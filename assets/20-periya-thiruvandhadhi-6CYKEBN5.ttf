{"id":"20-periya-thiruvandhadhi","name":"Periya Thiruvandhadhi","nameTa":"பெரிய திருவந்தாதி","alvar":"Nammazhvar","alvarTa":"நம்மாழ்வார்","src":"periya thiruvandhAdhi","ayiram":3,"start":2585,"end":2671,"thaniyans":[{"le":["thaniyan","emberumAnAr aruLich seydhadhu"],"lt":["தனியன்","எம்பெருமானார் அருளிச் செய்தது"],"en":["mundhuRRa nenjchE! muyaRRi thariththu uraiththu *","vandhiththu vAy Ara vAzhththich * - sandha","murugUrum sOlai sUzh moy pUm porunal *","kurugUran mARan pEr kURu"],"ta":["முந்துற்ற நெஞ்சே! முயற்றி தரித்து உரைத்து *","வந்தித்து வாய் ஆர வாழ்த்திச் * - சந்த","முருகூரும் சோலை சூழ் மொய் பூம் பொருநல் *","குருகூரன் மாறன் பேர் கூறு"]}],"sections":[{"he":[],"ht":[],"ae":null,"at":null,"p":[[2585,2585,["** muyaRRi sumandhu ezhundhu * mundhuRRa nenjchE! *","iyaRRuvAy emmoDu nI kUDi ** - nayappuDaiya","nAvIn thoDai kiLavi * uL podhivOm * naRpUvaip","pUvInRa vaNNan pugazh"],["** முயற்றி சுமந்து எழுந்து * முந்துற்ற நெஞ்சே! *","இயற்றுவாய் எம்மொடு நீ கூடி ** - நயப்புடைய","நாவீன் தொடை கிளவி * உள் பொதிவோம் * நற்பூவைப்","பூவீன்ற வண்ணன் புகழ்"],0,"/media/recitation/PTA.1.mp3"],[2586,2586,["pugazhvOm pazhippOm * pugazhOm pazhiyOm *","igazhvOm madhippOm madhiyOm - igazhOm ** maRRu","enggaL mAl! sengkaN mAl! * sIRal nI thI vinaiyOm *","enggaL mAl kaNDAy ivai"],["புகழ்வோம் பழிப்போம் * புகழோம் பழியோம் *","இகழ்வோம் மதிப்போம் மதியோம் - இகழோம் ** மற்று","எங்கள் மால்! செங்கண் மால்! * சீறல் நீ தீ வினையோம் *","எங்கள் மால் கண்டாய் இவை"],0,"/media/recitation/PTA.2.mp3"],[2587,2587,["ivai anRE nalla * ivai anRE thIya *","ivai enRivai aRivanElum ** - ivai ellAm","ennAl aDaippu nIkku * oNNAdhu iRaiyavanE! *","ennAl seyaRpAladhu en?"],["இவை அன்றே நல்ல * இவை அன்றே தீய *","இவை என்றிவை அறிவனேலும் ** - இவை எல்லாம்","என்னால் அடைப்பு நீக்கு * ஒண்ணாது இறையவனே! *","என்னால் செயற்பாலது என்?"],0,"/media/recitation/PTA.3.mp3"],[2588,2588,["ennin migu pugazhAr yAvarE? * pinnaiyum maRRu","eNNil * migu pugazhEn yAn allAl ** - enna","karunjchOdhik * kaNNan kaDal puraiyum * sIlap","perunjchOdhikku en nenjchu ALpeRRu"],["என்னின் மிகு புகழார் யாவரே? * பின்னையும் மற்று","எண்ணில் * மிகு புகழேன் யான் அல்லால் ** - என்ன","கருஞ்சோதிக் * கண்ணன் கடல் புரையும் * சீலப்","பெருஞ்சோதிக்கு என் நெஞ்சு ஆள்பெற்று"],0,"/media/recitation/PTA.4.mp3"],[2589,2589,["peRRa thAy nIyE * piRappiththa thandhai nI *","maRRaiyAr AvArum nI pEsil ** - eRREyO!","mAya! mA mAyavaLai * mAya mulai vAy vaiththa *","nI ammA! kATTum neRi"],["பெற்ற தாய் நீயே * பிறப்பித்த தந்தை நீ *","மற்றையார் ஆவாரும் நீ பேசில் ** - எற்றேயோ!","மாய! மா மாயவளை * மாய முலை வாய் வைத்த *","நீ அம்மா! காட்டும் நெறி"],0,"/media/recitation/PTA.5.mp3"],[2590,2590,["neRi kATTi nIkkudhiyO? * nin pAl karu mA","muRi mEni kATTudhiyO? ** mEl nAL - aRiyOmai *","en seyvAn eNNinAy? kaNNanE! * IdhuraiyAy","en seydhAl en paDOm yAm?"],["நெறி காட்டி நீக்குதியோ? * நின் பால் கரு மா","முறி மேனி காட்டுதியோ? ** மேல் நாள் - அறியோமை *","என் செய்வான் எண்ணினாய்? கண்ணனே! * ஈதுரையாய்","என் செய்தால் என் படோம் யாம்?"],0,"/media/recitation/PTA.6.mp3"],[2591,2591,["yAmE aru vinaiyOm sEyOm * en nenjchinAr","thAmE * aNukkarAych sArndhu ozhindhAr ** - pU mEya","semmAdhai * nin mArvil sErviththu * pAr iDandha","ammA! nin pAdhaththu arugu"],["யாமே அரு வினையோம் சேயோம் * என் நெஞ்சினார்","தாமே * அணுக்கராய்ச் சார்ந்து ஒழிந்தார் ** - பூ மேய","செம்மாதை * நின் மார்வில் சேர்வித்து * பார் இடந்த","அம்மா! நின் பாதத்து அருகு"],0,"/media/recitation/PTA.7.mp3"],[2592,2592,["arugum suvaDum therivuNarOm * anbE","perugum miga * idhu en? pEsIr ** - parugalAm","paNbuDaiyIr! pAr aLandhIr! * pAviyEm kaN kANbariya *","nuNbuDaiyIr! nummai numakku"],["அருகும் சுவடும் தெரிவுணரோம் * அன்பே","பெருகும் மிக * இது என்? பேசீர் ** - பருகலாம்","பண்புடையீர்! பார் அளந்தீர்! * பாவியேம் கண் காண்பரிய *","நுண்புடையீர்! நும்மை நுமக்கு"],0,"/media/recitation/PTA.8.mp3"],[2593,2593,["numakkaDiyOm enRenRu * nondhuraiththu en? * mAlAr","thamakku avar thAm * sArvariyar AnAl? ** - emakku ini","yAdhAnum * AgiDu kAN nenjchE! * avar thiRaththE","yAdhAnum sindhiththu iru"],["நுமக்கடியோம் என்றென்று * நொந்துரைத்து என்? * மாலார்","தமக்கு அவர் தாம் * சார்வரியர் ஆனால்? ** - எமக்கு இனி","யாதானும் * ஆகிடு காண் நெஞ்சே! * அவர் திறத்தே","யாதானும் சிந்தித்து இரு"],0,"/media/recitation/PTA.9.mp3"],[2594,2594,["iru nAlvar * Iraindhin mEl oruvar * eTTODu","oru nAlvar * Or iruvar allAl ** - thirumARku","yAm Ar? vaNakkam Ar? * E pAvam nannenjchE! *","nAmA miga uDaiyOm nAzh"],["இரு நால்வர் * ஈரைந்தின் மேல் ஒருவர் * எட்டோடு","ஒரு நால்வர் * ஓர் இருவர் அல்லால் ** - திருமாற்கு","யாம் ஆர்? வணக்கம் ஆர்? * ஏ பாவம் நன்னெஞ்சே! *","நாமா மிக உடையோம் நாழ்"],0,"/media/recitation/PTA.10.mp3"],[2595,2595,["nAzhAl amar muyanRa * vallarakkan innuyirai *","vAzhA vagai validhal nin valiyE ** - AzhAdha","pArum nI vAnum nI * kAlum nI thIyum nI *","nIrum nIyAy ninRa nI"],["நாழால் அமர் முயன்ற * வல்லரக்கன் இன்னுயிரை *","வாழா வகை வலிதல் நின் வலியே ** - ஆழாத","பாரும் நீ வானும் நீ * காலும் நீ தீயும் நீ *","நீரும் நீயாய் நின்ற நீ"],0,"/media/recitation/PTA.11.mp3"],[2596,2596,["nI anRE Azh thuyaril * vIzhvippAn ninRu uzhanRAy? *","pOy onRu solli en? pO nenjchE! ** - nI enRum","kAzhththu upadhEsam tharinum * kaik koLLAy * kaNNan thAL","vAzhththuvadhE kaNDAy vazhakku"],["நீ அன்றே ஆழ் துயரில் * வீழ்விப்பான் நின்று உழன்றாய்? *","போய் ஒன்று சொல்லி என்? போ நெஞ்சே! ** - நீ என்றும்","காழ்த்து உபதேசம் தரினும் * கைக் கொள்ளாய் * கண்ணன் தாள்","வாழ்த்துவதே கண்டாய் வழக்கு"],0,"/media/recitation/PTA.12.mp3"],[2597,2597,["vazhakkoDu mARukoL anRu * aDiyAr vENDa *","izhakkavum kANDum iRaiva! * - izhappuNDE? **","em ATkoNDAgilum * yAn vENDa en kaNgaL *","thammAl kATTu un mEnich chAy"],["வழக்கொடு மாறுகொள் அன்று * அடியார் வேண்ட *","இழக்கவும் காண்டும் இறைவ! * - இழப்புண்டே? **","எம் ஆட்கொண்டாகிலும் * யான் வேண்ட என் கண்கள் *","தம்மால் காட்டு உன் மேனிச் சாய்"],0,"/media/recitation/PTA.13.mp3"],[2598,2598,["sAyAl kariyAnai * uL aRiyArAy nenjchE! *","pEyAr mulai koDuththAr pEyarAy ** - nI yAr? pOyth","thEmbUN suvaiththu * Un aRindhu aRindhum * thI vinaiyAm","pAmbAr vAyk kai nITTal pArththi"],["சாயால் கரியானை * உள் அறியாராய் நெஞ்சே! *","பேயார் முலை கொடுத்தார் பேயராய் ** - நீ யார்? போய்த்","தேம்பூண் சுவைத்து * ஊன் அறிந்து அறிந்தும் * தீ வினையாம்","பாம்பார் வாய்க் கை நீட்டல் பார்த்தி"],0,"/media/recitation/PTA.14.mp3"],[2599,2599,["pArththOr edhiridhA nenjchE! * paDu thuyaram","pErththOdhap * pIDazhivAm pEchchillai ** - ArththOdham","tham mEni * thAL thaDavath thAm kiDandhu * thammuDaiya","semmEnik kaN vaLarvAr sIr"],["பார்த்தோர் எதிரிதா நெஞ்சே! * படு துயரம்","பேர்த்தோதப் * பீடழிவாம் பேச்சில்லை ** - ஆர்த்தோதம்","தம் மேனி * தாள் தடவத் தாம் கிடந்து * தம்முடைய","செம்மேனிக் கண் வளர்வார் சீர்"],0,"/media/recitation/PTA.15.mp3"],[2600,2600,["sIrAl piRandhu * siRappAl vaLarAdhu *","pEr vAman AgAkkAl pErALA! ** - mArbArap","pulgi nI uNDu umizhndha * bUmi nIr ERparidhE? *","sollu nI yAm aRiyach sUzhndhu"],["சீரால் பிறந்து * சிறப்பால் வளராது *","பேர் வாமன் ஆகாக்கால் பேராளா! ** - மார்பாரப்","புல்கி நீ உண்டு உமிழ்ந்த * பூமி நீர் ஏற்பரிதே? *","சொல்லு நீ யாம் அறியச் சூழ்ந்து"],0,"/media/recitation/PTA.16.mp3"],[2601,2601,["sUzhndhu aDiyAr vENDinakkAl * thOnRAdhu viTTAlum *","vAzhndhiDuvar pinnum tham vAy thiRavAr ** - sUzhndhu enggum","vAL varaigaL pOl arakkan * van thalaigaL thAm iDiya *","thAL varai vil EndhinAr thAm"],["சூழ்ந்து அடியார் வேண்டினக்கால் * தோன்றாது விட்டாலும் *","வாழ்ந்திடுவர் பின்னும் தம் வாய் திறவார் ** - சூழ்ந்து எங்கும்","வாள் வரைகள் போல் அரக்கன் * வன் தலைகள் தாம் இடிய *","தாள் வரை வில் ஏந்தினார் தாம்"],0,"/media/recitation/PTA.17.mp3"],[2602,2602,["thAmbAl AppuNDAlum * aththazhumbu thAn iLaga *","pAmbAl AppuNDu pADuRRAlum ** - sOmbAdhu ip","pal uruvai ellAm * paDarviththa viththA! * un","thol uruvai yAr aRivAr? sollu"],["தாம்பால் ஆப்புண்டாலும் * அத்தழும்பு தான் இளக *","பாம்பால் ஆப்புண்டு பாடுற்றாலும் ** - சோம்பாது இப்","பல் உருவை எல்லாம் * படர்வித்த வித்தா! * உன்","தொல் உருவை யார் அறிவார்? சொல்லு"],0,"/media/recitation/PTA.18.mp3"],[2603,2603,["cŏllil kuṟai illai * cūtu aṟiyā nĕñcame *","ĕlli pakal ĕṉṉātu ĕppotum ** tŏllaikkaṇ","māt tāṉaikku ĕllām * or aivaraiye māṟu āka *","kāttāṉaik kāṇṭum nī kāṇ -"],["சொல்லில் குறை இல்லை * சூது அறியா நெஞ்சமே *","எல்லி பகல் என்னாது எப்போதும் ** தொல்லைக்கண்","மாத் தானைக்கு எல்லாம் * ஓர் ஐவரையே மாறு ஆக *","காத்தானைக் காண்டும் நீ காண்"],1,"/media/recitation/PTA.19.mp3"],[2604,2604,["kāṇappukil aṟivu * kaikkŏṇṭa nal nĕñcam *","nāṇappaṭum aṉṟe nām pecil! ** māṇi","uru ākikkŏṇṭu * ulakam nīr eṟṟa cīrāṉ *","tiru ākam tīṇṭiṟṟuc cĕṉṟu -"],["காணப்புகில் அறிவு * கைக்கொண்ட நல் நெஞ்சம் *","நாணப்படும் அன்றே நாம் பேசில்! ** மாணி","உரு ஆகிக்கொண்டு * உலகம் நீர் ஏற்ற சீரான் *","திரு ஆகம் தீண்டிற்றுச் சென்று"],1,"/media/recitation/PTA.20.mp3"],[2605,2605,["senRanggu vennaragil * sErAmal kAppadhaRku *","inRinggu en nenjchAl iDukkuNDa ** - anRanggup","pAr uruvum pAr vaLaiththa * nIr uruvum kaN pudhaiya *","kAr uruvan thAn nimirththa kAl"],["சென்றங்கு வெந்நரகில் * சேராமல் காப்பதற்கு *","இன்றிங்கு என் நெஞ்சால் இடுக்குண்ட ** - அன்றங்குப்","பார் உருவும் பார் வளைத்த * நீர் உருவும் கண் புதைய *","கார் உருவன் தான் நிமிர்த்த கால்"],0,"/media/recitation/PTA.21.mp3"],[2606,2606,["kAlE podhath thirindhu * kaththuvarAm inanAL *","mAlAr kuDi pugundhAr en manaththE ** - mElAl","tharukkum iDam pATTinoDum * valvinaiyAr thAm * vIRRu","irukkum iDam kANAdhu iLaiththu"],["காலே பொதத் திரிந்து * கத்துவராம் இனநாள் *","மாலார் குடி புகுந்தார் என் மனத்தே ** - மேலால்","தருக்கும் இடம் பாட்டினொடும் * வல்வினையார் தாம் * வீற்று","இருக்கும் இடம் காணாது இளைத்து"],0,"/media/recitation/PTA.22.mp3"],[2607,2607,["iLaippAy iLaiyAppAy * nenjchamE! sonnEn *","iLaikka naman thamargaL paRRi * - iLaippeydha **","nAy thandhu mOdhAmal * nalguvAn nalkAppAn *","thAy thandhai evvuyirkkum thAn"],["இளைப்பாய் இளையாப்பாய் * நெஞ்சமே! சொன்னேன் *","இளைக்க நமன் தமர்கள் பற்றி * - இளைப்பெய்த **","நாய் தந்து மோதாமல் * நல்குவான் நல்காப்பான் *","தாய் தந்தை எவ்வுயிர்க்கும் தான்"],0,"/media/recitation/PTA.23.mp3"],[2608,2608,["thAnE thanith thOnRal * than aLappu onRu illAdhAn *","thAnE piRargaTkum thaRROnRal ** - thAnE","iLaikkil pAr kIzh mElAm * mINDu amaippAn AnAl *","aLakkiRpAr pArin mEl Ar?"],["தானே தனித் தோன்றல் * தன் அளப்பு ஒன்று இல்லாதான் *","தானே பிறர்கட்கும் தற்றோன்றல் ** - தானே","இளைக்கில் பார் கீழ் மேலாம் * மீண்டு அமைப்பான் ஆனால் *","அளக்கிற்பார் பாரின் மேல் ஆர்?"],0,"/media/recitation/PTA.24.mp3"],[2609,2609,["ArAnum AdhAnum seyya * agal iDaththai","ArAyndhu * adhu thiruththal AvadhE? ** - sIr Ar","manaththalai * vanthunbaththai mARRinEn * vAnOr","inath thalaivan kaNNanAl yAn"],["ஆரானும் ஆதானும் செய்ய * அகல் இடத்தை","ஆராய்ந்து * அது திருத்தல் ஆவதே? ** - சீர் ஆர்","மனத்தலை * வன்துன்பத்தை மாற்றினேன் * வானோர்","இனத் தலைவன் கண்ணனால் யான்"],0,"/media/recitation/PTA.25.mp3"],[2610,2610,["yAnum en nenjchum * isaindhozhindhOm * valvinaiyaik","kAnum malaiyum pugak kaDivAn ** - thAn Or","iruL anna mAmEni * em iRaiyAr thandha *","aruL ennum thaNDAl aDiththu"],["யானும் என் நெஞ்சும் * இசைந்தொழிந்தோம் * வல்வினையைக்","கானும் மலையும் புகக் கடிவான் ** - தான் ஓர்","இருள் அன்ன மாமேனி * எம் இறையார் தந்த *","அருள் என்னும் தண்டால் அடித்து"],0,"/media/recitation/PTA.26.mp3"],[2611,2611,["aDiyAl paDi kaDandha muththO? * adhanREl","muDiyAl * visumbu aLandha muththO? ** - neDiyAy!","seRi kazhalgaL thAL nimirththuch * senRu ulagam ellAm *","aRigilamAl nI aLandha anRu"],["அடியால் படி கடந்த முத்தோ? * அதன்றேல்","முடியால் * விசும்பு அளந்த முத்தோ? ** - நெடியாய்!","செறி கழல்கள் தாள் நிமிர்த்துச் * சென்று உலகம் எல்லாம் *","அறிகிலமால் நீ அளந்த அன்று"],0,"/media/recitation/PTA.27.mp3"],[2612,2612,["anRE nam kaN kANum * AzhiyAn kAr uruvam *","inRE nAm kANAdhu iruppadhuvum ** - enREnum","kaTkaNNAl * kANAdha avvuruvai * nenjchennum","uTkaNNEl kANum uNarndhu"],["அன்றே நம் கண் காணும் * ஆழியான் கார் உருவம் *","இன்றே நாம் காணாது இருப்பதுவும் ** - என்றேனும்","கட்கண்ணால் * காணாத அவ்வுருவை * நெஞ்சென்னும்","உட்கண்ணேல் காணும் உணர்ந்து"],0,"/media/recitation/PTA.28.mp3"],[2613,2613,["uNara oruvarkku * eLiyanE? sevvE *","iNarum thuzhAy alanggal endhai ** - uNarath","thanakku eLiyar evvaLavar * avvaLavan AnAl *","enakku eLiyan emperumAn inggu"],["உணர ஒருவர்க்கு * எளியனே? செவ்வே *","இணரும் துழாய் அலங்கல் எந்தை ** - உணரத்","தனக்கு எளியர் எவ்வளவர் * அவ்வளவன் ஆனால் *","எனக்கு எளியன் எம்பெருமான் இங்கு"],0,"/media/recitation/PTA.29.mp3"],[2614,2614,["inggillai * paNDu pOl vIRRu iruththal * ennuDaiya","sengkaNmAl * sIrkkum siRidhuLLam ** - anggE","maDi aDakki niRpadhanil * valvinaiyAr thAm * mINDu","aDi eDuppadhu anRO azhagu?"],["இங்கில்லை * பண்டு போல் வீற்று இருத்தல் * என்னுடைய","செங்கண்மால் * சீர்க்கும் சிறிதுள்ளம் ** - அங்கே","மடி அடக்கி நிற்பதனில் * வல்வினையார் தாம் * மீண்டு","அடி எடுப்பது அன்றோ அழகு?"],0,"/media/recitation/PTA.30.mp3"],[2615,2615,["azhagum aRivOmAy * valvinaiyaith thIrppAn *","nizhalum aDi thARum AnOm ** - suzhalak","kuDanggaL * thalai mIdhu eDuththuk koNDADi * anu ath","thaDangkaDalai mEyAr thamakku"],["அழகும் அறிவோமாய் * வல்வினையைத் தீர்ப்பான் *","நிழலும் அடி தாறும் ஆனோம் ** - சுழலக்","குடங்கள் * தலை மீது எடுத்துக் கொண்டாடி * அன்று அத்","தடங்கடலை மேயார் தமக்கு"],0,"/media/recitation/PTA.31.mp3"],[2616,2616,["tamakku aṭimai veṇṭuvār * tāmotaraṉār","tamakku * aṭimai cĕy ĕṉṟāl cĕyyātu ** ĕmakku ĕṉṟu","tām cĕyyum tīviṉaikke * tāzhvuṟuvar nĕñciṉār *","yām cĕyvatu ivviṭattu iṅku yātu? -"],["தமக்கு அடிமை வேண்டுவார் * தாமோதரனார்","தமக்கு * அடிமை செய் என்றால் செய்யாது ** எமக்கு என்று","தாம் செய்யும் தீவினைக்கே * தாழ்வுறுவர் நெஞ்சினார் *","யாம் செய்வது இவ்விடத்து இங்கு யாது?"],1,"/media/recitation/PTA.32.mp3"],[2617,2617,["yAdhAnum onRaRiyil * than ugakkil en kolO? *","yAdhAnum nErndhu aNugAvARu thAn? ** - yAdhAnum","thERumA seyyA * asurargaLai * nEmiyAl","pARu pARAkkinAn pAl"],["யாதானும் ஒன்றறியில் * தன் உகக்கில் என் கொலோ? *","யாதானும் நேர்ந்து அணுகாவாறு தான்? ** - யாதானும்","தேறுமா செய்யா * அசுரர்களை * நேமியால்","பாறு பாறாக்கினான் பால்"],0,"/media/recitation/PTA.33.mp3"],[2618,2618,["pAl Azhi nI kiDakkum paNbai * yAm kETTEyum *","kAl Azhum nenjchazhiyum kaN suzhalum ** - nIlAzhich","sOdhiyAy! AdhiyAy! * tholvinai empAl kaDiyum *","nIdhiyAy! niRsArndhu ninRu"],["பால் ஆழி நீ கிடக்கும் பண்பை * யாம் கேட்டேயும் *","கால் ஆழும் நெஞ்சழியும் கண் சுழலும் ** - நீலாழிச்","சோதியாய்! ஆதியாய்! * தொல்வினை எம்பால் கடியும் *","நீதியாய்! நிற்சார்ந்து நின்று"],0,"/media/recitation/PTA.34.mp3"],[2619,2619,["ninRum irundhum * kiDandhum thirithandhum *","onRumO ARRAn en nenjchagalAn ** - anRu angkai","vanpuDaiyAl pon peyarOn * vAy thagarththu mArvu iDandhAn *","anbuDaiyan anRE avan?"],["நின்றும் இருந்தும் * கிடந்தும் திரிதந்தும் *","ஒன்றுமோ ஆற்றான் என் நெஞ்சகலான் ** - அன்று அங்கை","வன்புடையால் பொன் பெயரோன் * வாய் தகர்த்து மார்வு இடந்தான் *","அன்புடையன் அன்றே அவன்?"],0,"/media/recitation/PTA.35.mp3"],[2620,2620,["avanAm ivanAm uvanAm * maRRu umbar","avanAm * avan enRu irAdhE ** - avanAm","avanE enath theLindhu * kaNNanukkE thIrndhAl *","avanE evanElumAm"],["அவனாம் இவனாம் உவனாம் * மற்று உம்பர்","அவனாம் * அவன் என்று இராதே ** - அவனாம்","அவனே எனத் தெளிந்து * கண்ணனுக்கே தீர்ந்தால் *","அவனே எவனேலுமாம்"],0,"/media/recitation/PTA.36.mp3"],[2621,2621,["Am ARu aRivuDaiyAr * Avadhu aridhu anRE? *","nAmE adhu uDaiyOm nannenjchE! ** - pUmEy","madhukaramE * thaNthuzhAy mAlArai * vAzhththAm","adhu karamE anbAl amai"],["ஆம் ஆறு அறிவுடையார் * ஆவது அரிது அன்றே? *","நாமே அது உடையோம் நன்னெஞ்சே! ** - பூமேய்","மதுகரமே * தண்துழாய் மாலாரை * வாழ்த்தாம்","அது கரமே அன்பால் அமை"],0,"/media/recitation/PTA.37.mp3"],[2622,2622,["amaikkum pozhudhu uNDE? * ArAyil nenjchE! *","imaikkum pozhudhum iDaichchi - kumaith thiRanggaL **","EsiyE Ayinum * InthuzhAy mAyanaiyE *","pEsiyE pOkkAy pizhai"],["அமைக்கும் பொழுது உண்டே? * ஆராயில் நெஞ்சே! *","இமைக்கும் பொழுதும் இடைச்சி - குமைத் திறங்கள் **","ஏசியே ஆயினும் * ஈன்துழாய் மாயனையே *","பேசியே போக்காய் பிழை"],0,"/media/recitation/PTA.38.mp3"],[2623,2623,["pizhaikka muyanROmO? * nenjchamE! pEsAy *","thazhaikkum thuzhAy mArvan thannai ** - azhaiththu orukAl","pOy upakAram * poliyak koLLAdhu * avan pugazhE","vAy upakAram koNDa vAyppu"],["பிழைக்க முயன்றோமோ? * நெஞ்சமே! பேசாய் *","தழைக்கும் துழாய் மார்வன் தன்னை ** - அழைத்து ஒருகால்","போய் உபகாரம் * பொலியக் கொள்ளாது * அவன் புகழே","வாய் உபகாரம் கொண்ட வாய்ப்பு"],0,"/media/recitation/PTA.39.mp3"],[2624,2624,["vAyppO idhu oppa * maRRillai vA nenjchE! *","pOyp pOoy vennaragil pUviyEl ** - thIp pAla","pEyth thAy * uyir kalAyp pAl uNDu * avaL uyirai","mAyththAnai vAzhththE vali"],["வாய்ப்போ இது ஒப்ப * மற்றில்லை வா நெஞ்சே! *","போய்ப் போஒய் வெந்நரகில் பூவியேல் ** - தீப் பால","பேய்த் தாய் * உயிர் கலாய்ப் பால் உண்டு * அவள் உயிரை","மாய்த்தானை வாழ்த்தே வலி"],0,"/media/recitation/PTA.40.mp3"],[2625,2625,["valiyam ĕṉa niṉaintu * vantu ĕtirnta mallar *","valiya muṭi iṭiya vāṅki ** valiya niṉ","pŏṉ āzhik kaiyāl * puṭaittiṭuti kīl̤āte *","pal nāl̤um niṟkum ip pār -"],["வலியம் என நினைந்து * வந்து எதிர்ந்த மல்லர் *","வலிய முடி இடிய வாங்கி ** வலிய நின்","பொன் ஆழிக் கையால் * புடைத்திடுதி கீளாதே *","பல் நாளும் நிற்கும் இப் பார்"],1,"/media/recitation/PTA.41.mp3"],[2626,2626,["pAr uNDAn pAr umizhndhAn * pAr iDanthAn pAr aLandhAn *","pAr iDam mun paDaiththAn enbarAl ** - pAr iDam","AvAnum * thAn AnAl Ar iDamE? * maRRoruvarkku","AvAn pugAvAl avai"],["பார் உண்டான் பார் உமிழ்ந்தான் * பார் இடந்தான் பார் அளந்தான் *","பார் இடம் முன் படைத்தான் என்பரால் ** - பார் இடம்","ஆவானும் * தான் ஆனால் ஆர் இடமே? * மற்றொருவர்க்கு","ஆவான் புகாவால் அவை"],0,"/media/recitation/PTA.42.mp3"],[2627,2627,["avayam ena ninaindhu * vandha surar pAlE *","navaiyai naLirvippAn thannai ** - kavai il","manaththuyara vaiththu irundhu * vAzhththAdhArkku uNDO? *","manath thuyarai mAykkum vagai"],["அவயம் என நினைந்து * வந்த சுரர் பாலே *","நவையை நளிர்விப்பான் தன்னை ** - கவை இல்","மனத்துயர வைத்து இருந்து * வாழ்த்தாதார்க்கு உண்டோ? *","மனத் துயரை மாய்க்கும் வகை"],0,"/media/recitation/PTA.43.mp3"],[2628,2628,["vakai cernta nal nĕñcum * nā uṭaiya vāyum *","mika vāyntu vīzhā ĕṉilum ** mika āyntu","mālait tām * vāzhttātu iruppar itu aṉṟe *","melait tām cĕyyum viṉai? -"],["வகை சேர்ந்த நல் நெஞ்சும் * நா உடைய வாயும் *","மிக வாய்ந்து வீழா எனிலும் ** மிக ஆய்ந்து","மாலைத் தாம் * வாழ்த்தாது இருப்பர் இது அன்றே *","மேலைத் தாம் செய்யும் வினை?"],1,"/media/recitation/PTA.44.mp3"],[2629,2629,["vinaiyAr thara muyalum * vemmaiyai anjchi *","thinaiyAm siRidhaLavum sella - ninaiyAdhu **","vAsagaththAl EththinEn * vAnOr thozhudhu iRainjchum *","nAyagaththAn pon aDikkaL nAn"],["வினையார் தர முயலும் * வெம்மையை அஞ்சி *","தினையாம் சிறிதளவும் செல்ல - நினையாது **","வாசகத்தால் ஏத்தினேன் * வானோர் தொழுது இறைஞ்சும் *","நாயகத்தான் பொன் அடிக்கள் நான்"],0,"/media/recitation/PTA.45.mp3"],[2630,2630,["nāṉ kūṟum * kūṟṟāvatu ittaṉaiye * nāl̤nāl̤um","teṅku ota nīr uruvaṉ cĕṅkaṇ māl ** nīṅkāta","mā kati ām * vĕm narakil cerāmal kāppataṟku *","nī kati ām nĕñce niṉai -"],["நான் கூறும் * கூற்றாவது இத்தனையே * நாள்நாளும்","தேங்கு ஓத நீர் உருவன் செங்கண் மால் ** நீங்காத","மா கதி ஆம் * வெம் நரகில் சேராமல் காப்பதற்கு *","நீ கதி ஆம் நெஞ்சே நினை"],1,"/media/recitation/PTA.46.mp3"],[2631,2631,["ninaiththu iRainjchi mAniDavar * onRu irappar enRE *","ninaiththiDavum vENDA nI nErE ** - ninaiththu iRainjcha","evvaLavar * evviDaththOr mAlE! * adhu thAnum","evvaLavum uNDO? emakku"],["நினைத்து இறைஞ்சி மானிடவர் * ஒன்று இரப்பர் என்றே *","நினைத்திடவும் வேண்டா நீ நேரே ** - நினைத்து இறைஞ்ச","எவ்வளவர் * எவ்விடத்தோர் மாலே! * அது தானும்","எவ்வளவும் உண்டோ? எமக்கு"],0,"/media/recitation/PTA.47.mp3"],[2632,2632,["emakku yAm viNNATTukku * uchchamadhAm vITTai *","amaiththu irundhOm aqdhanRE yAmARu? ** - amaippolindha","men thOLi kAraNamA * vengkOTTu ERu EzhuDanE *","konRAnaiyE manaththuk koNDu"],["எமக்கு யாம் விண்ணாட்டுக்கு * உச்சமதாம் வீட்டை *","அமைத்து இருந்தோம் அஃதன்றே யாமாறு? ** - அமைப்பொலிந்த","மென் தோளி காரணமா * வெங்கோட்டு ஏறு ஏழுடனே *","கொன்றானையே மனத்துக் கொண்டு"],0,"/media/recitation/PTA.48.mp3"],[2633,2633,["koNDal thAn mAl varai thAn * mA kaDal thAn kUr iruL thAn *","vaNDaRAp pUvai thAn maRRuth thAn ** - kaNDa nAL","kAr uruvam * kAN thORum nenjchu ODum * kaNNanAr","pEr uru enRemmaip pirindhu"],["கொண்டல் தான் மால் வரை தான் * மா கடல் தான் கூர் இருள் தான் *","வண்டறாப் பூவை தான் மற்றுத் தான் ** - கண்ட நாள்","கார் உருவம் * காண் தோறும் நெஞ்சு ஓடும் * கண்ணனார்","பேர் உரு என்றெம்மைப் பிரிந்து"],0,"/media/recitation/PTA.49.mp3"],[2634,2634,["pirindhu onRu nOkkAdhu * thammuDaiya pinnE *","thirindhu uzhalum sindhanaiyAr thammai ** - purindhu orukAl","AvA! ena iranggAr * andhO! validhE kol? *","mA vAy piLandhAr manam"],["பிரிந்து ஒன்று நோக்காது * தம்முடைய பின்னே *","திரிந்து உழலும் சிந்தனையார் தம்மை ** - புரிந்து ஒருகால்","ஆவா! என இரங்கார் * அந்தோ! வலிதே கொல்? *","மா வாய் பிளந்தார் மனம்"],0,"/media/recitation/PTA.50.mp3"],[2635,2635,["manam ALum Or aivar * vankuRumbar thammai *","sina mALviththu Or iDaththE sErththu ** - puna mEya","thaNthuzhAyAn aDiyaith * thAn kANum aqdhanRE *","vaNthuzhAm sIrArkku mANbu"],["மனம் ஆளும் ஓர் ஐவர் * வன்குறும்பர் தம்மை *","சின மாள்வித்து ஓர் இடத்தே சேர்த்து ** - புன மேய","தண்துழாயான் அடியைத் * தான் காணும் அஃதன்றே *","வண்துழாம் சீரார்க்கு மாண்பு"],0,"/media/recitation/PTA.51.mp3"],[2636,2636,["mAN pAviththu anjnjAnRu * maN irandhAn * mAyavaL nanjchu","UN pAviththu * uNDAnadhu Or uruvam ** - kANbAn nang","kaN avA * maRRonRu kAN uRA * sIr paravAdhu","uNNa vAy thAn uRumO onRu?"],["மாண் பாவித்து அஞ்ஞான்று * மண் இரந்தான் * மாயவள் நஞ்சு","ஊண் பாவித்து * உண்டானது ஓர் உருவம் ** - காண்பான் நங்","கண் அவா * மற்றொன்று காண் உறா * சீர் பரவாது","உண்ண வாய் தான் உறுமோ ஒன்று?"],0,"/media/recitation/PTA.52.mp3"],[2637,2637,["onRuNDu sengkaN mAl! yAn uraippadhu * un aDiyArkku","en seyvan enRE iruththi nI ** - nin pugazhil","vaigum * tham sinthaiyilum maRRu inidhO? * nI avarkku","vaikuntham enRu aruLum vAn"],["ஒன்றுண்டு செங்கண் மால்! யான் உரைப்பது * உன் அடியார்க்கு","என் செய்வன் என்றே இருத்தி நீ ** - நின் புகழில்","வைகும் * தம் சிந்தையிலும் மற்று இனிதோ? * நீ அவர்க்கு","வைகுந்தம் என்று அருளும் வான்"],0,"/media/recitation/PTA.53.mp3"],[2638,2638,["vAnO? maRi kaDalO? * mArudhamO? thIyagamO? *","kAnO? orunggiRRum kaNDilam Al ** - An InRa","kanRuyarath thAm eRindhu * kAy udhirththAr thAL paNindhOm *","vanthuyarai yAvA! marunggu"],["வானோ? மறி கடலோ? * மாருதமோ? தீயகமோ? *","கானோ? ஒருங்கிற்றும் கண்டிலம் ஆல் ** - ஆன் ஈன்ற","கன்றுயரத் தாம் எறிந்து * காய் உதிர்த்தார் தாள் பணிந்தோம் *","வன்துயரை யாவா! மருங்கு"],0,"/media/recitation/PTA.54.mp3"],[2639,2639,["maruṅku otam motum * maṇi nākaṇaiyār *","maruṅke vara ariyarelum ** ŏruṅke","ĕmakku avaraik kāṇalām * ĕppŏzhutum ul̤l̤āl *","maṉak kavalai tīrppār varavu-"],["மருங்கு ஓதம் மோதும் * மணி நாகணையார் *","மருங்கே வர அரியரேலும் ** ஒருங்கே","எமக்கு அவரைக் காணலாம் * எப்பொழுதும் உள்ளால் *","மனக் கவலை தீர்ப்பார் வரவு"],1,"/media/recitation/PTA.55.mp3"],[2640,2640,["varavARu onRillaiyAl * vAzhvinidhAl * ellE!","oru ARu * oruvan pugA ARu ** - uru mARum","Ayavar thAm sEyavar thAm * anRu ulagam thAyavar thAm *","mAyavar thAm kATTum vazhi"],["வரவாறு ஒன்றில்லையால் * வாழ்வினிதால் * எல்லே!","ஒரு ஆறு * ஒருவன் புகா ஆறு ** - உரு மாறும்","ஆயவர் தாம் சேயவர் தாம் * அன்று உலகம் தாயவர் தாம் *","மாயவர் தாம் காட்டும் வழி"],0,"/media/recitation/PTA.56.mp3"],[2641,2641,["vazhith thanggu valvinaiyai * mARRAnO? nenjchE! *","thazhIik koNDu pOr avuNan thannai ** - suzhiththu enggum","thAzhviDanggaL paRRip * pulAl veLLam thAn ugaLa *","vAzhvu aDangga mArvu iDandha mAl?"],["வழித் தங்கு வல்வினையை * மாற்றானோ? நெஞ்சே! *","தழீஇக் கொண்டு போர் அவுணன் தன்னை ** - சுழித்து எங்கும்","தாழ்விடங்கள் பற்றிப் * புலால் வெள்ளம் தான் உகள *","வாழ்வு அடங்க மார்வு இடந்த மால்?"],0,"/media/recitation/PTA.57.mp3"],[2642,2642,["mAlE! paDich sOdhi mARREl * ini unadhu *","pAlE pOl sIril pazhuththu ozhindhEn ** - mElAl","piRappinmai peRRu * aDik kIzhk kuRREval anRu *","maRappinmai yAn vENDum mADu"],["மாலே! படிச் சோதி மாற்றேல் * இனி உனது *","பாலே போல் சீரில் பழுத்து ஒழிந்தேன் ** - மேலால்","பிறப்பின்மை பெற்று * அடிக் கீழ்க் குற்றேவல் அன்று *","மறப்பின்மை யான் வேண்டும் மாடு"],0,"/media/recitation/PTA.58.mp3"],[2643,2643,["mADE varap peRuvarAm enRE * valvinaiyAr","kADAnum * AdhAnum kaik koLLAr ** - UDE pOyp","pEr Odham sindhu * thiraik kaNvaLarum * pErALan","pEr Odhach sindhikkap pErndhu"],["மாடே வரப் பெறுவராம் என்றே * வல்வினையார்","காடானும் * ஆதானும் கைக் கொள்ளார் ** - ஊடே போய்ப்","பேர் ஓதம் சிந்து * திரைக் கண்வளரும் * பேராளன்","பேர் ஓதச் சிந்திக்கப் பேர்ந்து"],0,"/media/recitation/PTA.59.mp3"],[2644,2644,["pErndhonRu nOkkAdhu * pin niRpAy nillAppAy *","InthuzhAy mAyanaiyE en nenjchE! ** - pErndhenggum","thollai mA vennaragil * sErAmal kAppadhaRku *","illai kAN maRROr iRai"],["பேர்ந்தொன்று நோக்காது * பின் நிற்பாய் நில்லாப்பாய் *","ஈன்துழாய் மாயனையே என் நெஞ்சே! ** - பேர்ந்தெங்கும்","தொல்லை மா வெந்நரகில் * சேராமல் காப்பதற்கு *","இல்லை காண் மற்றோர் இறை"],0,"/media/recitation/PTA.60.mp3"],[2645,2645,["iRai muRaiyAn sEvaDi mEl * maN aLandha annAL *","maRai muRaiyAl vAnADar kUDi ** - muRai muRaiyin","thAdhilagu * pUth theLiththAl ovvAdhE? * thAzh visumbin","mIdhilagith thAn kiDakkum mIn"],["இறை முறையான் சேவடி மேல் * மண் அளந்த அந்நாள் *","மறை முறையால் வானாடர் கூடி ** - முறை முறையின்","தாதிலகு * பூத் தெளித்தால் ஒவ்வாதே? * தாழ் விசும்பின்","மீதிலகித் தான் கிடக்கும் மீன்"],0,"/media/recitation/PTA.61.mp3"],[2646,2646,["mīṉ ĕṉṉum kampil * vĕṟi ĕṉṉum vĕl̤l̤i vey *","vāṉ ĕṉṉum keṭu ilā vāṉ kuṭaikku ** tāṉ or","maṇik kāmpu pol * nimirntu maṇ al̤antāṉ * naṅkal̤","piṇikku ām pĕru maruntu piṉ -"],["மீன் என்னும் கம்பில் * வெறி என்னும் வெள்ளி வேய் *","வான் என்னும் கேடு இலா வான் குடைக்கு ** தான் ஓர்","மணிக் காம்பு போல் * நிமிர்ந்து மண் அளந்தான் * நங்கள்","பிணிக்கு ஆம் பெரு மருந்து பின்"],1,"/media/recitation/PTA.62.mp3"],[2647,2647,["piṉ turakkum kāṟṟu izhanta * cūl kŏṇṭal perntum poy *","vaṉ tiraikkaṇ vantu aṇainta vāymaitte ** aṉṟu","tiruc cĕyya nemiyāṉ * tī arakki mūkkum","paruc cĕviyum īrnta paraṉ-"],["பின் துரக்கும் காற்று இழந்த * சூல் கொண்டல் பேர்ந்தும் போய் *","வன் திரைக்கண் வந்து அணைந்த வாய்மைத்தே ** அன்று","திருச் செய்ய நேமியான் * தீ அரக்கி மூக்கும்","பருச் செவியும் ஈர்ந்த பரன்"],1,"/media/recitation/PTA.63.mp3"],[2648,2648,["paranAm avan Adhal * pAvippar Agil *","uranAl oru mUnRu pOdhum ** - maram Ezh anRu","eydhAnaip * puLLin vAy kINDAnaiyE * amarar","kai thAn thozhAvE kalandhu?"],["பரனாம் அவன் ஆதல் * பாவிப்பர் ஆகில் *","உரனால் ஒரு மூன்று போதும் ** - மரம் ஏழ் அன்று","எய்தானைப் * புள்ளின் வாய் கீண்டானையே * அமரர்","கை தான் தொழாவே கலந்து?"],0,"/media/recitation/PTA.64.mp3"],[2649,2649,["kalandhu naliyum * kaDunthuyarai nenjchE! *","malangga aDiththu maDippAn ** - vilanggal pOl","thol mAlaik kEsavanai * nAraNanai mAdhavanai *","sol mAlai eppozhudhum sUTTu"],["கலந்து நலியும் * கடுந்துயரை நெஞ்சே! *","மலங்க அடித்து மடிப்பான் ** - விலங்கல் போல்","தொல் மாலைக் கேசவனை * நாரணனை மாதவனை *","சொல் மாலை எப்பொழுதும் சூட்டு"],0,"/media/recitation/PTA.65.mp3"],[2650,2650,["sUTTAya nEmiyAn * thol arakkan innuyirai *","mATTE thuyar izhaiththa mAyavanai ** - ITTa","veRi koNDa * thaNthuzhAy vEdhiyanai * nenjchE!","aRi kaNDAy sonnEn adhu"],["சூட்டாய நேமியான் * தொல் அரக்கன் இன்னுயிரை *","மாட்டே துயர் இழைத்த மாயவனை ** - ஈட்ட","வெறி கொண்ட * தண்துழாய் வேதியனை * நெஞ்சே!","அறி கண்டாய் சொன்னேன் அது"],0,"/media/recitation/PTA.66.mp3"],[2651,2651,["atuvo naṉṟu ĕṉṟu * aṅku amar ulako veṇṭil *","atuvo pŏrul̤ illai aṉṟe? ** atu ŏzhintu","maṇ niṉṟu * āl̤veṉ ĕṉilum kūṭum maṭa nĕñce *","kaṇṇaṉ tāl̤ vāzhttuvate kal-"],["அதுவோ நன்று என்று * அங்கு அமர் உலகோ வேண்டில் *","அதுவோ பொருள் இல்லை அன்றே? ** அது ஒழிந்து","மண் நின்று * ஆள்வேன் எனிலும் கூடும் மட நெஞ்சே *","கண்ணன் தாள் வாழ்த்துவதே கல்"],1,"/media/recitation/PTA.67.mp3"],[2652,2652,["kallum kanai kaDalum * vaikuntha vAnADum *","pullenRu ozhindhana kol? E pAvam! ** - vella","neDiyAn niRam kariyAn * uL pugundhu nInggAn *","aDiyEnadhu uLLaththu agam"],["கல்லும் கனை கடலும் * வைகுந்த வானாடும் *","புல்லென்று ஒழிந்தன கொல்? ஏ பாவம்! ** - வெல்ல","நெடியான் நிறம் கரியான் * உள் புகுந்து நீங்கான் *","அடியேனது உள்ளத்து அகம்"],0,"/media/recitation/PTA.68.mp3"],[2653,2653,["agam sivandha kaNNinarAy * valvinaiyar AvAr *","mugam sidhaivarAm anRE mukki ** - migum thirumAl","sIrk kaDalai uL podhindha * sindhanaiyEn thannai *","Arkku aDalAm sevvE aDarththu?"],["அகம் சிவந்த கண்ணினராய் * வல்வினையர் ஆவார் *","முகம் சிதைவராம் அன்றே முக்கி ** - மிகும் திருமால்","சீர்க் கடலை உள் பொதிந்த * சிந்தனையேன் தன்னை *","ஆர்க்கு அடலாம் செவ்வே அடர்த்து?"],0,"/media/recitation/PTA.69.mp3"],[2654,2654,["aDar pon muDiyAnai * Ayiram pErAnai *","suDar koL suDar AzhiyAnai ** - iDar kaDiyum","mAthA pithuvAga * vaiththEn enadhuLLE *","yAdhu Agil yAdhE ini?"],["அடர் பொன் முடியானை * ஆயிரம் பேரானை *","சுடர் கொள் சுடர் ஆழியானை ** - இடர் கடியும்","மாதா பிதுவாக * வைத்தேன் எனதுள்ளே *","யாது ஆகில் யாதே இனி?"],0,"/media/recitation/PTA.70.mp3"],[2655,2655,["ini ninRu nin perumai * yAn uraippadhu ennE? *","thani ninRa sArvilA mUrththi! ** - pani nIr","agaththulavu * senjchaDaiyAn AgaththAn * nAnku","mugaththAn nin undhi mudhal"],["இனி நின்று நின் பெருமை * யான் உரைப்பது என்னே? *","தனி நின்ற சார்விலா மூர்த்தி! ** - பனி நீர்","அகத்துலவு * செஞ்சடையான் ஆகத்தான் * நான்கு","முகத்தான் நின் உந்தி முதல்"],0,"/media/recitation/PTA.71.mp3"],[2656,2656,["mudhalAm thiru uruvam * mUnRu enbar * onRE","mudhal Agum * mUnRukkum enbar - mudhalvA! **","nigar ilagu kAr uruvA! * nin agaththadhanRE? *","pugar ilagu thAmaraiyin pU"],["முதலாம் திரு உருவம் * மூன்று என்பர் * ஒன்றே","முதல் ஆகும் * மூன்றுக்கும் என்பர் - முதல்வா! **","நிகர் இலகு கார் உருவா! * நின் அகத்ததன்றே? *","புகர் இலகு தாமரையின் பூ"],0,"/media/recitation/PTA.72.mp3"],[2657,2657,["pUvaiyum kAyAvum * nIlamum pUkkinRa *","kAvi malar enRum kAN thORum ** - pAviyEn","mellAvi * mey migavE pUrikkum * avvavai","ellAm pirAn uruvE enRu"],["பூவையும் காயாவும் * நீலமும் பூக்கின்ற *","காவி மலர் என்றும் காண் தோறும் ** - பாவியேன்","மெல்லாவி * மெய் மிகவே பூரிக்கும் * அவ்வவை","எல்லாம் பிரான் உருவே என்று"],0,"/media/recitation/PTA.73.mp3"],[2658,2658,["enRum oru nAL * ozhiyAmai yAn irandhAl *","onRum iranggAr uruk kATTAr ** - kunRu","kuDai Aga * A kAththa kOvalanAr * nenjchE!","puDai thAn peridhE puvi"],["என்றும் ஒரு நாள் * ஒழியாமை யான் இரந்தால் *","ஒன்றும் இரங்கார் உருக் காட்டார் ** - குன்று","குடை ஆக * ஆ காத்த கோவலனார் * நெஞ்சே!","புடை தான் பெரிதே புவி"],0,"/media/recitation/PTA.74.mp3"],[2659,2659,["puviyum iru visumbum nin agaththa * nI en","seviyin vazhi pugundhu en uLLAy ** - avivinRi","yAn periyan nI periyai * enbadhanai yAr aRivAr? *","Un parugu nEmiyAy! uLLu"],["புவியும் இரு விசும்பும் நின் அகத்த * நீ என்","செவியின் வழி புகுந்து என் உள்ளாய் ** - அவிவின்றி","யான் பெரியன் நீ பெரியை * என்பதனை யார் அறிவார்? *","ஊன் பருகு நேமியாய்! உள்ளு"],0,"/media/recitation/PTA.75.mp3"],[2660,2660,["uLLilum uLLam thaDikkum * vinaip paDalam *","viLLa vizhiththu unnai mey uRRAl ** - uLLa","ulagaLavum * yAnum uLan Avan en kolO? *","ulagaLandha mUrththi! urai"],["உள்ளிலும் உள்ளம் தடிக்கும் * வினைப் படலம் *","விள்ள விழித்து உன்னை மெய் உற்றால் ** - உள்ள","உலகளவும் * யானும் உளன் ஆவன் என் கொலோ? *","உலகளந்த மூர்த்தி! உரை"],0,"/media/recitation/PTA.76.mp3"],[2661,2661,["uraikkil Or suRRaththAr * uRRAr enRArE? *","iraikkum kaDal kiDandha endhAy! ** - uraippellAm","nin anRi * maRRilEn kaNDAy! * enadh uuyirkkOr","sol nanRi Agum thuNai"],["உரைக்கில் ஓர் சுற்றத்தார் * உற்றார் என்றாரே? *","இரைக்கும் கடல் கிடந்த எந்தாய்! ** - உரைப்பெல்லாம்","நின் அன்றி * மற்றிலேன் கண்டாய்! * எனதுயிர்க்கோர்","சொல் நன்றி ஆகும் துணை"],0,"/media/recitation/PTA.77.mp3"],[2662,2662,["tuṇai nāl̤ pĕruṅ kil̤aiyum * tŏl kulamum * cuṟṟattu","iṇai nāl̤um iṉpu uṭaittāmelum ** kaṇai nāṇil","ovāt tŏzhil cārṅkaṉ * tŏl cīrai nal nĕñce *","ovāta ūṇāka uṇ -"],["துணை நாள் பெருங் கிளையும் * தொல் குலமும் * சுற்றத்து","இணை நாளும் இன்பு உடைத்தாமேலும் ** கணை நாணில்","ஓவாத் தொழில் சார்ங்கன் * தொல் சீரை நல் நெஞ்சே *","ஓவாத ஊணாக உண்"],1,"/media/recitation/PTA.78.mp3"],[2663,2663,["ul̤ nāṭṭut tecu aṉṟe? * ūzhviṉaiyai añcume? *","viṇ nāṭṭai ŏṉṟu āka mĕccume? ** maṇ nāṭṭil","ār āki * ĕv izhiviṟṟu āṉālum * āzhi aṅkaip","per āyaṟku āl̤ ām piṟappu -"],["உள் நாட்டுத் தேசு அன்றே? * ஊழ்வினையை அஞ்சுமே? *","விண் நாட்டை ஒன்று ஆக மெச்சுமே? ** மண் நாட்டில்","ஆர் ஆகி * எவ் இழிவிற்று ஆனாலும் * ஆழி அங்கைப்","பேர் ஆயற்கு ஆள் ஆம் பிறப்பு"],1,"/media/recitation/PTA.79.mp3"],[2664,2664,["piRappu iRappu mUppup * piNi thuRandhu * pinnum","iRakkavum * inbuDaiththAm Elum ** - maRappellAm","EdhamE * enRallAl eNNuvanE? * maN aLandhAn","pAdhamE EththAp pagal"],["பிறப்பு இறப்பு மூப்புப் * பிணி துறந்து * பின்னும்","இறக்கவும் * இன்புடைத்தாம் ஏலும் ** - மறப்பெல்லாம்","ஏதமே * என்றல்லால் எண்ணுவனே? * மண் அளந்தான்","பாதமே ஏத்தாப் பகல்"],0,"/media/recitation/PTA.80.mp3"],[2665,2665,["pagal irA enbadhuvum * pAviyAdhu * emmai","igal seydhu * irupozhudhum ALvar ** - thagavAth","thozhumbar ivar sIrkkum * thuNai ilar enROrAr *","sezhum paravai mEyAr therindhu"],["பகல் இரா என்பதுவும் * பாவியாது * எம்மை","இகல் செய்து * இருபொழுதும் ஆள்வர் ** - தகவாத்","தொழும்பர் இவர் சீர்க்கும் * துணை இலர் என்றோரார் *","செழும் பரவை மேயார் தெரிந்து"],0,"/media/recitation/PTA.81.mp3"],[2666,2666,["therindhu uNarvonRu inmaiyAl * thIvinaiyEn * vALA","irundhu ozhindhEn * kIzh nALgaL ellAm ** - karandhu uruvin","ammAnai * annAnRu pin thoDarndha * Azhi angkai","ammAnai EththAdhu ayarththu"],["தெரிந்து உணர்வொன்று இன்மையால் * தீவினையேன் * வாளா","இருந்து ஒழிந்தேன் * கீழ் நாள்கள் எல்லாம் ** - கரந்து உருவின்","அம்மானை * அந்நான்று பின் தொடர்ந்த * ஆழி அங்கை","அம்மானை ஏத்தாது அயர்த்து"],0,"/media/recitation/PTA.82.mp3"],[2667,2667,["ayarppAy ayarAppAy * nenjchamE! sonnEn *","uyap pOm neRi idhuvE kaNDAy ** - seyaRpAla","vallavE seykiRudhi * nenjchamE! anjchinEn *","mallar nAL vavvinanai vAzhththu"],["அயர்ப்பாய் அயராப்பாய் * நெஞ்சமே! சொன்னேன் *","உயப் போம் நெறி இதுவே கண்டாய் ** - செயற்பால","வல்லவே செய்கிறுதி * நெஞ்சமே! அஞ்சினேன் *","மல்லர் நாள் வவ்வினனை வாழ்த்து"],0,"/media/recitation/PTA.83.mp3"],[2668,2668,["vAzhththi avan aDiyaip pUp punaindhu * nin thalaiyaith","thAzhththu * iru kai kUppu enRAl kUppAdha - pAzhththa vidhi! **","engguRRAy enRavanai * EththAdhu en nenjchamE! *","thanggaththAn AmElum thanggu"],["வாழ்த்தி அவன் அடியைப் பூப் புனைந்து * நின் தலையைத்","தாழ்த்து * இரு கை கூப்பு என்றால் கூப்பாத - பாழ்த்த விதி! **","எங்குற்றாய் என்றவனை * ஏத்தாது என் நெஞ்சமே! *","தங்கத்தான் ஆமேலும் தங்கு"],0,"/media/recitation/PTA.84.mp3"],[2669,2669,["thanggA muyaRRiyavAyth * thAzh visumbin mIdhu pAyndhu *","enggE pukku eththavam seydhiTTana kol? ** - ponggOdhath","thaN ampAl * vElai vAyk kaN vaLarum * ennuDaiya","kaNNan pAl nalniRam koL kAr"],["தங்கா முயற்றியவாய்த் * தாழ் விசும்பின் மீது பாய்ந்து *","எங்கே புக்கு எத்தவம் செய்திட்டன கொல்? ** - பொங்கோதத்","தண் அம்பால் * வேலை வாய்க் கண் வளரும் * என்னுடைய","கண்ணன் பால் நல்நிறம் கொள் கார்"],0,"/media/recitation/PTA.85.mp3"],[2670,2670,["** kAr kalandha mEniyAn * kai kalandha AzhiyAn *","pAr kalandha valvayiRRAn pAmbaNaiyAn ** - sIr kalandha","sol ninaindhu pOkkArEl * sUzh vinaiyin Azhthuyarai *","en ninaindhu pOkkuvar ippOdhu?"],["** கார் கலந்த மேனியான் * கை கலந்த ஆழியான் *","பார் கலந்த வல்வயிற்றான் பாம்பணையான் ** - சீர் கலந்த","சொல் நினைந்து போக்காரேல் * சூழ் வினையின் ஆழ்துயரை *","என் நினைந்து போக்குவர் இப்போது?"],0,"/media/recitation/PTA.86.mp3"],[2671,2671,["** ippOdhum innum * inich chiRidhu ninRAlum *","eppOdhum IdhE sol en nenjchE! ** - eppOdhum","kai kazhalA nEmiyAn * nam mEl vinai kaDivAn *","moy kazhalE Eththa muyal"],["** இப்போதும் இன்னும் * இனிச் சிறிது நின்றாலும் *","எப்போதும் ஈதே சொல் என் நெஞ்சே! ** - எப்போதும்","கை கழலா நேமியான் * நம் மேல் வினை கடிவான் *","மொய் கழலே ஏத்த முயல்"],0,"/media/recitation/PTA.87.mp3"]],"box":["https://app.box.com/s/eqs86l97czi9i4ms8z90pwm3htzac8z6","07. periya thiruvandhAdhi [2585-2671].mp3",2585,2671]}]}