[[1,"பல்லாண்டு பல்லாண்டு பல்லாயிரத்தாண்டு","pallANDu pallANDu pallAyiraththANDu"],[2,"அடியோமோடும் நின்னோடும் பிரிவின்றி ஆயிரம் பல்லாண்டு","aDiyOmODum ninnODum pirivinRi Ayiram pallANDu"],[3,"வாழாட்பட்டு நின்றீர் உள்ளீரேல் வந்து மண்ணும் மணமும் கொண்மின்","vAzhATpaTTu ninRIr uLLIrEl vandhu maNNum maNamum koNmin"],[4,"ஏடு நிலத்தில் இடுவதன் முன்னம் வந்து எங்கள் குழாம் புகுந்து","eṭu nilattil iṭuvataṉ muṉṉam vantu ĕṅkal̤ kuzhām pukuntu"],[5,"அண்டக் குலத்துக்கு அதிபதி ஆகி அசுரர் இராக்கதரை","aNDak kulaththukku adhipadhi Agi asurar irAkkadharai"],[6,"எந்தை தந்தை தந்தை தந்தை தம் மூத்தப்பன் ஏழ்படிகால் தொடங்கி","endhai thandhai thandhai thandhai tham mUththappan EzhpaDikAl thoDanggi"],[7,"தீயில் பொலிகின்ற செஞ்சுடர் ஆழி திகழ் திருச்சக்கரத்தின்","thIyil poliginRa senjchuDar Azhi thigazh thiruchchakkaraththin"],[8,"நெய்யிடை நல்லதோர் சோறும் நியதமும் அத்தாணிச் சேவகமும்","neyyiDai nalladhOr sORum niyathamum aththANich sEvagamum"],[9,"உடுத்துக் களைந்த நின் பீதக ஆடை உடுத்துக் கலத்ததுண்டு","uDuththuk kaLaindha nin pIdhaga ADai uDuththuk kalaththadhuNDu"],[10,"எந்நாள் எம்பெருமான் உன்தனக்கு அடியோம் என்று எழுத்துப்பட்ட","ĕnnāl̤ ĕmpĕrumāṉ uṉtaṉakku aṭiyom ĕṉṟu ĕzhuttuppaṭṭa"],[11,"அல்வழக்கு ஒன்றும் இல்லா அணிகோட்டியர் கோன் அபிமானதுங்கன்","alvazhakku onRum illA aNikOTTiyar kOn abimAnathunggan"],[12,"பல்லாண்டென்று பவித்திரனைப் பரமேட்டியை சார்ங்கம் என்னும்","pallANDenRu paviththiranaip paramETTiyai sArnggam ennum"],[13,"வண்ண மாடங்கள் சூழ் திருக்கோட்டியூர்","vaNNa mADanggaL sUzh thirukkOTTiyUr"],[14,"ஓடுவார் விழுவார் உகந்தாலிப்பார்","ODuvAr vizhuvAr ugandhAlippAr"],[15,"பேணிச் சீருடைப் பிள்ளை பிறந்தினில்","pENich chIruDaip piLLai piRandhinil"],[16,"உறியை முற்றத்து உருட்டி நின்றாடுவார்","uRiyai muRRaththu uruTTi ninRADuvAr"],[17,"கொண்ட தாள் உறி கோலக் கொடு மழு","koNDa thAL uRi kOlak koDu mazhu"],[18,"கையும் காலும் நிமிர்த்துக் கடார நீர்","kaiyum kAlum nimirththuk kaDAra nIr"],[19,"வாயுள் வையகம் கண்ட மட நல்லார்","vAyuL vaiyagam kaNDa maDa nallAr"],[20,"பத்து நாளும் கடந்த இரண்டா நாள்","paththu nALum kaDandha iraNDA nAL"],[21,"கிடக்கில் தொட்டில் கிழிய உதைத்திடும்","kiDakkil thoTTil kizhiya udhaiththiDum"],[22,"செந்நெலார் வயல் சூழ் திருக்கோட்டியூர்","sennelAr vayal sUzh thirukkOTTiyUr"],[23,"சீதக் கடல் உள் அமுதன்ன தேவகி","sIdhak kaDal uL amudhanna dEvaki"],[24,"முத்தும் மணியும் வயிரமும் நன்பொன்னும்","muththum maNiyum vayiramum nanponnum"],[25,"பணைத் தோள் இளவாய்ச்சி பால் பாய்ந்த கொங்கை","paNaith thOL iLavAychchi pAl pAyndha konggai"],[26,"உழந்தாள் நறுநெய் ஓரோ தடா உண்ண","uzhandhAL naRuney OrO thaDA uNNa"],[27,"பிறங்கிய பேய்ச்சி முலை சுவைத்து உண்டிட்டு","piRanggiya pEychchi mulai suvaiththu uNDiTTu"],[28,"மத்தக் களிற்று வசுதேவர் தம்முடை","maththak kaLiRRu vasudEvar thammuDai"],[29,"இருங்கை மதகளிறு ஈர்க்கின்றவனை","iruṅkai matakal̤iṟu īrkkiṉṟavaṉai"],[30,"வந்த மதலைக் குழாத்தை வலி செய்து","vandha madhalaik kuzhAththai vali seydhu"],[31,"அதிருங் கடல்நிற வண்ணனை ஆய்ச்சி","atiruṅ kaṭalniṟa vaṇṇaṉai āycci"],[32,"பெரு மா உரலில் பிணிப்புண்டு இருந்து அங்கு","peru mA uralil piNippuNDu irundhu anggu"],[33,"நாள்கள் ஓர் நாலைந்து திங்கள் அளவிலே","nALgaL Or nAlaindhu thinggaL aLavilE"],[34,"மைத்தடங்கண்ணி அசோதை வளர்க்கின்ற","maiththaDangkaNNi asOdhai vaLarkkinRa"],[35,"வண்டமர் பூங்குழல் ஆய்ச்சி மகனாக","vaNDamar pUngkuzhal Aychchi maganAga"],[36,"எந்தொண்டை வாய்ச் சிங்கம் வாவென்று எடுத்துக் கொண்டு","enthoNDai vAych chinggam vAvenRu eDuththuk koNDu"],[37,"நோக்கி யசோதை நுணுக்கிய மஞ்சளால்","nOkki yasOdhai nuNukkiya manjchaLAl"],[38,"விண் கொள் அமரர்கள் வேதனை தீர முன்","viN koL amarargaL vEdhanai thIra mun"],[39,"பருவம் நிரம்பாமே பார் எல்லாம் உய்ய","paruvam nirambAmE pAr ellAm uyya"],[40,"மண்ணும் மலையும் கடலும் உலகேழும்","maNNum malaiyum kaDalum ulagEzhum"],[41,"முற்றிலும் தூதையும் முன் கை மேல் பூவையும்","muRRilum thUdhaiyum mun kai mEl pUvaiyum"],[42,"அழகிய பைம்பொன்னின் கோல் அங்கைக் கொண்டு","azhagiya paimponnin kOl angkaik koNDu"],[43,"சுருப்பார் குழலி அசோதை முன் சொன்ன","suruppAr kuzhali asOdhai mun sonna"],[44,"மாணிக்கம் கட்டி வயிரம் இடை கட்டி","mANikkam kaTTi vayiram iDai kaTTi"],[45,"உடையார் கனமணியோடு ஒண் மாதுளம்பூ","uṭaiyār kaṉamaṇiyoṭu ŏṇ mātul̤ampū"],[46,"என் தம்பிரானார் எழில் திருமார்வர்க்கு","ĕṉ tampirāṉār ĕzhil tirumārvarkku"],[47,"சங்கின் வலம்புரியும் சேவடிக் கிண்கிணியும்","sanggin valampuriyum sEvaDik kiNkiNiyum"],[48,"எழில் ஆர் திருமார்வுக்கு ஏற்கும் இவை என்று","ĕzhil ār tirumārvukku eṟkum ivai ĕṉṟu"],[49,"ஓதக் கடலின் ஒளிமுத்தின் ஆரமும்","otak kaṭaliṉ ŏl̤imuttiṉ āramum"],[50,"கானார் நறுந்துழாய் கை செய்த கண்ணியும்","kAnAr naRunthuzhAy kai seydha kaNNiyum"],[51,"கச்சொடு பொற்சுரிகை காம்பு கனகவளை","kaccŏṭu pŏṟcurikai kāmpu kaṉakaval̤ai"],[52,"மெய் திமிரும் நானப் பொடியொடு மஞ்சளும்","mĕy timirum nāṉap pŏṭiyŏṭu mañcal̤um"],[53,"வஞ்சனையால் வந்த பேய்ச்சி முலை உண்ட","vanjchanaiyAl vandha pEychchi mulai uNDa"],[54,"தன் முகத்துச் சுட்டி தூங்கத் தூங்கத் தவழ்ந்து போய்","than mugaththuch chuTTi thUnggath thUnggath thavazhndhu pOy"],[55,"என் சிறுக் குட்டன் எனக்கோர் இன்னமுது எம்பிரான்","en siRuk kuTTan enakkOr innamudhu empirAn"],[56,"சுற்றும் ஒளி வட்டம் சூழ்ந்து சோதி பரந்து எங்கும்","suRRum oLi vaTTam sUzhndhu sOdhi parandhu enggum"],[57,"சக்கரக் கையன் தடங்கண்ணால் மலர விழித்து","chakkarak kaiyan thaDangkaNNAl malara vizhiththu"],[58,"அழகிய வாயில் அமுத ஊறல் தெளிவுறா","azhagiya vAyil amudha URal theLivuRA"],[59,"தண்டொடு சக்கரம் சார்ங்கம் ஏந்தும் தடக்கையன்","thaNDoDu chakkaram sArnggam Endhum thaDakkaiyan"],[60,"பாலகன் என்று பரிபவம் செய்யேல் பண்டொரு நாள்","pAlagan enRu paribavam seyyEl paNDoru nAL"],[61,"சிறியன் என்று என் இளஞ்சிங்கத்தை இகழேல் கண்டாய்","siRiyan enRu en iLanjsinggaththai igazhEl kaNDAy"],[62,"தாழியில் வெண்ணெய் தடங்கை ஆர விழுங்கிய","thAzhiyil veNNey thaDangkai Ara vizhunggiya"],[63,"மைத் தடங்கண்ணி அசோதை தன் மகனுக்கு இவை","maith thaDangkaNNi asOdai than maganukku ivai"],[64,"உய்ய உலகு படைத்து உண்ட மணிவயிறா!","uyya ulagu paDaiththu uNDa maNivayiRA!"],[65,"கோளரியின் உருவங் கொண்டு அவுணன் உடலம்","kol̤ariyiṉ uruvaṅ kŏṇṭu avuṇaṉ uṭalam"],[66,"நம்முடை நாயகனே! நான்மறையின் பொருளே!","nammuDai nAyaganE! nAnmaRaiyin poruLE!"],[67,"வானவர் தாம் மகிழ வன்சகடம் உருள","vAnavar thAm magizha vansagaDam uruLa"],[68,"மத்தளவும் தயிரும் வார்குழல் நன்மடவார்","maththaLavum thayirum vArkuzhal nanmaDavAr"],[69,"காயமலர் நிறவா! கருமுகில் போல் உருவா!","kAyamalar niRavA! karumugil pOl uruvA!"],[70,"துப்புடை ஆயர்கள் தம் சொல் வழுவாது ஒருகால்","thuppuDai AyargaL tham sol vazhuvAdhu orukAl"],[71,"உன்னையும் ஒக்கலையில் கொண்டு தமில் மருவி","unnaiyum okkalaiyil koNDu thamil maruvi"],[72,"பாலொடு நெய் தயிர் ஒண் சாந்தொடு சண்பகமும்","pālŏṭu nĕy tayir ŏṇ cāntŏṭu caṇpakamum"],[73,"செங்கமலக் கழலில் சிற்றிதழ் போல் விரலில்","sengkamalak kazhalil siRRidhazh pOl viralil"],[74,"அன்னமும் மீனுருவும் ஆளரியும் குறளும்","annamum mInuruvum ALariyum kuRaLum"],[75,"மாணிக்கக் கிண்கிணி ஆர்ப்ப மருங்கின் மேல்","mANikkak kiNkiNi Arppa marunggin mEl"],[76,"பொன்னரை நாணொடு மாணிக்கக் கிண்கிணி","ponnarai nANoDu mANikkak kiNkiNi"],[77,"பன்மணி முத்தின் பவளம் பதித்தன்ன","panmaNi muththin pavaLam padhiththanna"],[78,"தூநிலா முற்றத்தே போந்து விளையாட","thUnilA muRRaththE pOndhu viLaiyADa"],[79,"புட்டியில் சேறும் புழுதியும் கொண்டு வந்து","puTTiyil sERum puzhudhiyum koNDu vandhu"],[80,"தாரித்து நூற்றுவர் தந்தை சொல் கொள்ளாது","thAriththu nURRuvar thandhai sol koLLAdhu"],[81,"பரந்திட்டு நின்ற படுகடல் தன்னை","parantiṭṭu niṉṟa paṭukaṭal taṉṉai"],[82,"குரக்கினத்தாலே குரை கடல் தன்னை","kurakkinaththAlE kurai kaDal thannai"],[83,"அளந்திட்ட தூணை அவன் தட்ட ஆங்கே","aLandhiTTa thUNai avan thaTTa AnggE"],[84,"அடைந்திட்டு அமரர்கள் ஆழ்கடல் தன்னை","aDaindhiTTu amarargaL AzhkaDal thannai"],[85,"ஆட்கொள்ளத் தோன்றிய ஆயர் தம் கோவினை","ATkoLLath thOnRiya Ayar tham kOvinai"],[86,"தொடர் சங்கிலிகை சலார் பிலார் என்னத் தூங்கு பொன்மணி ஒலிப்ப","thoDar sanggilikai salAr pilAr ennath thUnggu ponmaNi olippa"],[87,"செக்கர் இடை நுனிக்கொம்பில் தோன்றும் சிறுபிறை முளைப் போல","sekkar iDai nunikkombil thOnRum siRupiRai muLaip pOla"],[88,"மின்னுக் கொடியும் ஓர் வெண்திங்களும் சூழ் பரிவேடமுமாய்","minnuk koDiyum Or veNthinggaLum sUzh parivEDamumAy"],[89,"கன்னல் குடம் திறந்தால் ஒத்தூறிக் கணகண சிரித்து வந்து","kannal kuDam thiRandhAl oththURik kaNakaNa siriththu vandhu"],[90,"முன்னல் ஓர் வெள்ளிப் பெருமலைக் குட்டன் மொடுமொடு விரைந்தோட","munnal Or veLLip perumalaik kuTTan moDumoDu viraindhODa"],[91,"ஒரு காலில் சங்கு ஒரு காலில் சக்கரம் உள்ளடி பொறித்து அமைந்த","oru kAlil sanggu oru kAlil chakkaram uLLaDi poRiththu amaindha"],[92,"படர் பங்கய மலர் வாய் நெகிழப் பனி படு சிறு துளி போல்","paDar panggaya malar vAy negizhap pani paDu siRu thuLi pOl"],[93,"பக்கம் கரும் சிறுப்பாறை மீதே அருவிகள் பகர்ந்தனைய","pakkam karum chiRuppARai mIdhE aruvigaL pagarndhanaiya"],[94,"வெண்புழுதி மேல் பெய்து கொண்டு அளைந்ததோர் வேழத்தின் கருங்கன்று போல்","veNpuzhuthi mEl peydhu koNDu aLaindhadhOr vEzhaththin karungkanRu pOl"],[95,"திரை நீர்ச் சந்திர மண்டலம் போல் செங்கண்மால் கேசவன் தன்","thirai nIrch chandhira maNDalam pOl sengkaNmAl kEsavan than"],[96,"ஆயர் குலத்தினில் வந்து தோன்றிய அஞ்சன வண்ணன் தன்னைத்","Ayar kulaththinil vandhu thOnRiya anjchana vaNNan thannaith"],[97,"பொன்னியல் கிண்கிணி சுட்டி புறம் கட்டி","ponniyal kiNkiNi suTTi puRam kaTTi"],[98,"செங்கமலப் பூவில் தேன் உண்ணும் வண்டே போல்","sengkamalap pUvil thEn uNNum vaNDE pOl"],[99,"பஞ்சவர் தூதனாய்ப் பாரதம் கை செய்து","panjchavar thUdhanAyp bAratham kai seydhu"],[100,"நாறிய சாந்தம் நமக்கு இறை நல்கு என்ன","nāṟiya cāntam namakku iṟai nalku ĕṉṉa"],[101,"கழல் மன்னர் சூழக் கதிர் போல் விளங்கி","kazhal mannar sUzhak kadhir pOl viLanggi"],[102,"போர் ஒக்கப் பண்ணி இப்பூமிப் பொறை தீர்ப்பான்","pOr okkap paNNi ippUmip poRai thIrppAn"],[103,"மிக்க பெரும் புகழ் மாவலி வேள்வியில்","mikka perum pugazh mAvali vELviyil"],[104,"என்னிது மாயம்? என் அப்பன் அறிந்திலன்","ennidhu mAyam? en appan aRindhilan"],[105,"கண்ட கடலும் மலையும் உலகேழும்","kaNDa kaDalum malaiyum ulagEzhum"],[106,"துன்னிய பேர் இருள் சூழ்ந்து உலகை மூட","thunniya pEr iruL sUzhndhu ulagai mUDa"],[107,"நச்சுவார் முன் நிற்கும் நாராயணன் தன்னை","nachchuvAr mun niRkum nArAyaNan thannai"],[108,"வட்டு நடுவே வளர்கின்ற மாணிக்க","vaTTu naDuvE vaLarginRa mANikka"],[109,"கிண்கிணி கட்டிக் கிறி கட்டி கையினில்","kiNkiNi kaTTik kiRi kaTTi kaiyinil"],[110,"கத்தக் கதித்துக் கிடந்த பெருஞ்செல்வம்","kaththak kadhiththuk kiDandha perunjchelvam"],[111,"நாந்தகம் ஏந்திய நம்பி சரண் என்று","nAndhagam Endhiya nambi saraN enRu"],[112,"வெண்கலப் பத்திரம் கட்டி விளையாடி","veNkalap paththiram kaTTi viLaiyADi"],[113,"சத்திரம் ஏந்தித் தனி ஒரு மாணியாய்","chaththiram Endhith thani oru mANiyAy"],[114,"பொத்த உரலைக் கவிழ்த்து அதன் மேல் ஏறி","poththa uralaik kavizhththu adhan mEl ERi"],[115,"மூத்தவை காண முது மணற்குன்று ஏறி","mUththavai kANa mudhu maNaRkunRu ERi"],[116,"கற்பகக் காவு கருதிய காதலிக்கு","kaRpagak kAvu karudhiya kAdhalikku"],[117,"ஆய்ச்சி அன்றாழிப்பிரான் புறம் புல்கிய","Aychchi anRAzhippirAn puRam pulgiya"],[118,"மெச்சூது சங்கம் இடத்தான் நல் வேய் ஊதி","mechchUdhu sanggam iDaththAn nal vEy Udhi"],[119,"மலை புரை தோள் மன்னவரும் மாரதரும் மற்றும்","malai purai thOL mannavarum mAradharum maRRum"],[120,"காயும் நீர் புக்குக் கடம்பு ஏறி காளியன்","kāyum nīr pukkuk kaṭampu eṟi kāl̤iyaṉ"],[121,"இருட்டில் பிறந்து போய் ஏழை வல்லாயர்","iruTTil piRandhu pOy Ezhai vallAyar"],[122,"சேப்பூண்ட சாடு சிதறி திருடி நெய்க்கு","sEppUNDa sADu sidhaRi thiruDi neykku"],[123,"செப்பிள மென்முலைத் தேவகி நங்கைக்கு","seppiLa menmulaith dEvaki nanggaikku"],[124,"தத்துக் கொண்டாள் கொலோ? தானே பெற்றாள் கொலோ?","thaththuk koNDAL kolO? thAnE peRRAL kolO?"],[125,"கொங்கை வன் கூனி சொற்கொண்டு குவலயத்","konggai van kUni soRkoNDu kuvalayath"],[126,"பதக முதலை வாய்ப் பட்ட களிறு","padhaga mudhalai vAyp paTTa kaLiRu"],[127,"வல்லாள் இலங்கை மலங்கச் சரம் துரந்த","vallAL ilanggai malanggach charam thurandha"],[128,"அரவணையாய்! ஆயர் ஏறே! அம்மம் உண்ணத் துயில் எழாயே","aravaNaiyAy! Ayar ERE! ammam uNNath thuyil ezhAyE"],[129,"வைத்த நெய்யும் காய்ந்த பாலும் வடிதயிரும் நறுவெண்ணெயும்","vaiththa neyyum kAyndha pAlum vaDithayirum naRuveNNeyum"],[130,"தம் தம் மக்கள் அழுது சென்றால் தாய்மார் ஆவார் தரிக்க கில்லார்","tham tham makkaL azhudhu senRAl thAymAr AvAr tharikka killAr"],[131,"கஞ்சன் தன்னால் புணர்க்கப்பட்ட கள்ளச் சகடு கலக்கழிய","kanjchan thannAl puNarkkappaTTa kaLLach chakaDu kalakkazhiya"],[132,"தீய புந்திக் கஞ்சன் உன் மேல் சினம் உடையன் சோர்வு பார்த்து","thIya pundhik kanjchan un mEl sinam uDaiyan sOrvu pArththu"],[133,"மின்னனைய நுண்ணிடையார் விரிகுழல் மேல் நுழைந்த வண்டு","minnanaiya nuNNiDaiyAr virikuzhal mEl nuzhaindha vaNDu"],[134,"பெண்டிர் வாழ்வார் நின் ஒப்பாரைப் பெறுதும் என்னும் ஆசையாலே","peNDir vAzhvAr nin oppAraip peRudhum ennum AsaiyAlE"],[135,"இரு மலை போல் எதிர்ந்த மல்லர் இருவர் அங்கம் எரி செய்தாய்! உன்","iru malai pOl edhirndha mallar iruvar anggam eri seydhAy! un"],[136,"அங்கமலப் போதகத்தில் அணிகொள் முத்தம் சிந்தினாற் போல்","angkamalap pOdhagaththil aNikoL muththam sindhinAR pOl"],[137,"ஓட ஓடக் கிண்கிணிகள் ஒலிக்கும் ஓசைப் பாணியாலே","ODa ODak kiNkiNigaL olikkum Osaip pANiyAlE"],[138,"வாரணிந்த கொங்கை ஆய்ச்சி மாதவா! உண்ணென்ற மாற்றம்","vAraNindha konggai Aychchi mAdhavA! uNNenRa mARRam"],[139,"போய்ப்பாடுடைய நின் தந்தையும் தாழ்த்தான்","pOyppADuDaiya nin thandhaiyum thAzhththAn"],[140,"வண்ணப் பவள மருங்கினில் சாத்தி","vaṇṇap paval̤a maruṅkiṉil cātti"],[141,"வையம் எல்லாம் பெறும் வார்கடல் வாழும்","vaiyam ellAm peRum vArkaDal vAzhum"],[142,"வண நன்றுடைய வயிரக் கடிப்பிட்டு","vaNa nanRuDaiya vayirak kaDippiTTu"],[143,"சோத்தம் பிரான்! என்றிரந்தாலும் கொள்ளாய்","sOththam pirAn! enRirandhAlum koLLAy"],[144,"விண்ணெல்லாம் கேட்க அழுதிட்டாய்","viṇṇĕllām keṭka azhutiṭṭāy"],[145,"முலை ஏதும் வேண்டேன் என்றோடி","mulai Edhum vENDEn enRODi nin kAdhil"],[146,"என் குற்றமே என்று சொல்லவும் வேண்டா காண்","en kuRRamE enRu sollavum vENDA kAN"],[147,"மெய்யென்று சொல்லுவார் சொல்லைக் கருதித்","meyyenRu solluvAr sollaik karudhith"],[148,"காரிகையார்க்கும் உனக்கும் இழுக்குற்றென்?","kArigaiyArkkum unakkum izhukkuRRen?"],[149,"கண்ணைக் குளிரக் கலந்து எங்கும்","kaNNaik kuLirak kalandhu enggum nOkkik"],[150,"வா என்று சொல்லி என்கையைப் பிடித்து","vā ĕṉṟu cŏlli ĕṉkaiyaip piṭittu"],[151,"வார்காது தாழப் பெருக்கி அமைத்து","vArkAdhu thAzhap perukki amaiththu"],[152,"வெண்ணெய் அளைந்த குணுங்கும் விளையாடு புழுதியும் கொண்டு","veNNey aLaindha kuNunggum viLaiyADu puzhudhiyum koNDu"],[153,"கன்றுகள் ஓடச் செவியில் கட்டெறும்பு பிடித்திட்டால்","kanRugaL ODach cheviyil kaTTeRumbu piDiththiTTAl"],[154,"பேய்ச்சி முலை உண்ணக் கண்டு பின்னையும் நில்லாது என் நெஞ்சம்","pEychchi mulai uNNak kaNDu pinnaiyum nillAdhu en nenjcham"],[155,"கஞ்சன் புணர்ப்பினில் வந்த கடிய சகடம் உதைத்து","kanjchan puNarppinil vandha kaDiya sagaDam udhaiththu"],[156,"அப்பம் கலந்த சிற்றுண்டி அக்காரம் பாலில் கலந்து","appam kalandha siRRuNDi akkAram pAlil kalandhu"],[157,"எண்ணெய்க் குடத்தை உருட்டி இளம்பிள்ளை கிள்ளி எழுப்பி","ĕṇṇĕyk kuṭattai uruṭṭi il̤ampil̤l̤ai kil̤l̤i ĕzhuppi"],[158,"கறந்த நற்பாலும் தயிரும் கடைந்துறி மேல் வைத்த வெண்ணெய்","kaRandha naRpAlum thayirum kaDaindhuRi mEl vaiththa veNNey"],[159,"கன்றினை வால் ஓலை கட்டிக் கனிகள் உதிர எறிந்து","kanRinai vAlOlai kaTTik kanigaL udhira eRindhu"],[160,"பூணித் தொழுவினில் புக்குப் புழுதி அளைந்த பொன்மேனி","pUNith thozhuvinil pukkup puzhudhi aLaindha ponmEni"],[161,"கார்மலி மேனி நிறத்துக் கண்ண பிரானை உகந்து","kArmali mEni niRaththuk kaNNa pirAnai ugandhu"],[162,"பின்னை மணாளனைப் பேரில் கிடந்தானை","pinnai maNALanaip pEril kiDandhAnai"],[163,"பேயின் முலை உண்ட பிள்ளை இவன் முன்னம்","pEyin mulai uNDa piLLai ivan munnam"],[164,"திண்ணக் கலத்துத் திரை உறி மேல் வைத்த","thiNNak kalaththuth thirai uRi mEl vaiththa"],[165,"பள்ளத்தில் மேயும் பறவை உருக் கொண்டு","paLLaththil mEyum paRavai uruk koNDu"],[166,"கற்றினம் மேய்த்துக் கனிக்கு ஒரு கன்றினை","kaRRinam mEyththuk kanikku oru kanRinai"],[167,"கிழக்கில் குடி மன்னர் கேடிலாதாரை","kizhakkil kuDi mannar kEDilAdhArai"],[168,"பிண்டத் திரளையும் பேய்க்கிட்ட நீர்ச் சோறும்","piNDath thiraLaiyum pEykkiTTa nIrch chORum"],[169,"உந்தி எழுந்த உருவ மலர் தன்னில்","undhi ezhundha uruva malar thannil"],[170,"மன்னன் தன் தேவிமார் கண்டு மகிழ்வெய்த","mannan than thEvimAr kaNDu magizhveydha"],[171,"கண்டார் பழியாமே அக்காக்காய்! கார் வண்ணன்","kaNDAr pazhiyAmE akkAkkAy! kAr vaNNan"],[172,"வேலிக் கோல் வெட்டி விளையாடு வில்லேற்றி","vElik kOl veTTi viLaiyADu villERRi"],[173,"கொங்கும் குடந்தையும் கோட்டியூரும் பேரும்","konggum kuDandhaiyum kOTTiyUrum pErum"],[174,"கறுத்திட்டு எதிர் நின்ற கஞ்சனைக் கொன்றான்","kaRuththiTTu edhir ninRa kanjchanaik konRAn"],[175,"ஒன்றே உரைப்பான் ஒரு சொல்லே சொல்லுவான்","ŏṉṟe uraippāṉ ŏru cŏlle cŏlluvāṉ"],[176,"சீர் ஒன்று தூதாய்த் துரியோதனன் பக்கல்","sIr onRu thUdhAyth duriyOdanan pakkal"],[177,"ஆலத்திலையான் அரவினணை மேலான்","AlaththilaiyAn aravinaNai mElAn"],[178,"பொன் திகழ் சித்திரகூடப் பொருப்பினில்","pon thigazh chiththirakUDap poruppinil"],[179,"மின்னிடைச் சீதை பொருட்டா இலங்கையர்","minniDaich sIthai poruTTA ilanggaiyar"],[180,"தென்னிலங்கை மன்னன் சிரம் தோள் துணி செய்து","thennilanggai mannan siram thOL thuNi seydhu"],[181,"அக்காக்காய்! நம்பிக்குக் கோல் கொண்டு வா என்று","akkAkkAy! nambikkuk kOl koNDu vA enRu"],[182,"ஆனிரை மேய்க்க நீ போதி அருமருந்து ஆவது அறியாய்","āṉirai meykka nī poti arumaruntu āvatu aṟiyāy"],[183,"கருவுடை மேகங்கள் கண்டால் உன்னைக் கண்டால் ஒக்கும் கண்கள்","karuvuDai mEganggaL kaNDAl unnaik kaNDAl okkum kaNgaL"],[184,"மச்சொடு மாளிகை ஏறி மாதர்கள் தம்மிடம் புக்கு","machchoDu mALigai ERi mAdhargaL thammiDam pukku"],[185,"தெருவின்கண் நின்று இள ஆய்ச்சி மார்களைத் தீமை செய்யாதே","tĕruviṉkaṇ niṉṟu il̤a āycci mārkal̤ait tīmai cĕyyāte"],[186,"புள்ளினை வாய் பிளந்திட்டாய்! பொரு கரியின் கொம்பொசித்தாய்!","puLLinai vAy piLandhiTTAy! poru kariyin kombosiththAy!"],[187,"எருதுகளோடு பொருதி ஏதும் உலோபாய் காண் நம்பி!","erudhugaLODu porudhi Edhum ulObAy kAN nambi!"],[188,"குடங்கள் எடுத்து ஏற விட்டுக் கூத்தாட வல்ல எம் கோவே","kuṭaṅkal̤ ĕṭuttu eṟa viṭṭuk kūttāṭa valla ĕm kove"],[189,"சீமாலிகன் அவனோடு தோழமை கொள்ளவும் வல்லாய்!","sImAligan avanODu thOzhamai koLLavum vallAy!"],[190,"அண்டத்து அமரர்கள் சூழ அத்தாணியுள் அங்கிருந்தாய்!","aNDaththu amarargaL sUzha aththANiyuL anggirundhAy!"],[191,"செண்பக மல்லிகையோடு செங்கழுநீர் இருவாட்சி","seNbaga malligaiyODu sengkazhunIr iruvATchi"],[192,"இந்திரனோடு பிரமன் ஈசன் இமையவர் எல்லாம்","indhiranODu piraman Isan imaiyavar ellAm"],[193,"கன்றுகள் இல்லம் புகுந்து கதறுகின்ற பசு எல்லாம்","kanRugaL illam pugundhu kadhaRuginRa pasu ellAm"],[194,"செப்போது மென்முலையார்கள் சிறு சோறும் இல்லும் சிதைத்திட்டு","seppOdhu menmulaiyArgaL siRu sORum illum sidhaiththiTTu"],[195,"கண்ணில் மணல் கொடு தூவிக் காலினால் பாய்ந்தனை என்றென்று","kaNNil maNal koDu thUvik kAlinAl pAyndhanai enRenRu"],[196,"பல்லாயிரவர் இவ்வூரில் பிள்ளைகள் தீமைகள் செய்வார்","pallAyiravar ivvUril piLLaigaL thImaigaL seyvAr"],[197,"கஞ்சன் கறுக் கொண்டு நின் மேல் கரு நிறச் செம்மயிர்ப் பேயை","kanjchan kaRuk koNDu nin mEl karu niRach chemmayirp pEyai"],[198,"கள்ளச் சகடும் மருதும் கலக்கழிய உதை செய்த","kaLLach chagaDum marudhum kalakkazhiya udhai seyda"],[199,"இன்பம் அதனை உயர்த்தாய்! இமையவர்க்கு என்றும் அரியாய்!","inbam adhanai uyarththAy! imaiyavarkku enRum ariyAy!"],[200,"இருக்கொடு நீர் சங்கில் கொண்டிட்டு எழில் மறையோர் வந்து நின்றார்","irukkoDu nIr sanggil koNDiTTu ezhil maRaiyOr vandhu ninRAr"],[201,"போதமர் செல்வக் கொழுந்து புணர் திருவெள்ளறையானை","pOdhamar selvak kozhundhu puNar thiruveLLaRaiyAnai"],[202,"வெண்ணெய் விழுங்கி வெறும் கலத்தை","veNNey vizhunggi veRum kalaththai"],[203,"வருக வருக வருக இங்கே","varuga varuga varuga inggE"],[204,"திருவுடைப் பிள்ளை தான் தீயவாறு","thiruvuDaip piLLai thAn thIyavARu"],[205,"கொண்டல் வண்ணா! இங்கே போதராயே","koNDal vaNNA! inggE pOdharAyE"],[206,"பாலைக் கறந்து அடுப்பேற வைத்துப்","pAlaik kaRandhu aDuppERa vaiththup"],[207,"போதர் கண்டாய் இங்கே போதர் கண்டாய்","pOdhar kaNDAy inggE pOdhar kaNDAy"],[208,"செந்நெல் அரிசி சிறு பருப்புச்","sennel arisi siRu paruppuch"],[209,"கேசவனே! இங்கே போதராயே","kEsavanE! inggE pOdharAyE"],[210,"கன்னல் இலட்டுவத்தோடு சீடை","kaṉṉal ilaṭṭuvattoṭu cīṭai"],[211,"சொல்லில் அரசிப்படுதி நங்காய்!","sollil arasippaDudhi nanggAy!"],[212,"வண்டு களித்து இரைக்கும் பொழில் சூழ்","vaNDu kaLiththu iraikkum pozhil sUzh"],[213,"ஆற்றில் இருந்து விளையாடுவோங்களை","ARRil irundhu viLaiyADuvOnggaLai"],[214,"குண்டலம் தாழக் குழல் தாழ நாண் தாழ","kuNDalam thAzhak kuzhal thAzha nAN thAzha"],[215,"தடம் படு தாமரைப் பொய்கை கலக்கி","thaDam paDu thAmaraip poygai kalakki"],[216,"தேனுகன் ஆவி செகுத்துப் பனங்கனி","thEnugan Avi seguththup panangkani"],[217,"ஆய்ச்சியர் சேரி அளை தயிர் பால் உண்டு","Aychchiyar sEri aLai thayir pAl uNDu"],[218,"தள்ளித் தளர் நடை இட்டு இளம் பிள்ளையாய்","thaLLith thaLar naDai iTTu iLam piLLaiyAy"],[219,"மாவலி வேள்வியில் மாண் உருவாய்ச் சென்று","mAvali vELviyil mAN uruvAych chenRu"],[220,"தாழை தண்ணாம்பல் தடம் பெரும் பொய்கை வாய்","thAzhai thaNNAmbal thaDam perum poygai vAy"],[221,"வானத்து எழுந்த மழை முகில் போல் எங்கும்","vAnaththu ezhundha mazhai mugil pOl enggum"],[222,"அங்கமலக் கண்ணன் தன்னை அசோதைக்கு","angkamalak kaNNan thannai asOdhaikku"],[223,"தன்னேர் ஆயிரம் பிள்ளைகளோடு தளர் நடை இட்டு வருவான்","thannEr Ayiram piLLaigaLODu thaLar naDai iTTu varuvAn"],[224,"பொன் போல் மஞ்சனம் ஆட்டி அமுது ஊட்டிப் போனேன் வருமளவு இப்பால்","pon pOl manjchanam ATTi amudhu UTTip pOnEn varumaLavu ippAl"],[225,"கும்மாயத்தொடு வெண்ணெய் விழுங்கிக் குடத் தயிர் சாய்த்துப் பருகி","kummAyaththoDu veNNey vizhunggik kuDath thayir sAyththup parugi"],[226,"மையார் கண் மடவாய்ச்சியர் மக்களை மையன்மை செய்து அவர் பின் போய்","maiyAr kaN maDavAychchiyar makkaLai maiyanmai seydhu avar pin pOy"],[227,"முப்போதும் கடைந்து ஈண்டிய வெண்ணெயினோடு தயிரும் விழுங்கி","muppOdhum kaDaindhu INDiya veNNeyinODu thayirum vizhunggi"],[228,"கரும்பார் நீள் வயல் காய் கதிர்ச் செந்நெலைக் கற்றாநிரை மண்டித் தின்ன","karumbAr nIL vayal kAy kadhirch chennelaik kaRRAnirai maNDith thinna"],[229,"மருட்டார் மென்குழல் கொண்டு பொழில் புக்கு வாய் வைத்து அவ்வாயர் தம் பாடி","maruTTAr menkuzhal koNDu pozhil pukku vAy vaiththu avvAyar tham pADi"],[230,"வாளா ஆகிலும் காணகில்லார் பிறர் மக்களை மையன்மை செய்து","vāl̤ā ākilum kāṇakillār piṟar makkal̤ai maiyaṉmai cĕytu"],[231,"தாய்மார் மோர் விற்கப் போவர் தமப்பன்மார் கற்றாநிரைப் பின்பு போவர்","thAymAr mOr viRkap pOvar thamappanmAr kaRRAniraip pinbu pOvar"],[232,"தொத்தார் பூங்குழல் கன்னி ஒருத்தியைச் சோலைத் தடம் கொண்டு புக்கு","thoththAr pUngguzhal kanni oruththiyaich sOlaith thaDam koNDu pukku"],[233,"காரார் மேனி நிறத்து எம்பிரானைக் கடிகமழ் பூங்குழல் ஆய்ச்சி","kArAr mEni niRaththu empirAnaik kaDikamazh pUngkuzhal Aychchi"],[234,"அஞ்சன வண்ணனை ஆயர் கோலக் கொழுந்தினை","anjchana vaNNanai Ayar kOlak kozhundhinai"],[235,"பற்று மஞ்சள் பூசிப் பாவைமாரொடு பாடியில்","paRRu manjchaL pUsip pAvaimAroDu pADiyil"],[236,"நன்மணி மேகலை நங்கைமாரொடு நாள்தொறும்","nanmaNi mEgalai nanggaimAroDu nALthoRum"],[237,"வண்ணக் கருங்குழல் மாதர் வந்து அலர் தூற்றிட","vaNNak karungkuzhal mAdhar vandhu alar thURRiDa"],[238,"அவ்வவ் இடம் புக்கு அவ் ஆயர் பெண்டிர்க்கு அணுக்கனாய்","avvav iṭam pukku av āyar pĕṇṭirkku aṇukkaṉāy"],[239,"மிடறு மெழு மெழுத்தோட வெண்ணெய் விழுங்கிப் போய்","miDaRu mezhu mezhuththODa veNNey vizhunggip pOy"],[240,"வள்ளி நுடங்கிடை மாதர் வந்து அலர் தூற்றிட","vaLLi nuDanggiDai mAdhar vandhu alar thURRiDa"],[241,"பன்னிரு திங்கள் வயிற்றில் கொண்ட அப் பாங்கினால்","paṉṉiru tiṅkal̤ vayiṟṟil kŏṇṭa ap pāṅkiṉāl"],[242,"குடையும் செருப்பும் கொடாதே தாமோதரனை நான்","kuDaiyum seruppum koDAdhE dAmOdaranai nAn"],[243,"என்றும் எனக்கு இனியானை என் மணிவண்ணனை","enRum enakku iniyAnai en maNivaNNanai"],[244,"சீலைக் குதம்பை ஒரு காது ஒரு காது செந்நிற மேல் தோன்றிப் பூ","sIlaik kudhambai oru kAdhu oru kAdhu senniRa mEl thOnRip pU"],[245,"கன்னி நன்மாமதிள் சூழ் தரு பூம்பொழில் காவிரித் தென்னரங்கம்","kanni nanmAmadhiL sUzh tharu pUmpozhil kAvirith thennaranggam"],[246,"காடுகள் ஊடு போய்க் கன்றுகள் மேய்த்து மறியோடி கார்க்கோடல் பூச்","kADugaL UDu pOyk kanRugaL mEyththu maRiyODi kArkkODal pUch"],[247,"கடியார் பொழில் அணி வேங்கடவா! கரும் போரேறே! நீ உகக்கும்","kaDiyAr pozhil aNi vEngkaDavA! karum pOrERE! nI ugakkum"],[248,"பற்றார் நடுங்க முன் பாஞ்சசன்னியத்தை வாய் வைத்த போரேறே!","paRRAr naDungga mun pAnjchasanniyaththai vAy vaiththa pOrERE!"],[249,"அஞ்சுடர் ஆழி உன் கையகத்து ஏந்தும் அழகா! நீ பொய்கை புக்கு","anjchuDar Azhi un kaiyagaththu Endhum azhagA! nI poygai pukku"],[250,"பன்றியும் ஆமையும் மீனமும் ஆகிய பாற்கடல் வண்ணா உன்மேல்","paṉṟiyum āmaiyum mīṉamum ākiya pāṟkaṭal vaṇṇā uṉmel"],[251,"கேட்டு அறியாதன கேட்கின்றேன் கேசவா! கோவலர் இந்திரற்கு","kETTu aRiyAdhana kETkinREn kEsavA! kOvalar indhiraRku"],[252,"திண்ணார் வெண்சங்குடையாய்! திருநாள் திருவோணம் இன்றேழு நாள் முன்","thiNNAr veNsangguDaiyAy! thirunAL thiruvONam inREzhu nAL mun"],[253,"புற்றரவல்குல் அசோதை நல்லாய்ச்சி தன் புத்திரன் கோவிந்தனை","puRRaravalgul asOdhai nallAychchi than puththiran gOvindanai"],[254,"தழைகளும் தொங்கலும் ததும்பி எங்கும்","thazhaigaLum thonggalum thadhumbi enggum"],[255,"வல்லி நுண் இதழ் அன்ன ஆடை கொண்டு வசை அறத் திருவரை விரித்து உடுத்து","valli nuṇ itazh aṉṉa āṭai kŏṇṭu vacai aṟat tiruvarai virittu uṭuttu"],[256,"சுரிகையும் தெறிவில்லும் செண்டுகோலும்","surikaiyum theRivillum seNDukOlum"],[257,"குன்றெடுத்து ஆநிரை காத்த பிரான்","kunReDuththu Anirai kAththa pirAn"],[258,"சுற்றி நின்று ஆயர் தழைகள் இடச்","suRRi ninRu Ayar thazhaigaL iDach"],[259,"சிந்துரம் இலங்கத் தன் திருநெற்றி மேல்","sindhuram ilanggath than thiruneRRi mEl"],[260,"சாலப் பல் நிரைப் பின்னே தழைக் காவின் கீழ்","sAlap pal niraip pinnE thazhaik kAvin kIzh"],[261,"சிந்துரப் பொடிக் கொண்டு சென்னி அப்பித்","sindhurap poDik koNDu senni appith"],[262,"வலங்காதின் மேல்தோன்றிப் பூவணிந்து","valangkAdhin mElthOnRip pUvaNindhu"],[263,"விண்ணின் மீது அமரர்கள் விரும்பித் தொழ","viNNin mIdhu amarargaL virumbith thozha"],[264,"அட்டுக் குவி சோற்றுப் பருப்பதமும்","aTTuk kuvi sORRup paruppadhamum"],[265,"வழுவொன்றும் இல்லாச் செய்கை வானவர் கோன்","vazhuvonRum illAch cheygai vAnavar kOn"],[266,"அம்மைத்தடங்கண் மடவாய்ச்சியரும்","ammaiththaDanggaN maDavAychchiyarum"],[267,"கடுவாய்ச் சின வெங்கண் களிற்றினுக்குக்","kaDuvAych china vengkaN kaLiRRinukkuk"],[268,"வானத்தில் உள்ளீர்! வலியீர் உள்ளீரேல்","vAnaththil uLLIr! valiyIr uLLIrEl"],[269,"செப்பாடுடைய திருமால் அவன் தன்","seppADuDaiya thirumAl avan than"],[270,"படங்கள் பலவும் உடைப் பாம்பரையன்","paDanggaL palavum uDaip pAmbaraiyan"],[271,"சலமா முகில் பல்கணப் போர்க்களத்துச்","salamA mugil palkaNap pOrkkaLaththuch"],[272,"வன்பேய் முலை உண்டதோர் வாயுடையன்","vanpEy mulai uNDadhOr vAyuDaiyan"],[273,"கொடியேறு செந்தாமரைக் கை விரல்கள்","koDiyERu sendhAmaraik kai viralgaL"],[274,"அரவில் பள்ளி கொண்டு அரவம் துரந்திட்டு","aravil paLLi koNDu aravam thurandhiTTu"],[275,"நாவலம் பெரிய தீவினில் வாழும்","nAvalam periya thIvinil vAzhum"],[276,"இடவணரை இடத் தோளொடு சாய்த்து","iDavaNarai iDath thOLoDu sAyththu"],[277,"வான் இளவரசு வைகுந்தக் குட்டன்","vAn iLavarasu vaikundhak kuTTan"],[278,"தேனுகன் பிலம்பன் காளியன் என்னும்","thEnugan pilamban kALiyan ennum"],[279,"முன்னரசிங்கம் அதாகி அவுணன்","munnarasinggam adhAgi avuNan"],[280,"செம்பெரும் தடங்கண்ணன் திரள் தோளன்","semperum thaDangkaNNan thiraL thOLan"],[281,"புவியுள் நான் கண்டதோர் அற்புதம் கேளீர்","puviyuL nAn kaNDadhOr aRpudham kELIr"],[282,"சிறுவிரல்கள் தடவிப் பரிமாறச்","siRuviralgaL thaDavip parimARach"],[283,"திரண்டு எழு தழை மழை முகில் வண்ணன் செங்கமல மலர் சூழ் வண்டினம் போலே","tiraṇṭu ĕzhu tazhai mazhai mukil vaṇṇaṉ cĕṅkamala malar cūzh vaṇṭiṉam pole"],[284,"கருங்கண் தோகை மயில் பீலி அணிந்து","karungkaN thOgai mayil pIli aNindhu"],[285,"குழல் இருண்டு சுருண்டு ஏறிய குஞ்சிக் கோவிந்தனுடைய கோமள வாயில்","kuzhal iruṇṭu curuṇṭu eṟiya kuñcik kovintaṉuṭaiya komal̤a vāyil"],[286,"ஐய புழுதி உடம்பளைந்து இவள் பேச்சும் அலந்தலையாய்","aiya puzhudhi uDambaLaindhu ivaL pEchchum alandhalaiyAy"],[287,"வாயில் பல்லும் எழுந்தில மயிரும் முடி கூடிற்றில","vAyil pallum ezhundhila mayirum muDi kUDiRRila"],[288,"பொங்கு வெண்மணல் கொண்டு சிற்றிலும் முற்றத்து இழைக்கலுறில்","ponggu veNmaNal koNDu siRRilum muRRaththu izhaikkaluRil"],[289,"ஏழை பேதை ஓர் பாலகன் வந்து என் பெண்மகளை எள்கி","Ezhai pEdhai Or pAlagan vandhu en peNmagaLai eLgi"],[290,"நாடும் ஊரும் அறியவே போய் நல்ல துழாய் அலங்கல்","nADum Urum aRiyavE pOy nalla thuzhAy alanggal"],[291,"பட்டம் கட்டிப் பொற்றோடு பெய்து இவள் பாடகமும் சிலம்பும்","paTTam kaTTip poRRODu peydhu ivaL pADagamum silambum"],[292,"பேசவும் தரியாத பெண்மையின் பேதையேன் பேதை இவள்","pEsavum thariyAdha peNmaiyin pEdhaiyEn pEdhai ivaL"],[293,"காறை பூணும் கண்ணாடி காணும் தன் கையில் வளை குலுக்கும்","kARai pUNum kaNNADi kANum than kaiyil vaLai kulukkum"],[294,"கைத்தலத்துள்ள மாடழியக் கண்ணாலங்கள் செய்து இவளை","kaiththalaththuLLa mADazhiyak kaNNAlanggaL seydhu ivaLai"],[295,"பெருப் பெருத்த கண்ணாலங்கள் செய்து பேணி நம் இல்லத்துள்ளே","perup peruththa kaNNAlanggaL seydhu pENi nam illaththuLLE"],[296,"ஞால முற்றும் உண்டு ஆலிலைத் துயில் நாராயணனுக்கு இவள்","njAla muRRum uNDu Alilaith thuyil nArAyaNanukku ivaL"],[297,"நல்லதோர் தாமரைப் பொய்கை நாண்மலர் மேல் பனி சோர","nalladhOr thAmaraip poygai nANmalar mEl pani sOra"],[298,"ஒன்றும் அறிவு ஒன்றில்லாத உருவறைக் கோபாலர் தங்கள்","onRum aRivu onRillAdha uruvaRaik kOpAlar thanggaL"],[299,"குமரி மணஞ்செய்து கொண்டு கோலம் செய்து இல்லத்து இருத்தி","kumari maNanjcheydhu koNDu kOlam seydhu illaththu iruththi"],[300,"ஒரு மகள் தன்னை உடையேன் உலகம் நிறைந்த புகழால்","oru magaL thannai uDaiyEn ulagam niRaindha pugazhAl"],[301,"தம் மாமன் நந்தகோபாலன் தழீஇக் கொண்டு என் மகள் தன்னை","tham mAman nandhagOpAlan thazhIik koNDu en magaL thannai"],[302,"வேடர் மறக்குலம் போலே வேண்டிற்றுச் செய்து என் மகளை","vEDar maRakkulam pOlE vENDiRRuch cheydhu en magaLai"],[303,"அண்டத்து அமரர் பெருமான் ஆழியான் இன்று என் மகளை","aNDaththu amarar perumAn AzhiyAn inRu en magaLai"],[304,"குடியில் பிறந்தவர் செய்யும் குணம் ஒன்றும் செய்திலன் அந்தோ!","kuDiyil piRandhavar seyyum guNam onRum seydhilan andhO!"],[305,"வெண்ணிறத் தோய் தயிர் தன்னை வெள்வரைப்பின் முன் எழுந்து","veNNiRath thOy thayir thannai veLvaraippin mun ezhundhu"],[306,"மாயவன் பின் வழி சென்று வழியிடை மாற்றங்கள் கேட்டு","mAyavan pin vazhi senRu vazhiyiDai mARRanggaL kETTu"],[307,"என் நாதன் தேவிக்கு அன்று இன்பப்பூ ஈயாதாள்","en nAthan thEvikku anRu inbappU IyAdhAL"],[308,"என் வில் வலி கண்டு போ என்று எதிர் வந்தான்","ĕṉ vil vali kaṇṭu po ĕṉṟu ĕtir vantāṉ"],[309,"உருப்பிணி நங்கையைத் தேர் ஏற்றிக் கொண்டு","uruppiNi nanggaiyaith thEr ERRik koNDu"],[310,"மாற்றுத் தாய் சென்று வனம் போகே என்றிட","mARRuth thAy senRu vanam pOgE enRiDa"],[311,"பஞ்சவர் தூதனாய்ப் பாரதம் கை செய்து","panjchavar thUdhanAyp pAradham kai seydhu"],[312,"முடி ஒன்றி மூவுலகங்களும் ஆண்டு உன்","muDi onRi mUvulaganggaLum ANDu un"],[313,"காளியன் பொய்கை கலங்கப் பாய்ந்திட்டு அவன்","kALiyan poygai kalanggap pAyndhiTTu avan"],[314,"தார்க்கு இளந்தம்பிக்கு அரசீந்து தண்டகம்","thArkku iLanthambikku arasIndhu thaNDagam"],[315,"மாயச் சகடம் உதைத்து மருது இறுத்து","mAyach chakaDam udhaiththu marudhu iRuththu"],[316,"காரார் கடலை அடைத்திட்டு இலங்கை புக்கு","kArAr kaDalai aDaiththiTTu ilanggai pukku"],[317,"நந்தன் மதலையைக் காகுத்தனை நவின்று","nandhan madhalaiyaik kAguththanai navinRu"],[318,"நெறிந்த கருங்குழல் மடவாய்! நின் அடியேன் விண்ணப்பம்","neRindha karungkuzhal maDavAy! nin aDiyEn viNNappam"],[319,"அல்லி அம்பூமலர்க் கோதாய்! அடி பணிந்தேன் விண்ணப்பம்","alli ampUmalark kOdhAy! aDi paNindhEn viNNappam"],[320,"கலக்கிய மாமனத்தனளாய்க் கைகேசி வரம் வேண்ட","kalakkiya mAmanaththanaLAyk kaikEsi varam vENDa"],[321,"வார் அணிந்த முலை மடவாய்! வைதேவீ! விண்ணப்பம்","vAr aNindha mulai maDavAy! vaidhEvI! viNNappam"],[322,"மானமரு மென்னோக்கி! வைதேவீ! விண்ணப்பம்","mAnamaru mennOkki! vaidhEvI! viNNappam"],[323,"சித்திரகூடத்து இருப்பச் சிறு காக்கை முலை தீண்ட","chiththirakUDaththu iruppach chiRu kAkkai mulai thINDa"],[324,"மின்னொத்த நுண்ணிடையாய்! மெய்யடியேன் விண்ணப்பம்","minnoththa nuNNiDaiyAy! meyyaDiyEn viNNappam"],[325,"மைத்தகு மாமலர்க் குழலாய்! வைதேவீ! விண்ணப்பம்","maiththagu mAmalark kuzhalAy! vaidhEvI! viNNappam"],[326,"திக்கு நிறை புகழாளன் தீ வேள்விச் சென்ற நாள்","thikku niRai pugazhALan thI vELvich chenRa nAL"],[327,"வாராரும் முலை மடவாள் வைதேவி தனைக் கண்டு","vArArum mulai maDavAL vaidhEvi thanaik kaNDu"],[328,"கதிர் ஆயிரம் இரவி கலந்து எறித்தால் ஒத்த நீள் முடியன்","katir āyiram iravi kalantu ĕṟittāl ŏtta nīl̤ muṭiyaṉ"],[329,"நாந்தகம் சங்கு தண்டு நாணொலிச் சார்ங்கம் திருச்சக்கரம்","nAndhagam sanggu thaNDu nANolich sArnggam thiruchchakkaram"],[330,"கொலை யானைக் கொம்பு பறித்துக் கூடலர் சேனை பொருதழிய","kolai yAnaik kombu paRiththuk kUDalar sEnai porudhazhiya"],[331,"தோயம் பரந்த நடுவு சூழலில் தொல்லை வடிவு கொண்ட","thOyam parandha naDuvu sUzhalil thollai vaDivu koNDa"],[332,"நீரேறு செஞ்சடை நீலகண்டனும் நான்முகனும் முறையால்","nIrERu senjchaDai nIlakaNDanum nAnmuganum muRaiyAl"],[333,"பொல்லா வடிவுடைப் பேய்ச்சி துஞ்சப் புணர் முலை வாய் மடுக்க","pollA vaDivuDaip pEychchi thunjchap puNar mulai vAy maDukka"],[334,"வெள்ளை விளிசங்கு வெஞ்சுடர்த் திருச்சக்கரம் ஏந்து கையன்","veLLai viLisanggu venjchuDarth thiruchchakkaram Endhu kaiyan"],[335,"நாழிகை கூறிட்டுக் காத்து நின்ற அரசர்கள் தம் முகப்பே","nAzhigai kURiTTuk kAththu ninRa arasargaL tham mugappE"],[336,"மண்ணும் மலையும் மறிகடல்களும் மற்றும் யாவும் எல்லாம்","maNNum malaiyum maRikaDalgaLum maRRum yAvum ellAm"],[337,"கரிய முகில் புரை மேனி மாயனைக் கண்ட சுவடுரைத்து","kariya mugil purai mEni mAyanaik kaNDa suvaDuraiththu"],[338,"அலம்பா வெருட்டாக் கொன்று திரியும் அரக்கரை","alambA veruTTAk konRu thiriyum arakkarai"],[339,"வல்லாளன் தோளும் வாள் அரக்கன் முடியும் தங்கை","vallALan thOLum vAL arakkan muDiyum thanggai"],[340,"தக்கார் மிக்கார்களைச் சஞ்சலம் செய்யும் சலவரை","thakkAr mikkArgaLaich chanjchalam seyyum salavarai"],[341,"ஆனாயர் கூடி அமைத்த விழவை அமரர் தம்","AnAyar kUDi amaiththa vizhavai amarar tham"],[342,"ஒரு வாரணம் பணி கொண்டவன் பொய்கையில் கஞ்சன் தன்","oru vAraNam paNi koNDavan poygaiyil kanjchan than"],[343,"ஏவிற்றுச் செய்வான் ஏன்று எதிர்ந்து வந்த மல்லரை","EviRRuch cheyvAn EnRu edhirndhu vandha mallarai"],[344,"மன்னர் மறுக மைத்துனன்மார்க்கு ஒரு தேரின் மேல்","mannar maRuga maiththunanmArkku oru thErin mEl"],[345,"குறுகாத மன்னரைக் கூடு கலக்கி வெங்கானிடை","kuRugAdha mannaraik kUDu kalakki vengkAniDai"],[346,"சிந்தப் புடைத்துச் செங்குருதி கொண்டு பூதங்கள்","sindhap puDaiththuch chengkurudhi koNDu pUdhanggaL"],[347,"எட்டுத் திசையும் எண் இறந்த பெருந் தேவிமார்","ĕṭṭut ticaiyum ĕṇ- iṟanta pĕrun tevimār"],[348,"மருதப் பொழில் அணி மாலிருஞ் சோலை மலை தன்னை","marutap pŏzhil aṇi māliruñ colai malai taṉṉai"],[349,"உருப்பிணி நங்கை தன்னை மீட்பான் தொடர்ந்தோடிச் சென்ற","uruppiNi nanggai thannai mITpAn thoDarndhODich chenRa"],[350,"கஞ்சனும் காளியனும் களிறும் மருதும் எருதும்","kanjchanum kALiyanum kaLiRum marudhum erudhum"],[351,"மன்னு நரகன் தன்னைச் சூழ் போகி வளைத்து எறிந்து","mannu naragan thannaich chUzh pOgi vaLaiththu eRindhu"],[352,"மாவலி தன்னுடைய மகன் வாணன் மகள் இருந்த","mAvali thannuDaiya magan vANan magaL irundha"],[353,"பல பல நாழம் சொல்லிப் பழித்த சிசுபாலன் தன்னை","pala pala nAzham sollip pazhiththa sisupAlan thannai"],[354,"பாண்டவர் தம்முடைய பாஞ்சாலி மறுக்கம் எல்லாம்","pANDavar thammuDaiya pAnjchAli maRukkam ellAm"],[355,"கனங்குழையாள் பொருட்டாக் கணை பாரித்து அரக்கர் தங்கள்","kanangkuzhaiyAL poruTTAk kaNai pAriththu arakkar thanggaL"],[356,"எரி சிதறும் சரத்தால் இலங்கையினைத் தன்னுடைய","eri sidhaRum saraththAl ilanggaiyinaith thannuDaiya"],[357,"கோட்டு மண் கொண்டு இடந்து குடங்கையில் மண் கொண்டு அளந்து","kOTTu maN koNDu iDandhu kuDangkaiyil maN koNDu aLandhu"],[358,"ஆயிரம் தோள் பரப்பி முடி ஆயிரம் மின்னிலக","Ayiram thOL parappi muDi Ayiram minnilaga"],[359,"மாலிருஞ்சோலை என்னும் மலையை உடைய மலையை","māliruñcolai ĕṉṉum malaiyai uṭaiya malaiyai"],[360,"நாவகாரியம் சொல்லிலாதவர் நாள்தொறும் விருந்தோம்புவார்","nAvakAriyam sollilAdhavar nALthoRum virundhOmbuvAr"],[361,"குற்றமின்றிக் குணம் பெருக்கிக் குருக்களுக்கு அனுகூலராய்","kuRRaminRik guNam perukkik gurukkaLukku anukUlarAy"],[362,"வண்ண நன்மணியும் மரதகமும் அழுத்தி நிழல் எழும்","vaNNa nanmaNiyum maradhagamum azhuththi nizhal ezhum"],[363,"உரக மெல் அணையான் கையில் உறை சங்கம் போல் மட அன்னங்கள்","uraka mĕl aṇaiyāṉ kaiyil uṟai caṅkam pol maṭa aṉṉaṅkal̤"],[364,"ஆமையின் முதுகத்திடைக் குதி கொண்டு தூமலர் சாடிப் போய்","Amaiyin mudhugaththiDaik kudhi koNDu thUmalar sADip pOy"],[365,"பூதம் ஐந்தொடு வேள்வி ஐந்து புலன்கள் ஐந்து பொறிகளால்","pUdham aindhoDu vELvi aindhu pulankaL aindhu poRigaLAl"],[366,"குருந்தம் ஒன்று ஒசித்தானொடும் சென்று கூடி ஆடி விழாச் செய்து","kurundham onRu osiththAnoDum senRu kUDi ADi vizhAch cheydhu"],[367,"நளிர்ந்த சீலன் நயாசலன் அபிமானதுங்கனை நாள்தொறும்","naLirndha sIlan nayAsalan abimAnathungganai nALthoRum"],[368,"கொம்பினார் பொழில் வாய் குயில் இனம் கோவிந்தன் குணம் பாடு சீர்","kombinAr pozhil vAy kuyil inam gOvindhan guNam pADu sIr"],[369,"காசின் வாய்க் கரம் விற்கிலும் கரவாது மாற்றிலி சோறிட்டு","kAsin vAyk karam viRkilum karavAdhu mARRili sORiTTu"],[370,"சீத நீர் புடை சூழ் செழுங் கழனி உடைத் திருக்கோட்டியூர்","cīta nīr puṭai cūzh cĕzhuṅ kazhaṉi uṭait tirukkoṭṭiyūr"],[371,"ஆசைவாய்ச் சென்ற சிந்தையராகி","AsaivAych chenRa sindhaiyarAgi"],[372,"சீயினால் செறிந்து ஏறிய புண்மேல் செற்றல் ஏறிக் குழம்பு இருந்து எங்கும்","cīyiṉāl cĕṟintu eṟiya puṇmel cĕṟṟal eṟik kuzhampu iruntu ĕṅkum"],[373,"சோர்வினால் பொருள் வைத்தது உண்டாகில்","sOrvinAl poruL vaiththadhu uNDAgil"],[374,"மேல் எழுந்ததோர் வாயுக் கிளர்ந்து","mEl ezhundhadhOr vAyuk kiLarndhu"],[375,"மடி வழி வந்து நீர் புலன்சோர வாயில் அட்டிய கஞ்சியும் மீண்டே","maṭi vazhi vantu nīr pulaṉcora vāyil aṭṭiya kañciyum mīṇṭe"],[376,"அங்கம் விட்டு அவை ஐந்தும் அகற்றி ஆவி மூக்கினிற் சோதித்த பின்னை","aṅkam viṭṭu avai aintum akaṟṟi āvi mūkkiṉiṟ cotitta piṉṉai"],[377,"தென்னவன் தமர் செப்பம் இலாதார்","thennavan thamar seppam ilAdhAr"],[378,"கூடிக் கூடி உற்றார்கள் இருந்து","kUDik kUDi uRRArgaL irundhu"],[379,"வாய் ஒரு பக்கம் வாங்கி வலிப்ப வார்ந்த நீர்க் குழிக் கண்கள் மிழற்ற","vāy ŏru pakkam vāṅki valippa vārnta nīrk kuzhik kaṇkal̤ mizhaṟṟa"],[380,"செத்துப் போவதோர் போது நினைந்து","seththup pOvadhOr pOdhu ninaindhu"],[381,"காசும் கறையுடைக் கூறைக்கும் அங்கோர் கற்றைக்கும்","kAsum kaRaiyuDaik kURaikkum anggOr kaRRaikkum"],[382,"அங்கொரு கூறை அரைக்குடுப்பதன் ஆசையால்","anggoru kURai araikkuDuppadhan AsaiyAl"],[383,"உச்சியில் எண்ணெயும் சுட்டியும் வளையும் உகந்து","uchchiyil eNNeyum chuTTiyum vaLaiyum ugandhu"],[384,"மானிட சாதியில் தோன்றிற்றோர் மானிட சாதியை","mAniDa sAdhiyil thOnRiRROr mAniDa sAdhiyai"],[385,"மலமுடை ஊத்தையில் தோன்றிற்றோர் மல ஊத்தையை","malamuDai Uththaiyil thOnRiRROr mala Uththaiyai"],[386,"நாடும் நகரும் அறிய மானிடப் பேர் இட்டு","nADum nagarum aRiya mAniDap pEr iTTu"],[387,"மண்ணில் பிறந்து மண்ணாகும் மானிடப் பேர் இட்டு அங்கு","maNNil piRandhu maNNAgum mAniDap pEr iTTu anggu"],[388,"நம்பி பிம்பி என்று நாட்டு மானிடப் பேர் இட்டால்","nampi pimpi ĕṉṟu nāṭṭu māṉiṭap per iṭṭāl"],[389,"ஊத்தைக் குழியில் அமுதம் பாய்வது போல் உங்கள்","Uththaik kuzhiyil amudham pAyvadhu pOl unggaL"],[390,"சீரணிமால் திருநாமமே இடத் தேற்றிய","sIraNimAl thirunAmamE iDath thERRiya"],[391,"தங்கையை மூக்கும் தமையனைத் தலையும் தடிந்த எம் தாசரதி போய்","taṅkaiyai mūkkum tamaiyaṉait talaiyum taṭinta ĕm tācarati poy"],[392,"சலம் பொதி உடம்பின் தழல் உமிழ் பேழ் வாய்ச்","salam podhi uDambin thazhal umizh pEzh vAych"],[393,"அதிர்முகம் உடைய வலம்புரி குமிழ்த்தி","adhirmugam uDaiya valampuri kumizhththi"],[394,"இமையவர் இறுமாந்திருந்து அரசாள","imaiyavar iRumAndhirundhu arasALa"],[395,"உழுவதோர் படையும் உலக்கையும் வில்லும்","uzhuvadhOr paDaiyum ulakkaiyum villum"],[396,"தலைபெய்து குமுறிச் சலம் பொதி மேகம் சலசல பொழிந்திடக் கண்டு","talaipĕytu kumuṟic calam pŏti mekam calacala pŏzhintiṭak kaṇṭu"],[397,"விற்பிடித்து இறுத்து வேழத்தை முறுக்கி","viRpiDiththu iRuththu vEzhaththai muRukki"],[398,"திரைபொரு கடல் சூழ் திண்மதிள் துவரை","thiraiporu kaDal sUzh thiNmadhiL thuvarai"],[399,"வடதிசை மதுரை சாளக்கிராமம்","vaDathisai madhurai sALakkirAmam"],[400,"மூன்றெழுத்து அதனை மூன்றெழுத்து அதனால்","mUnRezhuththu adhanai mUnRezhuththu adhanAl"],[401,"பொங்கொலி கங்கைக் கரை மலி கண்டத்து","ponggoli ganggaik karai mali kaNDaththu"],[402,"மாதவத்தோன் புத்திரன் போய் மறிகடல் வாய் மாண்டானை","mAthavaththOn puththiran pOy maRikaDal vAy mANDAnai"],[403,"பிறப்பகத்தே மாண்டு ஒழிந்த பிள்ளைகளை நால்வரையும்","piRappagaththE mANDu ozhindha piLLaigaLai nAlvaraiyum"],[404,"மருமகன் தன் சந்ததியை உயிர் மீட்டு மைத்துனன்மார்","marumagan than sandhadhiyai uyir mITTu maiththunanmAr"],[405,"கூன் தொழுத்தை சிதகுரைப்பக் கொடியவள் வாய்க் கடிய சொல் கேட்டு","kUn thozhuththai sidhaguraippak koDiyavaL vAyk kaDiya sol kETTu"],[406,"பெரு வரங்கள் அவை பற்றிப் பிழக்குடைய இராவணனை","peru varanggaL avai paRRip pizhakkuDaiya irAvaNanai"],[407,"கீழ் உலகில் அசுரர்களைக் கிழங்கிருந்து கிளராமே","kIzh ulagil asurargaLaik kizhanggirundhu kiLarAmE"],[408,"கொழுப்புடைய செழுங்குருதி கொழித்திழிந்து குமிழ்த்தெறிய","kozhuppuDaiya sezhungkurudhi kozhiththizhindhu kumizhththeRiya"],[409,"வல் எயிற்றுக் கேழலுமாய் வாள் எயிற்றுச் சீயமுமாய்","val eyiRRuk kEzhalumAy vAL eyiRRuch chIyamumAy"],[410,"குன்றாடு கொழுமுகில் போல் குவளைகள் போல் குரைகடல் போல்","kunRADu kozhumugil pOl kuvaLaigaL pOl kuraikaDal pOl"],[411,"பரு வரங்கள் அவை பற்றிப் படை ஆலித்து எழுந்தானை","paru varanggaL avai paRRip paDai Aliththu ezhundhAnai"],[412,"மரவடியைத் தம்பிக்கு வான்பணையம் வைத்துப்போய் வானோர் வாழ","maravaṭiyait tampikku vāṉpaṇaiyam vaittuppoy vāṉor vāzha"],[413,"தன் அடியார் திறத்தகத்துத்","thannaDiyAr thiRaththagaththuth"],[414,"கருள் உடைய பொழில் மருதும் கதக் களிறும் பிலம்பனையும் கடிய மாவும்","karul̤ uṭaiya pŏzhil marutum katak kal̤iṟum pilampaṉaiyum kaṭiya māvum"],[415,"பதினாறாம் ஆயிரவர் தேவிமார் பணி","padhinARAm Ayiravar dhEvimAr paNi"],[416,"ஆமையாய்க் கங்கையாய் ஆழ்கடலாய்","AmaiyAyk ganggaiyAy AzhkaDalAy"],[417,"மைத்துனன்மார் காதலியை மயிர் முடிப்பித்து","maiththunanmAr kAdhaliyai mayir muDippiththu"],[418,"குறட் பிரமசாரியாய் மாவலியைக்","kuRaT piramasAriyAy mAvaliyaik"],[419,"உரம் பற்றி இரணியனை உகிர் நுதியால்","uram paRRi iraNiyanai ugir nudhiyAl"],[420,"தேவு உடைய மீனமாய் ஆமையாய் ஏனமாய் அரியாய்க் குறளாய்","tevu uṭaiya mīṉamāy āmaiyāy eṉamāy ariyāyk kuṟal̤āy"],[421,"செருவாளும் புள்ளாளன் மண்ணாளன்","seruvALum puLLALan maNNALan"],[422,"கைந்நாகத்து இடர் கடிந்த கனல் ஆழிப்","kainnAgaththu iDar kaDindha kanal Azhip"],[423,"துப்புடையாரை அடைவதெல்லாம்","thuppuDaiyArai aDaivadhellAm"],[424,"சாமிடத்து என்னைக் குறிக்கொள் கண்டாய்","sAmiDaththu ennaik kuRikkoL kaNDAy"],[425,"எல்லையில் வாசல் குறுகச் சென்றால்","ellaiyil vAsal kuRugach chenRAl"],[426,"ஒற்றை விடையனும் நான்முகனும்","oRRai viDaiyanum nAnmuganum"],[427,"பையரவினணைப் பாற்கடலுள்","paiyaravinaNaip pARkaDaluL"],[428,"தண்ணன இல்லை நமன் தமர்கள்","thaNNana illai naman thamargaL"],[429,"செஞ்சொல் மறைப் பொருள் ஆகி நின்ற","senjchol maRaip poruL Agi ninRa"],[430,"நான் ஏதும் உன் மாயம் ஒன்றறியேன்","nAn Edhum un mAyam onRaRiyEn"],[431,"குன்றெடுத்து ஆநிரை காத்த ஆயா!","kunReDuththu Anirai kAththa AyA!"],[432,"மாயவனை மதுசூதனனை","mAyavanai madhusUdhananai"],[433,"வாக்குத் தூய்மை இலாமையினாலே","vAkkuth thUymai ilAmaiyinAlE"],[434,"சழக்கு நாக்கொடு புன்கவி சொன்னேன்","sazhakku nAkkoDu punkavi sonnEn"],[435,"நன்மை தீமைகள் ஒன்றும் அறியேன்","nanmai thImaigaL onRum aRiyEn"],[436,"நெடுமையால் உலகேழும் அளந்தாய்!","neDumaiyAl ulagEzhum aLandhAy!"],[437,"தோட்டம் இல்லவள் ஆத்தொழு ஓடை","thOTTam illavaL Aththozhu ODai"],[438,"கண்ணா! நான்முகனைப் படைத்தானே!","kaNNA! nAnmuganaip paDaiththAnE!"],[439,"வெள்ளை வெள்ளத்தின் மேல் ஒரு பாம்பை","veLLai veLLaththin mEl oru pAmbai"],[440,"வண்ண மால் வரையே குடையாக","vaNNa mAl varaiyE kuDaiyAga"],[441,"நம்பனே! நவின்று ஏத்த வல்லார்கள்","nambanE! navinRu Eththa vallArgaL"],[442,"காமர் தாதை கருதலர் சிங்கம்","kAmar thAdhai karudhalar singgam"],[443,"நெய்க்குடத்தைப் பற்றி ஏறும் எறும்புகள் போல் நிரந்து எங்கும்","neykkuDaththaip paRRi ERum eRumbugaL pOl nirandhu enggum"],[444,"சித்திரகுத்தன் எழுத்தால் தென்புலக்கோன் பொறி ஒற்றி","chiththirakuththan ezhuththAl thenpulakkOn poRi oRRi"],[445,"வயிற்றில் தொழுவைப் பிரித்து வன்புலச் சேவை அதக்கி","vayiRRil thozhuvaip piriththu vanpulach chEvai adhakki"],[446,"மங்கிய வல்வினை நோய்காள்! உமக்கும் ஓர் வல்வினை கண்டீர்","manggiya valvinai nOygAL! umakkum Or valvinai kaNDIr"],[447,"மாணிக்குறள் உருவாய மாயனை என் மனத்துள்ளே","mANikkuRaL uruvAya mAyanai en manaththuLLE"],[448,"உற்ற உறு பிணி நோய்காள்! உமக்கு ஒன்று சொல்லுகேன் கேண்மின்","uRRa uRu piNi nOygAL! umakku onRu sollugEn kENmin"],[449,"கொங்கைச் சிறுவரை என்னும் பொதும்பினில் வீழ்ந்து வழுக்கி","konggaich chiRuvarai ennum podhumbinil vIzhndhu vazhukki"],[450,"ஏதங்கள் ஆயின எல்லாம் இறங்கல் இடுவித்து என்னுள்ளே","etaṅkal̤ āyiṉa ĕllām iṟaṅkal iṭuvittu ĕṉṉul̤l̤e"],[451,"உறகல் உறகல் உறகல் ஒண்சுடர் ஆழியே! சங்கே!","uṟakal uṟakal uṟakal ŏṇcuṭar āzhiye! caṅke!"],[452,"அரவத்து அமளியினோடும் அழகிய பாற்கடலோடும்","aravaththu amaLiyinODum azhagiya pARkaDalODum"],[453,"துக்கச் சுழலையைச் சூழ்ந்து கிடந்த வலையை அறப்பறித்து","tukkac cuzhalaiyaic cūzhntu kiṭanta valaiyai aṟappaṟittu"],[454,"வளைத்து வைத்தேன் இனிப் போகல் ஒட்டேன்","vaLaiththu vaiththEn inip pOgal oTTEn"],[455,"உனக்குப் பணி செய்திருக்கும் தவம்","unakkup paNi seydhirukkum thavam"],[456,"காதம் பலவும் திரிந்து உழன்றேற்கு","kAdham palavum thirindhu uzhanRERku"],[457,"காலும் எழா கண்ண நீரும் நில்லா உடல் சோர்ந்து நடுங்கி குரல்","kālum ĕzhā kaṇṇa nīrum nillā uṭal corntu naṭuṅki kural"],[458,"எருத்துக் கொடி உடையானும்","eruththuk koDi uDaiyAnum"],[459,"அக்கரை என்னும் அனத்தக் கடலுள்","akkarai ennum anaththak kaDaluL"],[460,"எத்தனை காலமும் எத்தனை ஊழியும்","eththanai kAlamum eththanai Uzhiyum"],[461,"அன்று வயிற்றில் கிடந்து இருந்தே","anRu vayiRRil kiDandhu irundhE"],[462,"சென்று உலகம் குடைந்து ஆடும் சுனைத்","senRu ulagam kuDaindhu ADum sunaith"],[463,"சென்னியோங்கு தண்திருவேங்கடம் உடையாய்! உலகு","senniyOnggu thaNthiruvEngkaDam uDaiyAy! ulagu"],[464,"பறவை ஏறு பரம்புருடா! நீ என்னைக் கைக்கொண்ட பின்","paRavai ERu parampuruDA! nI ennaik kaikkoNDa pin"],[465,"எம்மனா! என் குல தெய்வமே! என்னுடை நாயகனே!","emmanA! en kula dheyvamE! ennuDai nAyaganE!"],[466,"கடல் கடைந்து அமுதம் கொண்டு கலசத்தை நிறைத்தாற்போல்","kaṭal kaṭaintu amutam kŏṇṭu kalacattai niṟaittāṟpol"],[467,"பொன்னைக் கொண்டு உரைகல் மீதே நிறம் எழ உரைத்தாற் போல்","ponnaik koNDu uraikal mIdhE niRam ezha uraiththAR pOl"],[468,"உன்னுடைய விக்கிரமம் ஒன்றொழியாமல் எல்லாம்","unnuDaiya vikkiramam onRozhiyAmal ellAm"],[469,"பருப்பதத்துக் கயல் பொறித்த பாண்டியர் குலபதி போல்","paruppadhaththuk kayal poRiththa pANDiyar kulapadhi pOl"],[470,"அனந்தன் பாலும் கருடன் பாலும் ஐது நொய்தாக வைத்து என்","ananthan pAlum karuDan pAlum aidhu noydhAga vaiththu en"],[471,"பனிக்கடலில் பள்ளிகோளைப் பழக விட்டு ஓடி வந்து என்","panikkaDalil paLLikOLaip pazhaga viTTu ODi vandhu en"],[472,"தடவரை வாய் மிளிர்ந்து மின்னும் தவள நெடுங்கொடிப் போல்","thaDavarai vAy miLirndhu minnum thavaLa neDungkoDip pOl"],[473,"வேயர் தங்கள் குலத்து உதித்த விட்டுசித்தன் மனத்தே","vEyar thanggaL kulathth uudhiththa viTTuchiththan manaththE"],[474,"மார்கழித் திங்கள் மதி நிறைந்த நன்னாளால்","mArgazhith thinggaL madhi niRaindha nannALAl"],[475,"வையத்து வாழ்வீர்காள்! நாமும் நம் பாவைக்குச்","vaiyaththu vAzhvIrgAL! nAmum nam pAvaikkuch"],[476,"ஓங்கி உலகு அளந்த உத்தமன் பேர் பாடி","oṅki ulaku al̤anta uttamaṉ per pāṭi"],[477,"ஆழி மழைக் கண்ணா! ஒன்று நீ கை கரவேல்","Azhi mazhaik kaNNA! onRu nI kai karavEl"],[478,"மாயனை மன்னு வடமதுரை மைந்தனை","mAyanai mannu vaDamadhurai maindhanai"],[479,"புள்ளும் சிலம்பின காண் புள் அரையன் கோயில்","puLLum silambina kAN puL araiyan kOyil"],[480,"கீசு கீசென்று எங்கும் ஆனைச்சாத்தன் கலந்து","kIsu kIsenRu enggum AnaichchAththan kalandhu"],[481,"கீழ்வானம் வெள்ளென்று எருமை சிறுவீடு","kIzhvAnam veLLenRu erumai siRuvIDu"],[482,"தூமணி மாடத்துச் சுற்றும் விளக்கு எரியத்","thUmaNi mADaththuch suRRum viLakku eriyath"],[483,"நோற்றுச் சுவர்க்கம் புகுகின்ற அம்மனாய்!","nORRuch suvarkkam pugukinRa ammanAy!"],[484,"கற்றுக் கறவைக் கணங்கள் பல கறந்து","kaRRuk kaRavaik kaNanggaL pala kaRandhu"],[485,"கனைத்து இளம் கற்றெருமை கன்றுக்கு இரங்கி","kanaiththu iLam kaRRerumai kanRukku iranggi"],[486,"புள்ளின் வாய் கீண்டானைப் பொல்லா அரக்கனை","puLLin vAy kINDAnaip pollA arakkanai"],[487,"உங்கள் புழைக்கடைத் தோட்டத்து வாவியுள்","uṅkal̤ puḻaikkaṭait toṭṭattu vāviyul̤"],[488,"எல்லே! இளங்கிளியே! இன்னம் உறங்குதியோ!","ellE! iLangkiLiyE! innam uRanggudhiyO!"],[489,"நாயகனாய் நின்ற நந்தகோபனுடைய","nāyakaṉāy niṉṟa nantakopaṉuṭaiya"],[490,"அம்பரமே தண்ணீரே சோறே அறம் செய்யும்","ambaramE thaNNIrE sORE aRam seyyum"],[491,"உந்து மத களிற்றன் ஓடாத தோள் வலியன்","undhu madha kaLiRRan ODAdha thOL valiyan"],[492,"குத்து விளக்கு எரியக் கோட்டுக்கால் கட்டில் மேல்","kuttu vil̤akku ĕriyak koṭṭukkāṟ kaṭṭil mel"],[493,"முப்பத்து மூவர் அமரர்க்கு முன் சென்று","muppaththu mUvar amararkku mun senRu"],[494,"ஏற்ற கலங்கள் எதிர் பொங்கி மீதளிப்ப","ERRa kalanggaL edhir ponggi mIdhaLippa"],[495,"அங்கண் மா ஞாலத்தரசர் அபிமான","angkaN mA njAlaththarasar abimAna"],[496,"மாரி மலை முழைஞ்சில் மன்னிக் கிடந்து உறங்கும்","mAri malai muzhainjchil mannik kiDandhu uRanggum"],[497,"அன்று இவ்வுலகம் அளந்தாய்! அடி போற்றி","anRu ivvulagam aLandhAy! aDi pORRi"],[498,"ஒருத்தி மகனாய்ப் பிறந்து ஓர் இரவில்","oruththi maganAyp piRandhu Or iravil"],[499,"மாலே! மணிவண்ணா! மார்கழி நீராடுவான்","mAlE! maNivaNNA! mArgazhi nIrADuvAn"],[500,"கூடாரை வெல்லும் சீர்க் கோவிந்தா! உன்தன்னைப்","kUDArai vellum sIrk gOvindhA! undhannaip"],[501,"கறவைகள் பின் சென்று கானம் சேர்ந்து உண்போம்","kaRavaigaL pin senRu kAnam sErndhu uNbOm"],[502,"சிற்றம் சிறு காலே வந்து உன்னைச் சேவித்து உன்","chiRRam chiRu kAlE vandhu unnaich sEviththu un"],[503,"வங்கக் கடல் கடைந்த மாதவனைக் கேசவனைத்","vanggak kaDal kaDaindha mAdhavanaik kEsavanaith"],[504,"தையொரு திங்களும் தரை விளக்கித்","thaiyoru thinggaLum tharai viLakkith"],[505,"வெள்ளை நுண்மணற் கொண்டு தெருவணிந்து","veLLai nuNmaNaR koNDu theruvaNindhu"],[506,"மத்த நன்னறுமலர் முருக்கமலர்","maththa nannaRumalar murukkamalar"],[507,"சுவரில் புராண! நின் பேர் எழுதிச்","suvaril purANa! nin pEr ezhudhich"],[508,"வானிடை வாழும் அவ்வானவர்க்கு","vAniDai vAzhum avvAnavarkku"],[509,"உருவுடையார் இளையார்கள் நல்லார்","uruvuDaiyAr iLaiyArgaL nallAr"],[510,"காயுடை நெல்லொடு கரும்பமைத்துக்","kAyuDai nelloDu karumbamaiththuk"],[511,"மாசுடை உடம்பொடு தலை உலறி","mAsuDai uDamboDu thalai ulaRi"],[512,"தொழுது முப்போதும் உன் அடி வணங்கித்","tŏḻutu muppotum uṉ aṭi vaṇaṅkit"],[513,"கருப்பு வில் மலர்க் கணைக் காம வேளைக்","karuppu vil malark kaNaik kAma vELaik"],[514,"நாமம் ஆயிரம் ஏத்த நின்ற நாராயணா! நரனே! உன்னை","nAmam Ayiram Eththa ninRa nArAyaNA! naranE! unnai"],[515,"இன்று முற்றும் முதுகு நோவ இருந்து இழைத்த இச்சிற்றிலை","iṉṟu muṟṟum mutuku nova iruntu izhaitta icciṟṟilai"],[516,"குண்டு நீர் உறை கோளரீ! மத யானை கோள் விடுத்தாய் உன்னைக்","kuNDu nIr uRai kOLarI! madha yAnai kOL viDuththAy unnaik"],[517,"பெய்யு மாமுகில் போல் வண்ணா! உன்தன் பேச்சும் செய்கையும் எங்களை","peyyu mAmugil pOl vaNNA! undhan pEchchum seygaiyum enggaLai"],[518,"வெள்ளை நுண்மணற் கொண்டு சிற்றில் விசித்திரப்பட வீதி வாய்த்","veLLai nuNmaNaR koNDu siRRil vichiththirappaDa vIdhi vAyth"],[519,"முற்றிலாத பிள்ளைகளோம் முலை போந்திலாதோமை நாள் தொறும்","muRRilAdha piLLaigaLOm mulai pOndhilAdhOmai nAL thoRum"],[520,"பேதம் நன்கு அறிவார்களோடு இவை பேசினால் பெரிது இன்சுவை","pEdham nanku aRivArgaLODu ivai pEsinAl peridhu insuvai"],[521,"வட்ட வாய்ச் சிறு தூதையோடு சிறு சுளகும் மணலும் கொண்டு","vaTTa vAych siRu thUdhaiyODu siRu suLagum maNalum koNDu"],[522,"முற்றத்தூடு புகுந்து நின் முகம் காட்டிப் புன்முறுவல் செய்து","muRRaththUDu pugundhu nin mugam kATTip punmuRuval seydhu"],[523,"சீதை வாய் அமுதம் உண்டாய்! எங்கள் சிற்றில் நீ சிதையேல் என்று","sIdhai vAy amudham uNDAy! enggaL siRRil nI sidhaiyEl enRu"],[524,"கோழி அழைப்பதன் முன்னம் குடைந்து நீராடுவான் போந்தோம்","kozhi azhaippataṉ muṉṉam kuṭaintu nīrāṭuvāṉ pontom"],[525,"இது என் புகுந்தது இங்கு? அந்தோ! இப் பொய்கைக்கு எவ்வாறு வந்தாய்?","itu ĕṉ pukuntatu iṅku? anto! ip pŏykaikku ĕvvāṟu vantāy?"],[526,"எல்லே! ஈதென்ன இளமை? எம்மனைமார் காணில் ஒட்டார்","ellE! Idhenna iLamai? emmanaimAr kANil oTTAr"],[527,"பரக்க விழித்து எங்கும் நோக்கிப் பலர் குடைந்தாடும் சுனையில்","parakka vizhiththu enggum nOkkip palar kuDaindhADum sunaiyil"],[528,"காலைக் கது விடுகின்ற கயலொடு வாளை விரவி","kAlaik kadhu viDuginRa kayaloDu vALai viravi"],[529,"தடத்தவிழ் தாமரைப் பொய்கைத் தாள்கள் எம் காலைக் கதுவ","thaDaththavizh thAmaraip poygaith thALgaL em kAlaik kadhuva"],[530,"நீரிலே நின்று அயர்க்கின்றோம் நீதி அல்லாதன செய்தாய்","nIrilE ninRu ayarkkinROm nIdhi allAdhana seydhAy"],[531,"மாமிமார் மக்களே அல்லோம் மற்றும் இங்கு எல்லாரும் போந்தார்","mAmimAr makkaLE allOm maRRum inggu ellArum pOndhAr"],[532,"கஞ்சன் வலை வைத்த அன்று கார் இருள் எல்லில் பிழைத்து","kanjchan valai vaiththa anRu kAr iruL ellil pizhaiththu"],[533,"கன்னியரோடு எங்கள் நம்பி கரிய பிரான் விளையாட்டை","kanniyarODu enggaL nambi kariya pirAn viLaiyATTai"],[534,"தெள்ளியார் பலர் கை தொழும் தேவனார்","theLLiyAr palar kai thozhum dhEvanAr"],[535,"காட்டில் வேங்கடம் கண்ணபுர நகர்","kATTil vEngkaDam kaNNapura nagar"],[536,"பூமகன் புகழ் வானவர் போற்றுதற்கு","pUmagan pugazh vAnavar pORRudhaRku"],[537,"ஆய்ச்சிமார்களும் ஆயரும் அஞ்சிட","AychchimArgaLum Ayarum anjchiDa"],[538,"மாட மாளிகை சூழ் மதுரைப் பதி","mADa mALigai sUzh madhuraip padhi"],[539,"அற்றவன் மருதம் முறிய நடை","aṟṟavaṉ marutam muṟiya naṭai"],[540,"அன்றின்னாதன செய் சிசுபாலனும்","anRu innAdhana sey sisupAlanum"],[541,"ஆவல் அன்புடையார் தம் மனத்தன்றி","Aval anbuDaiyAr tham manaththanRi"],[542,"கொண்ட கோலக் குறள் உருவாய்ச் சென்று","koNDa kOlak kuRaL uruvAych senRu"],[543,"பழகு நான்மறையின் பொருளாய் மதம்","pazhagu nAnmaRaiyin poruLAy madham"],[544,"ஊடல் கூடல் உணர்தல் புணர்தலை","UDal kUDal uNardhal puNardhalai"],[545,"மன்னு பெரும்புகழ் மாதவன் மாமணி","mannu perumpugazh mAdhavan mAmaNi"],[546,"வெள்ளை விளி சங்கு இடங்கையில் கொண்ட","veLLai viLi sanggu iDangkaiyil koNDa"],[547,"மாதலி தேர் முன்பு கோல் கொள்ள மாயன்","mAthali thEr munbu kOl koLLa mAyan"],[548,"என்பு உருகி இனவேல் நெடுங்கண்கள்","enbu urugi inavEl neDungkaNgaL"],[549,"மென்னடை அன்னம் பரந்து விளையாடும்","mennaDai annam parandhu viLaiyADum"],[550,"எத்திசையும் அமரர் பணிந்து ஏத்தும்","eththisaiyum amarar paNindhu Eththum"],[551,"பொங்கிய பாற்கடல் பள்ளி கொள்வானைப்","ponggiya pARkaDal paLLi koLvAnaip"],[552,"சார்ங்கம் வளைய வலிக்கும் தடக்கைச்","sArnggam vaLaiya valikkum thaDakkaich"],[553,"பைங்கிளி வண்ணன் சிரீதரன் என்பதோர்","paingkiLi vaNNan sirIdharan enbadhOr"],[554,"அன்று உலகம் அளந்தானை உகந்து","anRu ulagam aLandhAnai ugandhu"],[555,"விண்ணுற நீண்டு அடி தாவிய மைந்தனை","viNNuRa nINDu aDi thAviya maindhanai"],[556,"வாரணம் ஆயிரம் சூழ வலஞ்செய்து","vāraṇam āyiram cūzha valañcĕytu"],[557,"நாளை வதுவை மணம் என்று நாள் இட்டு","nALai vadhuvai maNam enRu nAL iTTu"],[558,"இந்திரன் உள்ளிட்ட தேவர் குழாம் எல்லாம்","indhiran uLLiTTa dhEvar kuzhAm ellAm"],[559,"நால் திசைத் தீர்த்தம் கொணர்ந்து நனி நல்கி","nAl thisaith thIrththam koNarndhu nani nalgi"],[560,"கதிரொளி தீபம் கலசம் உடன் ஏந்தி","kadhiroLi dhIpam kalasam uDan Endhi"],[561,"மத்தளம் கொட்ட வரி சங்கம் நின்று ஊத","mattal̤am kŏṭṭa vari-caṅkam niṉṟu ūta"],[562,"வாய் நல்லார் நல்ல மறை ஓதி மந்திரத்தால்","vAy nallAr nalla maRai Odhi mandhiraththAl"],[563,"இம்மைக்கும் ஏழ் ஏழ் பிறவிக்கும் பற்றாவான்","immaikkum Ezh Ezh piRavikkum paRRAvAn"],[564,"வரிசிலை வாள் முகத்து என்னைமார் தாம் வந்திட்டு","varisilai vAL mugaththu ennaimAr thAm vandhiTTu"],[565,"குங்குமம் அப்பிக் குளிர் சாந்தம் மட்டித்து","kunggumam appik kuLir sAndham maTTiththu"],[566,"ஆயனுக்காகத் தான் கண்ட கனாவினை","AyanukkAgath thAn kaNDa kanAvinai"],[567,"கருப்பூரம் நாறுமோ? கமலப்பூ நாறுமோ?","karuppUram nARumO? kamalappU nARumO?"],[568,"கடலில் பிறந்து கருதாது பஞ்சசனன்","kaDalil piRandhu karudhAdhu panjchasanan"],[569,"தட வரையின் மீதே சரற்கால சந்திரன்","thaDa varaiyin mIdhE saraRkAla chandhiran"],[570,"சந்திர மண்டலம் போல் தாமோதரன் கையில்","chandhira maNDalam pOl dhAmOdharan kaiyil"],[571,"உன்னோடு உடனே ஒரு கடலில் வாழ்வாரை","unnODu uDanE oru kaDalil vAzhvArai"],[572,"போய்த் தீர்த்தம் ஆடாதே நின்ற புணர் மருதம்","pOyth thIrththam ADAdhE ninRa puNar marudham"],[573,"செங்கமல நாள் மலர்மேல் தேன் நுகரும் அன்னம் போல்","cĕṅkamala nāl̤-malarmel teṉ nukarum aṉṉam pol"],[574,"உண்பது சொல்லில் உலகளந்தான் வாய் அமுதம்","uNbadhu sollil ulagaLandhAn vAy amudham"],[575,"பதினாறாம் ஆயிரவர் தேவிமார் பார்த்து இருப்ப","padhinARAm Ayiravar dhEvimAr pArththu iruppa"],[576,"பாஞ்சசன்னியத்தைப் பற்பநாபனோடும்","pAnjchasanniyaththaip paRpanAbanODum"],[577,"விண்ணீல மேலாப்பு விரித்தாற் போல் மேகங்காள்!","viNNIla mElAppu viriththAR pOl mEganggAL!"],[578,"மா முத்தநிதி சொரியும் மா முகில்காள் ! வேங்கடத்துச்","mā muttaniti cŏriyum mā mukilkāl̤ ! veṅkaṭattuc"],[579,"ஒளி வண்ணம் வளை சிந்தை உறக்கத்தோடு இவை எல்லாம்","oLi vaNNam vaLai sindhai uRakkaththODu ivai ellAm"],[580,"மின் ஆகத்து எழுகின்ற மேகங்காள் ! வேங்கடத்துத்","miṉ ākattu ĕzhukiṉṟa mekaṅkāl̤ ! veṅkaṭattut"],[581,"வான் கொண்டு கிளர்ந்து எழுந்த மாமுகில்காள்! வேங்கடத்துத்","vAn koNDu kiLarndhu ezhundha mAmugilgAL! vEngkaDaththuth"],[582,"சலம் கொண்டு கிளர்ந்து எழுந்த தண்முகில்காள்! மாவலியை","salam koNDu kiLarndhu ezhundha thaNmugilgAL! mAvaliyai"],[583,"சங்கமா கடல் கடைந்தான் தண்முகில்காள்! வேங்கடத்துச்","sanggamA kaDal kaDaindhAn thaNmugilgAL! vEngkaDaththuch"],[584,"கார் காலத்து எழுகின்ற கார்முகில்காள்! வேங்கடத்துப்","kAr kAlaththu ezhuginRa kArmugilgAL! vEngkaDaththup"],[585,"மத யானை போல் எழுந்த மாமுகில்காள்! வேங்கடத்தைப்","madha yAnai pOl ezhundha mAmugilgAL! vEngkaDaththaip"],[586,"நாகத்தின் அணையானை நன்னுதலாள் நயந்துரை செய்","nAgaththin aNaiyAnai nannudhalAL nayandhurai sey"],[587,"சிந்துரச் செம்பொடிப் போல் திருமாலிருஞ்சோலை எங்கும்","sindhurach sempoDip pOl thirumAlirunjchOlai enggum"],[588,"போர்க்களிறு பொரும் மாலிருஞ்சோலை அம் பூம்புறவில்","porkkal̤iṟu pŏrum māliruñcolai am pūmpuṟavil"],[589,"கருவிளை ஒண்மலர்காள்! காயா மலர்காள்! திருமால்","karuviLai oNmalargAL! kAyA malargAL! thirumAl"],[590,"பைம்பொழில் வாழ் குயில்காள்! மயில்காள்! ஒண்கருவிளைகாள்!","paimpozhil vAzh kuyilgAL! mayilgAL! oNkaruviLaigAL!"],[591,"துங்க மலர்ப் பொழில் சூழ் திருமாலிருஞ்சோலை நின்ற","tuṅka malarp pŏzhil cūzh tirumāliruñcolai niṉṟa"],[592,"நாறு நறும் பொழில் மாலிருஞ்சோலை நம்பிக்கு நான்","nāṟu naṟum pŏzhil māliruñcolai nampikku nāṉ"],[593,"இன்று வந்து இத்தனையும் அமுது செய்திடப் பெறில் நான்","inRu vandhu iththanaiyum amudhu seydhiDap peRil nAn"],[594,"காலை எழுந்திருந்து கரிய குருவிக் கணங்கள்","kAlai ezhundhirundhu kariya kuruvik kaNanggaL"],[595,"கோங்கலரும் பொழில் மாலிருஞ்சோலையில் கொன்றைகள் மேல்","kOnggalarum pozhil mAlirunjchOlaiyil konRaigaL mEl"],[596,"சந்தொடு கார் அகிலும் சுமந்து தடங்கள் பொருது","sandhoDu kAr agilum sumandhu thaDanggaL porudhu"],[597,"கார்க்கோடல் பூக்காள்! கார்க்கடல் வண்ணன் என் மேல் உம்மைப்","kArkkODal pUkkAL! kArkkaDal vaNNan en mEl ummaip"],[598,"மேல் தோன்றிப் பூக்காள்! மேல் உலகங்களின் மீது போய்","mEl thOnRip pUkkAL! mEl ulaganggaLin mIdhu pOy"],[599,"கோவை மணாட்டி! நீ உன் கொழுங்கனி கொண்டு எம்மை","kOvai maNATTi! nI un kozhungkani koNDu emmai"],[600,"முல்லைப் பிராட்டி நீ உன் முறுவல்கள் கொண்டு எம்மை","mullaip pirāṭṭi nī uṉ muṟuvalkal̤ kŏṇṭu ĕmmai"],[601,"பாடும் குயில்காள்! ஈதென்ன பாடல்? நல் வேங்கட","pADum kuyilgAL! Idhenna pADal? nal vEngkaDa"],[602,"கண மா மயில்காள்! கண்ண பிரான் திருக்கோலம் போன்று","kaNa mA mayilgAL! kaNNa pirAn thirukkOlam pOnRu"],[603,"நடமாடித் தோகை விரிக்கின்ற மா மயில்காள்! உம்மை","naDamADith thOgai virikkinRa mA mayilgAL! ummai"],[604,"மழையே! மழையே! மண் புறம் பூசி உள்ளாய் நின்று","mazhaiye! mazhaiye! maṇ puṟam pūci ul̤l̤āy niṉṟu"],[605,"கடலே! கடலே! உன்னைக் கடைந்து கலக்குறுத்து","kaDalE! kaDalE! unnaik kaDaindhu kalakkuRuththu"],[606,"நல்ல என் தோழி! நாகணை மிசை நம் பரர்","nalla en thOzhi! nAgaNai misai nam parar"],[607,"தாம் உகக்கும் தம் கையில் சங்கமே போலாவோ","tām ukakkum tam kaiyil caṅkame polāvo"],[608,"எழில் உடைய அம்மனைமீர்! என் அரங்கத்து இன்னமுதர்","ezhil uDaiya ammanaimIr! en aranggaththu innamudhar"],[609,"பொங்கோதம் சூழ்ந்த புவனியும் விண்ணுலகும்","ponggOdham sUzhndha buvaniyum viNNulagum"],[610,"மச்சணி மாட மதிள் அரங்கர் வாமனனார்","machchaNi mADa madhiL aranggar vAmananAr"],[611,"பொல்லாக் குறள் உருவாய்ப் பொற்கையில் நீர் ஏற்று","pollAk kuRaL uruvAyp poRkaiyil nIr ERRu"],[612,"கைப்பொருள்கள் முன்னமே கைக்கொண்டார் காவிரி நீர்","kaipporuLgaL munnamE kaikkoNDAr kAviri nIr"],[613,"உண்ணாது உறங்காது ஒலி கடலை ஊடறுத்து","uNNAdhu uRanggAdhu oli kaDalai UDaRuththu"],[614,"பாசி தூர்த்துக் கிடந்த பார் மகட்கு பண்டொரு நாள்","pAsi thUrththuk kiDandha pAr magaTku paNDoru nAL"],[615,"கண்ணாலம் கோடித்துக் கன்னி தன்னைக் கைப்பிடிப்பான்","kaNNAlam kODiththuk kanni thannaik kaippiDippAn"],[616,"செம்மை உடைய திருவரங்கர் தாம் பணித்த","semmai uDaiya thiruvaranggar thAm paNiththa"],[617,"மற்றிருந்தீர்கட்கு அறியல் ஆகா","maRRirundhIrgaTku aRiyal AgA"],[618,"நாணி இனி ஓர் கருமம் இல்லை","nANi ini Or karumam illai"],[619,"தந்தையும் தாயும் உற்றாரும் நிற்கத்","thandhaiyum thAyum uRRArum niRkath"],[620,"அங்கைத் தலத்திடை ஆழி கொண்டான்","anggaith thalaththiDai Azhi koNDAn"],[621,"ஆர்க்கும் என் நோய் இது அறியல் ஆகாது","Arkkum en nOy idhu aRiyal AgAdhu"],[622,"கார்த் தண்முகிலும் கருவிளையும்","kArth thaNmugilum karuviLaiyum"],[623,"வண்ணம் திரிவும் மனம் குழைவும்","vaNNam thirivum manam kuzhaivum"],[624,"கற்றினம் மேய்க்கிலும் மேய்க்கப் பெற்றான்","kaṟṟiṉam meykkilum meykkap pĕṟṟāṉ"],[625,"கூட்டில் இருந்து கிளி எப்போதும்","kūṭṭil iruntu kil̤i ĕppotum"],[626,"மன்னு மதுரை தொடக்கமாக","mannu madhurai thoDakkamAga"],[627,"கண்ணன் என்னும் கருந்தெய்வம் காட்சி பழகிக் கிடப்பேனை","kaNNan ennum karundheyvam kATchi pazhagik kiDappEnai"],[628,"பால் ஆலிலையில் துயில் கொண்ட பரமன் வலைப்பட்டு இருந்தேனை","pAl Alilaiyil thuyil koNDa paraman valaippaTTu irundhEnai"],[629,"கஞ்சைக் காய்ந்த கருவில்லி கடைக்கண் என்னும் சிறைக் கோலால்","kanjchaik kAyndha karuvilli kaDaikkaN ennum siRaik kOlAl"],[630,"ஆரே உலகத்து ஆற்றுவார்? ஆயர்பாடி கவர்ந்து உண்ணும்","ArE ulagaththu ARRuvAr? AyarpADi kavarndhu uNNum"],[631,"அழிலும் தொழிலும் உருக் காட்டான் அஞ்சேல் என்னான் அவன் ஒருவன்","azhilum thozhilum uruk kATTAn anjchEl ennAn avan oruvan"],[632,"நடை ஒன்று இல்லா உலகத்து நந்தகோபன் மகன் என்னும்","naDai onRu illA ulagaththu nandhagOpan magan ennum"],[633,"வெற்றிக் கருளக் கொடியான் தன் மீமீதாடா உலகத்து","veRRik karuLak koDiyAn than mImIdhADA ulagaththu"],[634,"உள்ளே உருகி நைவேனை உளளோ இலளோ என்னாத","uLLE urugi naivEnai uLaLO ilaLO ennAdha"],[635,"கொம்மை முலைகள் இடர் தீரக் கோவிந்தற்கு ஓர் குற்றேவல்","kŏmmai mulaikal̤ iṭar tīrak kovintaṟku or kuṟṟeval"],[636,"அல்லல் விளைத்த பெருமானை ஆயர்பாடிக்கு அணிவிளக்கை","allal viLaiththa perumAnai AyarpADikku aNiviLakkai"],[637,"பட்டி மேய்ந்தோர் கார் ஏறு பலதேவற்கு ஓர் கீழ்க் கன்றாய்","paTTi mEyndhOr kAr ERu paladhEvaRku Or kIzhk kanRAy"],[638,"அனுங்க என்னைப் பிரிவு செய்து ஆயர்பாடி கவர்ந்து உண்ணும்","aṉuṅka ĕṉṉaip pirivu cĕytu āyarpāṭi kavarntu uṇṇum"],[639,"மாலாய்ப் பிறந்த நம்பியை மாலே செய்யும் மணாளனை","mAlAyp piRandha nambiyai mAlE seyyum maNALanai"],[640,"கார்த் தண் கமலக் கண் என்னும் நெடுங்கயிறு படுத்தி என்னை","kārt taṇ kamalak kaṇ ĕṉṉum nĕṭuṅkayiṟu paṭutti ĕṉṉai"],[641,"மாதவன் என் மணியினை வலையில் பிழைத்த பன்றி போல்","mAdhavan en maNiyinai valaiyil pizhaiththa panRi pOl"],[642,"தருமம் அறியாக் குறும்பனைத் தன் கைச் சார்ங்கம் அதுவே போல்","dharumam aRiyAk kuRumbanaith than kaich sArnggam adhuvE pOl"],[643,"பொருத்தம் உடைய நம்பியைப் புறம் போல் உள்ளும் கரியானை","poruththam uDaiya nambiyaip puRam pOl uLLum kariyAnai"],[644,"வெளிய சங்கு ஒன்று உடையானைப் பீதக ஆடை உடையானை","veLiya sanggu onRu uDaiyAnaip pIdhaga ADai uDaiyAnai"],[645,"நாட்டைப் படை என்று அயன் முதலாத் தந்த நளிர் மாமலர் உந்தி","nATTaip paDai enRu ayan mudhalAth thandha naLir mAmalar undhi"],[646,"பருந்தாள் களிற்றுக்கு அருள் செய்த பரமன் தன்னை பாரின் மேல்","parunthAL kaLiRRukku aruL seydha paraman thannai pArin mEl"],[647,"இருள் இரியச் சுடர் மணிகள் இமைக்கும் நெற்றி","irul̤ iriyac cuṭar maṇikal̤ imaikkum nĕṟṟi"],[648,"வாய் ஓர் ஈரைஞ்ஞூறு துதங்கள் ஆர்ந்த","vāy or īraiññūṟu tutaṅkal̤ ārnta"],[649,"எம் மாண்பின் அயன் நான்கு நாவினாலும்","ĕm māṇpiṉ ayaṉ nāṉku nāviṉālum"],[650,"மாவினை வாய் பிளந்து உகந்த மாலை வேலை","māviṉai vāy pil̤antu ukanta mālai velai"],[651,"இணையில்லா இன்னிசை யாழ் கெழுமி இன்பத்","iṇaiyillā iṉṉicai yāḻ kĕḻumi iṉpat"],[652,"அளி மலர்மேல் அயன் அரன் இந்திரனோடு ஏனை","al̤i malarmel ayaṉ araṉ intiraṉoṭu eṉai"],[653,"மறம் திகழும் மனம் ஒழித்து வஞ்சமாற்றி","maRam thigazhum manam ozhiththu vanjchamARRi"],[654,"கோல் ஆர்ந்த நெடுஞ்சார்ங்கம் கூனல் சங்கம்","kol ārnta nĕṭuñcārṅkam kūṉal caṅkam"],[655,"தூராத மனக்காதல்-தொண்டர் தங்கள்","tūrāta maṉakkātal-tŏṇṭar taṅkal̤"],[656,"வன்பெரு வானகம் உய்ய அமரர் உய்ய","vanperu vAnagam uyya amarar uyya"],[657,"திடர் விளங்கு கரைப் பொன்னி நடுவு பாட்டுத்","thiDar viLanggu karaip ponni naDuvu pATTuth"],[658,"தேட்டு அருந் திறல் தேனினைத் தென் அரங்கனைத் திருமாது வாழ்","teṭṭu arun tiṟal-teṉiṉait tĕṉ araṅkaṉait tirumātu vāzh"],[659,"தோடுலா மலர்மங்கை தோளிணை தோய்ந்ததும்","thODulA malarmanggai thOLiNai thOyndhadhum"],[660,"ஏறடர்த்ததும் ஏனமாய் நிலம் கீண்டதும்","ERaDarththadhum EnamAy nilam kINDadhum"],[661,"தோய்த்த தண்தயிர் வெண்ணெய் பால் உடன்","thOyththa thaNthayir veNNey pAl uDan"],[662,"பொய் சிலைக் குரல் ஏற்றெருத்தம்","poy silaik kural ERReruththam"],[663,"ஆதி அந்தம் அனந்தம் அற்புதமான","Adhi andham anantham aRpudhamAna"],[664,"கார் இனம் புரை மேனி நற்கதிர்","kAr inam purai mEni naRkadhir"],[665,"மாலையுற்ற கடல் கிடந்தவன்","mAlaiyuRRa kaDal kiDandhavan"],[666,"மொய்த்துக் கண் பனி சோர மெய்கள்","moyththuk kaN pani sOra meygaL"],[667,"அல்லி மாமலர் மங்கை நாதன்","alli mAmalar manggai nAthan"],[668,"மெய்யில் வாழ்க்கையை மெய் எனக் கொள்ளும் இவ்","meyyil vAzhkkaiyai mey enak koLLum iv"],[669,"நூலினேர் இடையார் திறத்தே நிற்கும்","nUlinEr iDaiyAr thiRaththE niRkum"],[670,"மாரனார் வரிவெஞ்சிலைக்கு ஆட்செய்யும்","mAranAr varivenjchilaikku ATseyyum"],[671,"உண்டியே உடையே உகந்து ஓடும் இம்","uNDiyE uDaiyE ugandhu ODum im"],[672,"தீதில் நன்னெறி நிற்க அல்லாது செய்","thIdhil nanneRi niRka allAdhu sey"],[673,"எம் பரத்தர் அல்லாரொடும் கூடலன்","em paraththar allAroDum kUDalan"],[674,"எத்திறத்திலும் யாரொடும் கூடும் அச்","eththiRaththilum yAroDum kUDum ach"],[675,"பேயரே எனக்கு யாவரும் யானும் ஓர்","pEyarE enakku yAvarum yAnum Or"],[676,"அங்கை ஆழி அரங்கன் அடியிணை","angkai Azhi aranggan aDiyiNai"],[677,"ஊன் ஏறு செல்வத்து உடற் பிறவி யான் வேண்டேன்","Un ERu selvaththu uDaR piRavi yAn vENDEn"],[678,"ஆனாத செல்வத்து அரம்பையர்கள் தற்சூழ","AnAdha selvaththu arambaiyargaL thaRsUzha"],[679,"பின்னிட்ட சடையானும் பிரமனும் இந்திரனும்","pinniTTa saDaiyAnum piramanum indhiranum"],[680,"ஒண்பவள வேலை உலவு தண்பாற்கடலுள்","oNpavaLa vElai ulavu thaNpARkaDaluL"],[681,"கம்ப மத யானைக் கழுத்தகத்தின் மேல் இருந்து","kamba madha yAnaik kazhuththagaththin mEl irundhu"],[682,"மின்னனைய நுண்ணிடையார் உருப்பசியும் மேனகையும்","minnanaiya nuNNiDaiyAr uruppasiyum mEnagaiyum"],[683,"வானாளும் மாமதி போல் வெண்குடைக் கீழ் மன்னவர் தம்","vAnALum mAmadhi pOl veNkuDaik kIzh mannavar tham"],[684,"பிறை ஏறு சடையானும் பிரமனும் இந்திரனும்","piRai ERu saDaiyAnum piramanum indhiranum"],[685,"செடி ஆய வல்வினைகள் தீர்க்கும் திருமாலே!","seDi Aya valvinaigaL thIrkkum thirumAlE!"],[686,"உம்பர் உலகு ஆண்டு ஒரு குடைக்கீழ் உருப்பசி தன்","umpar ulaku āṇṭu ŏru kuṭaikkīzh uruppaci taṉ"],[687,"மன்னிய தண்சாரல் வடவேங்கடத்தான் தன்","manniya thaNsAral vaDavEngkaDaththAn than"],[688,"தரு துயரம் தடாயேல் உன் சரண் அல்லால் சரண் இல்லை","tharu thuyaram thaDAyEl un charaN allAl saraN illai"],[689,"கண்டார் இகழ்வனவே காதலன் தான் செய்திடினும்","kaNDAr igazhvanavE kAdhalan thAn seydhiDinum"],[690,"மீன் நோக்கும் நீள்வயல் சூழ் விற்றுவக்கோட்டம்மா! என்","mIn nOkkum nILvayal sUzh viRRuvakkOTTammA! en"],[691,"வாளால் அறுத்துச் சுடினும் மருத்துவன் பால்","vALAl aRuththuch suDinum maruththuvan pAl"],[692,"வெங்கண் திண்களிறு அடர்த்தாய்! விற்றுவக்கோட்டம்மானே!","vengkaN thiNkaLiRu aDarththAy! viRRuvakkOTTammAnE!"],[693,"செந்தழலே வந்து அழலைச் செய்திடினும் செங்கமலம்","senthazhalE vandhu azhalaich cheydhiDinum sengkamalam"],[694,"எத்தனையும் வான் மறந்த காலத்தும் பைங்கூழ்கள்","eththanaiyum vAn maRandha kAlaththum paingkUzhgaL"],[695,"தொக்கிலங்கு யாறெல்லாம் பரந்தோடி தொடுகடலே","thokkilanggu yARellAm parandhODith thoDukaDalE"],[696,"நின்னையே தான் வேண்டி நீள்செல்வம் வேண்டாதான்","ninnaiyE thAn vENDi nILselvam vENDAdhAn"],[697,"வித்துவக்கோட்டு அம்மா நீ வேண்டாயே ஆயிடினும்","vittuvakkoṭṭu ammā nī veṇṭāye āyiṭiṉum"],[698,"ஏர்மலர்ப் பூங்குழல் ஆயர் மாதர்","Ermalarp pUngkuzhal Ayar mAdhar"],[699,"கெண்டை ஒண்கண் மடவாள் ஒருத்தி","keNDai oNkaN maDavAL oruththi"],[700,"கருமலர்க் கூந்தல் ஒருத்திதன்னைக் கடைக்கணித்து ஆங்கே ஒருத்திதன்பால்","karumalark kūntal ŏruttitaṉṉaik kaṭaikkaṇittu āṅke ŏruttitaṉpāl"],[701,"தாய்முலைப் பாலில் அமுது இருக்கத்","thAymulaip pAlil amudhu irukkath"],[702,"மின்னொத்த நுண்ணிடையாளைக் கொண்டு","minnoththa nuNNiDaiyALaik koNDu"],[703,"மற்பொரு தோளுடை வாசுதேவா!","maRporu thOLuDai vAsudhEvA!"],[704,"பையரவு இன்னணைப் பள்ளியினாய்!","paiyaravu innaNaip paLLiyinAy!"],[705,"என்னை வருக எனக் குறித்திட்டு","ennai varuga enak kuRiththiTTu"],[706,"மங்கல நல்வனமாலை மார்வில் இலங்க","manggala nalvanamAlai mArvil ilangga"],[707,"அல்லிமலர்த் திருமங்கை கேள்வன்","allimalarth thirumanggai kELvan"],[708,"ஆலைநீள் கரும்பு அன்னவன் தாலோ","AlainIL karumbu annavan thAlO"],[709,"வடிக் கொள் அஞ்சனம் எழுது செம் மலர்க்கண் மருவி மேல் இனிது ஒன்றினை நோக்கி","vaṭik kŏl̤ añcaṉam ĕzhutu cĕm malarkkaṇ maruvi mel iṉitu ŏṉṟiṉai nokki"],[710,"முந்தை நன்முறை அன்புடை மகளிர்","mundhai nanmuRai anbuDai magaLir"],[711,"களிநிலா எழில் மதி புரை முகமும்","kaLinilA ezhil madhi purai mugamum"],[712,"மருவு நின் திருநெற்றியில் சுட்டி","maruvu nin thiruneRRiyil suTTi"],[713,"தண்ணந்தாமரைக் கண்ணனே! கண்ணா!","thaNNanthAmaraik kaNNanE! kaNNA!"],[714,"குழகனே! என்தன் கோமளப் பிள்ளாய்!","kuzhaganE! endhan kOmaLap piLLAy!"],[715,"முழுதும் வெண்ணெய் அளைந்து தொட்டு உண்ணும்","muzhudhum veNNey aLaindhu thoTTu uNNum"],[716,"குன்றினால் குடை கவித்ததும் கோலக்","kunRinAl kuDai kaviththadhum kOlak"],[717,"வஞ்சமேவிய நெஞ்சுடைப் பேய்ச்சி","vanjchamEviya nenjchuDaip pEychchi"],[718,"மல்லை மாநகர்க்கு இறையவன் தன்னை","mallai mAnagarkku iRaiyavan thannai"],[719,"மன்னுபுகழ்க் கௌசலை தன் மணிவயிறு வாய்த்தவனே!","mannupugazhk kausalai than maNivayiRu vAyththavanE!"],[720,"புண்டரிக மலர் அதன் மேல் புவனி எல்லாம் படைத்தவனே!","puNDarika malar adhan mEl buvani ellAm paDaiththavanE!"],[721,"கொங்கு மலி கருங்குழலாள் கௌசலை தன் குலமதலாய்!","konggu mali karungkuzhalAL kausalai than kulamadhalAy!"],[722,"தாமரை மேல் அயன் அவனைப் படைத்தவனே! தயரதன் தன்","thAmarai mEl ayan avanaip paDaiththavanE! dhayarathan than"],[723,"பாராளும் படர் செல்வம் பரத நம்பிக்கே அருளி","pArALum paDar selvam baratha nambikkE aruLi"],[724,"சுற்றம் எல்லாம் பின் தொடரத் தொல்கானம் அடைந்தவனே!","suRRam ellAm pin thoDarath tholkAnam aDaindhavanE!"],[725,"ஆலின் இலைப் பாலகனாய் அன்று உலகம் உண்டவனே!","Alin ilaip pAlaganAy anRu ulagam uNDavanE!"],[726,"மலை அதனால் அணை கட்டி மதிள் இலங்கை அழித்தவனே!","malai adhanAl aNai kaTTi madhiL ilanggai azhiththavanE!"],[727,"தளை அவிழும் நறுங்குஞ்சித் தயரதன் தன் குல மதலாய்!","thaLai avizhum naRungkunjchith thayaradhan than kula madhalAy!"],[728,"தேவரையும் அசுரரையும் திசைகளையும் படைத்தவனே!","dhEvaraiyum asuraraiyum thisaigaLaiyum paDaiththavanE!"],[729,"கன்னி நன்மா மதிள் புடை சூழ் கணபுரத்து என் காகுத்தன்","kanni nanmA madhiL puDai sUzh kaNapuraththu en kAguththan"],[730,"வன்தாளின் இணை வணங்கி வளநகரம்","vanthALin iNai vaNanggi vaLanagaram"],[731,"வெவ்வாயேன் வெவ்வுரை கேட்டு இருநிலத்தை","vevvAyEn vevvurai kETTu irunilaththai"],[732,"கொல்லணை வேல் வரி நெடுங்கண் கௌசலை தன்","kollaNai vEl vari neDungkaN kausalai than"],[733,"வா போகு வா இன்னம் வந்து ஒருகால்","vA pOgu vA innam vandhu orukAl"],[734,"பொருந்தார் கை வேல் நுதி போல் பரல் பாய","porundhAr kai vEl nudhi pOl paral pAya"],[735,"அம்மா என்று உகந்து அழைக்கும் ஆர்வச் சொல்","ammA enRu ugandhu azhaikkum Arvach chol"],[736,"பூ மருவு நறுங்குஞ்சி புன்சடையாப் புனைந்து பூந் துகில் சேர் அல்குல்","pū maruvu naṟuṅkuñci puṉcaṭaiyāp puṉaintu pūn tukil cer alkul"],[737,"பொன் பெற்றார் எழில் வேதப் புதல்வனையும்","pon peRRAr ezhil vEdhap pudhalvanaiyum"],[738,"முன்னொரு நாள் மழுவாளி சிலை வாங்கி","munnoru nAL mazhuvALi silai vAnggi"],[739,"தேன் நகு மா மலர்க் கூந்தல் கௌசலையும் சுமித்திரையும் சிந்தை நோவ","teṉ naku mā malark kūntal kaucalaiyum cumittiraiyum cintai nova"],[740,"ஏர் ஆர்ந்த கருநெடுமால் இராமனாய்","Er Arndha karuneDumAl irAmanAy"],[741,"அங்கண் நெடு மதிள் புடை சூழ் அயோத்தி என்னும்","aṅkaṇ nĕṭu matil̤ puṭai cūzh ayotti ĕṉṉum"],[742,"வந்து எதிர்ந்த தாடகை தன் உரத்தைக் கீறி","vandhu edhirndha thADagai than uraththaik kIRi"],[743,"செவ்வரி நற்கரு நெடுங்கண் சீதைக்கு ஆகிச்","cĕvvari naṟkaru nĕṭuṅkaṇ cītaikku ākic"],[744,"தொத்தலர் பூஞ்சுரிகுழல் கைகேசி சொல்லால்","thoththalar pUnjchurikuzhal kaikEsi sollAl"],[745,"வலி வணக்கு வரை நெடுந்தோள் விராதைக் கொன்று","vali vaNakku varai neDunthOL virAdhaik konRu"],[746,"தனமருவு வைதேகி பிரியல் உற்றுத்","thanamaruvu vaithEgi piriyal uRRuth"],[747,"குரை கடலை அடலம்பால் மறுக எய்து","kurai kaDalai aDalambAl maRuga eydhu"],[748,"அம்பொனெடு மணிமாட அயோத்தி எய்தி","amponeDu maNimADa ayOdhdhi eydhi"],[749,"செறிதவச் சம்புகன் தன்னைச் சென்று கொன்று","seRithavach sampugan thannaich senRu konRu"],[750,"அன்று சராசரங்களை வைகுந்தத்து ஏற்றி","anRu charAcharanggaLai vaikunthaththu ERRi"],[751,"தில்லை நகர்த் திருச்சித்ரகூடம் தன்னுள்","thillai nagarth thiruchchithrakUDam thannuL"],[752,"பூ நிலாய ஐந்துமாய்ப் புனற்கண் நின்ற நான்குமாய்","pU nilAya aindhumAyp punaRkaN ninRa nAnkumAy"],[753,"ஆறும் ஆறும் ஆறுமாய் ஓர் ஐந்தும் ஐந்தும் ஐந்துமாய்","ARum ARum ARumAy Or aindhum aindhum aindhumAy"],[754,"ஐந்தும் ஐந்தும் ஐந்துமாகி அல்லவற்றுள் ஆயுமாய்","aindhum aindhum aindhumAgi allavaRRuL AyumAy"],[755,"மூன்று முப்பதாறினோடு ஓர் ஐந்தும் ஐந்தும் ஐந்துமாய்","mUnRu muppadhARinODu Or aindhum aindhum aindhumAy"],[756,"நின்று இயங்கும் ஒன்றலா உருக்கள் தோறும் ஆவியாய்","ninRu iyanggum onRalA urukkaL thORum AviyAy"],[757,"நாகம் ஏந்து மேரு வெற்பை நாகம் ஏந்து மண்ணினை","nAgam Endhu mEru veRpai nAgam Endhu maNNinai"],[758,"ஒன்றிரண்டு மூர்த்தியாய் உறக்கமோடு உணர்ச்சியாய்","onRiraNDu mUrththiyAy uRakkamODu uNarchchiyAy"],[759,"ஆதியான வானவர்க்கும் அண்டமாய அப்புறத்து","AdhiyAna vAnavarkkum aNDamAya appuRaththu"],[760,"தாதுலாவு கொன்றை மாலை துன்னு செஞ்சடைச் சிவன்","thAdhulAvu konRai mAlai thunnu senjchaDaich sivan"],[761,"தன்னுளே திரைத்தெழும் தரங்க வெண்தடங்கடல்","thannuLE thiraiththezhum tharangga veNthaDanggaDal"],[762,"சொல்லினால் தொடர்ச்சி நீ சொலப்படும் பொருளும் நீ","cŏlliṉāl tŏṭarcci nī cŏlappaṭum pŏrul̤um nī"],[763,"உலகு தன்னை நீ படைத்தி உள்ளொடுக்கி வைத்தி மீண்டு","ulagu thannai nI paDaiththi uLLoDukki vaiththi mINDu"],[764,"இன்னை என்று சொல்லல் ஆவது இல்லை யாதும் இட்டிடை","innai enRu sollal Avadhu illai yAdhum iTTiDai"],[765,"தூய்மை யோகம் ஆயினாய்! துழாய் அலங்கல் மாலையாய்!","thUymai yOgam AyinAy! thuzhAy alanggal mAlaiyAy!"],[766,"அங்கம் ஆறும் வேத நான்கும் ஆகி நின்று அவற்றுளே","anggam ARum vEdha nAnkum Agi ninRu avaRRuLE"],[767,"தலைக்கணத் துகள் குழம்பு சாதி சோதி தோற்றமாய்","thalaikkaNath thugaL kuzhambu sAdhi sOdhi thORRamAy"],[768,"ஏக மூர்த்தி மூன்று மூர்த்தி நாலு மூர்த்தி நன்மை சேர்","Ega mUrththi mUnRu mUrththi nAlu mUrththi nanmai sEr"],[769,"விடத்த வாய் ஒராயிரம் இராயிரம் கண் வெந்தழல்","viDaththa vAy orAyiram irAyiram kaN venthazhal"],[770,"புள்ளது ஆகி வேதம் நான்கும் ஓதினாய் அது அன்றியும்","pul̤l̤atu āki vetam nāṉkum otiṉāy atu aṉṟiyum"],[771,"கூசம் ஒன்றும் இன்றி மாசுணம் படுத்து வேலை நீர்","kUsam onRum inRi mAsuNam paDuththu vElai nIr"],[772,"அரங்கனே! தரங்க நீர் கலங்க அன்று குன்று சூழ்","arangganE! tharangga nIr kalangga anRu kunRu sUzh"],[773,"பண்டும் இன்றும் மேலுமாய் ஒர் பாலனாகி ஞாலம் ஏழ்","paṇṭum iṉṟum melumāy ŏr pālaṉāki ñālam ezh"],[774,"வால் நிறத்து ஒர் சீயமாய் வளைந்த வாள் எயிற்றவன்","vāl niṟattu ŏr cīyamāy val̤ainta vāl̤-ĕyiṟṟavaṉ"],[775,"கங்கை நீர் பயந்த பாத பங்கயத்து எம் அண்ணலே!","ganggai nIr payandha pAdha panggayaththu em aNNalE!"],[776,"வரத்தினில் சிரத்தை மிக்க வாள் எயிற்று மற்றவன்","varaththinil siraththai mikka vAL eyiRRu maRRavan"],[777,"ஆணினோடு பெண்ணுமாகி அல்லவோடு நல்லவாய்","ANinODu peNNumAgi allavODu nallavAy"],[778,"விண் கடந்த சோதியாய் விளங்கு ஞான மூர்த்தியாய்","viṇ kaṭanta cotiyāy vil̤aṅku ñāṉa mūrttiyāy"],[779,"படைத்த பார் இடந்து அளந்து அதுண்டு உமிழ்ந்து பௌவ நீர்","paDaiththa pAr iDandhu aLandhu adhuNDu umizhndhu pauva nIr"],[780,"பரத்திலும் பரத்தை ஆதி பௌவ நீர் அணைக் கிடந்து","parattilum parattai āti pauva nīr aṇaik kiṭantu"],[781,"வானகமும் மண்ணகம்மும் வெற்பும் ஏழ் கடல்களும்","vāṉakamum maṇṇakammum vĕṟpum ezh kaṭalkal̤um"],[782,"கால நேமி காலனே! கணக்கு இலாத கீர்த்தியாய்","kAla nEmi kAlanE! kaNakku ilAdha kIrththiyAy"],[783,"குரக்கினப் படை கொடு குரை கடலின் மீது போய்","kurakkinap paDai koDu kurai kaDalin mIdhu pOy"],[784,"மின் நிறத்து எயிற்று அரக்கன் வீழ வெஞ்சரம் துரந்து","miṉ niṟattu ĕyiṟṟu arakkaṉ vīzha vĕñcaram turantu"],[785,"ஆதி ஆதி ஆதி நீ ஒர் அண்டம் ஆதி ஆதலால்","āti āti āti nī ŏr aṇṭam āti ātalāl"],[786,"அம்பு உலாவு மீனும் ஆகி ஆமை ஆகி ஆழியார்","ampu ulāvu mīṉum āki āmai āki āzhiyār"],[787,"ஆடகத்த பூண்முலை அசோதை ஆய்ச்சி பிள்ளையாய்","ADagaththa pUNmulai asOdhai Aychchi piLLaiyAy"],[788,"காய்த்த நீள் விளங்கனி உதிர்த்து எதிர்ந்த பூங்குருந்தம்","kAyththa nIL viLangkani udhirththu ethirndha pUngkurundham"],[789,"கடம் கலந்த வன்கரி மருப்பு ஒசித்தொர் பொய்கை வாய்","kaDam kalandha vankari maruppu osiththor poygai vAy"],[790,"வெற்பெடுத்து வேலை நீர் கலக்கினாய் அதன்றியும்","veRpeDuththu vElai nIr kalakkinAy adhanRiyum"],[791,"ஆனை காத்து ஒர் ஆனை கொன்று அது அன்றி ஆயர் பிள்ளையாய்","āṉai kāttu ŏr āṉai kŏṉṟu atu aṉṟi āyar-pil̤l̤aiyāy"],[792,"ஆயனாகி ஆயர் மங்கை வேய தோள் விரும்பினாய்","AyanAgi Ayar manggai vEya thOL virumbinAy"],[793,"வேறிசைந்த செக்கர் மேனி நீறணிந்த புன்சடை","vERisaindha sekkar mEni nIRaNindha punsaDai"],[794,"வெஞ்சினத்த வேழ வெண் மருப்பு ஒசித்து உருத்த மா","venjchinaththa vEzha veN maruppu osiththu uruththa mA"],[795,"பாலின் நீர்மை செம்பொன் நீர்மை பாசியின் பசும் புறம்","pAlin nIrmai sempon nIrmai pAsiyin pasum puRam"],[796,"மண்ணுளாய் கொல்? விண்ணுளாய் கொல்? மண்ணுளே மயங்கி நின்று","maNNuLAy kol? viNNuLAy kol? maNNuLE mayanggi ninRu"],[797,"தோடு பெற்ற தண்துழாய் அலங்கல் ஆடு சென்னியாய்!","thODu peRRa thaNthuzhAy alanggal ADu senniyAy!"],[798,"காரொடொத்த மேனி நங்கள் கண்ண! விண்ணிண் நாதனே!","kAroDoththa mEni nanggaL kaNNa! viNNiN nAdhanE!"],[799,"குன்றில் நின்று வான் இருந்து நீள்கடல் கிடந்து மண்","kunRil ninRu vAn irundhu nILkaDal kiDandhu maN"],[800,"கொண்டை கொண்ட கோதை மீது தேனுலாவு கூனி கூன்","koNDai koNDa kOdhai mIdhu thEnulAvu kUni kUn"],[801,"வெண்டிரைக் கருங்கடல் சிவந்து வேவ முன்னொர் நாள்","veNDiraik karungkaDal sivandhu vEva munnor nAL"],[802,"சரங்களைத் துரந்து வில் வளைத்து இலங்கை மன்னவன்","saranggaLaith thurandhu vil vaLaiththu ilanggai mannavan"],[803,"பொற்றை உற்ற முற்றல் யானை போர் எதிர்ந்து வந்ததை","poRRai uRRa muRRal yAnai pOr ethirndhu vandhadhai"],[804,"மோடி ஓடி லச்சையாய சாபம் எய்தி முக்கணான்","mODi ODi lachchaiyAya sAbam eydhi mukkaNAn"],[805,"இலைத் தலைச் சரம் துரந்து இலங்கை கட்டழித்தவன்","ilaith thalaich charam thurandhu ilanggai kaTTazhiththavan"],[806,"மன்னு மாமலர்க் கிழத்தி வைய மங்கை மைந்தனாய்","mannu mAmalark kizhaththi vaiya manggai maindhanAy"],[807,"இலங்கை மன்னன் ஐந்தொடு ஐந்து பைந்தலை நிலத்துக","ilanggai mannan ainthoDu aindhu painthalai nilaththuga"],[808,"சங்கு தங்கு முன் கை நங்கை கொங்கை தங்கல் உற்றவன்","sanggu thanggu mun kai nanggai konggai thanggal uRRavan"],[809,"மரம் கெட நடந்து அடர்த்து மத்த யானை மத்தகத்து","maram kĕṭa naṭantu aṭarttu matta yāṉai mattakattu"],[810,"சாலி வேலி தண்வயல் தடம் கிடங்கு பூம்பொழில்","sAli vEli thaNvayal thaDam kiDanggu pUmpozhil"],[811,"செழும் கொழும் பெரும்பனி பொழிந்திட உயர்ந்த வேய்","sezhum kozhum perumpani pozhindhiDa uyarndha vEy"],[812,"நடந்த கால்கள் நொந்தவோ? நடுங்க ஞாலம் ஏனமாய்","naDandha kAlgaL nondhavO? naDungga njAlam EnamAy"],[813,"கரண்டம் ஆடு பொய்கையுள் கரும் பனைப் பெரும் பழம்","karaNDam ADu poygaiyuL karum panaip perum pazham"],[814,"நன்றிருந்து யோக நீதி நண்ணுவார்கள் சிந்தையுள்","nanRirundhu yOga nIdhi naNNuvArgaL sindhaiyuL"],[815,"நின்றது எந்தை ஊரகத்து இருந்தது எந்தை பாடகத்து","ninRadhu endhai Uragaththu irundhadhu endhai pADagaththu"],[816,"நிற்பதும் ஓர் வெற்பகத்து இருப்பும் விண் கிடப்பதும்","niRpadhum Or veRpagaththu iruppum viN kiDappadhum"],[817,"இன்று சாதல் நின்று சாதல் அன்றி யாரும் வையகத்து","inRu sAdhal ninRu sAdhal anRi yArum vaiyagaththu"],[818,"சண்ட மண்டலத்தின் ஊடு சென்று வீடு பெற்று மேல்","caṇṭa maṇṭalattiṉ ūṭu cĕṉṟu vīṭu pĕṟṟu mel"],[819,"முத்திறத்து வாணியத்து இரண்டில் ஒன்று நீசர்கள்","muththiRaththu vANiyaththu iraNDil onRu nIsargaL"],[820,"காணிலும் உருப் பொலார் செவிக்கு இனாத கீர்த்தியார்","kANilum urup polAr sevikku inAdha kIrththiyAr"],[821,"குந்தமோடு சூலம் வேல்கள் தோமரங்கள் தண்டு வாள்","kundhamODu sUlam vElgaL thOmaranggaL thaNDu vAL"],[822,"வண்டுலாவு கோதை மாதர் காரணத்தினால் வெகுண்டு","vaNDulAvu kOdhai mAdhar kAraNaththinAl veguNDu"],[823,"போதின் மங்கை பூதலக் கிழத்தி தேவி அன்றியும்","pOdhin manggai pUthalak kizhaththi dhEvi anRiyum"],[824,"மரம் பொதச் சரம் துரந்து வாலி வீழ முன்னொர் நாள்","maram podhach charam thurandhu vAli vIzha munnor nAL"],[825,"அறிந்து அறிந்து வாமனன் அடியிணை வணங்கினால்","aRindhu aRindhu vAmanan aDiyiNai vaNangginAl"],[826,"ஒன்றி நின்று நற்றவம் செய்து ஊழி ஊழி தோறெலாம்","onRi ninRu naRRavam seydhu Uzhi Uzhi thORelAm"],[827,"புன் புல வழி அடைத்து அரக்கு இலச்சினை செய்து","puṉ pula vazhi aṭaittu arakku-ilacciṉai cĕytu"],[828,"எட்டும் எட்டும் எட்டுமாய் ஒரேழும் ஏழும் ஏழுமாய்","eTTum eTTum eTTumAy orEzhum Ezhum EzhumAy"],[829,"சோர்விலாத காதலால் தொடக்கறா மனத்தராய்","sOrvilAdha kAdhalAl thoDakkaRA manaththarAy"],[830,"பத்தினோடு பத்துமாய் ஒரேழினோடு ஒரொன்பதாய்","paththinODu paththumAy orEzhinODu oronbadhAy"],[831,"வாசியாகி நேசம் இன்றி வந்து எதிர்ந்த தேனுகன்","vAsiyAgi nEsam inRi vandhu edhirndha thEnugan"],[832,"கடைந்த பாற்கடல் கிடந்து காலநேமியைக் கடிந்து","kaṭainta pāṟkaṭal kiṭantu kālanemiyaik kaṭintu"],[833,"எத்திறத்தும் ஒத்து நின்று உயர்ந்து உயர்ந்த பெற்றியோய்","eththiRaththum oththu ninRu uyarndhu uyarndha peRRiyOy"],[834,"மட்டுலாவு தண்டுழாய் அலங்கலாய் புலன் கழல்","maTTulAvu thaNDuzhAy alanggalAy pulan kazhal"],[835,"பின் பிறக்க வைத்தனன் கொல்? அன்றி நின்று தன் கழற்கு","piṉ piṟakka vaittaṉaṉ kŏl? aṉṟi niṉṟu taṉ kazhaṟku"],[836,"நச்சு அராவணைக் கிடந்த நாத! பாத போதினில்","nachchu arAvaNaik kiDandha nAdha! pAdha pOdhinil"],[837,"சாடு சாடு பாதனே! சலம் கலந்த பொய்கை வாய்","sADu sADu pAdhanE! salam kalandha poygai vAy"],[838,"நெற்றி பெற்ற கண்ணன் விண்ணின் நாதனோடு போதின்மேல்","nĕṟṟi pĕṟṟa kaṇṇaṉ viṇṇiṉ nātaṉoṭu potiṉmel"],[839,"வெள்ளை வேலை வெற்பு நாட்டி வெள் எயிற்று அராவு அளாய்","vĕl̤l̤ai velai vĕṟpu nāṭṭi vĕl̤ ĕyiṟṟu arāvu al̤āy"],[840,"பார் மிகுத்த பாரம் முன் ஒழிச்சுவான் அருச்சுனன்","pār mikutta pāram muṉ ŏzhiccuvāṉ aruccuṉaṉ"],[841,"குலங்களாய ஈரிரண்டில் ஒன்றிலும் பிறந்திலேன்","kulaṅkal̤āya īriraṇṭil ŏṉṟilum piṟantileṉ"],[842,"பண் உலாவு மென் மொழிப் படைத் தடங்கணாள் பொருட்டு","paṇ ulāvu mĕṉ mŏzhip paṭait taṭaṅkaṇāl̤ pŏruṭṭu"],[843,"விடைக் குலங்கள் ஏழ் அடர்த்து வென்றி வேற்கண் மாதரார்","viDaik kulanggaL Ezh aDarththu venRi vERkaN mAdharAr"],[844,"சுரும்பு அரங்கு தண்துழாய் துதைந்து அலர்ந்த பாதமே","surumbu aranggu thaNthuzhAy thudhaindhu alarndha pAdhamE"],[845,"ஊனில் மேய ஆவி நீ உறக்கமோடு உணர்ச்சி நீ","ūṉil meya āvi nī uṟakkamoṭu uṇarcci nī"],[846,"அடக்கு அரும் புலன்கள் ஐந்து அடக்கி ஆசையாம் அவை","aṭakku arum pulaṉkal̤ aintu aṭakki ācaiyām avai"],[847,"வரம்பு இலாத மாய மாய! வையம் ஏழும் மெய்ம்மையே","varambu ilAdha mAya mAya! vaiyam Ezhum meymmaiyE"],[848,"வெய்ய ஆழி சங்கு தண்டு வில்லும் வாளும் ஏந்து சீர்க்","vĕyya āzhi caṅku taṇṭu villum vāl̤um entu cīrk"],[849,"மறம் துறந்து வஞ்சம் மாற்றி ஐம்புலன்கள் ஆசையும்","maṟam tuṟantu vañcam māṟṟi aimpulaṉkal̤ ācaiyum"],[850,"காட்டி நான் செய் வல்வினைப் பயன் தனால் மனம் தனை","kATTi nAn sey valvinaip payan thanAl manam thanai"],[851,"பிறப்பினோடு பேர் இடர்ச் சுழிக்கண் நின்றும் நீங்கும் அஃது","piṟappiṉoṭu per iṭarc cuzhikkaṇ niṉṟum nīṅkum aḵtu"],[852,"இரந்து உரைப்பது உண்டு வாழி ஏம நீர் நிறத்தமா!","irandhu uraippadhu uNDu vAzhi Ema nIr niRaththamA!"],[853,"விள்விலாத காதலால் விளங்கு பாத போதில் வைத்து","viLvilAdha kAdhalAl viLanggu pAdha pOdhil vaiththu"],[854,"திருக் கலந்து சேரு மார்ப! தேவ தேவ தேவனே!","thiruk kalandhu sEru mArba! dhEva dhEva dhEvanE!"],[855,"கடுங் கவந்தன் வக்கரன் கரன் முரன் சிரம் அவை","kaṭuṅ kavantaṉ vakkaraṉ karaṉ muraṉ ciram avai"],[856,"மண்ணை உண்டு உமிழ்ந்து பின் இரந்து கொண்டு அளந்து மண்","maṇṇai uṇṭu umizhntu piṉ irantu kŏṇṭu al̤antu maṇ"],[857,"கறுத்து எதிர்ந்த காலநேமி காலனோடு கூட அன்று","kaṟuttu ĕtirnta kālanemi kālaṉoṭu kūṭa aṉṟu"],[858,"காய் சினத்த காசி மன்னன் வக்கரன் பவுண்டிரன்","kāy ciṉatta kāci maṉṉaṉ vakkaraṉ pavuṇṭiraṉ"],[859,"கேடில் சீர் வரத்தனாய்க் கெடும் வரத்தயன் அரன்","kEDil sIr varaththanAyk keDum varaththu ayan aran"],[860,"சுருக்குவாரை இன்றியே சுருங்கினாய் சுருங்கியும்","surukkuvArai inRiyE surungginAy surunggiyum"],[861,"தூயனாயும் அன்றியும் சுரும்புலாவு தண்டுழாய்","thUyanAyum anRiyum surumbulAvu thaNDuzhAy"],[862,"வைது நின்னை வல்லவா பழித்தவர்க்கும் மாறில் போர்","vaitu niṉṉai vallavā pazhittavarkkum māṟil por"],[863,"வாள்கள் ஆகி நாள்கள் செல்ல நோய்மை குன்றி மூப்பு எய்தி","vāl̤kal̤ āki nāl̤kal̤ cĕlla noymai kuṉṟi mūppu ĕyti"],[864,"சலம் கலந்த செஞ்சடைக் கறுத்த கண்டன் வெண்தலை","calam kalanta cĕñcaṭaik kaṟutta kaṇṭaṉ vĕṇtalai"],[865,"ஈனமாய எட்டும் நீக்கி ஏதம் இன்றி மீதுபோய்","īṉamāya ĕṭṭum nīkki etam iṉṟi mītupoy"],[866,"அத்தனாகி அன்னையாகி ஆளும் எம்பிரானுமாய்","aththanAgi annaiyAgi ALum empirAnumAy"],[867,"மாறு செய்த வாள் அரக்கன் நாள் உலப்ப அன்று இலங்கை","mARu seydha vAL arakkan nAL ulappa anRu ilanggai"],[868,"அச்சம் நோயொடு அல்லல் பல் பிறப்பு ஆய மூப்பு இவை","accam noyŏṭu allal pal piṟappu āya mūppu ivai"],[869,"சொல்லினும் தொழிற்கணும் தொடக்கு அறாத அன்பினும்","cŏlliṉum tŏzhiṟkaṇum tŏṭakku aṟāta aṉpiṉum"],[870,"பொன்னி சூழ் அரங்க மேய பூவை வண்ண! மாய! கேள்","ponni sUzh arangga mEya pUvai vaNNa! mAya! kEL"],[871,"இயக்கு அறாத பல்பிறப்பில் என்னை மாற்றி இன்று வந்து","iyakku aRAdha palpiRappil ennai mARRi inRu vandhu"],[872,"காவலில் புலனை வைத்துக் கலி தன்னைக் கடக்கப் பாய்ந்து","kAvalil pulanai vaiththuk kali thannaik kaDakkap pAyndhu"],[873,"பச்சை மாமலை போல் மேனி பவள வாய் கமலச் செங்கண்","pachchai mAmalai pOl mEni pavaLa vAy kamalach chengkaN"],[874,"வேத நூல் பிராயம் நூறு மனிசர் தாம் புகுவரேலும்","vEdha nUl pirAyam nURu manisar thAm puguvarElum"],[875,"மொய்த்த வல்வினையுள் நின்று மூன்றெழுத்து உடைய பேரால்","moyththa valvinaiyuL ninRu mUnRezhuththu uDaiya pErAl"],[876,"பெண்டிரால் சுகங்கள் உய்ப்பான் பெரியது ஓர் இடும்பை பூண்டு","pĕṇṭirāl cukaṅkal̤ uyppāṉ pĕriyatu or iṭumpai pūṇṭu"],[877,"மறம் சுவர் மதிள் எடுத்து மறுமைக்கே வெறுமை பூண்டு","maRam suvar madhiL eDuththu maRumaikkE veRumai pUNDu"],[878,"புலை அறம் ஆகி நின்ற புத்தொடு சமணம் எல்லாம்","pulai-aṟam āki niṉṟa puttŏṭu camaṇam ĕllām"],[879,"வெறுப்பொடு சமணர் முண்டர் விதி இல் சாக்கியர்கள் நின் பால்","veRuppoDu samaNar muNDar vidhi il sAkkiyargaL nin pAl"],[880,"மற்றும் ஓர் தெய்வம் உண்டே மதி இலா மானிடங்காள்","maRRum Or dheyvam uNDE madhi ilA mAniDanggAL"],[881,"நாட்டினான் தெய்வம் எங்கும் நல்லதோர் அருள் தன்னாலே","nATTinAn dheyvam enggum nalladhOr aruL thannAlE"],[882,"ஒரு வில்லால் ஓங்கு முந்நீர் அடைத்து உலகங்கள் உய்ய","oru villAl Onggu munnIr aDaiththu ulaganggaL uyya"],[883,"நமனும் முற்கலனும் பேச நரகில் நின்றார்கள் கேட்க","namanum muRkalanum pEsa naragil ninRArgaL kETka"],[884,"எறியு நீர் வெறி கொள் வேலை மாநிலத்து உயிர்கள் எல்லாம்","eRiyu nIr veRi koL vElai mAnilaththu uyirgaL ellAm"],[885,"வண்டினம் முரலும் சோலை மயிலினம் ஆலும் சோலை","vaNDinam muralum sOlai mayilinam Alum sOlai"],[886,"மெய்யர்க்கே மெய்யனாகும் விதி இலா என்னைப் போல","meyyarkkE meyyanAgum vidhi ilA ennaip pOla"],[887,"சூதனாய்க் கள்வனாகித் தூர்த்தரோடு இசைந்த காலம்","cūtaṉāyk kal̤vaṉākit tūrttaroṭu icainta kālam"],[888,"விரும்பி நின்று ஏத்த மாட்டேன் விதியிலேன் மதி ஒன்றில்லை","virumbi ninRu Eththa mATTEn vidhiyilEn madhi onRillai"],[889,"இனிது இரைத் திவலை மோத எறியும் தண்பரவை மீதே","inidhu iraith thivalai mOdha eRiyum thaNparavai mIdhE"],[890,"குட திசை முடியை வைத்துக் குண திசை பாதம் நீட்டி","kuDa thisai muDiyai vaiththuk guNa thisai pAdham nITTi"],[891,"பாயு நீர் அரங்கம் தன்னுள் பாம்பணைப் பள்ளி கொண்ட","pAyu nIr aranggam thannuL pAmbaNaip paLLi koNDa"],[892,"பணிவினால் மனமது ஒன்றிப் பவள வாய் அரங்கனார்க்கு","paNivinAl manamadhu onRip pavaLa vAy arangganArkku"],[893,"பேசிற்றே பேசல் அல்லால் பெருமை ஒன்று உணரல் ஆகாது","pEsiRRE pEsal allAl perumai onRu uNaral AgAdhu"],[894,"கங்கையில் புனிதம் ஆய காவிரி நடுவு பாட்டு","ganggaiyil punidham Aya kAviri naDuvu pATTu"],[895,"வெள்ள நீர் பரந்து பாயும் விரி பொழில் அரங்கந் தன்னுள்","vĕl̤l̤a-nīr parantu pāyum viri pŏzhil araṅkan taṉṉul̤"],[896,"குளித்து மூன்று அனலை ஓம்பும் குறிகொள் அந்தணமை தன்னை","kul̤ittu mūṉṟu aṉalai ompum kuṟikŏl̤ antaṇamai taṉṉai"],[897,"போது எல்லாம் போது கொண்டு உன் பொன்னடி புனைய மாட்டேன்","pOdhu ellAm pOdhu koNDu un ponnaDi punaiya mATTEn"],[898,"குரங்குகள் மலையை நூக்கக் குளித்துத் தாம் புரண்டிட்டு ஓடி","kuranggugaL malaiyai nUkkak kuLiththuth thAm puraNDiTTu ODi"],[899,"உம்பரால் அறியலாகா ஒளியுளார் ஆனைக்காகி","umbarAl aRiyalAgA oLiyuLAr AnaikkAgi"],[900,"ஊரிலேன் காணி இல்லை உறவு மற்றொருவர் இல்லை","UrilEn kANi illai uRavu maRRoruvar illai"],[901,"மனத்திலோர் தூய்மை இல்லை வாயிலோர் இன்சொல் இல்லை","manaththilOr thUymai illai vAyilOr insol illai"],[902,"தவத்துளார் தம்மில் அல்லேன் தனம் படத்தாரில் அல்லேன்","thavaththuLAr thammil allEn dhanam paDaththAril allEn"],[903,"ஆர்த்து வண்டலம்பும் சோலை அணி திருவரங்கம் தன்னுள்","Arththu vaNDalambum sOlai aNi thiruvaranggam thannuL"],[904,"மெய் எல்லாம் போக விட்டு விரி குழலாரில் பட்டு","mey ellAm pOga viTTu viri kuzhalAril paTTu"],[905,"உள்ளத்தே உறையும் மாலை உள்ளுவான் உணர்வு ஒன்றில்லா","uLLaththE uRaiyum mAlai uLLuvAn uNarvu onRillA"],[906,"தாவி அன்று உலகம் எல்லாம் தலை விளாக் கொண்ட எந்தாய்!","thAvi anRu ulagam ellAm thalai viLAk koNDa endhAy!"],[907,"மழைக்கு அன்று வரை முன் ஏந்தும் மைந்தனே! மதுர ஆறே!","mazhaikku anRu varai mun Endhum maindhanE! madhura ARE!"],[908,"தெளிவிலாக் கலங்கல் நீர் சூழ் திருவரங்கத்துள் ஓங்கும்","theLivilAk kalanggal nIr sUzh thiruvaranggaththuL Onggum"],[909,"மேம்பொருள் போக விட்டு மெய்ம்மையை மிக உணர்ந்து","mEmporuL pOga viTTu meymmaiyai miga uNarndhu"],[910,"அடிமையில் குடிமை இல்லா அயல் சதுப்பேதிமாரில்","aDimaiyil kuDimai illA ayal sadhuppEdhimAril"],[911,"திரு மறு மார்வ! நின்னைச் சிந்தையுள் திகழ வைத்து","thiru maRu mArva! ninnaich sindhaiyuL thigazha vaiththu"],[912,"வானுளார் அறியலாகா வானவா என்பராகில்","vAnuLAr aRiyalAgA vAnavA enbarAgil"],[913,"பழுதிலா ஒழுகல் ஆற்றுப் பல சதுப்பேதிமார்கள்!","pazhudhilA ozhugal ARRup pala sadhuppEdhimArgaL!"],[914,"அமர ஓர் அங்கம் ஆறும் வேதம் ஓர் நான்கும் ஓதி","amara Or anggam ARum vEdham Or nAnkum Odhi"],[915,"பெண்ணுலாம் சடையினானும் பிரமனும் உன்னைக் காண்பான்","peNNulAm saDaiyinAnum piramanum unnaik kANbAn"],[916,"வளவெழும் தவள மாட மதுரை மாநகரம் தன்னுள்","vaLavezhum thavaLa mADa madhurai mAnagaram thannuL"],[917,"கதிரவன் குணதிசைச் சிகரம் வந்து அணைந்தான்","katiravaṉ kuṇaticaic cikaram vantu aṇaintāṉ"],[918,"கொழுங்கொடி முல்லையின் கொழு மலர் அணவிக்","kozhungkoDi mullaiyin kozhu malar aNavik"],[919,"சுடர் ஒளி பரந்தன சூழ் திசை எல்லாம்","cuṭar-ŏl̤i parantaṉa cūzh ticai ĕllām"],[920,"மேட்டிள மேதிகள் தளை விடும் ஆயர்கள்","mETTiLa mEdhigaL thaLai viDum AyargaL"],[921,"புலம்பின புட்களும் பூம்பொழில்களின் வாய்","pulambina puTkaLum pUmpozhilgaLin vAy"],[922,"இரவியர் மணி நெடும் தேரொடும் இவரோ?","iraviyar maNi neDum thEroDum ivarO?"],[923,"அந்தரத்து அமரர்கள் கூட்டங்கள் இவையோ?","andharaththu amarargaL kUTTanggaL ivaiyO?"],[924,"வம்பவிழ் வானவர் வாயுறை வழங்க","vampavizh vāṉavar vāyuṟai vazhaṅka"],[925,"ஏதமில் தண்ணுமை எக்கம் மத்தளி","Edhamil thaNNumai ekkam maththaLi"],[926,"கடி மலர்க் கமலங்கள் மலர்ந்தன இவையோ?","kaDi malark kamalanggaL malarndhana ivaiyO?"],[927,"அமலன் ஆதி பிரான் அடியார்க்கு என்னை ஆட்படுத்த","amalan Adhi pirAn aDiyArkku ennai ATpaDuththa"],[928,"உவந்த உள்ளத்தனாய் உலகம் அளந்து அண்டம் உற","uvandha uLLaththanAy ulagam aLandhu aNDam uRa"],[929,"மந்தி பாய் வட வேங்கட மாமலை வானவர்கள்","mandhi pAy vaDa vEngkaDa mAmalai vAnavargaL"],[930,"சதுரமா மதிள் சூழ் இலங்கைக்கு இறைவன் தலை பத்து","sadhuramA madhiL sUzh ilanggaikku iRaivan thalai paththu"],[931,"பாரமாய பழ வினை பற்று அறுத்து என்னைத் தன்","pAramAya pazha vinai paRRu aRuththu ennaith than"],[932,"துண்ட வெண்பிறையன் துயர் தீர்த்தவன் அஞ்சிறைய","thuNDa veNpiRaiyan thuyar thIrththavan anjchiRaiya"],[933,"கையினார் சுரிசங்கு அனல் ஆழியர் நீள் வரை போல்","kaiyinAr surisanggu anal Azhiyar nIL varai pOl"],[934,"பரியனாகி வந்த அவுணன் உடல் கீண்ட அமரர்க்கு","pariyanAgi vandha avuNan uDal kINDa amararkku"],[935,"ஆலமா மரத்தின் இலை மேல் ஒரு பாலகனாய்","AlamA maraththin ilai mEl oru pAlaganAy"],[936,"கொண்டல் வண்ணனைக் கோவலனாய் வெண்ணெய்","koNDal vaNNanaik kOvalanAy veNNey"],[937,"கண்ணிநுண் சிறுத் தாம்பினால் கட்டுண்ணப்","kaNNinuN siRuth thAmbinAl kaTTuNNap"],[938,"நாவினால் நவிற்று இன்பம் எய்தினேன்","nAvinAl naviRRu inbam eydhinEn"],[939,"திரிதந்து ஆகிலும் தேவபிரான் உடை","tiritantu ākilum tevapirāṉ uṭai"],[940,"நன்மையால் மிக்க நான்மறையாளர்கள்","nanmaiyAl mikka nAnmaRaiyALargaL"],[941,"நம்பினேன் பிறர் நன்பொருள் தன்னையும்","nambinEn piRar nanporuL thannaiyum"],[942,"இன்று தொட்டும் எழுமையும் எம்பிரான்","iṉṟu tŏṭṭum ĕzhumaiyum ĕmpirāṉ"],[943,"கண்டு கொண்டென்னைக் காரிமாறப் பிரான்","kaNDu koNDennaik kArimARap pirAn"],[944,"அருள் கொண்டாடும் அடியவர் இன்புற","aruL koNDADum aDiyavar inbuRa"],[945,"மிக்க வேதியர் வேதத்தின் உட்பொருள்","mikka vEdhiyar vEdhaththin uTporuL"],[946,"பயன் அன்றாகிலும் பாங்கல்லர் ஆகிலும்","payan anRAgilum pAnggallar Agilum"],[947,"அன்பன் தன்னை அடைந்தவர்கட்கு எல்லாம்","anban thannai aDaindhavargaTku ellAm"],[948,"வாடினேன் வாடி வருந்தினேன் மனத்தால்","vADinEn vADi varundhinEn manaththAl"],[949,"ஆவியே! அமுதே! என நினைந்து உருகி","AviyE! amudhE! ena ninaindhu urugi"],[950,"சேமமே வேண்டித் தீவினை பெருக்கித்","sEmamE vENDith thIvinai perukkith"],[951,"வென்றியே வேண்டி வீழ் பொருட்கு இரங்கி","venRiyE vENDi vIzh poruTku iranggi"],[952,"கள்வனேன் ஆனேன் படிறு செய்திருப்பேன்","kaLvanEn AnEn paDiRu seydhiruppEn"],[953,"எம்பிரான் எந்தை என்னுடைச் சுற்றம்","empirAn endhai ennuDaich chuRRam"],[954,"இற்பிறப்பு அறியீர் இவர் அவர் என்னீர்","iRpiRappu aRiyIr ivar avar ennIr"],[955,"கற்றிலேன் கலைகள் ஐம்புலன் கருதும்","kaRRilEn kalaigaL aimpulan karudhum"],[956,"குலம் தரும் செல்வம் தந்திடும்","kulam tharum selvam thandhiDum"],[957,"மஞ்சுலாம் சோலை வண்டறை மாநீர்","manjchulAm sOlai vaNDaRai mAnIr"],[958,"வாலி மா வலத்து ஒருவனது உடல் கெட வரி சிலை வளைவித்து அன்று","vāli mā valattu ŏruvaṉatu uṭal kĕṭa vari cilai val̤aivittu aṉṟu"],[959,"கலங்க மாக்கடல் அரிகுலம் பணி செய்ய","kalangga mAkkaDal arikulam paNi seyya"],[960,"துடிகொள் நுண்ணிடைச் சுரிகுழல்","thuDikoL nuNNiDaich churikuzhal"],[961,"மறங்கொள் ஆளரி உருவென வெருவர","maRangkoL ALari uruvena veruvara"],[962,"கரைசெய் மாக்கடல் கிடந்தவன்","karaisey mAkkaDal kiDandhavan"],[963,"பணங்கள் ஆயிரம் உடைய நல் அரவணைப்","paNanggaL Ayiram uDaiya nal aravaNaip"],[964,"கார் கொள் வேங்கைகள் கனவரை தழுவிய","kAr koL vEnggaigaL kanavarai thazhuviya"],[965,"இரவு கூர்ந்து இருள் பெருகிய வரை முழை","iravu kUrndhu iruL perugiya varai muzhai"],[966,"ஓதி ஆயிர நாமங்கள் உணர்ந்தவர்க்கு","Odhi Ayira nAmanggaL uNarndhavarkku"],[967,"கரிய மாமுகில் படலங்கள் கிடந்து","kariya mAmugil paDalanggaL kiDandhu"],[968,"முற்ற மூத்துக் கோல் துணையா முன்னடி நோக்கி வளைந்து","muRRa mUththuk kOl thuNaiyA munnaDi nOkki vaLaindhu"],[969,"முதுகு பற்றிக் கைத்தலத்தால் முன்னொரு கோல் ஊன்றி","mudhugu paRRik kaiththalaththAl munnoru kOl UnRi"],[970,"உறிகள் போல் மெய்ந் நரம்பு எழுந்து ஊன் தளர்ந்து உள்ளம் எள்கி","uṟikal̤ pol mĕyn narampu ĕzhuntu ūṉ tal̤arntu ul̤l̤am ĕl̤ki"],[971,"பீளை சோரக் கண் இடுங்கிப் பித்தெழ மூத்து இருமி","pILai sOrak kaN iDunggip piththezha mUththu irumi"],[972,"பண்டு காமர் ஆனவாறும் பாவையர் வாய் அமுதம்","paNDu kAmar AnavARum pAvaiyar vAy amudham"],[973,"எய்த்த சொல்லோடு ஈளை ஏங்கி இருமி இளைத்து உடலம்","eyththa sollODu ILai Enggi irumi iLaiththu uDalam"],[974,"பப்ப அப்பர் மூத்தவாறு பாழ்ப்பது சீத்திரளை","pappa appar mUththavARu pAzhppadhu sIththiraLai"],[975,"ஈசி போமின் ஈங்கு இரேன்மின் இருமி இளைத்தீர் உள்ளம்","īci pomiṉ īṅku ireṉmiṉ irumi il̤aittīr ul̤l̤am"],[976,"புலன்கள் நைய மெய்யில் மூத்துப் போந்திருந்து உள்ளம் எள்கி","pulankaL naiya meyyil mUththup pOndhirundhu uLLam eLgi"],[977,"வண்டு தண்தேன் உண்டு வாழும் வதரி நெடுமாலை","vaNDu thaNthEn uNDu vAzhum vadhari neDumAlai"],[978,"ஏனமுனாகி இருநிலம் இடந்து","EnamunAgi irunilam iDandhu"],[979,"கானிடை உருவைச் சுடு சரம் துரந்து","kAniDai uruvaich chuDu saram thurandhu"],[980,"இலங்கையும் கடலும் அடல் அருந்துப்பின்","ilanggaiyum kaDalum aDal arunthuppin"],[981,"துணிவு இனி உனக்குச் சொல்லுவன் மனமே!","thuNivu ini unakkuch solluvan manamE!"],[982,"பேய் இடைக்கிருந்து வந்த மற்றவள் தன்","pEy iDaikkirundhu vandha maRRavaL than"],[983,"தேரணங்கு அல்குல் செழுங்கயல் கண்ணி திறத்து","thEraNanggu algul sezhungkayal kaNNi thiRaththu"],[984,"வெந்திறல் களிறும் வேலை வாய் அமுதும்","venthiRal kaLiRum vElai vAy amudhum"],[985,"மான் முனிந்து ஒருகால் வரிசிலை வளைத்த","mAn munindhu orukAl varisilai vaLaiththa"],[986,"கொண்டல் மாருதங்கள் குல வரை தொகு நீர்க் குரை கடல் உலகு உடன் அனைத்தும்","kŏṇṭal mārutaṅkal̤ kula varai tŏku nīrk kurai kaṭal ulaku uṭaṉ aṉaittum"],[987,"வருந்திரை மணி நீர்க் கங்கையின் கரை மேல்","varunthirai maNi nIrk ganggaiyin karai mEl"],[988,"கலையும் கரியும் பரிமாவும் திரியும் கானம் கடந்து போய்","kalaiyum kariyum parimāvum tiriyum kāṉam kaṭantu poy"],[989,"கடம் சூழ் கரியும் பரிமாவும் ஒலி மாந்தேரும் காலாளும்","kaDam sUzh kariyum parimAvum oli mAnthErum kAlALum"],[990,"உலவு திரையும் குல வரையும் ஊழி முதலா எண் திக்கும்","ulavu thiraiyum kula varaiyum Uzhi mudhalA eN thikkum"],[991,"ஊரான் குடந்தை உத்தமன் ஒருகால் இருகால் சிலை வளைய","UrAn kuDandhai uththaman orukAl irukAl silai vaLaiya"],[992,"அடுத்தார்த்து எழுந்தாள் பிலவாய் விட்டலற அவள் மூக்கு அயில் வாளால்","aDuththArththu ezhundhAL pilavAy viTTalaRa avaL mUkku ayil vALAl"],[993,"தாயாய் வந்த பேய் உயிரும் தயிரும் இழுதும் உடன் உண்ட","thAyAy vandha pEy uyirum thayirum izhudhum uDan uNDa"],[994,"ஏனோர் அஞ்ச வெஞ்சமத்துள் அரியாய்ப் பரிய இரணியனை","EnOr anjcha venjchamaththuL ariyAyp pariya iraNiyanai"],[995,"வெந்தார் என்பும் சுடு நீறும் மெய்யில் பூசிக் கையகத்து ஓர்","vendhAr enbum suDu nIRum meyyil pUsik kaiyagaththu Or"],[996,"தொண்டு ஆம் இனமும் இமையோரும் துணை நூல் மார்பின் அந்தணரும்","tŏṇṭu ām iṉamum imaiyorum tuṇai nūl mārpiṉ antaṇarum"],[997,"தாரா ஆரும் வயல் சூழ்ந்த சாளக்கிராமத்து அடிகளை","thArA Arum vayal sUzhndha sALakkirAmaththu aDigaLai"],[998,"வாணிலா முறுவல் சிறுநுதல் பெருந்தோள்","vANilA muRuval siRunudhal perunthOL mAdharAr vanamulaip payanE"],[999,"சிலம்படி உருவிற் கருநெடுங்கண்ணார்","silambaDi uruviR karuneDungkaNNAr thiRaththanAy aRaththaiyE maRandhu"],[1000,"சூதினைப் பெருக்கிக் களவினைத் துணிந்து","sUdhinaip perukkik kaLavinaith thuNindhu surikuzhal maDandhaiyar thiRaththu"],[1001,"வம்புலாம் கூந்தல் மனைவியைத் துறந்து","vambulAm kUndhal manaiviyaith thuRandhu piRar poruL thAram enRu ivaRRai"],[1002,"இடும்பையால் அடர்ப்புண்டு இடுமினோ துற்றென்று","iDumbaiyAl aDarppuNDu iDuminO thuRRenRu irandhavarkku illaiyE enRu"],[1003,"கோடிய மனத்தால் சினத்தொழில் புரிந்து","kODiya manaththAl sinaththozhil purindhu thirindhu nAy inaththoDum thiLaiththiTTu"],[1004,"நெஞ்சினால் நினைந்தும் வாயினால் மொழிந்தும்","nenjchinAl ninaindhum vAyinAl mozhindhum nIdhi allAdhana seydhum"],[1005,"ஏவினார் கலியார் நலிக என்று என் மேல்","EvinAr kaliyAr naliga enRu en mEl engnganE vAzhumARu? aivar"],[1006,"ஊனிடைச் சுவர் வைத்து என்பு தூண் நாட்டி","UniDaich chuvar vaiththu enbu thUN nATTi urOmam vEyndhu onbadhu vAsal"],[1007,"ஏதம் வந்து அணுகா வண்ணம் நாம் எண்ணி","Edham vandhu aNugA vaNNam nAm eNNi ezhuminO thozhudhum enRu imaiyOr"],[1008,"அங்கண் ஞாலம் அஞ்ச அங்கோர் ஆளரியாய் அவுணன்","angkaN njAlam anjcha anggOr ALariyAy avuNan"],[1009,"அலைத்த பேழ் வாய் வாள் எயிற்றோர் கோள் அரியாய் அவுணன்","alaiththa pEzh vAy vAL eyiRROr kOL ariyAy avuNan"],[1010,"ஏய்ந்த பேழ் வாய் வாள் எயிற்றோர் கோள் அரியாய் அவுணன்","Eyndha pEzh vAy vAL eyiRROr kOL ariyAy avuNan"],[1011,"எவ்வம் வெவ்வேல் பொன் பெயரோன் ஏதலன் இன்னுயிரை","evvam vevvEl pon peyarOn Edhalan innuyirai"],[1012,"மென்ற பேழ் வாய் வாள் எயிற்றோர் கோள் அரியாய் அவுணன்","menRa pEzh vAy vAL eyiRROr kOL ariyAy avuNan"],[1013,"எரிந்த பைங்கண் இலங்கு பேழ் வாய் எயிற்றொடு இது எவ்வுரு என்று","erindha painggaN ilanggu pEzh vAy eyiRRoDu idhu evvuru enRu"],[1014,"முனைத்த சீற்றம் விண் சுடப் போய் மூவுலகும் பிறவும்","munaiththa sIRRam viN suDap pOy mUvulagum piRavum"],[1015,"நாத் தழும்ப நான்முகனும் ஈசனுமாய் முறையால்","nAth thazhumba nAnmuganum IsanumAy muRaiyAl"],[1016,"நல்லை நெஞ்சே! நாம் தொழுதும் நம்முடை நம்பெருமான்","nallai nenjchE! nAm thozhudhum nammuDai namperumAn"],[1017,"செங்கண் ஆளி இட்டிறைஞ்சும் சிங்கவேள் குன்றுடைய","sengkaN ALi iTTiRainjchum singgavEL kunRuDaiya"],[1018,"கொங்கலர்ந்த மலர்க் குருந்தம் ஒசித்த கோவலன் எம்பிரான்","konggalarndha malark kurundham osiththa kOvalan empirAn"],[1019,"பள்ளி ஆவது பாற்கடல் அரங்கம் இரங்க வன்பேய் முலை","paLLi Avadhu pARkaDal aranggam irangga vanpEy mulai"],[1020,"நின்ற மாமருது இற்று வீழ நடந்த நின்மலன் நேமியான்","ninRa mAmarudhu iRRu vIzha naDandha ninmalan nEmiyAn"],[1021,"பார்த்தற்காய் அன்று பாரதம் கை செய்திட்டு வென்ற பரஞ்சுடர்","pArththaRkAy anRu pAradham kai seydhiTTu venRa paranjchuDar"],[1022,"வண்கையான் அவுணர்க்கு நாயகன் வேள்வியில் சென்று மாணியாய்","vaNkaiyAn avuNarkku nAyagan vELviyil senRu mANiyAy"],[1023,"எண்திசைகளும் ஏழுலகமும் வாங்கிப் பொன் வயிற்றில் பெய்து","eNthisaigaLum Ezhulagamum vAnggip pon vayiRRil peydhu"],[1024,"பாரும் நீர் எரி காற்றினோடு ஆகாசமும் இவை ஆயினான்","pārum nīr ĕri kāṟṟiṉoṭu ākācamum ivai āyiṉāṉ"],[1025,"அம்பரம் அனல் கால் நிலம் சலம் ஆகி நின்ற அமரர் கோன்","ambaram anal kAl nilam salam Agi ninRa amarar kOn"],[1026,"பேசுமின் திருநாமம் எட்டெழுத்தும் சொல்லி நின்று பின்னரும்","pEsumin thirunAmam eTTezhuththum solli ninRu pinnarum"],[1027,"செங்கயல் திளைக்கும் சுனைத் திருவேங்கடத்துறை செல்வனை","sengkayal thiLaikkum sunaith thiruvEngkaDaththuRai selvanai"],[1028,"தாயே தந்தை என்றும் தாரமே கிளை மக்கள் என்றும்","tāye tantai ĕṉṟum tārame kil̤ai makkal̤ ĕṉṟum"],[1029,"மானேய் கண் மடவார் மயக்கில் பட்டு மாநிலத்து","mAnEy kaN maDavAr mayakkil paTTu mAnilaththu"],[1030,"கொன்றேன் பல்லுயிரைக் குறிக்கோள் ஒன்று இலாமையினால்","konREn palluyiraik kuRikkOL onRu ilAmaiyinAl"],[1031,"குலம் தான் எத்தனையும் பிறந்தே இறந்து எய்த்தொழிந்தேன்","kulam thAn eththanaiyum piRandhE iRandhu eyththozhindhEn"],[1032,"எப்பாவம் பலவும் இவையே செய்து இளைத்து ஒழிந்தேன்","eppAvam palavum ivaiyE seydhu iLaiththu ozhindhEn"],[1033,"மண்ணாய் நீர் எரி கால் மஞ்சுலாவும் ஆகாசமுமாம்","maNNAy nIr eri kAl manjchulAvum AgAsamumAm"],[1034,"தெரியேன் பாலகனாய்ப் பல தீமைகள் செய்துமிட்டேன்","theriyEn pAlaganAyp pala thImaigaL seydhumiTTEn"],[1035,"நோற்றேன் பல் பிறவி நுன்னைக் காண்பது ஓர் ஆசையினால்","noṟṟeṉ pal piṟavi nuṉṉaik kāṇpatu or ācaiyiṉāl"],[1036,"பற்றேல் ஒன்றுமிலேன் பாவமே செய்து பாவி ஆனேன்","paRREl onRumilEn pAvamE seydhu pAvi AnEn"],[1037,"கண்ணாய் ஏழுலகுக்கு உயிராய எங்கார் வண்ணனை","kaNNAy Ezhulagukku uyirAya engkAr vaNNanai"],[1038,"கண்ணார் கடல் சூழ் இலங்கைக்கு இறைவன் தன்","kaNNAr kaDal sUzh ilanggaikku iRaivan than"],[1039,"இலங்கைப் பதிக்கு அன்று இறையாய அரக்கர்","ilanggaip padhikku anRu iRaiyAya arakkar"],[1040,"நீரார் கடலும் நிலனும் முழுது உண்டு","nIrAr kaDalum nilanum muzhudhu uNDu"],[1041,"உண்டாய் உறி மேல் நறுநெய் அமுதாக","uNDAy uRi mEl naRuney amudhAga"],[1042,"தூணாய் அதனூடு அரியாய் வந்து தோன்றி","thUNAy adhanUDu ariyAy vandhu thOnRi"],[1043,"மன்னா இம்மனிசப் பிறவியை நீக்கி","mannA immanisap piRaviyai nIkki"],[1044,"மானேய் மடநோக்கி திறத்து எதிர் வந்த","mAnEy maDanOkki thiRaththu edhir vandha"],[1045,"சேயன் அணியன் என சிந்தையுள் நின்ற","sEyan aNiyan ena sindhaiyuL ninRa"],[1046,"வந்தாய் என் மனம் புகுந்தாய் மன்னி நின்றாய்!","vandhAy en manam pugundhAy manni ninRAy!"],[1047,"வில்லார் மலி வேங்கட மாமலை மேய","villAr mali vEngkaDa mAmalai mEya"],[1048,"வானவர் தங்கள் சிந்தை போல என் நெஞ்சமே! இனிது உவந்து மா தவ","vAnavar thanggaL sindhai pOla en nenjchamE! inidhu uvandhu mA thava"],[1049,"உறவு சுற்றம் என்று ஒன்றிலா ஒருவன் உகந்தவர் தம்மை மண் மிசைப்","uRavu suRRam enRu onRilA oruvan ugandhavar thammai maN misaip"],[1050,"இண்டை ஆயின கொண்டு தொண்டர்கள் ஏத்துவார் உறவோடும் வானிடைக்","iNDai Ayina koNDu thoNDargaL EththuvAr uRavODum vAniDaik"],[1051,"பாவியாது செய்தாய் என் நெஞ்சமே! பண்டு தொண்டு செய்தாரை மண்மிசை","pAviyAdhu seydhAy en nenjchamE! paNDu thoNDu seydhArai maNmisai"],[1052,"பொங்கு போதியும் பிண்டியும் உடைப் புத்தர் நோன்பியர் பள்ளியுள் உறை","ponggu pOdhiyum piNDiyum uDaip buththar nOnbiyar paLLiyuL uRai"],[1053,"துவரி ஆடையர் மட்டையர் சமண் தொண்டர்கள் மண்டி உண்டு பின்னரும்","thuvari ADaiyar maTTaiyar samaN thoNDargaL maNDi uNDu pinnarum"],[1054,"தருக்கினால் சமண் செய்து சோறு தண்தயிரினால் திரளை மிடற்றிடை","tharukkinAl samaN seydhu sORu thaNthayirinAl thiraLai miDaRRiDai"],[1055,"சேயன் அணியன் சிறியன் பெரியன் என்பதும் சிலர் பேசக் கேட்டிருந்","sEyan aNiyan siRiyan periyan enbadhum silar pEsak kETTirun"],[1056,"கூடி ஆடி உரைத்ததே உரைத்தாய் என் நெஞ்சம் என்பாய்! துணிந்து கேள்","kUDi ADi uraiththadhE uraiththAy en nenjcham enbAy! thuNindhu kEL"],[1057,"மின்னு மாமுகில் மேவு தண்திருவேங்கட மலை கோயில் மேவிய","minnu mAmugil mEvu thaNthiruvEngkaDa malai kOyil mEviya"],[1058,"காசை ஆடை மூடி ஓடிக் காதல் செய்தான் அவன் ஊர்","kAsai ADai mUDi ODik kAdhal seydhAn avan Ur"],[1059,"தையலாள் மேல் காதல் செய்த தானவன் வாள் அரக்கன்","thaiyalAL mEl kAdhal seydha dhAnavan vAL arakkan"],[1060,"முன் ஓர் தூது வானரத்தின் வாயில் மொழிந்து அரக்கன்","muṉ or tūtu vāṉarattiṉ vāyil mŏzhintu arakkaṉ"],[1061,"பந்தணைந்த மெல்விரலாள் பாவை தன் காரணத்தால்","pandhaNaindha melviralAL pAvai than kAraNaththAl"],[1062,"பாலனாகி ஞாலம் ஏழும் உண்டு பண்டு ஆலிலை மேல்","pAlanAgi njAlam Ezhum uNDu paNDu Alilai mEl"],[1063,"சோத்த நம்பி என்று தொண்டர் மிண்டித் தொடர்ந்து அழைக்கும்","sOththa nambi enRu thoNDar miNDith thoDarndhu azhaikkum"],[1064,"திங்கள் அப்பு வான் எரி காலாகி திசை முகனார்","thinggaL appu vAn eri kAlAgi thisai muganAr"],[1065,"முனிவன் மூர்த்தி மூவராகி வேதம் விரித்து உரைத்த","munivan mUrththi mUvarAgi vEdham viriththu uraiththa"],[1066,"பந்திருக்கும் மெல்விரலாள் பாவை பனிமலராள்","pandhirukkum melviralAL pAvai panimalarAL"],[1067,"இண்டை கொண்டு தொண்டர் ஏத்த எவ்வுள் கிடந்தானை","iNDai koNDu thoNDar Eththa evvuL kiDandhAnai"],[1068,"விற்பெரு விழவும் கஞ்சனும் மல்லும்","viRperu vizhavum kanjchanum mallum vEzhamum pAganum vIzha"],[1069,"வேதத்தை வேதத்தின் சுவைப் பயனை","vEdhaththai vEdhaththin suvaip payanai vizhumiya munivar vizhunggum"],[1070,"வஞ்சனை செய்யத் தாய் உருவாகி","vanjchanai seyyath thAy uruvAgi vandha pEy alaRi maN sEra"],[1071,"இந்திரனுக்கு என்று ஆயர்கள் எடுத்த","indhiranukku enRu AyargaL eDuththa ezhil vizhavil pazha naDai sey"],[1072,"இன் துணைப் பதுமத்து அலர்மகள் தனக்கும் இன்பன்","in thuNaip padhumaththu alarmagaL thanakkum inban naRpuvi thanakku iRaivan"],[1073,"அந்தகன் சிறுவன் அரசர் தம் அரசற்கு","andhagan siRuvan arasar tham arasaRku iLaiyavan aNiyizhaiyaich senRu"],[1074,"பரதனும் தம்பி சத்துருக்கனனும்","barathanum thambi chaththurukkananum ilakkumanODu maithiliyum"],[1075,"பள்ளியில் ஓதி வந்த தன் சிறுவன்","paLLiyil Odhi vandha than siRuvan vAyil Or Ayira nAmam"],[1076,"மீன் அமர் பொய்கை நாள் மலர் கொய்வான்","mIn amar poygai nAL malar koyvAn vETkaiyinODu senRu izhindha"],[1077,"மன்னு தண்பொழிலும் வாவியும் மதிளும்","mannu thaNpozhilum vAviyum madhiLum mADa mALigaiyum maNDapamum"],[1078,"அன்றாயர் குலக் கொடியோடு அணிமாமலர்","anRAyar kulak koDiyODu aNimAmalar manggaiyoDu anbaLavi avuNarkku"],[1079,"காண்டா வனம் என்பது ஓர் காடு அமரர்க்கு அரையன்னது கண்டு அவன் நிற்க முனே","kāṇṭā vaṉam ĕṉpatu or kāṭu amararkku araiyaṉṉatu kaṇṭu avaṉ niṟka muṉe"],[1080,"அலமன்னும் அடல் சுரி சங்கம் எடுத்து","alamannum aDal suri sanggam eDuththu aDal AzhiyinAl aNiyAr uruvil"],[1081,"தாங்காததொர் ஆளரியாய் அவுணன் தனை","thAnggAdhadhor ALariyAy avuNan thanai vIDa munindhu avanAl amarum"],[1082,"மாலும் கடல் ஆர மலைக் குவடிட்டு அணை கட்டி","mAlum kaDal Ara malaik kuvaDiTTu aNai kaTTi varamburuva madhi sEr"],[1083,"பாரார் உலகும் பனி மால் வரையும்","pArAr ulagum pani mAl varaiyum kaDalum suDarum ivai uNDum enakku"],[1084,"புகரார் உருவாகி முனிந்தவனைப்","pugarAr uruvAgi munindhavanaip pugazh vIDa munindhu uyir uNDu asuran"],[1085,"பிச்சச் சிறு பீலி பிடித்து உலகில்","pichchach siRu pIli piDiththu ulagil piNam thin maDavAr avar pOl angnganE"],[1086,"பேசும் அளவன்று இது வம்மின் நமர்","pEsum aLavanRu idhu vammin namar piRar kETpadhan mun paNivAr vinaigaL"],[1087,"நெடுமால் அவன் மேவிய நீர்மலை மேல்","neDumAl avan mEviya nIrmalai mEl nilavum pugazh manggaiyar kOn amaril"],[1088,"பாராயது உண்டு உமிழ்ந்த பவளத் தூணைப்","pArAyadhu uNDu umizhndha pavaLath thUNaip"],[1089,"பூண்டு அவத்தம் பிறர்க்கு அடைந்து தொண்டு பட்டுப் பொய்ந் நூலை மெய்ந் நூல் என்று என்றும் ஓதி","pūṇṭu avattam piṟarkku aṭaintu tŏṇṭu paṭṭup pŏyn nūlai mĕyn nūl ĕṉṟu ĕṉṟum oti"],[1090,"உடம்புருவில் மூன்றொன்றாய் மூர்த்தி வேறாய்","uDamburuvil mUnRonRAy mUrththi vERAy"],[1091,"பேய்த் தாயை முலை உண்ட பிள்ளை தன்னைப் பிணை மருப்பின் கருங் களிற்றை பிணை மான் நோக்கின்","peyt tāyai mulai uṇṭa pil̤l̤ai- taṉṉaip piṇai maruppiṉ karuṅ kal̤iṟṟai piṇai māṉ nokkiṉ"],[1092,"பாய்ந்தானைத் திரி சகடம் பாறி வீழப்","pAyndhAnaith thiri sagaDam pARi vIzhap"],[1093,"கிடந்தானைத் தடங்கடலுள் பணங்கள் மேவிக்","kiDandhAnaith thaDangkaDaluL paNanggaL mEvik"],[1094,"பேணாத வலி அரக்கர் மெலிய அன்று","pENAdha vali arakkar meliya anRu"],[1095,"பெண்ணாகி இன்னமுதம் வஞ்சித்தானைப்","peNNAgi innamudham vanjchiththAnaip"],[1096,"தொண்டாயார் தாம் பரவும் அடியினானைப்","thoNDAyAr thAm paravum aDiyinAnaip"],[1097,"பட நாகத்து அணைக் கிடந்து அன்று அவுணர் கோனைப் பட வெகுண்டு மருது இடை போய் பழன வேலி","paṭa nākattu aṇaik kiṭantu aṉṟu avuṇar-koṉaip paṭa vĕkuṇṭu marutu iṭai poy pazhaṉa veli"],[1098,"நண்ணாத வாள் அவுணர் இடைப் புக்கு வானவரைப்","naNNAdha vAL avuNar iDaip pukku vAnavaraip"],[1099,"பார்வண்ண மடமங்கை பனி நன்மாமலர்க் கிழத்தி","pArvaNNa maDamanggai pani nanmAmalark kizhaththi"],[1100,"ஏனத்தின் உருவாகி நிலமங்கை எழில் கொண்டான்","Enaththin uruvAgi nilamanggai ezhil koNDAn"],[1101,"விண்டாரை வென்றாவி விலங்கு உண்ண மெல்லியலார்","viNDArai venRAvi vilanggu uNNa melliyalAr"],[1102,"பிச்சச் சிறு பீலிச் சமண் குண்டர் முதலாயோர்","pichchach siRu pIlich samaN kuNDar mudhalAyOr"],[1103,"புலன் கொள் நிதிக் குவையோடு புழைக் கை மா களிற்று இனமும்","pulaṉ kŏl̤ nitik kuvaiyoṭu puzhaik kai mā kal̤iṟṟu iṉamum"],[1104,"பஞ்சிச் சிறு கூழை உருவாகி மருவாத","panjchich chiRu kUzhai uruvAgi maruvAdha"],[1105,"செழு நீர் மலர்க் கமலம் திரை உந்து வன்பகட்டால்","sezhu nIr malark kamalam thirai undhu vanpagaTTAl"],[1106,"பிணங்கள் இடு காடு அதனுள் நடம் ஆடு பிஞ்ஞகனோடு","piNanggaL iDu kADu adhanuL naDam ADu pinjnjaganODu"],[1107,"கடி கமழும் நெடுமறுகில் கடல்மல்லைத் தலசயனத்து","kaDi kamazhum neDumaRugil kaDalmallaith thalasayanaththu"],[1108,"திவளும் வெண்மதி போல் திருமுகத்து அரிவை","thivaLum veNmadhi pOl thirumugaththu arivai sezhungkaDal amudhinil piRandha"],[1109,"துளம் படு முறுவல் தோழியர்க்கு அருளாள்","thuLam paDu muRuval thOzhiyarkku aruLAL thuNaimulai sAndhu koNDu aNiyAL"],[1110,"சாந்தமும் பூணும் சந்தனக் குழம்பும்","sAndhamum pUNum sandhanak kuzhambum thaDamulaikku aNiyilum thazhalAm"],[1111,"ஊழியின் பெரிதால் நாழிகை என்னும் ஒண் சுடர் துயின்றதால் என்னும்","ūzhiyiṉ pĕritāl nāzhikai ĕṉṉum ŏṇ cuṭar tuyiṉṟatāl ĕṉṉum"],[1112,"ஓதிலும் உன் பேர் அன்றி மற்றோதாள்","Odhilum un pEr anRi maRROdhAL urugum nin thiruvuru ninaindhu"],[1113,"தன் குடிக்கு ஏதும் தக்கவா நினையாள்","than kuDikku Edhum thakkavA ninaiyAL thaDangkaDal nuDanggeyil ilanggai"],[1114,"உளம் கனிந்திருக்கும் உன்னையே பிதற்றும்","uLam kanindhirukkum unnaiyE pidhaRRum unakkanRi enakku anbu onRilaLAl"],[1115,"அலங்கெழு தடக்கை ஆயன் வாய் ஆம்பற்கு","alangkezhu thaDakkai Ayan vAy AmbaRku azhiyumAl en uLLam ennum"],[1116,"பொன் குலாம் பயலை பூத்தன மெந்தோள்","pon kulAm payalai pUththana menthOL porukayal kaNthuyil maRandhAL"],[1117,"அன்னமும் மீனும் ஆமையும் அரியும் ஆய","annamum mInum Amaiyum ariyum Aya em mAyanE! aruLAy"],[1118,"திரிபுரம் மூன்று எரித்தானும் மற்றை","thiripuram mUnRu eriththAnum maRRai malar misai mEl ayanum viyappa"],[1119,"வெந்திறல் வீரரில் வீரர் ஒப்பார்","venthiRal vIraril vIrar oppAr vEdham uraiththu imaiyOr vaNanggum"],[1120,"செம்பொன் இலங்கு வலங்கை வாளி","sempon ilanggu valangkai vALi thiNsilai thaNDoDu sanggam oLvAL"],[1121,"மஞ்சுயர் மாமணிக் குன்றம் ஏந்தி","manjchuyar mAmaNik kunRam Endhi mAmazhai kAththu oru mAya Anai"],[1122,"கலைகளும் வேதமும் நீதி நூலும்","kalaigaLum vEdhamum nIdhi nUlum kaRpamum soRporuL thAnum maRRai"],[1123,"எங்ஙனும் நாம் இவர் வண்ணம் எண்ணில்","engnganum nAm ivar vaNNam eNNil Edhum aRigilam EndhizhaiyAr"],[1124,"முழுசி வண்டாடிய தண்துழாயின்","muzhusi vaNDADiya thaNthuzhAyin moymmalark kaNNiyum mEni anjchAndhu"],[1125,"மேவி எப்பாலும் விண்ணோர் வணங்க","mEvi eppAlum viNNOr vaNangga vEdham uraippar munnIr maDandhai"],[1126,"தஞ்சம் இவர்க்கு என் வளையும் நில்லா","thanjcham ivarkku en vaLaiyum nillA nenjchamum thammadhE sindhiththERku"],[1127,"மன்னவன் தொண்டையர் கோன் வணங்கும்","mannavan thoNDaiyar kOn vaNanggum nILmuDi mAlai vayira mEgan"],[1128,"சொல்லு வன்சொற்பொருள் தான் அவையாய்ச்","sollu vansoRporuL thAn avaiyAych suvai URoli nARRamum thORRamumAy"],[1129,"கார் மன்னு நீள் விசும்பும் கடலும் சுடரும்","kAr mannu nIL visumbum kaDalum suDarum nilanum malaiyum than undhith"],[1130,"உரந்தரு மெல்லணைப் பள்ளி கொண்டான்","urantharu mellaNaip paLLi koNDAn oru kAl munnam mA uruvAyk kaDaluL"],[1131,"அண்டமும் எண்திசையும் நிலனும்","aNDamum eNthisaiyum nilanum alai nIroDu vAn eri kAl mudhalA"],[1132,"தூம்புடைத் திண்கை வன்தாள் களிற்றின் துயர்","thUmbuDaith thiNkai vanthAL kaLiRRin thuyar thIrththu aravam veruva muna nAL"],[1133,"திண்படைக் கோள் அரியின் உருவாய்த் திறலோன்","thiNpaDaik kOL ariyin uruvAyth thiRalOn agalam seruvil muna nAL"],[1134,"இலகிய நீள்முடி மாவலி தன் பெரு வேள்வியில்","ilagiya nILmuDi mAvali than peru vELviyil mAN uruvAy muna nAL"],[1135,"குடைத் திறல் மன்னவனாய் ஒரு கால்","kuDaith thiRal mannavanAy oru kAl kuranggaip paDaiyA malaiyAl kaDalai"],[1136,"பிறை உடை வாணுதல் பின்னை திறத்து","piRai uDai vANudhal pinnai thiRaththu munnE oru kAl seruvil urumin"],[1137,"பார் மன்னு தொல்புகழ்ப் பல்லவர் கோன் பணிந்த","pAr mannu tholpugazhp pallavar kOn paNindha paramEchchura viNNagar mEl"],[1138,"மஞ்சாடு வரை ஏழும் கடல்கள் ஏழும்","manjchADu varai Ezhum kaDalgaL Ezhum"],[1139,"கொந்தலர்ந்த நறுந்துழாய் சாந்தம் தூபம்","kondhalarndha naRunthuzhAy sAndham dhUpam"],[1140,"கொழுந்து அலரும் மலர்ச் சோலைக் குழாம்கொள் பொய்கைக்","kŏzhuntu alarum malarc colaik kuzhāmkŏl̤ pŏykaik"],[1141,"தாங்க அரும்போர் மாலி படப் பறவை ஊர்ந்து","thAngga arumpOr mAli paDap paRavai Urndhu"],[1142,"கறை வளர் வேல் கரன் முதலாக் கவந்தன் வாலி","kaRai vaLar vEl karan mudhalAk kavandhan vAli"],[1143,"உறி ஆர்ந்த நறுவெண்ணெய் ஒளியால் சென்று அங்கு","uRi Arndha naRuveNNey oLiyAl senRu anggu"],[1144,"இருங்கை மா கரி முனிந்து பரியைக் கீறி","irungkai mA kari munindhu pariyaik kIRi"],[1145,"பார் ஏறு பெரும் பாரம் தீரப் பண்டு","pAr ERu perum bAram thIrap paNDu"],[1146,"தூ வடிவின் பார்மகள் பூமங்கையோடு","thU vaDivin pArmagaL pUmanggaiyODu"],[1147,"வாரணம் கொள் இடர் கடிந்த மாலை நீல","vAraNam koL iDar kaDindha mAlai nIla"],[1148,"இருந்தண் மாநிலம் ஏனமதாய் வளை மருப்பினில் அகத்து ஒடுக்கி","irunthaN mAnilam EnamadhAy vaLai maruppinil agaththu oDukki"],[1149,"மின்னும் ஆழி அங்கை அவன் செய்யவள் உறை தரு திருமார்பன்","minnum Azhi angkai avan seyyavaL uRai tharu thirumArban"],[1150,"வையம் ஏழும் உண்டு ஆல் இலை வைகிய","vaiyam ezhum uṇṭu āl ilai vaikiya"],[1151,"மாறு கொண்டு உடன்று எதிர்ந்த வல்லவுணன் தன் மார்பகம் இரு பிளவா","mARu koNDu uDanRu edhirndha vallavuNan than mArbagam iru piLavA"],[1152,"ஆங்கு மாவலி வேள்வியில் இரந்து சென்று அகல் இடம் அளந்து ஆயர்","Anggu mAvali vELviyil irandhu senRu agal iDam aLandhu Ayar"],[1153,"கூன் உலாவிய மடந்தை தன் கொடுஞ்சொலின் திறத்து இளங்கொடியோடும்","kUn ulAviya maDandhai than koDunjcholin thiRaththu iLangkoDiyODum"],[1154,"மின்னின் நுண்ணிடை மடக்கொடி காரணம் விலங்கலின் மிசை இலங்கை","minnin nuNNiDai maDakkoDi kAraNam vilanggalin misai ilanggai"],[1155,"விரை கமழ்ந்த மென்கருங்குழல் காரணம் வில் இறுத்து அடல் மழைக்கு","virai kamazhndha menkarungkuzhal kAraNam vil iRuththu aDal mazhaikku"],[1156,"வேல் கொள் கைத்தலத்து அரசர் வெம்போரினில் விசயனுக்காய் மணித் தேர்","vEl koL kaiththalaththu arasar vempOrinil visayanukkAy maNith thEr"],[1157,"மூவராகிய ஒருவனை மூவுலகு உண்டு உமிழ்ந்து அளந்தானை","mUvarAgiya oruvanai mUvulagu uNDu umizhndhu aLandhAnai"],[1158,"ஊன் வாட உண்ணாது உயிர் காவல் இட்டு","Un vADa uNNAdhu uyir kAval iTTu"],[1159,"காயோடு நீடு கனி உண்டு வீசு","kAyODu nIDu kani uNDu vIsu"],[1160,"வெம்பும் சினத்துப் புனக் கேழல் ஒன்றாய்","vembum sinaththup punak kEzhal onRAy"],[1161,"அருமாநிலம் அன்று அளப்பான் குறளாய்","arumAnilam anRu aLappAn kuRaLAy"],[1162,"கோ மங்க வங்கக் கடல் வையம் உய்யக்","kO mangga vanggak kaDal vaiyam uyyak"],[1163,"நெய்வாய் அழல் அம்பு துரந்து முந்நீர்","neyvAy azhal ambu thurandhu munnIr"],[1164,"மௌவல் குழல் ஆய்ச்சி மென்தோள் நயந்து","mauval kuzhal Aychchi menthOL nayandhu"],[1165,"மா வாயின் அங்கம் மதியாது கீறி","mA vAyin anggam madhiyAdhu kIRi"],[1166,"செருநீல வேற்கண் மடவார் திறத்துச்","serunIla vERkaN maDavAr thiRaththuch"],[1167,"சீரார் பொழில் சூழ்ந்து அழகாய தில்லைத்","sIrAr pozhil sUzhndhu azhagAya thillaith"],[1168,"வாட மருதிடை போகி மல்லரைக் கொன்று ஒக்கலித்திட்டு","vADa marudhiDai pOgi mallaraik konRu okkaliththiTTu"],[1169,"பேய்மகள் கொங்கை நஞ்சுண்ட பிள்ளை பரிசு இது என்றால்","pEymagaL konggai nanjchuNDa piLLai parisu idhu enRAl"],[1170,"பண்டு இவன் வெண்ணெய் உண்டான் என்று ஆய்ச்சியர் கூடி இழிப்ப","paNDu ivan veNNey uNDAn enRu Aychchiyar kUDi izhippa"],[1171,"வளைக்கை நெடுங்கண் மடவார் ஆய்ச்சியர் அஞ்சி அழைப்ப","vaLaikkai neDungkaN maDavAr Aychchiyar anjchi azhaippa"],[1172,"பருவக் கருமுகில் ஒத்து முத்துடை மாகடல் ஒத்து","paruvak karumugil oththu muththuDai mAkaDal oththu"],[1173,"எய்யச் சிதைந்தது இலங்கை மலங்க வரு மழை காப்பான்","ĕyyac citaintatu ilaṅkai malaṅka varu mazhai kāppāṉ"],[1174,"ஆவர் இவை செய்தறிவார்? அஞ்சன மாமலை போலே","Avar ivai seydhaRivAr? anjchana mAmalai pOlE"],[1175,"பொங்கி அமரில் ஒரு கால் பொன் பெயரோனை வெருவ","ponggi amaril oru kAl pon peyarOnai veruva"],[1176,"கருமுகில் போல்வதோர் மேனி கையன ஆழியும் சங்கும்","karumugil pOlvadhOr mEni kaiyana Azhiyum sanggum"],[1177,"தேன் அமர் பூம் பொழில் தில்லைச் சித்திரகூடம் அமர்ந்த","teṉ amar pūm pŏzhil tillaic cittirakūṭam amarnta"],[1178,"ஒரு குறளாய் இருநிலம் மூவடி மண் வேண்டி","oru kuRaLAy irunilam mUvaDi maN vENDi"],[1179,"நான்முகன் நாள் மிகைத் தருக்கை இருக்கு வாய்மை நலம் மிகு சீர் உரோமசனால் நவிற்றி நக்கன்","nāṉmukaṉ nāl̤ mikait tarukkai irukku vāymai nalam miku cīr uromacaṉāl naviṟṟi nakkaṉ"],[1180,"வையணைந்த நுதிக் கோட்டு வராகம் ஒன்றாய்","vaiyaNaindha nudhik kOTTu varAgam onRAy"],[1181,"பஞ்சிய மெல்லடிப் பின்னை திறத்து முன்னாள்","panjchiya mellaDip pinnai thiRaththu munnAL"],[1182,"தெவ்வாய மற மன்னர் குருதி கொண்டு","thevvAya maRa mannar kurudhi koNDu"],[1183,"பைங்கண் விறல் செம்முகத்து வாலி மாளப்","paingkaN viRal semmugaththu vAli mALap"],[1184,"பொருவில் வலம்புரி அரக்கன் முடிகள் பத்தும்","poruvil valampuri arakkan muDigaL paththum"],[1185,"பட்டரவேர் அகல் அல்குல் பவளச் செவ்வாய்","paTTaravEr agal algul pavaLach chevvAy"],[1186,"பிறை தங்கு சடையானை வலத்தே வைத்துப்","piRai thanggu saDaiyAnai valaththE vaiththup"],[1187,"செங்கமலத்து அயன் அனைய மறையோர் காழிச்","sengkamalaththu ayan anaiya maRaiyOr kAzhich"],[1188,"வந்துனது அடியேன் மனம் புகுந்தாய் புகுந்ததற் பின் வணங்கும் என்","vandhunadhu aDiyEn manam pugundhAy pugundhadhaR pin vaNanggum en"],[1189,"நீலத் தட வரை மாமணி நிகழக் கிடந்தது போல் அரவணை","nIlath thaDa varai mAmaNi nigazhak kiDandhadhu pOl aravaNai"],[1190,"நென்னல் போய் வரும் என்றென்று எண்ணி இராமை என் மனத்தே புகுந்தது","nennal pOy varum enRenRu eNNi irAmai en manaththE pugundhadhu"],[1191,"மின்னின் மன்னும் நுடங்கு இடை மடவார் தம் சிந்தை மறந்து வந்து நின்","miṉṉiṉ maṉṉum nuṭaṅku iṭai maṭavār-tam cintai maṟantu vantu niṉ"],[1192,"நீடு பல் மலர் மாலை இட்டு நின் இணை அடி தொழுது ஏத்தும் என் மனம்","nīṭu pal malar mālai iṭṭu niṉ iṇai-aṭi tŏzhutu ettum ĕṉ maṉam"],[1193,"கந்த மாமலர் எட்டும் இட்டு நின் காமர் சேவடி கை தொழுதெழும்","gandha mAmalar eTTum iTTu nin kAmar sEvaDi kai thozhudhezhum"],[1194,"உலவு திரைக் கடல் பள்ளி கொண்டு வந்து உன் அடியேன் மனம் புகுந்த அப்","ulavu thiraik kaDal paLLi koNDu vandhu un aDiyEn manam pugundha ap"],[1195,"சங்கு தங்கு தடங்கடல் கடல் மல்லையுள் கிடந்தாய்! அருள் புரிந்து","sanggu thanggu thaDangkaDal kaDal mallaiyuL kiDandhAy! aruL purindhu"],[1196,"ஓதி ஆயிர நாமமும் பணிந்து ஏத்தி நின் அடைந்தேற்கு ஒரு பொருள்","Odhi Ayira nAmamum paNindhu Eththi nin aDaindhERku oru poruL"],[1197,"புல்லி வண்டறையும் பொழில் புடை சூழ் தென்னாலி இருந்த மாயனை","pulli vaNDaRaiyum pozhil puDai sUzh thennAli irundha mAyanai"],[1198,"தூ விரிய மலர் உழக்கித் துணையோடும் பிரியாதே","thU viriya malar uzhakkith thuNaiyODum piriyAdhE"],[1199,"பிணி அவிழு நறு நீல மலர் கிழியப் பெடையோடும்","piNi avizhu naRu nIla malar kizhiyap peDaiyODum"],[1200,"நீர் வானம் மண் எரி கால் ஆய் நின்ற நெடுமால் தன்","nīr vāṉam maṇ ĕri kāl āy niṉṟa nĕṭumāl taṉ"],[1201,"தான் ஆக நினையானேல் தன் நினைந்து நைவேற்கு ஓர்","thAn Aga ninaiyAnEl than ninaindhu naivERku Or"],[1202,"வாளாய கண் பனிப்ப மென்முலைகள் பொன் அரும்ப","vALAya kaN panippa menmulaigaL pon arumba"],[1203,"தாராய தண்துளவ வண்டுழுத வரை மார்பன்","thArAya thaNthuLava vaNDuzhudha varai mArban"],[1204,"கொண்டு அரவத் திரை உலவு குரை கடல்மேல் குலவரைபோல்","kŏṇṭu aravat tirai ulavu kurai kaṭalmel kulavaraipol"],[1205,"குயில் ஆலும் வளர் பொழில் சூழ் தண்குடந்தைக் குடமாடீ!","kuyil Alum vaLar pozhil sUzh thaNkuDandhaik kuDamADI!"],[1206,"நிலை ஆளா நின் வணங்க வேண்டாயே ஆகிலும் என்","nilai āl̤ā niṉ vaṇaṅka veṇṭāye ākilum ĕṉ"],[1207,"மையிலங்கு கருங்குவளை மருங்கலரும் வயலாலி","maiyilanggu karungkuvaLai marunggalarum vayalAli"],[1208,"கள்வன் கொல்? யான் அறியேன் கரியான் ஒரு காளை வந்து","kaLvan kol? yAn aRiyEn kariyAn oru kALai vandhu"],[1209,"பண்டிவன் ஆயன் நங்காய்! படிறன் புகுந்து என் மகள் தன்","paNDivan Ayan nanggAy! paDiRan pugundhu en magaL than"],[1210,"அஞ்சுவன் வெஞ்சொல் நங்காய்! அரக்கர் குலப் பாவை தன்னை","anjchuvan venjchol nanggAy! arakkar kulap pAvai thannai"],[1211,"ஏதவன் தொல் பிறப்பு? இளையவன் வளை ஊதி மன்னர்","Edhavan thol piRappu? iLaiyavan vaLai Udhi mannar"],[1212,"தாய் எனை என்று இரங்காள் தடந்தோளி தனக்கு அமைந்த","thAy enai enRu iranggAL thaDanthOLi thanakku amaindha"],[1213,"என் துணை என்று எடுத்தேற்கு இறையேனும் இரங்கிற்றிலள்","en thuNai enRu eDuththERku iRaiyEnum irangkiRRilaL"],[1214,"அன்னையும் அத்தனும் என்று அடியோமுக்கு இரங்கிற்றிலள்","annaiyum aththanum enRu aDiyOmukku irangkiRRilaL"],[1215,"முற்றிலும் பைங்கிளியும் பந்தும் ஊசலும் பேசுகின்ற","muRRilum paingkiLiyum pandhum Usalum pEsuginRa"],[1216,"காவி அங்கண்ணி எண்ணில் கடி மாமலர்ப் பாவை ஒப்பாள்","kAvi angkaNNi eNNil kaDi mAmalarp pAvai oppAL"],[1217,"தாய் மனம் நின்றிரங்கத் தனியே நெடுமால் துணையா","thAy manam ninRiranggath thaniyE neDumAl thuNaiyA"],[1218,"நந்தா விளக்கே அளத்தற்கு அரியாய்","nantā vil̤akke al̤attaṟku ariyāy"],[1219,"முதலைத் தனி மா முரண் தீர அன்று","mudhalaith thani mA muraN thIra anRu"],[1220,"கொலைப் புண் தலைக் குன்றம் ஒன்று உய்ய அன்று","kolaip puN thalaik kunRam onRu uyya anRu"],[1221,"சிறையார் உவணப் புள் ஒன்று ஏறி அன்று","siRaiyAr uvaNap puL onRu ERi anRu"],[1222,"இழை ஆடு கொங்கைத்தலை நஞ்சம் உண்டிட்டு","izhai ADu konggaiththalai nanjcham uNDiTTu"],[1223,"பண்ணேர் மொழி ஆய்ச்சியர் அஞ்ச வஞ்சப்","paNNEr mozhi Aychchiyar anjcha vanjchap"],[1224,"தளைக் கட்டு அவிழ் தாமரை வைகு பொய்கைத்","tal̤aik kaṭṭu avizh tāmarai vaiku pŏykait"],[1225,"துளையார் கருமென்குழல் ஆய்ச்சியர் தம்","thuLaiyAr karumenkuzhal Aychchiyar tham"],[1226,"விடை ஓட வென்று ஆய்ச்சி மென்தோள் நயந்த","viDai ODa venRu Aychchi menthOL nayandha"],[1227,"வண்டார் பொழில் சூழ்ந்து அழகாய நாங்கூர்","vaNDAr pozhil sUzhndhu azhagAya nAnggUr"],[1228,"சலங்கொண்ட இரணியனது அகல் மார்வம் கீண்டு","salangkoNDa iraNiyanadhu agal mArvam kINDu"],[1229,"திண்ணியதோர் அரி உருவாய்த் திசை அனைத்தும் நடுங்கத்","thiNNiyadhOr ari uruvAyth thisai anaiththum naDunggath"],[1230,"அண்டமும் இவ் அலை கடலும் அவனிகளும் எல்லாம்","aṇṭamum iv alai kaṭalum avaṉikal̤um ĕllām"],[1231,"கலை இலங்கும் அகலல்குல் அரக்கர் குலக் கொடியைக்","kalai ilanggum agalalgul arakkar kulak koDiyaik"],[1232,"மின் அனைய நுண்மருங்குல் மெல்லியற்கா இலங்கை","min anaiya nuNmarunggul melliyaRkA ilanggai"],[1233,"பெண்மை மிகு வடிவு கொடு வந்தவளை பெரிய","peNmai migu vaDivu koDu vandhavaLai periya"],[1234,"விளங்கனியை இளங்கன்று கொண்டு உதிர எறிந்து","viLangkaniyai iLangkanRu koNDu udhira eRindhu"],[1235,"ஆறாத சினத்தின் மிகு நரகன் உரம் அழித்த","ARAdha sinaththin migu naragan uram azhiththa"],[1236,"வங்க மலி தடங்கடலுள் வானவர்களோடு","vangga mali thaDangkaDaluL vAnavargaLODu"],[1237,"சங்கு மலி தண்டு முதல் சக்கரம் முன் ஏந்தும்","sanggu mali thaNDu mudhal chakkaram mun Endhum"],[1238,"திருமடந்தை மண்மடந்தை இருபாலும் திகழத்","thirumaDandhai maNmaDandhai irupAlum thigazhath"],[1239,"வென்றி மிகு நரகன் உரமது அழிய விசிறும்","venRi migu naragan uramadhu azhiya visiRum"],[1240,"உம்பரும் இவ்வேழ் உலகும் ஏழ் கடலும் எல்லாம்","umbarum ivvEzh ulagum Ezh kaDalum ellAm"],[1241,"ஓடாத ஆளரியின் உருவமது கொண்டு அன்று","ODAdha ALariyin uruvamadhu koNDu anRu"],[1242,"கண்டவர் தம் மனம் மகிழ மாவலி தன் வேள்விக்","kaNDavar tham manam magizha mAvali than vELvik"],[1243,"வாள் நெடுங்கண் மலர்க் கூந்தல் மைதிலிக்கா இலங்கை","vAL neDungkaN malark kUndhal maithilikkA ilanggai"],[1244,"தீ மனத்தான் கஞ்சனது வஞ்சனையில் திரியும்","thI manaththAn kanjchanadhu vanjchanaiyil thiriyum"],[1245,"கன்றதனால் விளவெறிந்து கனி உதிர்த்த காளை","kanRadhanAl viLaveRindhu kani udhirththa kALai"],[1246,"வஞ்சனையால் வந்தவள் தன் உயிர் உண்டு வாய்த்த","vanjchanaiyAl vandhavaL than uyir uNDu vAyththa"],[1247,"சென்று சின விடை ஏழும் பட அடர்த்துப் பின்னை","senRu sina viDai Ezhum paDa aDarththup pinnai"],[1248,"போதலர்ந்த பொழிற் சோலைப் புறம் எங்கும் பொரு திரைகள்","pOdhalarndha pozhiR sOlaip puRam enggum poru thiraigaL"],[1249,"யாவருமாய் யாவையுமாய் எழில் வேதப் பொருள்களுமாய்","yAvarumAy yAvaiyumAy ezhil vEdhap poruLgaLumAy"],[1250,"வானாடும் மண்ணாடும் மற்றுள்ள பல்லுயிரும்","vAnADum maNNADum maRRuLLa palluyirum"],[1251,"இந்திரனும் இமையவரும் முனிவர்களும் எழில் அமைந்த","indhiranum imaiyavarum munivargaLum ezhil amaindha"],[1252,"அண்டமும் இவ் அலை கடலும் அவனிகளும் குல வரையும்","aṇṭamum iv alai kaṭalum avaṉikal̤um kula varaiyum"],[1253,"ஞாலம் எல்லாம் அமுது செய்து நான்மறையும் தொடராத","njAlam ellAm amudhu seydhu nAnmaRaiyum thoDarAdha"],[1254,"ஓடாத ஆளரியின் உருவாகி இரணியனை","ODAdha ALariyin uruvAgi iraNiyanai"],[1255,"வாராரும் இளங்கொங்கை மைதிலியை மணம் புணர்வான்","vArArum iLangkonggai maithiliyai maNam puNarvAn"],[1256,"கும்ப மிகு மத யானை பாகனொடும் குலைந்து வீழ","kumba migu madha yAnai pAganoDum kulaindhu vIzha"],[1257,"காரார்ந்த திருமேனிக் கண்ணன் அமர்ந்து உறையும் இடம்","kArArndha thirumEnik kaNNan amarndhu uRaiyum iDam"],[1258,"கம்ப மாகடல் அடைத்து இலங்கைக்கு மன் கதிர் முடி அவை பத்தும்","kamba mAkaDal aDaiththu ilanggaikku man kathir muDi avai paththum"],[1259,"பல்லவம் திகழ் பூங்கடம்பு ஏறி அக்காளியன் பணவரங்கில்","pallavam thigazh pUngkaDambu ERi akkALiyan paNavaranggil"],[1260,"அண்டர் ஆனவர் வானவர் கோனுக்கு என்று அமைத்த சோறது எல்லாம்","aNDar Anavar vAnavar kOnukku enRu amaiththa sORadhu ellAm"],[1261,"பருங்கை யானையின் கொம்பினைப் பறித்து அதன் பாகனைச் சாடிப் புக்கு","paruṅkai yāṉaiyiṉ kŏmpiṉaip paṟittu ataṉ pākaṉaic cāṭip pukku"],[1262,"சாடு போய் விழத் தாள் நிமிர்த்து ஈசன் தன் படையொடும் கிளையோடும்","sADu pOy vizhath thAL nimirththu Isan than paDaiyoDum kiLaiyODum"],[1263,"அங்கையால் அடி மூன்று நீர் ஏற்று அயன் அலர் கொடு தொழுது ஏத்த","angkaiyAl aDi mUnRu nIr ERRu ayan alar koDu thozhudhu Eththa"],[1264,"உளைய ஒண்திறல் பொன்பெயரோன் தனது உரம் பிளந்து உதிரத்தை","uLaiya oNthiRal ponpeyarOn thanadhu uram piLandhu udhiraththai"],[1265,"வாளையார் தடங்கண் உமை பங்கன் வன் சாபம் மற்றது நீங்க","vALaiyAr thaDangkaN umai panggan van sAbam maRRadhu nIngga"],[1266,"இந்து வார் சடை ஈசனைப் பயந்த நான்முகனை தன் எழிலாரும்","indhu vAr saDai Isanaip payandha nAnmuganai than ezhilArum"],[1267,"மண்ணுள் ஆர் புகழ் வேதியர் நாங்கூர் வண்புருடோத்தமத்துள்","maNNuL Ar pugazh vEdhiyar nAnggUr vaNpuruDOththamaththuL"],[1268,"பேர் அணிந்து உலகத்தவர் தொழுது ஏத்தும்","pEr aNindhu ulagaththavar thozhudhu Eththum pEraruLALan empirAnai"],[1269,"பிறப்பொடு மூப்பு ஒன்று இல்லவன் தன்னைப்","piRappoDu mUppu onRu illavan thannaip pEdhiyA inba veLLaththai"],[1270,"திடவிசும்பு எரி நீர் திங்களும் சுடரும்","thiDavisumbu eri nIr thinggaLum suDarum sezhunilaththu uyirgaLum maRRum"],[1271,"வசை அறு குறளாய் மாவலி வேள்வி","vasai aRu kuRaLAy mAvali vELvi maN aLaviTTavan thannai"],[1272,"தீ மனத்து அரக்கர் திறல் அழித்தவனே! என்று","thI manaththu arakkar thiRal azhiththavanE! enRu senRu aDaindhavar thamakku"],[1273,"மல்லை மா முந்நீர் அதர்பட மலையால்","mallai mA munnIr adharpaDa malaiyAl aNai seydhu magizhndhavan thannai"],[1274,"வெஞ்சினக் களிறும் வில்லொடு மல்லும்","venjchinak kaLiRum villoDu mallum veguNDu iRuththu aDarththavan thannai"],[1275,"அன்றிய வாணன் ஆயிரம் தோளும் துணிய","anRiya vANan Ayiram thOLum thuNiya anRu Azhi thoTTAnai"],[1276,"களங்கனி வண்ணா! கண்ணணே!","kaLangkani vaNNA! kaNNaNE! endhan kArmugilE! ena ninaindhiTTu"],[1277,"தேன் அமர் சோலை நாங்கை நன்னடுவுள்","thEn amar sOlai nAnggai nannaDuvuL semponsey kOyilin uLLE"],[1278,"மாற்றரசர் மணிமுடியும் திறலும் தேசும்","mARRarasar maNimuDiyum thiRalum thEsum"],[1279,"பொற்றொடித் தோள் மடமகள் தன் வடிவு கொண்ட","poRRoDith thOL maDamagaL than vaDivu koNDa"],[1280,"படல் அடைத்த சிறு குரம்பை நுழைந்து புக்குப்","paṭal aṭaitta ciṟu kurampai nuzhaintu pukkup"],[1281,"வார் ஆரும் முலை மடவாள் பின்னைக்கு ஆகி","vār ārum mulai maṭavāl̤ piṉṉaikku āki"],[1282,"கலை இலங்கும் அகல் அல்குல் கமலப் பாவை","kalai ilanggum agal algul kamalap pAvai"],[1283,"தான்போலும் ஏன்று எழுந்தான் தரணியாளன்","tāṉpolum eṉṟu ĕzhuntāṉ taraṇiyāl̤aṉ"],[1284,"பொங்கு இலங்கு புரி நூலும் தோலும் தாழப்","pŏṅku ilaṅku puri nūlum tolum tāzhap"],[1285,"சிலம்பின் இடை சிறு பரல் போல் பெரிய மேரு","silambin iDai siRu paral pOl periya mEru"],[1286,"ஏழுலகும் தாழ் வரையும் எங்கும் மூடி","Ezhulagum thAzh varaiyum enggum mUDi"],[1287,"சீர் அணிந்த மணி மாடம் திகழும் நாங்கூர்த்","cīr aṇinta maṇi māṭam tikazhum nāṅkūrt"],[1288,"தூம்புடைப் பனைக் கை வேழம் துயர் கெடுத்து அருளி மன்னு","thUmbuDaip panaik kai vEzham thuyar keDuththu aruLi mannu"],[1289,"கவ்வை வாள் எயிற்று வன்பேய் கதிர் முலை சுவைத்து இலங்கை","kavvai vAL eyiRRu vanpEy kadhir mulai suvaiththu ilanggai"],[1290,"மாத் தொழில் மடங்கச் செற்று","māt tŏzhil maṭaṅkac cĕṟṟu"],[1291,"தாங்கு அரும் சினத்து வன் தாள்","tāṅku-arum ciṉattu vaṉ tāl̤"],[1292,"கரு மகள் இலங்கையாட்டி","karu makal̤ ilaṅkaiyāṭṭi"],[1293,"கெண்டையும் குறளும் புள்ளும் கேழலும் அரியும் மாவும்","keNDaiyum kuRaLum puLLum kEzhalum ariyum mAvum"],[1294,"குன்றமும் வானும் மண்ணும்","kuṉṟamum vāṉum maṇṇum"],[1295,"சங்கையும் துணிவும் பொய்யும் மெய்யும் இத்தரணி ஓம்பும்","sanggaiyum thuNivum poyyum meyyum iththaraNi Ombum"],[1296,"பாவமும் அறமும் வீடும் இன்பமும் துன்பம் தானும்","pAvamum aRamum vIDum inbamum thunbam thAnum"],[1297,"திங்கள் தோய் மாட நாங்கூர்த் திருமணிக்கூடத்தானை","thinggaL thOy mADa nAnggUrth thirumaNikkUDaththAnai"],[1298,"தா அளந்து உலகம் முற்றும்","tā al̤antu ulakam muṟṟum"],[1299,"மண்ணிடந்து ஏனம் ஆகி மாவலி வலி தொலைப்பான்","maNNiDandhu Enam Agi mAvali vali tholaippAn"],[1300,"உருத்தெழு வாலி மார்பில் ஓரு கணை உருவ ஓட்டி","uruththezhu vAli mArbil Oru kaNai uruva OTTi"],[1301,"முனை முகத்து அரக்கன் மாள முடிகள் பத்து அறுத்து வீழ்த்து ஆங்கு","munai mugaththu arakkan mALa muDigaL paththu aRuththu vIzhththu Anggu"],[1302,"பட அரவு உச்சி தன் மேல் பாய்ந்து பல் நடங்கள் செய்து","paDa aravu uchchi than mEl pAyndhu pal naDanggaL seydhu"],[1303,"மல்லரை அட்டு மாளக் கஞ்சனை மலைந்து கொன்று","mallarai aTTu mALak kanjchanai malaindhu konRu"],[1304,"மூத்தவற்கு அரசு வேண்டி","mūttavaṟku aracu veṇṭi"],[1305,"ஏவிளம் கன்னிக்காகி இமையவர் கோனைச் செற்று","EviLam kannikkAgi imaiyavar kOnaich seRRu"],[1306,"சந்தம் ஆய்ச் சமயம் ஆகிச்","cantam āyc camayam ākic"],[1307,"மா வளம் பெருகி மன்னும்","mā val̤am pĕruki maṉṉum"],[1308,"கண்ணார் கடல் போல் திருமேனி கரியாய்!","kaNNAr kaDal pOl thirumEni kariyAy!"],[1309,"கொந்தார் துளவ மலர் கொண்டு அணிவானே!","kondhAr thuLava malar koNDu aNivAnE!"],[1310,"குன்றால் குளிர் மாரி தடுத்து உகந்தானே!","kunRAl kuLir mAri thaDuththu ugandhAnE!"],[1311,"கானார் கரி கொம்பது ஒசித்த களிறே!","kAnAr kari kombadhu osiththa kaLiRE!"],[1312,"வேடார் திருவேங்கடம் மேய விளக்கே!","vEDAr thiruvEngkaDam mEya viLakkE!"],[1313,"கல்லால் கடலை அணை கட்டி உகந்தாய்!","kallAl kaDalai aNai kaTTi ugandhAy!"],[1314,"கோலால் நிரை மேய்த்த எங்கோவலர் கோவே!","kOlAl nirai mEyththa engkOvalar kOvE!"],[1315,"வாராகம் அது ஆகி இம் மண்ணை இடந்தாய்","vārākam-atu āki im maṇṇai iṭantāy"],[1316,"பூவார் திருமாமகள் புல்கிய மார்பா!","pUvAr thirumAmagaL pulgiya mArbA!"],[1317,"நல் அன்புடை வேதியர் மன்னிய நாங்கூர்","nal anbuDai vEdhiyar manniya nAnggUr"],[1318,"கவள யானைக் கொம்பு ஒசித்த கண்ணன் என்றும் காமரு சீர்","kavaLa yAnaik kombu osiththa kaNNan enRum kAmaru sIr"],[1319,"கஞ்சன் விட்ட வெஞ்சினத்த களிறு அடர்த்த காளை என்றும்","kanjchan viTTa venjchinaththa kaLiRu aDarththa kALai enRum"],[1320,"அண்டர் கோன் என் ஆனை என்றும்","aṇṭar-koṉ ĕṉ āṉai ĕṉṟum"],[1321,"கொல்லை ஆனாள் பரிசழிந்தாள் கோல் வளையார் தம் முகப்பே","kollai AnAL parisazhindhAL kOl vaLaiyAr tham mugappE"],[1322,"அரக்கர் ஆவி மாள அன்று","arakkar āvi māl̤a aṉṟu"],[1323,"ஞாலம் முற்றும் உண்டு உமிழ்ந்த","ñālam muṟṟum uṇṭu umizhnta"],[1324,"நாடி என்தன் உள்ளம் கொண்ட நாதன் என்றும் நான்மறைகள்","nADi endhan uLLam koNDa nAdhan enRum nAnmaRaigaL"],[1325,"உலகம் ஏத்தும் ஒருவன் என்றும் ஒண்சுடரோடு உம்பர் எய்தா","ulagam Eththum oruvan enRum oNsuDarODu umbar eydhA"],[1326,"கண்ணன் என்றும் வானவர்கள் காதலித்து மலர்கள் தூவும்","kaNNan enRum vAnavargaL kAdhaliththu malargaL thUvum"],[1327,"பாருள் நல்ல மறையோர் நாங்கைப் பார்த்தன்பள்ளிச் செங்கண் மாலை","pAruL nalla maRaiyOr nAnggaip pArththanpaLLich sengkaN mAlai"],[1328,"நும்மைத் தொழுதோம் நுந்தம் பணி செய்திருக்கும் நும் அடியோம்","nummaith thozhudhOm nundham paNi seydhirukkum num aDiyOm"],[1329,"சிந்தை தன்னுள் நீங்காது இருந்த திருவே! மருவினிய","sindhai thannuL nInggAdhu irundha thiruvE! maruviniya"],[1330,"பேசுகின்றது இதுவே வையம் ஈரடியால் அளந்த","pEsuginRadhu idhuvE vaiyam IraDiyAl aLandha"],[1331,"ஆசை வழுவாது ஏத்தும் எமக்கு இங்கு இழுக்காய்த்து அடியோர்க்கு","ācai vazhuvātu ettum ĕmakku iṅku izhukkāyttu aṭiyorkku"],[1332,"தீ எம்பெருமான் நீர் எம்பெருமான் திசையும் இரு நிலனு","thI emperumAn nIr emperumAn thisaiyum iru nilanu"],[1333,"சொல்லாது ஒழியகில்லேன் அறிந்த சொல்லில் நும் அடியார்","cŏllātu ŏzhiyakilleṉ aṟinta cŏllil num aṭiyār"],[1334,"மாட்டீர் ஆனீர் பணி நீர் கொள்ள எம்மைப் பணி அறியா","mATTIr AnIr paNi nIr koLLa emmaip paNi aRiyA"],[1335,"முன்னை வண்ணம் பாலின் வண்ணம் முழுதும் நிலை நின்ற","munnai vaNNam pAlin vaNNam muzhudhum nilai ninRa"],[1336,"எந்தை தந்தை தம்மான் என்றென்று எமர் ஏழ் அளவும்","endhai thandhai thammAn enRenRu emar Ezh aLavum"],[1337,"ஏரார் பொழில் சூழ் இந்தளூரில் எந்தை பெருமானை","ErAr pozhil sUzh indhaLUril endhai perumAnai"],[1338,"ஆய்ச்சியர் அழைப்ப வெண்ணெய் உண்டு ஒருகால்","āycciyar azhaippa vĕṇṇĕy uṇṭu ŏrukāl"],[1339,"ஆநிரை மேய்த்து அன்று அலைகடல் அடைத்திட்டு","Anirai mEyththu anRu alaikaDal aDaiththiTTu"],[1340,"கடு விடம் உடைய காளியன் தடத்தைக்","kaDu viDam uDaiya kALiyan thaDaththaik"],[1341,"கறவை முன் காத்துக் கஞ்சனைக் காய்ந்த","kaRavai mun kAththuk kanjchanaik kAyndha"],[1342,"பாரினை உண்டு பாரினை உமிழ்ந்து","pArinai uNDu pArinai umizhndhu"],[1343,"காற்றிடைப் பூளை கரந்தன அரந்தை","kARRiDaip pULai karandhana arandhai"],[1344,"ஓள்ளிய கருமம் செய்வன் என்று உணர்ந்த","OLLiya karumam seyvan enRu uNarndha"],[1345,"முடி உடை அமரர்க்கு இடர் செய்யும்","muDi uDai amararkku iDar seyyum"],[1346,"குடி குடி ஆகக் கூடி நின்று அமரர்","kuṭi kuṭi ākak kūṭi niṉṟu amarar"],[1347,"பண்டு முன் ஏனமாகி அன்று ஒருகால்","paNDu mun EnamAgi anRu orukAl"],[1348,"அறிவது அரியான் அனைத்துலகும் உடையான் என்னை ஆளுடையான்","aRivadhu ariyAn anaiththulagum uDaiyAn ennai ALuDaiyAn"],[1349,"கள்ளக் குறளாய் மாவலியை வஞ்சித்து உலகம் கைப்படுத்து","kaLLak kuRaLAy mAvaliyai vanjchiththu ulagam kaippaDuththu"],[1350,"மேவா அரக்கர் தென்னிலங்கை வேந்தன் வீயச் சரம் துரந்து","mEvA arakkar thennilanggai vEndhan vIyach saram thurandhu"],[1351,"வெற்பால் மாரி பழுதாக்கி விறல் வாள் அரக்கர் தலைவன் தன்","veRpAl mAri pazhudhAkki viRal vAL arakkar thalaivan than"],[1352,"மையார் தடங்கண் கருங்கூந்தல் ஆய்ச்சி மறைய வைத்த தயிர்","maiyAr thaDanggaN karungkUndhal Aychchi maRaiya vaiththa thayir"],[1353,"மின்னின் அன்ன நுண்மருங்குல் வேயேய் தடந்தோள் மெல்லியற்கா","minnin anna nuNmarunggul vEyEy thaDanthOL melliyaRkA"],[1354,"குடையா விலங்கல் கொண்டு ஏந்தி மாரி பழுது ஆநிரை காத்து","kuDaiyA vilanggal koNDu Endhi mAri pazhudhu Anirai kAththu"],[1355,"கறையார் நெடுவேல் மறமன்னர் வீய விசயன் தேர் கடவி","kaRaiyAr neDuvEl maRamannar vIya visayan thEr kaDavi"],[1356,"துன்னி மண்ணும் விண்ணாடும் தோன்றாது இருளாய் மூடிய நாள்","thunni maNNum viNNADum thOnRAdhu iruLAy mUDiya nAL"],[1357,"கற்றா மறித்து காளியன் தன் சென்னி நடுங்க நடம் பயின்ற","kaRRA maRiththu kALiyan than senni naDungga naDam payinRa"],[1358,"தாம் தம் பெருமை அறியார் தூது","thAm tham perumai aRiyAr thUdhu"],[1359,"செறுந்திண் திமில் ஏறுடைய பின்னை","seRunthiN thimil ERuDaiya pinnai"],[1360,"பிள்ளை உருவாய்த் தயிர் உண்டு அடியேன்","piLLai uruvAyth thayir uNDu aDiyEn"],[1361,"கூற்றேர் உருவின் குறளாய் நிலம் நீர்","kURREr uruvin kuRaLAy nilam nIr"],[1362,"தொண்டர் பரவச் சுடர் சென்று அணவ","thoNDar paravach suDar senRu aNava"],[1363,"தக்கன் வேள்வி தகர்த்த தலைவன்","thakkan vELvi thagarththa thalaivan"],[1364,"கருந்தண் கடலும் மலையும் உலகும்","karunthaN kaDalum malaiyum ulagum"],[1365,"கலை வாழ் பிணையோடு அணையும் திருநீர்","kalai vAzh piNaiyODu aNaiyum thirunIr"],[1366,"பெருகு காதல் அடியேன் உள்ளம்","perugu kAdhal aDiyEn uLLam"],[1367,"காவிப் பெருநீர் வண்ணன் கண்ணன்","kAvip perunIr vaNNan kaNNan"],[1368,"வென்றி மாமழு ஏந்தி முன் மண்","venRi mAmazhu Endhi mun maN misai mannarai mUvezhukAl"],[1369,"வசை இல் நான்மறை கெடுத்த அம்மலர்","vasai il nAnmaRai keDuththa ammalar ayaRku aruLi mun parimugamAy"],[1370,"வெய்யனாய் உலகு ஏழுடன் நலிந்தவன்","veyyanAy ulagu EzhuDan nalindhavan uDalagam iru piLavA"],[1371,"வாம் பரி உக மன்னர் தம் உயிர் செக","vAm pari uga mannar tham uyir sega aivargaTku arasu aLiththa"],[1372,"மானவேல் ஒண்கண் மடவரல் மண்மகள்","mAnavEl oNkaN maDavaral maNmagaL azhungga munnIrp parappil"],[1373,"பொங்கு நீள்முடி அமரர்கள் தொழுது எழ","ponggu nILmuDi amarargaL thozhudhu ezha amudhinaik koDuththu aLippAn"],[1374,"ஆறினோடு ஒரு நான்குடை நெடுமுடி","ARinODu oru nAnkuDai neDumuDi arakkan than siram ellAm"],[1375,"முன் இவ் ஏழ் உலகு உணர்வு இன்றி இருள் மிக","muṉ iv ezh ulaku uṇarvu iṉṟi irul̤ mika"],[1376,"ஆங்கு மாவலி வேள்வியில் இரந்து சென்று","Anggu mAvali vELviyil irandhu senRu agaliDam muzhudhinaiyum"],[1377,"மஞ்சுலா மணிமாடங்கள் சூழ்","manjchulA maNimADanggaL sUzh thiruveLLaRai adhan mEya"],[1378,"உந்தி மேல் நான்முகனைப் படைத்தான் உலகு உண்டவன்","undhi mEl nAnmuganaip paDaiththAn ulagu uNDavan"],[1379,"வையம் உண்டு ஆல் இலை மேவும் மாயன் மணி நீள் முடி","vaiyam uṇṭu āl ilai mevum māyaṉ maṇi nīl̤ muṭi"],[1380,"பண்டு இவ்வையம் அளப்பான் சென்று மாவலி கையில் நீர்","paNDu ivvaiyam aLappAn senRu mAvali kaiyil nIr"],[1381,"விளைத்த வெம்போர் விறல் வாள் அரக்கன் நகர் பாழ் பட","viLaiththa vempOr viRal vAL arakkan nagar pAzh paDa"],[1382,"வம்புலாம் கூந்தல் மண்டோதரி காதலன் வான் புக","vambulAm kUndhal maNDOdhari kAdhalan vAn puga"],[1383,"கலை உடுத்த அகல் அல்குல் வன்பேய் மகள் தாய் என","kalai uDuththa agal algul vanpEy magaL thAy ena"],[1384,"கஞ்சன் நெஞ்சும் கடு மல்லரும் சகடமும் காலினால்","kanjchan nenjchum kaDu mallarum sagaDamum kAlinAl"],[1385,"ஏனம் மீன் ஆமையோடு அரியும் சிறு குறளுமாய்","Enam mIn AmaiyODu ariyum siRu kuRaLumAy"],[1386,"சேயன் என்றும் மிகப் பெரியன் நுண் நேர்மையினாய இம்","sEyan enRum migap periyan nuN nErmaiyinAya im"],[1387,"அல்லி மாதர் அமரும் திருமார்வன் அரங்கத்தை","alli mAdhar amarum thirumArvan aranggaththai"],[1388,"வெருவாதாள் வாய் வெருவி","veruvAdhAL vAy veruvi vEngkaDamE! vEngkaDamE! enginRALAl"],[1389,"கலை ஆளா அகல் அல்குல் கனவளையும்","kalai ALA agal algul kanavaLaiyum kai ALA en seygEn nAn?"],[1390,"மானாய மென்னோக்கி வாள் நெடுங்கண்","mAnAya mennOkki vAL neDungkaN nIr malgum vaLaiyum sOrum"],[1391,"தாய் வாயில் சொற்கேளாள் தன் ஆயத்தோடு","thAy vAyil soRkELAL than AyaththODu aNaiyAL thaDamen konggai"],[1392,"பூண்முலை மேல் சாந்தணியாள் பொருகயல்","pUNmulai mEl sAndhaNiyAL porukayal kaN mai ezhudhAL pUvai pENAL"],[1393,"தாதாடு வன மாலை தாரானோ?","thAdhADu vana mAlai thArAnO? enRenRE thaLarndhAL kANmin"],[1394,"வாராளும் இளங்கொங்கை வண்ணம்","vArALum iLangkonggai vaNNam vERu AyinavARu eNNAL eNNil"],[1395,"உறவாதும் இலள் என்று ஒழியாது","uRavAdhum ilaL enRu ozhiyAdhu palar Esum alar AyiRRAl"],[1396,"பந்தோடு கழல் மருவாள் பைங்கிளியும்","pandhODu kazhal maruvAL paingkiLiyum pAl UTTAL pAvai pENAL"],[1397,"சேல் உகளும் வயல் புடை சூழ் திருவரங்கத்து","sEl ugaLum vayal puDai sUzh thiruvaranggaththu ammAnaich sindhai seydha"],[1398,"கைம்மான மழகளிற்றைக் கடல் கிடந்த கருமணியை","kaimmAna mazhakaLiRRaik kaDal kiDandha karumaNiyai"],[1399,"பேரானைக் குறுங்குடி எம்பெருமானை திருத்தண்கால்","pErAnaik kuRungkuDi emperumAnai thiruththaNkAl"],[1400,"ஏனாகி உலகு இடந்து அன்று இருநிலனும் பெரு விசும்பும்","EnAgi ulagu iDandhu anRu irunilanum peru visumbum"],[1401,"வளர்ந்தவனைத் தடங் கடலுள் வலி உருவில் திரி சகடம்","val̤arntavaṉait taṭaṅ kaṭalul̤ vali uruvil tiri cakaṭam"],[1402,"நீர் அழலாய் நெடு நிலனாய் நின்றானை அன்று அரக்கன்","nIr azhalAy neDu nilanAy ninRAnai anRu arakkan"],[1403,"தம் சினத்தைத் தவிர்த்து அடைந்தார் தவ நெறியை தரியாது","tam ciṉattait tavirttu aṭaintār tava nĕṟiyai tariyātu"],[1404,"சிந்தனையைத் தவ நெறியைத் திருமாலை பிரியாது","sindhanaiyaith thava neRiyaith thirumAlai piriyAdhu"],[1405,"துவரித்த உடையவர்க்கும் தூய்மை இல்லாச் சமணர்க்கும்","thuvariththa uDaiyavarkkum thUymai illAch samaNarkkum"],[1406,"பொய் வண்ணம் மனத்து அகற்றிப் புலன் ஐந்தும் செல வைத்து","pŏy vaṇṇam maṉattu akaṟṟip pulaṉ aintum cĕla vaittu"],[1407,"ஆ மருவி நிரை மேய்த்த அணி அரங்கத்து அம்மானை","A maruvi nirai mEyththa aNi aranggaththu ammAnai"],[1408,"பண்டை நான்மறையும் வேள்வியும் கேள்விப்","paNDai nAnmaRaiyum vELviyum kELvip"],[1409,"இந்திரன் பிரமன் ஈசன் என்று இவர்கள்","indhiran piraman Isan enRu ivargaL"],[1410,"மன்னு மாநிலனும் மலைகளும் கடலும்","mannu mAnilanum malaigaLum kaDalum"],[1411,"மா இரும் குன்றம் ஒன்று மத்தாக","mA irum kunRam onRu maththAga"],[1412,"எங்ஙனே உய்வர்? தானவர் நினைந்தால்","engnganE uyvar? dhAnavar ninaindhAl"],[1413,"ஆயிரம் குன்றம் சென்று தொக்கனைய","Ayiram kunRam senRu thokkanaiya"],[1414,"சுரி குழல் கனி வாய்த் திருவினைப் பிரித்த","suri kuzhal kani vAyth thiruvinaip piriththa"],[1415,"ஊழியாய் ஓமத்து உச்சியாய் ஒருகால்","UzhiyAy Omaththu uchchiyAy orukAl"],[1416,"பேயின் ஆர்முலை ஊண் பிள்ளையாய் ஒருகால்","pEyin Armulai UN piLLaiyAy orukAl"],[1417,"பொன்னும் மாமணியும் முத்தமும் சுமந்து","ponnum mAmaNiyum muththamum sumandhu"],[1418,"ஏழை ஏதலன் கீழ் மகன் என்னாது","Ezhai Edhalan kIzh magan ennAdhu"],[1419,"வாத மா மகன் மர்க்கடம் விலங்கு","vāta mā makaṉ markkaṭam vilaṅku"],[1420,"கடிகொள் பூம்பொழில் காமரு பொய்கை","kaDikoL pUmpozhil kAmaru poygai"],[1421,"நஞ்சு சோர்வதோர் வெஞ்சின அரவம்","nanjchu sOrvadhOr venjchina aravam"],[1422,"மாக மாநிலம் முழுவதும் வந்து இறைஞ்சும்","mAga mAnilam muzhuvadhum vandhu iRainjchum"],[1423,"மன்னு நான்மறை மாமுனி பெற்ற","mannu nAnmaRai mAmuni peRRa"],[1424,"ஓது வாய்மையும் உவனியப் பிறப்பும்","Odhu vAymaiyum uvaniyap piRappum"],[1425,"வேத வாய்மொழி அந்தணன் ஒருவன்","vEdha vAymozhi andhaNan oruvan"],[1426,"துளங்கு நீண்முடி அரசர் தம் குரிசில்","thuLanggu nINmuDi arasar tham kurisil"],[1427,"மாடமாளிகை சூழ் திருமங்கை","mADamALigai sUzh thirumanggai"],[1428,"கை இலங்கு ஆழி சங்கன் கருமுகில் திருநிறத்தன்","kai ilanggu Azhi sanggan karumugil thiruniRaththan"],[1429,"வங்கம் ஆர் கடல்கள் ஏழும் மலையும் வானகமும் மற்றும்","vanggam Ar kaDalgaL Ezhum malaiyum vAnagamum maRRum"],[1430,"ஒருவனை உந்திப் பூ மேல் ஓங்குவித்து ஆகம் தன்னால்","oruvanai undhip pU mEl Ongguviththu Agam thannAl"],[1431,"ஊன் அமர் தலை ஒன்று ஏந்தி உலகெலாம் திரியும் ஈசன்","Un amar thalai onRu Endhi ulagelAm thiriyum Isan"],[1432,"வக்கரன் வாய் முன் கீண்ட மாயனே! என்று வானோர்","vakkaran vAy mun kINDa mAyanE! enRu vAnOr"],[1433,"விலங்கலால் கடல் அடைத்து விளங்கிழை பொருட்டு வில்லால்","vilanggalAl kaDal aDaiththu viLanggizhai poruTTu villAl"],[1434,"வெண்ணெய் தான் அமுது செய்ய வெகுண்டு மத்தாய்ச்சி ஓச்சி","veNNey thAn amudhu seyya veguNDu maththAychchi Ochchi"],[1435,"அம்பொனார் உலகம் ஏழும் அறிய ஆய்ப்பாடி தன்னுள்","amponAr ulagam Ezhum aRiya AyppADi thannuL"],[1436,"நால் வகை வேதம் ஐந்து வேள்வி ஆறங்கம் வல்லார்","nAl vagai vEdham aindhu vELvi ARanggam vallAr"],[1437,"வண்டறை பொழில் திருப்பேர் வரி அரவணையில் பள்ளி","vaNDaRai pozhil thiruppEr vari aravaNaiyil paLLi"],[1438,"தீதறு நிலத்தொடு எரி காலினொடு","thIdhaRu nilaththoDu eri kAlinoDu nIrkezhu visumbum avaiyAy"],[1439,"உய்யும் வகை உண்டு சொன செய்யில்","uyyum vagai uNDu sona seyyil ulagEzhum ozhiyAmai muna nAL"],[1440,"உம்பர் உலகேழு கடல் ஏழு மலை ஏழும்","umbar ulagEzhu kaDal Ezhu malai Ezhum ozhiyAmai muna nAL"],[1441,"பிறையின் ஒளி எயிறு இலக முறுகி எதிர் பொருதும் என","piṟaiyiṉ ŏl̤i ĕyiṟu ilaka muṟuki ĕtir pŏrutum ĕṉa"],[1442,"மூள எரி சிந்தி முனிவெய்தி அமர் செய்தும்","mULa eri sindhi muniveydhi amar seydhum ena vandha asurar"],[1443,"தம்பியொடு தாம் ஒருவர் தன் துணைவி","thambiyoDu thAm oruvar than thuNaivi kAdhal thuNaiyAga muna nAL"],[1444,"தந்தை மனம் உந்து துயர் நந்த இருள்","thandhai manam undhu thuyar nandha iruL vandha viRal nandhan madhalai"],[1445,"எண்ணில் நினைவு எய்தி இனி இல்லை இறை","eNNil ninaivu eydhi ini illai iRai enRu muniyALar thiru Ar"],[1446,"வங்க மலி பௌவம் அது மா முகடின்","vangga mali pauvam adhu mA mugaDin uchchi puga mikka perunIr"],[1447,"நறை செய் பொழில் மழை தவழும்","naRai sey pozhil mazhai thavazhum nandhipura viNNagaram naNNi uRaiyum"],[1448,"வண்டுணு நறுமலர் இண்டை கொண்டு பண்டை","vaNDuNu naRumalar iNDai koNDu paNDai nam vinai keDa enRu aDi mEl"],[1449,"அண்ணல் செய்து அலை கடல் கடைந்து அதனுள்","aNNal seydhu alai kaDal kaDaindhu adhanuL kaN nudhal nanjchuNNak kaNDavanE!"],[1450,"குழல் நிற வண்ண! நின் கூறு கொண்ட","kuzhal niRa vaNNa! nin kURu koNDa thazhal niRa vaNNan naNNAr nagaram"],[1451,"நிலவொடு வெயில் நிலவு இரு சுடரும்","nilavŏṭu vĕyil nilavu iru cuṭarum"],[1452,"பார் எழு கடல் எழு மலை எழுமாய்ச்","pAr ezhu kaDal ezhu malai ezhumAych sIr kezhum ivvulagu Ezhum ellAm"],[1453,"கார் கெழு கடல்களும் மலைகளுமாய்","kAr kezhu kaDalgaLum malaigaLumAy Er kezhum ulagamum Agi mudha"],[1454,"உருக்குறு நறுநெய் கொண்டார் அழலில்","urukkuRu naRuney koNDAr azhalil irukkuRum andhaNar sandhiyin vAy"],[1455,"காதல் செய்து இளையவர் கலவி தரும்","kAdhal seydhu iLaiyavar kalavi tharum vEdhanai vinai adhu veruvudhalAm"],[1456,"சாதலும் பிறத்தலும் என்று இவற்றைக் காதல்","sAdhalum piRaththalum enRu ivaRRaik kAdhal seyyAdhu una kazhal aDaindhEn"],[1457,"பூ மரு பொழில் அணி விண்ணகர் மேல்","pU maru pozhil aNi viNNagar mEl"],[1458,"பொறுத்தேன் புன் சொல் நெஞ்சில் பொருள் இன்பம் என இரண்டும்","poRuththEn pun sol nenjchil poruL inbam ena iraNDum"],[1459,"மறந்தேன் உன்னை முன்னம் மறந்த மதியின் மனத்தால்","maRandhEn unnai munnam maRandha madhiyin manaththAl"],[1460,"மான் ஏய் நோக்கியர் தம் வயிற்றுக் குழியில் உழைக்கும்","māṉ ey nokkiyar-tam vayiṟṟuk kuzhiyil uzhaikkum"],[1461,"பிறிந்தேன் பெற்ற மக்கள் பெண்டிர் என்றிவர் பின் உதவாது","piRindhEn peRRa makkaL peNDir enRivar pin udhavAdhu"],[1462,"பாண் தேன் வண்டறையும் குழலார்கள் பல்லாண்டு இசைப்ப","pAN thEn vaNDaRaiyum kuzhalArgaL pallANDu isaippa"],[1463,"கல்லா ஐம்புலன்கள் அவை கண்டவாறு செய்ய கில்லேன்","kallA aimpulangaL avai kaNDavARu seyya killEn"],[1464,"வேறா யான் இரந்தேன் வெகுளாது மனக்கொள் எந்தாய்!","vERA yAn irandhEn veguLAdhu manakkoL endhAy!"],[1465,"தீ வாய் வல்வினையார் உடன் நின்று சிறந்தவர் போல்","thI vAy valvinaiyAr uDan ninRu siRandhavar pOl"],[1466,"போதார் தாமரையாள் புலவிக் குல வானவர் தம்","pOdhAr thAmaraiyAL pulavik kula vAnavar tham"],[1467,"தேன் ஆர் பூம் புறவில் திருவிண்ணகர் மேயவனை","thEn Ar pUm puRavil thiruviNNagar mEyavanai"],[1468,"துறப்பேன் அல்லேன் இன்பம் துறவாது நின் உருவம்","thuRappEn allEn inbam thuRavAdhu nin uruvam"],[1469,"துறந்தேன் ஆர்வச் செற்றச் சுற்றம் துறந்தமையால்","thuRandhEn Arvach cheRRach chuRRam thuRandhamaiyAl"],[1470,"மானேய் நோக்கு நல்லார் மதி போல் முகத்து உலவும்","mAnEy nOkku nallAr madhi pOl mugaththu ulavum"],[1471,"சாந்தேந்து மென்முலையார் தடந்தோள் புணர் இன்ப வெள்ளத்து","sAndhEndhu menmulaiyAr thaDanthOL puNar inba veLLaththu"],[1472,"மற்றோர் தெய்வம் எண்ணேன் உன்னை என் மனத்து வைத்துப்","maRROr dheyvam eNNEn unnai en manaththu vaiththup"],[1473,"மை ஒண்கருங்கடலும் நிலனும் மணி வரையும்","mai oNkarungkaDalum nilanum maNi varaiyum"],[1474,"வேறே கூறுவது உண்டு அடியேன் விரித்து உரைக்கும்","vERE kURuvadhu uNDu aDiyEn viriththu uraikkum"],[1475,"முளிந்து ஈந்த வெங்கடத்து மூரிப் பெரும் களிற்றால்","muLindhu Indha vengkaDaththu mUrip perum kaLiRRAl"],[1476,"சொல்லாய் திருமார்வா! உனக்காகித் தொண்டு பட்ட","sollAy thirumArvA! unakkAgith thoNDu paTTa"],[1477,"தாரார் மலர்க் கமலத் தடம் சூழ்ந்த தண் புறவில்","thArAr malark kamalath thaDam sUzhndha thaN puRavil"],[1478,"கண்ணும் சுழன்று பீளையோடு ஈளை வந்து ஏங்கினால்","kaNNum suzhanRu pILaiyODu ILai vandhu EngginAl"],[1479,"கொங்குண் குழலார் கூடி இருந்து சிரித்து நீர்","kongguN kuzhalAr kUDi irundhu siriththu nIr"],[1480,"கொங்கார் குழலார் கூடி இருந்து சிரித்து எம்மை","konggAr kuzhalAr kUDi irundhu siriththu emmai"],[1481,"கொம்பும் அரவமும் வல்லியும் வென்ற நுண் ஏர் இடை","kŏmpum aravamum valliyum vĕṉṟa nuṇ er iṭai"],[1482,"விலங்கும் கயலும் வேலும் ஒண் காவியும் வென்ற கண்","vilanggum kayalum vElum oN kAviyum venRa kaN"],[1483,"மின்னேர் இடையார் வேட்கையை மாற்றி இருந்து","minnEr iDaiyAr vETkaiyai mARRi irundhu"],[1484,"வில் ஏர் நுதலார் வேட்கையை மாற்றிச் சிரித்து இவன்","vil er nutalār veṭkaiyai māṟṟic cirittu ivaṉ"],[1485,"வாள் ஒண்கண் நல்லார் தாங்கள் மதனன் என்றார் தம்மை","vAL oNkaN nallAr thAnggaL madhanan enRAr thammai"],[1486,"கனி சேர்ந்து இலங்கு நல் வாயவர் காதன்மை விட்டிட","kani sErndhu ilanggu nal vAyavar kAdhanmai viTTiDa"],[1487,"பிறை சேர் நுதலார் பேணுதல் நம்மை இலாத முன்","piRai sEr nudhalAr pENudhal nammai ilAdha mun"],[1488,"கலங்க முந்நீர் கடைந்து அமுதம் கொண்டு இமையோர்","kalangga munnIr kaDaindhu amudham koNDu imaiyOr"],[1489,"முனை ஆர் சீயம் ஆகி அவுணன் முரண் மார்வம்","munai Ar sIyam Agi avuNan muraN mArvam"],[1490,"ஆனைப் புரவித் தேரொடு காலாள் அணி கொண்ட","Anaip puravith thEroDu kAlAL aNi koNDa"],[1491,"உறியார் வெண்ணெய் உண்டு உரலோடும் கட்டுண்டு","uRiyAr veNNey uNDu uralODum kaTTuNDu"],[1492,"விடை ஏழ் வென்று மென்தோள் ஆய்ச்சிக்கு அன்பனாய்","viDai Ezh venRu menthOL Aychchikku anbanAy"],[1493,"பகு வாய் வன்பேய் கொங்கை சுவைத்து ஆருயிர் உண்டு","pagu vAy vanpEy konggai suvaiththu Aruyir uNDu"],[1494,"முந்து நூலும் முப்புரி நூலும் முன் ஈந்த","mundhu nUlum muppuri nUlum mun Indha"],[1495,"வெள்ளைப் புரவித் தேர் விசயற்காய் விறல் வியூகம்","veLLaip puravith thEr visayaRkAy viRal viyUgam"],[1496,"பாரை ஊரும் பாரம் தீரப் பார்த்தன் தன்","pArai Urum pAram thIrap pArththan than"],[1497,"தாமத் துளப நீள் முடி மாயன் தான் நின்ற","thAmath thuLaba nIL muDi mAyan thAn ninRa"],[1498,"அம்பரமும் பெருநிலனும் திசைகள் எட்டும்","ambaramum perunilanum thisaigaL eTTum"],[1499,"கொழுங்கயலாய் நெடு வெள்ளம் கொண்ட காலம்","kozhungkayalAy neDu veLLam koNDa kAlam"],[1500,"பவ்வ நீர் உடை ஆடையாகச் சுற்றிப்","pavva nIr uDai ADaiyAgach suRRip"],[1501,"பைங்கண் ஆள் அரி உருவாய் வெருவ நோக்கிப்","paingkaN AL ari uruvAy veruva nOkkip"],[1502,"அன்று உலக மூன்றினையும் அளந்து வேறோர்","anRu ulaga mUnRinaiyum aLandhu vEROr"],[1503,"தன்னாலே தன் உருவம் பயந்த தான் ஆய்","taṉṉāle taṉ uruvam payanta tāṉ āy"],[1504,"முலைத் தடத்த நஞ்சுண்டு துஞ்சப் பேய்ச்சி","mulaith thaDaththa nanjchuNDu thunjchap pEychchi"],[1505,"முருக்கு இலங்கு கனித் துவர் வாய்ப் பின்னை கேள்வன்","murukku ilanggu kanith thuvar vAyp pinnai kELvan"],[1506,"தாராளன் தண்ணரங்க வாளன் பூ மேல்","thArALan thaNNarangga vALan pU mEl"],[1507,"செம்மொழி வாய் நால் வேத வாணர் வாழும்","semmozhi vAy nAl vEdha vANar vAzhum"],[1508,"ஆளும் பணியும் அடியேனைக் கொண்டான் விண்ட நிசாசரரை","ALum paNiyum aDiyEnaik koNDAn viNDa nisAsararai"],[1509,"முனியாய் வந்து மூவெழுகால் முடி சேர் மன்னர் உடல் துணிய","muniyAy vandhu mUvezhukAl muDi sEr mannar uDal thuNiya"],[1510,"தெள் ஆர் கடல்வாய் விட வாய","tĕl̤ ār kaṭalvāy viṭa vāya"],[1511,"ஓளியா வெண்ணெய் உண்டான் என்று உரலோடு ஆய்ச்சி ஒண்கயிற்றால்","OLiyA veNNey uNDAn enRu uralODu Aychchi oNkayiRRAl"],[1512,"வில்லார் விழவில் வடமதுரை விரும்பி விரும்பா மல் அடர்த்து","villAr vizhavil vaDamadhurai virumbi virumbA mal aDarththu"],[1513,"வள்ளி கொழுனன் முதலாய மக்களோடு முக்கணான்","vaLLi kozhunan mudhalAya makkaLODu mukkaNAn"],[1514,"மிடையா வந்த வேல் மன்னர் வீய விசயன் தேர் கடவி","miDaiyA vandha vEl mannar vIya visayan thEr kaDavi"],[1515,"பந்தார் விரலாள் பாஞ்சாலி கூந்தல் முடிக்கப் பாரதத்து","pandhAr viralAL pAnjchAli kUndhal muDikkap pAradhaththu"],[1516,"ஆறும் பிறையும் அரவமும்","āṟum piṟaiyum aravamum"],[1517,"நன்மை உடைய மறையோர் வாழ் நறையூர் நின்ற நம்பியை","nanmai uDaiya maRaiyOr vAzh naRaiyUr ninRa nambiyai"],[1518,"மான் கொண்ட தோல் மார்வில் மாணியாய் மாவலி மண்","mAn koNDa thOl mArvil mANiyAy mAvali maN"],[1519,"முந்நீரை முன்னாள் கடைந்தானை மூழ்த்த நாள்","munnIrai munnAL kaDaindhAnai mUzhththa nAL"],[1520,"தூ வாய புள் ஊர்ந்து வந்து துறை வேழம்","thU vAya puL Urndhu vandhu thuRai vEzham"],[1521,"ஓடா அரியாய் இரணியனை ஊன் இடந்த","ODA ariyAy iraNiyanai Un iDandha"],[1522,"கல்லார் மதிள் சூழ் கடி இலங்கைக் கார் அரக்கன்","kallAr madhiL sUzh kaDi ilanggaik kAr arakkan"],[1523,"உம்பர் உலகோடு உயிர் எல்லாம் உந்தியில்","umbar ulagODu uyir ellAm undhiyil"],[1524,"கட்டேறு நீள் சோலைக் காண்டவத்தைத் தீ மூட்டி","kaTTERu nIL sOlaik kANDavaththaith thI mUTTi"],[1525,"மண்ணின் மீ பாரம் கெடுப்பான் மற மன்னர்","maNNin mI pAram keDuppAn maRa mannar"],[1526,"பொங்கேறு நீள் சோதிப் பொன் ஆழி தன்னோடும்","ponggERu nIL sOdhip pon Azhi thannODum"],[1527,"மன்னு மதுரை வசுதேவர் வாழ் முதலை","mannu madhurai vasudhEvar vAzh mudhalai"],[1528,"பெடை அடர்த்த மடவன்னம் பிரியாது மலர்க் கமலம்","peDai aDarththa maDavannam piriyAdhu malark kamalam"],[1529,"கழி ஆரும் கன சங்கம் கலந்து எங்கும் நிறைந்தேறி","kazhi Arum kana sanggam kalandhu enggum niRaindhERi"],[1530,"சுளை கொண்ட பலங்கனிகள் தேன் பாய கதலிகளின்","suLai koNDa palangkanigaL thEn pAya kadhaligaLin"],[1531,"துன்றோளித் துகிற்படலம் துன்னி எங்கும் மாளிகை மேல்","thunROLith thukiRpaDalam thunni enggum mALigai mEl"],[1532,"அகில் குறடும் சந்தனமும் அம் பொன்னும் அணி முத்தும்","akil kuṟaṭum cantaṉamum am pŏṉṉum aṇi muttum"],[1533,"பொன் முத்தும் அரி உகிரும் புழைக் கைம்மா கரிக்கோடும்","pon muththum ari ugirum puzhaik kaimmA karikkODum"],[1534,"சீர் தழைத்த கதிர்ச் செந்நெல் செங்கமலத்து இடை இடையின்","sIr thazhaiththa kadhirch chennel sengkamalaththu iDai iDaiyin"],[1535,"குலை ஆர்ந்த பழுக்காயும் பசுங்காயும் பாளை முத்தும்","kulai Arndha pazhukkAyum pasungkAyum pALai muththum"],[1536,"மறை ஆரும் பெருவேள்விக் கொழும் புகை போய் வளர்ந்து எங்கும்","maRai Arum peruvELvik kozhum pugai pOy vaLarndhu enggum"],[1537,"திண்களக மதிள் புடை சூழ் திருநறையூர் நின்றானை","thiNkaLaga madhiL puDai sUzh thirunaRaiyUr ninRAnai"],[1538,"கிடந்த நம்பி குடந்தை மேவிக் கேழலாய் உலகை","kiDandha nambi kuDandhai mEvik kEzhalAy ulagai"],[1539,"விடம் தான் உடைய அரவம் வெருவச் செருவில் முன நாள் முன்","viDam thAn uDaiya aravam veruvach seruvil muna nAL mun"],[1540,"பூணாது அனலும் தறு கண் வேழம் மறுக வளை மருப்பைப்","pUNAdhu analum thaRu kaN vEzham maRuga vaLai maruppaip"],[1541,"கல்லார் மதிள் சூழ் கச்சி நகருள் நச்சி பாடகத்துள்","kallAr madhiL sUzh kachchi nagaruL nachchi pADagaththuL"],[1542,"குடையா வரையால் நிரை முன் காத்த பெருமான் மருவாத","kuDaiyA varaiyAl nirai mun kAththa perumAn maruvAdha"],[1543,"கான எண்கும் குரங்கும் முசுவும் படையா அடல் அரக்கர்","kAna eNgum kuranggum musuvum paDaiyA aDal arakkar"],[1544,"நின்ற வரையும் கிடந்த கடலும் திசையும் இருநிலனும்","ninRa varaiyum kiDandha kaDalum thisaiyum irunilanum"],[1545,"கடுங்கால் மாரி கல்லே பொழிய அல்லே எமக்கு என்று","kaDungkAl mAri kallE pozhiya allE emakku enRu"],[1546,"பொங்கு புணரிக் கடல் சூழ் ஆடை நில மாமகள் மலர் மா","ponggu puNarik kaDal sUzh ADai nila mAmagaL malar mA"],[1547,"வாவித் தடம் சூழ் மணி முத்தாற்று நறையூர் நெடுமாலை","vAvith thaDam sUzh maNi muththARRu naRaiyUr neDumAlai"],[1548,"கறவா மட நாகு தன் கன்று உள்ளினாற் போல்","kaRavA maDa nAgu than kanRu uLLinAR pOl"],[1549,"வற்றா முது நீரொடு மால் வரை ஏழும்","vaRRA mudhu nIroDu mAl varai Ezhum"],[1550,"தாரேன் பிறர்க்கு உன் அருள் என்னிடை வைத்தாய்","thArEn piRarkku un aruL enniDai vaiththAy"],[1551,"புள் வாய் பிளந்த புனிதா! என்று அழைக்க","puL vAy piLandha punidhA! enRu azhaikka"],[1552,"வில்லேர் நுதல் வேல் நெடுங்கண்ணியும் நீயும்","villEr nudhal vEl neDungkaNNiyum nIyum"],[1553,"பனி ஏய் பரங் குன்றின் பவளத் திரளே","paṉi ey paraṅ kuṉṟiṉ paval̤at tiral̤e"],[1554,"கதியேல் இல்லை நின் அருள் அல்லது எனக்கு","kadhiyEl illai nin aruL alladhu enakku"],[1555,"அத்தா! அரியே! என்று உன்னை அழைக்க","aththA! ariyE! enRu unnai azhaikka"],[1556,"தூயாய்! சுடர் மாமதி போல் உயிர்க்கு எல்லாம்","thUyAy! suDar mAmadhi pOl uyirkku ellAm"],[1557,"வண்டு ஆர் பொழில் சூழ் நறையூர் நம்பிக்கு என்றும்","vaṇṭu ār pŏzhil cūzh naṟaiyūr nampikku ĕṉṟum"],[1558,"புள்ளாய் ஏனமுமாய்ப் புகுந்து என்னை உள்ளம் கொண்ட","puLLAy EnamumAyp pugundhu ennai uLLam koNDa"],[1559,"ஓடா ஆளரியின் உருவாய் மருவி என்தன்","ODA ALariyin uruvAy maruvi enthan"],[1560,"எம்மானும் எம் அனையும் என்னைப் பெற்று ஒழிந்ததற்பின்","ĕmmāṉum ĕm aṉaiyum ĕṉṉaip pĕṟṟu ŏzhintataṟpiṉ"],[1561,"சிறியாய் ஓர் பிள்ளையுமாய் உலகுண்டு ஓர் ஆலிலை மேல்","siRiyAy Or piLLaiyumAy ulaguNDu Or Alilai mEl"],[1562,"நீண்டாயை வானவர்கள் நினைந்து ஏத்திக் காண்பரிதால்","nINDAyai vAnavargaL ninaindhu Eththik kANbaridhAl"],[1563,"எம் தாதை தாதை அப்பால் எழுவர் பழ அடிமை","ĕm tātai tātai appāl ĕzhuvar pazha aṭimai"],[1564,"மன் அஞ்ச ஆயிரம் தோள் மழுவில் துணித்த மைந்தா","maṉ añca āyiram tol̤ mazhuvil tuṇitta maintā"],[1565,"எப்போதும் பொன்மலர் இட்டு இமையோர் தொழுது தங்கள்","eppOdhum ponmalar iTTu imaiyOr thozhudhu thanggaL"],[1566,"ஊன் ஏர் ஆக்கை தன்னை உழந்து ஓம்பி வைத்தமையால்","Un Er Akkai thannai uzhandhu Ombi vaiththamaiyAl"],[1567,"நன்னீர் வயல் புடை சூழ் நறையூர் நின்ற நம்பியை","nannIr vayal puDai sUzh naRaiyUr ninRa nambiyai"],[1568,"சின இல் செங் கண் அரக்கர் உயிர் மாளச்","ciṉa il cĕṅ kaṇ arakkar uyir māl̤ac"],[1569,"தாய் நினைந்த கன்றே ஒக்க என்னையும்","thAy ninaindha kanRE okka ennaiyum"],[1570,"வந்த நாள் வந்து என் நெஞ்சிடம் கொண்டான்","vandha nAL vandhu en nenjchiDam koNDAn"],[1571,"உரங்களால் இயன்ற மன்னர் மாளப்","urangkaLAl iyanRa mannar mALap"],[1572,"ஆங்கு வெந்நரகத்து அழுந்தும் போது","Anggu vennaragaththu azhundhum pOdhu"],[1573,"எட்டனைப் பொழுது ஆகிலும் என்றும்","eTTanaip pozhudhu Agilum enRum"],[1574,"பண்ணின் இன்மொழி யாழ் நரம்பில் பெற்ற","paNNin inmozhi yAzh narambil peRRa"],[1575,"இனி எப்பாவம் வந்து எய்தும்? சொல்லீர்","ini eppAvam vandhu eydhum? sollIr"],[1576,"என் செய்கேன் அடியேன்? உரையீர் இதற்கு","en seygEn aDiyEn? uraiyIr idhaRku"],[1577,"தோடு விண்டலர் பூம்பொழில் மங்கையர்","thODu viNDalar pUmpozhil manggaiyar"],[1578,"கண் சோர வெங்குருதி வந்திழிய","kaN sOra vengkurudhi vandhizhiya"],[1579,"அம்புருவ வரி நெடுங்கண் அலர் மகளை","ampuruva vari neDungkaN alar magaLai"],[1580,"மீதோடி வாள் எயிறு மின் இலக","mIdhODi vAL eyiRu min ilaga"],[1581,"தேர் ஆளும் வாள் அரக்கன் தென் இலங்கை","thEr ALum vAL arakkan then ilanggai"],[1582,"வந்திக்கும் மற்றவர்க்கும் மாசுடம்பில்","vandhikkum maRRavarkkum mAsuDambil"],[1583,"பண்டு ஏனமாய் உலகை அன்று இடந்த","paNDu EnamAy ulagai anRu iDandha"],[1584,"பை விரியும் வரி அரவில் படுகடலுள்","pai viriyum vari aravil paDukaDaluL"],[1585,"உண்ணாது வெம் கூற்றம் ஓவாத","uṇṇātu vĕm kūṟṟam ovāta"],[1586,"கள்ளத்தேன் பொய் அகத்தேன் ஆதலால்","kaLLaththEn poy agaththEn AdhalAl"],[1587,"பூ மாண் சேர் கருங்குழலார் போல் நடந்து","pU mAN sEr karungkuzhalAr pOl naDandhu"],[1588,"தந்தை காலில் பெருவிலங்கு தாள் அவிழ நள்ளிருட்கண்","thandhai kAlil peruvilanggu thAL avizha naLLiruTkaN"],[1589,"பாரித்து எழுந்த படை மன்னர் தம்மை மாள பாரதத்துத்","pAriththu ezhundha paDai mannar thammai mALa pAradhaththuth"],[1590,"செம்பொன் மதிள் சூழ் தென்னிலங்கைக்கு இறைவன் சிரங்கள் ஐயிரண்டும்","sempon madhiL sUzh thennilanggaikku iRaivan siranggaL aiyiraNDum"],[1591,"வெள்ளத்துள் ஓர் ஆலிலை மேல் மேவி அடியேன் மனம் புகுந்து என்","veLLaththuL Or Alilai mEl mEvi aDiyEn manam pugundhu en"],[1592,"பகலும் இரவும் தானேயாய்ப் பாரும் விண்ணும் தானேயாய்","pagalum iravum thAnEyAyp pArum viNNum thAnEyAy"],[1593,"ஏடிலங்கு தாமரை போல் செவ்வாய் முறுவல் செய்தருளி","EDilanggu thAmarai pOl sevvAy muRuval seydharuLi"],[1594,"மாலைப் புகுந்து மலர் அணை மேல் வைகி அடியேன் மனம் புகுந்து என்","mAlaip pugundhu malar aNai mEl vaigi aDiyEn manam pugundhu en"],[1595,"வஞ்சி மருங்குல் இடை நோவ மணந்து நின்ற கனவகத்து என்","vanjchi marunggul iDai nOva maNandhu ninRa kanavagaththu en"],[1596,"என் ஐம்புலனும் எழிலும் கொண்டு இங்கே நெருநல் எழுந்தருளி","en aimpulanum ezhilum koNDu inggE nerunal ezhundharuLi"],[1597,"நெல்லில் குவளை கண் காட்ட நீரில் குமுதம் வாய் காட்ட","nellil kuvaLai kaN kATTa nIril kumudham vAy kATTa"],[1598,"சிங்கம் அதாய் அவுணன் திறல் ஆகம் முன் கீண்டுகந்த","singgam adhAy avuNan thiRal Agam mun kINDugandha"],[1599,"கோவானார் மடியக் கொலை ஆர் மழுக் கொண்டருளும்","kOvAnAr maDiyak kolai Ar mazhuk koNDaruLum"],[1600,"உடையானை ஒலி நீர் உலகங்கள் படைத்தானை","uDaiyAnai oli nIr ulaganggaL paDaiththAnai"],[1601,"குன்றால் மாரி தடுத்தவனைக் குல வேழம் அன்று","kunRAl mAri thaDuththavanaik kula vEzham anRu"],[1602,"கஞ்சனைக் காய்ந்தானைக் கண்ணமங்கையுள் நின்றானை","kanjchanaik kAyndhAnaik kaNNamanggaiyuL ninRAnai"],[1603,"பெரியானை அமரர் தலைவற்கும் பிரமனுக்கும்","periyAnai amarar thalaivaRkum piramanukkum"],[1604,"திருவாழ் மார்வன் தன்னைத் திசை மண் நீர் எரி முதலா","thiruvAzh mArvan thannaith thisai maN nIr eri mudhalA"],[1605,"நிலை ஆளாக என்னை உகந்தானை நிலமகள் தன்","nilai ALAga ennai ugandhAnai nilamagaL than"],[1606,"பேரானைக் குடந்தைப் பெருமானை இலங்கொளி சேர்","pErAnaik kuDandhaip perumAnai ilangkoLi sEr"],[1607,"திறல் முருகன் அனையார் தென்னழுந்தையில் மன்னி நின்ற","thiRal murugan anaiyAr thennazhundhaiyil manni ninRa"],[1608,"திருவுக்கும் திருவாகிய செல்வா!","thiruvukkum thiruvAgiya selvA!"],[1609,"பந்தார் மெல்விரல் நல்வளைத் தோளி","pandhAr melviral nalvaLaith thOLi"],[1610,"நெய்யார் ஆழியும் சங்கமும் ஏந்தும்","neyyAr Azhiyum sanggamum Endhum"],[1611,"பரனே! பஞ்சவன் பௌழியன் சோழன்","paranE! panjchavan pauzhiyan chOzhan"],[1612,"விண்டான் விண் புக வெஞ்சமத்து அரியாய்ப்","viNDAn viN puga venjchamaththu ariyAyp"],[1613,"தோயா இன்தயிர் நெய் அமுது உண்ணச்","thOyA inthayir ney amudhu uNNach"],[1614,"கறுத்துக் கஞ்சனை அஞ்ச முனிந்தாய்!","kaRuththuk kanjchanai anjcha munindhAy!"],[1615,"நெடியானே! கடி ஆர் கலி நம்பீ!","neDiyAnE! kaDi Ar kali nambI!"],[1616,"கோவாய் ஐவர் என் மெய்குடி ஏறிக்","kOvAy aivar en meykuDi ERik"],[1617,"அன்னம் மன்னு பைம்பூம்பொழில் சூழ்ந்த","annam mannu paimpUmpozhil sUzhndha"],[1618,"செங்கமலத் திருமகளும் புவியும் செம்பொன்","sengkamalath thirumagaLum puviyum sempon"],[1619,"முன் இவ்வுலகு ஏழும் இருள் மண்டி உண்ண","mun ivvulagu Ezhum iruL maNDi uNNa"],[1620,"குலத் தலைய மத வேழம் பொய்கை புக்குக்","kulath thalaiya madha vEzham poygai pukkuk"],[1621,"சிலம்பு முதல் கலன் அணிந்தோர் செங்கண் குன்றம்","silambu mudhal kalan aNindhOr sengkaN kunRam"],[1622,"சின மேவும் அடல் அரியின் உருவம் ஆகித்","sina mEvum aDal ariyin uruvam Agith"],[1623,"வானவர் தம் துயர் தீர வந்து தோன்றி","vAnavar tham thuyar thIra vandhu thOnRi"],[1624,"பந்தணைந்த மெல்விரலாள் சீதைக்காகிப்","pandhaNaindha melviralAL sIdhaikkAgip"],[1625,"கும்ப மிகு மத வேழம் குலையக் கொம்பு","kumba migu madha vEzham kulaiyak kombu"],[1626,"ஊடேறு கஞ்சனொடு மல்லும் வில்லும்","UDERu kanjchanoDu mallum villum"],[1627,"பன்றியாய் மீனாகி அரியாய்ப் பாரைப்","panRiyAy mInAgi ariyAyp pAraip"],[1628,"கள்ளம் மனம் விள்ளும் வகை கருதிக் கழல் தொழுவீர்","kaLLam manam viLLum vagai karudhik kazhal thozhuvIr"],[1629,"தெருவில் திரி சிறு நோன்பியர் செஞ்சோற்றொடு கஞ்சி","theruvil thiri siRu nOnbiyar senjchORRoDu kanjchi"],[1630,"பறையும் வினை தொழுது உய்மின் நீர் பணியும் சிறு தொண்டீர்!","paRaiyum vinai thozhudhu uymin nIr paNiyum siRu thoNDIr!"],[1631,"வானார் மதி பொதியும் சடை மழுவாளியொடு ஒருபால்","vAnAr madhi podhiyum saDai mazhuvALiyoDu orupAl"],[1632,"நந்தா நெடு நரகத்திடை நணுகா வகை நாளும்","nandhA neDu naragaththiDai naNugA vagai nALum"],[1633,"முழு நீலமும் மலர் ஆம்பலும் அரவிந்தமும் விரவி","muzhu nIlamum malar Ambalum aravindhamum viravi"],[1634,"சேய் ஓங்கு தண் திருமாலிருஞ்சோலை மலை உறையும்","sEy Onggu thaN thirumAlirunjchOlai malai uRaiyum"],[1635,"மை ஆர் வரி நீலம் மலர்க் கண்ணார் மனம் விட்டிட்டு","mai Ar vari nIlam malark kaNNAr manam viTTiTTu"],[1636,"கரு மா முகில் உருவா! கனல் உருவா! புனல் உருவா!","karu mA mugil uruvA! kanal uruvA! punal uruvA!"],[1637,"சீரார் நெடு மறுகில் சிறுபுலியூர்ச் சலசயனத்து","sIrAr neDu maRugil siRupuliyUrch salasayanaththu"],[1638,"பெரும்புறக்கடலை அடல் ஏற்றினைப்","perumpuRakkaDalai aDal ERRinaip"],[1639,"மெய்ந்நலத் தவத்தைத் திவத்தைத் தரும்","meynnalath thavaththaith thivaththaith tharum"],[1640,"எங்களுக்கு அருள் செய்கின்ற ஈசனை","enggaLukku aruL seyginRa Isanai"],[1641,"பேய் முலைத்தல நஞ்சு உண்ட பிள்ளையைத்","pEy mulaiththala nanjchu uNDa piLLaiyaith"],[1642,"ஏற்றினை இமயத்துள் எம் ஈசனை","ERRinai imayaththuL em Isanai"],[1643,"துப்பனைத் துரங்கம் படச் சீறிய","thuppanaith thuranggam paDach sIRiya"],[1644,"திருத்தனைத் திசை நான்முகன் தந்தையைத்","thiruththanaith thisai nAnmugan thandhaiyaith"],[1645,"வெஞ்சினக் களிற்றை விளங்காய் விழக்","venjchinak kaLiRRai viLanggAy vizhak"],[1646,"பண்ணினைப் பண்ணில் நின்றதோர் பான்மையைப்","paNNinaip paNNil ninRadhOr pAnmaiyaip"],[1647,"கண்ணமங்கையுள் கண்டு கொண்டேன் என்று","kaNNamanggaiyuL kaNDu koNDEn enRu"],[1648,"சிலை இலங்கு பொன்னாழி திண்படை தண்டு","silai ilanggu ponnAzhi thiNpaDai thaNDu"],[1649,"செரு வரை முன் ஆசறுத்த சிலை அன்றோ?","seru varai mun AsaRuththa silai anRO?"],[1650,"துன்னு மாமணி முடி மேல் துழாய் அலங்கல்","thunnu mAmaNi muDi mEl thuzhAy alanggal"],[1651,"தார் ஆய தண்துளப வண்டுழுத","thAr Aya thaNthuLaba vaNDuzhudha"],[1652,"அடித்தலமும் தாமரையே அங்கைகளும்","aDiththalamum thAmaraiyE angkaigaLum"],[1653,"பேர் ஆயிரம் உடைய பேர் ஆளன்","pEr Ayiram uDaiya pEr ALan"],[1654,"செவ்வரத்த உடை ஆடை அதன் மேல் ஓர்","sevvaraththa uDai ADai adhan mEl Or"],[1655,"கொற்றப் புள் ஒன்றேறி மன்றூடே","koRRap puL onRERi manRUDE"],[1656,"வண்டமரும் வனமாலை மணி முடி மேல்","vaNDamarum vanamAlai maNi muDi mEl"],[1657,"மா வளரு மென்னோக்கி மாதராள்","mA vaLaru mennOkki mAdharAL"],[1658,"தெள்ளியீர்! தேவர்க்கும் தேவர் திருத்தக்கீர்!","theLLiyIr! dhEvarkkum dhEvar thiruththakkIr!"],[1659,"நீணிலா முற்றத்து நின்று இவள் நோக்கினாள்","nINilA muRRaththu ninRu ivaL nOkkinAL"],[1660,"அருவி சோர் வேங்கடம் நீர்மலை என்று வாய்","aruvi sOr vEnggaDam nIrmalai enRu vAy"],[1661,"உண்ணும் நாள் இல்லை உறக்கமும் தான் இல்லை","uNNum nAL illai uRakkamum thAn illai"],[1662,"கண்ணன் ஊர் கண்ணபுரம் தொழும் காரிகை","kaNNan Ur kaNNapuram thozhum kArigai"],[1663,"வடவரை நின்றும் வந்து இன்று கணபுரம்","vaDavarai ninRum vandhu inRu kaNapuram"],[1664,"தரங்க நீர் பேசினும் தண் மதி காயினும்","tharangga nIr pEsinum thaN madhi kAyinum"],[1665,"தொண்டெல்லாம் நின் அடியே தொழுது உய்யுமா","thoNDellAm nin aDiyE thozhudhu uyyumA"],[1666,"முள் எயிறு ஏய்ந்தில கூழை முடி கொடா","muL eyiRu Eyndhila kUzhai muDi koDA"],[1667,"கார் மலி கண்ணபுரத்து எம் அடிகளை","kAr mali kaNNapuraththu em aDigaLai"],[1668,"கரை எடுத்த சுரிசங்கும் கன பவளத்து எழுகொடியும்","karai eDuththa surisanggum kana pavaLaththu ezhukoDiyum"],[1669,"அரி விரவு முகில் கணத்தால் அகில் புகையால் வரையோடும்","ari viravu mugil kaNaththAl agil pugaiyAl varaiyODum"],[1670,"துங்க மாமணி மாட நெடு முகட்டின் சூலிகை போம்","thungga mAmaNi mADa neDu mugaTTin sUligai pOm"],[1671,"கண மருவு மயில் அகவு கடிபொழில் சூழ் நெடு மறுகில்","kaNa maruvu mayil agavu kaDipozhil sUzh neDu maRugil"],[1672,"வாய் எடுத்த மந்திரத்தால் அந்தணர் தம் செய் தொழில்கள்","vAy eDuththa mandhiraththAl andhaNar tham sey thozhilgaL"],[1673,"மடல் எடுத்த நெடுந்தாழை மருங்கெல்லாம் வளர் பவளம்","maDal eDuththa neDunthAzhai marunggellAm vaLar pavaLam"],[1674,"வண்டமரும் மலர்ப் புன்னை வரி நீழல் அணி முத்தம்","vaNDamarum malarp punnai vari nIzhal aNi muththam"],[1675,"கொங்கு மலி கருங்குவளை கண்ணாகத் தெண்கயங்கள்","konggu mali karungkuvaLai kaNNAgath theNkayanggaL"],[1676,"வாராளும் இளங்கொங்கை நெடும் பணைத் தோள் மடப் பாவை","vArALum iLangkonggai neDum paNaith thOL maDap pAvai"],[1677,"தே மருவு பொழில் புடை சூழ் திருக்கண்ணபுரத்து உறையும்","thE maruvu pozhil puDai sUzh thirukkaNNapuraththu uRaiyum"],[1678,"விண்ணவர் தங்கள் பெருமான் திருமார்வன்","viNNavar thanggaL perumAn thirumArvan"],[1679,"வேத முதல்வன் விளங்கு புரிநூலன்","vEdha mudhalvan viLanggu purinUlan"],[1680,"விண்ட மலர் எல்லாம் ஊதி நீ என் பெறுதி?","viNDa malar ellAm Udhi nI en peRudhi?"],[1681,"நீர் மலிகின்றதோர் மீனாய் ஓர் ஆமையுமாய்","nIr maliginRadhOr mInAy Or AmaiyumAy"],[1682,"ஏரார் மலர் எல்லாம் ஊதி நீ என் பெறுதி?","ErAr malar ellAm Udhi nI en peRudhi?"],[1683,"மார்வில் திருவன் வலன் ஏந்து சக்கரத்தன்","mArvil thiruvan valan Endhu chakkaraththan"],[1684,"வாமனன் கற்கி மதுசூதன் மாதவன்","vAmanan kaRki madhusUdhan mAdhavan"],[1685,"நீல மலர்கள் நெடு நீர் வயல் மருங்கில்","nIla malargaL neDu nIr vayal marunggil"],[1686,"நந்தன் மதலை நிலமங்கை நல்துணைவன்","nandhan madhalai nilamanggai nalthuNaivan"],[1687,"வண்டமரும் சோலை வயல் ஆலி நல்நாடன்","vaNDamarum sOlai vayal Ali nalnADan"],[1688,"தந்தை காலில் விலங்கற வந்து","thandhai kAlil vilanggaRa vandhu"],[1689,"மாரி மாக்கடல் வளை வணற்கு இளையவன்","mAri mAkkaDal vaLai vaNaRku iLaiyavan"],[1690,"ஆயன் மாயமே அன்றி மற்று என்","Ayan mAyamE anRi maRRu en"],[1691,"கயங்கொள் புண் தலைக் களிறுந்து","kayangkoL puN thalaik kaLiRundhu"],[1692,"ஏழு மாமரம் துளை படச்","Ezhu mAmaram thuLai paDach"],[1693,"முரியும் வெண்திரை முதுகயம்","muriyum veNthirai mudhukayam"],[1694,"கலங்க மாக்கடல் கடைந்தடைத்து","kalangga mAkkaDal kaDaindhaDaiththu"],[1695,"முழுது இவ்வையகம் முறை கெட","muzhudhu ivvaiyagam muRai keDa"],[1696,"கனஞ்செய் மாமதிள் கணபுரத்தவனொடும்","kananjchey mAmadhiL kaNapuraththavanoDum"],[1697,"வார்கொள் மென்முலை மடந்தையர்","vArkoL menmulai maDandhaiyar"],[1698,"தொண்டீர்! உய்யும் வகை கண்டேன்","thoNDIr! uyyum vagai kaNDEn"],[1699,"பொருந்தா அரக்கர் வெஞ்சமத்துப்","porundhA arakkar venjchamaththup"],[1700,"வல்லி இடையாள் பொருட்டாக","valli iDaiyAL poruTTAga"],[1701,"மல்லை முந்நீர் அதர்பட","mallai munnIr adharpaDa"],[1702,"ஆமை ஆகி அரி ஆகி","Amai Agi ari Agi"],[1703,"வருந்தாதிரு நீ மடநெஞ்சே!","varundhAdhiru nI maDanenjchE!"],[1704,"இலையார் மலர்ப் பூம்பொய்கை வாய்","ilaiyAr malarp pUmpoygai vAy"],[1705,"மாலாய் மனமே! அருந்துயரில்","mAlAy manamE! arunthuyaril"],[1706,"குன்றால் மாரி பழுதாக்கிக்","kunRAl mAri pazhudhAkkik"],[1707,"கருமாமுகில் தோய் நெடுமாடக்","karumAmugil thOy neDumADak"],[1708,"வியம் உடை விடை இனம் உடைதர மடமகள்","viyam uDai viDai inam uDaithara maDamagaL"],[1709,"இணை மலி மருதினொடு எருதிற இகல் செய்து","iNai mali marudhinoDu erudhiRa igal seydhu"],[1710,"புயல் உறு வரை மழை பொழி தர மணி நிரை","puyal uRu varai mazhai pozhi thara maNi nirai"],[1711,"ஏதலர் நகை செய இளையவர் அளை வெணெய்","Edhalar nagai seya iLaiyavar aLai veNey"],[1712,"தொண்டரும் அமரரும் முனிவரும் தொழுதெழ","thoNDarum amararum munivarum thozhudhezha"],[1713,"மழுவியல் படை உடை அவன் இடம் மழை முகில்","mazhuviyal paDai uDai avan iDam mazhai mugil"],[1714,"பரிதியொடு அணிமதி பனி வரை திசை நிலம்","paridhiyoDu aNimadhi pani varai thisai nilam"],[1715,"படி புல்கும் அடி இணை பலர் தொழ மலர் வைகு","paDi pulgum aDi iNai palar thozha malar vaigu"],[1716,"புல மனும் மலர்மிசை மலர் மகள் புணரிய","pula maṉum malarmicai malar-makal̤ puṇariya"],[1717,"மலி புகழ் கணபுரம் உடைய எம் அடிகளை","mali pugazh kaNapuram uDaiya em aDigaLai"],[1718,"வானோர் அளவும் முது முந்நீர் வளர்ந்த காலம் வலி உருவின்","vāṉor al̤avum mutu munnīr val̤arnta kālam vali uruviṉ"],[1719,"மலங்கு விலங்கு நெடு வெள்ளம்","malanggu vilanggu neDu veLLam"],[1720,"பாரார் அளவும் முது முந்நீர்","pArAr aLavum mudhu munnIr"],[1721,"உளைந்த அரியும் மானிடமும்","uLaindha ariyum mAniDamum"],[1722,"தொழுநீர் வடிவின் குறள் உருவாய்","thozhunIr vaDivin kuRaL uruvAy"],[1723,"வடி வாய் மழுவே படையாக","vaDi vAy mazhuvE paDaiyAga"],[1724,"வையம் எல்லாம் உடன் வணங்க","vaiyam ellAm uDan vaNangga"],[1725,"ஒற்றைக் குழையும் நாஞ்சிலும்","oRRaik kuzhaiyum nAnjchilum"],[1726,"துவரிக் கனி வாய் நிலமங்கை","thuvarik kani vAy nilamanggai"],[1727,"மீனோடு ஆமை கேழல் அரி","mInODu Amai kEzhal ari"],[1728,"கைம்மான மத யானை இடர் தீர்த்த கருமுகிலை","kaimmAna madha yAnai iDar thIrththa karumugilai"],[1729,"தரு மான மழை முகிலைப் பிரியாது தன் அடைந்தார்","tharu mAna mazhai mugilaip piriyAdhu than aDaindhAr"],[1730,"விடை ஏழ் அன்றடர்த்து வெகுண்டு விலங்கல் உற","viDai Ezh anRaDarththu veguNDu vilanggal uRa"],[1731,"மிக்கானை மறையாய் விரிந்த விளக்கை என்னுள்","mikkAnai maRaiyAy virindha viLakkai ennuL"],[1732,"வந்தாய் என் மனத்தே வந்து நீ புகுந்த பின்னை","vandhAy en manaththE vandhu nI pugundha pinnai"],[1733,"எஞ்சா வெந்நரகத்து அழுந்தி நடுங்குகின்றேற்கு","enjchA vennaragaththu azhundhi naDungguginRERku"],[1734,"பெற்றார் பெற்று ஒழிந்தார் பின்னும் நின்று அடியேனுக்கு","peRRAr peRRu ozhindhAr pinnum ninRu aDiyEnukku"],[1735,"கற்றார் பற்றறுக்கும் பிறவிப் பெருங்கடலே","kaRRAr paRRaRukkum piRavip perungkaDalE"],[1736,"கண்ணார் கண்ணபுரம் கடிகை கடி கமழும்","kaNNAr kaNNapuram kaDigai kaDi kamazhum"],[1737,"செரு நீர வேல் வலவன் கலிகன்றி மங்கையர் கோன்","seru nIra vEl valavan kalikanRi manggaiyar kOn"],[1738,"வண்டார் பூ மாமலர் மங்கை மண நோக்கம்","vaNDAr pU mAmalar manggai maNa nOkkam"],[1739,"பெரு நீரும் விண்ணும் மலையும் உலகேழும்","peru nIrum viNNum malaiyum ulagEzhum"],[1740,"மற்றும் ஓர் தெய்வம் உளது என்று இருப்பாரோடு","maṟṟum or tĕyvam ul̤atu ĕṉṟu iruppāroṭu"],[1741,"பெண் ஆனாள் பேர் இளம் கொங்கையின் ஆரழல் போல்","peN AnAL pEr iLam konggaiyin Arazhal pOl"],[1742,"பெற்றாரும் சுற்றமும் என்றிவை பேணேன் நான்","peRRArum suRRamum enRivai pENEn nAn"],[1743,"ஏத்தி உன் சேவடி எண்ணி இருப்பாரை","Eththi un sEvaDi eNNi iruppArai"],[1744,"வெள்ளை நீர் வெள்ளத்து அணைந்த அரவணை மேல்","veLLai nIr veLLaththu aNaindha aravaNai mEl"],[1745,"மாணாகி வையம் அளந்ததுவும் வாள் அவுணன்","mANAgi vaiyam aLandhadhuvum vAL avuNan"],[1746,"நாட்டினாய் என்னை உனக்கு முன் தொண்டாக","nATTinAy ennai unakku mun thoNDAga"],[1747,"கண்ட சீர்க் கண்ணபுரத்துறை அம்மானை","kaNDa sIrk kaNNapuraththuRai ammAnai"],[1748,"வங்க மா முந்நீர் வரி நிறப் பெரிய","vangga mA munnIr vari niRap periya"],[1749,"கவள மா கதத்த கரி உய்யப் பொய்கைக்","kavaLa mA kadhaththa kari uyyap poygaik"],[1750,"வாதை வந்தடர வானமும் நிலனும்","vAdhai vandhaDara vAnamum nilanum"],[1751,"வென்றி சேர் திண்மை விலங்கல் மாமேனி","venRi sEr thiNmai vilanggal mAmEni"],[1752,"மன்னவன் பெரிய வேள்வியில் குறளாய்","mannavan periya vELviyil kuRaLAy"],[1753,"மழுவினால் அவனி அரசை மூவெழுகால்","mazhuvinAl avani arasai mUvezhukAl"],[1754,"வான் உளார் அவரை வலிமையால் நலியும்","vāṉ ul̤ār-avarai valimaiyāl naliyum"],[1755,"அரவு நீள்கொடியோன் அவையுள் ஆசனத்தை","aravu nILkoDiyOn avaiyuL Asanaththai"],[1756,"பன்னிய பாரம் பார்மகட்கு ஒழியப்","panniya bAram pArmagaTku ozhiyap"],[1757,"கலை உலா அல்குல் காரிகை திறத்துக்","kalai ulA algul kArigai thiRaththuk"],[1758,"பொன் இவர் மேனி மரகதத்தின்","pŏṉ ivar meṉi marakatattiṉ"],[1759,"தோடவிழ் நீலம் மணம் கொடுக்கும்","thODavizh nIlam maNam koDukkum"],[1760,"வேய் இருஞ்சோலை விலங்கல் சூழ்ந்த","vEy irunjchOlai vilanggal sUzhndha"],[1761,"வம்பவிழும் துழாய் மாலை தோள் மேல்","vambavizhum thuzhAy mAlai thOL mEl"],[1762,"கோழியும் கூடலும் கோயில் கொண்ட","kOzhiyum kUDalum kOyil koNDa"],[1763,"வெஞ்சின வேழம் மருப்பொசித்த","venjchina vEzham marupposiththa"],[1764,"பிணி அவிழ் தாமரை மொட்டலர்த்தும்","piNi avizh thAmarai moTTalarththum"],[1765,"மஞ்சுயர் மாமதி தீண்ட நீண்ட","manjchuyar mAmadhi thINDa nINDa"],[1766,"எண்திசையும் எறி நீர்க் கடலும்","eNthisaiyum eRi nIrk kaDalum"],[1767,"அன்னமும் கேழலும் மீனும் ஆய","annamum kEzhalum mInum Aya"],[1768,"தன்னை நைவிக்கிலேன் வல் வினையேன் தொழுதும் எழு","taṉṉai naivikkileṉ val viṉaiyeṉ tŏzhutum ĕzhu-"],[1769,"உருகி நெஞ்சே! நினைந்து இங்கு இருந்தென்? தொழுதும் எழு","urugi nenjchE! ninaindhu inggu irundhen? thozhudhum ezhu"],[1770,"ஏது செய்தால் மறக்கேன்? மனமே! தொழுதும் எழு","Edhu seydhAl maRakkEn? manamE! thozhudhum ezhu"],[1771,"கொங்குண் வண்டே கரி ஆக வந்தான் கொடியேற்கு முன்","kongguN vaNDE kari Aga vandhAn koDiyERku mun"],[1772,"உணரில் உள்ளம் சுடும் ஆல் வினையேன் தொழுதும் எழு","uNaril uLLam suDum Al vinaiyEn thozhudhum ezhu"],[1773,"எள்கி நெஞ்சே! நினைந்து இங்கு இருந்தென்? தொழுதும் எழு","eLgi nenjchE! ninaindhu inggu irundhen? thozhudhum ezhu"],[1774,"பரவி நெஞ்சே! தொழுதும் எழு போய் அவன் பாலமாய்","paravi nenjchE! thozhudhum ezhu pOy avan pAlamAy"],[1775,"அலமும் ஆழிப் படையும் உடையார் நமக்கு அன்பராய்","alamum Azhip paDaiyum uDaiyAr namakku anbarAy"],[1776,"ஓதி நாமம் குளித்து உச்சி தன்னால் ஒளி மா மலர்","oti nāmam kul̤ittu ucci-taṉṉāl ŏl̤i mā malar"],[1777,"இலங்கு முத்தும் பவளக் கொழுந்தும் எழில் தாமரை","ilanggu muththum pavaLak kozhundhum ezhil thAmarai"],[1778,"காவார் மடல் பெண்ணை அன்றில் அரி குரலும்","kAvAr maDal peNNai anRil ari kuralum"],[1779,"முன்னம் குறள் உருவாய் மூவடி மண் கொண்டளந்த","munnam kuRaL uruvAy mUvaDi maN koNDaLandha"],[1780,"வவ்வித் துழாய் அதன் மேல் சென்ற தனி நெஞ்சம்","vavvith thuzhAy adhan mEl senRa thani nenjcham"],[1781,"பரிய இரணியனது ஆகம் அணி உகிரால்","pariya iraNiyanadhu Agam aNi ugirAl"],[1782,"வில்லால் இலங்கை மலங்கச் சரம் துரந்த","villAl ilanggai malanggach saram thurandha"],[1783,"சுழன்று இலங்கு வெங்கதிரோன் தேரோடும் போய் மறைந்தான்","suzhanRu ilanggu vengkadhirOn thErODum pOy maRaindhAn"],[1784,"கனையார் இடிகுரலின் கார்மணியின் நா ஆடல்","kanaiyAr iDikuralin kArmaNiyin nA ADal"],[1785,"தூம்புடைக் கை வேழம் வெருவ மருப்பு ஒசித்த","thUmbuDaik kai vEzham veruva maruppu osiththa"],[1786,"வேதமும் வேள்வியும் விண்ணும் இருசுடரும்","vEdhamum vELviyum viNNum irusuDarum"],[1787,"பொன் அலரும் புன்னை சூழ் புல்லாணி அம்மானை","pon alarum punnai sUzh pullANi ammAnai"],[1788,"தவள இளம்பிறை துள்ளு முந்நீர்த்","thavaLa iLampiRai thuLLu munnIrth"],[1789,"தாதவிழ் மல்லிகை புல்லி வந்த","thAdhavizh malligai pulli vandha"],[1790,"காலையும் மாலை ஒத்துண்டு கங்குல்","kālaiyum mālai ŏttuṇṭu kaṅkul"],[1791,"கரு மணி பூண்டு வெண் நாகு அணைந்து","karu maṇi pūṇṭu vĕṇ nāku aṇaintu"],[1792,"திண்திமில் ஏற்றின் மணியும் ஆயன்","thiNthimil ERRin maNiyum Ayan"],[1793,"எல்லியும் நன்பகலும் இருந்தே","elliyum nanpagalum irundhE"],[1794,"செங்கண் நெடிய கரிய மேனித்","sengkaN neDiya kariya mEnith"],[1795,"கேவலம் அன்று கடலின் ஓசை","kEvalam anRu kaDalin Osai"],[1796,"சோத்தென நின்று தொழ இரங்கான்","sOththena ninRu thozha iranggAn"],[1797,"செற்றவன் தென் இலங்கை மலங்கத்","cĕṟṟavaṉ tĕṉ ilaṅkai malaṅkat"],[1798,"அக்கும் புலியின் அதளும் உடையார் அவர் ஒருவர்","akkum puliyin adhaLum uDaiyAr avar oruvar"],[1799,"துங்கார் அரவத் திரை வந்துலவத் தொடுகடலுள்","thunggAr aravath thirai vandhulavath thoDukaDaluL"],[1800,"வாழக் கண்டோம் வந்து காண்மின் தொண்டீர்காள்!","vAzhak kaNDOm vandhu kANmin thoNDIrgAL!"],[1801,"சிரம் முன் ஐந்தும் ஐந்தும் சிந்தச் சென்று அரக்கன்","ciram muṉ aintum aintum cintac cĕṉṟu arakkaṉ"],[1802,"கவ்வைக் களிற்று மன்னர் மாளக் கலி மான் தேர்","kavvaik kaLiRRu mannar mALak kali mAn thEr"],[1803,"தீ நீர் வண்ண மாமலர் கொண்டு விரை ஏந்தி","thI nIr vaNNa mAmalar koNDu virai Endhi"],[1804,"வல்லிச் சிறு நுண் இடையார் இடை நீர் வைக்கின்ற","vallich siRu nuN iDaiyAr iDai nIr vaikkinRa"],[1805,"நாரார் இண்டை நாண்மலர் கொண்டு நந்தமர்காள்!","nArAr iNDai nANmalar koNDu nanthamargAL!"],[1806,"நின்ற வினையும் துயரும் கெட மாமலர் ஏந்தி","ninRa vinaiyum thuyarum keDa mAmalar Endhi"],[1807,"சிலையால் இலங்கை செற்றான் மற்றோர் சின வேழம்","silaiyAl ilanggai seRRAn maRROr sina vEzham"],[1808,"தந்தை தாய் மக்களே சுற்றம் என்று","thandhai thAy makkaLE suRRam enRu"],[1809,"மின்னு மாவல்லியும் வஞ்சியும்","minnu mAvalliyum vanjchiyum"],[1810,"பூண் உலா மென்முலைப் பாவைமார்","pUN ulA menmulaip pAvaimAr"],[1811,"பண் உலாம் மென் மொழிப் பாவைமார் பணை முலை அணைதும் நாம் என்று","paṇ ulām mĕṉ mŏzhip pāvaimār paṇai mulai aṇaitum nām ĕṉṟu"],[1812,"மஞ்சு தோய் வெண்குடை மன்னராய்","manjchu thOy veNkuDai mannarAy"],[1813,"உருவின் ஆர் பிறவி சேர் ஊன் பொதி","uruvin Ar piRavi sEr Un podhi"],[1814,"நோய் எலாம் பெய்ததோர் ஆக்கையை","nOy elAm peydhadhOr Akkaiyai"],[1815,"மஞ்சு சேர் வான் எரி நீர் நிலம் கால் இவை மயங்கி நின்ற","mañcu cer vāṉ ĕri nīr nilam kāl ivai mayaṅki niṉṟa"],[1816,"வெள்ளியார் பிண்டியார் போதியார் என்று இவர் ஓதுகின்ற","vĕl̤l̤iyār piṇṭiyār potiyār ĕṉṟu ivar otukiṉṟa"],[1817,"மறை வலார் குறைவிலார் உறையும் ஊர்","maRai valAr kuRaivilAr uRaiyum Ur"],[1818,"முந்துற உரைக்கேன் விரைக் குழல் மடவார்","mundhuRa uraikkEn viraik kuzhal maDavAr"],[1819,"இண்டையும் புனலும் கொண்டு இடை இன்றி","iNDaiyum punalum koNDu iDai inRi"],[1820,"பிணி வளர் ஆக்கை நீங்க நின்றேத்தப்","piNi vaLar Akkai nIngga ninREththap"],[1821,"சூர்மயில் ஆய பேய் முலை சுவைத்துச்","sUrmayil Aya pEy mulai suvaiththuch"],[1822,"வணங்கலில் அரக்கன் செருக் களத்து அவிய","vaNanggalil arakkan seruk kaLaththu aviya"],[1823,"விடங்கலந்து அமர்ந்த அரவணைத் துயின்று","viDangkalandhu amarndha aravaNaith thuyinRu"],[1824,"தேனுகன் ஆவி போய் உக அங்கோர்","thEnugan Avi pOy uga anggOr"],[1825,"புத மிகு விசும்பில் புணரி சென்று அணவப்","pudha migu visumbil puNari senRu aNavap"],[1826,"புந்தியில் சமணர் புத்தர் என்றிவர்கள்","pundhiyil samaNar buththar enRivargaL"],[1827,"வண்டமர் சாரல் மாலிருஞ்சோலை","vaNDamar sAral mAlirunjchOlai"],[1828,"மூவரில் முன் முதல்வன் முழங்கார் கடலுள் கிடந்து","mUvaril mun mudhalvan muzhanggAr kaDaluL kiDandhu"],[1829,"புனை வளர் பூம்பொழிலார் பொன்னி சூழ் அரங்க நகருள்","punai vaLar pUmpozhilAr ponni sUzh arangga nagaruL"],[1830,"உண்டு உலகேழினையும் ஒரு பாலகன் ஆலிலை மேல்","uNDu ulagEzhinaiyum oru pAlagan Alilai mEl"],[1831,"சிங்கம் அதாய் அவுணன் திறல் ஆகம் முன் கீண்டுகந்த","singgam adhAy avuNan thiRal Agam mun kINDugandha"],[1832,"தானவன் வேள்வி தன்னில் தனியே குறளாய் நிமிர்ந்து","dhAnavan vELvi thannil thaniyE kuRaLAy nimirndhu"],[1833,"நேசம் இலாதவர்க்கும் நினையாதவர்க்கும் அரியான்","nEsam ilAdhavarkkum ninaiyAdhavarkkum ariyAn"],[1834,"புள்ளினை வாய் பிளந்து பொரு மா கரி கொம்பொசித்து","puLLinai vAy piLandhu poru mA kari kombosiththu"],[1835,"பார்த்தனுக்கு அன்று அருளிப் பாரதத்து ஒரு தேர் முன் நின்று","pArththanukku anRu aruLip bAradhaththu oru thEr mun ninRu"],[1836,"வலம்புரி ஆழியனை வரையார் திரள் தோளன் தன்னை","valampuri Azhiyanai varaiyAr thiraL thOLan thannai"],[1837,"தேடற்கு அரியவனைத் திருமாலிருஞ்சோலை நின்ற","thEDaRku ariyavanaith thirumAlirunjchOlai ninRa"],[1838,"எங்கள் எம் இறை எம் பிரான்","enggaL em iRai em pirAn"],[1839,"எவ்வ நோய் தவிர்ப்பான் எமக்கு இறை இன் நகைத் துவர் வாய் நில மகள்","ĕvva noy tavirppāṉ ĕmakku iṟai iṉ nakait tuvar vāy nila-makal̤"],[1840,"வெள்ளியான் கரியான் மணி நிற வண்ணன்","veLLiyAn kariyAn maNi niRa vaNNan"],[1841,"ஏறும் ஏறி இலங்கும் ஒண் மழுப் பற்றும் ஈசற்கு இசைந்து உடம்பில் ஓர்","eṟum eṟi ilaṅkum ŏṇ mazhup paṟṟum īcaṟku icaintu uṭampil or"],[1842,"வங்க மாகடல் வண்ணன் மாமணி வண்ணன்","vangga mAkaDal vaNNan mAmaNi vaNNan"],[1843,"காவலன் இலங்கைக்கிறை கலங்கச்","kAvalan ilanggaikkiRai kalanggach"],[1844,"கன்று கொண்டு விளங்கனி எறிந்து","kanRu koNDu viLangkani eRindhu"],[1845,"பூங்குருந்து ஒசித்து ஆனை காய்ந்து அரிமாச்","pUngkurundhu osiththu Anai kAyndhu arimAch"],[1846,"கோவை இன் தமிழ் பாடுவார் குடம்","kOvai in thamizh pADuvAr kuDam"],[1847,"ஆலு மாவலவன் கலிகன்றி மங்கையர்","Alu mAvalavan kalikanRi manggaiyar"],[1848,"ஒரு நல் சுற்றம் எனக்கு உயிர் ஒண்பொருள்","oru nal suRRam enakku uyir oNporuL"],[1849,"பொன்னை மாமணியை அணி ஆர்ந்ததோர்","ponnai mAmaNiyai aNi ArndhadhOr"],[1850,"வேலை ஆலிலைப் பள்ளி விரும்பிய","vElai Alilaip paLLi virumbiya"],[1851,"துளக்கமில் சுடரை அவுணன் உடல்","thuLakkamil suDarai avuNan uDal"],[1852,"சுடலையில் சுடு நீறன் அமர்ந்தது ஓர்","cuṭalaiyil cuṭu nīṟaṉ amarntatu or"],[1853,"வானை ஆரமுதம் தந்த வள்ளலை","vAnai Aramudham thandha vaLLalai"],[1854,"கூந்தலார் மகிழ் கோவலனாய் வெண்ணெய்","kUndhalAr magizh kOvalanAy veNNey"],[1855,"பத்தர் ஆவியைப் பால் மதியை அணித்","paththar Aviyaip pAl madhiyai aNith"],[1856,"கம்ப மா களிறு அஞ்சிக் கலங்க ஓர்","kampa mā kal̤iṟu añcik kalaṅka or"],[1857,"பெற்றம் ஆளியைப் பேரில் மணாளனை","peRRam ALiyaip pEril maNALanai"],[1858,"இரக்கம் இன்றி எங்கோன் செய்த தீமை","irakkam inRi engkOn seydha thImai"],[1859,"பத்து நீள்முடியும் அவற்று இரட்டிப்","paththu nILmuDiyum avaRRu iraTTip"],[1860,"தண்டகாரணியம் புகுந்து அன்று","thaNDakAraNiyam pugundhu anRu"],[1861,"எஞ்சலில் இலங்கைக்கு இறை எங்கோன்","enjchalil ilanggaikku iRai engkOn"],[1862,"செம்பொன் நீள்முடி எங்கள் இராவணன்","sempon nILmuDi enggaL irAvaNan"],[1863,"ஓத மாகடலைக் கடந்தேறி","Odha mAkaDalaik kaDandhERi"],[1864,"தாழம் இன்றி முந்நீரை அஞ்ஞான்று","thAzham inRi munnIrai anjnjAnRu"],[1865,"மனங்கொண்டு ஏறும் மண்டோதரி முதலா","manangkoNDu ERum maNDOdhari mudhalA"],[1866,"புரங்கள் மூன்றும் ஓர் மாத்திரைப் போதில்","puraṅkal̤ mūṉṟum or māttiraip potil"],[1867,"அங்கு வானவர்க்கு ஆகுலம் தீர","anggu vAnavarkku Agulam thIra"],[1868,"ஏத்துகின்றோம் நாத்தழும்ப இராமன் திருநாமம்","EththuginROm nAththazhumba irAman thirunAmam"],[1869,"எம்பிரானே என்னை ஆள்வாய் என்று என்று அலற்றாதே","ĕmpirāṉe ĕṉṉai āl̤vāy ĕṉṟu ĕṉṟu alaṟṟāte"],[1870,"ஞாலம் ஆளும் உங்கள் கோமான் எங்கள் இராவணற்கு","njAlam ALum unggaL kOmAn enggaL irAvaNaRku"],[1871,"மணங்கள் நாறும் வார் குழலார் மாதர்கள் ஆதரத்தை","maNanggaL nARum vAr kuzhalAr mAdhargaL Adharaththai"],[1872,"வென்றி தந்தோம் மானம் வேண்டோம் தானம் எமக்காக","venRi thandhOm mAnam vENDOm dhAnam emakkAga"],[1873,"கல்லின் முந்நீர் மாற்றி வந்து காவல் கடந்து இலங்கை","kallin munnIr mARRi vandhu kAval kaDandhu ilanggai"],[1874,"மாற்றம் ஆவது இத்தனையே வம்மின் அரக்கர் உள்ளீர்!","mARRam Avadhu iththanaiyE vammin arakkar uLLIr!"],[1875,"கவள யானை பாய் புரவி தேரொடு அரக்கர் எல்லாம்","kaval̤a yāṉai pāy puravi terŏṭu arakkar ĕllām"],[1876,"ஏடொத்த ஏந்தும் நீளிலை வேல் எங்கள் இராவணனார்","EDoththa Endhum nILilai vEl enggaL irAvaNanAr"],[1877,"வென்ற தொல் சீர்த் தென்னிலங்கை வெஞ்சமத்து அன்று அரக்கர்","venRa thol sIrth thennilanggai venjchamaththu anRu arakkar"],[1878,"சந்த மலர்க் குழல் தாழத்","sandha malark kuzhal thAzhath"],[1879,"வங்க மறிகடல் வண்ணா!","vangga maRikaDal vaNNA!"],[1880,"திருவில் பொலிந்த எழில் ஆர்","thiruvil polindha ezhil Ar"],[1881,"மக்கள் பெறு தவம் போலும்","makkaL peRu thavam pOlum"],[1882,"மைத்த கருங்குஞ்சி மைந்தா!","maiththa karungkunjchi maindhA!"],[1883,"பிள்ளைகள் செய்வன செய்யாய்","piLLaigaL seyvana seyyAy"],[1884,"தன் மகனாக வன்பேய்ச்சி","than maganAga vanpEychchi"],[1885,"உந்தம் அடிகள் முனிவர்","undham aDigaL munivar"],[1886,"பெற்றத் தலைவன் எங்கோமான்","peRRath thalaivan enggOmAn"],[1887,"இம்மை இடர் கெட வேண்டி","immai iDar keDa vENDi"],[1888,"பூங் கோதை ஆய்ச்சி கடை வெண்ணெய் புக்கு உண்ண","pūṅ kotai āycci kaṭai vĕṇṇĕy pukku uṇṇa"],[1889,"தாயர் மனங்கள் தடிப்ப தயிர் நெய் உண்","thAyar mananggaL thaDippa thayir ney uN"],[1890,"தா மோர் உருட்டித் தயிர் நெய் விழுங்கிட்டு","thA mOr uruTTith thayir ney vizhunggiTTu"],[1891,"பெற்றார் தளை கழலப் பேர்ந்தங்கு அயல் இடத்து","peRRAr thaLai kazhalap pErndhanggu ayal iDaththu"],[1892,"சோத்தென நின்னைத் தொழுவன் வரம் தர","sOththena ninnaith thozhuvan varam thara"],[1893,"கேவலம் அன்று உன் வயிறு வயிற்றுக்கு","kEvalam anRu un vayiRu vayiRRukku"],[1894,"புள்ளினை வாய் பிளந்து பூங்குருந்தம் சாய்த்து","puLLinai vAy piLandhu pUngkurundham sAyththu"],[1895,"யாயும் பிறரும் அறியாத யாமத்து","yāyum piṟarum aṟiyāta yāmattu"],[1896,"கள்ளக் குழவியாய்க் காலால் சகடத்தை","kaLLak kuzhaviyAyk kAlAl sakaDaththai"],[1897,"காரார் புயற்கைக் கலிகன்றி மங்கையர் கோன்","kArAr puyaRkaik kalikanRi manggaiyar kOn"],[1898,"எங்கானும் ஈதொப்பதோர் மாயம் உண்டே?","enggAnum IdhoppadhOr mAyam uNDE?"],[1899,"குன்றொன்று மத்தா அரவம் அளவிக்","kunRonRu maththA aravam aLavik"],[1900,"உளைந்திட்டு எழுந்த மது கைடவர்கள்","ul̤aintiṭṭu ĕzhunta matu-kaiṭavarkal̤"],[1901,"தளர்ந்திட்டு இமையோர் சரண் தா எனத் தான்","thaLarndhiTTu imaiyOr saraN thA enath thAn"],[1902,"நீண்டான் குறளாய் நெடுவான் அளவும்","nINDAn kuRaLAy neDuvAn aLavum"],[1903,"பழித்திட்ட இன்பப் பயன் பற்றறுத்துப்","pazhiththiTTa inbap payan paRRaRuththup"],[1904,"படைத்திட்டது இவ்வையம் உய்ய முன நாள்","paDaiththiTTadhu ivvaiyam uyya muna nAL"],[1905,"நெறித்திட்ட மென் கூழை நல் நேர் இழையோடு","nĕṟittiṭṭa mĕṉ kūzhai nal ner-izhaiyoṭu"],[1906,"சுரிந்திட்ட செங் கேழ் உளைப் பொங்கு அரிமாத்","curintiṭṭa cĕṅ kezh ul̤aip pŏṅku arimāt"],[1907,"நின்றார் முகப்புச் சிறிதும் நினையான்","ninRAr mugappuch siRidhum ninaiyAn"],[1908,"மானம் உடைத்து உங்கள் ஆயர் குலம்","mAnam uDaiththu unggaL Ayar kulam"],[1909,"காலை எழுந்து கடைந்த இம்மோர் விற்கப்","kAlai ezhundhu kaDaindha immOr viRkap"],[1910,"தெள்ளிய வாய்ச் சிறியான் நங்கைகாள்! உறி","theLLiya vAych chiRiyAn nanggaigAL! uRi"],[1911,"மைந்நம்பு வேற்கண் நல்லாள் முன்னம் பெற்ற வளை","mainnambu vERkaN nallAL munnam peRRa vaLai"],[1912,"தந்தை புகுந்திலன் நான் இங்கு இருந்திலேன்","thandhai pugundhilan nAn inggu irundhilEn"],[1913,"மண்மகள் கேள்வன் மலர்மங்கை நாயகன்","maNmagaL kELvan malarmanggai nAyagan"],[1914,"ஆயிரம் கண் உடை இந்திரனாருக்கு என்று","Ayiram kaN uDai indhiranArukku enRu"],[1915,"தோய்த்த தயிரும் நறு நெய்யும் பாலும்","toytta tayirum naṟu nĕyyum pālum"],[1916,"ஈடும் வலியும் உடைய இந் நம்பி","īṭum valiyum uṭaiya in nampi"],[1917,"அஞ்சுவன் சொல்லி அழைத்திட நங்கைகாள்!","anjchuvan solli azhaiththiDa nanggaigAL!"],[1918,"அங்ஙனம் தீமைகள் செய்வர்களோ","aṅṅaṉam tīmaikal̤ cĕyvarkal̤o-"],[1919,"அச்சம் தினைத்தனை இல்லை இப்பிள்ளைக்கு","achcham thinaiththanai illai ippiLLaikku"],[1920,"தம் பரம் அல்லன ஆண்மைகளைத் தனியே","tham param allana ANmaigaLaith thaniyE"],[1921,"அன்ன நடை மடவாய்ச்சி வயிறடித்து","anna naDai maDavAychchi vayiRaDiththu"],[1922,"காதில் கடிப்பு இட்டுக் கலிங்கம் உடுத்து","kātil kaṭippu iṭṭuk kaliṅkam uṭuttu"],[1923,"துவர் ஆடை உடுத்து ஒரு செண்டு சிலுப்பி","thuvar ADai uDuththu oru seNDu siluppi"],[1924,"கருளக் கொடி ஒன்றுடையீர்! தனிப் பாகீர்","karuLak koDi onRuDaiyIr! thanip pAgIr"],[1925,"நாமம் பலவும் உடை நாரண நம்பீ","nāmam palavum uṭai nāraṇa nampī"],[1926,"சுற்றும் குழல் தாழச் சுரிகை அணைத்து","suRRum kuzhal thAzhach surigai aNaiththu"],[1927,"ஆன் ஆயரும் ஆநிரையும் அங்கொழிய","An Ayarum Aniraiyum anggozhiya"],[1928,"மல்லே பொருத திரள் தோல் மணவாளீர்!","mallE porudha thiraL thOl maNavALIr!"],[1929,"புக்கு ஆடரவம் பிடித்தாட்டும் புனிதீர்!","pukku ADaravam piDiththATTum punidhIr!"],[1930,"ஆடி அசைந்து ஆய் மடவாரொடு நீ போய்","ADi asaindhu Ay maDavAroDu nI pOy"],[1931,"அல்லிக் கமலக் கண்ணனை அங்கோர் ஆய்ச்சி","allik kamalak kaNNanai anggOr Aychchi"],[1932,"புள் உருவாகி நள் இருள் வந்த","puL uruvAgi naL iruL vandha"],[1933,"மன்றில் மலிந்து கூத்துவந்தாடி","manRil malindhu kUththuvandhADi"],[1934,"ஆர் மலி ஆழி சங்கொடு பற்றி","Ar mali Azhi sanggoDu paRRi"],[1935,"மல்கிய தோளும் மான் உரி அதளும்","malgiya thOLum mAn uri adhaLum"],[1936,"செரு அழியாத மன்னர்கள் மாளத்","seru azhiyAdha mannargaL mALath"],[1937,"அரக்கியர் ஆகம் புல்லென வில்லால்","arakkiyar Agam pullena villAl"],[1938,"ஆழி அந்திண்தேர் அரசர் வந்து இறைஞ்ச","Azhi anthiNthEr arasar vandhu iRainjcha"],[1939,"பொருந்தலன் ஆகம் புள் உவந்து ஏற","porundhalan Agam puL uvandhu ERa"],[1940,"நீர் அழல் வானாய் நெடுநிலம் காலாய்","nIr azhal vAnAy neDunilam kAlAy"],[1941,"வேட்டத்தைக் கருதாது அடி இணை வணங்கி","vETTaththaik karudhAdhu aDi iNai vaNanggi"],[1942,"திருத்தாய் செம்போத்தே!","thiruththAy sempOththE!"],[1943,"கரையாய் காக்கைப் பிள்ளாய்!","karaiyAy kAkkaip piLLAy!"],[1944,"கூவாய் பூங்குயிலே!","kUvAy pUngkuyilE!"],[1945,"கொட்டாய் பல்லிக் குட்டி!","koTTAy pallik kuTTi!"],[1946,"சொல்லாய் பைங்கிளியே!","sollAy paingkiLiyE!"],[1947,"கோழி கூவென்னும் ஆல்","kOzhi kUvennum Al"],[1948,"காமற்கு என் கடவேன்?","kAmaRku en kaDavEn?"],[1949,"இங்கே போதுங்கொலோ?","inggE pOdhungklolO?"],[1950,"இன்னார் என்று அறியேன்","innAr enRu aRiyEn"],[1951,"தொண்டீர்! பாடுமினோ","thoNDIr! pADuminO"],[1952,"குன்றம் ஒன்று எடுத்து ஏந்தி மாமழை","kunRam onRu eDuththu Endhi mAmazhai"],[1953,"காரும் வார் பனிக் கடலும் அன்னவன்","kārum vār paṉik kaṭalum aṉṉavaṉ"],[1954,"சங்கும் மாமையும் தளரும் மேனி மேல்","sanggum mAmaiyum thaLarum mEni mEl"],[1955,"அங்கோர் ஆய்க்குலத்துள் வளர்ந்து சென்று","anggOr AykkulaththuL vaLarndhu senRu"],[1956,"அங்கோர் ஆள் அரியாய் அவுணனை","anggu Or AL ariyAy avuNanai"],[1957,"சென்று வார் சிலை வளைத்து இலங்கையை","senRu vAr silai vaLaiththu ilanggaiyai"],[1958,"பூவை வண்ணனார் புள்ளின் மேல் வர","pUvai vaNNanAr puLLin mEl vara"],[1959,"மால் இனம் துழாய் வரும் என் நெஞ்சகம்","mAl inam thuzhAy varum en nenjchagam"],[1960,"கெண்டை ஒண்கணும் துயிலும் என் நிறம்","keNDai oNkaNum thuyilum en niRam"],[1961,"அன்று பாரதத்து ஐவர் தூதனாய்","anRu pAradhaththu aivar thUdhanAy"],[1962,"குன்றம் எடுத்து மழை","kunRam eDuththu mazhai"],[1963,"பூங்குருந்து ஒசித்து ஆனை","pUngkurundhu osiththu Anai"],[1964,"மல்லொடு கஞ்சனும் துஞ்ச","malloDu kanjchanum thunjcha"],[1965,"பொருந்து மாமரம் ஏழும்","porundhu mAmaram Ezhum"],[1966,"அன்னை முனிவதும் அன்றிலின்","annai munivadhum anRilin"],[1967,"ஆழியும் சங்கும் உடைய நங்கள் அடிகள் தாம்","āzhiyum caṅkum uṭaiya naṅkal̤ aṭikal̤-tām"],[1968,"காமன் தனக்கு முறை","kAman thanakku muRai"],[1969,"மஞ்சுறு மாலிருஞ்சோலை","manjchuRu mAlirunjchOlai"],[1970,"காமன் கணைக்கு ஓர் இலக்கமாய்","kAman kaNaikku Or ilakkamAy"],[1971,"வென்றி விடை உடன்","venRi viDai uDan"],[1972,"மன் இலங்கு பாரதத்துத் தேர் ஊர்ந்து மாவலியைப்","maṉ ilaṅku pāratattut ter ūrntu māvaliyaip"],[1973,"இருந்தான் என் உள்ளத்து இறைவன் கறை சேர்","irundhAn en uLLaththu iRaivan kaRai sEr"],[1974,"அன்னே! இவரை அறிவன் மறை நான்கும்","annE! ivarai aRivan maRai nAnkum"],[1975,"அறியோமே என்று உரைக்கலாமே? எமக்கு","aRiyOmE enRu uraikkalAmE? emakku"],[1976,"தம்மையே நாளும் வணங்கித் தொழுவார்க்கு","thammaiyE nALum vaNanggith thozhuvArkku"],[1977,"வைத்தார் அடியார் மனத்தினில் வைத்து இன்பம்","vaiththAr aDiyAr manaththinil vaiththu inbam"],[1978,"கண்ணன் மனத்துள்ளே நிற்கவும் கைவளைகள்","kaNNan manaththuLLE niRkavum kaivaLaigaL"],[1979,"பாடோமே? எந்தை பெருமானைப் பாடி நின்று","pADOmE? endhai perumAnaip pADi ninRu"],[1980,"நன்னெஞ்சே! நம்பெருமான் நாளும் இனிதமரும்","nannenjchE! namperumAn nALum inidhamarum"],[1981,"பெற்றாரார் ஆயிரம் பேரானைப் பேர் பாடப்","peRRArAr Ayiram pErAnaip pEr pADap"],[1982,"நிலை இடம் எங்கும் இன்றி நெடு வெள்ளம்","nilai iDam enggum inRi neDu veLLam"],[1983,"செரு மிகு வாள் எயிற்ற அரவு ஒன்று சுற்றித்","cĕru miku vāl̤ ĕyiṟṟa aravu ŏṉṟu cuṟṟit"],[1984,"தீது அறு திங்கள் பொங்கு சுடர் உம்பர்","tītu aṟu tiṅkal̤ pŏṅku cuṭar umpar"],[1985,"தளை அவிழ் கோதை மாலை இருபால் தயங்க","tal̤ai avizh kotai mālai irupāl tayaṅka"],[1986,"வெந்திறல் வாணன் வேள்வி இடம் எய்தி","venthiRal vANan vELvi iDam eydhi"],[1987,"இரு நில மன்னர் தம்மை இரு நாலும்","iru nila mannar thammai iru nAlum"],[1988,"இலை மலி பள்ளி எய்தி இது மாயம்","ilai mali paLLi eydhi idhu mAyam"],[1989,"முன் உலகங்கள் ஏழும் இருள்மண்டி உண்ண","muṉ ulakaṅkal̤ ezhum irul̤maṇṭi uṇṇa"],[1990,"துணை நிலை மற்றெமக்கோர் உளது என்றிராது","thuNai nilai maRRemakkOr uLadhu enRirAdhu"],[1991,"கொலை கெழு செம்முகத்த களிறு ஒன்று","kolai kezhu semmugaththa kaLiRu onRu"],[1992,"மான் அமரு மென்னோக்கி வைதேவி இன் துணையா","mAn amaru mennOkki vaidhEvi in thuNaiyA"],[1993,"தந்தை தளை கழலத் தோன்றிப் போய் ஆய்ப்பாடி","thandhai thaLai kazhalath thOnRip pOy AyppADi"],[1994,"ஆழ் கடல் சூழ் வையகத்தார் ஏசப் போய் ஆய்ப்பாடித்","Azh kaDal sUzh vaiyagaththAr Esap pOy AyppADith"],[1995,"அறியாதார்க்கு ஆனாயன் ஆகிப் போய் ஆய்ப்பாடி","aRiyAdhArkku AnAyan Agip pOy AyppADi"],[1996,"வண்ணக் கருங்குழல் ஆய்ச்சியால் மொத்துண்டு","vaNNak karungguzhal AychchiyAl moththuNDu"],[1997,"கன்றப் பறை கறங்கக் கண்டவர் தம் கண் களிப்ப","kanRap paRai kaRanggak kaNDavar tham kaN kaLippa"],[1998,"கோதை வேல் ஐவர்க்காய் மண் அகலம் கூறிடுவான்","kOdhai vEl aivarkkAy maN agalam kURiDuvAn"],[1999,"பார் மன்னர் மங்கப் படை தொட்டு வெஞ்சமத்து","pAr mannar manggap paDai thoTTu venjchamaththu"],[2000,"கண்டார் இரங்கக் கழியக் குறள் உருவாய்","kaNDAr iranggak kazhiyak kuRaL uruvAy"],[2001,"கள்ளத்தால் மாவலியை மூவடி மண் கொண்டளந்தான்","kaLLaththAl mAvaliyai mUvaDi maN koNDaLandhAn"],[2002,"மைந்நின்ற கருங்கடல் வாய் உலகின்றி","mainninRa karungkaDal vAy ulaginRi"],[2003,"நில்லாத பெருவெள்ளம் நெடுவிசும்பின்","nillAdha peruveLLam neDuvisumbin"],[2004,"நெற்றி மேல் கண்ணானும் நிறை மொழி வாய்","neRRi mEl kaNNAnum niRai mozhi vAy"],[2005,"பனிப் பரவைத் திரை ததும்பப் பார் எல்லாம்","panip paravaith thirai thadhumbap pAr ellAm"],[2006,"பார் ஆரும் காணாமே பரவை மா","pAr Arum kANAmE paravai mA"],[2007,"பேய் இருக்கும் நெடு வெள்ளம் பெரு விசும்பின் மீது","pey irukkum nĕṭu vĕl̤l̤am pĕru vicumpiṉ-mītu"],[2008,"மண்ணாடும் விண்ணாடும் வானவரும்","maNNADum viNNADum vAnavarum"],[2009,"மறம் கிளர்ந்த கருங்கடல் நீர் உரம் துரந்து","maRam kiLarndha karungkaDal nIr uram thurandhu"],[2010,"அண்டத்தின் முகடழுந்த அலை முந்நீர்த்","aNDaththin mugaDazhundha alai munnIrth"],[2011,"தேவரையும் அசுரரையும் திசைகளையும்","dhEvaraiyum asuraraiyum thisaigaLaiyum"],[2012,"நீள் நாகம் சுற்றி நெடு வரை நட்டு ஆழ் கடலைப்","nIL nAgam suRRi neDu varai naTTu Azh kaDalaip"],[2013,"நீள்வான் குறள் உருவாய் நின்று இரந்து மாவலி மண்","nILvAn kuRaL uruvAy ninRu irandhu mAvali maN"],[2014,"தூயானைத் தூய மறையானை தென் ஆலி","thUyAnaith thUya maRaiyAnai then Ali"],[2015,"கூடா இரணியனைக் கூர் உகிரால் மார்விடந்த","kUDA iraNiyanaik kUr ugirAl mArviDandha"],[2016,"மை ஆர் கடலும் மணி வரையும் மாமுகிலும்","mai Ar kaDalum maNi varaiyum mAmugilum"],[2017,"கள்ளார் துழாயும் கணவலரும் கூவிளையும்","kaLLAr thuzhAyum kaNavalarum kUviLaiyum"],[2018,"கனையார் கடலும் கருவிளையும் காயாவும்","kanaiyAr kaDalum karuviLaiyum kAyAvum"],[2019,"வெறியார் கருங்கூந்தல் ஆய்ச்சியர் வைத்த","veRiyAr karungkUndhal Aychchiyar vaiththa"],[2020,"தேனோடு வண்டாலும் திருமாலிருஞ்சோலை","thEnODu vaNDAlum thirumAlirunjchOlai"],[2021,"மெய்ந் நின்ற பாவம் அகல திருமாலைக்","mĕyn niṉṟa pāvam akala tirumālaik"],[2022,"மாற்றம் உள ஆகிலும் சொல்லுவன் மக்கள்","mARRam uLa Agilum solluvan makkaL"],[2023,"சீற்றம் உள ஆகிலும் செப்புவன் மக்கள்","sIRRam uLa Agilum seppuvan makkaL"],[2024,"தூங்கார் பிறவிக்கள் இன்னம் புகப் பெய்து","thUnggAr piRavikkaL innam pugap peydhu"],[2025,"உருவார் பிறவிக்கள் இன்னம் புகப் பெய்து","uruvAr piRavikkaL innam pugap peydhu"],[2026,"கொள்ளக் குறையாத இடும்பைக் குழியில்","koLLak kuRaiyAdha iDumbaik kuzhiyil"],[2027,"படை நின்ற பைந்தாமரையோடு அணி நீலம்","paDai ninRa painthAmaraiyODu aNi nIlam"],[2028,"வேம்பின் புழு வேம்பு அன்றி உண்ணாது அடியேன்","vEmbin puzhu vEmbu anRi uNNAdhu aDiyEn"],[2029,"அணியார் பொழில் சூழ் அரங்க நகர் அப்பா!","aNiyAr pozhil sUzh arangga nagar appA!"],[2030,"நந்தா நரகத்து அழுந்தா வகை நாளும்","nandhA naragaththu azhundhA vagai nALum"],[2031,"குன்றம் எடுத்து ஆநிரை காத்தவன் தன்னை","kunRam eDuththu Anirai kAththavan thannai"],[2032,"நிதியினைப் பவளத் தூணை நெறிமையால் நினைய வல்லார்","nidhiyinaip pavaLath thUNai neRimaiyAl ninaiya vallAr"],[2033,"காற்றினைப் புனலைத் தீயைக் கடி மதிள் இலங்கை செற்ற","kARRinaip punalaith thIyaik kaDi madhiL ilanggai seRRa"],[2034,"பாய் இரும் பரவை தன்னுள் பருவரை திரித்து வானோர்க்","pAy irum paravai thannuL paruvarai thiriththu vAnOrk"],[2035,"கேட்க யான் உற்றதுண்டு கேழலாய் உலகம் கொண்ட","kETka yAn uRRadhuNDu kEzhalAy ulagam koNDa"],[2036,"இரும்பு அனன்றுண்ட நீர் போல் எம்பெருமானுக்கு என்தன்","irumbu ananRuNDa nIr pOl emperumAnukku endhan"],[2037,"மூவரில் முதல்வனாய ஒருவனை உலகம் கொண்ட","mUvaril mudhalvanAya oruvanai ulagam koNDa"],[2038,"இம்மையை மறுமை தன்னை எமக்கு வீடாகி நின்ற","immaiyai maRumai thannai emakku vIDAgi ninRa"],[2039,"வானிடைப் புயலை மாலை வரை இடைப் பிரசம் ஈன்ற","vAniDaip puyalai mAlai varai iDaip pirasam InRa"],[2040,"உள்ளமோ ஒன்றில் நில்லாது ஓசையில் எரி நின்று உண்ணும்","ul̤l̤amo ŏṉṟil nillātu ocaiyil ĕri niṉṟu uṇṇum"],[2041,"சித்தமும் செவ்வை நில்லாது என் செய்கேன் தீ வினையேன்?","chiththamum sevvai nillAdhu en seygEn thI vinaiyEn?"],[2042,"தொண்டெல்லாம் பரவி நின்னைத் தொழுது அடி பணியுமாறு","thoNDellAm paravi ninnaith thozhudhu aDi paNiyumARu"],[2043,"ஆவியை அரங்க மாலை அழுக்கு உடம்பு எச்சில் வாயால்","āviyai araṅka mālai azhukku uṭampu ĕccil vāyāl"],[2044,"இரும்பு அனன்றுண்ட நீரும் போதரும் கொள்க என்தன்","irumbu ananRuNDa nIrum pOdharum koLga endhan"],[2045,"காவியை வென்ற கண்ணார் கலவியே கருதி நாளும்","kAviyai venRa kaNNAr kalaviyE karudhi nALum"],[2046,"முன் பொலா இராவணன் தன் முது மதிள் இலங்கை வேவித்து","mun polA irAvaNan than mudhu madhiL ilanggai vEviththu"],[2047,"மாய மான் மாயச் செற்று மருதிற நடந்து வையம்","mAya mAn mAyach cheRRu marudhiRa naDandhu vaiyam"],[2048,"பேசினார் பிறவி நீத்தார் பேர் உளான் பெருமை பேசி","pEsinAr piRavi nIththAr pEr uLAn perumai pEsi"],[2049,"இளைப்பினை இயக்கம் நீக்கி இருந்து முன் இமையைக் கூட்டி","il̤aippiṉai iyakkam nīkki iruntu muṉ imaiyaik kūṭṭi"],[2050,"பிண்டியார் மண்டை ஏந்திப் பிறர் மனை திரிதந்து உண்ணும்","piNDiyAr maNDai Endhip piRar manai thiridhandhu uNNum"],[2051,"வானவர் தங்கள் கோனும் மலர் மிசை அயனும் நாளும்","vAnavar thanggaL kOnum malar misai ayanum nALum"],[2052,"மின் உருவாய் முன் உருவில் வேதம் நான்காய்","min uruvAy mun uruvil vEdham nAnkAy"],[2053,"பார் உருவி நீர் எரி கால் விசும்பும் ஆகிப்","pAr uruvi nIr eri kAl visumbum Agip"],[2054,"திருவடிவில் கரு நெடுமால் சேயன் என்றும்","tiruvaṭivil karu nĕṭumāl ceyaṉ ĕṉṟum"],[2055,"இந்திரற்கும் பிரமற்கும் முதல்வன் தன்னை","indhiraRkum piramaRkum mudhalvan thannai"],[2056,"ஒண்மிதியில் புனல் உருவி ஒருகால் நிற்ப","oNmidhiyil punal uruvi orukAl niRpa"],[2057,"அலம் புரிந்த நெடுந்தடக்கை அமரர் வேந்தன்","alam purindha neDunthaDakkai amarar vEndhan"],[2058,"வற்பு உடைய வரை நெடுந் தோள் மன்னர் மாள","vaṟpu uṭaiya varai nĕṭun tol̤ maṉṉar māl̤a"],[2059,"நீரகத்தாய்! நெடுவரையின் உச்சி மேலாய்!","nIragaththAy! neDuvaraiyin uchchi mElAy!"],[2060,"வங்கத்தால் மாமணி வந்துந்து முந்நீர்","vanggaththAl mAmaNi vandhundhu munnIr"],[2061,"பொன் ஆனாய்! பொழில் ஏழும் காவல் பூண்ட","pon AnAy! pozhil Ezhum kAval pUNDa"],[2062,"பட்டு உடுக்கும் அயர்த்து இரங்கும் பாவை பேணாள்","paṭṭu uṭukkum ayarttu iraṅkum pāvai peṇāl̤"],[2063,"நெஞ்சுருகிக் கண் பனிப்ப நிற்கும் சோரும்","nenjchurugik kaN panippa niRkum sOrum"],[2064,"கல் எடுத்துக் கல் மாரி காத்தாய்! என்றும்","kal eDuththuk kal mAri kAththAy! enRum"],[2065,"முளைக் கதிரைக் குறுங்குடியுள் முகிலை மூவா","muLaik kadhiraik kuRungkuDiyuL mugilai mUvA"],[2066,"கல் உயர்ந்த நெடுமதிள் சூழ் கச்சி மேய","kal uyarndha neDumadhiL sUzh kachchi mEya"],[2067,"கன்று மேய்த்து இனிது உகந்த காளாய்! என்றும்","kanRu mEyththu inidhu ugandha kALAy! enRum"],[2068,"பொங்கார் மெல்லிளம் கொங்கை பொன்னே பூப்பப்","ponggAr melliLam konggai ponnE pUppap"],[2069,"கார் வண்ணம் திருமேனி கண்ணும் வாயும்","kAr vaNNam thirumEni kaNNum vAyum"],[2070,"முற்றாரா வனமுலையாள் பாவை மாயன்","muRRArA vanamulaiyAL pAvai mAyan"],[2071,"தேர் ஆளும் வாள் அரக்கன் செல்வம் மாளத்","thEr ALum vAL arakkan selvam mALath"],[2072,"மை வண்ண நறுங்குஞ்சி குழல் பின் தாழ","mai vaNNa naRungkunjchi kuzhal pin thAzha"],[2073,"நைவளம் ஒன்று ஆராயா நம்மை நோக்கா","naivaLam onRu ArAyA nammai nOkkA"],[2074,"உள்ளூரும் சிந்தை நோய் எனக்கே தந்து என்","uLLUrum sindhai nOy enakkE thandhu en"],[2075,"இரு கையில் சங்கு இவை நில்லா எல்லே பாவம்!","iru kaiyil sanggu ivai nillA ellE pAvam!"],[2076,"மின் இலங்கு திருவுருவும் பெரிய தோளும்","miṉ ilaṅku tiruvuruvum pĕriya tol̤um"],[2077,"தே மருவு பொழில் இடத்து மலர்ந்த போதைத்","thE maruvu pozhil iDaththu malarndha pOdhaith"],[2078,"செங்கால மட நாராய்! இன்றே சென்று","sengkAla maDa nArAy! inRE senRu"],[2079,"தென் இலங்கை அரண் சிதறி அவுணன் மாளச்","then ilanggai araN sidhaRi avuNan mALach"],[2080,"அன்று ஆயர் குலமகளுக்கு அரையன் தன்னை","anRu Ayar kulamagaLukku araiyan thannai"],[2081,"மின்னு மாமழை தவழும் மேக வண்ணா!","minnu mAmazhai thavazhum mEga vaNNA!"],[2082,"வையம் தகளியா வார் கடலே நெய்யாக","vaiyam thagaLiyA vAr kaDalE neyyAga"],[2083,"என்று கடல் கடைந்தது? எவ்வுலகம் நீர் ஏற்றது?","enRu kaDal kaDaindhadhu? evvulagam nIr ERRadhu?"],[2084,"பார் அளவும் ஓர் அடி வைத்து ஓர் அடியும் பார் உடுத்த","pAr aLavum Or aDi vaiththu Or aDiyum pAr uDuththa"],[2085,"நெறி வாசல் தானேயாய் நின்றானை ஐந்து","neRi vAsal thAnEyAy ninRAnai aindhu"],[2086,"அரன் நாரணன் நாமம் ஆன்விடை புள் ஊர்தி","aran nAraNan nAmam AnviDai puL Urdhi"],[2087,"ஒன்றும் மறந்தறியேன் ஓத நீர் வண்ணனை நான்","onRum maRandhaRiyEn Odha nIr vaNNanai nAn"],[2088,"திசையும் திசை உறு தெய்வமும் தெய்வத்து","thisaiyum thisai uRu dheyvamum dheyvaththu"],[2089,"மயங்க வலம்புரி வாய் வைத்து வானத்து","mayangga valampuri vAy vaiththu vAnaththu"],[2090,"பொரு கோட்டு ஓர் ஏனமாய்ப் புக்கு இடந்தாய்க்கு அன்று உன்","pŏru koṭṭu or eṉamāyp pukku iṭantāykku aṉṟu uṉ"],[2091,"மண்ணும் மலையும் மறி கடலும் மாருதமும்","maNNum malaiyum maRi kaDalum mArudhamum"],[2092,"வாய் அவனை அல்லது வாழ்த்தாது கை உலகம்","vAy avanai alladhu vAzhththAdhu kai ulagam"],[2093,"செவி வாய் கண் மூக்கு உடல் என்று ஐம்புலனும் செந்தீ","cĕvi vāy kaṇ mūkku uṭal ĕṉṟu aimpulaṉum cĕntī"],[2094,"இயல்வாக ஈன் துழாயான் அடிக்கே செல்ல","iyalvAga In thuzhAyAn aDikkE sella"],[2095,"அவர் அவர் தாம் தாம் அறிந்தவாறு ஏத்தி","avar avar thAm thAm aRindhavARu Eththi"],[2096,"முதல் ஆவார் மூவரே அம்மூவர் உள்ளும்","mudhal AvAr mUvarE ammUvar uLLum"],[2097,"பழுதே பல பகலும் போயின என்று அஞ்சி","pazhudhE pala pagalum pOyina enRu anjchi"],[2098,"அடியும் படி கடப்பத் தோள் திசை மேல் செல்ல","aDiyum paDi kaDappath thOL thisai mEl sella"],[2099,"நான்ற முலைத் தலை நஞ்சுண்டு உறி வெண்ணெய்","nAnRa mulaith thalai nanjchuNDu uRi veNNey"],[2100,"மாலும் கருங்கடலே! என் நோற்றாய்? வையகம் உண்டு","mAlum karungkaDalE! en nORRAy? vaiyagam uNDu"],[2101,"பெற்றார் தளை கழலப் பேர்ந்தோர் குறள் உருவாய்","peRRAr thaLai kazhalap pErndhOr kuRaL uruvAy"],[2102,"நின்று நிலம் அங்கை நீர் ஏற்று மூவடியால்","ninRu nilam angkai nIr ERRu mUvaDiyAl"],[2103,"அறியும் உலகெல்லாம் யானேயும் அல்லேன்","aRiyum ulagellAm yAnEyum allEn"],[2104,"தழும்பிருந்த சார்ங்க நாண் தோய்ந்தவாம் அங்கை","thazhumbirundha sArngga nAN thOyndhavAm angkai"],[2105,"விரலோடு வாய் தோய்ந்த வெண்ணெய் கண்டு ஆய்ச்சி","viralODu vAy thOyndha veNNey kaNDu Aychchi"],[2106,"உரை மேல் கொண்டு என் உள்ளம் ஓவாது எப்போதும்","urai mEl koNDu en uLLam OvAdhu eppOdhum"],[2107,"எழுவார் விடை கொள்வார் ஈன் துழாயானை","ezhuvAr viDai koLvAr In thuzhAyAnai"],[2108,"மலையால் குடை கவித்து மா வாய் பிளந்து","malaiyAl kuDai kaviththu mA vAy piLandhu"],[2109,"கைய வலம்புரியும் நேமியும் கார் வண்ணத்து","kaiya valampuriyum nEmiyum kAr vaNNaththu"],[2110,"இறையும் நிலனும் இருவிசும்பும் காற்றும்","iRaiyum nilanum iruvisumbum kARRum"],[2111,"தெளிதாக உள்ளத்தைச் செந்நிறீஇ ஞானத்","theLidhAga uLLaththaich chenniRIi njAnath"],[2112,"புரி ஒரு கை பற்றி ஓர் பொன் ஆழி ஏந்தி","puri oru kai paRRi Or pon Azhi Endhi"],[2113,"இமையாத கண்ணால் இருள் அகல நோக்கி","imaiyAdha kaNNAl iruL agala nOkki"],[2114,"நகரம் அருள் புரிந்து நான்முகற்குப் பூ மேல்","nagaram aruL purindhu nAnmugaRkup pU mEl"],[2115,"என் ஒருவர் மெய் என்பர் ஏழ் உலகுண்டு ஆலிலையில்","en oruvar mey enbar Ezh ulaguNDu Alilaiyil"],[2116,"ஆறிய அன்பில் அடியார் தம் ஆர்வத்தால்","ARiya anbil aDiyAr tham ArvaththAl"],[2117,"முரணை வலி தொலைதற்கு ஆம் என்றே முன்னம்","muraNai vali tholaidhaRku Am enRE munnam"],[2118,"வகை அறு நுண் கேள்வி வாய்வார்கள் நாளும்","vagai aRu nuN kELvi vAyvArgaL nALum"],[2119,"ஊரும் வரி அரவம் ஒண் குறவர் மால் யானை","Urum vari aravam oN kuRavar mAl yAnai"],[2120,"இடந்தது பூமி எடுத்தது குன்றம்","iDandhadhu bUmi eDuththadhu kunRam"],[2121,"பெரு வில் பகழிக் குறவர் கைச் செந்தீ","peru vil pagazhik kuRavar kaich chenthI"],[2122,"குன்றனைய குற்றம் செயினும் குணம் கொள்ளும்","kunRanaiya kuRRam seyinum guNam koLLum"],[2123,"திருமகளும் மண்மகளும் ஆய்மகளும் சேர்ந்தால்","thirumagaLum maNmagaLum AymagaLum sErndhAl"],[2124,"மன மாசு தீரும் அரு வினையும் சாரா","maṉa mācu tīrum aru viṉaiyum cārā"],[2125,"தமர் உகந்தது எவ்வுருவம் அவ்வுருவம் தானே","thamar ugandhadhu evvuruvam avvuruvam thAnE"],[2126,"ஆமே அமரர்க்கு அறிய? அது நிற்க","AmE amararkku aRiya? adhu niRka"],[2127,"பண் புரிந்த நான்மறையோன் சென்னிப் பலி ஏற்ற","paN purindha nAnmaRaiyOn sennip pali ERRa"],[2128,"வாரி சுருக்கி மதக் களிறு ஐந்தினையும்","vāri curukki matak kal̤iṟu aintiṉaiyum"],[2129,"கழல் ஒன்றெடுத்து ஒரு கை சுற்றி ஓர் கை மேல்","kazhal onReDuththu oru kai suRRi Or kai mEl"],[2130,"மகிழ் அலகொன்றே போல் மாறும் பல் யாக்கை","magizh alagonRE pOl mARum pal yAkkai"],[2131,"அரிய புலன் ஐந்தடக்கி ஆய்மலர் கொண்டு ஆர்வம்","ariya pulan aindhaDakki Aymalar koNDu Arvam"],[2132,"எளிதில் இரண்டடியும் காண்பதற்கு என் உள்ளம்","eLidhil iraNDuaDiyum kANbadhaRku en uLLam"],[2133,"எண்மர் பதினொருவர் ஈரறுவர் ஓரிருவர்","eNmar padhinoruvar IraRuvar Oriruvar"],[2134,"சென்றால் குடை ஆம் இருந்தால் சிங்காசனம் ஆம்","cĕṉṟāl kuṭai ām iruntāl ciṅkācaṉam ām"],[2135,"அரவம் அடல் வேழம் ஆன் குருந்தம் புள் வாய்","aravam aDal vEzham An kurundham puL vAy"],[2136,"அவன் தமர் எவ்வினையர் ஆகிலும் எங்கோன்","avan thamar evvinaiyar Agilum engkOn"],[2137,"பேரே வரப் பிதற்றல் அல்லால் என் பெம்மானை","pere varap pitaṟṟal allāl ĕṉ pĕmmāṉai"],[2138,"அயல் நின்ற வல் வினையை அஞ்சினேன் அஞ்சி","ayal niṉṟa val viṉaiyai añciṉeṉ añci"],[2139,"தொழுது மலர் கொண்டு தூபம் கை ஏந்தி","thozhudhu malar koNDu thUbam kai Endhi"],[2140,"அடைந்த அருவினையோடு அல்லல் நோய் பாவம்","aDaindha aruvinaiyODu allal nOy pAvam"],[2141,"சரணா மறை பயந்த தாமரையானோடு","saraNA maRai payandha thAmaraiyAnODu"],[2142,"உலகும் உலகிறந்த ஊழியும் ஒண்கேழ்","ulagum ulagiRandha Uzhiyum oNkEzh"],[2143,"புணர் மருதின் ஊடு போய்ப் பூங்குருந்தம் சாய்த்து","puNar marudhin UDu pOyp pUngkurundham sAyththu"],[2144,"தோள் அவனை அல்லால் தொழா என் செவி இரண்டும்","thOL avanai allAl thozhA en sevi iraNDum"],[2145,"நயவேன் பிறர் பொருளை நள்ளேன் கீழாரோடு","nayavEn piRar poruLai naLLEn kIzhArODu"],[2146,"வினையால் அடர்ப்படார் வெந்நரகில் சேரார்","vinaiyAl aDarppaDAr vennaragil sErAr"],[2147,"காலை எழுந்து உலகம் கற்பனவும் கற்றுணர்ந்த","kAlai ezhundhu ulagam kaRpanavum kaRRuNarndha"],[2148,"பெயரும் கருங்கடலே நோக்கும் ஆறு ஒண்பூ","peyarum karungkaDalE nOkkum ARu oNpU"],[2149,"உணர்வார் ஆர் உன் பெருமை? ஊழி தோறூழி","uNarvAr Ar un perumai? Uzhi thORUzhi"],[2150,"பாலன் தனது உருவாய் ஏழுலகுண்டு ஆலிலையின்","pAlan thanadhu uruvAy EzhulaguNDu Alilaiyin"],[2151,"சொல்லுந்தனையும் தொழுமின் விழும் உடம்பு","sollunthanaiyum thozhumin vizhum uDambu"],[2152,"நன்று பிணி மூப்புக் கை அகற்றி நான்கூழி","nanRu piNi mUppuk kai agaRRi nAnkUzhi"],[2153,"அன்பாழியானை அணுகென்னும் நா அவன் தன்","anbAzhiyAnai aNugennum nA avan than"],[2154,"புகழ்வாய் பழிப்பாய் நீ பூந்துழாயானை","pugazhvAy pazhippAy nI pUnthuzhAyAnai"],[2155,"ஏற்றான் புள் ஊர்ந்தான் எயில் எரித்தான் மார்விடந்தான்","ERRAn puL UrndhAn eyil eriththAn mArviDandhAn"],[2156,"காப்பு உன்னை உன்னக் கழியும் அருவினைகள்","kAppu unnai unnak kazhiyum aruvinaigaL"],[2157,"வழி நின்று நின்னைத் தொழுவார் வழுவா","vazhi ninRu ninnaith thozhuvAr vazhuvA"],[2158,"வேங்கடமும் விண்ணகரும் வெஃகாவும் அஃகாத","vEngkaDamum viNNagarum veqkAvum aqkAtha"],[2159,"இடர் ஆர் படுவார்? எழு நெஞ்சே வேழம்","iDar Ar paDuvAr? ezhu nenjchE vEzham"],[2160,"கொண்டானை அல்லால் கொடுத்தாரை யார் பழிப்பார்?","koNDAnai allAl koDuththArai yAr pazhippAr?"],[2161,"அடுத்த கடும் பகைஞற்கு ஆற்றேன் என்றோடி","aDuththa kaDum pagainjaRku ARREn enRODi"],[2162,"ஆள் அமர் வென்றி அடுகளத்துள் அஞ்ஞான்று","AL amar venRi aDukaLaththuL anjnjAnRu"],[2163,"படை ஆரும் வாட்கண்ணார் பாரசி நாள் பைம்பூந்","paDai Arum vATkaNNAr pArasi nAL paimpUn"],[2164,"வரை குடை தோள் காம்பாக ஆநிரை காத்து ஆயர்","varai kuDai thOL kAmbAga Anirai kAththu Ayar"],[2165,"பிரான்! உன் பெருமை பிறர் ஆர் அறிவார்?","pirAn! un perumai piRar Ar aRivAr?"],[2166,"படி கண்டறிதியே? பாம்பணையினான் புள்","paDi kaNDaRidhiyE? pAmbaNaiyinAn puL"],[2167,"நீயும் திருமகளும் நின்றாயால் குன்றெடுத்துப்","nIyum thirumagaLum ninRAyAl kunReDuththup"],[2168,"இனி ஆர் புகுவார் எழு நரக வாசல்?","ini Ar puguvAr ezhu naraga vAsal?"],[2169,"நாடிலும் நின் அடியே நாடுவன் நாள் தோறும்","nADilum nin aDiyE nADuvan nAL thORum"],[2170,"எனக்காவார் ஆர் ஒருவரே! எம்பெருமான்","enakkAvAr Ar oruvarE! emperumAn"],[2171,"வரத்தால் வலி நினைந்து மாதவ! நின் பாதம்","varaththAl vali ninaindhu mAdhava! nin pAdham"],[2172,"ஊனக் குரம்பையின் உள் புக்கு இருள் நீக்கி","Unak kurambaiyin uL pukku iruL nIkki"],[2173,"வானாகித் தீயாய் மறிகடலாய் மாருதமாய்","vAnAgith thIyAy maRikaDalAy mArudhamAy"],[2174,"வயிறு அழல வாள் உருவி வந்தானை அஞ்ச","vayiṟu azhala vāl̤ uruvi vantāṉai añca"],[2175,"செற்றெழுந்து தீ விழித்துச் சென்ற இந்த ஏழுலகும்","seRRezhundhu thI vizhiththuch chenRa indha Ezhulagum"],[2176,"நா வாயில் உண்டே நமோ நாரணா என்று","nA vAyil uNDE namO nAraNA enRu"],[2177,"திறம்பாது என் நெஞ்சமே! செங்கண் மால் கண்டாய்","thiRambAdhu en nenjchamE! sengkaN mAl kaNDAy"],[2178,"பிடி சேர் களிறளித்த பேராளா! உன்தன்","piDi sEr kaLiRaLiththa pErALA! undhan"],[2179,"பொன் திகழும் மேனிப் புரி சடை அம் புண்ணியனும்","pŏṉ tikazhum meṉip puri caṭai am puṇṇiyaṉum"],[2180,"உளன் கண்டாய் நன்னெஞ்சே! உத்தமன் என்றும்","uLan kaNDAy nannenjchE! uththaman enRum"],[2181,"ஓரடியும் சாடுதைத்த ஒண்மலர்ச் சேவடியும்","OraDiyum sADudhaiththa oNmalarch sEvaDiyum"],[2182,"அன்பே தகளியா ஆர்வமே நெய் ஆக","anbE thagaLiyA ArvamE ney Aga"],[2183,"ஞானத்தால் நன்குணர்ந்து நாரணன் தன் நாமங்கள்","njAnaththAl nankuNarndhu nAraNan than nAmanggaL"],[2184,"பரிசு நறுமலரால் பாற்கடலான் பாதம்","parisu naRumalarAl pARkaDalAn pAdham"],[2185,"நகர் இழைத்து நித்திலத்து நாண்மலர் கொண்டு ஆங்கே","nagar izhaiththu niththilaththu nANmalar koNDu AnggE"],[2186,"அடி மூன்றில் இவ்வுலகம் அன்று அளந்தாய் போலும்","aDi mUnRil ivvulagam anRu aLandhAy pOlum"],[2187,"அறிந்தைந்தும் உள் அடக்கி ஆய்மலர் கொண்டு ஆர்வம்","aRindhu aindhum uL aDakki Aymalar koNDu Arvam"],[2188,"கழல் எடுத்து வாய் மடித்துக் கண் சுழன்று மாற்றார்","kazhal ĕṭuttu vāy maṭittuk kaṇ cuzhaṉṟu māṟṟār"],[2189,"உகந்து உன்னை வாங்கி ஒளி நிறங்கொள் கொங்கை","ugandhu unnai vAnggi oLi niRangkoL konggai"],[2190,"அன்று அது கண்டு அஞ்சாத ஆய்ச்சி உனக்கு இரங்கி","anRu adhu kaNDu anjchAdha Aychchi unakku iranggi"],[2191,"பேர்த்தனை மா சகடம் பிள்ளையாய் மண் இரந்து","pErththanai mA sagaDam piLLaiyAy maN irandhu"],[2192,"கடை நின்று அமரர் கழல் தொழுது நாளும்","kaDai ninRu amarar kazhal thozhudhu nALum"],[2193,"அவர் இவர் என்றில்லை அரவணையான் பாதம்","avar ivar enRillai aravaNaiyAn pAdham"],[2194,"தொடர் எடுத்த மால் யானை சூழ் கயம் புக்கஞ்சி","thoDar eDuththa mAl yAnai sUzh kayam pukkanjchi"],[2195,"பண்டு இப்பெரும் பதியை ஆக்கி பழி பாவம்","paNDu ipperum padhiyai Akki pazhi pAvam"],[2196,"திரிந்தது வெஞ்சமத்துத் தேர் கடவி அன்று","thirindhadhu venjchamaththuth thEr kaDavi anRu"],[2197,"தனக்கடிமை பட்டது தான் அறியானேலும்","thanakkaDimai paTTadhu thAn aRiyAnElum"],[2198,"மற்றார் இயல் ஆவர்? வானவர் கோன் மாமலரோன்","maRRAr iyal Avar? vAnavar kOn mAmalarOn"],[2199,"கொண்டது உலகம் குறள் உருவாய்க் கோள் அரியாய்","koNDadhu ulagam kuRaL uruvAyk kOL ariyAy"],[2200,"வழக்கன்று கண்டாய் வலி சகடம் செற்றாய்","vazhakkanRu kaNDAy vali sagaDam seRRAy"],[2201,"பழி பாவம் கை அகற்றிப் பல்காலும் நின்னை","pazhi pAvam kai agaRRip palkAlum ninnai"],[2202,"தாம் உளரே தம் உள்ளம் உள் உளதே தாமரையின்","thAm uLarE tham uLLam uL uLadhE thAmaraiyin"],[2203,"அரியது எளிதாகும் ஆற்றலால் மாற்றி","ariyadhu eLidhAgum ARRalAl mARRi"],[2204,"தாழ்ந்து வரம் கொண்டு தக்க வகைகளால்","thAzhndhu varam koNDu thakka vagaigaLAl"],[2205,"அவன் கண்டாய் நன்னெஞ்சே! ஆர் அருளும் கேடும்","avan kaNDAy nannenjchE! Ar aruLum kEDum"],[2206,"சென்றது இலங்கை மேல் செவ்வே தன் சீற்றத்தால்","senRadhu ilanggai mEl sevvE than sIRRaththAl"],[2207,"வந்தித்து அவனை வழி நின்ற ஐம்பூதம்","vandhiththavanai vazhi ninRa aimpUdham"],[2208,"பதி அமைந்து நாடிப் பருத்தெழுந்த சிந்தை","padhi amaindhu nADip paruththezhundha sindhai"],[2209,"மனத்துள்ளான் வேங்கடத்தான் மா கடலான் மற்றும்","manaththuLLAn vEngkaDaththAn mA kaDalAn maRRum"],[2210,"மகன் ஆகக் கொண்டெடுத்தாள் மாண்பாய கொங்கை","magan Agak koNDeDuththAL mANbAya konggai"],[2211,"நீ அன்று உலகு அளந்தாய் நீண்ட திருமாலே!","nī aṉṟu ulaku al̤antāy nīṇṭa tirumāle!"],[2212,"பிரான் என்று நாளும் பெரும் புலரி என்றும்","pirAn enRu nALum perum pulari enRum"],[2213,"மகிழ்ந்தது சிந்தை திருமாலே! மற்றும்","magizhndhadhu sindhai thirumAlE! maRRum"],[2214,"துணிந்தது சிந்தை துழாய் அலங்கல் அங்கம்","thuNindhadhu sindhai thuzhAy alanggal anggam"],[2215,"வகையால் அவனி இரந்து அளந்தாய் பாதம்","vagaiyAl avani irandhu aLandhAy pAdham"],[2216,"இனிதென்பர் காமம் அதனிலும் ஆற்ற","inidhenbar kAmam adhanilum ARRa"],[2217,"சிறியார் பெருமை சிறிதின் கண் எய்தும்","siRiyAr perumai siRidhin kaN eydhum"],[2218,"இருந்தண் கமலத்து இருமலரின் உள்ளே","irunthaN kamalaththu irumalarin uLLE"],[2219,"எமக்கென்று இரு நிதியம் ஏமாந்திராதே","emakkenRu iru nidhiyam EmAndhirAdhE"],[2220,"ஓத்தின் பொருள் முடிவும் இத்தனையே உத்தமன் பேர்","Oththin poruL muDivum iththanaiyE uththaman pEr"],[2221,"சுருக்காக வாங்கிச் சுலாவி நின்று ஐயார்","surukkAga vAnggich sulAvi ninRu aiyAr"],[2222,"பொருளால் அமர் உலகம் புக்கியலல் ஆகாது","poruLAl amar ulagam pukkiyalal AgAdhu"],[2223,"நினைப்பன் திருமாலை நீண்ட தோள் காண","ninaippan thirumAlai nINDa thOL kANa"],[2224,"தோள் இரண்டு எட்டேழும் மூன்றும் முடி அனைத்தும்","thOL iraNDu eTTEzhum mUnRum muDi anaiththum"],[2225,"சிறந்தார்க்கு எழு துணையாம் செங்கண் மால் நாமம்","siRandhArkku ezhu thuNaiyAm sengkaN mAl nAmam"],[2226,"உளதென்று இறுமாவார் உண்டில்லை என்று","uLadhenRu iRumAvAr uNDillai enRu"],[2227,"பயின்றது அரங்கம் திருக்கோட்டி பன்னாள்","payinRadhu aranggam thirukkOTTi pannAL"],[2228,"மாலை அரி உருவன் பாத மலர் அணிந்து","mAlai ari uruvan pAdha malar aNindhu"],[2229,"உணர்ந்தாய் மறை நான்கும் ஓதினாய் நீதி","uNarndhAy maRai nAnkum OdhinAy nIdhi"],[2230,"மலை ஏழும் மாநிலங்கள் ஏழும் அதிர","malai Ezhum mAnilanggaL Ezhum adhira"],[2231,"அழைப்பன் திருமாலை ஆங்கு அவர்கள் சொன்ன","azhaippan thirumAlai Anggu avargaL sonna"],[2232,"மதிக் கண்டாய் நெஞ்சே! மணிவண்ணன் பாதம்","madhik kaNDAy nenjchE! maNivaNNan pAdham"],[2233,"நிறம் கரியன் செய்ய நெடுமலராள் மார்வன்","niRam kariyan seyya neDumalarAL mArvan"],[2234,"நெறியார் குழல் கற்றை முன் நின்று பின் தாழ்ந்து","neRiyAr kuzhal kaRRai mun ninRu pin thAzhndhu"],[2235,"வெற்பென்று இருஞ்சோலை வேங்கடம் என்று இவ்விரண்டும்","veRpenRu irunjchOlai vEngkaDam enRu ivviraNDum"],[2236,"என்றும் மறந்தறியேன் ஏழ் பிறப்பும் எப்பொழுதும்","enRum maRandhaRiyEn Ezh piRappum eppozhudhum"],[2237,"காணக் கழி காதல் கைமிக்குக் காட்டினால்","kANak kazhi kAdhal kaimikkuk kATTinAl"],[2238,"திருமங்கை நின்றருளும் தெய்வம் நா வாழ்த்தும்","thirumanggai ninRaruLum dheyvam nA vAzhththum"],[2239,"நாம் பெற்ற நன்மையும் நா மங்கை நன்னெஞ்சத்து","nAm peRRa nanmaiyum nA manggai nannenjchaththu"],[2240,"அருள் புரிந்த சிந்தை அடியார் மேல் வைத்து","aruL purindha sindhai aDiyAr mEl vaiththu"],[2241,"ஓர் உருவன் அல்லை ஒளி உருவம் நின் உருவம்","Or uruvan allai oLi uruvam nin uruvam"],[2242,"நின்றதோர் பாதம் நிலம் புதைப்ப நீண்ட தோள்","ninRadhOr pAdham nilam pudhaippa nINDa thOL"],[2243,"பேறொன்று முன் அறியேன் பெற்றறியேன் பேதைமையால்","pERonRu mun aRiyEn peRRaRiyEn pEdhaimaiyAl"],[2244,"ஏறு ஏழும் வென்று அடர்த்த எந்தை எரி உருவத்து","eṟu ezhum vĕṉṟu aṭartta ĕntai ĕri uruvattu"],[2245,"கதையும் பெரும் பொருளும் கண்ணா ! நின் பேரே","kataiyum pĕrum pŏrul̤um kaṇṇā ! niṉ pere"],[2246,"பணிந்தேன் திருமேனி பைங்கமலம் கையால்","paNindhEn thirumEni paingkamalam kaiyAl"],[2247,"இது கண்டாய் நன்னெஞ்சே! இப்பிறவி ஆவது","idhu kaNDAy nannenjchE! ippiRavi Avadhu"],[2248,"கண்டேன் திருமேனி யான் கனவில் ஆங்கவன் கைக்","kaNDEn thirumEni yAn kanavil Anggavan kaik"],[2249,"வலி மிக்க வாள் எயிற்று வாள் அவுணர் மாள","vali mikka vāl̤ ĕyiṟṟu vāl̤ avuṇar māl̤a"],[2250,"கோவாகி மா நிலம் காத்து நங்கண் முகப்பே","kOvAgi mA nilam kAththu nangkaN mugappE"],[2251,"தமர் உள்ளம் தஞ்சை தலை அரங்கம் தண்கால்","thamar uLLam thanjchai thalai aranggam thaNkAl"],[2252,"இடங்கை வலம்புரி நின்று ஆர்ப்ப எரி கான்று","iDanggai valampuri ninRu Arppa eri kAnRu"],[2253,"போதறிந்து வானரங்கள் பூஞ்சுனை புக்கு ஆங்கலர்ந்த","pOdhaRindhu vAnaranggaL pUnjchunai pukku Anggalarndha"],[2254,"ஆய்ந்துரைப்பன் ஆயிரம் பேர் ஆதி நடு அந்திவாய்","Ayndhuraippan Ayiram pEr Adhi naDu andhivAy"],[2255,"யானே தவம் செய்தேன் ஏழ் பிறப்பும் எப்பொழுதும்","yAnE thavam seydhEn Ezh piRappum eppozhudhum"],[2256,"பெருகு மத வேழம் மாப்பிடிக்கு முன் நின்று","perugu madha vEzham mAppiDikku mun ninRu"],[2257,"வரைச் சந்தனக் குழம்பும் வான் கலனும் பட்டும்","varaich chandhanak kuzhambum vAn kalanum paTTum"],[2258,"உறும் கண்டாய் நல் நெஞ்சே ! உத்தமன் நல் பாதம்","uṟum kaṇṭāy nal nĕñce ! uttamaṉ nal pātam"],[2259,"தவம் செய்து நான் முகனே பெற்றான் தரணி","tavam cĕytu nāṉ mukaṉe pĕṟṟāṉ taraṇi"],[2260,"பின் நின்று தாய் இரப்பக் கேளான் பெரும் பணைத்தோள்","pin ninRu thAy irappak kELAn perum paNaiththOL"],[2261,"நேர்ந்தேன் அடிமை நினைந்தேன் அதொண்கமலம்","nErndhEn aDimai ninaindhEn adhoNkamalam"],[2262,"பகல் கண்டேன் நாரணனைக் கண்டேன் கனவில்","pakal kaṇṭeṉ nāraṇaṉaik kaṇṭeṉ kaṉavil"],[2263,"வடிக் கோல வாள் நெடுங்கண் மா மலராள் செவ்விப்","vaDik kOla vAL neDungkaN mA malarAL sevvip"],[2264,"குறை ஆக வெஞ்சொற்கள் கூறினேன் கூறி","kuRai Aga venjchoRkaL kURinEn kURi"],[2265,"வரம் கருதித் தன்னை வணங்காத வன்மை","varam karudhith thannai vaNanggAdha vanmai"],[2266,"அமுது என்றும் தேன் என்றும் ஆழியான் என்றும்","amudhu enRum thEn enRum AzhiyAn enRum"],[2267,"நவின்றுரைத்த நாவலர்கள் நாண்மலர் கொண்டு ஆங்கே","navinRuraiththa nAvalargaL nANmalar koNDu AnggE"],[2268,"இன்றா அறிகின்றேன் அல்லேன் இருநிலத்தைச்","inRA aRiginREn allEn irunilaththaich"],[2269,"திறம்பிற்று இனி அறிந்தேன் தென்னரங்கத்து எந்தை","thiRambiRRu ini aRindhEn thennaranggaththu endhai"],[2270,"கதவிக் கதம் சிறந்த கஞ்சனை முன் காய்ந்து","kadhavik kadham siRandha kanjchanai mun kAyndhu"],[2271,"மண்ணுலகம் ஆளேனே ? வானவர்க்கும் வானவனாய்","maṇṇulakam āl̤eṉe ? vāṉavarkkum vāṉavaṉāy"],[2272,"பின்னால் அரு நரகம் சேராமல் பேதுறுவீர்","piṉṉāl aru narakam cerāmal petuṟuvīr"],[2273,"அடியால் முன் கஞ்சனைச் செற்று அமரர் ஏத்தும்","aDiyAl mun kanjchanaich seRRu amarar Eththum"],[2274,"கடிது கொடு நரகம் பிற்காலும் செய்கை","kaDidhu koDu naragam piRkAlum seygai"],[2275,"உற்று வணங்கித் தொழுமின் உலகேழும்","uRRu vaNanggith thozhumin ulagEzhum"],[2276,"என்னெஞ்ச மேயான் என் சென்னியான் தானவனை","ennenjcha mEyAn en senniyAn dhAnavanai"],[2277,"அத்தியூரான் புள்ளை ஊர்வான் அணிமணியின்","aththiyUrAn puLLai UrvAn aNimaNiyin"],[2278,"எங்கள் பெருமான்! இமையோர் தலைமகன்! நீ","enggaL perumAn! imaiyOr thalaimagan! nI"],[2279,"கொண்டு வளர்க்கக் குழவியாய்த் தான் வளர்ந்தது","koNDu vaLarkkak kuzhaviyAyth thAn vaLarndhadhu"],[2280,"இறை எம்பெருமான்! அருள் என்று இமையோர்","iRai emperumAn! aruL enRu imaiyOr"],[2281,"மாலே! நெடியோனே! கண்ணனே! விண்ணவர்க்கு","mAlE! neDiyOnE! kaNNanE! viNNavarkku"],[2282,"திருக் கண்டேன் பொன் மேனி கண்டேன் திகழும்","thiruk kaNDEn pon mEni kaNDEn thigazhum"],[2283,"இன்றே கழல் கண்டேன் ஏழ் பிறப்பும் யான் அறுத்தேன்","inRE kazhal kaNDEn Ezh piRappum yAn aRuththEn"],[2284,"மனத்துள்ளான் மாகடல் நீர் உள்ளான் மலராள்","manaththuLLAn mAkaDal nIr uLLAn malarAL"],[2285,"மருந்தும் பொருளும் அமுதமும் தானே","maruntum pŏrul̤um amutamum tāṉe"],[2286,"அடி வண்ணம் தாமரை அன்று உலகம் தாயோன்","aDi vaNNam thAmarai anRu ulagam thAyOn"],[2287,"அழகன்றே ஆழியாற்கு ஆழி நீர் வண்ணம்","azhaganRE AzhiyARku Azhi nIr vaNNam"],[2288,"கழல் தொழுதும் வா நெஞ்சே! கார்க்கடல் நீர் வேலை","kazhal thozhudhum vA nenjchE! kArkkaDal nIr vElai"],[2289,"நாமம் பல சொல்லி நாராயணா என்று","nāmam pala cŏlli nārāyaṇā ĕṉṟu"],[2290,"கண்ணும் கமலம் கமலமே கைத்தலமும்","kaNNum kamalam kamalamE kaiththalamum"],[2291,"தேசும் திறலும் திருவும் உருவமும்","thEsum thiRalum thiruvum uruvamum"],[2292,"நன்கோதும் நால் வேதத்துள்ளான் நறவிரியும்","nankOdhum nAl vEdhaththuLLAn naRaviriyum"],[2293,"அறிவென்னும் தாள் கொளுவி ஐம்புலனும் தம்மில்","aRivennum thAL koLuvi aimpulanum thammil"],[2294,"படி வட்டத் தாமரை பண்டு உலகம் நீர் ஏற்று","paDi vaTTath thAmarai paNDu ulagam nIr ERRu"],[2295,"மாற்பால் மனம் சுழிப்ப மங்கையர் தோள் கை விட்டு","mARpAl manam suzhippa manggaiyar thOL kai viTTu"],[2296,"பணிந்து உயர்ந்த பௌவப் படுதிரைகள் மோத","paNindhu uyarndha pauvap paDuthiraigaL mOdha"],[2297,"வந்துதைத்த வெண்திரைகள் செம்பவள வெண்முத்தம்","vandhudhaiththa veNthiraigaL sempavaLa veNmuththam"],[2298,"சென்ற நாள் செல்லாத செங்கண் மால் எங்கள் மால்","senRa nAL sellAdha sengkaN mAl enggaL mAl"],[2299,"வாய் மொழிந்து வாமனனாய் மாவலி பால் மூவடி மண்","vAy mozhindhu vAmananAy mAvali pAl mUvaDi maN"],[2300,"அருளாது ஒழியுமே? ஆலிலை மேல் அன்று","aruLAdhu ozhiyumE? Alilai mEl anRu"],[2301,"முன் உலகம் உண்டு உமிழ்ந்தாய்க்கு அவ்வுலகம் ஈரடியால்","mun ulagam uNDu umizhndhAykku avvulagam IraDiyAl"],[2302,"பேசுவார் எவ்வளவு பேசுவர் அவ்வளவே","pEsuvAr evvaLavu pEsuvar avvaLavE"],[2303,"வடிவார் முடி கோட்டி வானவர்கள் நாளும்","vaDivAr muDi kOTTi vAnavargaL nALum"],[2304,"விரும்பி விண் மண் அளந்த அஞ்சிறைய வண் தார்","virumbi viN maN aLandha anjchiRaiya vaN thAr"],[2305,"வருங்கால் இருநிலனும் மால் விசும்பும் காற்றும்","varungkAl irunilanum mAl visumbum kARRum"],[2306,"தொழுதால் பழுதுண்டே? தூ நீர் உலகம்","thozhudhAl pazhudhuNDE? thU nIr ulagam"],[2307,"சிறந்த என் சிந்தையும் செங்கண் அரவும்","siRandha en sindhaiyum sengkaN aravum"],[2308,"ஆரே துயர் உழந்தார் துன்புற்றார் ஆண்டையார்?","ArE thuyar uzhandhAr thunbuRRAr ANDaiyAr?"],[2309,"அடைந்தது அரவணை மேல் ஐவர்க்காய் அன்று","aDaindhadhu aravaNai mEl aivarkkAy anRu"],[2310,"பேய்ச்சி பால் உண்ட பெருமானைப் பேர்ந்தெடுத்து","pEychchi pAl uNDa perumAnaip pErndheDuththu"],[2311,"சேர்ந்த திருமால் கடல் குடந்தை வேங்கடம்","sErndha thirumAl kaDal kuDandhai vEngkaDam"],[2312,"இவை அவன் கோயில் இரணியனது ஆகம்","ivai avan kOyil iraNiyanadhu Agam"],[2313,"பாற்கடலும் வேங்கடமும் பாம்பும் பனி விசும்பும்","pARkaDalum vEngkaDamum pAmbum pani visumbum"],[2314,"பாலகனாய் ஆலிலை மேல் பைய உலகெல்லாம்","pAlaganAy Alilai mEl paiya ulagellAm"],[2315,"அன்று இவ்வுலகம் அளந்த அசவே கொல்?","anRu ivvulagam aLandha asavE kol?"],[2316,"காண் காண் என விரும்பும் கண்கள் கதிர் இலகு","kAN kAN ena virumbum kaNgaL kadhir ilagu"],[2317,"கைய கனல் ஆழி கார்க்கடல்வாய் வெண்சங்கம்","kaiya kanal Azhi kArkkaDalvAy veNsanggam"],[2318,"அவற்கு அடிமைப் பட்டேன் அகத்தான் புறத்தான்","avaRku aDimaip paTTEn agaththAn puRaththAn"],[2319,"தானே தனக்கு உவமன் தன் உருவே எவ்வுருவும்","thAnE thanakku uvaman than uruvE evvuruvum"],[2320,"இறையாய் நிலனாகி எண்திசையும் தானாய்","iRaiyAy nilanAgi eNthisaiyum thAnAy"],[2321,"உளன் கண்டாய் நன்னெஞ்சே! உத்தமன் என்றும்","uLan kaNDAy nannenjchE! uththaman enRum"],[2322,"மன்னு மணி முடி நீண்டு அண்டம் போய் எண்திசையும்","mannu maNi muDi nINDu aNDam pOy eNthisaiyum"],[2323,"கோவலனாய் ஆநிரைகள் மேய்த்துக் குழல் ஊதி","kOvalanAy AniraigaL mEyththuk kuzhal Udhi"],[2324,"சின மா மத களிற்றின் திண்மருப்பைச் சாய்த்து","sina mA madha kaLiRRin thiNmaruppaich sAyththu"],[2325,"உலகமும் ஊழியும் ஆழியும் ஒண்கேழ்","ulagamum Uzhiyum Azhiyum oNkEzh"],[2326,"புரிந்து மத வேழம் மாப் பிடியோடு ஊடி","purindhu madha vEzham mAp piDiyODu UDi"],[2327,"மலை முகடு மேல் வைத்து வாசுகியைச் சுற்றி","malai mugaDu mEl vaiththu vAsugiyaich suRRi"],[2328,"நின்ற பெருமானே! நீர் ஏற்று உலகெல்லாம்","ninRa perumAnE! nIr ERRu ulagellAm"],[2329,"நீ அன்றே நீர் ஏற்று உலகம் அடி அளந்தாய்?","nI anRE nIr ERRu ulagam aDi aLandhAy?"],[2330,"செற்றதுவும் சேரா இரணியனை சென்றேற்றுப்","seRRadhuvum sErA iraNiyanai senRERRup"],[2331,"சூழ்ந்த துழாய் அலங்கல் சோதி மணி முடி மால்","sUzhndha thuzhAy alanggal sOdhi maNi muDi mAl"],[2332,"அவனே அருவரையால் ஆநிரைகள் காத்தான்","avanE aruvaraiyAl AniraigaL kAththAn"],[2333,"எய்தான் மராமரம் ஏழும் இராமனாய்","eydhAn marAmaram Ezhum irAmanAy"],[2334,"முயன்று தொழு நெஞ்சே! மூரி நீர் வேலை","muyanRu thozhu nenjchE! mUri nIr vElai"],[2335,"தாளால் சகடம் உதைத்துப் பகடுந்தி","thALAl sagaDam udhaiththup pagaDundhi"],[2336,"பெரிய வரை மார்பில் பேர் ஆரம் பூண்டு","pĕriya varai mārpil per āram pūṇṭu"],[2337,"நிறம் வெளிது செய்து பசிது கரிதென்று","niRam veLidhu seydhu pasidhu karidhenRu"],[2338,"பொலிந்திருண்ட கார் வானில் மின்னே போல் தோன்றி","polindhu iruNDa kAr vAnil minnE pOl thOnRi"],[2339,"தெளிந்த சிலாதலத்தின் மேல் இருந்த மந்தி","theLindha silAdhalaththin mEl irundha mandhi"],[2340,"வாழும் வகை அறிந்தேன் மை போல் நெடுவரைவாய்","vAzhum vagai aRindhEn mai pOl neDuvaraivAy"],[2341,"பெற்றம் பிணை மருதம் பேய் முலை மாச் சகடம்","peRRam piNai marudham pEy mulai mAch chagaDam"],[2342,"பண்டெல்லாம் வேங்கடம் பாற்கடல் வைகுந்தம்","paNDellAm vEngkaDam pARkaDal vaikuntham"],[2343,"விண்ணகரம் வெஃகா விரி திரை நீர் வேங்கடம்","viṇṇakaram vĕḵkā viri tirai nīr veṅkaṭam"],[2344,"தாழ் சடையும் நீள் முடியும் ஒண் மழுவும் சக்கரமும்","thAzh saDaiyum nIL muDiyum oN mazhuvum chakkaramum"],[2345,"இசைந்த அரவமும் வெற்பும் கடலும்","isaindha aravamum veRpum kaDalum"],[2346,"அங்கற்கிடர் இன்றி அந்திப் பொழுதத்து","anggaRkiDar inRi andhip pozhudhaththu"],[2347,"காய்ந்திருளை மாற்றிக் கதிர் இலகு மா மணிகள்","kAyndhiruLai mARRik kadhir ilagu mA maNigaL"],[2348,"ஆங்கு மலரும் குவியு மால் உந்தி வாய்","Anggu malarum kuviyu mAl undhi vAy"],[2349,"பார்த்த கடுவன் சுனை நீர் நிழல் கண்டு","pArththa kaDuvan sunai nIr nizhal kaNDu"],[2350,"வெற்பென்று வேங்கடம் பாடும் வியன் துழாய்","veRpenRu vEngkaDam pADum viyan thuzhAy"],[2351,"புகு மதத்தால் வாய் பூசிக் கீழ் தாழ்ந்து அருவி","pugu madhaththAl vAy pUsik kIzh thAzhndhu aruvi"],[2352,"களிறு முகில் குத்தக் கை எடுத்தோடி","kaLiRu mugil kuththak kai eDuththODi"],[2353,"குன்று ஒன்றினாய குற மகளிர் கோல் வளைக் கை","kunRu onRinAya kuRa magaLir kOl vaLaik kai"],[2354,"இடம் வலம் ஏழ் பூண்ட இரவித் தேர் ஓட்டி","iDam valam Ezh pUNDa iravith thEr OTTi"],[2355,"நலமே வலிது கொல்? நஞ்சூட்டு வன்பேய்","nalamE validhu kol? nanjchUTTu vanpEy"],[2356,"சார்ந்தகடு தேய்ப்பத் தடாவிய கோட்டுச்சி வாய்","sArndhagaDu thEyppath thaDAviya kOTTuchchi vAy"],[2357,"பொருப்பிடையே நின்றும் புனல் குளித்தும் ஐந்து","poruppiDaiyE ninRum punal kuLiththum aindhu"],[2358,"ஆய்ந்த அருமறையோன் நான்முகத்தோன் நன்குறங்கில்","Ayndha arumaRaiyOn nAnmugaththOn nankuRanggil"],[2359,"அரணாம் நமக்கு என்றும் ஆழி வலவன்","araNAm namakku enRum Azhi valavan"],[2360,"ஓர்த்த மனத்தராய் ஐந்தடக்கி ஆராய்ந்து","Orththa manaththarAy aindhaDakki ArAyndhu"],[2361,"நின்று எதிராய நிரை மணித் தேர் வாணன் தோள்","ninRu edhirAya nirai maNith thEr vANan thOL"],[2362,"நெஞ்சால் நினைப்பரியனேலும் நிலைப் பெற்றென்","nenjchAl ninaippariyanElum nilaip peRRen"],[2363,"உணரில் உணர்வரியன் உள்ளம் புகுந்து","uNaril uNarvariyan uLLam pugundhu"],[2364,"இனி அவன் மாயன் என உரைப்பரேலும்","ini avan mAyan ena uraipparElum"],[2365,"உளன் ஆய நான்மறையின் உட்பொருளை உள்ளத்து","uLan Aya nAnmaRaiyin uTporuLai uLLaththu"],[2366,"கவியினார் கை புனைந்து கண்ணார் கழல் போய்","kaviyinAr kai punaindhu kaNNAr kazhal pOy"],[2367,"எழில் கொண்டு மின்னுக் கொடி எடுத்து வேகத்","ezhil koNDu minnuk koDi eDuththu vEgath"],[2368,"கலந்து மணி இமைக்கும் கண்ணா! நின் மேனி","kalandhu maNi imaikkum kaNNA! nin mEni"],[2369,"அது நன்று இது தீதென்று ஐயப் படாதே","adhu nanRu idhu thIdhenRu aiyap paDAdhE"],[2370,"முடிந்த பொழுதில் குற வாணர் ஏனம்","muDindha pozhudhil kuRa vANar Enam"],[2371,"சிலம்பும் செறி கழலும் சென்றிசைப்ப விண் ஆறு","silambum seRi kazhalum senRisaippa viN ARu"],[2372,"மண் உண்டும் பேய்ச்சி முலை உண்டும் ஆற்றாதாய்","maN uNDum pEychchi mulai uNDum ARRAdhAy"],[2373,"மகன் ஒருவர்க்கு அல்லாத மாமேனி மாயன்","magan oruvarkku allAdha mAmEni mAyan"],[2374,"நினைத்துலகில் ஆர் தெளிவார்? நீண்ட திருமால்","ninaiththulagil Ar theLivAr? nINDa thirumAl"],[2375,"உய்த்து உணர்வென்னும் ஒளி கொள் விளக்கேற்றி","uyththu uNarvennum oLi koL viLakkERRi"],[2376,"புகுந்து இலங்கும் அந்திப் பொழுதத்து அரியாய்","pugundhu ilanggum andhip pozhudhaththu ariyAy"],[2377,"வாழ்த்திய வாயராய் வானோர் மணி மகுடம்","vAzhththiya vAyarAy vAnOr maNi maguDam"],[2378,"அலர் எடுத்த உந்தியான் ஆங்கு எழிலாய","alar eDuththa undhiyAn Anggu ezhilAya"],[2379,"இமம் சூழ் மலையும் இருவிசும்பும் காற்றும்","imam sUzh malaiyum iruvisumbum kARRum"],[2380,"தொட்ட படை எட்டும் தோலாத வென்றியான்","thoTTa paDai eTTum thOlAdha venRiyAn"],[2381,"சார்வு நமக்கென்றும் சக்கரத்தான் தண்துழாய்த்","sArvu namakkenRum chakkaraththAn thaNthuzhAyth"],[2382,"நான்முகனை நாராயணன் படைத்தான் நான்முகனும்","nAnmuganai nArAyaNan paDaiththAn nAnmuganum"],[2383,"தேருங்கால் தேவன் ஒருவனே என்று உரைப்பர்","thErungkAl dhEvan oruvanE enRu uraippar"],[2384,"பாலில் கிடந்ததுவும் பண்டு அரங்கம் மேயதுவும்","pAlil kiDandhadhuvum paNDu aranggam mEyadhuvum"],[2385,"ஆறு சடைக் கரந்தான் அண்டர் கோன் தன்னோடும்","ARu saDaik karandhAn aNDar kOn thannODum"],[2386,"தொகுத்த வரத்தனாய்த் தோலாதான் மார்வம்","thoguththa varaththanAyth thOlAdhAn mArvam"],[2387,"அறியார் சமணர் அயர்த்தார் பவுத்தர்","aṟiyār camaṇar ayarttār pavuttar"],[2388,"இன்றாக நாளையே ஆக இனிச் சிறிதும்","inRAga nALaiyE Aga inich chiRidhum"],[2389,"இலை துணை மற்று என் நெஞ்சே! ஈசனை வென்ற","ilai thuNai maRRu en nenjchE! Isanai venRa"],[2390,"குறை கொண்டு நான்முகன் குண்டிகை நீர் பெய்து","kuRai koNDu nAnmugan kuNDigai nIr peydhu"],[2391,"ஆங்காரவாரம் அது கேட்டு அழல் உமிழும்","AnggAravAram adhu kETTu azhal umizhum"],[2392,"வாழ்த்துக வாய் காண்க கண் கேட்க செவி மகுடம்","vAzhththuga vAy kANga kaN kETka sevi maguDam"],[2393,"மதித்தாய் போய் நான்கின் மதியார் போய் வீழ","madhiththAy pOy nAnkin madhiyAr pOy vIzha"],[2394,"வீடாக்கும் பெற்றி அறியாது மெய் வருத்திக்","vIDAkkum peRRi aRiyAdhu mey varuththik"],[2395,"நாராயணன் என்னை ஆளி நரகத்துச்","nArAyaNan ennai ALi naragaththuch"],[2396,"பல தேவர் ஏத்தப் படி கடந்தான் பாதம்","pala dhEvar Eththap paDi kaDandhAn pAdham"],[2397,"நிலை மன்னும் என் நெஞ்சம் அந்நான்று தேவர்","nilai mannum en nenjcham annAnRu dhEvar"],[2398,"ஆல நிழற்கீழ் அற நெறியை நால்வர்க்கு","Ala nizhaRkIzh aRa neRiyai nAlvarkku"],[2399,"மாறாய தானவனை வள்ளுகிரால் மார்விரண்டு","mARAya dhAnavanai vaLLugirAl mArviraNDu"],[2400,"தவம் செய்து நான்முகனால் பெற்ற வரத்தை","thavam seydhu nAnmuganAl peRRa varaththai"],[2401,"நீயே உலகெல்லாம் நின் அருளே நிற்பனவும்","nIyE ulagellAm nin aruLE niRpanavum"],[2402,"இவையா! பில வாய் திறந்தெரி கான்ற","ivaiyA! pila vAy thiRandheri kAnRa"],[2403,"அழகியான் தானே அரி உருவன் தானே","azhagiyAn thAnE ari uruvan thAnE"],[2404,"வித்தும் இடவேண்டும் கொல்லோ? விடை அடர்த்த","vittum iṭaveṇṭum kŏllo? viṭai aṭartta"],[2405,"நிகழ்ந்தாய் பால் பொன் பசுப்புக் கார் வண்ணம் நான்கும்","nigazhndhAy pAl pon pasuppuk kAr vaNNam nAnkum"],[2406,"வகையால் மதியாது மண் கொண்டாய் மற்றும்","vagaiyAl madhiyAdhu maN koNDAy maRRum"],[2407,"மற்றுத் தொழுவார் ஒருவரையும் யான் இன்மை","maRRuth thozhuvAr oruvaraiyum yAn inmai"],[2408,"மால் தான் புகுந்த மட நெஞ்சம் மற்றதுவும்","mAl thAn pugundha maDa nenjcham maRRadhuvum"],[2409,"இது இலங்கை ஈடழியக் கட்டிய சேது","idhu ilanggai IDazhiyak kaTTiya sEdhu"],[2410,"உகப்புருவன் தானே ஒளி உருவன் தானே","ugappuruvan thAnE oLi uruvan thAnE"],[2411,"அவன் என்னை ஆளி அரங்கத்தரங்கில்","avan ennai ALi aranggaththu aranggil"],[2412,"மேல் நான்முகன் அரனை இட்ட விடு சாபம்","mEl nAnmugan aranai iTTa viDu sAbam"],[2413,"கதைப் பொருள் தான் கண்ணன் திரு வயிற்றின் உள்ள","kadhaip poruL thAn kaNNan thiru vayiRRin uLLa"],[2414,"அடிச் சகடம் சாடி அரவாட்டி யானை","aDich sagaDam sADi aravATTi yAnai"],[2415,"குறிப்பு எனக்குக் கோட்டியூர் மேயானை ஏத்த","kuRippu enakkuk kOTTiyUr mEyAnai Eththa"],[2416,"தாளால் உலகம் அளந்த அசவே கொல்?","thALAl ulagam aLandha asavE kol?"],[2417,"நாகத்தணைக் குடந்தை வெஃகா திருவெவ்வுள்","nAgaththaNaik kuDandhai veqkA thiruvevvuL"],[2418,"வான் உலவு தீ வளி மா கடல் மா பொருப்பு","vAn ulavu thI vaLi mA kaDal mA poruppu"],[2419,"அகைப்பில் மனிசரை ஆறு சமயம்","agaippil manisarai ARu samayam"],[2420,"அழைப்பன் திருவேங்கடத்தானைக் காண","azhaippan thiruvEngkaDaththAnaik kANa"],[2421,"வெற்பென்று வேங்கடம் பாடினேன் வீடாக்கி","veRpenRu vEngkaDam pADinEn vIDAkki"],[2422,"காணல் உறுகின்றேன் கல் அருவி முத்துதிர","kANal uRuginREn kal aruvi muththudhira"],[2423,"சென்று வணங்குமினோ சேண் உயர் வேங்கடத்தை","senRu vaNangguminO sEN uyar vEngkaDaththai"],[2424,"மங்குல் தோய் சென்னி வட வேங்கடத்தானை","manggul thOy senni vaDa vEngkaDaththAnai"],[2425,"கொண்டு குடங்கால் மேல் வைத்த குழவியாய்","koNDu kuDangkAl mEl vaiththa kuzhaviyAy"],[2426,"புரிந்து மலர் இட்டுப் புண்டரீகப் பாதம்","purindhu malar iTTup puNDarIkap pAdham"],[2427,"வைப்பன் மணி விளக்கா மாமதியை மாலுக்கென்று","vaippan maNi viLakkA mAmadhiyai mAlukkenRu"],[2428,"நன்மணி வண்ணன் ஊர் ஆளியும் கோள் அரியும்","nanmaNi vaNNan Ur ALiyum kOL ariyum"],[2429,"வேங்கடமே விண்ணோர் தொழுவதுவும் மெய்ம்மையால்","vEngkaDamE viNNOr thozhuvadhuvum meymmaiyAl"],[2430,"மலை ஆமை மேல் வைத்து வாசுகியைச் சுற்றி","malai Amai mEl vaiththu vAsugiyaich suRRi"],[2431,"கூற்றமும் சாரா கொடு வினையும் சாரா தீ","kURRamum sArA koDu vinaiyum sArA thI"],[2432,"எனக்காவார் ஆர் ஒருவரே? எம்பெருமான்","enakkAvAr Ar oruvarE? emperumAn"],[2433,"விலைக்கு ஆட்படுவர் விசாதி ஏற்று உண்பர்","vilaikku ATpaDuvar visAdhi ERRu uNbar"],[2434,"கல்லாதவர் இலங்கை கட்டழித்த காகுத்தன்","kallAdhavar ilanggai kaTTazhiththa kAguththan"],[2435,"தேவராய் நிற்கும் அத்தேவும் அத்தேவரில்","thEvarAy niRkum aththEvum aththEvaril"],[2436,"கடை நின்றமரர் கழல் தொழுது நாளும்","kaDai ninRamarar kazhal thozhudhu nALum"],[2437,"அவர் இவர் என்று இல்லை அனங்க வேள் தாதைக்கு","avar ivar enRu illai anangga vEL thAdhaikku"],[2438,"ஒருங்கிருந்த நல்வினையும் தீவினையும் ஆவான்","orunggirundha nalvinaiyum thIvinaiyum AvAn"],[2439,"என் நெஞ்சம் மேயான் இருள் நீக்கி எம்பிரான்","ĕṉ nĕñcam meyāṉ irul̤ nīkki ĕmpirāṉ"],[2440,"அன்பாவாய் ஆரமுதம் ஆவாய் அடியேனுக்கு","anbAvAy Aramudham AvAy aDiyEnukku"],[2441,"ஆட்பார்த்து உழி தருவாய் கண்டு கொள் என்றும் நின்","ATpArththu uzhi tharuvAy kaNDu koL enRum nin"],[2442,"மனக் கேதம் சாரா மதுசூதன் தன்னை","manak kEdham sArA madhusUdhan thannai"],[2443,"திரு நின்ற பக்கம் திறவிது என்று ஓரார்","thiru ninRa pakkam thiRavidhu enRu OrAr"],[2444,"தரித்திருந்தேன் ஆகவே தாராகணப் போர்","thariththirundhEn AgavE thArAkaNap pOr"],[2445,"போதான இட்டிறைஞ்சி ஏத்துமினோ பொன் மகரக்","pOdhAna iTTiRainjchi EththuminO pon magarak"],[2446,"சூது ஆவது என் நெஞ்சத்து எண்ணினேன் சொல் மாலை","cūtu āvatu ĕṉ nĕñcattu ĕṇṇiṉeṉ cŏl mālai"],[2447,"இடம் ஆவது என் நெஞ்சம் இன்றெல்லாம் பண்டு","iDam Avadhu en nenjcham inRellAm paNDu"],[2448,"வலமாக மாட்டாமை தானாக வைகல்","valamAga mATTAmai thAnAga vaigal"],[2449,"திறம்பேன்மின் கண்டீர் திருவடி தன் நாமம்","thiRambEnmin kaNDIr thiruvaDi than nAmam"],[2450,"செவிக்கு இன்பம் ஆவதுவும் செங்கண்மால் நாமம்","sevikku inbam Avadhuvum sengkaNmAl nAmam"],[2451,"தான் ஒருவன் ஆகித் தரணி இடந்து எடுத்து","thAn oruvan Agith tharaNi iDandhu eDuththu"],[2452,"சேயன் அணியன் சிறியன் மிகப் பெரியன்","sEyan aNiyan siRiyan migap periyan"],[2453,"இல்லறம் இல்லேல் துறவறம் இல் என்னும்","illaṟam illel tuṟavaṟam il ĕṉṉum"],[2454,"ஆரே அறிவார்? அனைத்துலகும் உண்டு உமிழ்ந்த","ArE aRivAr? anaiththulagum uNDu umizhndha"],[2455,"பதிப் பகைஞர்க்கு ஆற்றாது பாய் திரை நீர்ப் பாழி","patip pakaiñarkku āṟṟātu pāy tirai nīrp pāzhi"],[2456,"நாக் கொண்டு மானிடம் பாடேன் நலமாகத்","nAk koNDu mAniDam pADEn nalamAgath"],[2457,"பாட்டும் முறையும் படுகதையும் பல்பொருளும்","pATTum muRaiyum paDukadhaiyum palporuLum"],[2458,"தற்பென்னைத் தான் அறியானேலும் தடங்கடலைக்","thaRpennaith thAn aRiyAnElum thaDangkaDalaik"],[2459,"கண்டு வணங்கினார்க்கு என்னாங்கொல்? காமன் உடல்","kaNDu vaNangginArkku ennAngkol? kAman uDal"],[2460,"ஆய்ந்து கொண்டு ஆதிப் பெருமானை அன்பினால்","Ayndhu koNDu Adhip perumAnai anbinAl"],[2461,"விரைந்து அடைமின் மேல் ஒரு நாள் வெள்ளம் பரக்க","viraindhu aDaimin mEl oru nAL veLLam parakka"],[2462,"கதவு மனம் என்றும் காணலாம் என்றும்","kadhavu manam enRum kANalAm enRum"],[2463,"கலந்தான் என் உள்ளத்துக் காம வேள் தாதை","kalantāṉ ĕṉ ul̤l̤attuk kāma vel̤ tātai"],[2464,"வேந்தராய் விண்ணவராய் விண்ணாகித் தண்ணளியாய்","vEndharAy viNNavarAy viNNAgith thaNNaLiyAy"],[2465,"பிதிரும் மனம் இலேன் பிஞ்ஞகன் தன்னோடு","pitirum maṉam ileṉ piññakaṉ taṉṉoṭu"],[2466,"தொழில் எனக்குத் தொல்லை மால் தன் நாமம் ஏத்த","thozhil enakkuth thollai mAl than nAmam Eththa"],[2467,"உளன் கண்டாய் நன்னெஞ்சே! உத்தமன் என்றும்","uLan kaNDAy nannenjchE! uththaman enRum"],[2468,"இமையப் பெருமலை போல் இந்திரனார்க்கு இட்ட","imaiyap perumalai pOl indhiranArkku iTTa"],[2469,"உயிர் கொண்டு உடல் ஒழிய ஓடும் போதோடி","uyir koNDu uDal ozhiya ODum pOdhODi"],[2470,"பழுதாகாது ஒன்றறிந்தேன் பாற்கடலான் பாதம்","pazhudhAgAdhu onRaRindhEn pARkaDalAn pAdham"],[2471,"வீற்றிருந்து விண்ணாள வேண்டுவார் வேங்கடத்தான்","vIRRirundhu viNNALa vENDuvAr vEngkaDaththAn"],[2472,"தமர் ஆவார் யாவர்க்கும் தாமரை மேலாற்கும்","thamar AvAr yAvarkkum thAmarai mElARkum"],[2473,"என்றும் மறந்தறியேன் என் நெஞ்சத்தே வைத்து","enRum maRandhaRiyEn en nenjchaththE vaiththu"],[2474,"காப்பு மறந்தறியேன் கண்ணனே என்று இருப்பன்","kAppu maRandhaRiyEn kaNNanE enRu iruppan"],[2475,"மெய் தெளிந்தார் என் செய்யார்? வேறானார் நீறாக","mey theLindhAr en seyyAr? vERAnAr nIRAga"],[2476,"ஏன்றேன் அடிமை இழிந்தேன் பிறப்பு இடும்பை","eṉṟeṉ aṭimai izhinteṉ piṟappu iṭumpai"],[2477,"இனி அறிந்தேன் ஈசற்கும் நான்முகற்கும் தெய்வம்","ini aRindhEn IsaRkum nAnmugaRkum dheyvam"],[2478,"பொய்ந்நின்ற ஞானமும் பொல்லா ஒழுக்கும் அழுக்குடம்பும்","poynninRa njAnamum pollA ozhukkum azhukkuDambum"],[2479,"செழு நீர்த் தடத்துக் கயல் மிளிர்ந்தால் ஒப்ப சேய் அரிக் கண்","sezhu nIrth thaDaththuk kayal miLirndhAl oppa sEy arik kaN"],[2480,"குழல் கோவலர் மடப் பாவையும் மண்மகளும் திருவும்","kuzhal kOvalar maDap pAvaiyum maNmagaLum thiruvum"],[2481,"தனி நெஞ்சம் முன் அவர் புள்ளே கவர்ந்தது தண்ணந்துழாய்க்கு","thani nenjcham mun avar puLLE kavarndhadhu thaNNanthuzhAykku"],[2482,"பனிப்பு இயல்வாக உடைய தண்வாடை இக்காலம் இவ்வூர்ப்","panippu iyalvAga uDaiya thaNvADai ikkAlam ivvUrp"],[2483,"தடாவிய அம்பும் முரிந்த சிலைகளும் போக விட்டு","thaDAviya ambum murindha silaigaLum pOga viTTu"],[2484,"ஞாலம் பனிப்பச் செறித்து நன்னீர் இட்டுக்கால் சிதைந்து","njAlam panippach seRiththu nannIr iTTukkAl sidhaindhu"],[2485,"காண்கின்றனகளும் கேட்கின்றனகளும் காணில் இந்நாள்","kANginRanagaLum kETkinRanagaLum kANil innAL"],[2486,"திண் பூஞ்சுடர் நுதி நேமி அஞ்செல்வர் விண்ணாடு அனைய","thiN pUnjchuDar nudhi nEmi anjchelvar viNNADu anaiya"],[2487,"மாயோன் வட திருவேங்கட நாட வல்லிக் கொடிகாள்!","mAyOn vaDa thiruvEngkaDa nADa vallik koDigAL!"],[2488,"அரியன யாம் இன்று காண்கின்றன கண்ணன் விண் அனையாய்!","ariyana yAm inRu kANginRana kaNNan viN anaiyAy!"],[2489,"பேர்கின்றது மணி மாமை பிறங்கி அள்ளல் பயலை","pErginRadhu maNi mAmai piRanggi aLLal payalai"],[2490,"தனி வளர் செங்கோல் நடாவு தழல் வாய் அரசவியப்","thani vaLar sengkOl naDAvu thazhal vAy arasaviyap"],[2491,"ஈர்வன வேலும் அஞ்சேலும் உயிர் மேல் மிளிர்ந்து இவையோ","Irvana vElum anjchElum uyir mEl miLirndhu ivaiyO"],[2492,"கயலோ நும கண்கள்? என்று களிறு வினவி நிற்றீர்","kayalO numa kaNgaL? enRu kaLiRu vinavi niRRIr"],[2493,"பல பல ஊழிகள் ஆயிடும் அன்றி ஓர் நாழிகையைப்","pala pala UzhigaL AyiDum anRi Or nAzhigaiyaip"],[2494,"இருள் விரிந்தால் அன்ன மா நீர்த் திரை கொண்டு வாழியரோ","iruL virindhAl anna mA nIrth thirai koNDu vAzhiyarO"],[2495,"கடல் கொண்டு எழுந்தது வானம் அவ்வானத்தை அன்றிச் சென்று","kaDal koNDu ezhundhadhu vAnam avvAnaththai anRich senRu"],[2496,"காரிகையார் நிறை காப்பவர் யார் என்று கார் கொண்டு இன்னே","kArigaiyAr niRai kAppavar yAr enRu kAr koNDu innE"],[2497,"சின்மொழி நோயோ கழி பெருந்தெய்வம் இந்நோய் இனதென்று","chinmozhi nOyO kazhi perundheyvam innOy inadhenRu"],[2498,"சூட்டு நன்மாலைகள் தூயன ஏந்தி விண்ணோர்கள் நன்னீர்","sUTTu nanmAlaigaL thUyana Endhi viNNOrgaL nannIr"],[2499,"கொம்பார் தழை கை சிறு நாண் எறிவிலம் வேட்டை கொண்டாட்டு","kombAr thazhai kai siRu nAN eRivilam vETTai koNDATTu"],[2500,"புனமோ? புனத்தயலே வழி போகும் அருவினையேன்","punamO? punaththayalE vazhi pOgum aruvinaiyEn"],[2501,"இயல்வு ஆயின வஞ்ச நோய் கொண்டு உலாவும் ஓரோ குடங்கைக்","iyalvu Ayina vanjcha nOy koNDu ulAvum OrO kuDangkaik"],[2502,"எங்கோல் வளை முதலாக் கண்ணன் மண்ணும் விண்ணும் அளிக்கும்","engkOl vaLai mudhalAk kaNNan maNNum viNNum aLikkum"],[2503,"நானிலம் வாய்க் கொண்டு நன்னீர் அறம் என்று கோது கொண்ட","nAnilam vAyk koNDu nannIr aRam enRu kOdhu koNDa"],[2504,"சேமம் செங்கோன் அருளே செறுவாரும் நட்பு ஆகுவர் என்று","cemam cĕṅkoṉ arul̤e cĕṟuvārum naṭpu ākuvar ĕṉṟu"],[2505,"தண் அம் துழாய் வளை கொள்வது யாம் இழப்போம் நடுவே","taṇ am tuzhāy val̤ai kŏl̤vatu yām izhappom naṭuve"],[2506,"இன்னன்ன தூது எம்மை ஆள் அற்றப் பட்டிரந்தாள் இவள் என்று","innanna thUdhu emmai AL aRRap paTTirandhAL ivaL enRu"],[2507,"அன்னம் செல்வீரும் வண்டானம் செல்வீரும் தொழுது இரந்தேன்","annam selvIrum vaNDAnam selvIrum thozhudhu irandhEn"],[2508,"இசைமின்கள் தூது என்று இசைத்தால் இசையிலம் என் தலை மேல்","isaiminkaL thUdhu enRu isaiththAl isaiyilam en thalai mEl"],[2509,"மேகங்களோ! உரையீர் திருமால் திருமேனி ஒக்கும்","mEganggaLO! uraiyIr thirumAl thirumEni okkum"],[2510,"அருள் ஆர் திருச்சக்கரத்தால் அகல் விசும்பும் நிலனும்","aruL Ar thiruchchakkaraththAl agal visumbum nilanum"],[2511,"சிதைக்கின்றதாழி என்று ஆழியைச் சீறி தன் சீறடியால்","sidhaikkinRadhAzhi enRu Azhiyaich sIRi than sIRaDiyAl"],[2512,"பால் வாய்ப் பிறைப் பிள்ளை ஒக்கலைக் கொண்டு பகல் இழந்த","pAl vAyp piRaip piLLai okkalaik koNDu pagal izhandha"],[2513,"துழா நெடுஞ்சூழ் இருள் என்று தந்தண் தார் அது பெயரா","thuzhA neDunjchUzh iruL enRu thanthaN thAr adhu peyarA"],[2514,"கொடுங்கால் சிலையர் நிரை கோள் உழவர் கொலையில் வெய்ய","koDungkAl silaiyar nirai kOL uzhavar kolaiyil veyya"],[2515,"கடம் ஆயினகள் கழித்து தன் கால் வன்மையால் பல நாள்","kaṭam āyiṉakal̤ kazhittu taṉ kāl vaṉmaiyāl pala nāl̤"],[2516,"நீலத் தட வரை மேல் புண்டரீக நெடுந்தடங்கள்","nIlath thaDa varai mEl puNDarIga neDunthaDanggaL"],[2517,"கோலப் பகல் களிறு ஒன்று கற்புய்ய குழாம் விரிந்த","kOlap pagal kaLiRu onRu kaRpuyya kuzhAm virindha"],[2518,"என்றும் புன் வாடை இது கண்டறிதும் இவ்வாறு வெம்மை","enRum pun vADai idhu kaNDaRidhum ivvARu vemmai"],[2519,"வன் காற்று அறைய ஒருங்கே மறிந்து கிடந்து அலர்ந்த","van kARRu aRaiya orunggE maRindhu kiDandhu alarndha"],[2520,"கண்ணும் செந்தாமரை கையும் அவை அடியோ அவையே","kaNNum senthAmarai kaiyum avai aDiyO avaiyE"],[2521,"நிறம் உயர் கோலமும் பேரும் உருவும் இவை இவை என்று","niRam uyar kOlamum pErum uruvum ivai ivai enRu"],[2522,"பெருங்கேழலார் தம் பெருங்கண் மலர்ப் புண்டரீகம் நம் மேல்","perungkEzhalAr tham perungkaN malarp puNDarIkam nam mEl"],[2523,"மட நெஞ்சம் என்றும் தமது என்றும் ஓர் கருமம் கருதி","maDa nenjcham enRum thamadhu enRum Or karumam karudhi"],[2524,"திரிகின்றது வட மாருதம் திங்கள் வெந்தீ முகந்து","thiriginRadhu vaDa mArudham thinggaL venthI mugandhu"],[2525,"மெல்லியல் ஆக்கைக் கிருமி குருவில் மிளிர்தந்து ஆங்கே","melliyal Akkaik kirumi kuruvil miLirthandhu AnggE"],[2526,"பண்டும் பல பல வீங்கிருள் காண்டும் இப்பாய் இருள் போல்","paNDum pala pala vInggiruL kANDum ippAy iruL pOl"],[2527,"ஒண்ணுதல் மாமை ஒளி பயவாமை விரைந்து நந்தேர்","oNNudhal mAmai oLi payavAmai viraindhu nanthEr"],[2528,"மலை கொண்டு மத்தா அரவால் சுழற்றிய மாயப் பிரான்","malai koNDu maththA aravAl suzhaRRiya mAyap pirAn"],[2529,"அழைக்கும் கருங்கடல் வெண்திரைக் கைக் கொண்டு போய் அலர் வாய்","azhaikkum karungkaDal veNthiraik kaik koNDu pOy alar vAy"],[2530,"வார் ஆயின முலையாள் இவள் வானோர் தலைமகனாம்","vAr Ayina mulaiyAL ivaL vAnOr thalaimaganAm"],[2531,"வீசும் சிறகால் பறத்திர் விண்ணாடு நுங்கட்கு எளிது","vIsum siRagAl paRaththir viNNADu nunggaTku eLidhu"],[2532,"வண்டுகளோ! வம்மின் நீர்ப் பூ நிலப் பூ மரத்தில் ஒண்பூ","vaNDugaLO! vammin nIrp pU nilap pU maraththil oNpU"],[2533,"வியல் இடம் உண்ட பிரானார் விடுத்த திருவருளால்","viyal iDam uNDa pirAnAr viDuththa thiruvaruLAl"],[2534,"புலக் குண்டலப் புண்டரீகத்த போர்க் கெண்டை வல்லி ஒன்றால்","pulak kuNDalap puNDarIkaththa pOrk keNDai valli onRAl"],[2535,"கழல் தலம் ஒன்றே நில முழுதாயிற்று ஒரு கழல் போய்","kazhal thalam onRE nila muzhudhAyiRRu oru kazhal pOy"],[2536,"அளப்பரும் தன்மைய ஊழி அங்கங்குல் அந்தண்ணந்துழாய்க்கு","aLapparum thanmaiya Uzhi angkanggul anthaNNanthuzhAykku"],[2537,"முலையோ முழு முற்றும் போந்தில மொய் பூங்குழல் குறிய","mulaiyO muzhu muRRum pOndhila moy pUngkuzhal kuRiya"],[2538,"வாசகம் செய்வது நம் பரமே? தொல்லை வானவர் தம்","vAsagam seyvadhu nam paramE? thollai vAnavar tham"],[2539,"இறையோ இரக்கினும் ஈங்குஓர் பெண்பால் எனவும் இரங்காது","iRaiyO irakkinum InggOr peNpAl enavum iranggAdhu"],[2540,"வண்ணம் சிவந்துள வானாடமரும் குளிர் விழிய","vaNNam sivandhuLa vAnADamarum kuLir vizhiya"],[2541,"இருக்கு ஆர் மொழியால் நெறி இழுக்காமை உலகு அளந்த","irukku ār mŏzhiyāl nĕṟi izhukkāmai ulaku al̤anta"],[2542,"கற்றுப் பிணை மலர்க் கண்ணின் குலம் வென்று ஓரோ கருமம்","kaRRup piNai malark kaNNin kulam venRu OrO karumam"],[2543,"உண்ணாது உறங்காது உணர்வுறும் எத்தனை யோகியர்க்கும்","uṇṇātu uṟaṅkātu uṇarvuṟum ĕttaṉai yokiyarkkum"],[2544,"காவியும் நீலமும் வேலும் கயலும் பலபல வென்று","kāviyum nīlamum velum kayalum palapala vĕṉṟu"],[2545,"மலர்ந்தே ஒழிந்தில மாலையும் மாலைப் பொன் வாசிகையும்","malarndhE ozhindhila mAlaiyum mAlaip pon vAsigaiyum"],[2546,"கார் ஏற்றிருள் செகில் ஏற்றின் சுடருக்கு உளைந்து வெல்வான்","kAr ERRiruL segil ERRin suDarukku uLaindhu velvAn"],[2547,"வளை வாய்த் திருச்சக்கரத்து எங்கள் வானவனார் முடி மேல்","vaLai vAyth thiruchchakkaraththu enggaL vAnavanAr muDi mEl"],[2548,"ஊழிகளாய் உலகேழும் உண்டான் என்றிலம் பழம் கண்டு","UzhigaLAy ulagEzhum uNDAn enRilam pazham kaNDu"],[2549,"சூழ்கின்ற கங்குல் சுருங்கா இருளின் கருந்திணிம்பை","sUzhginRa kanggul surunggA iruLin karunthiNimbai"],[2550,"வால் வெண்ணிலவு உலகாரச் சுரக்கும் வெண்திங்கள் என்னும்","vAl veNNilavu ulagArach surakkum veNthinggaL ennum"],[2551,"தளர்ந்தும் முறிந்தும் வரு திரைப் பாயல் திரு நெடுங்கண்","thaLarndhum muRindhum varu thiraip pAyal thiru neDungkaN"],[2552,"உலாகின்ற கெண்டை ஒளி அம்பு எம் ஆவியை ஊடுருவக்","ulAginRa keNDai oLi ambu em Aviyai UDuruvak"],[2553,"இடம் போய் விரிந்து இவ்வுலகளந்தான் எழில் ஆர் தண்துழாய்","iDam pOy virindhu ivvulagaLandhAn ezhil Ar thaNthuzhAy"],[2554,"திங்கள் அம்பிள்ளை புலம்பத் தன் செங்கோல் அரசு பட்ட","thinggaL ampiLLai pulambath than sengkOl arasu paTTa"],[2555,"நலியும் நரகனை வீட்டிற்றும் வாணன் திண் தோல் துணித்த","naliyum narakaṉai vīṭṭiṟṟum vāṇaṉ tiṇ tol tuṇitta"],[2556,"வேதனை வெண்புரி நூலனை விண்ணோர் பரவ நின்ற","vEdhanai veNpuri nUlanai viNNOr parava ninRa"],[2557,"சீர் அரசாண்டு தன் செங்கோல் சில நாள் செலீஇக் கழிந்த","sIr arasANDu than sengkOl sila nAL selIik kazhindha"],[2558,"உறுகின்ற கன்மங்கள் மேலன ஓர்ப்பிலராய் இவளைப்","uṟukiṉṟa kaṉmaṅkal̤ melaṉa orppilarāy ival̤aip"],[2559,"எரி கொள் செந்நாயிறு இரண்டுடனே உதயம் மலை வாய்","eri koL sennAyiRu iraNDuDanE udhayam malai vAy"],[2560,"விளரிக் குரல் அன்றில் மென்படை மேகின்ற முன்றில் பெண்ணை","viLarik kural anRil menpaDai mEginRa munRil peNNai"],[2561,"தையல் நல்லார்கள் குழாங்கள் குழிய குழுவினுள்ளும்","taiyal nallārkal̤ kuzhāṅkal̤ kuzhiya kuzhuviṉul̤l̤um"],[2562,"மாணிக்கம் கொண்டு குரங்கு எறிவு ஒத்து இருளோடு முட்டி","māṇikkam kŏṇṭu kuraṅku ĕṟivu ŏttu irul̤oṭu muṭṭi"],[2563,"அடைக் கலத்தோங்கு கமலத்து அலர் அயன் சென்னி என்னும்","aDaik kalaththOnggu kamalaththu alar ayan senni ennum"],[2564,"புலம்பும் கன குரல் போழ் வாய அன்றிலும் பூங்கழி பாய்ந்து","pulambum kana kural pOzh vAya anRilum pUngkazhi pAyndhu"],[2565,"திரு மால் உரு ஒக்கும் மேரு அம்மேருவில் செஞ்சுடரோன்","thiru mAl uru okkum mEru ammEruvil senjchuDarOn"],[2566,"தீ வினைக்கரு நஞ்சை நல் வினைக்கு இன்னமுதத்தினை","thI vinaikkaru nanjchai nal vinaikku innamudhaththinai"],[2567,"தலைப்பெய்து யான் உன் திருவடிச் சூடும் தகைமையினால்","thalaippeydhu yAn un thiruvaDich sUDum thagaimaiyinAl"],[2568,"சுருங்குறி வெண்ணெய் தொடு உண்ட கள்வனை வையம் முற்றும்","surungguRi veNNey thoDu uNDa kaLvanai vaiyam muRRum"],[2569,"பேணலம் இல்லா அரக்கர் முந்நீர பெரும் பதி வாய்","pENalam illA arakkar munnIra perum padhi vAy"],[2570,"காலை வெய்யோற்கு முன் ஓட்டுக் கொடுத்த கங்குல் குறும்பர்","kAlai veyyORku mun OTTuk koDuththa kanggul kuRumbar"],[2571,"மைப் படி மேனியும் செந்தாமரைக் கண்ணும் வைதிகரே","maip paDi mEniyum senthAmaraik kaNNum vaidhigarE"],[2572,"யாதானும் ஓர் ஆக்கையில் புக்கு அங்கு ஆப்புண்டும் ஆப்பவிழ்ந்தும்","yAdhAnum Or Akkaiyil pukku anggu AppuNDum Appavizhndhum"],[2573,"வணங்கும் துறைகள் பல பல ஆக்கி மதி விகற்பால்","vaNanggum thuRaigaL pala pala Akki madhi vigaRpAl"],[2574,"எழுவதும் மீண்டே படுவதும் பட்டு எனை ஊழிகள் போய்க்","ezhuvadhum mINDE paDuvadhum paTTu enai UzhigaL pOyk"],[2575,"துஞ்சா முனிவரும் அல்லாதவரும் தொடர நின்ற","thunjchA munivarum allAdhavarum thoDara ninRa"],[2576,"ஈனச் சொல் ஆயினும் ஆக எறி திரை வையம் முற்றும்","Inach sol Ayinum Aga eRi thirai vaiyam muRRum"],[2577,"நல்லார் நவில் குருகூர் நகரான் திருமால் திருப் பேர்","nallAr navil kurugUr nagarAn thirumAl thirup pEr"],[2578,"செக்கர் மா முகில் உடுத்து மிக்க செஞ் சுடர்ப்","cĕkkar mā mukil uṭuttu mikka cĕñ cuṭarp"],[2579,"உலகு படைத்து உண்ட எந்தை அறை கழல்","ulagu paDaiththu uNDa endhai aRai kazhal"],[2580,"குறிப்பில் கொண்டு நெறிப்பட உலகம்","kuṟippil kŏṇṭu nĕṟippaṭa ulakam"],[2581,"ஊழி தோறூழி ஓவாது வாழிய","Uzhi thORUzhi OvAdhu vAzhiya"],[2582,"மா முதல் அடிப் போது ஒன்று கவிழ்த்து அலர்த்தி","mā mutal aṭip potu ŏṉṟu kavizhttu alartti"],[2583,"ஓஓ உலகினது இயல்வே! ஈன்றோள் இருக்க","oo ulakiṉatu iyalve! īṉṟol̤ irukka"],[2584,"நளிர் மதிச் சடையனும் நான்முகக் கடவுளும்","naLir madhich saDaiyanum nAnmugak kaDavuLum"],[2585,"முயற்றி சுமந்து எழுந்து முந்துற்ற நெஞ்சே!","muyaRRi sumandhu ezhundhu mundhuRRa nenjchE!"],[2586,"புகழ்வோம் பழிப்போம் புகழோம் பழியோம்","pugazhvOm pazhippOm pugazhOm pazhiyOm"],[2587,"இவை அன்றே நல்ல இவை அன்றே தீய","ivai anRE nalla ivai anRE thIya"],[2588,"என்னின் மிகு புகழார் யாவரே? பின்னையும் மற்று","ennin migu pugazhAr yAvarE? pinnaiyum maRRu"],[2589,"பெற்ற தாய் நீயே பிறப்பித்த தந்தை நீ","peRRa thAy nIyE piRappiththa thandhai nI"],[2590,"நெறி காட்டி நீக்குதியோ? நின் பால் கரு மா","neRi kATTi nIkkudhiyO? nin pAl karu mA"],[2591,"யாமே அரு வினையோம் சேயோம் என் நெஞ்சினார்","yAmE aru vinaiyOm sEyOm en nenjchinAr"],[2592,"அருகும் சுவடும் தெரிவுணரோம் அன்பே","arugum suvaDum therivuNarOm anbE"],[2593,"நுமக்கடியோம் என்றென்று நொந்துரைத்து என்? மாலார்","numakkaDiyOm enRenRu nondhuraiththu en? mAlAr"],[2594,"இரு நால்வர் ஈரைந்தின் மேல் ஒருவர் எட்டோடு","iru nAlvar Iraindhin mEl oruvar eTTODu"],[2595,"நாழால் அமர் முயன்ற வல்லரக்கன் இன்னுயிரை","nAzhAl amar muyanRa vallarakkan innuyirai"],[2596,"நீ அன்றே ஆழ் துயரில் வீழ்விப்பான் நின்று உழன்றாய்?","nI anRE Azh thuyaril vIzhvippAn ninRu uzhanRAy?"],[2597,"வழக்கொடு மாறுகொள் அன்று அடியார் வேண்ட","vazhakkoDu mARukoL anRu aDiyAr vENDa"],[2598,"சாயால் கரியானை உள் அறியாராய் நெஞ்சே!","sAyAl kariyAnai uL aRiyArAy nenjchE!"],[2599,"பார்த்தோர் எதிரிதா நெஞ்சே! படு துயரம்","pArththOr edhiridhA nenjchE! paDu thuyaram"],[2600,"சீரால் பிறந்து சிறப்பால் வளராது","sIrAl piRandhu siRappAl vaLarAdhu"],[2601,"சூழ்ந்து அடியார் வேண்டினக்கால் தோன்றாது விட்டாலும்","sUzhndhu aDiyAr vENDinakkAl thOnRAdhu viTTAlum"],[2602,"தாம்பால் ஆப்புண்டாலும் அத்தழும்பு தான் இளக","thAmbAl AppuNDAlum aththazhumbu thAn iLaga"],[2603,"சொல்லில் குறை இல்லை சூது அறியா நெஞ்சமே","cŏllil kuṟai illai cūtu aṟiyā nĕñcame"],[2604,"காணப்புகில் அறிவு கைக்கொண்ட நல் நெஞ்சம்","kāṇappukil aṟivu kaikkŏṇṭa nal nĕñcam"],[2605,"சென்றங்கு வெந்நரகில் சேராமல் காப்பதற்கு","senRanggu vennaragil sErAmal kAppadhaRku"],[2606,"காலே பொதத் திரிந்து கத்துவராம் இனநாள்","kAlE podhath thirindhu kaththuvarAm inanAL"],[2607,"இளைப்பாய் இளையாப்பாய் நெஞ்சமே! சொன்னேன்","iLaippAy iLaiyAppAy nenjchamE! sonnEn"],[2608,"தானே தனித் தோன்றல் தன் அளப்பு ஒன்று இல்லாதான்","thAnE thanith thOnRal than aLappu onRu illAdhAn"],[2609,"ஆரானும் ஆதானும் செய்ய அகல் இடத்தை","ArAnum AdhAnum seyya agal iDaththai"],[2610,"யானும் என் நெஞ்சும் இசைந்தொழிந்தோம் வல்வினையைக்","yAnum en nenjchum isaindhozhindhOm valvinaiyaik"],[2611,"அடியால் படி கடந்த முத்தோ? அதன்றேல்","aDiyAl paDi kaDandha muththO? adhanREl"],[2612,"அன்றே நம் கண் காணும் ஆழியான் கார் உருவம்","anRE nam kaN kANum AzhiyAn kAr uruvam"],[2613,"உணர ஒருவர்க்கு எளியனே? செவ்வே","uNara oruvarkku eLiyanE? sevvE"],[2614,"இங்கில்லை பண்டு போல் வீற்று இருத்தல் என்னுடைய","inggillai paNDu pOl vIRRu iruththal ennuDaiya"],[2615,"அழகும் அறிவோமாய் வல்வினையைத் தீர்ப்பான்","azhagum aRivOmAy valvinaiyaith thIrppAn"],[2616,"தமக்கு அடிமை வேண்டுவார் தாமோதரனார்","tamakku aṭimai veṇṭuvār tāmotaraṉār"],[2617,"யாதானும் ஒன்றறியில் தன் உகக்கில் என் கொலோ?","yAdhAnum onRaRiyil than ugakkil en kolO?"],[2618,"பால் ஆழி நீ கிடக்கும் பண்பை யாம் கேட்டேயும்","pAl Azhi nI kiDakkum paNbai yAm kETTEyum"],[2619,"நின்றும் இருந்தும் கிடந்தும் திரிதந்தும்","ninRum irundhum kiDandhum thirithandhum"],[2620,"அவனாம் இவனாம் உவனாம் மற்று உம்பர்","avanAm ivanAm uvanAm maRRu umbar"],[2621,"ஆம் ஆறு அறிவுடையார் ஆவது அரிது அன்றே?","Am ARu aRivuDaiyAr Avadhu aridhu anRE?"],[2622,"அமைக்கும் பொழுது உண்டே? ஆராயில் நெஞ்சே!","amaikkum pozhudhu uNDE? ArAyil nenjchE!"],[2623,"பிழைக்க முயன்றோமோ? நெஞ்சமே! பேசாய்","pizhaikka muyanROmO? nenjchamE! pEsAy"],[2624,"வாய்ப்போ இது ஒப்ப மற்றில்லை வா நெஞ்சே!","vAyppO idhu oppa maRRillai vA nenjchE!"],[2625,"வலியம் என நினைந்து வந்து எதிர்ந்த மல்லர்","valiyam ĕṉa niṉaintu vantu ĕtirnta mallar"],[2626,"பார் உண்டான் பார் உமிழ்ந்தான் பார் இடந்தான் பார் அளந்தான்","pAr uNDAn pAr umizhndhAn pAr iDanthAn pAr aLandhAn"],[2627,"அவயம் என நினைந்து வந்த சுரர் பாலே","avayam ena ninaindhu vandha surar pAlE"],[2628,"வகை சேர்ந்த நல் நெஞ்சும் நா உடைய வாயும்","vakai cernta nal nĕñcum nā uṭaiya vāyum"],[2629,"வினையார் தர முயலும் வெம்மையை அஞ்சி","vinaiyAr thara muyalum vemmaiyai anjchi"],[2630,"நான் கூறும் கூற்றாவது இத்தனையே நாள்நாளும்","nāṉ kūṟum kūṟṟāvatu ittaṉaiye nāl̤nāl̤um"],[2631,"நினைத்து இறைஞ்சி மானிடவர் ஒன்று இரப்பர் என்றே","ninaiththu iRainjchi mAniDavar onRu irappar enRE"],[2632,"எமக்கு யாம் விண்ணாட்டுக்கு உச்சமதாம் வீட்டை","emakku yAm viNNATTukku uchchamadhAm vITTai"],[2633,"கொண்டல் தான் மால் வரை தான் மா கடல் தான் கூர் இருள் தான்","koNDal thAn mAl varai thAn mA kaDal thAn kUr iruL thAn"],[2634,"பிரிந்து ஒன்று நோக்காது தம்முடைய பின்னே","pirindhu onRu nOkkAdhu thammuDaiya pinnE"],[2635,"மனம் ஆளும் ஓர் ஐவர் வன்குறும்பர் தம்மை","manam ALum Or aivar vankuRumbar thammai"],[2636,"மாண் பாவித்து அஞ்ஞான்று மண் இரந்தான் மாயவள் நஞ்சு","mAN pAviththu anjnjAnRu maN irandhAn mAyavaL nanjchu"],[2637,"ஒன்றுண்டு செங்கண் மால்! யான் உரைப்பது உன் அடியார்க்கு","onRuNDu sengkaN mAl! yAn uraippadhu un aDiyArkku"],[2638,"வானோ? மறி கடலோ? மாருதமோ? தீயகமோ?","vAnO? maRi kaDalO? mArudhamO? thIyagamO?"],[2639,"மருங்கு ஓதம் மோதும் மணி நாகணையார்","maruṅku otam motum maṇi nākaṇaiyār"],[2640,"வரவாறு ஒன்றில்லையால் வாழ்வினிதால் எல்லே!","varavARu onRillaiyAl vAzhvinidhAl ellE!"],[2641,"வழித் தங்கு வல்வினையை மாற்றானோ? நெஞ்சே!","vazhith thanggu valvinaiyai mARRAnO? nenjchE!"],[2642,"மாலே! படிச் சோதி மாற்றேல் இனி உனது","mAlE! paDich sOdhi mARREl ini unadhu"],[2643,"மாடே வரப் பெறுவராம் என்றே வல்வினையார்","mADE varap peRuvarAm enRE valvinaiyAr"],[2644,"பேர்ந்தொன்று நோக்காது பின் நிற்பாய் நில்லாப்பாய்","pErndhonRu nOkkAdhu pin niRpAy nillAppAy"],[2645,"இறை முறையான் சேவடி மேல் மண் அளந்த அந்நாள்","iRai muRaiyAn sEvaDi mEl maN aLandha annAL"],[2646,"மீன் என்னும் கம்பில் வெறி என்னும் வெள்ளி வேய்","mīṉ ĕṉṉum kampil vĕṟi ĕṉṉum vĕl̤l̤i vey"],[2647,"பின் துரக்கும் காற்று இழந்த சூல் கொண்டல் பேர்ந்தும் போய்","piṉ turakkum kāṟṟu izhanta cūl kŏṇṭal perntum poy"],[2648,"பரனாம் அவன் ஆதல் பாவிப்பர் ஆகில்","paranAm avan Adhal pAvippar Agil"],[2649,"கலந்து நலியும் கடுந்துயரை நெஞ்சே!","kalandhu naliyum kaDunthuyarai nenjchE!"],[2650,"சூட்டாய நேமியான் தொல் அரக்கன் இன்னுயிரை","sUTTAya nEmiyAn thol arakkan innuyirai"],[2651,"அதுவோ நன்று என்று அங்கு அமர் உலகோ வேண்டில்","atuvo naṉṟu ĕṉṟu aṅku amar ulako veṇṭil"],[2652,"கல்லும் கனை கடலும் வைகுந்த வானாடும்","kallum kanai kaDalum vaikuntha vAnADum"],[2653,"அகம் சிவந்த கண்ணினராய் வல்வினையர் ஆவார்","agam sivandha kaNNinarAy valvinaiyar AvAr"],[2654,"அடர் பொன் முடியானை ஆயிரம் பேரானை","aDar pon muDiyAnai Ayiram pErAnai"],[2655,"இனி நின்று நின் பெருமை யான் உரைப்பது என்னே?","ini ninRu nin perumai yAn uraippadhu ennE?"],[2656,"முதலாம் திரு உருவம் மூன்று என்பர் ஒன்றே","mudhalAm thiru uruvam mUnRu enbar onRE"],[2657,"பூவையும் காயாவும் நீலமும் பூக்கின்ற","pUvaiyum kAyAvum nIlamum pUkkinRa"],[2658,"என்றும் ஒரு நாள் ஒழியாமை யான் இரந்தால்","enRum oru nAL ozhiyAmai yAn irandhAl"],[2659,"புவியும் இரு விசும்பும் நின் அகத்த நீ என்","puviyum iru visumbum nin agaththa nI en"],[2660,"உள்ளிலும் உள்ளம் தடிக்கும் வினைப் படலம்","uLLilum uLLam thaDikkum vinaip paDalam"],[2661,"உரைக்கில் ஓர் சுற்றத்தார் உற்றார் என்றாரே?","uraikkil Or suRRaththAr uRRAr enRArE?"],[2662,"துணை நாள் பெருங் கிளையும் தொல் குலமும் சுற்றத்து","tuṇai nāl̤ pĕruṅ kil̤aiyum tŏl kulamum cuṟṟattu"],[2663,"உள் நாட்டுத் தேசு அன்றே? ஊழ்வினையை அஞ்சுமே?","ul̤ nāṭṭut tecu aṉṟe? ūzhviṉaiyai añcume?"],[2664,"பிறப்பு இறப்பு மூப்புப் பிணி துறந்து பின்னும்","piRappu iRappu mUppup piNi thuRandhu pinnum"],[2665,"பகல் இரா என்பதுவும் பாவியாது எம்மை","pagal irA enbadhuvum pAviyAdhu emmai"],[2666,"தெரிந்து உணர்வொன்று இன்மையால் தீவினையேன் வாளா","therindhu uNarvonRu inmaiyAl thIvinaiyEn vALA"],[2667,"அயர்ப்பாய் அயராப்பாய் நெஞ்சமே! சொன்னேன்","ayarppAy ayarAppAy nenjchamE! sonnEn"],[2668,"வாழ்த்தி அவன் அடியைப் பூப் புனைந்து நின் தலையைத்","vAzhththi avan aDiyaip pUp punaindhu nin thalaiyaith"],[2669,"தங்கா முயற்றியவாய்த் தாழ் விசும்பின் மீது பாய்ந்து","thanggA muyaRRiyavAyth thAzh visumbin mIdhu pAyndhu"],[2670,"கார் கலந்த மேனியான் கை கலந்த ஆழியான்","kAr kalandha mEniyAn kai kalandha AzhiyAn"],[2671,"இப்போதும் இன்னும் இனிச் சிறிது நின்றாலும்","ippOdhum innum inich chiRidhu ninRAlum"],[2672,"ஒரு பேர் உந்தி இரு மலர்த் தவிசில்","ŏru per unti iru malart tavicil"],[2791,"உயர்வற உயர் நலம் உடையவன் யவன் அவன்","uyarvaRa uyar nalam uDaiyavan yavan avan"],[2792,"மனன் அகம் மலம் அற மலர் மிசை எழு தரும்","manan agam malam aRa malar misai ezhu tharum"],[2793,"இலன் அது உடையன் இது என நினைவு அரியவன்","ilan adhu uDaiyan idhu ena ninaivu ariyavan"],[2794,"நாம் அவன் இவன் உவன் அவள் இவள் உவள் எவள்","nAm avan ivan uvan avaL ivaL uvaL evaL"],[2795,"அவரவர் தமதமது அறிவறி வகை வகை","avaravar thamathamadhu aRivaRi vagai vagai"],[2796,"நின்றனர் இருந்தனர் கிடந்தனர் திரிந்தனர்","ninRanar irundhanar kiDandhanar thirindhanar"],[2797,"திட விசும்பு எரி வளி நீர் நிலம் இவை மிசை","thiDa visumbu eri vaLi nIr nilam ivai misai"],[2798,"சுரர் அறிவு அரு நிலை விண் முதல் முழுவதும்","surar aRivu aru nilai viN mudhal muzhuvadhum"],[2799,"உளன் எனில் உளன் அவன் உருவம் இவ்வுருவுகள்","uLan enil uLan avan uruvam ivvuruvugaL"],[2800,"பரந்த தண் பரவையுள் நீர் தொறும் பரந்துளன்","parandha thaN paravaiyuL nIr thoRum parandhuLan"],[2801,"கர விசும்பு எரி வளி நீர் நிலம் இவை மிசை","kara visumbu eri vaLi nIr nilam ivai misai"],[2802,"வீடுமின் முற்றவும்","vIDumin muRRavum"],[2803,"மின்னின் நிலையில","minnin nilaiyila"],[2804,"நீர் நுமது என்றிவை","nIr numadhu enRivai"],[2805,"இல்லதும் உள்ளதும்","illadhum uLLadhum"],[2806,"அற்றது பற்று எனில்","aRRadhu paRRu enil"],[2807,"பற்றிலன் ஈசனும்","paRRilan Isanum"],[2808,"அடங்கெழில் சம்பத்து","aDanggezhil sampaththu"],[2809,"உள்ளம் உரை செயல்","uLLam urai seyal"],[2810,"ஒடுங்க அவண் கண்","oDungga avaN kaN"],[2811,"எண் பெருக்கு அந்நலத்து","eN perukku annalaththu"],[2812,"சேர்த் தடத் தென் குரு","sErth thaDath then kuru"],[2813,"பத்துடை அடியவர்க்கு எளியவன் பிறர்களுக்கு அரிய","paththuDai aDiyavarkku eLiyavan piRargaLukku ariya"],[2814,"எளிவரும் இயல்வினன் நிலை வரம்பில பல பிறப்பாய்","eLivarum iyalvinan nilai varambila pala piRappAy"],[2815,"அமைவுடை அற நெறி முழுவதும் உயர்வற உயர்ந்து","amaivuDai aRa neRi muzhuvadhum uyarvaRa uyarndhu"],[2816,"யாரும் ஓர் நிலைமையன் என அறிவரிய எம்பெருமான்","yArum Or nilaimaiyan ena aRivariya emperumAn"],[2817,"பிணக்கற அறு வகைச் சமயமும் நெறி உள்ளி உரைத்த","piNakkaRa aRu vagaich samayamum neRi uLLi uraiththa"],[2818,"உணர்ந்து உணர்ந்து இழிந்து அகன்று உயர்ந்துரு வியந்த இந்நிலைமை","uNarndhu uNarndhu izhindhu aganRu uyarndhuru viyandha innilaimai"],[2819,"ஒன்றெனப் பல என அறிவரும் வடிவினுள் நின்ற","onRenap pala ena aRivarum vaDivinuL ninRa"],[2820,"நாளும் நின்றடு நம பழமை அங்கொடு வினை உடனே","nALum ninRaDu nama pazhamai anggoDu vinai uDanE"],[2821,"வலத்தனன் திரிபுரம் எரித்தவன் இடம் பெறத்துந்தித்","valaththanan thiripuram eriththavan iDam peRaththundhith"],[2822,"துயக்கறு மதியில் நல் ஞானத்துள் அமரரைத் துயக்கும்","thuyakkaRu madhiyil nal njAnaththuL amararaith thuyakkum"],[2823,"அமரர்கள் தொழுது எழ அலைகடல் கடைந்தவன் தன்னை","amarargaL thozhudhu ezha alaikaDal kaDaindhavan thannai"],[2824,"அஞ்சிறைய மட நாராய்! அளியத்தாய்! நீயும் நின்","anjchiRaiya maDa nArAy! aLiyaththAy! nIyum nin"],[2825,"என் செய்ய தாமரைக் கண் பெருமானார்க்கு என் தூதாய்","en seyya thAmaraik kaN perumAnArkku en thUdhAy"],[2826,"விதியினால் பெடை மணக்கும் மென்னடைய அன்னங்காள்!","vidhiyinAl peDai maNakkum mennaDaiya annanggAL!"],[2827,"என் நீர்மை கண்டு இரங்கி இது தகாது என்னாத","en nIrmai kaNDu iranggi idhu thagAdhu ennAdha"],[2828,"நல்கித் தான் காத்து அளிக்கும் பொழில் ஏழும் வினையேற்கே","nalgith thAn kAththu aLikkum pozhil Ezhum vinaiyERkE"],[2829,"அருளாத நீர் அருளி அவர் ஆவி துவரா முன்","aruLAdha nIr aruLi avar Avi thuvarA mun"],[2830,"என்பு இழை கோப்பது போலப் பனி வாடை ஈர்கின்ற","enbu izhai kOppadhu pOlap pani vADai IrginRa"],[2831,"நீ அலையே? சிறு பூவாய்! நெடுமாலார்க்கு என் தூதாய்","nI alaiyE? siRu pUvAy! neDumAlArkku en thUdhAy"],[2832,"நாடாத மலர் நாடி நாள் தோறும் நாரணன் தன்","nADAdha malar nADi nAL thORum nAraNan than"],[2833,"உடல் ஆழிப் பிறப்பு வீடு உயிர் முதலா முற்றுமாய்","uDal Azhip piRappu vIDu uyir mudhalA muRRumAy"],[2834,"அளவியன்ற ஏழ் உலகத்தவர் பெருமான் கண்ணனை","aLaviyanRa Ezh ulagaththavar perumAn kaNNanai"],[2835,"வளவேழ் உலகின் முதலாய வானோர் இறையை அருவினையேன்","vaLavEzh ulagin mudhalAya vAnOr iRaiyai aruvinaiyEn"],[2836,"நினைந்து நைந்து உள் கரைந்து உருகி இமையோர் பலரும் முனிவரும்","ninaindhu naindhu uL karaindhu urugi imaiyOr palarum munivarum"],[2837,"மா யோனிகளாய் நடை கற்ற வானோர் பலரும் முனிவரும்","mA yOnigaLAy naDai kaRRa vAnOr palarum munivarum"],[2838,"தான் ஓர் உருவே தனி வித்தாய்த் தன்னில் மூவர் முதலாய","thAn Or uruvE thani viththAyth thannil mUvar mudhalAya"],[2839,"மான் ஏய் நோக்கி மடவாளை மார்வில் கொண்டாய்! மாதவா!","mAn Ey nOkki maDavALai mArvil koNDAy! mAdhavA!"],[2840,"வினையேன் வினை தீர் மருந்தானாய்! விண்ணோர் தலைவா! கேசவா!","vinaiyEn vinai thIr marundhAnAy! viNNOr thalaivA! kEsavA!"],[2841,"அடியேன் சிறிய ஞானத்தன் அறிதல் ஆர்க்கும் அரியானை","aDiyEn siRiya njAnaththan aRidhal Arkkum ariyAnai"],[2842,"உண்டாய் உலகேழ் முன்னமே உமிழ்ந்து மாயையால் புக்கு","uNDAy ulagEzh munnamE umizhndhu mAyaiyAl pukku"],[2843,"மாயோம் தீய அலவலைப் பெரு மா வஞ்சப் பேய் வீய","mAyOm thIya alavalaip peru mA vanjchap pEy vIya"],[2844,"சார்ந்த இரு வல் வினைகளும் சரித்து மாயப் பற்று அறுத்து","sArndha iru val vinaigaLum sariththu mAyap paRRu aRuththu"],[2845,"மாலே! மாயப் பெருமானே! மாமாயனே! என்றென்று","mAlE! mAyap perumAnE! mAmAyanE! enRenRu"],[2846,"பரிவதில் ஈசனைப் பாடி","parivadhil Isanaip pADi"],[2847,"மது வார் தண்ணந்துழாயான்","madhu vAr thaNNanthuzhAyAn"],[2848,"ஈடும் எடுப்பும் இல் ஈசன்","IDum eDuppum il Isan"],[2849,"அணங்கு என ஆடும் என் அங்கம்","aNanggu ena ADum en anggam"],[2850,"கொள்கை கொளாமை இலாதான்","koLgai koLAmai ilAdhAn"],[2851,"அமுதம் அமரர்கட்கு ஈந்த","amudham amarargaTku Indha"],[2852,"நீள் கடல் சூழ் இலங்கைக் கோன்","nIL kaDal sUzh ilanggaik kOn"],[2853,"கழிமின் தொண்டீர்கள்! கழித்து","kazhimin thoNDIrgaL! kazhiththu"],[2854,"தரும அரும் பயனாய","tharuma arum payanAya"],[2855,"கடிவார் தீய வினைகள்","kaDivAr thIya vinaigaL"],[2856,"மாதவன் பால் சடகோபன்","mAdhavan pAl saDakOpan"],[2857,"பிறவித் துயர் அற ஞானத்துள் நின்று","piRavith thuyar aRa njAnaththuL ninRu"],[2858,"வைப்பாம் மருந்தாம் அடியரை வல்வினைத்","vaippAm marundhAm aDiyarai valvinaith"],[2859,"ஆயர் கொழுந்தாய் அவரால் புடை உண்ணும்","Ayar kozhundhAy avarAl puDai uNNum"],[2860,"மயர்வு அற என் மனத்தே மன்னினான் தன்னை","mayarvu aRa en manaththE manninAn thannai"],[2861,"விடுவேனோ? என் விளக்கை என் ஆவியை","viDuvEnO? en viLakkai en Aviyai"],[2862,"பிரான் பெரு நிலம் கீண்டவன் பின்னும்","pirAn peru nilam kINDavan pinnum"],[2863,"யான் ஒட்டி என்னுள் இருத்துவம் என்றிலன்","yAn oTTi ennuL iruththuvam enRilan"],[2864,"என்னை நெகிழ்க்கிலும் என்னுடை நல் நெஞ்சம்","ennai negizhkkilum ennuDai nal nenjcham"],[2865,"அமரர் முழு முதல் ஆகிய ஆதியை","amarar muzhu mudhal Agiya Adhiyai"],[2866,"அகலில் அகலும் அணுகில் அணுகும்","agalil agalum aNugil aNugum"],[2867,"குடைந்து வண்டுண்ணும் துழாய் முடியானை","kuDaindhu vaNDuNNum thuzhAy muDiyAnai"],[2868,"ஓடும் புள் ஏறி","ODum puL ERi"],[2869,"அம்மானாய்ப் பின்னும்","ammAnAyp pinnum"],[2870,"கண் ஆவான் என்றும்","kaN AvAn enRum"],[2871,"வெற்பை ஒன்று எடுத்து","veRpai onRu eDuththu"],[2872,"வைகலும் வெண்ணெய்","vaigalum veNNey"],[2873,"கலந்து என் ஆவி","kalandhu en Avi"],[2874,"கொண்டான் ஏழ் விடை","koNDAn Ezh viDai"],[2875,"ஆனான் ஆன் ஆயன்","AnAn An Ayan"],[2876,"சங்கு சக்கரம்","sanggu chakkaram"],[2877,"நாதன் ஞாலம் கொள்","nAdhan njAlam koL"],[2878,"நீர் புரை வண்ணன்","nIr purai vaNNan"],[2879,"இவையும் அவையும் உவையும் இவரும் அவரும் உவரும்","ivaiyum avaiyum uvaiyum ivarum avarum uvarum"],[2880,"சூழல் பல பல வல்லான் தொல்லையம் காலத்து உலகை","sUzhal pala pala vallAn thollaiyam kAlaththu ulagai"],[2881,"அருகல் இலாய பெருஞ்சீர் அமரர்கள் ஆதி முதல்வன்","arugal ilAya perunjchIr amarargaL Adhi mudhalvan"],[2882,"உடன் அமர் காதல் மகளிர் திருமகள் மண்மகள் ஆயர்","uDan amar kAdhal magaLir thirumagaL maNmagaL Ayar"],[2883,"ஒக்கலை வைத்து முலைப் பால் உண்ணென்று தந்திட வாங்கி","okkalai vaiththu mulaip pAl uNNenRu thandhiDa vAnggi"],[2884,"மாயன் என் நெஞ்சின் உள்ளன் மற்றும் யவர்க்கும் அஃதே","mAyan en nenjchin uLLan maRRum yavarkkum aqdhE"],[2885,"தோளிணை மேலும் நன்மார்பின் மேலும் சுடர் முடி மேலும்","thOLiNai mElum nanmArbin mElum suDar muDi mElum"],[2886,"நாவினுள் நின்று மலரும் ஞானக் கலைகளுக்கு எல்லாம்","nAvinuL ninRu malarum njAnak kalaigaLukku ellAm"],[2887,"கமலக் கண்ணன் என் கண்ணின் உள்ளான் காண்பன் அவன் கண்களாலே","kamalak kaNNan en kaNNin uLLAn kANban avan kaNgaLAlE"],[2888,"நெற்றியுள் நின்று என்னை ஆளும் நிரை மலர்ப் பாதங்கள் சூடி","neRRiyuL ninRu ennai ALum nirai malarp pAdhanggaL sUDi"],[2889,"உச்சி உள்ளே நிற்கும் தேவ தேவற்குக் கண்ணபிராற்கு","uchchi uLLE niRkum dhEva dhEvaRkuk kaNNapirARku"],[2890,"பொரு மா நீள் படை ஆழி சங்கத்தொடு","poru mA nIL paDai Azhi sanggaththoDu"],[2891,"கண்ணுள்ளே நிற்கும் காதன்மையால் தொழில்","kaNNuLLE niRkum kAdhanmaiyAl thozhil"],[2892,"எம்பிரானை எந்தை தந்தை தந்தைக்கும்","empirAnai endhai thandhai thandhaikkum"],[2893,"நெஞ்சமே நல்லை நல்லை உன்னைப் பெற்றால்","nenjchamE nallai nallai unnaip peRRAl"],[2894,"கண்டாயே நெஞ்சே! கருமங்கள் வாய்க்கின்று ஓர்","kaNDAyE nenjchE! karumanggaL vAykkinRu Or"],[2895,"நீயும் நானும் இந்நேர் நிற்கில் மேல் மற்றோர்","nIyum nAnum innEr niRkil mEl maRROr"],[2896,"எந்தையே என்றும் எம்பெருமான் என்றும்","endhaiyE enRum emperumAn enRum"],[2897,"செல்வ நாரணன் என்ற சொல் கேட்டலும்","selva nAraNan enRa sol kETTalum"],[2898,"நம்பியைத் தென்குறுங்குடி நின்ற அச்","nambiyaith thenkuRungkuDi ninRa ach"],[2899,"மறப்பும் ஞானமும் நான் ஒன்று உணர்ந்திலன்","maRappum njAnamum nAn onRu uNarndhilan"],[2900,"மணியை வானவர் கண்ணனைத் தன்னதோர்","maNiyai vAnavar kaNNanaith thannadhOr"],[2901,"வாயும் திரை உகளும் கானல் மட நாராய்!","vAyum thirai ugaLum kAnal maDa nArAy!"],[2902,"கோட்பட்ட சிந்தையையாய்க் கூர் வாய அன்றிலே!","kOTpaTTa sindhaiyaiyAyk kUr vAya anRilE!"],[2903,"காமுற்ற கை அறவோடு எல்லே! இராப் பகல்","kAmuRRa kai aRavODu ellE! irAp pagal"],[2904,"கடலும் மலையும் விசும்பும் துழாய் எம் போல்","kaDalum malaiyum visumbum thuzhAy em pOl"],[2905,"ஊழி தோறு ஊழி உலகுக்கு நீர் கொண்டு","Uzhi thORu Uzhi ulagukku nIr koNDu"],[2906,"நைவாய எம்மே போல் நாள் மதியே! நீ இந்நாள்","naivAya emmE pOl nAL madhiyE! nI innAL"],[2907,"தோற்றோம் மட நெஞ்சம் எம்பெருமான் நாரணற்கு எம்","thORROm maDa nenjcham emperumAn nAraNaRku em"],[2908,"இருளின் திணி வண்ணம் மா நீர்க் கழியே! போய்","iruLin thiNi vaNNam mA nIrk kazhiyE! pOy"],[2909,"நொந்தாராக் காதல் நோய் மெல் ஆவி உள் உலர்த்த","nondhArAk kAdhal nOy mel Avi uL ularththa"],[2910,"வேவாரா வேட்கை நோய் மெல் ஆவி உள் உலர்த்த","vEvArA vETkai nOy mel Avi uL ularththa"],[2911,"சோராத எப்பொருட்கும் ஆதியாம் சோதிக்கே","sOrAdha epporuTkum AdhiyAm sOdhikkE"],[2912,"திண்ணன் வீடு முதல் முழுதுமாய்","thiNNan vIDu mudhal muzhudhumAy"],[2913,"ஏ பாவம்! பரமே! ஏழ் உலகும்","E pAvam! paramE! Ezh ulagum"],[2914,"ஏறனைப் பூவனைப் பூமகள் தன்னை","ERanaip pUvanaip pUmagaL thannai"],[2915,"தேவும் எப்பொருளும் படைக்க","thEvum epporuLum paDaikka"],[2916,"தகும் சீர்த் தன் தனி முதலினுள்ளே","thagum sIrth than thani mudhalinuLLE"],[2917,"யவரும் யாவையும் எல்லாப் பொருளும்","yavarum yAvaiyum ellAp poruLum"],[2918,"பள்ளி ஆலிலை ஏழுலகும் கொள்ளும்","paLLi Alilai Ezhulagum koLLum"],[2919,"கருத்தில் தேவும் எல்லாப் பொருளும்","karuththil thEvum ellAp poruLum"],[2920,"காக்கும் இயல்வினன் கண்ண பெருமான்","kAkkum iyalvinan kaNNa perumAn"],[2921,"கள்வா! எம்மையும் ஏழுலகும் நின்","kaLvA! emmaiyum Ezhulagum nin"],[2922,"ஏத்த ஏழுலகும் கொண்ட கோலக்","Eththa Ezhulagum koNDa kOlak"],[2923,"ஊனில் வாழ் உயிரே! நல்லை போ உன்னைப் பெற்று","Unil vAzh uyirE! nallai pO unnaip peRRu"],[2924,"ஒத்தார் மிக்காரை இலை ஆய மா மாயா!","oththAr mikkArai ilai Aya mA mAyA!"],[2925,"அறியாக் காலத்துள்ளே அடிமைக் கண் அன்பு செய்வித்து","aRiyAk kAlaththuLLE aDimaik kaN anbu seyviththu"],[2926,"எனதாவி உள் கலந்த பெரு நல் உதவிக் கைம்மாறு","enadhAvi uL kalandha peru nal udhavik kaimmARu"],[2927,"இனி யார் ஞானங்களால் எடுக்கல் எழாத எந்தாய்","ini yAr njAnanggaLAl eDukkal ezhAdha endhAy"],[2928,"சேர்ந்தார் தீ வினைகட்கு அரு நஞ்சைத் திண் மதியை","sErndhAr thI vinaigaTku aru nanjchaith thiN madhiyai"],[2929,"முன் நல் யாழ் பயில் நூல் நரம்பின் முதிர் சுவையே!","mun nal yAzh payil nUl narambin mudhir suvaiyE!"],[2930,"குறிக்கொள் ஞானங்களால் எனை ஊழி செய் தவமும்","kuRikkoL njAnanggaLAl enai Uzhi sey thavamum"],[2931,"கடி வார் தண்ணந்துழாய்க் கண்ணன் விண்ணவர் பெருமான்","kaDi vAr thaNNanthuzhAyk kaNNan viNNavar perumAn"],[2932,"களிப்பும் கவர்வும் அற்றுப் பிறப்புப் பிணி மூப்பு இறப்பு அற்று","kaLippum kavarvum aRRup piRappup piNi mUppu iRappu aRRu"],[2933,"குழாங்கொள் பேர் அரக்கன் குலம் வீய முனிந்தவனை","kuzhAngkoL pEr arakkan kulam vIya munindhavanai"],[2934,"ஆடி ஆடி அகம் கரைந்து இசை","ADi ADi agam karaindhu isai"],[2935,"வாணுதல் இம்மடவரல் உம்மைக்","vANudhal immaDavaral ummaik"],[2936,"இரக்க மனத்தோடு எரி அணை","irakka manaththODu eri aNai"],[2937,"இலங்கை செற்றவனே! என்னும் பின்னும்","ilanggai seRRavanE! ennum pinnum"],[2938,"இவள் இராப் பகல் வாய் வெரீஇ தன","ivaL irAp pagal vAy verIi thana"],[2939,"தகவு உடையவனே! என்னும் பின்னும்","thagavu uDaiyavanE! ennum pinnum"],[2940,"உள்ளுள் ஆவி உலர்ந்து உலர்ந்து என","uLLuL Avi ularndhu ularndhu ena"],[2941,"வஞ்சனே! என்னும் கை தொழும் தன","vanjchanE! ennum kai thozhum thana"],[2942,"பட்ட போது எழு போது அறியாள் விரை","paTTa pOdhu ezhu pOdhu aRiyAL virai"],[2943,"ஏழை பேதை இராப் பகல் தன","Ezhai pEdhai irAp pagal thana"],[2944,"வாட்டம் இல் புகழ் வாமனனை இசை","vATTam il pugazh vAmananai isai"],[2945,"அந்தாமத்து அன்பு செய்து என் ஆவி சேர் அம்மானுக்கு","anthAmaththu anbu seydhu en Avi sEr ammAnukku"],[2946,"திரு உடம்பு வான் சுடர் செந்தாமரைக் கண் கை கமலம்","thiru uDambu vAn suDar senthAmaraik kaN kai kamalam"],[2947,"என்னுள் கலந்தவன் செங்கனி வாய் செங்கமலம்","ennuL kalandhavan sengkani vAy sengkamalam"],[2948,"எப்பொருளும் தானாய் மரதகக் குன்றம் ஒக்கும்","epporuLum thAnAy maradhagak kunRam okkum"],[2949,"ஆரா அமுதமாய் அல்லாவி உள்கலந்த","ArA amudhamAy allAvi uLkalandha"],[2950,"பல பலவே ஆபரணம் பேரும் பல பலவே","pala palavE AbaraNam pErum pala palavE"],[2951,"பாம்பணை மேல் பாற்கடலுள் பள்ளி அமர்ந்ததுவும்","pAmbaNai mEl pARkaDaluL paLLi amarndhadhuvum"],[2952,"பொன் முடி அம்போர் ஏற்றை எம்மானை நால் தடந்தோள்","pon muDi ampOr ERRai emmAnai nAl thaDanthOL"],[2953,"சொல்லீர் என் அம்மானை என்னாவி ஆவி தனை","sollIr en ammAnai ennAvi Avi thanai"],[2954,"ஆண் அல்லன் பெண் அல்லன் அல்லா அலியும் அல்லன்","AN allan peN allan allA aliyum allan"],[2955,"கூறுதல் ஒன்று ஆராக் குடக் கூத்த அம்மானை","kURudhal onRu ArAk kuDak kUththa ammAnai"],[2956,"வைகுந்தா! மணிவண்ணனே! என் பொல்லாத் திருக்குறளா! என்னுள் மன்னி","vaikunthA! maNivaNNanE! en pollAth thirukkuRaLA! ennuL manni"],[2957,"சிக்கெனச் சிறிதோர் இடமும் புறப்படாத் தன் உள்ளே உலகுகள்","sikkenach siRidhOr iDamum puRappaDAth than uLLE ulagugaL"],[2958,"தாமரைக் கண்ணனை விண்ணோர் பரவும் தலைமகனை துழாய் விரைப்","thAmaraik kaNNanai viNNOr paravum thalaimaganai thuzhAy viraip"],[2959,"வள்ளலே! மதுசூதனா! என் மரதக மலையே! உனை நினைந்து","vaLLalE! madhusUdhanA! en maradhaga malaiyE! unai ninaindhu"],[2960,"உய்ந்து போந்து என் உலப்பிலாத வெந்தீ வினைகளை நாசம் செய்து உனது","uyndhu pOndhu en ulappilAdha venthI vinaigaLai nAsam seydhu unadhu"],[2961,"உன்னைச் சிந்தை செய்து செய்து உன் நெடு மா மொழி இசை பாடி ஆடி என்","unnaich sindhai seydhu seydhu un neDu mA mozhi isai pADi ADi en"],[2962,"முடியாதது என் எனக்கேல் இனி? முழு ஏழ் உலகும் உண்டான் உகந்து வந்து","muDiyAdhadhu en enakkEl ini? muzhu Ezh ulagum uNDAn ugandhu vandhu"],[2963,"மாறி மாறிப் பல பிறப்பும் பிறந்து அடியை அடைந்து உள்ளம் தேறி","mARi mARip pala piRappum piRandhu aDiyai aDaindhu uLLam thERi"],[2964,"எந்தாய்! தண் திருவேங்கடத்துள் நின்றாய்! இலங்கை செற்றாய்! மராமரம்","endhAy! thaN thiruvEngkaDaththuL ninRAy! ilanggai seRRAy! marAmaram"],[2965,"போகின்ற காலங்கள் போய காலங்கள் போகு காலங்கள் தாய் தந்தை உயிர்","pOginRa kAlanggaL pOya kAlanggaL pOgu kAlanggaL thAy thandhai uyir"],[2966,"கண்ணித் தண்ணந்துழாய் முடிக் கமலத் தடம் பெருங்கண்ணனை புகழ்","kaNNith thaNNanthuzhAy muDik kamalath thaDam perungkaNNanai pugazh"],[2967,"கேசவன் தமர் கீழ் மேல் எமர் ஏழ் எழு பிறப்பும்","kEsavan thamar kIzh mEl emar Ezh ezhu piRappum"],[2968,"நாரணன் முழு ஏழ் உலகுக்கும் நாதன் வேத மயன்","nAraNan muzhu Ezh ulagukkum nAthan vEdha mayan"],[2969,"மாதவன் என்றதே கொண்டு என்னை இனி இப்பால் பட்டது","mAdhavan enRadhE koNDu ennai ini ippAl paTTadhu"],[2970,"கோவிந்தன் குடக்கூத்தன் கோவலன் என்றென்றே குனித்து","gOvindhan kuDakkUththan kOvalan enRenRE kuniththu"],[2971,"விட்டிலங்கு செஞ்சோதித் தாமரை பாதம் கைகள் கண்கள்","viTTilanggu senjchOdhith thAmarai pAdham kaigaL kaNgaL"],[2972,"மதுசூதனை அன்றி மற்றிலேன் என்று எத்தாலும் கருமம் இன்றி","madhusUdhanai anRi maRRilEn enRu eththAlum karumam inRi"],[2973,"திரிவிக்கிரமன் செந்தாமரைக் கண் எம்மான் என் செங்கனி வாய்","thirivikkiraman senthAmaraik kaN emmAn en sengkani vAy"],[2974,"வாமனன் என் மரதக வண்ணன்! தாமரைக் கண்ணினன்!","vAmanan en maradhaga vaNNan! thAmaraik kaNNinan!"],[2975,"சிரீஇதரன் செய்ய தாமரைக் கண்ணன் என்றென்று இராப் பகல் வாய்","sirIidharan seyya thAmaraik kaNNan enRenRu irAp pagal vAy"],[2976,"இருடீகேசன் எம்பிரான் இலங்கை அரக்கர் குலம்","iruDIkEsan empirAn ilanggai arakkar kulam"],[2977,"பற்பநாபன் உயர்வற உயரும் பெருந்திறலோன்","paRpanAban uyarvaRa uyarum perunthiRalOn"],[2978,"தாமோதரனைத் தனி முதல்வனை ஞாலம் உண்டவனை","dhAmOdharanaith thani mudhalvanai njAlam uNDavanai"],[2979,"வண்ண மா மணிச் சோதியை அமரர் தலை மகனை","vaNNa mA maNich sOdhiyai amarar thalai maganai"],[2980,"அணைவது அரவணை மேல் பூம்பாவை ஆகம்","aNaivadhu aravaNai mEl pUmpAvai Agam"],[2981,"நீந்தும் துயர்ப் பிறவி உட்பட மற்று எவ்வெவையும்","nIndhum thuyarp piRavi uTpaDa maRRu evvevaiyum"],[2982,"புணர்க்கும் அயனாம் அழிக்கும் அரனாம்","puNarkkum ayanAm azhikkum aranAm"],[2983,"புலன் ஐந்து மேயும் பொறி ஐந்து நீங்கி","pulan aindhu mEyum poRi aindhu nInggi"],[2984,"ஒவாத் துயர்ப் பிறவி உட்பட மற்று எவ்வெவையும்","ovAth thuyarp piRavi uTpaDa maRRu evvevaiyum"],[2985,"தீர்த்தன் உலகளந்த சேவடி மேல் பூந்தாமம்","thIrththan ulagaLandha sEvaDi mEl pUnthAmam"],[2986,"கிடந்து இருந்து நின்று அளந்து கேழலாய்க் கீழ் புக்கு","kiDandhu irundhu ninRu aLandhu kEzhalAyk kIzh pukku"],[2987,"காண்பார் ஆர்? எம் ஈசன் கண்ணனை என் காணும் ஆறு?","kANbAr Ar? em Isan kaNNanai en kANum ARu?"],[2988,"எங்கும் உளன் கண்ணன் என்ற மகனைக் காய்ந்து","enggum uLan kaNNan enRa maganaik kAyndhu"],[2989,"சீர்மை கொள் வீடு சுவர்க்க நரகு ஈறா","sIrmai koL vIDu suvarkka naragu IRA"],[2990,"கண் தலங்கள் செய்ய கருமேனி அம்மானை","kaN thalanggaL seyya karumEni ammAnai"],[2991,"எம்மா வீட்டுத் திறமும் செப்பம் நின்","emmA vITTuth thiRamum seppam nin"],[2992,"ஈதே யான் உன்னைக் கொள்வது எஞ்ஞான்றும் என்","IdhE yAn unnaik koLvadhu enjnjAnRum en"],[2993,"செய்யேல் தீ வினை என்று அருள் செய்யும் என்","seyyEl thI vinai enRu aruL seyyum en"],[2994,"எனக்கே ஆட்செய் எக்காலத்தும் என்று என்","enakkE ATsey ekkAlaththum enRu en"],[2995,"சிறப்பில் வீடு சுவர்க்க நரகம்","siRappil vIDu suvarkka naragam"],[2996,"மகிழ் கொள் தெய்வம் உலோகம் அலோகம்","magizh koL theyvam ulOgam alOgam"],[2997,"வாராய் உன் திருப்பாத மலர்க் கீழ்","vArAy un thiruppAdha malark kIzh"],[2998,"எக்காலத்து எந்தையாய் என்னுள் மன்னில் மற்று","ekkAlaththu endhaiyAy ennuL mannil maRRu"],[2999,"யானே என்னை அறிய கிலாதே","yAnE ennai aRiya kilAdhE"],[3000,"ஏறேல் ஏழும் வென்று ஏர் கொள் இலங்கையை","EREl Ezhum venRu Er koL ilanggaiyai"],[3001,"விடலில் சக்கரத்து அண்ணலை மேவல்","viDalil chakkaraththu aNNalai mEval"],[3002,"கிளர் ஒளி இளமை கெடுவதன் முன்னம்","kiLar oLi iLamai keDuvadhan munnam"],[3003,"சதிர் இள மடவார் தாழ்ச்சியை மதியாது","sadhir iLa maDavAr thAzhchchiyai madhiyAdhu"],[3004,"பயன் அல்ல செய்து பயன் இல்லை நெஞ்சே!","payan alla seydhu payan illai nenjchE!"],[3005,"கரும வன் பாசம் கழித்து உழன்று உய்யவே","karuma van pAsam kazhiththu uzhanRu uyyavE"],[3006,"திறம் உடை வலத்தால் தீ வினை பெருக்காது","thiRam uDai valaththAl thI vinai perukkAdhu"],[3007,"கிறி என நினைமின் கீழ்மை செய்யாதே","kiRi ena ninaimin kIzhmai seyyAdhE"],[3008,"நலம் என நினைமின் நரகு அழுந்தாதே","nalam ena ninaimin naragu azhundhAdhE"],[3009,"வலம் செய்து வைகல் வலம் கழியாதே","valam seydhu vaigal valam kazhiyAdhE"],[3010,"வழக்கென நினைமின் வல்வினை மூழ்காது","vazhakkena ninaimin valvinai mUzhgAdhu"],[3011,"சூது என்று களவும் சூதும் செய்யாதே","sUdhu enRu kaLavum sUdhum seyyAdhE"],[3012,"பொருள் என்று இவ்வுலகம் படைத்தவன் புகழ் மேல்","poruL enRu ivvulagam paDaiththavan pugazh mEl"],[3013,"முடிச் சோதியாய் உனது முகச் சோதி மலர்ந்ததுவோ?","muDich chOdhiyAy unadhu mugach chOdhi malarndhadhuvO?"],[3014,"கட்டுரைக்கில் தாமரை நின் கண் பாதம் கை ஒவ்வா","kaTTuraikkil thAmarai nin kaN pAdham kai ovvA"],[3015,"பரஞ்சோதி! நீ பரமாய் நின் இகழ்ந்து பின் மற்றோர்","paranjchOdhi! nI paramAy nin igazhndhu pin maRROr"],[3016,"மாட்டாதே ஆகிலும் இம்மலர் தலை மா ஞாலம் நின்","mATTAdhE Agilum immalar thalai mA njAlam nin"],[3017,"வருந்தாத அருந்தவத்த மலர் கதிரின் சுடர் உடம்பாய்","varundhAdha arunthavaththa malar kadhirin suDar uDambAy"],[3018,"ஓதுவார் ஓத்தெல்லாம் எவ்வுலகத்து எவ்வெவையும்","OdhuvAr OththellAm evvulagaththu evvevaiyum"],[3019,"வாழ்த்துவார் பலர் ஆக நின்னுள்ளே நான்முகனை","vAzhththuvAr palar Aga ninnuLLE nAnmuganai"],[3020,"மாசூணாச் சுடர் உடம்பாய் மலராது குவியாது","mAsUNAch suDar uDambAy malarAdhu kuviyAdhu"],[3021,"மழுங்காத வைந்நுதிய சக்கர நல் வலத்தையாய்","mazhunggAdha vainnudhiya chakkara nal valaththaiyAy"],[3022,"மறை ஆய நால் வேதத்துள் நின்ற மலர்ச் சுடரே!","maRai Aya nAl vEdhaththuL ninRa malarch chuDarE!"],[3023,"வியப்பாய வியப்பில்லா மெய்ஞ்ஞான வேதியனை","viyappAya viyappu illA meynjnjAna vEdhiyanai"],[3024,"முந்நீர் ஞாலம் படைத்த எம் முகில் வண்ணனே!","munnIr njAlam paDaiththa em mugil vaNNanE!"],[3025,"வன் மா வையம் அளந்த எம் வாமனா! நின்","van mA vaiyam aLandha em vAmanA! nin"],[3026,"கொல்லா மாக் கோல் கொலை செய்து பாரதப் போர்","kollA mAk kOl kolai seydhu bArathap pOr"],[3027,"சூழ்ச்சி ஞானச் சுடர் ஒளி ஆகி என்றும்","sUzhchchi njAnach suDar oLi Agi enRum"],[3028,"வந்தாய் போலே வந்தும் என் மனத்தினை நீ","vandhAy pOlE vandhum en manaththinai nI"],[3029,"கிற்பன் கில்லேன் என்றிலன் முன நாளால்","kiRpan killEn enRilan muna nALAl"],[3030,"எஞ்ஞான்று நாம் இருந்து இருந்து இரங்கி நெஞ்சே!","enjnjAnRu nAm irundhu irundhu iranggi nenjchE!"],[3031,"மேவு துன்ப வினைகளை விடுத்தும் இலேன்","mEvu thunba vinaigaLai viDuththum ilEn"],[3032,"கூவிக் கூவிக் கொடு வினைத் தூற்றுள் நின்று","kUvik kUvik koDu vinaith thURRuL ninRu"],[3033,"தலைப்பெய் காலம் நமன் தமர் பாசம் விட்டால்","thalaippey kAlam naman thamar pAsam viTTAl"],[3034,"உயிர்கள் எல்லா உலகமும் உடையவனை","uyirgaL ellA ulagamum uDaiyavanai"],[3035,"ஒழிவில் காலம் எல்லாம் உடனாய் மன்னி","ozhivil kAlam ellAm uDanAy manni"],[3036,"எந்தை தந்தை தந்தை தந்தை தந்தைக்கும்","endhai thandhai thandhai thandhai thandhaikkum"],[3037,"அண்ணல் மாயன் அணி கொள் செந்தாமரைக்","aNNal mAyan aNi koL senthAmaraik"],[3038,"ஈசன் வானவர்க்கு என்பன் என்றால் அது","Isan vAnavarkku enban enRAl adhu"],[3039,"சோதி ஆகி எல்லா உலகும் தொழும்","sOdhi Agi ellA ulagum thozhum"],[3040,"வேம் கடங்கள் மெய் மேல் வினை முற்றவும்","vEm kaDanggaL mey mEl vinai muRRavum"],[3041,"சுமந்து மா மலர் நீர் சுடர் தூபம் கொண்டு","sumandhu mA malar nIr suDar dhUpam koNDu"],[3042,"குன்றம் ஏந்திக் குளிர் மழை காத்தவன்","kunRam Endhik kuLir mazhai kAththavan"],[3043,"ஓயு மூப்புப் பிறப்பு இறப்புப் பிணி","Oyu mUppup piRappu iRappup piNi"],[3044,"வைத்த நாள் வரை எல்லை குறுகிச் சென்று","vaiththa nAL varai ellai kuRugich senRu"],[3045,"தாள் பரப்பி மண் தாவிய ஈசனை","thAL parappi maN thAviya Isanai"],[3046,"புகழு நல் ஒருவன் என்கோ? பொருவில் சீர்ப் பூமி என்கோ?","pugazhu nal oruvan engO? poruvil sIrp bUmi engO?"],[3047,"கூவும் ஆறு அறிய மாட்டேன் குன்றங்கள் அனைத்தும் என்கோ?","kUvum ARu aRiya mATTEn kunRanggaL anaiththum engO?"],[3048,"பங்கயக் கண்ணன் என்கோ? பவளச் செவ்வாயன் என்கோ?","panggayak kaNNan engO? pavaLach sevvAyan engO?"],[3049,"சாதி மாணிக்கம் என்கோ? சவி கொள் பொன் முத்தம் என்கோ?","sAdhi mANikkam engO? savi koL pon muththam engO?"],[3050,"அச்சுதன் அமலன் என்கோ? அடியவர் வினை கெடுக்கும்","achchudhan amalan engO? aDiyavar vinai keDukkum"],[3051,"பால் என்கோ? நான்கு வேதப் பயன் என்கோ? சமய நீதி","pAl engO? nAnku vEdhap payan engO? samaya nIdhi"],[3052,"வானவர் ஆதி என்கோ? வானவர் தெய்வம் என்கோ?","vAnavar Adhi engO? vAnavar dheyvam engO?"],[3053,"ஒளி மணி வண்ணன் என்கோ? ஒருவன் என்று ஏத்த நின்ற","oLi maNi vaNNan engO? oruvan enRu Eththa ninRa"],[3054,"கண்ணனை மாயன் தன்னைக் கடல் கடைந்து அமுதம் கொண்ட","kaNNanai mAyan thannaik kaDal kaDaindhu amudham koNDa"],[3055,"யாவையும் யவரும் தான் ஆய் அவர் அவர் சமயம் தோறும்","yAvaiyum yavarum thAn Ay avar avar samayam thORum"],[3056,"கூடி வண்டறையும் தண்தார்க் கொண்டல் போல் வண்ணன் தன்னை","kUDi vaNDaRaiyum thaNthArk koNDal pOl vaNNan thannai"],[3057,"மொய் மாம் பூம்பொழில் பொய்கை முதலைச் சிறைப்பட்டு நின்ற","moy mAm pUmpozhil poygai mudhalaich siRaippaTTu ninRa"],[3058,"தண்கடல் வட்டத்து உள்ளாரைத் தமக்கு இரையாத் தடிந்துண்ணும்","thaNkaDal vaTTaththu uLLAraith thamakku iraiyAth thaDindhuNNum"],[3059,"மலையை எடுத்துக் கல் மாரி காத்துப் பசு நிரை தன்னை","malaiyai eDuththuk kal mAri kAththup pasu nirai thannai"],[3060,"வம்பவிழ் கோதை பொருட்டா மால் விடை ஏழும் அடர்த்த","vambavizh kOdhai poruTTA mAl viDai Ezhum aDarththa"],[3061,"சாது சனத்தை நலியும் கஞ்சனைச் சாதிப்பதற்கு","sAdhu sanaththai naliyum kanjchanaich sAdhippadhaRku"],[3062,"மனிசரும் மற்றும் முற்றுமாய் மாயப் பிறவி பிறந்த","manisarum maRRum muRRumAy mAyap piRavi piRandha"],[3063,"நீர்மை இல் நூற்றுவர் வீய ஐவர்க்கு அருள் செய்து நின்று","nIrmai il nURRuvar vIya aivarkku aruL seydhu ninRu"],[3064,"வார் புனல் அந்தண் அருவி வட திருவேங்கடத்து எந்தை","vAr punal anthaN aruvi vaDa thiruvEngkaDaththu endhai"],[3065,"அமரர் தொழப்படுவானை அனைத்துலகுக்கும் பிரானை","amarar thozhappaDuvAnai anaiththulagukkum pirAnai"],[3066,"கருமமும் கரும பலனும் ஆகிய காரணன் தன்னை","karumamum karuma palanum Agiya kAraNan thannai"],[3067,"தீர்ந்த அடியவர் தம்மைத் திருத்திப் பணி கொள்ள வல்ல","thIrndha aDiyavar thammaith thiruththip paNi koLLa valla"],[3068,"செய்ய தாமரைக் கண்ணனாய்","seyya thAmaraik kaNNanAy"],[3069,"மூவர் ஆகிய மூர்த்தியை முதல்","mUvar Agiya mUrththiyai mudhal"],[3070,"பரவி வானவர் ஏத்த நின்ற","paravi vAnavar Eththa ninRa"],[3071,"வைம்மின் நும் மனத்தென்று யான்","vaimmin num manaththenRu yAn"],[3072,"திரியும் காற்றோடு அகல் விசும்பு","thiriyum kARRODu agal visumbu"],[3073,"தோற்றக் கேடவை இல்லவன் உடையான்","thORRak kEDavai illavan uDaiyAn"],[3074,"எழுமைக்கும் எனது ஆவிக்கு","ezhumaikkum enadhu Avikku"],[3075,"துயரமே தரு துன்ப இன்ப","thuyaramE tharu thunba inba"],[3076,"தஞ்சம் ஆகிய தந்தை தாயொடு","thanjcham Agiya thandhai thAyoDu"],[3077,"கடல் வண்ணன் கண்ணன் விண்ணவர்","kaDal vaNNan kaNNan viNNavar"],[3078,"கண்கள் காண்டற்கு அரியனாய்க்","kaNgaL kANDaRku ariyanAyk"],[3079,"பயிலும் சுடர் ஒளி மூர்த்தியைப் பங்கயக் கண்ணனை","payilum suDar oLi mUrththiyaip panggayak kaNNanai"],[3080,"ஆளும் பரமனைக் கண்ணனை ஆழிப் பிரான் தன்னை","ALum paramanaik kaNNanai Azhip pirAn thannai"],[3081,"நாதனை ஞாலமும் வானமும் ஏத்தும் நறுந்துழாய்ப்","nAdhanai njAlamum vAnamum Eththum naRunthuzhAyp"],[3082,"உடை ஆர்ந்த ஆடையன் கண்டிகையன் உடை நாணினன்","uDai Arndha ADaiyan kaNDikaiyan uDai nANinan"],[3083,"பெருமக்கள் உள்ளவர் தம் பெருமானை அமரர்கட்கு","perumakkaL uLLavar tham perumAnai amarargaTku"],[3084,"அளிக்கும் பரமனைக் கண்ணனை ஆழிப் பிரான் தன்னை","aLikkum paramanaik kaNNanai Azhip pirAn thannai"],[3085,"சன்ம சன்மாந்தரம் காத்து அடியார்களைக் கொண்டு போய்","sanma sanmAntharam kAththu aDiyArgaLaik koNDu pOy"],[3086,"நம்பனை ஞாலம் படைத்தவனைத் திரு மார்பனை","nambanai njAlam paDaiththavanaith thiru mArbanai"],[3087,"குலம் தாங்கு சாதிகள் நாலிலும் கீழ் இழிந்து எத்தனை","kulam thAnggu sAdhigaL nAlilum kIzh izhindhu eththanai"],[3088,"அடி ஆர்ந்த வையம் உண்டு ஆலிலை அன்ன வசஞ்செய்யும்","aDi Arndha vaiyam uNDu Alilai anna vasanjcheyyum"],[3089,"அடி ஓங்கு நூற்றுவர் வீய அன்று ஐவருக்கு அருள் செய்த","aDi Onggu nURRuvar vIya anRu aivarukku aruL seydha"],[3090,"முடியானே! மூவுலகும் தொழுது ஏத்தும் சீர்","muDiyAnE! mUvulagum thozhudhu Eththum sIr"],[3091,"நெஞ்சமே! நீள் நகராக இருந்த என்","nenjchamE! nIL nagarAga irundha en"],[3092,"வாசகமே ஏத்த அருள் செய்யும் வானவர் தம்","vAsagamE Eththa aruL seyyum vAnavar tham"],[3093,"கைகளால் ஆரத் தொழுது தொழுது உன்னை","kaigaLAl Arath thozhudhu thozhudhu unnai"],[3094,"கண்களால் காண வருங்கொல்? என்று ஆசையால்","kaNgaLAl kANa varungkol? enRu AsaiyAl"],[3095,"செவிகளால் ஆர நின் கீர்த்திக் கனி என்னும்","sevigaLAl Ara nin kIrththik kani ennum"],[3096,"ஆவியே! ஆரமுதே! என்னை ஆள் உடை","AviyE! AramudhE! ennai AL uDai"],[3097,"கோலமே! தாமரைக் கண்ணதோர் அஞ்சன","kOlamE! thAmaraik kaNNadhOr anjchana"],[3098,"கொள்வன் நான் மாவலி! மூவடி தா என்ற","koLvan nAn mAvali! mUvaDi thA enRa"],[3099,"பொருந்திய மா மருதின் இடை போய எம்","porundhiya mA marudhin iDai pOya em"],[3100,"புலம்பு சீர்ப் பூமி அளந்த பெருமானை","pulambu sIrp bUmi aLandha perumAnai"],[3101,"சொன்னால் விரோதம் இது ஆகிலும் சொல்லுவன் கேண்மினோ","sonnAl virOdham idhu Agilum solluvan kENminO"],[3102,"உளன் ஆகவே எண்ணித் தன்னை ஒன்றாகத் தன் செல்வத்தை","uLan AgavE eNNith thannai onRAgath than selvaththai"],[3103,"ஒழிவு ஒன்று இல்லாத பல் ஊழி தோறூழி நிலாவ போம்","ozhivu onRu illAdha pal Uzhi thORUzhi nilAva pOm"],[3104,"என் ஆவது? எத்தெனை நாளைக்குப் போதும்? புலவீர்காள்!","en Avadhu? eththenai nALaikkup pOdhum? pulavIrgAL!"],[3105,"கொள்ளும் பயன் இல்லை குப்பை கிளர்த்தன்ன செல்வத்தை","koLLum payan illai kuppai kiLarththanna selvaththai"],[3106,"வம்மின் புலவீர்! நும் மெய் வருத்திக் கை செய்து உய்ம்மினோ","vammin pulavIr! num mey varuththik kai seydhu uymminO"],[3107,"சேரும் கொடை புகழ் எல்லை இலானை ஓர் ஆயிரம்","sErum koDai pugazh ellai ilAnai Or Ayiram"],[3108,"வேயின் மலி புரை தோளி பின்னைக்கு மணாளனை","vEyin mali purai thOLi pinnaikku maNALanai"],[3109,"வாய் கொண்டு மானிடம் பாட வந்த கவியேன் அல்லேன்","vAy koNDu mAniDam pADa vandha kaviyEn allEn"],[3110,"நின்று நின்று பல நாள் உய்க்கும் இவ்வுடல் நீங்கிப் போய்","ninRu ninRu pala nAL uykkum ivvuDal nInggip pOy"],[3111,"ஏற்கும் பெரும் புகழ் வானவர் ஈசன் கண்ணன் தனக்கு","ERkum perum pugazh vAnavar Isan kaNNan thanakku"],[3112,"சன்மம் பல பல செய்து வெளிப்பட்டுச்","sanmam pala pala seydhu veLippaTTuch"],[3113,"குறைவில் தடங்கடல் கோள் அரவேறித் தன்","kuRaivil thaDangkaDal kOL aravERith than"],[3114,"முட்டில் பல் போகத்து ஒரு தனி நாயகன்","muTTil pal bOgaththu oru thani nAyagan"],[3115,"பரிவின்றி வாணனைக் காத்தும் என்று அன்று","parivinRi vANanaik kAththum enRu anRu"],[3116,"இடர் இன்றியே ஒரு நாள் ஒரு போழ்தில்","iDar inRiyE oru nAL oru pOzhdhil"],[3117,"துயரில் சுடர் ஒளி தன்னுடைச் சோதி","thuyaril suDar oLi thannuDaich sOdhi"],[3118,"துன்பமும் இன்பமுமாகிய செய் வினையாய்","thunbamum inbamumAgiya sey vinaiyAy"],[3119,"அல்லலில் இன்பம் அளவு இறந்து எங்கும்","allalil inbam aLavu iRandhu enggum"],[3120,"துக்கம் இல் ஞானச் சுடர் ஒளி மூர்த்தி","dhukkamil njAnach suDar oLi mUrththi"],[3121,"தளர்வு இன்றியே என்றும் எங்கும் பரந்த","thaLarvu inRiyE enRum enggum parandha"],[3122,"கேடில் விழுப் புகழ்க் கேசவனைக்","kEDil vizhup pugazhk kEsavanaik"],[3123,"ஒரு நாயகமாய் ஓட உலகுடன் ஆண்டவர்","oru nAyagamAy ODa ulaguDan ANDavar"],[3124,"உய்ம்மின் திறை கொணர்ந்து என்று உலகான்டவர் இம்மையே","uymmin thiRai koNarndhu enRu ulagANDavar immaiyE"],[3125,"அடி சேர் முடியினர் ஆகி அரசர்கள் தாம் தொழ","aDi sEr muDiyinar Agi arasargaL thAm thozha"],[3126,"நினைப்பான் புகில் கடல் எக்கலில் நுண்மணலின் பலர்","ninaippAn pugil kaDal ekkalil nuNmaNalin palar"],[3127,"பணிமின் திரு அருள் என்னும் அம்சீதப் பைம்பூம் பள்ளி","paNimin thiru aruL ennum amsIdhap paimpUm paLLi"],[3128,"வாழ்ந்தார்கள் வாழ்ந்தது மா மழை மொக்குளின் மாய்ந்து மாய்ந்து","vAzhndhArgaL vAzhndhadhu mA mazhai mokkuLin mAyndhu mAyndhu"],[3129,"ஆம் இன் சுவை அவை ஆறோடு அடிசில் உண்டு ஆர்ந்த பின்","Am in suvai avai ARODu aDisil uNDu Arndha pin"],[3130,"குணங்கொள் நிறை புகழ் மன்னர் கொடைக் கடன் பூண்டிருந்து","guNangkoL niRai pugazh mannar koDaik kaDan pUNDirundhu"],[3131,"படி மன்னு பல்கலன் பற்றோடு அறுத்து ஐம்புலன் வென்று","paDi mannu palkalan paRRODu aRuththu aimpulan venRu"],[3132,"குறுக மிக உணர்வத்தொடு நோக்கி எல்லாம் விட்ட","kuRuga miga uNarvaththoDu nOkki ellAm viTTa"],[3133,"அஃதே உய்யப் புகும் ஆறென்று கண்ணன் கழல்கள் மேல்","aqdhE uyyap pugum ARenRu kaNNan kazhalgaL mEl"],[3134,"பாலனாய் ஏழ் உலகுண்டு பரிவின்றி","pAlanAy Ezh ulaguNDu parivinRi"],[3135,"வல்லி சேர் நுண்ணிடை ஆய்ச்சியர் தம்மொடும்","valli sEr nuNNiDai Aychchiyar thammoDum"],[3136,"பா இயல் வேத நன்மாலை பல கொண்டு","pA iyal vEdha nanmAlai pala koNDu"],[3137,"கோதில வண்புகழ் கொண்டு சமயிகள்","kOdhila vaNpugazh koNDu samayigaL"],[3138,"தோளி சேர் பின்னை பொருட்டு எருது ஏழ் தழீஇக்","thOLi sEr pinnai poruTTu erudhu Ezh thazhIik"],[3139,"மாதர் மா மண் மடந்தை பொருட்டு ஏனமாய்","mAdhar mA maN maDandhai poruTTu EnamAy"],[3140,"மடந்தையை வண்கமலத் திரு மாதினை","maDandhaiyai vaNkamalath thiru mAdhinai"],[3141,"கொம்பு போல் சீதை பொருட்டு இலங்கை நகர்","kombu pOl sIthai poruTTu ilanggai nagar"],[3142,"நங்கைமீர்! நீரும் ஓர் பெண் பெற்று நல்கினீர்","nanggaimIr! nIrum Or peN peRRu nalginIr"],[3143,"என் செய்கேன்? என்னுடைப் பேதை என் கோமளம்","en seygEn? ennuDaip pEdhai en kOmaLam"],[3144,"மெலியு நோய் தீர்க்கும் நம் கண்ணன் கழல்கள் மேல்","meliyu nOy thIrkkum nam kaNNan kazhalgaL mEl"],[3145,"கோவை வாயாள் பொருட்டு ஏற்றின்","kOvai vAyAL poruTTu ERRin"],[3146,"பூசும் சாந்து என் நெஞ்சமே","pUsum sAndhu en nenjchamE"],[3147,"ஏக மூர்த்தி இரு மூர்த்தி","Ega mUrththi iru mUrththi"],[3148,"மாய்த்தல் எண்ணி வாய் முலை","mAyththal eNNi vAy mulai"],[3149,"கண்ணி எனதுயிர் காதல்","kaNNi enadhuyir kAdhal"],[3150,"கால சக்கரத்தொடு வெண்சங்கம்","kAla chakkaraththoDu veNsanggam"],[3151,"குரை கழல்கள் நீட்டி மண்","kurai kazhalgaL nITTi maN"],[3152,"என்னதாவி மேலையாய்","ennadhAvi mElaiyAy"],[3153,"உரைக்க வல்லேன் அல்லேன் உன்","uraikka vallEn allEn un"],[3154,"யானும் ஏத்தி ஏழ் உலகும்","yAnum Eththi Ezh ulagum"],[3155,"உய்வு உபாயம் மற்று இன்மை","uyvu upAyam maRRu inmai"],[3156,"மண்ணை இருந்து துழாவி","maNNai irundhu thuzhAvi"],[3157,"பெய் வளைக் கைகளைக் கூப்பிப்","pey vaLaik kaigaLaik kUppip"],[3158,"அறியும் செந்தீயைத் தழுவி","aRiyum senthIyaith thazhuvi"],[3159,"ஒன்றிய திங்களைக் காட்டி","onRiya thinggaLaik kATTi"],[3160,"கோமள வான் கன்றைப் புல்கிக்","kOmaLa vAn kanRaip pulgik"],[3161,"கூத்தர் குடம் எடுத்து ஆடில்","kUththar kuDam eDuththu ADil"],[3162,"ஏறிய பித்தினோடு எல்லா","ERiya piththinODu ellA"],[3163,"திரு உடை மன்னரைக் காணில்","thiru uDai mannaraik kANil"],[3164,"விரும்பிப் பகவரைக் காணில்","virumbip pagavaraik kANil"],[3165,"அயர்க்கும் சுற்றும் பற்றி நோக்கும்","ayarkkum suRRum paRRi nOkkum"],[3166,"வல்வினை தீர்க்கும் கண்ணனை","valvinai thIrkkum kaNNanai"],[3167,"வீற்றிருந்து ஏழ் உலகும் தனிக் கோல் செல்ல வீவில் சீர்","vIRRirundhu Ezh ulagum thanik kOl sella vIvil sIr"],[3168,"மைய கண்ணாள் மலர் மேல் உறைவாள் உறை மார்பினன்","maiya kaNNAL malar mEl uRaivAL uRai mArbinan"],[3169,"வீவில் இன்பம் மிக எல்லை நிகழ்ந்த நம் அச்சுதன்","vIvil inbam miga ellai nigazhndha nam achchudhan"],[3170,"மேவி நின்று தொழுவார் வினை போக மேவும் பிரான்","mEvi ninRu thozhuvAr vinai pOga mEvum pirAn"],[3171,"ஆற்ற நல்ல வகை காட்டும் அம்மானை அமரர் தம்","ARRa nalla vagai kATTum ammAnai amarar tham"],[3172,"கரிய மேனி மிசை வெளிய நீறு சிறிதே இடும்","kariya mEni misai veLiya nIRu siRidhE iDum"],[3173,"என்றும் ஒன்றாகி ஒத்தாரும் மிக்கார்களும் தன் தனக்கு","enRum onRAgi oththArum mikkArgaLum than thanakku"],[3174,"நமக்கும் பூவின் மிசை நங்கைக்கும் இன்பனை ஞாலத்தார்","namakkum pUvin misai nanggaikkum inbanai njAlaththAr"],[3175,"வானத்தும் வானத்துள் உம்பரும் மண்ணுள்ளும் மண்ணின் கீழ்த்","vAnaththum vAnaththuL umbarum maNNuLLum maNNin kIzhth"],[3176,"உண்டு உமிழ்ந்தும் கடந்தும் இடந்தும் கிடந்து நின்றும்","uNDu umizhndhum kaDandhum iDandhum kiDandhu ninRum"],[3177,"மாரி மாறாத தண்ணம்மலை வேங்கடத்து அண்ணலை","mAri mARAdha thaNNammalai vEngkaDaththu aNNalai"],[3178,"தீர்ப்பாரை யாம் இனி எங்ஙனம் நாடுதும் அன்னைமீர்!","thIrppArai yAm ini engnganam nADudhum annaimIr!"],[3179,"திசைக்கின்றதே இவள் நோய் இது மிக்க பெருந்தெய்வம்","thisaikkinRadhE ivaL nOy idhu mikka perundheyvam"],[3180,"இது காண்மின் அன்னைமீர்! இக்கட்டுவிச்சி சொற்கொண்டு நீர்","idhu kANmin annaimIr! ikkaTTuvichchi soRkoNDu nIr"],[3181,"மருந்தாகும் என்று அங்கோர் மாய அலவை சொற்கொண்டு நீர்","marundhAgum enRu anggOr mAya alavai soRkoNDu nIr"],[3182,"இவளைப் பெறும் பரிசு இவ்வணங்கு ஆடுதல் அன்றந்தோ!","ivaLaip peRum parisu ivvaNanggu ADudhal anRandhO!"],[3183,"தணியும் பொழுது இல்லை நீர் அணங்கு ஆடுதிர் அன்னைமீர்!","thaNiyum pozhudhu illai nIr aNanggu ADudhir annaimIr!"],[3184,"அணங்குக்கு அருமருந்து என்று அங்கோர் ஆடும் கள்ளும் பராய்","aNanggukku arumarundhu enRu anggOr ADum kaLLum parAy"],[3185,"வேதம் வல்லார்களைக் கொண்டு விண்ணோர் பெருமான் திருப்","vEdham vallArgaLaik koNDu viNNOr perumAn thirup"],[3186,"கீழ்மையினால் அங்கோர் கீழ் மகன் இட்ட முழவின் கீழ்","kIzhmaiyinAl anggOr kIzh magan iTTa muzhavin kIzh"],[3187,"உன்னித்து மற்றொரு தெய்வம் தொழாள் அவனை அல்லால்","unniththu maRRoru dheyvam thozhAL avanai allAl"],[3188,"தொழுது ஆடி தூமணி வண்ணனுக்கு ஆட்செய்து நோய் தீர்ந்த","thozhudhu ADi thUmaNi vaNNanukku ATseydhu nOy thIrndha"],[3189,"சீலம் இல்லாச் சிறியன் ஏலும் செய் வினையோ பெரிதால்","sIlam illAch siRiyan Elum sey vinaiyO peridhAl"],[3190,"கொள்ள மாளா இன்ப வெள்ளம் கோதில தந்திடும் என்","koLLa mALA inba veLLam kOdhila thandhiDum en"],[3191,"ஈவிலாத தீ வினைகள் எத்தனை செய்தனன் கொல்?","IvilAdha thI vinaigaL eththanai seydhanan kol?"],[3192,"காண வந்து என் கண் முகப்பே தாமரைக் கண் பிறழ","kANa vandhu en kaN mugappE thAmaraik kaN piRazha"],[3193,"அப்பனே! அடல் ஆழியானே! ஆழ் கடலைக் கடைந்த","appanE! aDal AzhiyAnE! Azh kaDalaik kaDaindha"],[3194,"நோக்கி நோக்கி உன்னைக் காண்பான் யான் எனதாவி உள்ளே","nOkki nOkki unnaik kANbAn yAn enadhAvi uLLE"],[3195,"அறிந்து அறிந்து தேறித் தேறி யான் எனதாவி உள்ளே","aRindhu aRindhu thERith thERi yAn enadhAvi uLLE"],[3196,"கண்டு கொண்டு என் கைகள் ஆர நின் திருப்பாதங்கள் மேல்","kaNDu koNDu en kaigaL Ara nin thiruppAdhanggaL mEl"],[3197,"இட கிலேன் ஓன்று அட்ட கில்லேன் ஐம்புலன் வெல்ல கில்லேன்","iDa kilEn OnRu aTTa killEn aimpulan vella killEn"],[3198,"சக்கரத்து அண்ணலே! என்று தாழ்ந்து கண்ணீர் ததும்ப","chakkaraththu aNNalE! enRu thAzhndhu kaNNIr thadhumba"],[3199,"தழுவி நின்ற காதல் தன்னால் தாமரைக் கண்ணன் தன்னை","thazhuvi ninRa kAdhal thannAl thAmaraik kaNNan thannai"],[3200,"ஏறாளும் இறையோனும்","ERALum iRaiyOnum"],[3201,"மணி மாமை குறைவில்லா","maNi mAmai kuRaivillA"],[3202,"மட நெஞ்சால் குறைவில்லா","maDa nenjchAl kuRaivillA"],[3203,"நிறைவினால் குறைவில்லா","niRaivinAl kuRaivillA"],[3204,"தளிர் நிறத்தால் குறைவில்லாத்","thaLir niRaththAl kuRaivillAth"],[3205,"அறிவினால் குறைவில்லா","aRivinAl kuRaivillA"],[3206,"கிளர் ஒளியால் குறைவில்லா","kiLar oLiyAl kuRaivillA"],[3207,"வரி வளையால் குறைவில்லாப்","vari vaLaiyAl kuRaivillAp"],[3208,"மேகலையால் குறைவில்லா","mEgalaiyAl kuRaivillA"],[3209,"உடம்பினால் குறைவில்லா","uDambinAl kuRaivillA"],[3210,"உயிரினால் குறைவில்லா","uyirinAl kuRaivillA"],[3211,"நண்ணாதார் முறுவலிப்ப","naNNAdhAr muRuvalippa"],[3212,"சாம் ஆறும் கெடும் ஆறும்","sAm ARum keDum ARum"],[3213,"கொண்டாட்டும் குலம் புனைவும்","koNDATTum kulam punaivum"],[3214,"கொள் என்று கிளர்ந்து எழுந்த","koL enRu kiLarndhu ezhundha"],[3215,"வாங்கு நீர் மலர் உலகில்","vAnggu nIr malar ulagil"],[3216,"மறுக்கி வல்வலைப் படுத்திக்","maRukki valvalaip paDuththik"],[3217,"ஆயே! இவ்வுலகத்து","AyE! ivvulagaththu"],[3218,"காட்டி நீ கரந்து உமிழும்","kATTi nI karandhu umizhum"],[3219,"கூட்டுதி நின் குரை கழல்கள் இமையோரும்","kUTTudhi nin kurai kazhalgaL imaiyOrum"],[3220,"கண்டு கேட்டு உற்று மோந்து","kaNDu kETTu uRRu mOndhu"],[3221,"திருவடியை நாரணனைக்","thiruvaDiyai nAraNanaik"],[3222,"ஒன்றும் தேவும் உலகும் உயிரும் மற்றும் யாதும் இல்லா","onRum dhEvum ulagum uyirum maRRum yAdhum illA"],[3223,"நாடி நீர் வணங்கும் தெய்வமும் உம்மையும் முன் படைத்தான்","nADi nIr vaNanggum dheyvamum ummaiyum mun paDaiththAn"],[3224,"பரந்த தெய்வமும் பல் உலகும் படைத்து அன்று உடனே விழுங்கி","parandha dheyvamum pal ulagum paDaiththu anRu uDanE vizhunggi"],[3225,"பேச நின்ற சிவனுக்கும் பிரமன் தனக்கும் பிறர்க்கும்","pEsa ninRa sivanukkum piraman thanakkum piRarkkum"],[3226,"இலிங்கத்து இட்ட புராணத்தீரும் சமணரும் சாக்கியரும்","ilinggaththu iTTa purANaththIrum samaNarum sAkkiyarum"],[3227,"போற்றி மற்றோர் தெய்வம் பேணப் புறத்து இட்டு உம்மை இன்னே","pORRi maRROr dheyvam pENap puRaththu iTTu ummai innE"],[3228,"ஓடி ஓடிப் பல பிறப்பும் பிறந்து மற்றோர் தெய்வம்","ODi ODip pala piRappum piRandhu maRROr dheyvam"],[3229,"புக்கு அடிமையினால் தன்னைக் கண்ட மார்க்கண்டேயன் அவனை","pukku aDimaiyinAl thannaik kaNDa mArkkaNDEyan avanai"],[3230,"விளம்பும் ஆறு சமயமும் அவை ஆகிய மற்றும் தன் பால்","viLambum ARu samayamum avai Agiya maRRum than pAl"],[3231,"உறுவது ஆவது எத்தேவும் எவ்வுலகங்களும் மற்றும் தன் பால்","uRuvadhu Avadhu eththEvum evvulaganggaLum maRRum than pAl"],[3232,"ஆட்செய்து ஆழிப் பிரானைச் சேர்ந்தவன் வண்குருகூர் நகரான்","ATcheydhu Azhip pirAnaich sErndhavan vaNkurugUr nagarAn"],[3233,"கையார் சக்கரத்து என் கரு மாணிக்கமே! என்றென்று","kaiyAr chakkaraththu en karu mANikkamE! enRenRu"],[3234,"போனாய்! மா மருதின் நடுவே என் பொல்லா மணியே!","pOnAy! mA marudhin naDuvE en pollA maNiyE!"],[3235,"உள்ளன மற்றுளவாப் புறமே சில மாயம் சொல்லி","uLLana maRRuLavAp puRamE sila mAyam solli"],[3236,"என் கொள்வன்? உன்னை விட்டு என்னும் வாசகங்கள் சொல்லியும்","en koLvan? unnai viTTu ennum vAsaganggaL solliyum"],[3237,"கண்ண பிரானை விண்ணோர் கரு மாணிக்கத்தை அமுதை","kaNNa pirAnai viNNOr karu mANikkaththai amudhai"],[3238,"புறம் அறக் கட்டிக் கொண்டு இரு வல்வினையார் குமைக்கும்","puRam aRak kaTTik koNDu iru valvinaiyAr kumaikkum"],[3239,"அம்மான் ஆழிப் பிரான் அவன் எவ்விடத்தான்? யான் ஆர்?","ammAn Azhip pirAn avan evviDaththAn? yAn Ar?"],[3240,"மேலாத் தேவர்களும் நிலத் தேவரும் மேவித் தொழும்","mElAth thEvargaLum nilath thEvarum mEvith thozhum"],[3241,"ஆவார் ஆர்? துணை என்று அலை நீர்க் கடலுள் அழுந்தும்","AvAr Ar? thuNai enRu alai nIrk kaDaluL azhundhum"],[3242,"ஆனான் ஆள் உடையான் என்று அஃதே கொண்டு உகந்து வந்து","AnAn AL uDaiyAn enRu aqdhE koNDu ugandhu vandhu"],[3243,"கார் வண்ணன் கண்ண பிரான் கமலத் தடங்கண்ணன் தன்னை","kAr vaNNan kaNNa pirAn kamalath thaDangkaNNan thannai"],[3244,"பொலிக பொலிக பொலிக","poliga poliga poliga"],[3245,"கண்டோம் கண்டோம் கண்டோம்","kaNDOm kaNDOm kaNDOm"],[3246,"திரியும் கலி யுகம் நீங்கித்","thiriyum kali yugam nInggith"],[3247,"இடங்கொள் சமயத்தை எல்லாம்","iDangkoL samayaththai ellAm"],[3248,"செய்கின்றது என் கண்ணுக்கு ஒன்றே","seyginRadhu en kaNNukku onRE"],[3249,"கொன்று உயிர் உண்ணும் விசாதி","konRu uyir uNNum visAdhi"],[3250,"நிறுத்தி நும் உள்ளத்துக் கொள்ளும்","niRuththi num uLLaththuk koLLum"],[3251,"இறுக்கும் இறை இறுத்து உண்ண","iRukkum iRai iRuththu uNNa"],[3252,"மேவித் தொழுது உய்ம்மின் நீர்கள்","mEvith thozhudhu uymmin nIrgaL"],[3253,"மிக்க உலகுகள் தோறும்","mikka ulagugaL thORum"],[3254,"கலி யுகம் ஒன்றும் இன்றிக்கே","kali yugam onRum inRikkE"],[3255,"மாசறு சோதி என் செய்ய வாய் மணிக் குன்றத்தை","mAsaRu sOdhi en seyya vAy maNik kunRaththai"],[3256,"என் செய்யும் ஊரவர் கவ்வை? தோழீ! இனி நம்மை","en seyyum Uravar kavvai? thOzhI! ini nammai"],[3257,"ஊர்ந்த சகடம் உதைத்த பாதத்தன் பேய் முலை","Urndha sagaDam udhaiththa pAdhaththan pEy mulai"],[3258,"ஊரவர் கவ்வை எரு இட்டு அன்னை சொல் நீர் படுத்து","Uravar kavvai eru iTTu annai sol nIr paDuththu"],[3259,"கடியன் கொடியன் நெடிய மால் உலகம் கொண்ட","kaDiyan koDiyan neDiya mAl ulagam koNDa"],[3260,"அன்னை என் செய்யில் என்? ஊர் என் சொல்லில் என்? தோழிமீர்!","annai en seyyil en? Ur en sollil en? thOzhimIr!"],[3261,"வலையுள் அகப்படுத்து என்னை நல் நெஞ்சம் கூவிக் கொண்டு","valaiyuL agappaDuththu ennai nal nenjcham kUvik koNDu"],[3262,"பேய் முலை உண்டு சகடம் பாய்ந்து மருதிடைப்","pEy mulai uNDu sagaDam pAyndhu marudhiDaip"],[3263,"நாணும் நிறையும் கவர்ந்து என்னை நல் நெஞ்சம் கூவிக் கொண்டு","nANum niRaiyum kavarndhu ennai nal nenjcham kUvik koNDu"],[3264,"யாம் மடல் ஊர்ந்தும் எம் ஆழி அங்கைப் பிரானுடை","yAm maDal Urndhum em Azhi angkaip pirAnuDai"],[3265,"இரைக்கும் கருங்கடல் வண்ணன் கண்ண பிரான் தன்னை","iraikkum karungkaDal vaNNan kaNNa pirAn thannai"],[3266,"ஊர் எல்லாம் துஞ்சி உலகெல்லாம் நள்ளிருளாய்","Ur ellAm thunjchi ulagellAm naLLiruLAy"],[3267,"ஆவி காப்பார் இனி யார்? ஆழ் கடல் மண் விண் மூடி","Avi kAppAr ini yAr? Azh kaDal maN viN mUDi"],[3268,"நீயும் பாங்கு அல்லை காண் நெஞ்சமே! நீள் இரவும்","nIyum pAnggu allai kAN nenjchamE! nIL iravum"],[3269,"பெண் பிறந்தார் எய்தும் பெருந்துயர் காண்கிலேன் என்று","peN piRandhAr eydhum perunthuyar kANgilEn enRu"],[3270,"ஆர் என்னை ஆராய்வார்? அன்னையரும் தோழியரும்","Ar ennai ArAyvAr? annaiyarum thOzhiyarum"],[3271,"பின் நின்ற காதல் நோய் நெஞ்சம் பெரிது அடுமால்","pin ninRa kAdhal nOy nenjcham peridhu aDumAl"],[3272,"காப்பார் ஆர் இவ்விடத்து? கங்கிருளின் நுண் துளியாய்","kAppAr Ar ivviDaththu? kanggiruLin nuN thuLiyAy"],[3273,"தெய்வங்காள்! என் செய்கேன்? ஓர் இரவு ஏழ் ஊழியாய்","dheyvanggAL! en seygEn? Or iravu Ezh UzhiyAy"],[3274,"வெஞ்சுடரில் தான் அடுமால் வீங்கிருளின் நுண் துளியாய்","venjchuDaril thAn aDumAl vInggiruLin nuN thuLiyAy"],[3275,"நின்று உருகுகின்றேனே போல நெடு வானம்","ninRu uruguginREnE pOla neDu vAnam"],[3276,"உறங்குவான் போல் யோகு செய்த பெருமானை","uRangguvAn pOl yOgu seydha perumAnai"],[3277,"எங்ஙனேயோ அன்னைமீர்காள்! என்னை முனிவது நீர்?","engnganEyO annaimIrgAL! ennai munivadhu nIr?"],[3278,"என் நெஞ்சினால் நோக்கிக் காணீர் என்னை முனியாதே","en nenjchinAl nOkkik kANIr ennai muniyAdhE"],[3279,"நின்றிடும் திசைக்கும் நையும் என்று அன்னையரும் முனிதிர்","ninRiDum thisaikkum naiyum enRu annaiyarum munidhir"],[3280,"நீங்க நில்லா கண்ண நீர்கள் என்று அன்னையரும் முனிதிர்","nIngga nillA kaNNa nIrgaL enRu annaiyarum munidhir"],[3281,"பக்கம் நோக்கி நிற்கும் நையும் என்று அன்னையரும் முனிதிர்","pakkam nOkki niRkum naiyum enRu annaiyarum munidhir"],[3282,"மேலும் வன் பழி நங்குடிக்கு இவள் என்று அன்னை காண கொடாள்","mElum van pazhi nangkuDikku ivaL enRu annai kANa koDAL"],[3283,"நிறைந்த வன் பழி நங்குடிக்கு இவள் என்று அன்னை காண கொடாள்","niRaindha van pazhi nangkuDikku ivaL enRu annai kANa koDAL"],[3284,"கையுள் நன் முகம் வைக்கும் நையும் என்று அன்னையரும் முனிதிர்","kaiyuL nan mugam vaikkum naiyum enRu annaiyarum munidhir"],[3285,"முன் நின்றாய் என்று தோழிமார்களும் அன்னையரும் முனிதிர்","mun ninRAy enRu thOzhimArgaLum annaiyarum munidhir"],[3286,"கழிய மிக்கதோர் காதலள் இவள் என்று அன்னை காண கொடாள்","kazhiya mikkadhOr kAdhalaL ivaL enRu annai kANa koDAL"],[3287,"அறிவரிய பிரானை ஆழி அங்கையனையே அலற்றி","aRivariya pirAnai Azhi angkaiyanaiyE alaRRi"],[3288,"கடல் ஞாலம் செய்தேனும் யானே என்னும்","kaDal njAlam seydhEnum yAnE ennum"],[3289,"கற்கும் கல்விக்கு எல்லை இலனே என்னும்","kaRkum kalvikku ellai ilanE ennum"],[3290,"காண்கின்ற நிலம் எல்லாம் யானே என்னும்","kANginRa nilam ellAm yAnE ennum"],[3291,"செய்கின்ற கிதி எல்லாம் யானே என்னும்","seyginRa kidhi ellAm yAnE ennum"],[3292,"திறம்பாமல் மண் காக்கின்றேன் யானே என்னும்","thiRambAmal maN kAkkinREn yAnE ennum"],[3293,"இன வேய் மலை ஏந்தினேன் யானே என்னும்","ina vEy malai EndhinEn yAnE ennum"],[3294,"உற்றார்கள் எனக்கு இல்லை யாரும் என்னும்","uRRArgaL enakku illai yArum ennum"],[3295,"உரைக்கின்ற முக்கண் பிரான் யானே என்னும்","uraikkinRa mukkaN pirAn yAnE ennum"],[3296,"கொடிய வினை யாதும் இலனே என்னும்","koDiya vinai yAdhum ilanE ennum"],[3297,"கோலங்கொள் சுவர்க்கமும் யானே என்னும்","kOlangkoL suvarkkamum yAnE ennum"],[3298,"கூந்தல் மலர் மங்கைக்கும் மண் மடந்தைக்கும்","kUndhal malar manggaikkum maN maDandhaikkum"],[3299,"நோற்ற நோன்பிலேன் நுண்ணறிவு இலேன் ஆகிலும் இனி உன்னை விட்டு ஒன்றும்","nORRa nOnbilEn nuNNaRivu ilEn Agilum ini unnai viTTu onRum"],[3300,"அங்குற்றேன் அல்லேன் இங்குற்றேன் அல்லேன் உன்னைக் காணும் அவாவில் வீழ்ந்து","angguRREn allEn ingguRREn allEn unnaik kANum avAvil vIzhndhu nAn"],[3301,"கருளப் புட்கொடி சக்கரப் படை வான நாட! என் கார் முகில் வண்ணா","karuLap puTkoDi chakkarap paDai vAna nADa! en kAr mugil vaNNA"],[3302,"மாறு சேர் படை நூற்றுவர் மங்க ஓர் ஐவர்க்காய் அன்று மாயப் போர் பண்ணி","mARu sEr paDai nURRuvar mangga Or aivarkkAy anRu mAyap pOr paNNi"],[3303,"எய்தக் கூவுதல் ஆவதே எனக்கு? எவ்வ தெவ்வத்துளாயும் ஆய் நின்று","eydhak kUvudhal AvadhE enakku? evva thevvaththuLAyum Ay ninRu"],[3304,"ஏனமாய் நிலம் கீண்ட என் அப்பனே! கண்ணா! என்றும் என்னை ஆளுடை","EnamAy nilam kINDa en appanE! kaNNA! enRum ennai ALuDai"],[3305,"வந்தருளி என் நெஞ்சு இடம் கொண்ட வானவர் கொழுந்தே! உலகுக்கு ஓர்","vandharuLi en nenjchu iDam koNDa vAnavar kozhundhE! ulagukku Or"],[3306,"அகற்ற நீ வைத்த மாய வல் ஐம்புலன்கள் ஆம் அவை நன்கு அறிந்தனன்","agaRRa nI vaiththa mAya val aimpulankaL Am avai nanku aRindhanan"],[3307,"புள்ளின் வாய் பிளந்தாய்! மருது இடை போயினாய்! எருது ஏழ் அடர்த்த என்","puLLin vAy piLandhAy! marudhu iDai pOyinAy! erudhu Ezh aDarththa en"],[3308,"ஆறெனக்கு நின் பாதமே சரணாகத் தந்து ஒழிந்தாய் உனக்கு ஓர் கைம்","ARenakku nin pAdhamE saraNAgath thandhu ozhindhAy unakku Or kaim"],[3309,"தெய்வ நாயகன் நாரணன் திரிவிக்கிரமன் அடி இணை மிசை","dheyva nAyagan nAraNan thirivikkiraman aDi iNai misai"],[3310,"ஆரா அமுதே! அடியேன் உடலம் நின் பால் அன்பாயே","ArA amudhE! aDiyEn uDalam nin pAl anbAyE"],[3311,"எம்மானே! என் வெள்ளை மூர்த்தி! என்னை ஆள்வானே","emmAnE! en veLLai mUrththi! ennai ALvAnE"],[3312,"என் நான் செய்கேன்? யாரே களைகண்? என்னை என் செய்கின்றாய்?","en nAn seygEn? yArE kaLaikaN? ennai en seyginRAy?"],[3313,"செலக் காண் கிற்பார் காணும் அளவும் செல்லும் கீர்த்தியாய்!","selak kAN kiRpAr kANum aLavum sellum kIrththiyAy!"],[3314,"அழுவன் தொழுவன் ஆடிக் காண்பன் பாடி அலற்றுவன்","azhuvan thozhuvan ADik kANban pADi alaRRuvan"],[3315,"சூழ் கண்டாய் என் தொல்லை வினையை அறுத்து உன் அடி சேரும்","sUzh kaNDAy en thollai vinaiyai aRuththu un aDi sErum"],[3316,"அரி ஏறே! என் அம்பொற் சுடரே! செங்கண் கரு முகிலே!","ari ERE! en ampoR suDarE! sengkaN karu mugilE!"],[3317,"களைவாய் துன்பம் களையாது ஒழிவாய் களைகண் மற்றிலேன்","kaLaivAy thunbam kaLaiyAdhu ozhivAy kaLaikaN maRRilEn"],[3318,"இசைவித்து என்னை உன் தாள் இணைக் கீழ் இருத்தும் அம்மானே!","isaiviththu ennai un thAL iNaik kIzh iruththum ammAnE!"],[3319,"வாரா அருவாய் வரும் என் மாயா! மாயா மூர்த்தியாய்!","vArA aruvAy varum en mAyA! mAyA mUrththiyAy!"],[3320,"உழலை என்பின் பேய்ச்சி முலை ஊடு அவளை உயிர் உண்டான்","uzhalai enbin pEychchi mulai UDu avaLai uyir uNDAn"],[3321,"மானேய் நோக்கு நல்லீர்! வைகலும் வினையேன் மெலிய","mAnEy nOkku nallIr! vaigalum vinaiyEn meliya"],[3322,"என்று கொல்? தோழிமீர்காள்! எம்மை நீர் நலிந்து என் செய்தீரோ?","enRu kol? thOzhimIrgAL! emmai nIr nalindhu en seydhIrO?"],[3323,"சூடு மலர்க் குழலீர்! துயராட்டியேனை மெலிய","sUDu malark kuzhalIr! thuyarATTiyEnai meliya"],[3324,"நிச்சலும் தோழிமீர்காள்! எம்மை நீர் நலிந்து என் செய்தீரோ?","nichchalum thOzhimIrgAL! emmai nIr nalindhu en seydhIrO?"],[3325,"நன்னலத் தோழிமீர்காள்! நல்ல அந்தணர் வேள்விப் புகை","nannalath thOzhimIrgAL! nalla andhaNar vELvip pugai"],[3326,"காண்பது எஞ்ஞான்று கொலொ? வினையேன் கனி வாய் மடவீர்!","kANbadhu enjnjAnRu kolo? vinaiyEn kani vAy maDavIr!"],[3327,"பாதங்கள் மேல் அணி பூந்தொழக் கூடுங்கொல்? பாவை நல்லீர்!","pAdhanggaL mEl aNi pUnthozhak kUDungkol? pAvai nallIr!"],[3328,"நாடொறும் வீடு இன்றியே தொழக் கூடுங்கொல்? நல் நுதலீர்!","nADoRum vIDu inRiyE thozhak kUDungkol? nal nudhalIr!"],[3329,"கழல் வளை பூரிப்ப யாம் கண்டு கை தொழக் கூடுங்கொலோ?","kazhal vaLai pUrippa yAm kaNDu kai thozhak kUDungkolO?"],[3330,"தொல் அருள் நல் வினையால் சொலக் கூடுங்கொல்? தோழிமீர்காள்!","thol aruL nal vinaiyAl solak kUDungkol? thOzhimIrgAL!"],[3331,"நாமங்கள் ஆயிரம் உடைய நம் பெருமான் அடி மேல்","nAmanggaL Ayiram uDaiya nam perumAn aDi mEl"],[3332,"பிறந்தவாறும் வளர்ந்தவாறும்","piRandhavARum vaLarndhavARum"],[3333,"வதுவை வார்த்தையுள் ஏறு பாய்ந்ததும்","vadhuvai vArththaiyuL ERu pAyndhadhum"],[3334,"பெய்யும் பூங்குழல் பேய் முலை உண்ட","peyyum pUngkuzhal pEy mulai uNDa"],[3335,"கள்ள வேடத்தைக் கொண்டு போய்ப் புறம்","kaLLa vEDaththaik koNDu pOyp puRam"],[3336,"உண்ண வானவர் கோனுக்கு ஆயர்","uNNa vAnavar kOnukku Ayar"],[3337,"நின்றவாறும் இருந்தவாறும்","ninRavARum irundhavARum"],[3338,"ஒண் சுடரோடு இருளுமாய் நின்றவாறும்","oN suDarODu iruLumAy ninRavARum"],[3339,"திரு உருவு கிடந்தவாறும் கொப்பூழ்ச்","thiru uruvu kiDandhavARum koppUzhch"],[3340,"அடியை மூன்றை இரந்தவாறும் அங்கே நின்று","aDiyai mUnRai irandhavARum anggE ninRu"],[3341,"கூடி நீரைக் கடைந்தவாறும்","kUDi nIraik kaDaindhavARum"],[3342,"நாகணை மிசை நம் பிரான் சரணே","nAgaNai misai nam pirAn charaNE"],[3343,"வைகல் பூங்கழி வாய் வந்து மேயும் குருகு இனங்காள்!","vaigal pUngkazhi vAy vandhu mEyum kurugu inanggAL!"],[3344,"காதல் மென் பெடையோடு உடன் மேயும் கரு நாராய்!","kAdhal men peDaiyODu uDan mEyum karu nArAy!"],[3345,"திறங்கள் ஆகி எங்கும் செய்களூடு உழல் புள் இனங்காள்!","thiRanggaL Agi enggum seygaLUDu uzhal puL inanggAL!"],[3346,"இடரில் போகம் மூழ்கி இணைந்தாடும் மட அன்னங்காள்!","iDaril bOgam mUzhgi iNaindhADum maDa annanggAL!"],[3347,"உணர்த்தல் ஊடல் உணர்ந்து உடன் மேயும் மட அன்னங்காள்!","uNarththal UDal uNarndhu uDan mEyum maDa annanggAL!"],[3348,"போற்றி யான் இரந்தேன் புன்னை மேல் உறை பூங்குயில்காள்!","pORRi yAn irandhEn punnai mEl uRai pUngkuyilgAL!"],[3349,"ஒரு வண்ணம் சென்று புக்கு எனக்கு ஒன்று உரை ஒண்கிளியே!","oru vaNNam senRu pukku enakku onRu urai oNkiLiyE!"],[3350,"திருந்தக் கண்டு எனக்கு ஒன்று உரையாய் ஒண்சிறு பூவாய்!","thirundhak kaNDu enakku onRu uraiyAy oNsiRu pUvAy!"],[3351,"அடிகள் கை தொழுது அலர் மேல் அசையும் அன்னங்காள்!","aDigaL kai thozhudhu alar mEl asaiyum annanggAL!"],[3352,"வேறு கொண்டு உம்மை யான் இரந்தேன் வெறி வண்டு இனங்காள்!","vERu koNDu ummai yAn irandhEn veRi vaNDu inanggAL!"],[3353,"மின்கொள் சேர் புரிநூல் குறளாய் அகல் ஞாலம் கொண்ட","minkoL sEr purinUl kuRaLAy agal njAlam koNDa"],[3354,"மின்னிடை மடவார்கள் நின்னருள் சூடுவார் முன்பு நான் அதஞ்சுவன்","minniDai maDavArgaL ninnaruL sUDuvAr munbu nAn adhanjchuvan"],[3355,"போகு நம்பீ! உன் தாமரை புரை கண்ணிணையும் செவ்வாய் முறுவலும்","pOgu nambI! un thAmarai purai kaNNiNaiyum sevvAy muRuvalum"],[3356,"போய் இருந்து நின் புள்ளுவம் அறியாதவர்க்கு உரை நம்பீ! நின் செய்ய","pOy irundhu nin puLLuvam aRiyAdhavarkku urai nambI! nin seyya"],[3357,"ஆலின் நீள் இலை ஏழுலகம் உண்டு அன்று நீ கிடந்தாய் உன் மாயங்கள்","Alin nIL ilai Ezhulagam uNDu anRu nI kiDandhAy un mAyanggaL"],[3358,"கழறேல் நம்பீ! உன் கைதவம் மண்ணும் விண்ணும் நன்கறியும் திண் சக்கர","kazhaREl nambI! un kaithavam maNNum viNNum nankaRiyum thiN chakkara"],[3359,"குழகி எங்கள் குழமணன் கொண்டு கோயின்மை செய்து கன்மம் ஒன்று இல்லை","kuzhagi enggaL kuzhamaNan koNDu kOyinmai seydhu kanmam onRu illai"],[3360,"கன்மம் அன்று எங்கள் கையில் பாவை பறிப்பது கடல் ஞாலம் உண்டிட்ட","kanmam anRu enggaL kaiyil pAvai paRippadhu kaDal njAlam uNDiTTa"],[3361,"பிணக்கி யாவையும் யாவரும் பிழையாமல் பேதித்தும் பேதியாததோர்","piNakki yAvaiyum yAvarum pizhaiyAmal pEdhiththum pEdhiyAdhadhOr"],[3362,"உகவையால் நெஞ்சம் உள்ளுருகி உன் தாமரைத் தடங்கண் விழிகளின்","ugavaiyAl nenjcham uLLurugi un thAmaraith thaDangkaN vizhigaLin"],[3363,"நின்று இலங்கு முடியினாய்! இருபத்தோர் கால் அரசு களை கட்ட","ninRu ilanggu muDiyinAy! irupaththOr kAl arasu kaLai kaTTa"],[3364,"ஆய்ச்சி ஆகிய அன்னையால் அன்று வெண்ணெய் வார்த்தையுள் சீற்றமுண்டு அழு","Aychchi Agiya annaiyAl anRu veNNey vArththaiyuL sIRRamuNDu azhu"],[3365,"நல்குரவும் செல்வும் நரகும் சுவர்க்கமுமாய்","nalkuravum selvum naragum suvarkkamumAy"],[3366,"கண்ட இன்பம் துன்பம் கலக்கங்களும் தேற்றமுமாய்","kaNDa inbam thunbam kalakkanggaLum thERRamumAy"],[3367,"நகரமும் நாடுகளும் ஞானமும் மூடமுமாய்","nagaramum nADugaLum njAnamum mUDamumAy"],[3368,"புண்ணியம் பாவம் புணர்ச்சி பிரிவு என்ற இவையாய்","puNNiyam pAvam puNarchchi pirivu enRa ivaiyAy"],[3369,"கைதவம் செம்மை கருமை வெளுமையுமாய்","kaithavam semmai karumai veLumaiyumAy"],[3370,"மூவுலகங்களுமாய் அல்லனாய் உகப்பாய் முனிவாய்","mUvulaganggaLumAy allanAy ugappAy munivAy"],[3371,"பரஞ்சுடர் உடம்பாய் அழுக்கு பதித்த உடம்பாய்","paranjchuDar uDambAy azhukku padhiththa uDambAy"],[3372,"வன் சரண் சுரர்க்காய் அசுரர்க்கு வெங்கூற்றமுமாய்","van saraN surarkkAy asurarkku vengkURRamumAy"],[3373,"என் அப்பன் எனக்காய் இகுளாய் என்னைப் பெற்றவளாய்","en appan enakkAy iguLAy ennaip peRRavaLAy"],[3374,"நிழல் வெய்யில் சிறுமை பெருமை குறுமை நெடுமையுமாய்","nizhal veyyil siRumai perumai kuRumai neDumaiyumAy"],[3375,"காண்மின்கள் உலகீர்! என்று கண் முகப்பே நிமிர்ந்த","kANmingaL ulagIr! enRu kaN mugappE nimirndha"],[3376,"குரவை ஆய்ச்சியரோடு கோத்ததும் குன்றம் ஒன்று ஏந்தியதும்","kuravai AychchiyarODu kOththadhum kunRam onRu Endhiyadhum"],[3377,"கேயத் தீங்குழல் ஊதிற்றும் நிரை மேய்த்ததும் கெண்டை ஒண்கண்","kEyath thIngkuzhal UdhiRRum nirai mEyththadhum keNDai oNkaN"],[3378,"நிகரில் மல்லரைச் செற்றதும் நிரை மேய்த்ததும் நீள் நெடுங்கை","nigaril mallaraich seRRadhum nirai mEyththadhum nIL neDungkai"],[3379,"நோவ ஆய்ச்சி உரலோடு ஆர்க்க இரங்கிற்றும் வஞ்சப் பெண்ணை","nOva Aychchi uralODu Arkka iranggiRRum vanjchap peNNai"],[3380,"வேண்டித் தேவர் இரக்க வந்து பிறந்ததும் வீங்கிருள் வாய்","vENDith dhEvar irakka vandhu piRandhadhum vInggiruL vAy"],[3381,"இகல் கொள் புள்ளைப் பிளந்ததும் இமில் ஏறுகள் செற்றதுவும்","igal koL puLLaip piLandhadhum imil ERugaL seRRadhuvum"],[3382,"மனப் பரிப்போடு அழுக்கு மானிட சாதியில் தான் பிறந்து","manap parippODu azhukku mAniDa sAdhiyil thAn piRandhu"],[3383,"நீணிலத்தொடு வான் வியப்ப நிறை பெரும் போர்கள் செய்து","nINilaththoDu vAn viyappa niRai perum pOrgaL seydhu"],[3384,"கலக்க ஏழ் கடல் ஏழ் மலை உலகு ஏழும் கழியக் கடாய்","kalakka Ezh kaDal Ezh malai ulagu Ezhum kazhiyak kaDAy"],[3385,"மண் மிசைப் பெரும் பாரம் நீங்க ஓர் பாரத மா பெரும் போர்","maN misaip perum bAram nIngga Or bAradha mA perum pOr"],[3386,"நாயகன் முழு ஏழ் உலகுக்குமாய் முழு ஏழ் உலகும் தன்","nAyagan muzhu Ezh ulagukkumAy muzhu Ezh ulagum than"],[3387,"துவளில் மா மணி மாடம் ஓங்கு","thuvaLil mA maNi mADam Onggu"],[3388,"குமுறும் ஓசை விழவொலித் தொலைவில்லி","kumuRum Osai vizhavolith tholaivilli"],[3389,"கரை கொள் பைம்பொழில் தண் பணைத் தொலைவில்லி","karai koL paimpozhil thaN paNaith tholaivilli"],[3390,"நிற்கும் நான்மறை வாணர் வாழ் தொலைவில்லி","niRkum nAnmaRai vANar vAzh tholaivilli"],[3391,"குழையும் வாண்முகத்து ஏழையைத் தொலைவில்லி","kuzhaiyum vANmugaththu Ezhaiyaith tholaivilli"],[3392,"நோக்கும் பக்கம் எல்லாம் கரும்பொடு","nOkkum pakkam ellAm karumboDu"],[3393,"அன்னைமீர்! அணி மா மயில் சிறு","annaimIr! aNi mA mayil siRu"],[3394,"திருந்து வேதமும் வேள்வியும்","thirundhu vEdhamum vELviyum"],[3395,"இரங்கி நாள் தொறும் வாய்வெரீஇ இவள்","iranggi nAL thoRum vAyverIi ivaL"],[3396,"பின்னை கொல்? நில மா மகள் கொல்?","pinnai kol? nila mA magaL kol?"],[3397,"சிந்தையாலும் சொல்லாலும் செய்கையினாலும்","sindhaiyAlum sollAlum seygaiyinAlum"],[3398,"மாலுக்கு வையம் அளந்த மணாளற்கு","mAlukku vaiyam aLandha maNALaRku"],[3399,"சங்கு வில் வாள் தண்டு சக்கரக் கையற்கு","sanggu vil vAL thaNDu chakkarak kaiyaRku"],[3400,"நிறம் கரியானுக்கு நீடு உலகுண்ட","niRam kariyAnukku nIDu ulaguNDa"],[3401,"பீடுடை நான்முகனைப் படைத்தானுக்கு","pIDuDai nAnmuganaip paDaiththAnukku"],[3402,"பண்புடை வேதம் பயந்த பரனுக்கு","paNbuDai vEdham payandha paranukku"],[3403,"கற்பகக் காவன நற் பல தோளற்கு","kaRpagak kAvana naR pala thOLaRku"],[3404,"மெய் அமர் பல் கலன் நன்கு அணிந்தானுக்கு","mey amar pal kalan nanku aNindhAnukku"],[3405,"சாயக் குருந்தம் ஒசித்த தமியற்கு","sAyak kurundham osiththa thamiyaRku"],[3406,"மாண்பமை கோலத்து எம் மாயக் குறளற்கு","mANbamai kOlaththu em mAyak kuRaLaRku"],[3407,"பொற்பமை நீள் முடிப் பூந்தண் துழாயற்கு","poRpamai nIL muDip pUnthaN thuzhAyaRku"],[3408,"கட்டெழில் சோலை நல் வேங்கட வாணனை","kaTTezhil sOlai nal vEngkaDa vANanai"],[3409,"உண்ணும் சோறு பருகு நீர்","uNNum sORu parugu nIr"],[3410,"ஊரும் நாடும் உலகமும்","Urum nADum ulagamum"],[3411,"பூவை பைங்கிளிகள் பந்து","pUvai paingkiLigaL pandhu"],[3412,"கொல்லை என்பர் கொலோ? குணம்","kollai enbar kolO? guNam"],[3413,"மேவி நைந்து நைந்து","mEvi naindhu naindhu"],[3414,"இன்று எனக்கு உதவாது அகன்ற","inRu enakku udhavAdhu aganRa"],[3415,"மல்கு நீர்க் கண்ணொடு","malgu nIrk kaNNoDu"],[3416,"ஒசிந்த நுண்ணிடை மேல் கையை","osindha nuNNiDai mEl kaiyai"],[3417,"காரியம் நல்லனகள் அவை காணில் என்","kAriyam nallanagaL avai kANil en"],[3418,"நினைக்கிலேன் தெய்வங்காள்! நெடுங்கண்","ninaikkilEn dheyvanggAL! neDungkaN"],[3419,"வைத்த மா நிதியாம்","vaiththa mA nidhiyAm"],[3420,"பொன்னுலகு ஆளீரோ?","ponnlagu ALIrO?"],[3421,"மையமர் வாள் நெடுங்கண்","maiyamar vAL neDungkaN"],[3422,"ஓடி வந்து என் குழல் மேல்","ODi vandhu en kuzhal mEl"],[3423,"தூ மது வாய்கள் கொண்டு","thU madhu vAygaL koNDu"],[3424,"நுங்கட்கு யான் உரைக்கேன்","nunggaTku yAn uraikkEn"],[3425,"என் மின்னு நூல் மார்வன்","en minnu nUl mArvan"],[3426,"பூவைகள் போல் நிறத்தன்","pUvaigaL pOl niRaththan"],[3427,"பாசறவு எய்தி இன்னே","pAsaRavu eydhi innE"],[3428,"பேர்த்து மற்றோர் களைகண்","pErththu maRROr kaLaikaN"],[3429,"வந்து இருந்து உம்முடைய","vandhu irundhu ummuDaiya"],[3430,"மாற்றங்கள் ஆய்ந்து கொண்டு","mARRanggaL Ayndhu koNDu"],[3431,"நீராய் நிலனாய்த் தீயாய்க் காலாய் நெடுவானாய்","nIrAy nilanAyth thIyAyk kAlAy neDuvAnAy"],[3432,"மண்ணும் விண்ணும் மகிழக் குறளாய் வலங்காட்டி","maNNum viNNum magizhak kuRaLAy valangkATTi"],[3433,"ஞாலத்தூடே நடந்தும் நின்றும் கிடந்து இருந்தும்","njAlaththUDE naDandhum ninRum kiDandhu irundhum"],[3434,"தளர்ந்தும் முறிந்தும் சகட அசுரர் உடல் வேறா","thaLarndhum muRindhum sagaDa asurar uDal vERA"],[3435,"விண் மீது இருப்பாய்! மலை மேல் நிற்பாய்! கடல் சேர்ப்பாய்!","viN mIdhu iruppAy! malai mEl niRpAy! kaDal sErppAy!"],[3436,"பாய் ஓர் அடி வைத்து அதன் கீழ்ப் பரவை நிலம் எல்லாம்","pAy Or aDi vaiththu adhan kIzhp paravai nilam ellAm"],[3437,"உலகில் திரியும் கரும கதியாய் உலகமாய்","ulagil thiriyum karuma kadhiyAy ulagamAy"],[3438,"அறிவு இலேனுக்கு அருளாய் அறிவார் உயிர் ஆனாய்!","aRivu ilEnukku aruLAy aRivAr uyir AnAy!"],[3439,"ஆவி திகைக்க ஐவர் குமைக்கும் சிற்றின்பம்","Avi thigaikka aivar kumaikkum chiRRinbam"],[3440,"குறுகா நீளா இறுதி கூடா எனை ஊழி","kuRugA nILA iRudhi kUDA enai Uzhi"],[3441,"தெரிதல் நினைதல் எண்ணல் ஆகாத் திருமாலுக்கு","theridhal ninaidhal eNNal AgAth thirumAlukku"],[3442,"உலகம் உண்ட பெரு வாயா! உலப்பில் கீர்த்தி அம்மானே!","ulagam uNDa peru vAyA! ulappil kIrththi ammAnE!"],[3443,"கூறாய் நீறாய் நிலன் ஆகிக் கொடு வல் அசுரர் குலம் எல்லாம்","kURAy nIRAy nilan Agik koDu val asurar kulam ellAm"],[3444,"வண்ணம் அருள் கொள் அணி மேக வண்ணா! மாய அம்மானே!","vaNNam aruL koL aNi mEga vaNNA! mAya ammAnE!"],[3445,"ஆவா! என்னாது உலகத்தை அலைக்கும் அசுரர் வாணாள் மேல்","AvA! ennAdhu ulagaththai alaikkum asurar vANAL mEl"],[3446,"புணரா நின்ற மரம் ஏழ் அன்று எய்த ஒரு வில் வலவாவோ!","puNarA ninRa maram Ezh anRu eydha oru vil valavAvO!"],[3447,"எந்நாளே? நாம் மண் அளந்த இணைத் தாமரைகள் காண்பதற்கு என்று","ennALE? nAm maN aLandha iNaith thAmaraigaL kANbadhaRku enRu"],[3448,"அடியேன் மேவி அமர்கின்ற அமுதே! இமையோர் அதிபதியே!","aDiyEn mEvi amarginRa amudhE! imaiyOr adhipadhiyE!"],[3449,"நோலாது ஆற்றேன் உன பாதம் காண என்று நுண் உணர்வின்","nOlAdhu ARREn una pAdham kANa enRu nuN uNarvin"],[3450,"வந்தாய் போலே வாராதாய் வாராதாய் போல் வருவானே!","vandhAy pOlE vArAdhAy vArAdhAy pOl varuvAnE!"],[3451,"அகல கில்லேன் இறையும் என்று அலர் மேல் மங்கை உறை மார்பா!","agala killEn iRaiyum enRu alar mEl manggai uRai mArbA!"],[3452,"அடிக் கீழ் அமர்ந்து புகுந்து அடியீர்! வாழ்மின் என்றென்று அருள் கொடுக்கும்","aDik kIzh amarndhu pugundhu aDiyIr! vAzhmin enRenRu aruL koDukkum"],[3453,"உண்ணிலாவிய ஐவரால் குமை","uNNilAviya aivarAl kumai"],[3454,"என்னை ஆளும் வன் கோ ஓரைந்து இவை பெய்து","ennai ALum van kO Oraindhu ivai peydhu"],[3455,"வேதியா நிற்கும் ஐவரால் வினையேனை","vEdhiyA niRkum aivarAl vinaiyEnai"],[3456,"சூது நான் அறியா வகை சுழற்றி ஓர்","sUdhu nAn aRiyA vagai suzhaRRi Or"],[3457,"தீர் மருந்து இன்றி ஐந்து நோய் அடும்","thIr marundhu inRi aindhu nOy aDum"],[3458,"விண்ணுளார் பெருமாற்கு அடிமை செய்வாரையும்","viNNuLAr perumARku aDimai seyvAraiyum"],[3459,"ஒன்று சொல்லி ஒருத்தினில் நிற்கிலாத","onRu solli oruththinil niRkilAdha"],[3460,"இன்னமுது எனத் தோன்றி ஓர் ஐவர்","innamudhu enath thOnRi Or aivar"],[3461,"குல முதல் அடும் தீவினைக் கொடு வன் குழியினில்","kula mudhal aDum thIvinaik koDu van kuzhiyinil"],[3462,"என் பரஞ்சுடரே! என்று உன்னை அலற்றி உன்","en paranjchuDarE! enRu unnai alaRRi un"],[3463,"கொண்ட மூர்த்தி ஓர் மூவராய்க் குணங்கள்","koNDa mUrththi Or mUvarAyk guNanggaL"],[3464,"கங்குலும் பகலும் கண் துயில் அறியாள்","kanggulum pagalum kaN thuyil aRiyAL"],[3465,"என் செய்கின்றாய்? என் தாமரைக் கண்ணா!","en seyginRAy? en thAmaraik kaNNA!"],[3466,"வட்கிலள் இறையும் மணி வண்ணா! என்னும்","vaTkilaL iRaiyum maNi vaNNA! ennum"],[3467,"இட்ட கால் இட்ட கையளாய் இருக்கும்","iTTa kAl iTTa kaiyaLAy irukkum"],[3468,"சிந்திக்கும் திசைக்கும் தேறும் கை கூப்பும்","sindhikkum thisaikkum thERum kai kUppum"],[3469,"மையல் செய்து என்னை மனம் கவர்ந்தானே!","maiyal seydhu ennai manam kavarndhAnE!"],[3470,"பால துன்பங்கள் இன்பங்கள் படைத்தாய்!","pAla thunbanggaL inbanggaL paDaiththAy!"],[3471,"கொழுந்து வானவர்கட்கு! என்னும் குன்றேந்திக்","kozhundhu vAnavargaTku! ennum kunREndhik"],[3472,"என் திரு மகள் சேர் மார்வனே! என்னும்","en thiru magaL sEr mArvanE! ennum"],[3473,"முடிவு இவள் தனக்கு ஒன்று அறிகிலேன் என்னும்","muDivu ivaL thanakku onRu aRigilEn ennum"],[3474,"முகில் வண்ணன் அடியை அடைந்து அருள் சூடி","mugil vaNNan aDiyai aDaindhu aruL sUDi"],[3475,"வெள்ளைச் சுரி சங்கொடு ஆழி ஏந்தித்","veLLaich suri sanggoDu Azhi Endhith"],[3476,"நானக் கருங்குழல் தோழிமீர்காள்!","nAnak karungkuzhal thOzhimIrgAL!"],[3477,"செங்கனி வாயின் திறத்ததாயும்","sengkani vAyin thiRaththadhAyum"],[3478,"இழந்த எம் மாமை திறத்துப் போன","izhandha em mAmai thiRaththup pOna"],[3479,"முனிந்து சகடம் உதைத்து மாயப்","munindhu sagaDam udhaiththu mAyap"],[3480,"காலம் பெற என்னைக் காட்டுமின்கள்","kAlam peRa ennaik kATTumingaL"],[3481,"பேர் எயில் சூழ் கடல் தென் இலங்கை","pEr eyil sUzh kaDal then ilanggai"],[3482,"கண்டதுவே கொண்டு எல்லாரும் கூடிக்","kaNDadhuvE koNDu ellArum kUDik"],[3483,"சேர்வன் சென்று என்னுடைத் தோழிமீர்காள்!","sErvan senRu ennuDaith thOzhimIrgAL!"],[3484,"நகரமும் நாடும் பிறவும் தேர்வேன்","nagaramum nADum piRavum thErvEn"],[3485,"ஊழி தோறூழி உருவும் பேரும்","Uzhi thORUzhi uruvum pErum"],[3486,"ஆழி எழச் சங்கும் வில்லும் எழ திசை","Azhi ezhach sanggum villum ezha thisai"],[3487,"ஆறு மலைக்கு எதிர்ந்து ஓடும் ஒலி அரவு","ARu malaikku edhirndhu ODum oli aravu"],[3488,"நான்றில ஏழ் மண்ணும் தானத்தவே பின்னும்","nAnRila Ezh maNNum thAnaththavE pinnum"],[3489,"நாளும் எழ நில நீரும் எழ விண்ணும்","nALum ezha nila nIrum ezha viNNum"],[3490,"ஊண் உடை மல்லர் ததர்ந்த ஒலி மன்னர்","UN uDai mallar thadharndha oli mannar"],[3491,"போழ்து மெலிந்த புன் செக்கரில் வான் திசை","pOzhdhu melindha pun sekkaril vAn thisai"],[3492,"மாறு நிரைத்து இரைக்கும் சரங்கள் இன","mARu niraiththu iraikkum saranggaL ina"],[3493,"நேர் சரிந்தான் கொடிக் கோழி கொண்டான் பின்னும்","nEr sarindhAn koDik kOzhi koNDAn pinnum"],[3494,"அன்று மண் நீர் எரி கால் விண் மலை முதல்","anRu maN nIr eri kAl viN malai mudhal"],[3495,"மேய் நிரை கீழ் புக மா புரள சுனை","mEy nirai kIzh puga mA puraLa sunai"],[3496,"குன்றம் எடுத்த பிரான் அடியாரொடும்","kunRam eDuththa pirAn aDiyAroDum"],[3497,"கற்பார் இராம பிரானை அல்லால் மற்றும் கற்பரோ?","kaRpAr irAma pirAnai allAl maRRum kaRparO?"],[3498,"நாட்டில் பிறந்தவர் நாரணற்கு ஆள் அன்றி ஆவரோ?","nATTil piRandhavar nAraNaRku AL anRi AvarO?"],[3499,"கேட்பார்கள் கேசவன் கீர்த்தி அல்லால் மற்றும் கேட்பரோ?","kETpArgaL kEsavan kIrththi allAl maRRum kETparO?"],[3500,"தன்மை அறிபவர் தாம் அவற்கு ஆள் அன்றி ஆவரோ?","thanmai aRipavar thAm avaRku AL anRi AvarO?"],[3501,"சூழல்கள் சிந்திக்கில் மாயன் கழல் அன்றிச் சூழ்வரோ?","sUzhalgaL sindhikkil mAyan kazhal anRich sUzhvarO?"],[3502,"கேட்டும் உணர்ந்தவர் கேசவற்கு ஆள் அன்றி ஆவரோ?","kETTum uNarndhavar kEsavaRku AL anRi AvarO?"],[3503,"கண்டும் தெளிந்தும் கற்றார் கண்ணற்கு ஆள் அன்றி ஆவரோ?","kaNDum theLindhum kaRRAr kaNNaRku AL anRi AvarO?"],[3504,"செல்ல உணர்ந்தவர் செல்வன் தன் சீர் அன்றிக் கற்பரோ?","sella uNarndhavar selvan than sIr anRik kaRparO?"],[3505,"மாயம் அறிபவர் மாயவற்கு ஆள் அன்றி ஆவரோ?","mAyam aRibavar mAyavaRku AL anRi AvarO?"],[3506,"வார்த்தை அறிபவர் மாயவற்கு ஆள் அன்றி ஆவரோ?","vArththai aRibavar mAyavaRku AL anRi AvarO?"],[3507,"தெளிவுற்று வீவின்றி நின்றவர்க்கு இன்பக் கதி செய்யும்","theLivuRRu vIvinRi ninRavarkku inbak kadhi seyyum"],[3508,"பா மரு மூவுலகும் படைத்த","pA maru mUvulagum paDaiththa"],[3509,"என்று கொல் சேர்வது? அந்தோ! அரன்","enRu kol sErvadhu? andhO! aran"],[3510,"காத்த எம் கூத்தாவோ! மலை ஏந்திக்","kAththa em kUththAvO! malai Endhik"],[3511,"எங்குத் தலைப்பெய்வன் நான்? எழில்","engguth thalaippeyvan nAn? ezhil"],[3512,"என்னுடைக் கோவலனே! என்","ennuDaik kOvalanE! en"],[3513,"வந்து எய்தும் ஆறு அறியேன் மல்கு","vandhu eydhum ARu aRiyEn malgu"],[3514,"என் திருமார்பன் தன்னை என்","en thirumArban thannai en"],[3515,"ஆளியைக் காண்பரியாய் அரி காண்","ALiyaik kANbariyAy ari kAN"],[3516,"காண்டுங்கொலோ? நெஞ்சமே! கடிய","kANDungkolO? nenjchamE! kaDiya"],[3517,"ஏற்றரும் வைகுந்தத்தை அருளும்","ERRarum vaikundhaththai aruLum"],[3518,"புக்க அரி உருவாய் அவுணன்","pukka ari uruvAy avuNan"],[3519,"ஏழையர் ஆவி உண்ணும் இணைக்","Ezhaiyar Avi uNNum iNaik"],[3520,"ஆட்டியும் தூற்றியும் நின்று அன்னைமீர்!","ATTiyum thURRiyum ninRu annaimIr!"],[3521,"வாலியதோர் கனி கொல்?","vAliyadhOr kani kol?"],[3522,"இன்னுயிர்க்கு ஏழையர் மேல் வளையும்","innuyirkku Ezhaiyar mEl vaLaiyum"],[3523,"என்று நின்றே திகழும் செய்ய ஈன்","enRu ninRE thigazhum seyya In"],[3524,"உய்விடம் ஏழையர்க்கும்","uyviDam Ezhaiyarkkum"],[3525,"காண்மின்கள் அன்னையர்காள்! என்று","kANmingaL annaiyargAL! enRu"],[3526,"கோள் இழைத் தாமரையும்","kOL izhaith thAmaraiyum"],[3527,"கொள்கின்ற கோள் இருளைச்","koLginRa kOL iruLaich"],[3528,"நிற்றி முற்றத்துள் என்று நெரித்த","niRRi muRRaththuL enRu neriththa"],[3529,"கட்கரிய பிரமன் சிவன்","kaTkariya piraman sivan"],[3530,"மாயா! வாமனனே! மதுசூதா! நீ அருளாய்","mAyA! vAmananE! madhusUdhA! nI aruLAy"],[3531,"அங்கண் மலர்த் தண் துழாய் முடி அச்சுதனே! அருளாய்","angkaN malarth thaN thuzhAy muDi achchudhanE! aruLAy"],[3532,"சித்திரத் தேர் வலவா! திருச் சக்கரத்தாய்! அருளாய்","chiththirath thEr valavA! thiruch chakkaraththAy! aruLAy"],[3533,"கள்ளவிழ் தாமரைக் கண் கண்ணனே! எனக்கு ஒன்று அருளாய்","kaLLavizh thAmaraik kaN kaNNanE! enakku onRu aruLAy"],[3534,"பாசங்கள் நீக்கி என்னை உனக்கே அறக் கொண்டிட்டு நீ","pAsanggaL nIkki ennai unakkE aRak koNDiTTu nI"],[3535,"மயக்கா! வாமனனே! மதி ஆம் வண்ணம் ஒன்று அருளாய்","mayakkA! vAmananE! madhi Am vaNNam onRu aruLAy"],[3536,"துயரங்கள் செய்யும் கண்ணா! சுடர் நீள் முடியாய்! அருளாய்","thuyaranggaL seyyum kaNNA! suDar nIL muDiyAy! aruLAy"],[3537,"என்ன சுண்டாயங்களால் நின்றிட்டாய்? என்னை ஆளும் கண்ணா!","enna suNDAyanggaLAl ninRiTTAy? ennai ALum kaNNA!"],[3538,"என்ன இயற்கைகளால் எங்ஙனே நின்றிட்டாய்? என் கண்ணா!","enna iyaRkaigaLAl engnganE ninRiTTAy? en kaNNA!"],[3539,"இல்லை நுணுக்கங்களே இதனில் பிறிது என்னும் வண்ணம்","illai nuNukkanggaLE idhanil piRidhu ennum vaNNam"],[3540,"ஆம் வண்ணம் இன்னது ஒன்றென்று அறிவது அரிய அரியை","Am vaNNam innadhu onRenRu aRivadhu ariya ariyai"],[3541,"என்றைக்கும் என்னை உய்யக் கொண்டு போகிய","enRaikkum ennai uyyak koNDu pOgiya"],[3542,"என் சொல்லி நிற்பன்? என் இன்னுயிர் இன்று ஒன்றாய்","en solli niRpan? en innuyir inRu onRAy"],[3543,"ஆம் முதல்வன் இவன் என்று தற்றேற்றி என்","Am mudhalvan ivan enRu thaRRERRi en"],[3544,"அப்பனை என்று மறப்பன்? என் ஆகியே","appanai enRu maRappan? en AgiyE"],[3545,"சீர் கண்டு கொண்டு திருந்து நல் இன் கவி","sIr kaNDu koNDu thirundhu nal in kavi"],[3546,"இன் கவி பாடும் பரம கவிகளால்","in kavi pADum parama kavigaLAl"],[3547,"வைகுந்த நாதன் என வல்வினை மாய்ந்தற","vaikuntha nAdhan ena valvinai mAyndhaRa"],[3548,"ஆர்வனோ? ஆழி அங்கை எம்பிரான் புகழ்","ArvanO? Azhi angkai empirAn pugazh"],[3549,"திறத்துக்கே துப்பரவாம் திருமாலின் சீர்","thiRaththukkE thupparavAm thirumAlin sIr"],[3550,"உதவிக் கைம்மாறு என் உயிர் என்ன உற்று எண்ணில்","udhavik kaimmARu en uyir enna uRRu eNNil"],[3551,"இங்கும் அங்கும் திருமால் அன்றி இன்மை கண்டு","inggum anggum thirumAl anRi inmai kaNDu"],[3552,"இன்பம் பயக்க எழில் மலர்","inbam payakka ezhil malar"],[3553,"ஆகுங்கொல்? ஐயம் ஒன்றின்றி","Agungkol? aiyam onRinRi"],[3554,"கூடுங்கொல்? வைகலும் கோவிந்தனை","kUDungkol? vaigalum gOvindhanai"],[3555,"வாய்க்குங்கொல்? நிச்சலும் எப்பொழுதும்","vAykkungkol? nichchalum eppozhudhum"],[3556,"மலர் அடிப் போதுகள் என் நெஞ்சத்து","malar aDip pOdhugaL en nenjchaththu"],[3557,"ஒன்றும் நில்லா கெடும் முற்றவும்","onRum nillA keDum muRRavum"],[3558,"நீணகரம் அதுவே மலர்ச்","nINagaram adhuvE malarch"],[3559,"அன்றி மற்றொன்று இலம் நின் சரணே","anRi maRRonRu ilam nin charaNE"],[3560,"தீவினை உள்ளத்தின் சார்வு அல்ல ஆகித்","thIvinai uLLaththin sArvu alla Agith"],[3561,"சிந்தை மற்றொன்றின் திறத்தது அல்லாத்","sindhai maRRonRin thiRaththadhu allAth"],[3562,"தீர்த்தனுக்கு அற்ற பின் மற்றோர்","thIrththanukku aRRa pin maRROr"],[3563,"தேவிமார் ஆவார் திருமகள் பூமி","dhEvimAr AvAr thirumagaL bUmi"],[3564,"காணும் ஆறு அருளாய் என்று என்றே கலங்கிக்","kANum ARu aruLAy enRu enRE kalanggik"],[3565,"எடுத்த பேராளன் நந்தகோபன் தன்","eDuththa pErALan nandhagOpan than"],[3566,"உமர் உகந்து உகந்த உருவம் நின் உருவம் ஆகி","umar ugandhu ugandha uruvam nin uruvam Agi"],[3567,"ஆருயிரேயோ! அகல் இடம் முழுதும்","AruyirEyO! agal iDam muzhudhum"],[3568,"எங்கு வந்து உறுகோ? என்னை ஆள்வானே!","enggu vandhu uRugO? ennai ALvAnE!"],[3569,"இறந்ததும் நீயே எதிர்ந்ததும் நீயே","iRandhadhum nIyE edhirndhadhum nIyE"],[3570,"மணந்த பேர் ஆயா! மாயத்தால் முழுதும்","maNandha pEr AyA! mAyaththAl muzhudhum"],[3571,"யானும் நீ தானே ஆவதோ மெய்யே","yAnum nI thAnE AvadhO meyyE"],[3572,"தாள்களை எனக்கே தலைத் தலைச் சிறப்பத்","thALgaLai enakkE thalaith thalaich siRappath"],[3573,"பெரிய அப்பனைப் பிரமன் அப்பனை","periya appanaip piraman appanai"],[3574,"நங்கள் வரி வளை ஆயங்காளோ!","nanggaL vari vaLai AyanggALO!"],[3575,"வேன்டிச் சென்று ஒன்று பெறுகிற்பாரில்","vENDich senRu onRu peRugiRpAril"],[3576,"காலம் இளைக்கில் அல்லால் வினையேன்","kAlam iLaikkil allAl vinaiyEn"],[3577,"கூடச் சென்றேன் இனி என் கொடுக்கேன்?","kUDach senREn ini en koDukkEn?"],[3578,"ஆழி வலவனை ஆதரிப்பும் ஆங்கவன்","Azhi valavanai Adharippum Anggavan"],[3579,"தொல்லை அஞ்சோதி நினைக்குங்கால் என்","thollai anjchOdhi ninaikkunggAl en"],[3580,"மால் அரி கேசவன் நாரணன் சீமாதவன்","mAl ari kEsavan nAraNan sImAdhavan"],[3581,"இடை இல்லை யான் வளர்த்த கிளிகாள்!","iDai illai yAn vaLarththa kiLigAL!"],[3582,"காண் கொடுப்பான் அல்லன் ஆர்க்கும் தன்னைக்","kAN koDuppAn allan Arkkum thannaik"],[3583,"என்னுடை நன்னுதல் நங்கைமீர்காள்!","ennuDai nannudhal nanggaimIrgAL!"],[3584,"பாதம் அடைவதன் பாசத்தாலே","pAdham aDaivadhan pAsaththAlE"],[3585,"அங்கும் இங்கும் வானவர் தானவர் யாவரும்","anggum inggum vAnavar thAnavar yAvarum"],[3586,"சரணம் ஆகிய நான்மறை நூல்களும் சாராதே","saraNam Agiya nAnmaRai nUlgaLum sArAdhE"],[3587,"ஆளும் ஆளார் ஆழியும் சங்கும் சுமப்பார் தாம்","ALum ALAr Azhiyum sanggum sumappAr thAm"],[3588,"ஞாலம் போனகம் பற்றி ஓர் முற்றா உரு ஆகி","njAlam pOnagam paRRi Or muRRA uru Agi"],[3589,"கொடி ஆர் மாடக் கோளுர் அகத்தும் புளிங்குடியும்","koDi Ar mADak kOLur agaththum puLingkuDiyum"],[3590,"பணியா அமரர் பணிவும் பண்பும் தாமேயாம்","paNiyA amarar paNivum paNbum thAmEyAm"],[3591,"வருவார் செல்வார் வண் பரிசாரத்து இருந்த என்","varuvAr selvAr vaN parisAraththu irundha en"],[3592,"என்றே என்னை உன் ஏரார் கோலத் திருந்து அடிக் கீழ்","enRE ennai un ErAr kOlath thirundhu aDik kIzh"],[3593,"திருமால்! நான்முகன் செஞ்சடையான் என்றிவர்கள் எம்","thirumAl! nAnmugan senjchaDaiyAn enRivargaL em"],[3594,"கலக்கம் இல்லா நல் தவ முனிவர் கரை கண்டோர்","kalakkam illA nal thava munivar karai kaNDOr"],[3595,"உரையா வெந்நோய் தவிர அருள் நீள் முடியானை","uraiyA vennOy thavira aruL nIL muDiyAnai"],[3596,"வார் கடா அருவி யானை மா மலையின்","vAr kaDA aruvi yAnai mA malaiyin"],[3597,"எங்கள் செல் சார்வு யாமுடை அமுதம்","enggaL sel sArvu yAmuDai amudham"],[3598,"என் அமர் பெருமான் இமையவர் பெருமான்","en amar perumAn imaiyavar perumAn"],[3599,"பிறிது இல்லை எனக்குப் பெரிய மூவுலகும்","piRidhu illai enakkup periya mUvulagum"],[3600,"அல்லதோர் அரணும் அவனில் வேறு இல்லை","alladhOr araNum avanil vERu illai"],[3601,"எனக்கு நல் அரணை எனது ஆருயிரை","enakku nal araNai enadhu Aruyirai"],[3602,"திருச்செங்குன்றூரில் திருச்சிற்றாறு அதனுள்","thiruchchengkunRUril thiruchchiRRARu adhanuL"],[3603,"திகழ என் சிந்தையுள் இருந்தானைச்","thigazha en sindhaiyuL irundhAnaich"],[3604,"படைப்பொடு கெடுப்புக் காப்பு அவன் பிரம","paDaippoDu keDuppuk kAppu avan pirama"],[3605,"அமர்ந்த நாதனை அவர் அவர் ஆகி","amarndha nAthanai avar avar Agi"],[3606,"தேனை நன்பாலைக் கன்னலை அமுதைத்","thEnai nanpAlaik kannalai amudhaith"],[3607,"மாயக் கூத்தா! வாமனா!","mAyak kUththA! vAmanA!"],[3608,"காண வாராய் என்றென்று","kANa vArAy enRenRu"],[3609,"முடி சேர் சென்னி அம்மா! நின்","muDi sEr senni ammA! nin"],[3610,"தூநீர் முகில் போல் தோன்றும் நின்","thUnIr mugil pOl thOnRum nin"],[3611,"சொல்ல மாட்டேன் அடியேன் உன்","solla mATTEn aDiyEn un"],[3612,"கொண்டல் வண்ணா! குடக் கூத்தா!","koNDal vaNNA! kuDak kUththA!"],[3613,"வந்து தோன்றாய் அன்றேல் உன்","vandhu thOnRAy anREl un"],[3614,"ஒக்கும் அம்மான் உருவம் என்று","okkum ammAn uruvam enRu"],[3615,"இதுவோ பொருத்தம்? மின் ஆழிப்","idhuvO poruththam? min Azhip"],[3616,"பிறந்த மாயா! பாரதம்","piRandha mAyA! bAratham"],[3617,"எங்கே காண்கேன்! ஈன் துழாய்","enggE kANgEn! In thuzhAy"],[3618,"எல்லியும் காலையும் தன்னை நினைந்து எழ","elliyum kAlaiyum thannai ninaindhu ezha"],[3619,"திருக்கடித்தானமும் என்னுடைச் சிந்தையும்","thirukkaDiththAnamum ennuDaich sindhaiyum"],[3620,"ஒருவர் இருவர் ஓர் மூவர் என நின்று","oruvar iruvar Or mUvar ena ninRu"],[3621,"மாயப் பிரான் என வல் வினை மாய்ந்து அற","mAyap pirAn ena val vinai mAyndhu aRa"],[3622,"கோயில் கொண்டான் தன் திருக்கடித்தானத்தை","kOyil koNDAn than thirukkaDiththAnaththai"],[3623,"கூத்த அம்மான் கொடியேன் இடர் முற்றவும்","kUththa ammAn koDiyEn iDar muRRavum"],[3624,"கொண்மின் இடர் கெட உள்ளத்துக் கோவிந்தன்","koNmin iDar keDa uLLaththuk gOvindhan"],[3625,"தான நகர்கள் தலைச் சிறந்து எங்கெங்கும்","thAna nagargaL thalaich chiRandhu enggenggum"],[3626,"தாயப் பதிகள் தலைச் சிறந்து எங்கெங்கும்","thAyap padhigaL thalaich chiRandhu enggenggum"],[3627,"அற்புதன் நாராயணன் அரி வாமனன்","aRpudhan nArAyaNan ari vAmanan"],[3628,"சோலை திருக்கடித்தானத்து உறை திரு","sOlai thirukkaDiththAnaththu uRai thiru"],[3629,"இருத்தும் வியந்து என்னைத் தன் பொன் அடிக் கீழ் என்று","iruththum viyandhu ennaith than pon aDik kIzh enRu"],[3630,"இருந்தான் கண்டு கொண்டு எனது ஏழை நெஞ்சாளும்","irundhAn kaNDu koNDu enadhu Ezhai nenjchALum"],[3631,"அருள் தான் இனி யான் அறியேன் அவன் என் உள்","aruL thAn ini yAn aRiyEn avan en uL"],[3632,"மாய மயக்கு மயக்கான் என்னை வஞ்சித்து","mAya mayakku mayakkAn ennai vanjchiththu"],[3633,"திகழும் தன் திரு அருள் செய்து உலகத்தார்","thigazhum than thiru aruL seydhu ulagaththAr"],[3634,"பொருள் மற்று எனக்கும் ஓர் பொருள் தன்னில் சீர்க்கத்","poruL maRRu enakkum Or poruL thannil sIrkkath"],[3635,"செவ்வாய் உந்தி வெண் பல் சுடர்க் குழை தம்மோடு","sevvAy undhi veN pal suDark kuzhai thammODu"],[3636,"அறியேன் மற்று அருள் என்னை ஆளும் பிரானார்","aRiyEn maRRu aruL ennai ALum pirAnAr"],[3637,"வயிற்றில் கொண்டு நின்றொழிந்தாரும் யவரும்","vayiRRil koNDu ninRozhindhArum yavarum"],[3638,"வைத்தேன் மதியால் எனது உள்ளத்து அகத்தே","vaiththEn madhiyAl enadhu uLLaththu agaththE"],[3639,"சுடர்ப் பாம்பணை நம் பரனைத் திருமாலை","suDarp pAmbaNai nam paranaith thirumAlai"],[3640,"கண்கள் சிவந்து பெரியவாய்","kaNgaL sivandhu periyavAy"],[3641,"அடியேன் உள்ளான் உடல் உள்ளான்","aDiyEn uLLAn uDal uLLAn"],[3642,"உணர்வில் உம்பர் ஒருவனை","uNarvil umbar oruvanai"],[3643,"யானும் தானாய் ஒழிந்தானை","yAnum thAnAy ozhindhAnai"],[3644,"நின்ற ஒன்றை உணர்ந்தேனுக்கு","ninRa onRai uNarndhEnukku"],[3645,"நன்றாய் ஞானம் கடந்து போய்","nanRAy njAnam kaDandhu pOy"],[3646,"அதுவே வீடு வீடு பேற்று","adhuvE vIDu vIDu pERRu"],[3647,"எய்த்தார் எய்த்தார் எய்த்தார் என்று","eyththAr eyththAr eyththAr enRu"],[3648,"கூடிற்று ஆகில் நல் உறைப்புக்","kUDiRRu Agil nal uRaippuk"],[3649,"உளரும் இல்லை அல்லராய்","uLarum illai allarAy"],[3650,"தெருளும் மருளும் மாய்த்துத் தன்","theruLum maruLum mAyththuth than"],[3651,"கரு மாணிக்க மலை மேல் மணித் தடம்","karu mANikka malai mEl maNith thaDam"],[3652,"அன்னைமீர் இதற்கு என் செய்கேன்?","annaimIr idhaRku en seygEn?"],[3653,"புகழும் இவள் நின்று இராப் பகல்","pugazhum ivaL ninRu irAp pagal"],[3654,"ஊர் வளம் கிளர் சோலையும்","Ur vaLam kiLar sOlaiyum"],[3655,"புனை இழைகள் அணிவும்","punai izhaigaL aNivum"],[3656,"திருவருள் மூழ்கி வைகலும்","thiruvaruL mUzhgi vaigalum"],[3657,"மெல் இலைச் செல்வ வண்கொடிப் புல்க","mel ilaich selva vaNkoDip pulga"],[3658,"மடவரல் அன்னைமீர்கட்கு என் சொல்லிச்","maDavaral annaimIrgaTku en sollich"],[3659,"பரவாள் இவள் நின்று இராப் பகல்","paravAL ivaL ninRu irAp pagal"],[3660,"அன்றி மற்றோர் உபாயம் என்? இவள்","anRi maRROr upAyam en? ivaL"],[3661,"நேர்ப்பட்ட நிறை மூவுலகுக்கும்","nErppaTTa niRai mUvulagukkum"],[3662,"நெடுமாற்கு அடிமை செய்வேன் போல் அவனைக் கருத வஞ்சித்து","neDumARku aDimai seyvEn pOl avanaik karudha vanjchiththu"],[3663,"வியன் மூவுலகு பெறினும் போய்த் தானே தானே ஆனாலும்","viyan mUvulagu peRinum pOyth thAnE thAnE AnAlum"],[3664,"உறுமோ பாவியேனுக்கு? இவ்வுலகம் மூன்றும் உடன் நிறைய","uRumO pAviyEnukku? ivvulagam mUnRum uDan niRaiya"],[3665,"இங்கே திரிந்தேற்கு இழுக்குற்றென்? இரு மா நிலம் முன் உண்டு உமிழ்ந்த","inggE thirindhERku izhukkuRRen? iru mA nilam mun uNDu umizhndha"],[3666,"வழிபட்டு ஓட அருள் பெற்று மாயன் கோல மலர் அடிக் கீழ்","vazhipaTTu ODa aruL peRRu mAyan kOla malar aDik kIzh"],[3667,"நுகர்ச்சி உறுமோ? மூவுலகின் வீடு பேறு தன் கேழ் இல்","nugarchchi uRumO? mUvulagin vIDu pERu than kEzh il"],[3668,"தனி மாப் புகழே எஞ்ஞான்றும் நிற்கும்படியாத் தான் தோன்றி","thani mAp pugazhE enjnjAnRum niRkumpaDiyAth thAn thOnRi"],[3669,"நாளும் வாய்க்க நங்கட்கு நளிர் நீர்க் கடலைப் படைத்து தன்","nALum vAykka nanggaTku naLir nIrk kaDalaip paDaiththu than"],[3670,"தமர்கள் கூட்ட வல் வினையை நாசம் செய்யும் சதிர் மூர்த்தி","thamargaL kUTTa val vinaiyai nAsam seyyum sadhir mUrththi"],[3671,"வாய்க்க தமியேற்கு ஊழி தோறூழி ஊழி மா காயாம்","vAykka thamiyERku Uzhi thORUzhi Uzhi mA kAyAm"],[3672,"நல்ல கோட்பாட்டு உலகங்கள் மூன்றின் உள்ளும் தான் நிறைந்த","nalla kOTpATTu ulaganggaL mUnRin uLLum thAn niRaindha"],[3673,"கொண்ட பெண்டிர் மக்கள் உற்றார் சுற்றத்தவர் பிறரும்","koNDa peNDir makkaL uRRAr suRRaththavar piRarum"],[3674,"துணையும் சார்வும் ஆகுவார் போல் சுற்றத்தவர் பிறரும்","thuNaiyum sArvum AguvAr pOl suRRaththavar piRarum"],[3675,"பொருள் கை உண்டாய்ச் செல்லக் காணில் போற்றி என்று ஏற்று எழுவர்","poruL kai uNDAych sellak kANil pORRi enRu ERRu ezhuvar"],[3676,"அரணம் ஆவர் அற்ற காலைக்கு என்றென்று அமைக்கப்பட்டார்","araNam Avar aRRa kAlaikku enRenRu amaikkappaTTAr"],[3677,"சதிரம் என்று தம்மைத் தாமே சம்மதித்து இன்மொழியார்","sadhiram enRu thammaith thAmE sammadhiththu inmozhiyAr"],[3678,"இல்லை கண்டீர் இன்பம் அந்தோ! உள்ளது நினையாதே","illai kaNDIr inbam andhO! uLLadhu ninaiyAdhE"],[3679,"மற்றொன்று இல்லை சுருங்கச் சொன்னோம் மா நிலத்து எவ்வுயிர்க்கும்","maRRonRu illai surunggach sonnOm mA nilaththu evvuyirkkum"],[3680,"வாழ்தல் கண்டீர் குணம் இதந்தோ? மாயவன் அடி பரவி","vAzhdhal kaNDIr guNam idhandhO? mAyavan aDi paravi"],[3681,"யாதும் இல்லை மிக்கு அதனில் என்றென்று அது கருதி","yAdhum illai mikku adhanil enRenRu adhu karudhi"],[3682,"கண்ணன் அல்லால் இல்லை கண்டீர் சரண் அது நிற்க வந்து","kaNNan allAl illai kaNDIr saraN adhu niRka vandhu"],[3683,"ஆதும் இல்லை மற்று அவனில் என்றதுவே துணிந்து","Adhum illai maRRu avanil enRadhuvE thuNindhu"],[3684,"பண்டை நாளாலே நின் திருவருளும்","paNDai nALAlE nin thiruvaruLum"],[3685,"குடி கிடந்து ஆக்கம் செய்து நின் தீர்த்த","kuDi kiDandhu Akkam seydhu nin thIrththa"],[3686,"கிடந்த நாள் கிடந்தாய் எத்தனை காலம்","kiDandha nAL kiDandhAy eththanai kAlam"],[3687,"புளிங்குடிக் கிடந்து வரகுணமங்கை","puLingkuDik kiDandhu varaguNamanggai"],[3688,"பவளம் போல் கனி வாய் சிவப்ப நீ காண","pavaLam pOl kani vAy sivappa nI kANa"],[3689,"காய் சினப் பறவை ஊர்ந்து பொன் மலையின்","kAy sinap paRavai Urndhu pon malaiyin"],[3690,"எம் இடர் கடிந்து இங்கு என்னை ஆள்வானே!","em iDar kaDindhu inggu ennai ALvAnE!"],[3691,"எங்கள் கண் முகப்பே உலகர்கள் எல்லாம்","enggaL kaN mugappE ulagargaL ellAm"],[3692,"வீற்றிடங் கொண்டு வியன் கொள் மா ஞாலத்து","vIRRiDang koNDu viyan koL mA njAlaththu"],[3693,"கொடு வினைப் படைகள் வல்லையாய் அமரர்க்கு","koDu vinaip paDaigaL vallaiyAy amararkku"],[3694,"கூவுதல் வருதல் செய்திடாய் என்று","kUvudhal varudhal seydhiDAy enRu"],[3695,"ஓர் ஆயிரமாய் உலகேழ் அளிக்கும்","Or AyiramAy ulagEzh aLikkum"],[3696,"அவனே அகல் ஞாலம் படைத்து இடந்தான்","avanE agal njAlam paDaiththu iDandhAn"],[3697,"அறிந்தன வேத அரும் பொருள் நூல்கள்","aRindhana vEdha arum poruL nUlgaL"],[3698,"மருந்தே நங்கள் போக மகிழ்ச்சிக்கு என்று","marundhE nanggaL bOga magizhchchikku enRu"],[3699,"மனமே! உன்னை வல் வினையேன் இரந்து","manamE! unnai val vinaiyEn irandhu"],[3700,"அடைவதும் அணி ஆர் மலர் மங்கை தோள்","aDaivadhum aNi Ar malar manggai thOL"],[3701,"ஆகம் சேர் நரசிங்கம் அதாகி ஓர்","Agam sEr narasinggam adhAgi Or"],[3702,"இன்றிப் போக இரு வினையும் கெடுத்து","inRip pOga iru vinaiyum keDuththu"],[3703,"தொழுது மா மலர் நீர் சுடர் தூபம் கொண்டு","thozhudhu mA malar nIr suDar dhUpam koNDu"],[3704,"தாள தாமரையான் உனது உந்தியான்","thALa thAmaraiyAn unadhu undhiyAn"],[3705,"சீலம் எல்லை இலான் அடி மேல் அணி","sIlam ellai ilAn aDi mEl aNi"],[3706,"மையார் கருங் கண்ணி கமல மலர் மேல்","maiyAr karung kaNNi kamala malar mEl"],[3707,"கண்ணே! உன்னைக் காணக் கருதி என் நெஞ்சம்","kaNNE! unnaik kANak karudhi en nenjcham"],[3708,"அழைக்கின்ற அடி நாயேன் நாய் கூழை வாலால்","azhaikkinRa aDi nAyEn nAy kUzhai vAlAl"],[3709,"உறுவது இது என்று உனக்கு ஆட்பட்டு நின் கண்","uRuvadhu idhu enRu unakku ATpaTTu nin kaN"],[3710,"அரி ஆய அம்மானை அமரர் பிரானை","ari Aya ammAnai amarar pirAnai"],[3711,"கருத்தே! உன்னைக் காணக் கருதி என் நெஞ்சத்து","karuththE! unnaik kANak karudhi en nenjchaththu"],[3712,"உகந்தே உன்னை உள்ளும் என் உள்ளத்து அகம் பால்","ugandhE unnai uLLum en uLLaththu agam pAl"],[3713,"உரு ஆகிய ஆறு சமயங்கட்கு எல்லாம்","uru Agiya ARu samayanggaTku ellAm"],[3714,"கண்டு கொண்டு என் கண் இணை ஆரக் களித்து","kaNDu koNDu en kaN iNai Arak kaLiththu"],[3715,"அடியான் இவன் என்று எனக்கு ஆரருள் செய்யும்","aDiyAn ivan enRu enakku AraruL seyyum"],[3716,"ஆறா மத யானை அடர்த்தவன் தன்னை","ARA madha yAnai aDarththavan thannai"],[3717,"இன் உயிர்ச் சேவலும் நீரும் கூவிக் கொண்டு இங்கு எத்தனை","in uyirch sEvalum nIrum kUvik koNDu inggu eththanai"],[3718,"இத்தனை வேண்டுவது அன்று அந்தோ! அன்றில் பேடைகாள்!","iththanai vENDuvadhu anRu andhO! anRil pEDaigAL!"],[3719,"அவன் கையதே எனது ஆருயிர் அன்றில் பேடைகாள்!","avan kaiyadhE enadhu Aruyir anRil pEDaigAL!"],[3720,"கூக்குரல் கேட்டும் நம் கண்ணன் மாயன் வெளிப்படான்","kUkkural kETTum nam kaNNan mAyan veLippaDAn"],[3721,"அந்தரம் நின்று உழல்கின்ற யானுடைப் பூவைகாள்!","andharam ninRu uzhalginRa yAnuDaip pUvaigAL!"],[3722,"நன்கு எண்ணி நான் வளர்த்த சிறு கிளிப் பைதலே!","nanku eNNi nAn vaLarththa siRu kiLip paidhalE!"],[3723,"கூட்டுண்டு நீங்கிய கோலத் தாமரைக் கண் செவ்வாய்","kUTTuNDu nInggiya kOlath thAmaraik kaN sevvAy"],[3724,"உயிர்க்கு அது காலன் என்று உம்மை யான் இரந்தேற்கு நீர்","uyirkku adhu kAlan enRu ummai yAn irandhERku nIr"],[3725,"பண்புடை வண்டொடு தும்பிகாள்! பண் மிழற்றேல்மின்","paNbuDai vaNDoDu thumbigAL! paN mizhaRRElmin"],[3726,"எழ நண்ணி நாமும் நம் வான நாடனோடு ஒன்றினோம்","ezha naNNi nAmum nam vAna nADanODu onRinOm"],[3727,"இன்பம் தலைப்பெய்து எங்கும் தழைத்த பல் ஊழிக்கு","inbam thalaippeydhu enggum thazhaiththa pal Uzhikku"],[3728,"உருகுமால் நெஞ்சம் உயிரின் பரம் அன்றி","urugumAl nenjcham uyirin param anRi"],[3729,"நினைதொறும் சொல்லுந்தொறும் நெஞ்சு இடிந்து உகும்","ninaithoRum sollunthoRum nenjchu iDindhu ugum"],[3730,"நீர்மையால் நெஞ்சம் வஞ்சித்துப் புகுந்து என்னை","nIrmaiyAl nenjcham vanjchiththup pugundhu ennai"],[3731,"அறிகிலேன் தன்னுள் அனைத்து உலகும் நிற்க","aRigilEn thannuL anaiththu ulagum niRka"],[3732,"திரு அருள் செய்பவன் போல என்னுள் புகுந்து","thiru aruL seybavan pOla ennuL pugundhu"],[3733,"என் கண்ணன் கள்வம் எனக்குச் செம்மாய் நிற்கும்","en kaNNan kaLvam enakkuch semmAy niRkum"],[3734,"காட்கரை ஏத்தும் அதனுள் கண்ணா! என்னும்","kATkarai Eththum adhanuL kaNNA! ennum"],[3735,"கோள் உண்டான் அன்றி வந்து என் உயிர் தான் உண்டான்","kOL uNDAn anRi vandhu en uyir thAn uNDAn"],[3736,"ஆருயிர் பட்டது எனது உயிர் பட்டது?","Aruyir paTTadhu enadhu uyir paTTadhu?"],[3737,"வாரிக் கொண்டு உன்னை விழுங்குவன் காணில் என்று","vArik koNDu unnai vizhungguvan kANil enRu"],[3738,"கடியனாய்க் கஞ்சனைக் கொன்ற பிரான் தன்னை","kaDiyanAyk kanjchanaik konRa pirAn thannai"],[3739,"எங்கானல் அகம் கழிவாய் இரைத் தேர்ந்து இங்கு இனிது அமரும்","engkAnal agam kazhivAy iraith thErndhu inggu inidhu amarum"],[3740,"நுமரோடும் பிரியாதே நீரும் நும் சேவலுமாய்","numarODum piriyAdhE nIrum num sEvalumAy"],[3741,"தக்கிலமே? கேளீர்கள் தடம் புனல் வாய் இரை தேரும்","thakkilamE? kELIrgaL thaDam punal vAy irai thErum"],[3742,"திருமேனி அடிகளுக்குத் தீ வினையேன் விடு தூதாய்","thirumEni aDigaLukkuth thI vinaiyEn viDu thUdhAy"],[3743,"தெளி விசும்பு கடிது ஓடித் தீ வளைத்து மின் இலகும்","theLi visumbu kaDidhu ODith thI vaLaiththu min ilagum"],[3744,"தூது உரைத்தல் செப்புமின்கள் தூ மொழி வாய் வண்டு இனங்காள்!","thUdhu uraiththal seppumingaL thU mozhi vAy vaNDu inanggAL!"],[3745,"சுடர் வளையும் கலையும் கொண்டு அருவினையேன் தோள் துறந்த","suDar vaLaiyum kalaiyum koNDu aruvinaiyEn thOL thuRandha"],[3746,"எனக்கு ஒன்று பணியீர்கள் இரும் பொழில் வாய் இரை தேர்ந்து","enakku onRu paNiyIrgaL irum pozhil vAy irai thErndhu"],[3747,"பூந்துழாய் முடியார்க்குப் பொன் ஆழிக் கையாருக்கு","pUnthuzhAy muDiyArkkup pon Azhik kaiyArukku"],[3748,"தகவன்று என்று உரையீர்கள் தடம் புனல் வாய் இரை தேர்ந்து","thagavanRu enRu uraiyIrgaL thaDam punal vAy irai thErndhu"],[3749,"ஒழிவு இன்றித் திருமூழிக்களத்து உறையும் ஒண்சுடரை","ozhivu inRith thirumUzhikkaLaththu uRaiyum oNsuDarai"],[3750,"அறுக்கும் வினை ஆயின ஆகத்து அவனை","aRukkum vinai Ayina Agaththu avanai"],[3751,"கொடி ஏர் இடைக் கோகனகத்தவள் கேள்வன்","koDi Er iDaik kOkanagaththavaL kELvan"],[3752,"எவை கொல் அணுகப் பெறு நாள்? என்று எப்போதும்","evai kol aNugap peRu nAL? enRu eppOdhum"],[3753,"நாளேல் அறியேன் எனக்கு உள்ளன நானும்","nALEl aRiyEn enakku uLLana nAnum"],[3754,"மணாளன் மலர் மங்கைக்கும் மண் மடந்தைக்கும்","maNALan malar manggaikkum maN maDandhaikkum"],[3755,"கண்டே களிக்கின்றது இங்கு என்று கொல்? கண்கள்","kaNDE kaLikkinRadhu inggu enRu kol? kaNgaL"],[3756,"கோ ஆகிய மாவலியை நிலம் கொண்டாய்!","kO Agiya mAvaliyai nilam koNDAy!"],[3757,"அருளாது ஒழிவாய் அருள் செய்து அடியேனைப்","aruLAdhu ozhivAy aruL seydhu aDiyEnaip"],[3758,"தேவர் முனிவர்க்கு என்றும் காண்டற்கு அரியன்","dhEvar munivarkku enRum kANDaRku ariyan"],[3759,"அந்தோ! அணுகப் பெறு நாள் என்று எப்போதும்","andhO! aNugap peRu nAL enRu eppOdhum"],[3760,"வண்ணம் மணி மாட நல் நாவாய் உள்ளானை","vaNNam maNi mADa nal nAvAy uLLAnai"],[3761,"மல்லிகை கமழ் தென்றல் ஈரும் ஆலோ!","malligai kamazh thenRal Irum AlO!"],[3762,"புகல் இடம் அறிகிலம் தமியம் ஆலோ!","pugal iDam aRigilam thamiyam AlO!"],[3763,"இனி இருந்து என் உயிர் காக்கும் ஆறு என்?","ini irundhu en uyir kAkkum ARu en?"],[3764,"பாவியேன் மனத்தே நின்று ஈரும் ஆலோ!","pAviyEn manaththE ninRu Irum AlO!"],[3765,"யாம் உடை நெஞ்சமும் துணை அன்றாலோ!","yAm uDai nenjchamum thuNai anRAlO!"],[3766,"அவன் உடை அருள் பெறும் போது அரிதால்","avan uDai aruL peRum pOdhu aridhAl"],[3767,"ஆருக்கு என் சொல்லுகேன்? அன்னைமீர்காள்!","Arukku en sollugEn? annaimIrgAL!"],[3768,"புது மணம் முகந்து கொண்டு எறியும் ஆலோ!","pudhu maNam mugandhu koNDu eRiyum AlO!"],[3769,"ஊதும் அத்தீங்குழற்கே உய்யேன் நான்","Udhum aththIngkuzhaRkE uyyEn nAn"],[3770,"மாலையும் வந்தது மாயன் வாரான்","mAlaiyum vandhadhu mAyan vArAn"],[3771,"அவனை விட்டு அகன்று உயிர் ஆற்ற கில்லா","avanai viTTu aganRu uyir ARRa killA"],[3772,"மாலை நண்ணித் தொழுது எழுமினோ வினை கெட","mAlai naNNith thozhudhu ezhuminO vinai keDa"],[3773,"கள் அவிழும் மலர் இட்டு நீர் இறைஞ்சுமின்","kaL avizhum malar iTTu nIr iRainjchumin"],[3774,"தொண்டர்! நுந்தம் துயர் போக நீர் ஏகமாய்","thoNDar! nuntham thuyar pOga nIr EkamAy"],[3775,"மானை நோக்கி மடப் பின்னை தன் கேள்வனை","mAnai nOkki maDap pinnai than kELvanai"],[3776,"சரணம் ஆகும் தன தாள் அடைந்தார்க்கு எல்லாம்","saraNam Agum thana thAL aDaindhArkku ellAm"],[3777,"அன்பன் ஆகும் தன தாள் அடைந்தார்க்கு எல்லாம்","anban Agum thana thAL aDainthArkku ellAm"],[3778,"மெய்யன் ஆகும் விரும்பித் தொழுவார்க்கு எல்லாம்","meyyan Agum virumbith thozhuvArkku ellAm"],[3779,"அணியன் ஆகும் தன தாள் அடைந்தார்க்கு எல்லாம்","aNiyan Agum thana thAL aDainthArkku ellAm"],[3780,"பாத நாளும் பணியத் தணியும் பிணி","pAdha nALum paNiyath thaNiyum piNi"],[3781,"இல்லை அல்லல் எனக்கேல் இனி என் குறை?","illai allal enakkEl ini en kuRai?"],[3782,"பாடு சாரா வினை பற்றற வேண்டுவீர்","pADu sArA vinai paRRaRa vENDuvIr"],[3783,"தாள தாமரைத் தடம் அணி வயல் திருமோகூர்","thALa thAmaraith thaDam aNi vayal thirumOgUr"],[3784,"இலம் கதி மற்றொன்று எம்மைக்கும் ஈன் தண்துழாயின்","ilam kathi maRRonRu emmaikkum In thaNthuzhAyin"],[3785,"அன்றி யாம் ஒரு புகல் இடம் இலம் என்றென்று அலற்றி","anRi yAm oru pugal iDam ilam enRenRu alaRRi"],[3786,"இடர் கெட எம்மைப் போந்து அளியாய் என்றென்று ஏத்தி","iDar keDa emmaip pOndhu aLiyAy enRenRu Eththi"],[3787,"தொண்டீர்! வம்மின் நம் சுடர் ஒளி ஒரு தனி முதல்வன்","thoNDIr! vammin nam suDar oLi oru thani mudhalvan"],[3788,"கூத்தன் கோவலன் குதற்று வல் அசுரர்கள் கூற்றம்","kUththan kOvalan kudhaRRu val asurargaL kURRam"],[3789,"மற்றிலம் அரண் வான் பெரும் பாழ் தனி முதலா","maRRilam araN vAn perum pAzh thani mudhalA"],[3790,"துயர் கெடும் கடிது அடைந்து வந்து அடியவர் தொழுமின்","thuyar keDum kaDidhu aDaindhu vandhu aDiyavar thozhumin"],[3791,"மணித் தடத்தடி மலர்க் கண்கள் பவளச் செவ்வாய்","maNith thaDaththaDi malark kaNgaL pavaLach sevvAy"],[3792,"நாம் அடைந்த நல் அரண் நமக்கு என்று நல் அமரர்","nAm aDaindha nal araN namakku enRu nal amarar"],[3793,"ஏத்துமின் நமர்காள்! என்று தான் குடம் ஆடு","Eththumin namargAL! enRu thAn kuDam ADu"],[3794,"கெடும் இடர் ஆய எல்லாம் கேசவா என்ன நாளும்","keDum iDar Aya ellAm kEsavA enna nALum"],[3795,"இன்று போய்ப் புகுதிர் ஆகில் எழுமையும் ஏதம் சார","inRu pOyp pugudhir Agil ezhumaiyum Edham sAra"],[3796,"ஊரும் புட்கொடியும் அஃதே உலகெல்லாம் உண்டு உமிழ்ந்தான்","Urum puTkoDiyum aqdhE ulagellAm uNDu umizhndhAn"],[3797,"பேசுமின் கூசம் இன்றிப் பெரிய நீர் வேலை சூழ்ந்து","pEsumin kUsam inRip periya nIr vElai sUzhndhu"],[3798,"புண்ணியம் செய்து நல்ல புனலொடு மலர்கள் தூவி","puNNiyam seydhu nalla punaloDu malargaL thUvi"],[3799,"அமரராய்த் திரிகின்றார்கட்கு ஆதி சேர் அனந்தபுரத்து","amararAyth thiriginRArgaTku Adhi sEr ananthapuraththu"],[3800,"துடைத்த கோவிந்தனாரே உலகு உயிர் தேவும் மற்றும்","thuDaiththa gOvindhanArE ulagu uyir thEvum maRRum"],[3801,"கடு வினை களையல் ஆகும் காமனைப் பயந்த காளை","kaDu vinai kaLaiyal Agum kAmanaip payandha kALai"],[3802,"நாம் உமக்கு அறியச் சொன்ன நாள்களும் நணிய ஆன","nAm umakku aRiyach sonna nALgaLum naNiya Ana"],[3803,"மாய்ந்து அறும் வினைகள் தாமே மாதவா! என்ன நாளும்","mAyndhu aRum vinaigaL thAmE mAdhavA! enna nALum"],[3804,"அந்தமில் புகழ் அனந்தபுர நகர் ஆதி தன்னை","andhamil pugazh ananthapura nagar Adhi thannai"],[3805,"வேய் மரு தோள் இணை மெலியும் ஆலோ!","vEy maru thOL iNai meliyum AlO!"],[3806,"தகவிலை தகவிலையே நீ கண்ணா!","thagavilai thagavilaiyE nI kaNNA!"],[3807,"வீவன் நின் பசு நிரை மேய்க்கப் போக்கு","vIvan nin pasu nirai mEykkap pOkku"],[3808,"தொழுத்தையோம் தனிமையும் துணை பிரிந்தார்","thozhuththaiyOm thanimaiyum thuNai pirindhAr"],[3809,"பணி மொழி நினைதொறும் ஆவி வேமால்","paNi mozhi ninaithoRum Avi vEmAl"],[3810,"அடிச்சியோம் தலை மிசை நீ அணியாய்","aDichchiyOm thalai misai nI aNiyAy"],[3811,"வேம் எமது உயிர் அழல் மெழுகில் உக்கு","vEm emadhu uyir azhal mezhugil ukku"],[3812,"அசுரர்கள் தலைப் பெய்யில் யவன் கொல் ஆங்கு என்று","asurargaL thalaip peyyil yavan kol Anggu enRu"],[3813,"உகக்கு நல்லவரொடும் உழிதந்து","ugakku nallavaroDum uzhithandhu"],[3814,"அவத்தங்கள் விளையும் என் சொற்கொள் அந்தோ!","avaththanggaL viLaiyum en soRkoL andhO!"],[3815,"செங்கனிவாய் எங்கள் ஆயர் தேவு","sengkanivAy enggaL Ayar thEvu"],[3816,"சார்வே தவ நெறிக்குத் தாமோதரன் தாள்கள்","sArvE thava neRikkuth dhAmOdharan thALgaL"],[3817,"பெருமையனே வானத்து இமையோர்க்கும் காண்டற்கு","perumaiyanE vAnaththu imaiyOrkkum kANDaRku"],[3818,"ஆள்கின்றான் ஆழியான் ஆரால் குறை உடையம்?","ALginRAn AzhiyAn ArAl kuRai uDaiyam?"],[3819,"தலை மேல் புனைந்தேன் சரணங்கள் ஆலின்","thalai mEl punaindhEn saraNanggaL Alin"],[3820,"நிச்சித்து இருந்தேன் என் நெஞ்சம் கழியாமை","nichchiththu irundhEn en nenjcham kazhiyAmai"],[3821,"நாகத்து அணையானை நாள் தோறும் ஞானத்தால்","nAgaththu aNaiyAnai nAL thORum njAnaththAl"],[3822,"பணி நெஞ்சே! நாளும் பரம பரம் பரனை","paNi nenjchE! nALum parama param paranai"],[3823,"ஆழியான் ஆழி அமரர்க்கும் அப்பாலான்","AzhiyAn Azhi amararkkum appAlAn"],[3824,"கண்டேன் கமல மலர்ப் பாதம் காண்டலுமே","kaNDEn kamala malarp pAdham kANDalumE"],[3825,"வகையால் மனம் ஒன்றி மாதவனை நாளும்","vagaiyAl manam onRi mAdhavanai nALum"],[3826,"பற்று என்று பற்றிப் பரம பரம் பரனை","paRRu enRu paRRip parama param paranai"],[3827,"கண்ணன் கழல் இணை","kaNNan kazhal iNai"],[3828,"நாரணன் எம்மான்","nAraNan emmAn"],[3829,"தானே உலகு எல்லாம்","thAnE ulagu ellAm"],[3830,"ஆள்வான் ஆழி நீர்","ALvAn Azhi nIr"],[3831,"நாடீர் நாள் தோறும்","nADIr nAL thORum"],[3832,"மேயான் வேங்கடம்","mEyAn vEngkaDam"],[3833,"மாதவன் என்றென்று","mAdhavan enRenRu"],[3834,"சாரா ஏதங்கள்","sArA EdhanggaL"],[3835,"அமரர்க்கு அரியானை","amararkku ariyAnai"],[3836,"வினை வல் இருள் என்னும்","vinai val iruL ennum"],[3837,"நெடியான் அருள் சூடும்","neDiyAn aruL sUDum"],[3838,"அருள் பெறுவார் அடியார் தம் அடியனேற்கு ஆழியான்","aruL peRuvAr aDiyAr tham aDiyanERku AzhiyAn"],[3839,"வாட்டாற்றான் அடி வணங்கி மா ஞாலப் பிறப்பு அறுப்பான்","vATTARRAn aDi vaNanggi mA njAlap piRappu aRuppAn"],[3840,"நண்ணினம் நாரயணனை நாமங்கள் பல சொல்லி","naNNinam nArayaNanai nAmanggaL pala solli"],[3841,"என் நெஞ்சத்துள் இருந்து இங்கு இருந்தமிழ் நூல் இவை மொழிந்து","en nenjchaththuL irundhu inggu irunthamizh nUl ivai mozhindhu"],[3842,"வான் ஏற வழி தந்த வாட்டாற்றான் பணி வகையே","vAn ERa vazhi thandha vATTARRAn paNi vagaiyE"],[3843,"தலை மேல தாள் இணைகள் தாமரைக் கண் என் அம்மான்","thalai mEla thAL iNaigaL thAmaraik kaN en ammAn"],[3844,"குரைகழல்கள் குறுகினம் நம் கோவிந்தன் குடி கொண்டான்","kuraikazhalgaL kuRuginam nam gOvindhan kuDi koNDAn"],[3845,"மெய் நின்று கமழ் துளவ விரை ஏறு திரு முடியன்","mey ninRu kamazh thuLava virai ERu thiru muDiyan"],[3846,"திகழ்கின்ற திரு மார்பில் திரு மங்கை தன்னோடும்","thigazhginRa thiru mArbil thiru manggai thannODum"],[3847,"பிரியாது ஆட்செய் என்று பிறப்பு அறுத்து ஆளறக் கொண்டான்","piriyAdhu ATsey enRu piRappu aRuththu ALaRak koNDAn"],[3848,"காட்டித் தன் கனை கழல்கள் கடு நரகம் புகல் ஒழித்த","kATTith than kanai kazhalgaL kaDu naragam pugal ozhiththa"],[3849,"செஞ்சொற் கவிகாள்! உயிர் காத்து ஆட்செய்ம்மின் திருமாலிருஞ்சோலை","senjchoR kavigAL! uyir kAththu ATseymmin thirumAlirunjchOlai"],[3850,"தானே ஆகி நிறைந்து எல்லா உலகும் உயிரும் தானேயாய்","thAnE Agi niRaindhu ellA ulagum uyirum thAnEyAy"],[3851,"என்னை முற்றும் உயிர் உண்டு என் மாய ஆக்கை இதனுள் புக்கு","ennai muRRum uyir uNDu en mAya Akkai idhanuL pukku"],[3852,"என் கொல் அம்மான் திரு அருள்கள்? உலகும் உயிரும் தானேயாய்","en kol ammAn thiru aruLgaL? ulagum uyirum thAnEyAy"],[3853,"நண்ணா அசுரர் நவிவு எய்த நல்ல அமரர் பொலிவு எய்த","naNNA asurar navivu eydha nalla amarar polivu eydha"],[3854,"திருமாலிருஞ்சோலையானே ஆகிச் செழு மூவுலகும் தன்","thirumAlirunjchOlaiyAnE Agich sezhu mUvulagum than"],[3855,"அருளை ஈ என் அம்மானே! என்னும் முக்கண் அம்மானும்","aruLai I en ammAnE! ennum mukkaN ammAnum"],[3856,"திருமாலிருஞ்சோலை மலையே திருப்பாற்கடலே என் தலையே","thirumAlirunjchOlai malaiyE thiruppARkaDalE en thalaiyE"],[3857,"ஊழி முதல்வன் ஒருவனே என்னும் ஒருவன் உலகு எல்லாம்","Uzhi mudhalvan oruvanE ennum oruvan ulagu ellAm"],[3858,"மங்க ஒட்டு உன் மா மாயை திருமாலிருஞ்சோலை மேய","mangga oTTu un mA mAyai thirumAlirunjchOlai mEya"],[3859,"மான் ஆங்கார மனம் கெட ஐவர் வன்கையர் மங்க","mAn AnggAra manam keDa aivar vankaiyar mangga"],[3860,"திருமாலிருஞ்சோலை மலை என்றேன் என்ன","thirumAlirunjchOlai malai enREn enna"],[3861,"பேரே உறைகின்ற பிரான் இன்று வந்து","pErE uRaiginRa pirAn inRu vandhu"],[3862,"பிடித்தேன் பிறவி கெடுத்தேன் பிணி சாரேன்","piDiththEn piRavi keDuththEn piNi sArEn"],[3863,"எளிதாயின ஆறு என்று என் கண்கள் களிப்ப","eLidhAyina ARu enRu en kaNgaL kaLippa"],[3864,"வானே தருவான் எனக்கா என்னோடு ஒட்டி","vAnE tharuvAn enakkA ennODu oTTi"],[3865,"திருப்பேர் நகரான் திருமாலிருஞ்சோலை","thiruppEr nagarAn thirumAlirunjchOlai"],[3866,"உண்டு களித்தேற்கு உம்பர் என் குறை? மேலைத்","uNDu kaLiththERku umbar en kuRai? mElaith"],[3867,"கண்ணுள் நின்று அகலான் கருத்தின் கண் பெரியன்","kaNNuL ninRu agalAn karuththin kaN periyan"],[3868,"இன்று என்னைப் பொருள் ஆக்கித் தன்னை என்னுள் வைத்தான்","inRu ennaip poruL Akkith thannai ennuL vaiththAn"],[3869,"உற்றேன் உகந்து பணி செய்து உன பாதம்","uRREn ugandhu paNi seydhu una pAdham"],[3870,"நில்லா அல்லல் நீள் வயல் சூழ் திருப்பேர் மேல்","nillA allal nIL vayal sUzh thiruppEr mEl"],[3871,"சூழ் விசும்பு அணி முகில் தூரியம் முழக்கின","sUzh visumbu aNi mugil thUriyam muzhakkina"],[3872,"நாரணன் தமரைக் கண்டு உகந்து நன்னீர் முகில்","nAraNan thamaraik kaNDu ugandhu nannIr mugil"],[3873,"தொழுதனர் உலகர்கள் தூப நல் மலர் மழை","thozhudhanar ulagargaL dhUpa nal malar mazhai"],[3874,"எதிர் எதிர் இமையவர் இருப்பிடம் வகுத்தனர்","edhir edhir imaiyavar iruppiDam vaguththanar"],[3875,"மாதவன் தமர் என்று வாசலில் வானவர்","mAdhavan thamar enRu vAsalil vAnavar"],[3876,"வேள்வி உள் மடுத்தலும் விரை கமழ் நறும் புகை","vELvi uL maDuththalum virai kamazh naRum pugai"],[3877,"மடந்தையர் வாழ்த்தலும் மருதரும் வசுக்களும்","maDandhaiyar vAzhththalum marudharum vasukkaLum"],[3878,"குடி அடியார் இவர் கோவிந்தன் தனக்கு என்று","kuDi aDiyAr ivar gOvindhan thanakku enRu"],[3879,"வைகுந்தம் புகுதலும் வாசலில் வானவர்","vaikundham puguthalum vAsalil vAnavar"],[3880,"விதி வகை புகுந்தனர் என்று நல் வேதியர்","vidhi vagai pugundhanar enRu nal vEdhiyar"],[3881,"வந்தவர் எதிர் கொள்ள மா மணி மண்டபத்து","vandhavar edhir koLLa mA maNi maNDapaththu"],[3882,"முனியே! நான்முகனே! முக்கண் அப்பா! என் பொல்லாக்","muniyE! nAnmuganE! mukkaN appA! en pollAk"],[3883,"மாயம் செய்யேல் என்னை உன் திருமார்வத்து மாலை நங்கை","mAyam seyyEl ennai un thirumArvaththu mAlai nanggai"],[3884,"கூவிக் கொள்ளாய் வந்து அந்தோ! என் பொல்லாக் கரு மாணிக்கமே!","kUvik koLLAy vandhu andhO! en pollAk karu mANikkamE!"],[3885,"உம்பர் அந்தண் பாழேயோ! அதனுள் மிசை நீயேயோ!","umbar anthaN pAzhEyO! adhanuL misai nIyEyO!"],[3886,"போர விட்டிட்டு என்னை நீ புறம் போக்கல் உற்றால் பின்னை யான்","pOra viTTiTTu ennai nI puRam pOkkal uRRAl pinnai yAn"],[3887,"எனக்கு ஆரா அமுதாய் எனது ஆவியை இன் உயிரை","enakku ArA amudhAy enadhu Aviyai in uyirai"],[3888,"கோல மலர்ப் பாவைக்கு அன்பாகிய என் அன்பேயோ!","kOla malarp pAvaikku anbAgiya en anbEyO!"],[3889,"பெற்று இனிப் போக்குவனோ? உன்னை என் தனிப் பேர் உயிரை","peRRu inip pOkkuvanO? unnai en thanip pEr uyirai"],[3890,"முதல் தனி வித்தேயோ! முழு மூவுலகு ஆதிக்கு எல்லாம்","mudhal thani viththEyO! muzhu mUvulagu Adhikku ellAm"],[3891,"சூழ்ந்தகன்று ஆழ்ந்து உயர்ந்த முடிவில் பெரும் பாழேயோ!","sUzhndhaganRu Azhndhu uyarndha muDivil perum pAzhEyO!"],[3892,"அவா அறச் சூழ் அரியை அயனை அரனை அலற்றி","avA aRach sUzh ariyai ayanai aranai alaRRi"],[3893,"பூ மன்னு மாது பொருந்திய மார்பன் புகழ் மலிந்த","pU mannu mAdhu porundhiya mArban pugazh malindha"],[3894,"கள்ளார் பொழில் தென்னரங்கன் கமலப் பதங்கள் நெஞ்சில்","kaLLAr pozhil thennarangkan kamalap padhangkaL nenjchil"],[3895,"பேர் இயல் நெஞ்சே அடி பணிந்தேன் உன்னை பேய்ப் பிறவிப்","per iyal nĕñce aṭi paṇinteṉ uṉṉai peyp piṟavip"],[3896,"என்னைப் புவியில் ஒரு பொருள் ஆக்கி மருள் சுரந்த","ennaip puviyil oru poruL Akki maruL surandha"],[3897,"எனக்குற்ற செல்வம் இராமானுசன் என்று இசைய கில்லா","enakkuRRa selvam irAmAnusan enRu isaiya killA"],[3898,"இயலும் பொருளும் இசையத் தொடுத்து ஈன் கவிகள் அன்பால்","iyalum poruLum isaiyath thoDuththu In kavigaL anbAl"],[3899,"மொழியைக் கடக்கும் பெரும் புகழான் வஞ்ச முக்குறும்பாம்","mozhiyaik kaDakkum perum pugazhAn vanjcha mukkuRumbAm"],[3900,"வருத்தும் புற இருள் மாற்ற எம் பொய்கைப் பிரான் மறையின்","varuththum puRa iruL mARRa em poygaip pirAn maRaiyin"],[3901,"இறைவனைக் காணும் இதயத்திருள் கெட ஞானம் என்னும்","iRaivanaik kANum idhayaththiruL keDa njAnam ennum"],[3902,"மன்னிய பேர் இருள் மாண்டபின் கோவலுள் மா மலராள்","maṉṉiya per irul̤ māṇṭapiṉ kovalul̤ mā malarāl̤"],[3903,"சீரிய நான்மறைச் செம்பொருள் செந்தமிழால் அளித்த","sIriya nAnmaRaich semporuL senthamizhAl aLiththa"],[3904,"இடங்கொண்ட கீர்த்தி மழிசைக்கிறைவன் இணை அடிப் போது","iDangkoNDa kIrththi mazhisaikkiRaivan iNai aDip pOdhu"],[3905,"செய்யும் பசுந்துளவத் தொழில் மாலையும் செந்தமிழில்","seyyum pasunthuLavath thozhil mAlaiyum senthamizhil"],[3906,"கதிக்குப் பதறி வெங்கானமும் கல்லும் கடலும் எல்லாம்","kadhikkup padhaRi vengkAnamum kallum kaDalum ellAm"],[3907,"சோராத காதல் பெரும் சுழிப்பால் தொல்லை மாலை ஒன்றும்","sOrAdha kAdhal perum suzhippAl thollai mAlai onRum"],[3908,"தாழ்வொன்றில்லா மறை தாழ்ந்து தல முழுதும் கலியே","thAzhvonRillA maRai thAzhndhu thala muzhudhum kaliyE"],[3909,"முனியார் துயரங்கள் முந்திலும் இன்பங்கள் மொய்த்திடினும்","muniyAr thuyarangkaL mundhilum inbangkaL moyththiDinum"],[3910,"எய்தற்கு அரிய மறைகளை ஆயிரம் இன் தமிழால்","eydhaRku ariya maRaigaLai Ayiram in thamizhAl"],[3911,"உறு பெரும் செல்வமும் தந்தையும் தாயும் உயர் குருவும்","uRu perum selvamum thandhaiyum thAyum uyar guruvum"],[3912,"ஆரப் பொழில் தென் குருகைப் பிரான் அமுதத் திருவாய்","Arap pozhil then kurugaip pirAn amudhath thiruvAy"],[3913,"நிதியைப் பொழியும் முகில் என்று நீசர் தம் வாசல் பற்றித்","nidhiyaip pozhiyum mugil enRu nIsar tham vAsal paRRith"],[3914,"கார்த்திகையானும் கரி முகத்தானும் கனலும் முக்கண்","kArththigaiyAnum kari mugaththAnum kanalum mukkaN"],[3915,"வைப்பாய வான் பொருள் என்று நல் அன்பர் மனத்தகத்தே","vaippAya vAn poruL enRu nal anbar manaththagaththE"],[3916,"மொய்த்த வெம் தீவினையால் பல் உடல்தொறும் மூத்து அதனால்","mŏytta vĕm tīviṉaiyāl pal uṭaltŏṟum mūttu ataṉāl"],[3917,"கார் ஏய் கருணை இராமானுச! இக்கடல் இடத்தில்","kAr Ey karuNai irAmAnusa! ikkaDal iDaththil"],[3918,"திக்குற்ற கீர்த்தி இராமானுசனை என் செய் வினையாம்","thikkuRRa kIrththi irAmAnusanai en sey vinaiyAm"],[3919,"கொள்ளக் குறைவற்று இலங்கி கொழுந்து விட்டோங்கிய உன்","koLLak kuRaivaRRu ilangki kozhundhu viTTOngkiya un"],[3920,"நெஞ்சில் கறை கொண்ட கஞ்சனைக் காய்ந்த நிமலன் நங்கள்","nenjchil kaRai koNDa kanjchanaik kAyndha nimalan nangkaL"],[3921,"கூட்டும் விதி என்று கூடும் கொலோ? தென் குருகைப் பிரான்","kUTTum vidhi enRu kUDum kolO? then kurugaip pirAn"],[3922,"இன்பம் தரு பெரு வீடு வந்து எய்தில் என்? எண் இறந்த","inbam tharu peru vIDu vandhu eydhil en? eN iRandha"],[3923,"ஆண்டுகள் நாள் திங்களாய் நிகழ் காலம் எல்லாம் மனமே!","ANDugaL nAL thingkaLAy nigazh kAlam ellAm manamE!"],[3924,"பொருந்திய தேசும் பொறையும் திறலும் புகழும் நல்ல","porundhiya thEsum poRaiyum thiRalum pugazhum nalla"],[3925,"அடையார் கமலத்து அலர் மகள் கேள்வன் கை ஆழி என்னும்","aDaiyAr kamalaththu alar magaL kELvan kai Azhi ennum"],[3926,"நிலத்தைச் செறுத்து உண்ணும் நீசக் கலியை நினைப்பரிய","nilaththaich seRuththu uNNum nIsak kaliyai ninaippariya"],[3927,"நயவேன் ஒரு தெய்வம் நானிலத்தே சில மானிடத்தைப்","nayavEn oru dheyvam nAnilaththE sila mAniDaththaip"],[3928,"அடல் கொண்ட நேமியன் ஆருயிர் நாதன் அன்று ஆரணச் சொல்","aDal koNDa nEmiyan Aruyir nAthan anRu AraNach sol"],[3929,"படி கொண்ட கீர்த்தி இராமாயணம் என்னும் பத்தி வெள்ளம்","paDi koNDa kIrththi irAmAyaNam ennum paththi veLLam"],[3930,"ஆக்கி அடிமை நிலைப் பித்தனை என்னை இன்று அவமே","Akki aDimai nilaip piththanai ennai inRu avamE"],[3931,"பொருளும் புதல்வரும் பூமியும் பூங்குழலாரும் என்றே","poruLum pudhalvarum bUmiyum pUngkuzhalArum enRE"],[3932,"சேம நல் வீடும் பொருளும் தருமமும் சீரிய நற்","sEma nal vIDum poruLum dharumamum sIriya naR"],[3933,"மண் மிசை யோனிகள் தோறும் பிறந்து எங்கள் மாதவனே","maN misai yOnigaL thORum piRandhu engkaL mAdhavanE"],[3934,"ஆயிழையார் கொங்கை தங்கும் அக்காதல் அளற்று அழுந்தி","AyizhaiyAr kongkai thangkum akkAdhal aLaRRu azhundhi"],[3935,"சுரக்கும் திருவும் உணர்வும் சொலப் புகில் வாய் அமுதம்","surakkum thiruvum uNarvum solap pugil vAy amudham"],[3936,"சொல் ஆர் தமிழ் ஒரு மூன்றும் சுருதிகள் நான்கும் எல்லை","sol Ar thamizh oru mUnRum surudhikaL nAnkum ellai"],[3937,"பேறொன்று மற்றில்லை நின் சரண் அன்றி அப்பேறு அளித்தற்கு","pERonRu maRRillai nin charaN anRi appERu aLiththaRku"],[3938,"கூறும் சமயங்கள் ஆறும் குலைய குவலயத்தே","kURum samayangkaL ARum kulaiya kuvalayaththE"],[3939,"இறைஞ்சப்படும் பரன் ஈசன் அரங்கன் என்று இவ்வுலகத்து","iRainjchappaDum paran Isan arangkan enRu ivvulagaththu"],[3940,"நிகர் இன்றி நின்ற என் நீசதைக்கு நின் அருளின் கண் அன்றிப்","nigar inRi ninRa en nIsadhaikku nin aruLin kaN anRip"],[3941,"ஆனது செம்மை அற நெறி பொய்ம்மை அறு சமயம்","Anadhu semmai aRa neRi poymmai aRu samayam"],[3942,"உதிப்பன உத்தமர் சிந்தையுள் ஒன்னலர் நெஞ்சம் அஞ்சிக்","udhippana uththamar sindhaiyuL onnalar nenjcham anjchik"],[3943,"அடியைத் தொடர்ந்து எழும் ஐவர்கட்காய் அன்று பாரதப் போர்","aDiyaith thoDarndhu ezhum aivargaTkAy anRu bArathap pOr"],[3944,"பார்த்தான் அறு சமயங்கள் பதைப்ப இப்பார் முழுதும்","pArththAn aRu samayangkaL padhaippa ippAr muzhudhum"],[3945,"அற்புதன் செம்மை இராமானுசன் என்னை ஆள வந்த","aRpudhan semmai irAmAnusan ennai ALa vandha"],[3946,"நாட்டிய நீசச் சமயங்கள் மாண்டன நாரணனைக்","nATTiya nIsach samayangkaL mANDana nAraNanaik"],[3947,"கண்டவர் சிந்தை கவரும் கடி பொழில் தென் அரங்கன்","kaṇṭavar cintai kavarum kaṭi pŏzhil tĕṉ araṅkaṉ"],[3948,"கோக்குல மன்னரை மூவெழு கால் ஒரு கூர் மழுவால்","kOkkula mannarai mUvezhu kAl oru kUr mazhuvAl"],[3949,"மற்றொரு பேறு மதியாது அரங்கன் மலர் அடிக்கு ஆள்","maRRoru pERu madhiyAdhu arangkan malar aDikku AL"],[3950,"பேதையர் வேதப் பொருள் இது என்று உன்னி பிரமம் நன்று என்று","petaiyar vetap pŏrul̤ itu ĕṉṟu uṉṉi piramam naṉṟu ĕṉṟu"],[3951,"கடல் அளவாய திசை எட்டின் உள்ளும் கலி இருளே","kaDal aLavAya thisai eTTin uLLum kali iruLE"],[3952,"உணர்ந்த மெய்ஞ்ஞானியர் யோகம்தொறும் திருவாய்மொழியின்","uṇarnta mĕyññāṉiyar yokamtŏṟum tiruvāymŏzhiyiṉ"],[3953,"கொழுந்து விட்டோடிப் படரும் வெங்கோள் வினையால் நிரயத்து","kozhundhu viTTODip paDarum vengkOL vinaiyAl nirayaththu"],[3954,"இருந்தேன் இரு வினைப் பாசம் கழற்றி இன்று யான் இறையும்","irundhEn iru vinaip pAsam kazhaRRi inRu yAn iRaiyum"],[3955,"பிடியைத் தொடரும் களிறென்ன யான் உன் பிறங்கிய சீர்","piDiyaith thoDarum kaLiRenna yAn un piRangkiya sIr"],[3956,"பண் தரு மாறன் பசுந்தமிழ் ஆனந்தம் பாய் மதமாய்","paN tharu mARan pasunthamizh Anandham pAy madhamAy"],[3957,"வாழ்வற்றது தொல்லை வாதியர்க்கு என்றும் மறையவர் தம்","vAzhvaRRadhu thollai vAdhiyarkku enRum maRaiyavar tham"],[3958,"ஞானம் கனிந்த நலம் கொண்டு நாள் தொறும் நைபவர்க்கு","njAnam kanindha nalam koNDu nAL thoRum naibavarkku"],[3959,"சரணம் அடைந்த தருமனுக்கா பண்டு நூற்றுவரை","saraNam aDaindha dharumanukkA paNDu nURRuvarai"],[3960,"ஆர் எனக்கு இன்று நிகர் சொல்லில்? மாயன் அன்று ஐவர் தெய்வத்","Ar enakku inRu nigar sollil? mAyan anRu aivar dheyvath"],[3961,"சிந்தையினோடு கரணங்கள் யாவும் சிதைந்து முன்னாள்","sindhaiyinODu karaNangkaL yAvum sidhaindhu munnAL"],[3962,"என்னையும் பார்த்து என் இயல்வையும் பார்த்து எண்ணில் பல் குணத்த","ennaiyum pArththu en iyalvaiyum pArththu eNNil pal guNaththa"],[3963,"சார்ந்தது என் சிந்தை உன் தாள் இணைக் கீழ் அன்பு தான் மிகவும்","sArnthadhu en sindhai un thAL iNaik kIzh anbu thAn migavum"],[3964,"கைத்தனன் தீய சமயக் கலகரைக் காசினிக்கே","kaiththanan thIya samayak kalagaraik kAsinikkE"],[3965,"வண்மையினாலும் தன் மா தகவாலும் மதி புரையும்","vaNmaiyinAlum than mA thagavAlum madhi puraiyum"],[3966,"தேரார் மறையின் திறம் என்று மாயவன் தீயவரைக்","thErAr maRaiyin thiRam enRu mAyavan thIyavaraik"],[3967,"செய்த் தலைச் சங்கம் செழு முத்தம் ஈனும் திருவரங்கர்","seyth thalaich sangkam sezhu muththam Inum thiruvarangkar"],[3968,"நின்ற வண் கீர்த்தியும் நீள் புனலும் நிறை வேங்கடப் பொற்","ninRa vaN kIrththiyum nIL punalum niRai vEngkaDap poR"],[3969,"ஈந்தனன் ஈயாத இன் அருள் எண்ணில் மறைக் குறும்பைப்","Indhanan IyAdha in aruL eNNil maRaik kuRumbaip"],[3970,"கருத்தில் புகுந்து உள்ளில் கள்ளம் கழற்றி கருதரிய","karuththil pugundhu uLLil kaLLam kazhaRRi karudhariya"],[3971,"பொய்யைச் சுரக்கும் பொருளைத் துரந்து இந்தப் பூதலத்தே","pŏyyaic curakkum pŏrul̤ait turantu intap pūtalatte"],[3972,"நல்லார் பரவும் இராமானுசன் திருநாமம் நம்ப","nallAr paravum irAmAnusan thirunAmam namba"],[3973,"சோர்வு இன்றி உன்தன் துணை அடிக் கீழ் தொண்டு பட்டவர் பால்","sOrvinRi undhan thuNai aDik kIzh thoNDu paTTavar pAl"],[3974,"தெரிவுற்ற ஞானம் செறியப் பெறாது வெந்தீ வினையால்","therivuRRa njAnam seRiyap peRAdhu venthI vinaiyAl"],[3975,"சீர் கொண்டு பேர் அறம் செய்து நல் வீடு செறிதும் என்னும்","sIr koNDu pEr aRam seydhu nal vIDu seRidhum ennum"],[3976,"கண்டு கொண்டேன் எம் இராமானுசன் தன்னை காண்டலுமே","kaNDu koNDEn em irAmAnusan thannai kANDalumE"],[3977,"ஓதிய வேதத்தின் உட்பொருளாய் அதன் உச்சி மிக்க","Odhiya vEdhaththin uTporuLAy adhan uchchi mikka"],[3978,"பற்றா மனிசரைப் பற்றி அப்பற்று விடாதவரே","paRRA manisaraip paRRi appaRRu viDAdhavarE"],[3979,"பெரியவர் பேசிலும் பேதையர் பேசிலும் தன் குணங்கட்கு","periyavar pEsilum pEdhaiyar pEsilum than guNangkaTku"],[3980,"கலி மிக்க செந்நெல் கழனிக் குறையல் கலைப் பெருமான்","kali mikka sennel kazhanik kuRaiyal kalaip perumAn"],[3981,"போற்றரும் சீலத்து இராமானுச! நின் புகழ் தெரிந்து","pORRarum sIlaththu irAmAnusa! nin pugazh therindhu"],[3982,"நினையார் பிறவியை நீக்கும் பிரானை இந்நீள் நிலத்தே","ninaiyAr piRaviyai nIkkum pirAnai innIL nilaththE"],[3983,"மருள் சுரந்து ஆகம வாதியர் கூறும் அவப் பொருளாம்","maruL surandhu Agama vAdhiyar kURum avap poruLAm"],[3984,"புண்ணிய நோன்பு புரிந்தும் இலேன் அடி போற்றி செய்யும்","puNNiya nOnbu purindhum ilEn aDi pORRi seyyum"],[3985,"கட்டப் பொருளை மறைப் பொருள் என்று கயவர் சொல்லும்","kaTTap poruLai maRaip poruL enRu kayavar sollum"],[3986,"தவம் தரும் செல்வம் தகவும் தரும் சலியாப் பிறவிப்","tavam tarum cĕlvam takavum tarum caliyāp piṟavip"],[3987,"உண்ணின்று உயிர்களுக்கு உற்றனவே செய்து அவர்க்கு உயவே","uNNinRu uyirgaLukku uRRanavE seydhu avarkku uyavE"],[3988,"வளரும் பிணி கொண்ட வல் வினையால் மிக்க நல் வினையில்","vaLarum piNi koNDa val vinaiyAl mikka nal vinaiyil"],[3989,"தன்னை உற்று ஆட்செய்யும் தன்மையினோர் மன்னு தாமரைத் தாள்","thannai uRRu ATcheyyum thanmaiyinOr mannu thAmaraith thAL"],[3990,"இடுமே இனிய சுவர்க்கத்தில்? இன்னும் நரகில் இட்டுச்","iṭume iṉiya cuvarkkattil? iṉṉum narakil iṭṭuc"],[3991,"தற்கச் சமணரும் சாக்கியப் பேய்களும் தாழ் சடையோன்","thaRkach chamaNarum sAkkiyap pEygaLum thAzh saDaiyOn"],[3992,"போந்தது என் நெஞ்சென்னும் பொன் வண்டு உனதடிப் போதில் ஒண் சீர்","pOndhadhu en nenjchennum pon vaNDu unadhaDip pOdhil oN sIr"],[3993,"மயக்கும் இரு வினை வல்லியில் பூண்டு மதி மயங்கித்","mayakkum iru vinai valliyil pUNDu madhi mayangkith"],[3994,"நையும் மனம் உன் குணங்களை உன்னி என் நா இருந்து எம்","naiyum manam un guNangkaLai unni en nA irundhu em"],[3995,"வளர்ந்த வெங்கோப மடங்கல் ஒன்றாய் அன்று வாள் அவுணன்","vaLarndha vengkOpa maDangkal onRAy anRu vAL avuNan"],[3996,"கையில் கனி என்னக் கண்ணனைக் காட்டித் தரிலும் உன்தன்","kaiyil kani ennak kaNNanaik kATTith tharilum undhan"],[3997,"செழுந்திரைப் பாற்கடல் கண் துயில் மாயன் திருவடிக் கீழ்","sezhunthiraip pARkaDal kaN thuyil mAyan thiruvaDik kIzh"],[3998,"இருப்பிடம் வைகுந்தம் வேங்கடம் மாலிருஞ்சோலை என்னும்","iruppiṭam vaikuntam veṅkaṭam māliruñcolai ĕṉṉum"],[3999,"இன்புற்ற சீலத்து இராமானுச! என்றும் எவ்விடத்தும்","inbuRRa sIlaththu irAmAnusa! enRum evviDaththum"],[4000,"அங்கயல் பாய் வயல் தென்னரங்கன் அணி ஆகம் மன்னும்","angkayal pAy vayal thennarangkan aNi Agam mannum"],[2673,"காரார் வரைக் கொங்கை கண்ணார் கடல் உடுக்கை","kArAr varaik konggai kaNNAr kaDal uDukkai","Siriya Thirumadal · kanni 1","/p/22-siriya-thirumadal/k1"],[2673,"பேர் ஆர மார்பின் பெரு மா மழைக் கூந்தல்","pEr Ara mArbin peru mA mazhaik kUndhal","Siriya Thirumadal · kanni 2","/p/22-siriya-thirumadal/k2"],[2673,"பாரோர் சொலப் பட்ட மூன்றன்றே அம்மூன்றும்","pArOr solap paTTa mUnRanRE ammUnRum","Siriya Thirumadal · kanni 3","/p/22-siriya-thirumadal/k3"],[2673,"ஆரார் இவற்றின் இடை அதனை எய்துவார்","ArAr ivaRRin iDai adhanai eydhuvAr","Siriya Thirumadal · kanni 4","/p/22-siriya-thirumadal/k4"],[2673,"ஆரானும் உண்டென்பார் என்பது தான் அதுவும்","ArAnum uNDenbAr enbadhu thAn adhuvum","Siriya Thirumadal · kanni 5","/p/22-siriya-thirumadal/k5"],[2673,"ஒராமை ஆமாறு அது உரைக்கேன் கேள் ஆமே","orAmai AmARu adhu uraikkEn kEL AmE","Siriya Thirumadal · kanni 6","/p/22-siriya-thirumadal/k6"],[2673,"தேரார் நிறை கதிரோன் மண்டலத்தைக் கீண்டு புக்கு","thErAr niRai kadhirOn maNDalaththaik kINDu pukku","Siriya Thirumadal · kanni 7","/p/22-siriya-thirumadal/k7"],[2673,"வாராது ஒழிவது ஒன்றுண்டே? அது நிற்க","vArAdhu ozhivadhu onRuNDE? adhu niRka","Siriya Thirumadal · kanni 8","/p/22-siriya-thirumadal/k8"],[2673,"ஏரார் இள முலையீர் என் தனக்கு உற்றது தான்","ErAr iLa mulaiyIr en thanakku uRRadhu thAn","Siriya Thirumadal · kanni 9","/p/22-siriya-thirumadal/k9"],[2673,"வாரார வீக்கி மணி மேகலை திருத்தி","vArAra vIkki maNi mEgalai thiruththi","Siriya Thirumadal · kanni 10","/p/22-siriya-thirumadal/k10"],[2673,"சீரார் செழும் பந்து கொண்டடியா நின்றேன் நான்","sIrAr sezhum pandhu koNDaDiyA ninREn nAn","Siriya Thirumadal · kanni 11","/p/22-siriya-thirumadal/k11"],[2673,"பாரோர்கள் எல்லாம் மகிழப் பறை கறங்க","pArOrgaL ellAm magizhap paRai kaRangga","Siriya Thirumadal · kanni 12","/p/22-siriya-thirumadal/k12"],[2673,"ஆரார் எனச் சொல்லி ஆடும் அது கண்டு","ArAr enach solli ADum adhu kaNDu","Siriya Thirumadal · kanni 13","/p/22-siriya-thirumadal/k13"],[2673,"வாராயோ என்றார்க்குச் சென்றேன் என் வல்வினையால்","vArAyO enRArkkuch senREn en valvinaiyAl","Siriya Thirumadal · kanni 14","/p/22-siriya-thirumadal/k14"],[2673,"ஆரானும் சொல்லிற்றும் கொள்ளேன் அறிவழிந்து","ArAnum solliRRum koLLEn aRivazhindhu","Siriya Thirumadal · kanni 15","/p/22-siriya-thirumadal/k15"],[2673,"ஏரார் கிளிக் கிளவி எம் அனை தான் வந்து என்னை","ErAr kiLik kiLavi em anai thAn vandhu ennai","Siriya Thirumadal · kanni 16","/p/22-siriya-thirumadal/k16"],[2673,"தாரார் நறு மாலை சாத்தற்கு தான் பின்னும்","thArAr naRu mAlai sAththaRku thAn pinnum","Siriya Thirumadal · kanni 17","/p/22-siriya-thirumadal/k17"],[2673,"தீராது என் சிந்தை நோய் தீராது என் பேதுறவு","thIrAdhu en sindhai nOy thIrAdhu en pEdhuRavu","Siriya Thirumadal · kanni 18","/p/22-siriya-thirumadal/k18"],[2673,"ஆரானும் மூதறியும் அம்மனைமார் சொல்லுவார்","ArAnum mUdhaRiyum ammanaimAr solluvAr","Siriya Thirumadal · kanni 19","/p/22-siriya-thirumadal/k19"],[2673,"ஆரானும் மெய்ப்படுவன் என்றார் அது கேட்டுக்","ArAnum meyppaDuvan enRAr adhu kETTuk","Siriya Thirumadal · kanni 20","/p/22-siriya-thirumadal/k20"],[2673,"சீரார் சுளகில் சில நெல் பிடித்து எறியா","sIrAr suLagil sila nel piDiththu eRiyA","Siriya Thirumadal · kanni 21","/p/22-siriya-thirumadal/k21"],[2673,"பேர் ஆயிரம் உடையான் என்றாள் பேர்த்தேயும்","pEr Ayiram uDaiyAn enRAL pErththEyum","Siriya Thirumadal · kanni 22","/p/22-siriya-thirumadal/k22"],[2673,"சீரார் வலம்புரியே என்றாள் திருத்துழாய்த்","sIr Ar valampuriyE enRAL thiruththuzhAyth","Siriya Thirumadal · kanni 23","/p/22-siriya-thirumadal/k23"],[2673,"நீர் ஏதும் அஞ்சேன்மின் நும் மகளை நோய் செய்தான்","nIr Edhum anjchEnmin num magaLai nOy seydhAn","Siriya Thirumadal · kanni 24","/p/22-siriya-thirumadal/k24"],[2673,"கூரார் வேற்கண்ணீர்! உமக்கறியக் கூறுகேனோ?","kUrAr vERkaNNIr! umakkaRiyak kURugEnO?","Siriya Thirumadal · kanni 25","/p/22-siriya-thirumadal/k25"],[2673,"ஆரால் இலங்கை பொடி பொடியா வீழ்ந்தது? மற்று","ArAl ilanggai poDi poDiyA vIzhndhadhu? maRRu","Siriya Thirumadal · kanni 26","/p/22-siriya-thirumadal/k26"],[2673,"ஆரால் கடைந்திடப்பட்டது? அவன் காண்மின்","ArAl kaDainthiDappaTTadhu? avan kANmin","Siriya Thirumadal · kanni 27","/p/22-siriya-thirumadal/k27"],[2673,"ஆராத தன்மையனாய் ஆங்கொரு நாள் ஆய்ப்பாடி","ArAdha thanmaiyanAy Anggoru nAL AyppADi","Siriya Thirumadal · kanni 28","/p/22-siriya-thirumadal/k28"],[2673,"வாரார் வன முலையாள் மத்தாரப் பற்றிக் கொண்டு","vArAr vana mulaiyAL maththArap paRRik koNDu","Siriya Thirumadal · kanni 29","/p/22-siriya-thirumadal/k29"],[2673,"சீரார் தயிர் கடைந்து வெண்ணை திரண்டதணை","sIrAr thayir kaDaindhu veNNai thiraNDadhaNai","Siriya Thirumadal · kanni 30","/p/22-siriya-thirumadal/k30"],[2673,"நாரார் உறி ஏற்றி நன்கமைய வைத்ததனை","nArAr uRi ERRi nankamaiya vaiththadhanai","Siriya Thirumadal · kanni 31","/p/22-siriya-thirumadal/k31"],[2673,"ஓராதவன் போல் உறங்கி அறிவுற்று","OrAdhavan pOl uRanggi aRivuRRu","Siriya Thirumadal · kanni 32","/p/22-siriya-thirumadal/k32"],[2673,"ஆராத வெண்ணெய் விழுங்கி அருகிருந்த","ArAdha veNNey vizhunggi arugirundha","Siriya Thirumadal · kanni 33","/p/22-siriya-thirumadal/k33"],[2673,"ஓராதவன் போல் கிடந்தானைக் கண்டவளும்","OrAdhavan pOl kiDandhAnaik kaNDavaLum","Siriya Thirumadal · kanni 34","/p/22-siriya-thirumadal/k34"],[2673,"ஆரார் புகுதுவார்? ஐயர் இவர் அல்லால்","ArAr pugudhuvAr? aiyar ivar allAl","Siriya Thirumadal · kanni 35","/p/22-siriya-thirumadal/k35"],[2673,"ஊரார்கள் எல்லாரும் காண உரலோடே","UrArgaL ellArum kANa uralODE","Siriya Thirumadal · kanni 36","/p/22-siriya-thirumadal/k36"],[2673,"ஆரா வயிற்றினோடு ஆற்றாதான் அன்றியும்","ArA vayiRRinODu ARRAdhAn anRiyum","Siriya Thirumadal · kanni 37","/p/22-siriya-thirumadal/k37"],[2673,"ஒராயிரம் பண வெங்கோவியல் நாகத்தை","orAyiram paNa vengkOviyal nAgaththai","Siriya Thirumadal · kanni 38","/p/22-siriya-thirumadal/k38"],[2673,"சீரார் திருவடியால் பாய்ந்தான் தன் சீதைக்கு","sIrAr thiruvaDiyAl pAyndhAn than sIthaikku","Siriya Thirumadal · kanni 39","/p/22-siriya-thirumadal/k39"],[2673,"கூரார்ந்த வாளால் கொடி மூக்கும் காதிரண்டும்","kUrArndha vALAl koDi mUkkum kAdhiraNDum","Siriya Thirumadal · kanni 40","/p/22-siriya-thirumadal/k40"],[2673,"சேரா வகையே சிலை குனித்தான் செந்துவர் வாய்","sErA vagaiyE silai kuniththAn senthuvar vAy","Siriya Thirumadal · kanni 41","/p/22-siriya-thirumadal/k41"],[2673,"எரார் தடந்தோள் இராவணனை ஈரைந்து","erAr thaDanthOL irAvaNanai Iraindhu","Siriya Thirumadal · kanni 42","/p/22-siriya-thirumadal/k42"],[2673,"போரார் நெடு வேலோன் பொன் பெயரோன் ஆகத்தை","pOrAr neDu vElOn pon peyarOn Agaththai","Siriya Thirumadal · kanni 43","/p/22-siriya-thirumadal/k43"],[2673,"சீரார் திரு மார்பின் மேல் கட்டி செங்குருதி","sIrAr thiru mArbin mEl kaTTi sengkurudhi","Siriya Thirumadal · kanni 44","/p/22-siriya-thirumadal/k44"],[2673,"ஆரா எழுந்தான் அரி உருவாய் அன்றியும்","ArA ezhundhAn ari uruvAy anRiyum","Siriya Thirumadal · kanni 45","/p/22-siriya-thirumadal/k45"],[2673,"தாராய் எனக்கு என்று வேண்டிச் சலத்தினால்","thArAy enakku enRu vENDich salaththinAl","Siriya Thirumadal · kanni 46","/p/22-siriya-thirumadal/k46"],[2673,"ஆராத போரில் அசுரர்களும் தானுமாய்","ArAdha pOril asurargaLum thAnumAy","Siriya Thirumadal · kanni 47","/p/22-siriya-thirumadal/k47"],[2673,"பேராமல் தாங்கிக் கடைந்தான் திருத்துழாய்த்","pErAmal thAnggik kaDaindhAn thiruththuzhAyth","Siriya Thirumadal · kanni 48","/p/22-siriya-thirumadal/k48"],[2673,"போர் ஆனை பொய்கை வாய் கோட்பட்டு நின்று அலறி","pOr Anai poygai vAy kOTpaTTu ninRu alaRi","Siriya Thirumadal · kanni 49","/p/22-siriya-thirumadal/k49"],[2673,"நாராயணா! ஓ! மணிவண்ணா! நாகணையாய்!","nArAyaNA! O! maNivaNNA! nAgaNaiyAy!","Siriya Thirumadal · kanni 50","/p/22-siriya-thirumadal/k50"],[2673,"தீராத சீற்றத்தால் சென்று இரண்டு கூறாக","thIrAdha sIRRaththAl senRu iraNDu kURAga","Siriya Thirumadal · kanni 51","/p/22-siriya-thirumadal/k51"],[2673,"பேர் ஆயிரம் உடையான் பேய்ப் பெண்டீர்! நும் மகளை","pEr Ayiram uDaiyAn pEyp peNDIr! num magaLai","Siriya Thirumadal · kanni 52","/p/22-siriya-thirumadal/k52"],[2673,"ஆரானும் அல்லாமை கேட்டு எங்கள் அம்மனையும்","ArAnum allAmai kETTu enggaL ammanaiyum","Siriya Thirumadal · kanni 53","/p/22-siriya-thirumadal/k53"],[2673,"தாராது ஒழியுமே? தன் அடிச்சி அல்லளே? மற்று","thArAdhu ozhiyumE? than aDichchi allaLE? maRRu","Siriya Thirumadal · kanni 54","/p/22-siriya-thirumadal/k54"],[2673,"காரார் திருமேனி கண்டதுவே காரணமா","kArAr thirumEni kaNDadhuvE kAraNamA","Siriya Thirumadal · kanni 55","/p/22-siriya-thirumadal/k55"],[2673,"ஈராப் புகுதலும் இவ்வுடலைத் தண் வாடை","IrAp pugudhalum ivvuDalaith thaN vADai","Siriya Thirumadal · kanni 56","/p/22-siriya-thirumadal/k56"],[2673,"ஆரானும் ஏசுவர் என்னுமதன் பழியை","ArAnum Esuvar ennumadhan pazhiyai","Siriya Thirumadal · kanni 57","/p/22-siriya-thirumadal/k57"],[2673,"வாராய் மட நெஞ்சே! வந்து மணிவண்ணன்","vArAy maDa nenjchE! vandhu maNivaNNan","Siriya Thirumadal · kanni 58","/p/22-siriya-thirumadal/k58"],[2673,"தாரான் தரும் என்று இரண்டத்தில் ஒன்றதனை","thArAn tharum enRu iraNDaththil onRadhanai","Siriya Thirumadal · kanni 59","/p/22-siriya-thirumadal/k59"],[2673,"ஆராயுமேலும் பணி கேட்டு அதன்றெனிலும்","ArAyumElum paNi kETTu adhanRenilum","Siriya Thirumadal · kanni 60","/p/22-siriya-thirumadal/k60"],[2673,"கார் ஆர் கடல்வண்ணன் பின் போன நெஞ்சமும்","kAr Ar kaDalvaNNan pin pOna nenjchamum","Siriya Thirumadal · kanni 61","/p/22-siriya-thirumadal/k61"],[2673,"ஊரார் உகப்பதே ஆயினேன் மற்றெனக்கு இங்கு","UrAr ugappadhE AyinEn maRRenakku inggu","Siriya Thirumadal · kanni 62","/p/22-siriya-thirumadal/k62"],[2673,"நீராய் உருகும் என் ஆவி நெடுங்கண்கள்","nIrAy urugum en Avi neDungkaNgaL","Siriya Thirumadal · kanni 63","/p/22-siriya-thirumadal/k63"],[2673,"பேர் ஆயினவே பிதற்றுவன் பின்னையும்","pEr AyinavE pidhaRRuvan pinnaiyum","Siriya Thirumadal · kanni 64","/p/22-siriya-thirumadal/k64"],[2673,"ஆரே பொல்லாமை அறிவார்? அது நிற்க","ArE pollAmai aRivAr? adhu niRka","Siriya Thirumadal · kanni 65","/p/22-siriya-thirumadal/k65"],[2673,"வாரார் வனமுலை வாசவதத்தை என்று","vArAr vanamulai vAsavadhaththai enRu","Siriya Thirumadal · kanni 66","/p/22-siriya-thirumadal/k66"],[2673,"பேர் ஆயம் எல்லாம் ஒழியப் பெருந்தெருவே","pEr Ayam ellAm ozhiyap peruntheruvE","Siriya Thirumadal · kanni 67","/p/22-siriya-thirumadal/k67"],[2673,"ஊரார் இகழ்ந்திடப்பட்டாளே? மற்றெனக்கு இங்கு","UrAr igazhndhiDappaTTALE? maRRenakku inggu","Siriya Thirumadal · kanni 68","/p/22-siriya-thirumadal/k68"],[2673,"காரார் திருமேனி காணும் அளவும் போய்","kArAr thirumEni kANum aLavum pOy","Siriya Thirumadal · kanni 69","/p/22-siriya-thirumadal/k69"],[2673,"லூரே மதிட்கச்சி ஊரகமே பேரகமே","lUrE madhiTkachchi UragamE pEragamE","Siriya Thirumadal · kanni 70","/p/22-siriya-thirumadal/k70"],[2673,"பேர் ஆலி தண்கால் நறையூர் திருப்புலியூர்","pEr Ali thaNkAl naRaiyUr thiruppuliyUr","Siriya Thirumadal · kanni 71","/p/22-siriya-thirumadal/k71"],[2673,"காரார் மணி நிறக் கண்ணனூர் விண்ணகரம்","kArAr maNi niRak kaNNanUr viNNagaram","Siriya Thirumadal · kanni 72","/p/22-siriya-thirumadal/k72"],[2673,"காரார் குடந்தை கடிகை கடல் மல்லை","kArAr kuDandhai kaDigai kaDal mallai","Siriya Thirumadal · kanni 73","/p/22-siriya-thirumadal/k73"],[2673,"சீராரும் மாலிருஞ்சோலை திருமோகூர்","sIrArum mAlirunjchOlai thirumOgUr","Siriya Thirumadal · kanni 74","/p/22-siriya-thirumadal/k74"],[2673,"ஊராய எல்லாம் ஒழியாமே நான் அவனை","UrAya ellAm ozhiyAmE nAn avanai","Siriya Thirumadal · kanni 75","/p/22-siriya-thirumadal/k75"],[2673,"சீரானை செங்கண் நெடியானைத் தேன் துழாய்த்","sIrAnai sengkaN neDiyAnaith thEn thuzhAyth","Siriya Thirumadal · kanni 76","/p/22-siriya-thirumadal/k76"],[2673,"பேர் ஆயிரமும் பிதற்றி பெருந்தெருவே","pEr Ayiramum pidhaRRi peruntheruvE","Siriya Thirumadal · kanni 77","/p/22-siriya-thirumadal/k77"],[2673,"வாரார் பூம் பெண்ணை மடல்","vArAr pUm peNNai maDal","Siriya Thirumadal · kanni 77½","/p/22-siriya-thirumadal/k77½"],[2673,"காரார் வரைக் கொங்கை கண்ணார் கடல் உடுக்கை","kArAr varaik konggai kaNNAr kaDal uDukkai","Siriya Thirumadal · 2673","/n/2673"],[2674,"அம்மூன்றும் ஆராயில் தானே அறம் பொருள் இன்பம் என்று","ammUnRum ArAyil thAnE aRam poruL inbam enRu","Siriya Thirumadal · 2674","/n/2674"],[2675,"சிக்கென மற்று","sikkena maRRu","Siriya Thirumadal · 2675","/n/2675"],[2676,"அதில் நின்றும்","adhil ninRum","Siriya Thirumadal · 2676","/n/2676"],[2677,"காரார் குழல் எடுத்துக் கட்டி கதிர் முலையை","kArAr kuzhal eDuththuk kaTTi kadhir mulaiyai","Siriya Thirumadal · 2677","/n/2677"],[2678,"செழுந்தெருவே","sezhuntheruvE","Siriya Thirumadal · 2678","/n/2678"],[2679,"அறிவழிந்து தீரா உடம்பொடு பேதுறுவேன் கண்டு இரங்கி","aRivazhindhu thIrA uDamboDu pEdhuRuvEn kaNDu iranggi","Siriya Thirumadal · 2679","/n/2679"],[2680,"செங்குறிஞ்சித்","sengkuRinjchith","Siriya Thirumadal · 2680","/n/2680"],[2681,"அதனாலும் தீராது என் சிந்தை நோய் தீராது என் பேதுறவு","adhanAlum thIrAdhu en sindhai nOy thIrAdhu en pEdhuRavu","Siriya Thirumadal · 2681","/n/2681"],[2682,"அது கேட்டுக் காரார் குழற் கொண்டைக் கட்டுவிச்சி கட்டேறி","adhu kETTuk kArAr kuzhaR koNDaik kaTTuvichchi kaTTERi","Siriya Thirumadal · 2682","/n/2682"],[2683,"பேர்த்தேயும்","pErththEyum","Siriya Thirumadal · 2683","/n/2683"],[2684,"திருத்துழாய்த்","sIr Ar valampuriyE enRAL thiruththuzhAyth","Siriya Thirumadal · 2684","/n/2684"],[2685,"ஆழி நீர் ஆரால் கடைந்திடப்பட்டது? அவன் காண்மின்","Azhi nIr ArAl kaDainthiDappaTTadhu? avan kANmin","Siriya Thirumadal · 2685","/n/2685"],[2686,"அருகிருந்த மோரார் குடம் உருட்டி முன் கிடந்த தானத்தே","arugirundha mOrAr kuDam uruTTi mun kiDandha thAnaththE","Siriya Thirumadal · 2686","/n/2686"],[2687,"வயிறடித்து இங்கு","vayiRaDiththu inggu","Siriya Thirumadal · 2687","/n/2687"],[2688,"அன்றியும் நீரார் நெடுங்கயத்தை சென்று அலைக்க நின்று உரப்பி","anRiyum nIrAr neDungkayaththai senRu alaikka ninRu urappi","Siriya Thirumadal · 2688","/n/2688"],[2689,"தன் சீதைக்கு நேர் ஆவன் என்றோர் நிசாசரி தான் வந்தாளை","than sIthaikku nEr Avan enROr nisAsari thAn vandhALai","Siriya Thirumadal · 2689","/n/2689"],[2690,"வெந்நரகம் சேரா வகையே சிலை குனித்தான் செந்துவர் வாய்","vennaragam sErA vagaiyE silai kuniththAn senthuvar vAy","Siriya Thirumadal · 2690","/n/2690"],[2691,"ஈரைந்து சீரார் சிரம் அறுத்துச் செற்றுகந்த செங்கண் மால்","Iraindhu sIrAr siram aRuththuch seRRugandha sengkaN mAl","Siriya Thirumadal · 2691","/n/2691"],[2692,"குடல் மாலை சீரார் திரு மார்பின் மேல் கட்டி செங்குருதி","kuDal mAlai sIrAr thiru mArbin mEl kaTTi sengkurudhi","Siriya Thirumadal · 2692","/n/2692"],[2693,"அன்றியும் பேர் வாமன் ஆகிய காலத்து மூவடி மண்","anRiyum pEr vAman Agiya kAlaththu mUvaDi maN","Siriya Thirumadal · 2693","/n/2693"],[2694,"ஆராத போரில் அசுரர்களும் தானுமாய்","ArAdha pOril asurargaLum thAnumAy","Siriya Thirumadal · 2694","/n/2694"],[2695,"திருத்துழாய்த்","thiruththuzhAyth","Siriya Thirumadal · 2695","/n/2695"],[2696,"ஆரானும் அல்லாமை கேட்டு எங்கள் அம்மனையும்","ArAnum allAmai kETTu enggaL ammanaiyum","Siriya Thirumadal · 2696","/n/2696"],[2697,"நான் அவனைக் காரார் திருமேனி கண்டதுவே காரணமா","nAn avanaik kArAr thirumEni kaNDadhuvE kAraNamA","Siriya Thirumadal · 2697","/n/2697"],[2698,"ஈராப் புகுதலும் இவ்வுடலைத் தண் வாடை","IrAp pugudhalum ivvuDalaith thaN vADai","Siriya Thirumadal · 2698","/n/2698"],[2699,"ஆரானும் ஏசுவர் என்னுமதன் பழியை","ArAnum Esuvar ennumadhan pazhiyai","Siriya Thirumadal · 2699","/n/2699"],[2700,"சீரார் திருத்துழாய் மாலை நமக்கருளி","sIrAr thiruththuzhAy mAlai namakkaruLi","Siriya Thirumadal · 2700","/n/2700"],[2701,"ஊரார் உகப்பதே ஆயினேன் மற்றெனக்கு இங்கு","UrAr ugappadhE AyinEn maRRenakku inggu","Siriya Thirumadal · 2701","/n/2701"],[2702,"ஊரார் உறங்கிலும் தான் உறங்கா உத்தமன் தன்","UrAr uRanggilum thAn uRanggA uththaman than","Siriya Thirumadal · 2702","/n/2702"],[2703,"காரார் கடல் போலும் காமத்தர் ஆயினார்","kArAr kaDal pOlum kAmaththar AyinAr","Siriya Thirumadal · 2703","/n/2703"],[2704,"ஆரானும் ஆதானும் அல்லள் அவள் காணீர்","ArAnum AdhAnum allaL avaL kANIr","Siriya Thirumadal · 2704","/n/2704"],[2705,"பேர் ஆயம் எல்லாம் ஒழியப் பெருந்தெருவே","pEr Ayam ellAm ozhiyap peruntheruvE","Siriya Thirumadal · 2705","/n/2705"],[2706,"காரார் திருமேனி காணும் அளவும் போய்","kArAr thirumEni kANum aLavum pOy","Siriya Thirumadal · 2706","/n/2706"],[2707,"காரார் மணி நிறக் கண்ணனூர் விண்ணகரம்","kArAr maNi niRak kaNNanUr viNNagaram","Siriya Thirumadal · 2707","/n/2707"],[2708,"பாரோர் புகழும் வதரி வட மதுரை","pArOr pugazhum vadhari vaDa madhurai","Siriya Thirumadal · 2708","/n/2708"],[2709,"ஊராய எல்லாம் ஒழியாமே நான் அவனை","UrAya ellAm ozhiyAmE nAn avanai","Siriya Thirumadal · 2709","/n/2709"],[2710,"எண்ணரும் சீர்","eNNarum sIr","Siriya Thirumadal · 2710","/n/2710"],[2711,"ஊரார் இகழிலும் ஊராது ஒழியேன் நான்","UrAr igazhilum UrAdhu ozhiyEn nAn","Siriya Thirumadal · 2711","/n/2711"],[2712,"வாரார் பூம் பெண்ணை மடல்","vArAr pUm peNNai maDal","Siriya Thirumadal · 2712","/n/2712"],[2713,"மன்னிய பல் பொறி சேர் ஆயிர வாய் வாள் அரவின்","manniya pal poRi sEr Ayira vAy vAL aravin","Periya Thirumadal · kanni 1","/p/23-periya-thirumadal/k1"],[2713,"மன்னிய நாகத்தணை மேல் ஓர் மாமலை போல்","manniya nAgaththaNai mEl Or mAmalai pOl","Periya Thirumadal · kanni 2","/p/23-periya-thirumadal/k2"],[2713,"துன்னிய தாரகையின் பேரொளி சேர் ஆகாசம்","thunniya thAragaiyin pEroLi sEr AgAsam","Periya Thirumadal · kanni 3","/p/23-periya-thirumadal/k3"],[2713,"மன்னும் விளக்காக ஏற்றி மறி கடலும்","mannum viLakkAga ERRi maRi kaDalum","Periya Thirumadal · kanni 4","/p/23-periya-thirumadal/k4"],[2713,"தன்னை முன நாள் அளவிட்ட தாமரை போல்","thannai muna nAL aLaviTTa thAmarai pOl","Periya Thirumadal · kanni 5","/p/23-periya-thirumadal/k5"],[2713,"என்னும் மலர்ப் பிணையல் ஏய்ந்த மழைக் கூந்தல்","ennum malarp piNaiyal Eyndha mazhaik kUndhal","Periya Thirumadal · kanni 6","/p/23-periya-thirumadal/k6"],[2713,"என்னும் இவையே முலையா வடிவமைந்த","ennum ivaiyE mulaiyA vaDivamaindha","Periya Thirumadal · kanni 7","/p/23-periya-thirumadal/k7"],[2713,"தன்னுடைய அங்கைகளால் தான் தடவத் தான் கிடந்து ஓர்","thannuDaiya angkaigaLAl thAn thaDavath thAn kiDandhu Or","Periya Thirumadal · kanni 8","/p/23-periya-thirumadal/k8"],[2713,"பின்னை தன் நாபி வலயத்துப் பேரொளி சேர்","pinnai than nAbi valayaththup pEroLi sEr","Periya Thirumadal · kanni 9","/p/23-periya-thirumadal/k9"],[2713,"முன்னம் திசை முகனைத் தான் படைக்க மற்றவனும்","munnam thisai muganaith thAn paDaikka maRRavanum","Periya Thirumadal · kanni 10","/p/23-periya-thirumadal/k10"],[2713,"மன்னும் அறம் பொருள் இன்பம் வீடு என்று உலகில்","mannum aRam poruL inbam vIDu enRu ulagil","Periya Thirumadal · kanni 11","/p/23-periya-thirumadal/k11"],[2713,"பின்னையது பின்னைப் பெயர் தரும் என்பதோர்","pinnaiyadhu pinnaip peyar tharum enbadhu Or","Periya Thirumadal · kanni 12","/p/23-periya-thirumadal/k12"],[2713,"என்னும் இவையே நுகர்ந்துடலம் தாம் வருந்தி","ennum ivaiyE nugarndhuDalam thAm varundhi","Periya Thirumadal · kanni 13","/p/23-periya-thirumadal/k13"],[2713,"மன்னும் அழல் நுகர்ந்தும் வண்தடத்தின் உட்கிடந்தும்","mannum azhal nugarndhum vaNthaDaththin uTkiDandhum","Periya Thirumadal · kanni 14","/p/23-periya-thirumadal/k14"],[2713,"தொன்னெறிக்கண் சென்றார் எனப்படும் சொல் அல்லால்","thonneRikkaN senRAr enappaDum sol allAl","Periya Thirumadal · kanni 15","/p/23-periya-thirumadal/k15"],[2713,"என்னவும் கேட்டு அறிவதில்லை உளதென்னில்","ennavum kETTu aRivadhillai uLadhennil","Periya Thirumadal · kanni 16","/p/23-periya-thirumadal/k16"],[2713,"அன்னதோர் இல்லியின் ஊடு போய் வீடென்னும்","annadhOr illiyin UDu pOy vIDennum","Periya Thirumadal · kanni 17","/p/23-periya-thirumadal/k17"],[2713,"அன்னதே பேசும் அறிவில் சிறு மனத்து ஆங்கு","annadhE pEsum aRivil siRu manaththu Anggu","Periya Thirumadal · kanni 18","/p/23-periya-thirumadal/k18"],[2713,"முன்ன நான் சொன்ன அறத்தின் வழி முயன்ற","munna nAn sonna aRaththin vazhi muyanRa","Periya Thirumadal · kanni 19","/p/23-periya-thirumadal/k19"],[2713,"பொன்னகரம் புக்கு அமரர் போற்றி செப்ப பொங்கொளி சேர்","ponnagaram pukku amarar pORRi seppa ponggoLi sEr","Periya Thirumadal · kanni 20","/p/23-periya-thirumadal/k20"],[2713,"மன்னிய சிங்காசனத்தின் மேல் வாள் நெடுங்கண்","manniya singgAsanaththin mEl vAL neDungkaN","Periya Thirumadal · kanni 21","/p/23-periya-thirumadal/k21"],[2713,"இன்னிளம் பூந்தென்றல் இயங்க மருங்கிருந்த","inniLam pUnthenRal iyangga marunggirundha","Periya Thirumadal · kanni 22","/p/23-periya-thirumadal/k22"],[2713,"முன்னம் முகிழ்த்த முகிழ் நிலா வந்தரும்ப","munnam mugizhththa mugizh nilA vandharumba","Periya Thirumadal · kanni 23","/p/23-periya-thirumadal/k23"],[2713,"பொன் இயல் கற்பகத்தின் காடுடுத்த மாடெல்லாம்","pon iyal kaRpagaththin kADuDuththa mADellAm","Periya Thirumadal · kanni 24","/p/23-periya-thirumadal/k24"],[2713,"இன்னிசை வண்டமரும் சோலை வாய் மாலை சேர்","innisai vaNDamarum sOlai vAy mAlai sEr","Periya Thirumadal · kanni 25","/p/23-periya-thirumadal/k25"],[2713,"மின் இடையாரோடும் விளையாடி வேண்டிடத்து","min iDaiyArODum viLaiyADi vENDiDaththu","Periya Thirumadal · kanni 26","/p/23-periya-thirumadal/k26"],[2713,"மின்னின் ஒளி சேர் பளிங்கு விளிம்படுத்த","minnin oLi sEr paLinggu viLimbaDuththa","Periya Thirumadal · kanni 27","/p/23-periya-thirumadal/k27"],[2713,"அன்ன நடைய அரம்பையர் தம் கை வளர்த்த","anna naDaiya arambaiyar tham kai vaLarththa","Periya Thirumadal · kanni 28","/p/23-periya-thirumadal/k28"],[2713,"மன்னு மழை தவழும் வாணிலா நீள் மதி தோய்","mannu mazhai thavazhum vANilA nIL madhi thOy","Periya Thirumadal · kanni 29","/p/23-periya-thirumadal/k29"],[2713,"மன்னு மணி விளக்கை மாட்டி மழைக் கண்ணார்","mannu maNi viLakkai mATTi mazhaik kaNNAr","Periya Thirumadal · kanni 30","/p/23-periya-thirumadal/k30"],[2713,"துன்னிய சாலேகம் சூழ் கதவம் தாள் திறப்ப","thunniya sAlEgam sUzh kadhavam thAL thiRappa","Periya Thirumadal · kanni 31","/p/23-periya-thirumadal/k31"],[2713,"சின்ன நறுந்தாது சூடி ஓர் மந்தாரம்","chinna naRunthAdhu sUDi Or mandhAram","Periya Thirumadal · kanni 32","/p/23-periya-thirumadal/k32"],[2713,"மன்னு மலர் வாய் மணி வண்டு பின் தொடர","mannu malar vAy maNi vaNDu pin thoDara","Periya Thirumadal · kanni 33","/p/23-periya-thirumadal/k33"],[2713,"நன்னரும் சந்தனச் சேறு புலர்த்த தாங்கருஞ்சீர்","nannarum sandhanach sERu pularththa thAnggarunjchIr","Periya Thirumadal · kanni 34","/p/23-periya-thirumadal/k34"],[2713,"பொன் அரும்பாரம் புலம்ப அகம் குழைந்து ஆங்கு","pon arumbAram pulamba agam kuzhaindhu Anggu","Periya Thirumadal · kanni 35","/p/23-periya-thirumadal/k35"],[2713,"அன்னவர் தம் மானோக்கம் உண்டு ஆங்கு அணிமுறுவல்","annavar tham mAnOkkam uNDu Anggu aNimuRuval","Periya Thirumadal · kanni 36","/p/23-periya-thirumadal/k36"],[2713,"அன்ன அறத்தின் பயன் ஆவது ஒண் பொருளும்","anna aRaththin payan Avadhu oN poruLum","Periya Thirumadal · kanni 37","/p/23-periya-thirumadal/k37"],[2713,"மன்னும் வழி முறையே நிற்று நாம் மானோக்கின்","mannum vazhi muRaiyE niRRu nAm mAnOkkin","Periya Thirumadal · kanni 38","/p/23-periya-thirumadal/k38"],[2713,"மன்னு மடல் ஊரார் என்பதோர் வாசகமும்","mannu maDal UrAr enbadhOr vAsagamum","Periya Thirumadal · kanni 39","/p/23-periya-thirumadal/k39"],[2713,"மன்னும் வட நெறியே வேண்டினோம் வேண்டாதார்","mannum vaDa neRiyE vENDinOm vENDAdhAr","Periya Thirumadal · kanni 40","/p/23-periya-thirumadal/k40"],[2713,"அன்னதோர் தன்மை அறியாதார் ஆயன் வேய்","annadhOr thanmai aRiyAdhAr Ayan vEy","Periya Thirumadal · kanni 41","/p/23-periya-thirumadal/k41"],[2713,"மன்னு மணி புலம்ப வாடாதார் பெண்ணை மேல்","mannu maNi pulamba vADAdhAr peNNai mEl","Periya Thirumadal · kanni 42","/p/23-periya-thirumadal/k42"],[2713,"உன்னி உடல் உருகி நையாதார் உம்பர் வாய்த்","unni uDal urugi naiyAdhAr umbar vAyth","Periya Thirumadal · kanni 43","/p/23-periya-thirumadal/k43"],[2713,"தம் உடலம் வேவத் தளராதார் காம வேள்","tham uDalam vEvath thaLarAdhAr kAma vEL","Periya Thirumadal · kanni 44","/p/23-periya-thirumadal/k44"],[2713,"பொன் நெடு வீதி புகாதார் தம் பூவணை மேல்","pon neDu vIdhi pugAdhAr tham pUvaNai mEl","Periya Thirumadal · kanni 45","/p/23-periya-thirumadal/k45"],[2713,"இன்னிள வாடை தடவத் தாம் கண் துயிலும்","inniLa vADai thaDavath thAm kaN thuyilum","Periya Thirumadal · kanni 46","/p/23-periya-thirumadal/k46"],[2713,"தன்னுடைய தாதை பணியால் அரசொழிந்து","thannuDaiya thAdhai paNiyAl arasozhindhu","Periya Thirumadal · kanni 47","/p/23-periya-thirumadal/k47"],[2713,"மன்னும் வள நாடு கை விட்டு மாதிரங்கள்","mannum vaLa nADu kai viTTu mAthiranggaL","Periya Thirumadal · kanni 48","/p/23-periya-thirumadal/k48"],[2713,"கல் நிரைந்து தீய்ந்து கழை உடைந்து கால் சுழன்று","kal niraindhu thIyndhu kazhai uDaindhu kAl suzhanRu","Periya Thirumadal · kanni 49","/p/23-periya-thirumadal/k49"],[2713,"கொன்னவிலும் வெங்கானத்தூடு கொடுங்கதிரோன்","konnavilum vengkAnaththUDu koDungkadhirOn","Periya Thirumadal · kanni 50","/p/23-periya-thirumadal/k50"],[2713,"மன்னன் இராமன் பின் வைதேவி என்றுரைக்கும்","mannan irAman pin vaidhEvi enRuraikkum","Periya Thirumadal · kanni 51","/p/23-periya-thirumadal/k51"],[2713,"பின்னும் கரு நெடுங்கண் செவ்வாய்ப் பிணை நோக்கின்","pinnum karu neDungkaN sevvAyp piNai nOkkin","Periya Thirumadal · kanni 52","/p/23-periya-thirumadal/k52"],[2713,"கன்னி தன் இன்னுயிராம் காதலனைக் காணாது","kanni than innuyirAm kAdhalanaik kANAdhu","Periya Thirumadal · kanni 53","/p/23-periya-thirumadal/k53"],[2713,"அன்னவனை நோக்காது அழித்து உரப்பி வாள் அமருள்","annavanai nOkkAdhu azhiththu urappi vAL amaruL","Periya Thirumadal · kanni 54","/p/23-periya-thirumadal/k54"],[2713,"பொன் நவிலும் ஆகம் புணர்ந்திலளே? பூங்கங்கை","pon navilum Agam puNarndhilaLE? pUngganggai","Periya Thirumadal · kanni 55","/p/23-periya-thirumadal/k55"],[2713,"கொன்னவிலும் நீள் வேல் குருக்கள் குல மதலை","konnavilum nIL vEl gurukkaL kula madhalai","Periya Thirumadal · kanni 56","/p/23-periya-thirumadal/k56"],[2713,"பன்னாகராயன் மடப் பாவை பாவை தன்","pannAgarAyan maDap pAvai pAvai than","Periya Thirumadal · kanni 57","/p/23-periya-thirumadal/k57"],[2713,"தன்னுடைய கொங்கை முகநெரிய தான் அவன் தன்","thannuDaiya konggai muganeriya thAn avan than","Periya Thirumadal · kanni 58","/p/23-periya-thirumadal/k58"],[2713,"நல் நகரம் புக்கு நயந்து இனிது வாழ்ந்ததுவும்","nal nagaram pukku nayandhu inidhu vAzhndhadhuvum","Periya Thirumadal · kanni 59","/p/23-periya-thirumadal/k59"],[2713,"பொன் நகரம் செற்ற புரந்தரனோடு ஏர் ஒக்கும்","pon nagaram seRRa purandharanODu Er okkum","Periya Thirumadal · kanni 60","/p/23-periya-thirumadal/k60"],[2713,"தன்னுடைய பாவை உலகத்துத் தன் ஒக்கும்","thannuDaiya pAvai ulagaththuth than okkum","Periya Thirumadal · kanni 61","/p/23-periya-thirumadal/k61"],[2713,"இன்னுயிர்த் தோழியால் எம்பெருமான் ஈந்துழாய்","innuyirth thOzhiyAl emperumAn InthuzhAy","Periya Thirumadal · kanni 62","/p/23-periya-thirumadal/k62"],[2713,"என்னை இது விளைத்த ஈரிரண்டு மால் வரைத் தோள்","ennai idhu viLaiththa IriraNDu mAl varaith thOL","Periya Thirumadal · kanni 63","/p/23-periya-thirumadal/k63"],[2713,"கன்னி தன் பால் வைக்க மற்றவனோடு எத்தனையோர்","kanni than pAl vaikka maRRavanODu eththanaiyOr","Periya Thirumadal · kanni 64","/p/23-periya-thirumadal/k64"],[2713,"என்னாலே கேட்டீரே? ஏழைகாள்! என் உரைக்கேன்?","ennAlE kETTIrE? EzhaigAL! en uraikkEn?","Periya Thirumadal · kanni 65","/p/23-periya-thirumadal/k65"],[2713,"மின்னு மணி முறுவல் செவ்வாய் உமை என்னும்","minnu maNi muRuval sevvAy umai ennum","Periya Thirumadal · kanni 66","/p/23-periya-thirumadal/k66"],[2713,"பொன் உடம்பு வாடப் புலன் ஐந்தும் நொந்தகல","pon uDambu vADap pulan aindhum nondhagala","Periya Thirumadal · kanni 67","/p/23-periya-thirumadal/k67"],[2713,"அன்ன அருந்தவத்தின் ஊடு போய் ஆயிரந்தோள்","anna arunthavaththin UDu pOy AyiranthOL","Periya Thirumadal · kanni 68","/p/23-periya-thirumadal/k68"],[2713,"மின்னி எரி வீச மேல் எடுத்த சூழ் கழற்கால்","minni eri vIsa mEl eDuththa sUzh kazhaRkAl","Periya Thirumadal · kanni 69","/p/23-periya-thirumadal/k69"],[2713,"மன்னு குல வரையும் மாருதமும் தாரகையும்","mannu kula varaiyum mArudhamum thAragaiyum","Periya Thirumadal · kanni 70","/p/23-periya-thirumadal/k70"],[2713,"கொன்னவிலும் மூவிலை வேல் கூத்தன் பொடியாடி","konnavilum mUvilai vEl kUththan poDiyADi","Periya Thirumadal · kanni 71","/p/23-periya-thirumadal/k71"],[2713,"பன்னி உரைக்குங்கால் பாரதமாம் பாவியேற்கு","panni uraikkungkAl bAradhamAm pAviyERku","Periya Thirumadal · kanni 72","/p/23-periya-thirumadal/k72"],[2713,"மன்னு மறையோர் திருநறையூர் மாமலை போல்","mannu maRaiyOr thirunaRaiyUr mAmalai pOl","Periya Thirumadal · kanni 73","/p/23-periya-thirumadal/k73"],[2713,"என்னுடைய கண் களிப்ப நோக்கினேன் நோக்குதலும்","ennuDaiya kaN kaLippa nOkkinEn nOkkudhalum","Periya Thirumadal · kanni 74","/p/23-periya-thirumadal/k74"],[2713,"பன்னு கரதலமும் கண்களும் பங்கயத்தின்","pannu karathalamum kaNgaLum panggayaththin","Periya Thirumadal · kanni 75","/p/23-periya-thirumadal/k75"],[2713,"மின்னி ஒளி படைப்ப வீழ் நாணும் தோள் வளையும்","minni oLi paDaippa vIzh nANum thOL vaLaiyum","Periya Thirumadal · kanni 76","/p/23-periya-thirumadal/k76"],[2713,"துன்னு வெயில் விரித்த சூளாமணி இமைப்ப","thunnu veyil viriththa sULAmaNi imaippa","Periya Thirumadal · kanni 77","/p/23-periya-thirumadal/k77"],[2713,"இன்னிள வஞ்சிக் கொடி ஒன்று நின்றது தான்","inniLa vanjchik koDi onRu ninRadhu thAn","Periya Thirumadal · kanni 78","/p/23-periya-thirumadal/k78"],[2713,"மின்னாய் இளவேய் இரண்டாய் இணைச் செப்பாய்","minnAy iLavEy iraNDAy iNaich cheppAy","Periya Thirumadal · kanni 79","/p/23-periya-thirumadal/k79"],[2713,"அன்ன திரு உருவம் நின்றது அறியாதே","anna thiru uruvam ninRadhu aRiyAdhE","Periya Thirumadal · kanni 80","/p/23-periya-thirumadal/k80"],[2713,"பொன் இயலும் மேகலையும் ஆங்கொழியப் போந்தேற்கு","pon iyalum mEgalaiyum Anggozhiyap pOndhERku","Periya Thirumadal · kanni 81","/p/23-periya-thirumadal/k81"],[2713,"இன்னிலாவின் கதிரும் என் தனக்கே வெய்தாகும்","innilAvin kadhirum en thanakkE veydhAgum","Periya Thirumadal · kanni 82","/p/23-periya-thirumadal/k82"],[2713,"தென்னன் பொதியில் செழுஞ்சந்தின் தாதளைந்து","thennan podhiyil sezhunjchandhin thAdhaLaindhu","Periya Thirumadal · kanni 83","/p/23-periya-thirumadal/k83"],[2713,"இன்னிளம் பூந்தென்றலும் வீசும் எரி எனக்கே","inniLam pUnthenRalum vIsum eri enakkE","Periya Thirumadal · kanni 84","/p/23-periya-thirumadal/k84"],[2713,"பின்னும் அவ்வன்றில் பெடை வாய்ச் சிறு குரலும்","pinnum avvanRil peDai vAych siRu kuralum","Periya Thirumadal · kanni 85","/p/23-periya-thirumadal/k85"],[2713,"கல் நவில் தோள் காமன் கருப்புச் சிலை வளைய","kal navil thOL kAman karuppuch silai vaLaiya","Periya Thirumadal · kanni 86","/p/23-periya-thirumadal/k86"],[2713,"தன்னுடைய தோள் கழிய வாங்கி தமியேன் மேல்","thannuDaiya thOL kazhiya vAnggi thamiyEn mEl","Periya Thirumadal · kanni 87","/p/23-periya-thirumadal/k87"],[2713,"பின் இதனைக் காப்பீர் தாம் இல்லையே பேதையேன்","pin idhanaik kAppIr thAm illaiyE pEdhaiyEn","Periya Thirumadal · kanni 88","/p/23-periya-thirumadal/k88"],[2713,"நல் நறு வாசம் மற்றாரானும் எய்தாமே","nal naRu vAsam maRRArAnum eydhAmE","Periya Thirumadal · kanni 89","/p/23-periya-thirumadal/k89"],[2713,"என்னுடைய பெண்மையும் என் நலனும் என் முலையும்","ennuDaiya peNmaiyum en nalanum en mulaiyum","Periya Thirumadal · kanni 90","/p/23-periya-thirumadal/k90"],[2713,"பொன் மலை போல் நின்றவன் தன் பொன் அகலம் தோயாவேல்","pon malai pOl ninRavan than pon agalam thOyAvEl","Periya Thirumadal · kanni 91","/p/23-periya-thirumadal/k91"],[2713,"முன் இருந்து மூக்கின்று மூவாமைக் காப்பதோர்","mun irundhu mUkkinRu mUvAmaik kAppadhOr","Periya Thirumadal · kanni 92","/p/23-periya-thirumadal/k92"],[2713,"துன்னு பிடர் எருத்துத் தூக்குண்டு வன் தொடரால்","thunnu piDar eruththuth thUkkuNDu van thoDarAl","Periya Thirumadal · kanni 93","/p/23-periya-thirumadal/k93"],[2713,"தன்னுடைய நா ஒழியாது ஆடும் தனி மணியின்","thannuDaiya nA ozhiyAdhu ADum thani maNiyin","Periya Thirumadal · kanni 94","/p/23-periya-thirumadal/k94"],[2713,"கொல் நவிலும் எஃகில் கொடிதாய் நெடிதாகும்","kol navilum eqkil koDidhAy neDidhAgum","Periya Thirumadal · kanni 95","/p/23-periya-thirumadal/k95"],[2713,"மன்னன் நறுந்துழாய் வாழ் மார்பன் மா மதி கோள்","mannan naRunthuzhAy vAzh mArban mA madhi kOL","Periya Thirumadal · kanni 96","/p/23-periya-thirumadal/k96"],[2713,"சின்ன நறும் பூந்திகழ் வண்ணன் வண்ணம் போல்","sinna naRum pUnthigazh vaNNan vaNNam pOl","Periya Thirumadal · kanni 97","/p/23-periya-thirumadal/k97"],[2713,"மன்னன் இராவணனை மா மண்டு வெஞ்சமத்து","mannan irAvaNanai mA maNDu venjchamaththu","Periya Thirumadal · kanni 98","/p/23-periya-thirumadal/k98"],[2713,"தென்னுலகம் ஏற்றுவித்த சேவகனை ஆயிரக் கண்","thennulagam ERRuviththa sEvaganai Ayirak kaN","Periya Thirumadal · kanni 99","/p/23-periya-thirumadal/k99"],[2713,"தன்னுடைய தோள் வலியால் கைக் கொண்ட தானவனை","thannuDaiya thOL valiyAl kaik koNDa dhAnavanai","Periya Thirumadal · kanni 100","/p/23-periya-thirumadal/k100"],[2713,"கொல் நவிலும் வெஞ்சமத்துக் கொல்லாதே வல்லாளன்","kol navilum venjchamaththuk kollAdhE vallALan","Periya Thirumadal · kanni 101","/p/23-periya-thirumadal/k101"],[2713,"தன்னுடைய தாள் மேல் கிடாத்தி அவனுடைய","thannuDaiya thAL mEl kiDAththi avanuDaiya","Periya Thirumadal · kanni 102","/p/23-periya-thirumadal/k102"],[2713,"மின் இலங்கும் ஆழிப் படைத் தடக் கை வீரனை","min ilanggum Azhip paDaith thaDak kai vIranai","Periya Thirumadal · kanni 103","/p/23-periya-thirumadal/k103"],[2713,"பின்னும் ஓர் ஏனமாய்ப் புக்கு வளை மருப்பில்","pinnum Or EnamAyp pukku vaLai maruppil","Periya Thirumadal · kanni 104","/p/23-periya-thirumadal/k104"],[2713,"மன்னும் வட மலையை மத்தாக மாசுணத்தால்","mannum vaDa malaiyai maththAga mAsuNaththAl","Periya Thirumadal · kanni 105","/p/23-periya-thirumadal/k105"],[2713,"தன்னினுடனே சுழல மலை திரித்து ஆங்கு","thanninuDanE suzhala malai thiriththu Anggu","Periya Thirumadal · kanni 106","/p/23-periya-thirumadal/k106"],[2713,"மன்னும் துயர் கடிந்த வள்ளலை மற்றன்றியும்","mannum thuyar kaDindha vaLLalai maRRanRiyum","Periya Thirumadal · kanni 107","/p/23-periya-thirumadal/k107"],[2713,"மன்னும் குறள் உருவின் மாணியாய் மாவலி தன்","mannum kuRaL uruvin mANiyAy mAvali than","Periya Thirumadal · kanni 108","/p/23-periya-thirumadal/k108"],[2713,"மன்னை மனங்கொள்ள வஞ்சித்து நெஞ்சுருக்கி","mannai manangkoLLa vanjchiththu nenjchurukki","Periya Thirumadal · kanni 109","/p/23-periya-thirumadal/k109"],[2713,"மன்னா! தருக என்று வாய் திறப்ப மற்றவனும்","mannA! tharuga enRu vAy thiRappa maRRavanum","Periya Thirumadal · kanni 110","/p/23-periya-thirumadal/k110"],[2713,"மின்னார் மணி முடி போய் விண் தடவ மேல் எடுத்த","minnAr maNi muDi pOy viN thaDava mEl eDuththa","Periya Thirumadal · kanni 111","/p/23-periya-thirumadal/k111"],[2713,"ஒன்னா அசுரர் துளங்கச் செல நீட்டி","onnA asurar thuLanggach sela nITTi","Periya Thirumadal · kanni 112","/p/23-periya-thirumadal/k112"],[2713,"தன் உலகம் ஆக்குவித்த தாளானை தாமரை மேல்","than ulagam Akkuviththa thALAnai thAmarai mEl","Periya Thirumadal · kanni 113","/p/23-periya-thirumadal/k113"],[2713,"பொன்னி மணி கொழிக்கும் பூங்குடந்தைப் போர் விடையை","ponni maNi kozhikkum pUngkuDandhaip pOr viDaiyai","Periya Thirumadal · kanni 114","/p/23-periya-thirumadal/k114"],[2713,"மன்னிய தண் சேறை வள்ளலை மா மலர் மேல்","manniya thaN sERai vaLLalai mA malar mEl","Periya Thirumadal · kanni 115","/p/23-periya-thirumadal/k115"],[2713,"என்னுடைய இன்னமுதை எவ்வுள் பெருமலையை","ennuDaiya innamudhai evvuL perumalaiyai","Periya Thirumadal · kanni 116","/p/23-periya-thirumadal/k116"],[2713,"மின்னை இரு சுடரை வெள்ளறையுள் கல் அறை மேல்","minnai iru suDarai veLLaRaiyuL kal aRai mEl","Periya Thirumadal · kanni 117","/p/23-periya-thirumadal/k117"],[2713,"மன்னும் அரங்கத்து எம் மா மணியை வல்லவாழ்ப்","mannum aranggaththu em mA maNiyai vallavAzhp","Periya Thirumadal · kanni 118","/p/23-periya-thirumadal/k118"],[2713,"தொன்னீர்க் கடல் கிடந்த தோளா மணிச் சுடரை","thonnIrk kaDal kiDandha thOLA maNich suDarai","Periya Thirumadal · kanni 119","/p/23-periya-thirumadal/k119"],[2713,"மன்னும் கடல்மல்லை மாயவனை வானவர் தம்","mannum kaDalmallai mAyavanai vAnavar tham","Periya Thirumadal · kanni 120","/p/23-periya-thirumadal/k120"],[2713,"தன்னைப் பிறர் அறியாத் தத்துவத்தை முத்தினை","thannaip piRar aRiyAth thaththuvaththai muththinai","Periya Thirumadal · kanni 121","/p/23-periya-thirumadal/k121"],[2713,"முன் இவ்வுலகுண்ட மூர்த்தியை கோவலூர்","mun ivvulaguNDa mUrththiyai kOvalUr","Periya Thirumadal · kanni 122","/p/23-periya-thirumadal/k122"],[2713,"பின்னும் முலை உண்ட பிள்ளையை அள்ளல் வாய்","pinnum mulai uNDa piLLaiyai aLLal vAy","Periya Thirumadal · kanni 123","/p/23-periya-thirumadal/k123"],[2713,"தென் தில்லைச் சித்திர கூடத்து என் செல்வனை","then thillaich chiththira kUDaththu en selvanai","Periya Thirumadal · kanni 124","/p/23-periya-thirumadal/k124"],[2713,"மன்னனை மாலிருஞ்சோலை மணாளனை","mannanai mAlirunjchOlai maNALanai","Periya Thirumadal · kanni 125","/p/23-periya-thirumadal/k125"],[2713,"அன்ன உருவின் அரியை திருமெய்யத்து","anna uruvin ariyai thirumeyyaththu","Periya Thirumadal · kanni 126","/p/23-periya-thirumadal/k126"],[2713,"மன்னு மதிள் கச்சி வேளுக்கை ஆளரியை","mannu madhiL kachchi vELukkai ALariyai","Periya Thirumadal · kanni 127","/p/23-periya-thirumadal/k127"],[2713,"உன்னிய யோகத்து உறக்கத்தை ஊரகத்துள்","unniya yOgaththu uRakkaththai UragaththuL","Periya Thirumadal · kanni 128","/p/23-periya-thirumadal/k128"],[2713,"என்னை மனம் கவர்ந்த ஈசனை வானவர் தம்","ennai manam kavarndha Isanai vAnavar tham","Periya Thirumadal · kanni 129","/p/23-periya-thirumadal/k129"],[2713,"அன்னவனை ஆதனூர் ஆண்டளக்கும் ஐயனை","annavanai AdhanUr ANDaLakkum aiyanai","Periya Thirumadal · kanni 130","/p/23-periya-thirumadal/k130"],[2713,"மன்னும் மறை நான்கும் ஆனானை புல்லாணித்","mannum maRai nAnkum AnAnai pullANith","Periya Thirumadal · kanni 131","/p/23-periya-thirumadal/k131"],[2713,"மன்னு மணிமாடக் கோயில் மணாளனை","mannu maNimADak kOyil maNALanai","Periya Thirumadal · kanni 132","/p/23-periya-thirumadal/k132"],[2713,"கண்ணனைக் கண்ணபுரத்தானை தென்னறையூர்","kaNNanaik kaNNapuraththAnai thennaRaiyUr","Periya Thirumadal · kanni 133","/p/23-periya-thirumadal/k133"],[2713,"கல் நவில் தோள் காளையைக் கண்டாங்குக் கை தொழுது","kal navil thOL kALaiyaik kaNDAngguk kai thozhudhu","Periya Thirumadal · kanni 134","/p/23-periya-thirumadal/k134"],[2713,"தன் அருளும் ஆகமும் தாரானேல் தன்னை நான்","than aruLum Agamum thArAnEl thannai nAn","Periya Thirumadal · kanni 135","/p/23-periya-thirumadal/k135"],[2713,"தன் அடியார் முன்பும் தரணி முழுதாளும்","than aDiyAr munbum tharaNi muzhudhALum","Periya Thirumadal · kanni 136","/p/23-periya-thirumadal/k136"],[2713,"தன் நிலைமை எல்லாம் அறிவிப்பன் தான் முன நாள்","than nilaimai ellAm aRivippan thAn muna nAL","Periya Thirumadal · kanni 137","/p/23-periya-thirumadal/k137"],[2713,"துன்னு படல் திறந்து புக்கு தயிர் வெண்ணெய்","thunnu paDal thiRandhu pukku thayir veNNey","Periya Thirumadal · kanni 138","/p/23-periya-thirumadal/k138"],[2713,"மன்னு மடவோர்கள் பற்றி ஓர் வான் கயிற்றால்","mannu maDavOrgaL paRRi Or vAn kayiRRAl","Periya Thirumadal · kanni 139","/p/23-periya-thirumadal/k139"],[2713,"அன்னதோர் பூதமாய் ஆயர் விழவின்கண்","annadhOr bUthamAy Ayar vizhavinkaN","Periya Thirumadal · kanni 140","/p/23-periya-thirumadal/k140"],[2713,"முன் இருந்து முற்றத் தான் துற்றிய தெற்றெனவும்","mun irundhu muRRath thAn thuRRiya theRRenavum","Periya Thirumadal · kanni 141","/p/23-periya-thirumadal/k141"],[2713,"தன்னை இகந்து உரைப்பத் தான் முன நாள் சென்றதுவும்","thannai igazndhu uraippath thAn muna nAL senRadhuvum","Periya Thirumadal · kanni 142","/p/23-periya-thirumadal/k142"],[2713,"கொன்னவிலும் கூத்தனாய்ப் பெயர்த்தும் குடம் ஆடி","konnavilum kUththanAyp peyarththum kuDam ADi","Periya Thirumadal · kanni 143","/p/23-periya-thirumadal/k143"],[2713,"தென் இலங்கையாட்டி அரக்கர் குலப் பாவை","then ilanggaiyATTi arakkar kulap pAvai","Periya Thirumadal · kanni 144","/p/23-periya-thirumadal/k144"],[2713,"துன்னு சுடு சினத்துச் சூர்பணகாச் சோர்வெய்தி","thunnu suDu sinaththuch sUrpaNakAch sOrveydhi","Periya Thirumadal · kanni 145","/p/23-periya-thirumadal/k145"],[2713,"தன்னை நயந்தாளைத் தான் முனிந்து மூக்கரிந்து","thannai nayandhALaith thAn munindhu mUkkarindhu","Periya Thirumadal · kanni 146","/p/23-periya-thirumadal/k146"],[2713,"தன் நிகர் ஒன்றில்லாத தாடகையை மாமுனிக்காத்","than nigar onRillAdha thADagaiyai mAmunikkAth","Periya Thirumadal · kanni 147","/p/23-periya-thirumadal/k147"],[2713,"உன்னி உலவா உலகறிய ஊர்வன் நான்","unni ulavA ulagaRiya Urvan nAn","Periya Thirumadal · kanni 148","/p/23-periya-thirumadal/k148"],[2713,"மன்னிய பூம் பெண்ணை மடல்","manniya pUm peNNai maDal","Periya Thirumadal · kanni 148½","/p/23-periya-thirumadal/k148½"],[2713,"மன்னிய பல் பொறி சேர் ஆயிர வாய் வாள் அரவின்","manniya pal poRi sEr Ayira vAy vAL aravin","Periya Thirumadal · 2713","/n/2713"],[2714,"என்னும் விதானத்தின் கீழால் இரு சுடரை","ennum vidhAnaththin kIzhAl iru suDarai","Periya Thirumadal · 2714","/n/2714"],[2715,"வான் இயங்கு தாரகை மீன்","vAn iyanggu thAragai mIn","Periya Thirumadal · 2715","/n/2715"],[2716,"தென்னன் உயர் பொருப்பும் தெய்வ வடமலையும்","thennan uyar poruppum dheyva vaDamalaiyum","Periya Thirumadal · 2716","/n/2716"],[2717,"தன் நாபி வலயத்துப் பேரொளி சேர்","than nAbi valayaththup pEroLi sEr","Periya Thirumadal · 2717","/n/2717"],[2718,"மற்றவனும் முன்னம் படைத்தனன் நான்மறைகள் அம்மறை தான்","maRRavanum munnam paDaiththanan nAnmaRaigaL ammaRai thAn","Periya Thirumadal · 2718","/n/2718"],[2719,"நான்கினிலும்","nAnkinilum","Periya Thirumadal · 2719","/n/2719"],[2720,"மன்னும் அழல் நுகர்ந்தும் வண்தடத்தின் உட்கிடந்தும்","mannum azhal nugarndhum vaNthaDaththin uTkiDandhum","Periya Thirumadal · 2720","/n/2720"],[2721,"மன்னும் கடுங்கதிரோன் மண்டலத்தின் நன்னடுவுள்","mannum kaDungkadhirOn maNDalaththin nannaDuvuL","Periya Thirumadal · 2721","/n/2721"],[2722,"முன்ன நான் சொன்ன அறத்தின் வழி முயன்ற","munna nAn sonna aRaththin vazhi muyanRa","Periya Thirumadal · 2722","/n/2722"],[2723,"மன்னிய சிங்காசனத்தின் மேல் வாள் நெடுங்கண்","manniya singgAsanaththin mEl vAL neDungkaN","Periya Thirumadal · 2723","/n/2723"],[2724,"மின் அனைய நுண்மருங்குல் மெல் இயலார் வெண்முறுவல்","min anaiya nuNmarunggul mel iyalAr veNmuRuval","Periya Thirumadal · 2724","/n/2724"],[2725,"மின் இடையாரோடும் விளையாடி வேண்டிடத்து","min iDaiyArODum viLaiyADi vENDiDaththu","Periya Thirumadal · 2725","/n/2725"],[2726,"இரு விசும்பில்","iru visumbil","Periya Thirumadal · 2726","/n/2726"],[2727,"பன்னு விசித்திரமாப் பாப்படுத்த பள்ளி மேல்","pannu vichiththiramAp pAppaDuththa paLLi mEl","Periya Thirumadal · 2727","/n/2727"],[2728,"துன்னு நறுமலரால் தோள் கொட்டி கற்பகத்தின்","thunnu naRumalarAl thOL koTTi kaRpagaththin","Periya Thirumadal · 2728","/n/2728"],[2729,"மின்னிடை மேல் கை வைத்திருந்து ஏந்திளமுலை மேல்","minniDai mEl kai vaiththirundhu EndhiLamulai mEl","Periya Thirumadal · 2729","/n/2729"],[2730,"இன்ன உருவின் இமையாத் தடங்கண்ணார்","inna uruvin imaiyAth thaDangkaNNAr","Periya Thirumadal · 2730","/n/2730"],[2731,"அன்ன அறத்தின் பயன் ஆவது ஒண் பொருளும்","anna aRaththin payan Avadhu oN poruLum","Periya Thirumadal · 2731","/n/2731"],[2732,"மானோக்கின் அன்ன நடையார் அலர் ஏச ஆடவர் மேல்","mAnOkkin anna naDaiyAr alar Esa ADavar mEl","Periya Thirumadal · 2732","/n/2732"],[2733,"வேண்டாதார் தென்னன் பொதியில் செழும் சந்தனக் குழம்பின்","vENDAdhAr thennan podhiyil sezhum sandhanak kuzhambin","Periya Thirumadal · 2733","/n/2733"],[2734,"ஆயன் வேய் இன்னிசை ஓசைக்கு இரங்காதார் மால் விடையின்","Ayan vEy innisai Osaikku iranggAdhAr mAl viDaiyin","Periya Thirumadal · 2734","/n/2734"],[2735,"பெண்ணை மேல் பின்னும் அவ்வன்றில் பெடை வாய்ச் சிறு குரலுக்கு","peNNai mEl pinnum avvanRil peDai vAych siRu kuralukku","Periya Thirumadal · 2735","/n/2735"],[2736,"உம்பர் வாய்த்","umbar vAyth","Periya Thirumadal · 2736","/n/2736"],[2737,"காம வேள் மன்னும் சிலை வாய் மலர் வாளி கோத்தெய்ய","kAma vEL mannum silai vAy malar vALi kOththeyya","Periya Thirumadal · 2737","/n/2737"],[2738,"தம் பூவணை மேல்","tham pUvaNai mEl","Periya Thirumadal · 2738","/n/2738"],[2739,"போர் வேந்தன் தன்னுடைய தாதை பணியால் அரசொழிந்து","pOr vEndhan thannuDaiya thAdhai paNiyAl arasozhindhu","Periya Thirumadal · 2739","/n/2739"],[2740,"மின் உருவில் விண் தேர் திரிந்து வெளிப்பட்டு","min uruvil viN thEr thirindhu veLippaTTu","Periya Thirumadal · 2740","/n/2740"],[2741,"கொடுங்கதிரோன்","koDungkadhirOn","Periya Thirumadal · 2741","/n/2741"],[2742,"பின்னும் கரு நெடுங்கண் செவ்வாய்ப் பிணை நோக்கின்","pinnum karu neDungkaN sevvAyp piNai nOkkin","Periya Thirumadal · 2742","/n/2742"],[2743,"வாள் அமருள் கல் நவில் தோள் காளையைக் கைப் பிடித்து மீண்டும் போய்","vAL amaruL kal navil thOL kALaiyaik kaip piDiththu mINDum pOy","Periya Thirumadal · 2743","/n/2743"],[2744,"பூங்கங்கை முன்னம் புனல் பரக்கும் நல் நாடன் மின் ஆடும்","pUngganggai munnam punal parakkum nal nADan min ADum","Periya Thirumadal · 2744","/n/2744"],[2745,"பாவை தன் மன்னிய நாண் அச்சம் மடம் என்றிவை அகல","pAvai than manniya nAN achcham maDam enRivai agala","Periya Thirumadal · 2745","/n/2745"],[2746,"தான் அவன் தன் பொன் வரை ஆகம் தழீஇக் கொண்டு போய் தனது","thAn avan than pon varai Agam thazhIik koNDu pOy thanadhu","Periya Thirumadal · 2746","/n/2746"],[2747,"சூழ் கடலுள் பொன் நகரம் செற்ற புரந்தரனோடு ஏர் ஒக்கும்","sUzh kaDaluL pon nagaram seRRa purandharanODu Er okkum","Periya Thirumadal · 2747","/n/2747"],[2748,"தன்னுடைய இன்னுயிர்த் தோழியால் எம்பெருமான் ஈந்துழாய்","thannuDaiya innuyirth thOzhiyAl emperumAn InthuzhAy","Periya Thirumadal · 2748","/n/2748"],[2749,"பாவியேன் என்னை இது விளைத்த ஈரிரண்டு மால் வரைத் தோள்","pAviyEn ennai idhu viLaiththa IriraNDu mAl varaith thOL","Periya Thirumadal · 2749","/n/2749"],[2750,"மற்றிவை தான் என்னாலே கேட்டீரே? ஏழைகாள்! என் உரைக்கேன்?","maRRivai thAn ennAlE kETTIrE? EzhaigAL! en uraikkEn?","Periya Thirumadal · 2750","/n/2750"],[2751,"வாணிலா மின்னு மணி முறுவல் செவ்வாய் உமை என்னும்","vANilA minnu maNi muRuval sevvAy umai ennum","Periya Thirumadal · 2751","/n/2751"],[2752,"ஆயிரந்தோள் மன்னு கரதலங்கள் மட்டித்து மாதிரங்கள்","AyiranthOL mannu karathalanggaL maTTiththu mAthiranggaL","Periya Thirumadal · 2752","/n/2752"],[2753,"பாவியேற்கு என் உறு நோய் யான் உரைப்பக் கேண்மின் இரும்பொழில் சூழ்","pAviyERku en uRu nOy yAn uraippak kENmin irumpozhil sUzh","Periya Thirumadal · 2753","/n/2753"],[2754,"நோக்குதலும் மன்னன் திரு மார்பும் வாயும் அடி இணையும்","nOkkudhalum mannan thiru mArbum vAyum aDi iNaiyum","Periya Thirumadal · 2754","/n/2754"],[2755,"பொன் இயல் காடோர் மணி வரை மேல் பூத்தது போல்","pon iyal kADOr maNi varai mEl pUththadhu pOl","Periya Thirumadal · 2755","/n/2755"],[2756,"அன்னமாய் மானாய் அணிமயிலாய் ஆங்கிடையே","annamAy mAnAy aNimayilAy AnggiDaiyE","Periya Thirumadal · 2756","/n/2756"],[2757,"தென்னன் பொதியில் செழுஞ்சந்தின் தாதளைந்து","thennan podhiyil sezhunjchandhin thAdhaLaindhu","Periya Thirumadal · 2757","/n/2757"],[2758,"கல் நவில் தோள் காமன் கருப்புச் சிலை வளைய","kal navil thOL kAman karuppuch silai vaLaiya","Periya Thirumadal · 2758","/n/2758"],[2759,"பேதையேன் கல் நவிலும் காட்டகத்து ஓர் வல்லிக் கடி மலரின்","pEdhaiyEn kal navilum kATTagaththu Or vallik kaDi malarin","Periya Thirumadal · 2759","/n/2759"],[2760,"பொன் மலை போல் நின்றவன் தன் பொன் அகலம் தோயாவேல்","pon malai pOl ninRavan than pon agalam thOyAvEl","Periya Thirumadal · 2760 (2760–2763 as one, per uveda.org)","/n/2760"],[2764,"காயாவின் சின்ன நறும் பூந்திகழ் வண்ணன் வண்ணம் போல்","kAyAvin sinna naRum pUnthigazh vaNNan vaNNam pOl","Periya Thirumadal · 2764","/n/2764"],[2765,"ஆயிரக் கண் மன்னவன் வானமும் வானவர் தம் பொன் உலகும்","Ayirak kaN mannavan vAnamum vAnavar tham pon ulagum","Periya Thirumadal · 2765","/n/2765"],[2766,"மன்னு இவ்வகல் இடத்தை மா முது நீர் தான் விழுங்க","mannu ivvagal iDaththai mA mudhu nIr thAn vizhungga","Periya Thirumadal · 2766","/n/2766"],[2767,"மன்னும் வட மலையை மத்தாக மாசுணத்தால்","mannum vaDa malaiyai maththAga mAsuNaththAl","Periya Thirumadal · 2767","/n/2767"],[2768,"மற்றன்றியும்","maRRanRiyum","Periya Thirumadal · 2768","/n/2768"],[2769,"பொன் இயலும் வேள்விக்கண் புக்கிருந்து போர் வேந்தர்","pon iyalum vELvikkaN pukkirundhu pOr vEndhar","Periya Thirumadal · 2769","/n/2769"],[2770,"மற்றவனும் என்னால் தரப்பட்டது என்றலுமே அத்துணைக்கண்","maRRavanum ennAl tharappaTTadhu enRalumE aththuNaikkaN","Periya Thirumadal · 2770","/n/2770"],[2771,"பொன்னார் கனை கழற்கால் ஏழ் உலகும் போய்க் கடந்து அங்கு","ponnAr kanai kazhaRkAl Ezh ulagum pOyk kaDandhu anggu","Periya Thirumadal · 2771","/n/2771"],[2772,"தாமரை மேல் மின்னிடையாள் நாயகனை விண்ணகருள் பொன் மலையை","thAmarai mEl minniDaiyAL nAyaganai viNNagaruL pon malaiyai","Periya Thirumadal · 2772","/n/2772"],[2773,"மா மலர் மேல் அன்னம் துயிலும் அணி நீர் வயல் ஆலி","mA malar mEl annam thuyilum aNi nIr vayal Ali","Periya Thirumadal · 2773","/n/2773"],[2774,"வல்லவாழ்ப் பின்னை மணாளனை பேரில் பிறப்பிலியை","vallavAzhp pinnai maNALanai pEril piRappiliyai","Periya Thirumadal · 2774","/n/2774"],[2775,"வானவர் தம் சென்னி மணிச் சுடரைத் தண்கால் திறல் வலியை","vAnavar tham senni maNich suDaraith thaNkAl thiRal valiyai","Periya Thirumadal · 2775","/n/2775"],[2776,"கோவலூர் மன்னும் இடைகழி எம் மாயவனை பேய் அலறப்","kOvalUr mannum iDaikazhi em mAyavanai pEy alaRap","Periya Thirumadal · 2776","/n/2776"],[2777,"அள்ளல் வாய் அன்னம் இரை தேர் அழுந்தூர் எழும் சுடரை","aLLal vAy annam irai thEr azhundhUr ezhum suDarai","Periya Thirumadal · 2777","/n/2777"],[2778,"மின்னி மழை தவழும் வேங்கடத்து எம் வித்தகனை","minni mazhai thavazhum vEngkaDaththu em viththaganai","Periya Thirumadal · 2778","/n/2778"],[2779,"கோட்டியூர் அன்ன உருவின் அரியை திருமெய்யத்து","kOTTiyUr anna uruvin ariyai thirumeyyaththu","Periya Thirumadal · 2779","/n/2779"],[2780,"வெஃகாவில் உன்னிய யோகத்து உறக்கத்தை ஊரகத்துள்","veqkAvil unniya yOgaththu uRakkaththai UragaththuL","Periya Thirumadal · 2780","/n/2780"],[2781,"மூழிக் களத்து விளக்கினை","mUzhik kaLaththu viLakkinai","Periya Thirumadal · 2781","/n/2781"],[2782,"மன்னும் மறை நான்கும் ஆனானை புல்லாணித்","mannum maRai nAnkum AnAnai pullANith","Periya Thirumadal · 2782","/n/2782"],[2783,"கல் நவில் தோள் காளையைக் கண்டாங்குக் கை தொழுது","kal navil thOL kALaiyaik kaNDAngguk kai thozhudhu","Periya Thirumadal · 2783","/n/2783"],[2784,"தன்னை நான் மின்னிடையார் சேரியிலும் வேதியர்கள் வாழ்விடத்தும்","thannai nAn minniDaiyAr sEriyilum vEdhiyargaL vAzhviDaththum","Periya Thirumadal · 2784","/n/2784"],[2785,"தான் முன நாள் மின்னிடை ஆய்ச்சியர் தம் சேரிக் களவின்கண்","thAn muna nAL minniDai Aychchiyar tham sErik kaLavinkaN","Periya Thirumadal · 2785","/n/2785"],[2786,"தயிர் வெண்ணெய்","thayir veNNey","Periya Thirumadal · 2786","/n/2786"],[2787,"தென் இலங்கையாட்டி அரக்கர் குலப் பாவை","then ilanggaiyATTi arakkar kulap pAvai","Periya Thirumadal · 2787","/n/2787"],[2788,"வாய்த்த மலை போலும்","vAyththa malai pOlum","Periya Thirumadal · 2788","/n/2788"],[2789,"மற்றிவை தான் உன்னி உலவா உலகறிய ஊர்வன் நான்","maRRivai thAn unni ulavA ulagaRiya Urvan nAn","Periya Thirumadal · 2789","/n/2789"],[2790,"முன்னி முளைத்தெழுந்து ஓங்கி ஒளி பரந்த","munni muLaiththezhundhu Onggi oLi parandha","Periya Thirumadal · 2790","/n/2790"]]