{"id":"23-periya-thirumadal","name":"Periya Thirumadal","nameTa":"பெரிய திருமடல்","alvar":"Thirumangai Azhvar","alvarTa":"திருமங்கையாழ்வார்","src":"periya thirumaDal","ayiram":3,"start":2713,"end":2790,"thaniyans":[{"le":["thaniyan","piLLaith thirunaRaiyUr araiyar aruLich cheydhadhu"],"lt":["தனியன்","பிள்ளைத் திருநறையூர் அரையர் அருளிச் செய்தது"],"en":["ponnulagil vAnavarum pU magaLum pORRi seyyum *","nannudhalIr! nambi naRaiyUrar * - mannulagil","en nilaimai kaNDum iranggArEyAm Agil *","mannu maDal Urvan vandhu"],"ta":["பொன்னுலகில் வானவரும் பூ மகளும் போற்றி செய்யும் *","நன்னுதலீர்! நம்பி நறையூரர் * - மன்னுலகில்","என் நிலைமை கண்டும் இரங்காரேயாம் ஆகில் *","மன்னு மடல் ஊர்வன் வந்து"]}],"sections":[{"he":[],"ht":[],"ae":"aDivaravu: manniya uyar","at":"அடிவரவு: மன்னிய உயர்","p":[[2713,2790,["** manniya pal poRi sEr Ayira vAy vAL aravin *","senni maNik kuDumith dheyvach suDar naDuvuL *","manniya nAgaththaNai mEl Or mAmalai pOl *","minnum maNi magara kuNDalanggaL vil vIsa *","thunniya thAragaiyin pEroLi sEr AgAsam *","ennum vidhAnaththin kIzhAl * - iru suDarai","mannum viLakkAga ERRi * maRi kaDalum","pannu thiraik kavari vIsa * - nila manggai","thannai muna nAL aLaviTTa thAmarai pOl *","manniya sEvaDiyai vAn iyanggu thAragai mIn *","ennum malarp piNaiyal Eyndha * - mazhaik kUndhal","thennan uyar poruppum dheyva vaDamalaiyum *","ennum ivaiyE mulaiyA vaDivamaindha *","anna naDaiya aNanggE(y) * - aDi iNaiyaith","thannuDaiya angkaigaLAl thAn thaDavath thAn kiDandhu * Or","unniya yOgaththu uRakkam thalaik koNDa","pinnai * than nAbi valayaththup pEroLi sEr *","manniya thAmarai mAmalar pUththu * ammalar mEl","munnam thisai muganaith thAn paDaikka * maRRavanum","munnam paDaiththanan nAnmaRaigaL * - ammaRai thAn","mannum aRam poruL inbam vIDu enRu ulagil *","nanneRi mEmpaTTana nAnkanRE * - nAnkinilum","pinnaiyadhu pinnaip peyar tharum enbadhu Or *","thonneRiyai vENDuvAr vIzh kaniyum Uzh ilaiyum *","ennum ivaiyE nugarndhuDalam thAm varundhi *","thunnum ilaikkurambaith thunjchiyum * - venjchuDarOn","mannum azhal nugarndhum vaNthaDaththin uTkiDandhum *","innadhOr thanmaiyarAy IngguDalam viTTezhundhu *","thonneRikkaN senRAr enappaDum sol allAl *","innadhOr kAlaththu inaiyAr idhu peRRAr *","ennavum kETTu aRivadhillai * - uLadhennil","mannum kaDungkadhirOn maNDalaththin nannaDuvuL *","annadhOr illiyin UDu pOy * - vIDennum","thonneRikkaN senRAraich solluminkaL sollAdhE *","annadhE pEsum aRivil siRu manaththu * Anggu","annavaraik kaRpippOm yAmE * - adhu niRka","munna nAn sonna aRaththin vazhi muyanRa *","annavar thAm kaNDIrgaL Ayirak kaN vAnavar kOn *","ponnagaram pukku amarar pORRi seppa * - ponggoLi sEr","kol navilum kOL ari mAth thAn sumandha kOlam sEr *","manniya singgAsanaththin mEl * - vAL neDungkaN","kanniyarAl iTTa kavarip podhi avizhndhu * Anggu","inniLam pUnthenRal iyangga * - marunggirundha","min anaiya nuNmarunggul mel iyalAr veNmuRuval *","munnam mugizhththa mugizh nilA vandharumba *","annavar tham mAnOkkam uNDAnggu aNimalar sEr *","pon iyal kaRpagaththin kADuDuththa mADellAm *","manniya mandhAram pUththa madhuth thivalai *","innisai vaNDamarum sOlai vAy mAlai sEr *","manniya mA mayil pOl kUndhal * - mazhaith thaDangkaN","min iDaiyArODum viLaiyADi vENDiDaththu *","mannum maNith thalaththu mANikka manjchariyin *","minnin oLi sEr paLinggu viLimbaDuththa *","mannum pavaLakkAl sempon sey maNDapaththuL *","anna naDaiya arambaiyar tham kai vaLarththa *","innisai yAzh pADal kETTu inbuRRu * - iru visumbil","mannu mazhai thavazhum vANilA nIL madhi thOy *","minnin oLi sEr visumbUrum mALigai mEl *","mannu maNi viLakkai mATTi * - mazhaik kaNNAr","pannu vichiththiramAp pAppaDuththa paLLi mEl *","thunniya sAlEgam sUzh kadhavam thAL thiRappa *","annam uzhakka neRindhukka vAL nIlach *","chinna naRunthAdhu sUDi * - Or mandhAram","thunnu naRumalarAl thOL koTTi * kaRpagaththin","mannu malar vAy maNi vaNDu pin thoDara *","inniLam pUnthenRal pugundhu Inggu iLamulai mEl *","nannarum sandhanach sERu pularththa * - thAnggarunjchIr","minniDai mEl kai vaiththirundhu EndhiLamulai mEl *","pon arumbAram pulamba * - agam kuzhaindhu Anggu","inna uruvin imaiyAth thaDangkaNNAr *","annavar tham mAnOkkam uNDu Anggu aNimuRuval *","innamudham mAndhi iruppar * - idhu anRE","anna aRaththin payan Avadhu * oN poruLum","anna thiRaththadhE AdhalAl * - kAmaththin","mannum vazhi muRaiyE niRRu nAm * mAnOkkin","anna naDaiyAr alar Esa ADavar mEl *","mannu maDal UrAr enbadhOr vAsagamum *","thennuRaiyil kETTu aRivadhuNDu * - adhanai yAm theLiyOm","mannum vaDa neRiyE vENDinOm * vENDAdhAr","thennan podhiyil sezhum sandhanak kuzhambin *","annadhOr thanmai aRiyAdhAr * - Ayan vEy","innisai Osaikku iranggAdhAr * mAl viDaiyin","mannu maNi pulamba vADAdhAr * - peNNai mEl","pinnum avvanRil peDai vAych siRu kuralukku *","unni uDal urugi naiyAdhAr * - umbar vAyth","thunnu madhi uguththa thU nilA nIL neruppil *","tham uDalam vEvath thaLarAdhAr * - kAma vEL","mannum silai vAy malar vALi kOththeyya *","pon neDu vIdhi pugAdhAr * - tham pUvaNai mEl","chinna malark kuzhalum algulum menmulaiyum *","inniLa vADai thaDavath thAm kaN thuyilum *","pon anaiyAr pinnum thiru uRuga * - pOr vEndhan","thannuDaiya thAdhai paNiyAl arasozhindhu *","pon nagaram pinnE pulamba valam koNDu *","mannum vaLa nADu kai viTTu * - mAthiranggaL","min uruvil viN thEr thirindhu veLippaTTu *","kal niraindhu thIyndhu kazhai uDaindhu kAl suzhanRu *","pinnum thirai vayiRRup pEyE thirindhulavA *","konnavilum vengkAnaththUDu * - koDungkadhirOn","thunnu veyil vaRuththa vemparal mEl panjchaDiyAl *","mannan irAman pin vaidhEvi enRuraikkum *","anna naDaiya aNanggu naDandhilaLE? *","pinnum karu neDungkaN sevvAyp piNai nOkkin *","min anaiya nuNmarunggul vEgavadhi enRuraikkum","kanni * than innuyirAm kAdhalanaik kANAdhu *","thannuDaiya mun thOnRal koNDEgath thAn senRu * anggu","annavanai nOkkAdhu azhiththu urappi * - vAL amaruL","kal navil thOL kALaiyaik kaip piDiththu mINDum pOy *","pon navilum Agam puNarndhilaLE? * pUngganggai","munnam punal parakkum nal nADan min ADum *","konnavilum nIL vEl gurukkaL kula madhalai *","than nigar onRillAdha venRith dhananjchayanai *","pannAgarAyan maDap pAvai * - pAvai than","manniya nAN achcham maDam enRivai agala *","thannuDaiya konggai muganeriya * - thAn avan than","pon varai Agam thazhIik koNDu pOy * thanadhu","nal nagaram pukku nayandhu inidhu vAzhndhadhuvum *","mun uraiyil kETTu aRivadhu illaiyE? * - sUzh kaDaluL","pon nagaram seRRa purandharanODu Er okkum *","mannavan vANan avuNarkku vAL vEndhan *","thannuDaiya pAvai ulagaththuth than okkum *","kanniyarai illAdha kATchiyAL * - thannuDaiya","innuyirth thOzhiyAl emperumAn InthuzhAy *","mannu maNi varaith thOL mAyavan * - pAviyEn","ennai idhu viLaiththa IriraNDu mAl varaith thOL *","mannavan than kAdhalanai mAyaththAl koNDu pOy *","kanni than pAl vaikka maRRavanODu eththanaiyOr *","manniya pEr inbam eydhinAL * - maRRivai thAn","ennAlE kETTIrE? EzhaigAL! en uraikkEn? *","mannu malai araiyan poRpAvai * - vANilA","minnu maNi muRuval sevvAy umai ennum *","anna naDaiya aNanggu nuDanggiDai sEr *","pon uDambu vADap pulan aindhum nondhagala *","thannuDaiya kUzhaich saDAbAram thAn thariththu * Anggu","anna arunthavaththin UDu pOy * - AyiranthOL","mannu karathalanggaL maTTiththu * mAthiranggaL","minni eri vIsa mEl eDuththa sUzh kazhaRkAl *","pon ulagam Ezhum kaDandhu umbar mEl silumba *","mannu kula varaiyum mArudhamum thAragaiyum *","thannin uDanE suzhalach suzhanRADum *","konnavilum mUvilai vEl kUththan poDiyADi *","annavan than pon agalam senRAnggu aNaindhilaLE? *","panni uraikkungkAl bAradhamAm * - pAviyERku","en uRu nOy yAn uraippak kENmin * irumpozhil sUzh","mannu maRaiyOr thirunaRaiyUr mAmalai pOl *","pon iyalum mADak kavADam kaDandhu pukku *","ennuDaiya kaN kaLippa nOkkinEn * - nOkkudhalum","mannan thiru mArbum vAyum aDi iNaiyum *","pannu karathalamum kaNgaLum * - panggayaththin","pon iyal kADOr maNi varai mEl pUththadhu pOl *","minni oLi paDaippa vIzh nANum thOL vaLaiyum *","manniya kuNDalamum Aramum nIL muDiyum *","thunnu veyil viriththa sULAmaNi imaippa *","mannu maradhagak kunRin marunggE * - Or","inniLa vanjchik koDi onRu ninRadhu thAn *","annamAy mAnAy aNimayilAy AnggiDaiyE *","minnAy iLavEy iraNDAy iNaich cheppAy *","munnAya thoNDaiyAyk keNDaik kulam iraNDAy *","anna thiru uruvam ninRadhu aRiyAdhE *","ennuDaiya nenjchum aRivum ina vaLaiyum *","pon iyalum mEgalaiyum Anggozhiyap pOndhERku *","mannu maRi kaDalum Arkkum * - madhi uguththa","innilAvin kadhirum en thanakkE veydhAgum *","thannuDaiya thanmai thavirath thAn en kolO? *","thennan podhiyil sezhunjchandhin thAdhaLaindhu *","mannu ivvulagai manam kaLippa vandhu iyanggum *","inniLam pUnthenRalum vIsum eri enakkE *","munniya peNNai mEl muL muLarik kUTTagaththu *","pinnum avvanRil peDai vAych siRu kuralum *","ennuDaiya nenjchukkOr Ir vALAm en seygEn? *","kal navil thOL kAman karuppuch silai vaLaiya *","kol navilum pUngkaNaigaL kOththup podha aNaindhu *","thannuDaiya thOL kazhiya vAnggi * - thamiyEn mEl","ennuDaiya nenjchE ilakkAga eyginRAn *","pin idhanaik kAppIr thAm illaiyE * - pEdhaiyEn","kal navilum kATTagaththu Or vallik kaDi malarin *","nal naRu vAsam maRRArAnum eydhAmE *","mannum vaRu nilaththu vALA Anggu uguththadhu pOl *","ennuDaiya peNmaiyum en nalanum en mulaiyum *","mannu malar manggai maindhan * kaNapuraththup","pon malai pOl ninRavan than pon agalam thOyAvEl *","en ivai thAn? vALA enakkE poRai Agi *","mun irundhu mUkkinRu mUvAmaik kAppadhOr *","mannum marundhaRivIr illaiyE? * - mAl viDaiyin","thunnu piDar eruththuth thUkkuNDu * van thoDarAl","kanniyar kaN miLirak kaTTuNDu * mAlai vAyth","thannuDaiya nA ozhiyAdhu ADum thani maNiyin *","innisai Osaiyum vandhu en sevi thanakkE *","kol navilum eqkil koDidhAy neDidhAgum *","en idhanaik kAkkumA? sollIr * - idhu viLaiththa","mannan naRunthuzhAy vAzh mArban * - mA madhi kOL","munnam viDuththa mugil vaNNan * kAyAvin","sinna naRum pUnthigazh vaNNan * vaNNam pOl","anna kaDalai malai iTTu aNai kaTTi *","mannan irAvaNanai mA maNDu venjchamaththu *","pon muDigaL paththum puraLach charam thurandhu *","thennulagam ERRuviththa sEvaganai * - Ayirak kaN","mannavan vAnamum vAnavar tham pon ulagum *","thannuDaiya thOL valiyAl kaik koNDa dhAnavanai *","pin Or ari uruvam Agi eri vizhiththu *","kol navilum venjchamaththuk kollAdhE * - vallALan","mannu maNik kunjchi paRRi vara Irththu *","thannuDaiya thAL mEl kiDAththi * - avanuDaiya","pon agalam vaL ugirAl pOzhndhu pugazh paDaiththa *","min ilanggum Azhip paDaith thaDak kai vIranai *","mannu ivvagal iDaththai mA mudhu nIr thAn vizhungga *","pinnum Or EnamAyp pukku vaLai maruppil *","kol navilum kUr nudhi mEl vaiththu eDuththa kUththanai *","mannum vaDa malaiyai maththAga mAsuNaththAl *","minnum iru suDarum viNNum piRanggoLiyum *","thanninuDanE suzhala malai thiriththu * Anggu","innamudham vAnavarai UTTi * avaruDaiya","mannum thuyar kaDindha vaLLalai * - maRRanRiyum","than uruvam Arum aRiyAmal thAn anggOr *","mannum kuRaL uruvin mANiyAy * - mAvali than","pon iyalum vELvikkaN pukkirundhu * pOr vEndhar","mannai manangkoLLa vanjchiththu nenjchurukki *","ennuDaiya pAdhaththAl yAn aLappa mUvaDi maN *","mannA! tharuga enRu vAy thiRappa * - maRRavanum","ennAl tharappaTTadhu enRalumE * aththuNaikkaN","minnAr maNi muDi pOy viN thaDava * - mEl eDuththa","ponnAr kanai kazhaRkAl Ezh ulagum pOyk kaDandhu * anggu","onnA asurar thuLanggach sela nITTi *","mannu ivvagal iDaththai mAvaliyai vanjchiththu *","than ulagam Akkuviththa thALAnai * - thAmarai mEl","minniDaiyAL nAyaganai viNNagaruL pon malaiyai *","ponni maNi kozhikkum pUngkuDandhaip pOr viDaiyai *","then nankuRungkuDiyuL sempavaLak kunRinai *","manniya thaN sERai vaLLalai * - mA malar mEl","annam thuyilum aNi nIr vayal Ali *","ennuDaiya innamudhai evvuL perumalaiyai *","kanni madhiL sUzh kaNamanggaik kaRpagaththai *","minnai iru suDarai veLLaRaiyuL kal aRai mEl","ponnai * maradhagaththaip puTkuzhi em pOr ERRai *","** mannum aranggaththu em mA maNiyai * - vallavAzhp","pinnai maNALanai pEril piRappiliyai *","thonnIrk kaDal kiDandha thOLA maNich suDarai *","en manaththu mAlai iDavendhai Isanai *","mannum kaDalmallai mAyavanai * - vAnavar tham","senni maNich suDaraith thaNkAl thiRal valiyai *","thannaip piRar aRiyAth thaththuvaththai muththinai *","annaththai mInai ariyai arumaRaiyai *","mun ivvulaguNDa mUrththiyai * - kOvalUr","mannum iDaikazhi em mAyavanai * pEy alaRap","pinnum mulai uNDa piLLaiyai * - aLLal vAy","annam irai thEr azhundhUr ezhum suDarai *","then thillaich chiththira kUDaththu en selvanai * -","minni mazhai thavazhum vEngkaDaththu em viththaganai *","mannanai mAlirunjchOlai maNALanai *","kol navilum Azhip paDaiyAnai * - kOTTiyUr","anna uruvin ariyai * thirumeyyaththu","innamudha veLLaththai indhaLUr andhaNanai *","mannu madhiL kachchi vELukkai ALariyai *","manniya pADagaththu em maindhanai * - veqkAvil","unniya yOgaththu uRakkaththai * UragaththuL","annavanai aTTabuyakaraththu emmAn ERRai *","ennai manam kavarndha Isanai * - vAnavar tham","munnavanai mUzhik kaLaththu viLakkinai *","annavanai AdhanUr ANDaLakkum aiyanai *","nennalai inRinai nALaiyai * - nIrmalai mEl","mannum maRai nAnkum AnAnai * pullANith","thennan thamizhai vaDamozhiyai * nAnggUril","mannu maNimADak kOyil maNALanai *","nannIrth thalaichchangga nANmadhiyai * - nAn vaNanggum","kaNNanaik kaNNapuraththAnai * thennaRaiyUr","mannu maNimADak kOyil maNALanai *","kal navil thOL kALaiyaik kaNDAngguk kai thozhudhu *","en nilaimai ellAm aRiviththAl emperumAn *","than aruLum Agamum thArAnEl * - thannai nAn","minniDaiyAr sEriyilum vEdhiyargaL vAzhviDaththum *","than aDiyAr munbum tharaNi muzhudhALum *","kol navilum vEl vEndhar kUTTaththum nATTagaththum *","than nilaimai ellAm aRivippan * - thAn muna nAL","minniDai Aychchiyar tham sErik kaLavinkaN *","thunnu paDal thiRandhu pukku * - thayir veNNey","than vayiRAra vizhungga * kozhungkayaRkaN","mannu maDavOrgaL paRRi Or vAn kayiRRAl *","pinnum uralODu kaTTuNDa peRRimaiyum *","annadhOr bUthamAy Ayar vizhavinkaN *","thunnu sagaDaththAl pukka perunjchORRai *","mun irundhu muRRath thAn thuRRiya theRRenavum *","mannar perum savaiyuL vAzh vEndhar thUdhanAy *","thannai igazndhu uraippath thAn muna nAL senRadhuvum *","mannu paRai kaRangga manggaiyar tham kaN kaLippa *","konnavilum kUththanAyp peyarththum kuDam ADi *","en ivan? ennappaDuginRa IDaRavum *","then ilanggaiyATTi arakkar kulap pAvai *","mannan irAvaNan than nal thanggai * - vAL eyiRRuth","thunnu suDu sinaththuch sUrpaNakAch sOrveydhi *","pon niRam koNDu pularndhu ezhundha kAmaththAl *","thannai nayandhALaith thAn munindhu mUkkarindhu *","manniya thiNNenavum vAyththa malai pOlum *","than nigar onRillAdha thADagaiyai * - ** mAmunikkAth","thennulagam ERRuviththa thiN thiRalum * maRRivai thAn","unni ulavA ulagaRiya Urvan nAn *","munni muLaiththezhundhu Onggi oLi parandha *","manniya pUm peNNai maDal","en nilaimai ellAm aRiviththAl emperumAn *","than aruLum Agamum thArAnEl * - pinnaip pOy","oNDuRai nIr vElai ulagaRiya Urvan nAn *","vaNDaRai pUm peNNai maDal"],["** மன்னிய பல் பொறி சேர் ஆயிர வாய் வாள் அரவின் *","சென்னி மணிக் குடுமித் தெய்வச் சுடர் நடுவுள் *","மன்னிய நாகத்தணை மேல் ஓர் மாமலை போல் *","மின்னும் மணி மகர குண்டலங்கள் வில் வீச *","துன்னிய தாரகையின் பேரொளி சேர் ஆகாசம் *","என்னும் விதானத்தின் கீழால் * - இரு சுடரை","மன்னும் விளக்காக ஏற்றி * மறி கடலும்","பன்னு திரைக் கவரி வீச * - நில மங்கை","தன்னை முன நாள் அளவிட்ட தாமரை போல் *","மன்னிய சேவடியை வான் இயங்கு தாரகை மீன் *","என்னும் மலர்ப் பிணையல் ஏய்ந்த * - மழைக் கூந்தல்","தென்னன் உயர் பொருப்பும் தெய்வ வடமலையும் *","என்னும் இவையே முலையா வடிவமைந்த *","அன்ன நடைய அணங்கே(ய்) * - அடி இணையைத்","தன்னுடைய அங்கைகளால் தான் தடவத் தான் கிடந்து * ஓர்","உன்னிய யோகத்து உறக்கம் தலைக் கொண்ட","பின்னை * தன் நாபி வலயத்துப் பேரொளி சேர் *","மன்னிய தாமரை மாமலர் பூத்து * அம்மலர் மேல்","முன்னம் திசை முகனைத் தான் படைக்க * மற்றவனும்","முன்னம் படைத்தனன் நான்மறைகள் * - அம்மறை தான்","மன்னும் அறம் பொருள் இன்பம் வீடு என்று உலகில் *","நன்னெறி மேம்பட்டன நான்கன்றே * - நான்கினிலும்","பின்னையது பின்னைப் பெயர் தரும் என்பதோர் *","தொன்னெறியை வேண்டுவார் வீழ் கனியும் ஊழ் இலையும் *","என்னும் இவையே நுகர்ந்துடலம் தாம் வருந்தி *","துன்னும் இலைக்குரம்பைத் துஞ்சியும் * - வெஞ்சுடரோன்","மன்னும் அழல் நுகர்ந்தும் வண்தடத்தின் உட்கிடந்தும் *","இன்னதோர் தன்மையராய் ஈங்குடலம் விட்டெழுந்து *","தொன்னெறிக்கண் சென்றார் எனப்படும் சொல் அல்லால் *","இன்னதோர் காலத்து இனையார் இது பெற்றார் *","என்னவும் கேட்டு அறிவதில்லை * - உளதென்னில்","மன்னும் கடுங்கதிரோன் மண்டலத்தின் நன்னடுவுள் *","அன்னதோர் இல்லியின் ஊடு போய் * - வீடென்னும்","தொன்னெறிக்கண் சென்றாரைச் சொல்லுமின்கள் சொல்லாதே *","அன்னதே பேசும் அறிவில் சிறு மனத்து * ஆங்கு","அன்னவரைக் கற்பிப்போம் யாமே * - அது நிற்க","முன்ன நான் சொன்ன அறத்தின் வழி முயன்ற *","அன்னவர் தாம் கண்டீர்கள் ஆயிரக் கண் வானவர் கோன் *","பொன்னகரம் புக்கு அமரர் போற்றி செப்ப * - பொங்கொளி சேர்","கொல் நவிலும் கோள் அரி மாத் தான் சுமந்த கோலம் சேர் *","மன்னிய சிங்காசனத்தின் மேல் * - வாள் நெடுங்கண்","கன்னியரால் இட்ட கவரிப் பொதி அவிழ்ந்து * ஆங்கு","இன்னிளம் பூந்தென்றல் இயங்க * - மருங்கிருந்த","மின் அனைய நுண்மருங்குல் மெல் இயலார் வெண்முறுவல் *","முன்னம் முகிழ்த்த முகிழ் நிலா வந்தரும்ப *","அன்னவர் தம் மானோக்கம் உண்டாங்கு அணிமலர் சேர் *","பொன் இயல் கற்பகத்தின் காடுடுத்த மாடெல்லாம் *","மன்னிய மந்தாரம் பூத்த மதுத் திவலை *","இன்னிசை வண்டமரும் சோலை வாய் மாலை சேர் *","மன்னிய மா மயில் போல் கூந்தல் * - மழைத் தடங்கண்","மின் இடையாரோடும் விளையாடி வேண்டிடத்து *","மன்னும் மணித் தலத்து மாணிக்க மஞ்சரியின் *","மின்னின் ஒளி சேர் பளிங்கு விளிம்படுத்த *","மன்னும் பவளக்கால் செம்பொன் செய் மண்டபத்துள் *","அன்ன நடைய அரம்பையர் தம் கை வளர்த்த *","இன்னிசை யாழ் பாடல் கேட்டு இன்புற்று * - இரு விசும்பில்","மன்னு மழை தவழும் வாணிலா நீள் மதி தோய் *","மின்னின் ஒளி சேர் விசும்பூரும் மாளிகை மேல் *","மன்னு மணி விளக்கை மாட்டி * - மழைக் கண்ணார்","பன்னு விசித்திரமாப் பாப்படுத்த பள்ளி மேல் *","துன்னிய சாலேகம் சூழ் கதவம் தாள் திறப்ப *","அன்னம் உழக்க நெறிந்துக்க வாள் நீலச் *","சின்ன நறுந்தாது சூடி * - ஓர் மந்தாரம்","துன்னு நறுமலரால் தோள் கொட்டி * கற்பகத்தின்","மன்னு மலர் வாய் மணி வண்டு பின் தொடர *","இன்னிளம் பூந்தென்றல் புகுந்து ஈங்கு இளமுலை மேல் *","நன்னரும் சந்தனச் சேறு புலர்த்த * - தாங்கருஞ்சீர்","மின்னிடை மேல் கை வைத்திருந்து ஏந்திளமுலை மேல் *","பொன் அரும்பாரம் புலம்ப * - அகம் குழைந்து ஆங்கு","இன்ன உருவின் இமையாத் தடங்கண்ணார் *","அன்னவர் தம் மானோக்கம் உண்டு ஆங்கு அணிமுறுவல் *","இன்னமுதம் மாந்தி இருப்பர் * - இது அன்றே","அன்ன அறத்தின் பயன் ஆவது * ஒண் பொருளும்","அன்ன திறத்ததே ஆதலால் * - காமத்தின்","மன்னும் வழி முறையே நிற்று நாம் * மானோக்கின்","அன்ன நடையார் அலர் ஏச ஆடவர் மேல் *","மன்னு மடல் ஊரார் என்பதோர் வாசகமும் *","தென்னுறையில் கேட்டு அறிவதுண்டு * - அதனை யாம் தெளியோம்","மன்னும் வட நெறியே வேண்டினோம் * வேண்டாதார்","தென்னன் பொதியில் செழும் சந்தனக் குழம்பின் *","அன்னதோர் தன்மை அறியாதார் * - ஆயன் வேய்","இன்னிசை ஓசைக்கு இரங்காதார் * மால் விடையின்","மன்னு மணி புலம்ப வாடாதார் * - பெண்ணை மேல்","பின்னும் அவ்வன்றில் பெடை வாய்ச் சிறு குரலுக்கு *","உன்னி உடல் உருகி நையாதார் * - உம்பர் வாய்த்","துன்னு மதி உகுத்த தூ நிலா நீள் நெருப்பில் *","தம் உடலம் வேவத் தளராதார் * - காம வேள்","மன்னும் சிலை வாய் மலர் வாளி கோத்தெய்ய *","பொன் நெடு வீதி புகாதார் * - தம் பூவணை மேல்","சின்ன மலர்க் குழலும் அல்குலும் மென்முலையும் *","இன்னிள வாடை தடவத் தாம் கண் துயிலும் *","பொன் அனையார் பின்னும் திரு உறுக * - போர் வேந்தன்","தன்னுடைய தாதை பணியால் அரசொழிந்து *","பொன் நகரம் பின்னே புலம்ப வலம் கொண்டு *","மன்னும் வள நாடு கை விட்டு * - மாதிரங்கள்","மின் உருவில் விண் தேர் திரிந்து வெளிப்பட்டு *","கல் நிரைந்து தீய்ந்து கழை உடைந்து கால் சுழன்று *","பின்னும் திரை வயிற்றுப் பேயே திரிந்துலவா *","கொன்னவிலும் வெங்கானத்தூடு * - கொடுங்கதிரோன்","துன்னு வெயில் வறுத்த வெம்பரல் மேல் பஞ்சடியால் *","மன்னன் இராமன் பின் வைதேவி என்றுரைக்கும் *","அன்ன நடைய அணங்கு நடந்திலளே? *","பின்னும் கரு நெடுங்கண் செவ்வாய்ப் பிணை நோக்கின் *","மின் அனைய நுண்மருங்குல் வேகவதி என்றுரைக்கும்","கன்னி * தன் இன்னுயிராம் காதலனைக் காணாது *","தன்னுடைய முன் தோன்றல் கொண்டேகத் தான் சென்று * அங்கு","அன்னவனை நோக்காது அழித்து உரப்பி * - வாள் அமருள்","கல் நவில் தோள் காளையைக் கைப் பிடித்து மீண்டும் போய் *","பொன் நவிலும் ஆகம் புணர்ந்திலளே? * பூங்கங்கை","முன்னம் புனல் பரக்கும் நல் நாடன் மின் ஆடும் *","கொன்னவிலும் நீள் வேல் குருக்கள் குல மதலை *","தன் நிகர் ஒன்றில்லாத வென்றித் தனஞ்சயனை *","பன்னாகராயன் மடப் பாவை * - பாவை தன்","மன்னிய நாண் அச்சம் மடம் என்றிவை அகல *","தன்னுடைய கொங்கை முகநெரிய * - தான் அவன் தன்","பொன் வரை ஆகம் தழீஇக் கொண்டு போய் * தனது","நல் நகரம் புக்கு நயந்து இனிது வாழ்ந்ததுவும் *","முன் உரையில் கேட்டு அறிவது இல்லையே? * - சூழ் கடலுள்","பொன் நகரம் செற்ற புரந்தரனோடு ஏர் ஒக்கும் *","மன்னவன் வாணன் அவுணர்க்கு வாள் வேந்தன் *","தன்னுடைய பாவை உலகத்துத் தன் ஒக்கும் *","கன்னியரை இல்லாத காட்சியாள் * - தன்னுடைய","இன்னுயிர்த் தோழியால் எம்பெருமான் ஈந்துழாய் *","மன்னு மணி வரைத் தோள் மாயவன் * - பாவியேன்","என்னை இது விளைத்த ஈரிரண்டு மால் வரைத் தோள் *","மன்னவன் தன் காதலனை மாயத்தால் கொண்டு போய் *","கன்னி தன் பால் வைக்க மற்றவனோடு எத்தனையோர் *","மன்னிய பேர் இன்பம் எய்தினாள் * - மற்றிவை தான்","என்னாலே கேட்டீரே? ஏழைகாள்! என் உரைக்கேன்? *","மன்னு மலை அரையன் பொற்பாவை * - வாணிலா","மின்னு மணி முறுவல் செவ்வாய் உமை என்னும் *","அன்ன நடைய அணங்கு நுடங்கிடை சேர் *","பொன் உடம்பு வாடப் புலன் ஐந்தும் நொந்தகல *","தன்னுடைய கூழைச் சடாபாரம் தான் தரித்து * ஆங்கு","அன்ன அருந்தவத்தின் ஊடு போய் * - ஆயிரந்தோள்","மன்னு கரதலங்கள் மட்டித்து * மாதிரங்கள்","மின்னி எரி வீச மேல் எடுத்த சூழ் கழற்கால் *","பொன் உலகம் ஏழும் கடந்து உம்பர் மேல் சிலும்ப *","மன்னு குல வரையும் மாருதமும் தாரகையும் *","தன்னின் உடனே சுழலச் சுழன்றாடும் *","கொன்னவிலும் மூவிலை வேல் கூத்தன் பொடியாடி *","அன்னவன் தன் பொன் அகலம் சென்றாங்கு அணைந்திலளே? *","பன்னி உரைக்குங்கால் பாரதமாம் * - பாவியேற்கு","என் உறு நோய் யான் உரைப்பக் கேண்மின் * இரும்பொழில் சூழ்","மன்னு மறையோர் திருநறையூர் மாமலை போல் *","பொன் இயலும் மாடக் கவாடம் கடந்து புக்கு *","என்னுடைய கண் களிப்ப நோக்கினேன் * - நோக்குதலும்","மன்னன் திரு மார்பும் வாயும் அடி இணையும் *","பன்னு கரதலமும் கண்களும் * - பங்கயத்தின்","பொன் இயல் காடோர் மணி வரை மேல் பூத்தது போல் *","மின்னி ஒளி படைப்ப வீழ் நாணும் தோள் வளையும் *","மன்னிய குண்டலமும் ஆரமும் நீள் முடியும் *","துன்னு வெயில் விரித்த சூளாமணி இமைப்ப *","மன்னு மரதகக் குன்றின் மருங்கே * - ஓர்","இன்னிள வஞ்சிக் கொடி ஒன்று நின்றது தான் *","அன்னமாய் மானாய் அணிமயிலாய் ஆங்கிடையே *","மின்னாய் இளவேய் இரண்டாய் இணைச் செப்பாய் *","முன்னாய தொண்டையாய்க் கெண்டைக் குலம் இரண்டாய் *","அன்ன திரு உருவம் நின்றது அறியாதே *","என்னுடைய நெஞ்சும் அறிவும் இன வளையும் *","பொன் இயலும் மேகலையும் ஆங்கொழியப் போந்தேற்கு *","மன்னு மறி கடலும் ஆர்க்கும் * - மதி உகுத்த","இன்னிலாவின் கதிரும் என் தனக்கே வெய்தாகும் *","தன்னுடைய தன்மை தவிரத் தான் என் கொலோ? *","தென்னன் பொதியில் செழுஞ்சந்தின் தாதளைந்து *","மன்னு இவ்வுலகை மனம் களிப்ப வந்து இயங்கும் *","இன்னிளம் பூந்தென்றலும் வீசும் எரி எனக்கே *","முன்னிய பெண்ணை மேல் முள் முளரிக் கூட்டகத்து *","பின்னும் அவ்வன்றில் பெடை வாய்ச் சிறு குரலும் *","என்னுடைய நெஞ்சுக்கோர் ஈர் வாளாம் என் செய்கேன்? *","கல் நவில் தோள் காமன் கருப்புச் சிலை வளைய *","கொல் நவிலும் பூங்கணைகள் கோத்துப் பொத அணைந்து *","தன்னுடைய தோள் கழிய வாங்கி * - தமியேன் மேல்","என்னுடைய நெஞ்சே இலக்காக எய்கின்றான் *","பின் இதனைக் காப்பீர் தாம் இல்லையே * - பேதையேன்","கல் நவிலும் காட்டகத்து ஓர் வல்லிக் கடி மலரின் *","நல் நறு வாசம் மற்றாரானும் எய்தாமே *","மன்னும் வறு நிலத்து வாளா ஆங்கு உகுத்தது போல் *","என்னுடைய பெண்மையும் என் நலனும் என் முலையும் *","மன்னு மலர் மங்கை மைந்தன் * கணபுரத்துப்","பொன் மலை போல் நின்றவன் தன் பொன் அகலம் தோயாவேல் *","என் இவை தான்? வாளா எனக்கே பொறை ஆகி *","முன் இருந்து மூக்கின்று மூவாமைக் காப்பதோர் *","மன்னும் மருந்தறிவீர் இல்லையே? * - மால் விடையின்","துன்னு பிடர் எருத்துத் தூக்குண்டு * வன் தொடரால்","கன்னியர் கண் மிளிரக் கட்டுண்டு * மாலை வாய்த்","தன்னுடைய நா ஒழியாது ஆடும் தனி மணியின் *","இன்னிசை ஓசையும் வந்து என் செவி தனக்கே *","கொல் நவிலும் எஃகில் கொடிதாய் நெடிதாகும் *","என் இதனைக் காக்குமா? சொல்லீர் * - இது விளைத்த","மன்னன் நறுந்துழாய் வாழ் மார்பன் * - மா மதி கோள்","முன்னம் விடுத்த முகில் வண்ணன் * காயாவின்","சின்ன நறும் பூந்திகழ் வண்ணன் * வண்ணம் போல்","அன்ன கடலை மலை இட்டு அணை கட்டி *","மன்னன் இராவணனை மா மண்டு வெஞ்சமத்து *","பொன் முடிகள் பத்தும் புரளச் சரம் துரந்து *","தென்னுலகம் ஏற்றுவித்த சேவகனை * - ஆயிரக் கண்","மன்னவன் வானமும் வானவர் தம் பொன் உலகும் *","தன்னுடைய தோள் வலியால் கைக் கொண்ட தானவனை *","பின் ஓர் அரி உருவம் ஆகி எரி விழித்து *","கொல் நவிலும் வெஞ்சமத்துக் கொல்லாதே * - வல்லாளன்","மன்னு மணிக் குஞ்சி பற்றி வர ஈர்த்து *","தன்னுடைய தாள் மேல் கிடாத்தி * - அவனுடைய","பொன் அகலம் வள் உகிரால் போழ்ந்து புகழ் படைத்த *","மின் இலங்கும் ஆழிப் படைத் தடக் கை வீரனை *","மன்னு இவ்வகல் இடத்தை மா முது நீர் தான் விழுங்க *","பின்னும் ஓர் ஏனமாய்ப் புக்கு வளை மருப்பில் *","கொல் நவிலும் கூர் நுதி மேல் வைத்து எடுத்த கூத்தனை *","மன்னும் வட மலையை மத்தாக மாசுணத்தால் *","மின்னும் இரு சுடரும் விண்ணும் பிறங்கொளியும் *","தன்னினுடனே சுழல மலை திரித்து * ஆங்கு","இன்னமுதம் வானவரை ஊட்டி * அவருடைய","மன்னும் துயர் கடிந்த வள்ளலை * - மற்றன்றியும்","தன் உருவம் ஆரும் அறியாமல் தான் அங்கோர் *","மன்னும் குறள் உருவின் மாணியாய் * - மாவலி தன்","பொன் இயலும் வேள்விக்கண் புக்கிருந்து * போர் வேந்தர்","மன்னை மனங்கொள்ள வஞ்சித்து நெஞ்சுருக்கி *","என்னுடைய பாதத்தால் யான் அளப்ப மூவடி மண் *","மன்னா! தருக என்று வாய் திறப்ப * - மற்றவனும்","என்னால் தரப்பட்டது என்றலுமே * அத்துணைக்கண்","மின்னார் மணி முடி போய் விண் தடவ * - மேல் எடுத்த","பொன்னார் கனை கழற்கால் ஏழ் உலகும் போய்க் கடந்து * அங்கு","ஒன்னா அசுரர் துளங்கச் செல நீட்டி *","மன்னு இவ்வகல் இடத்தை மாவலியை வஞ்சித்து *","தன் உலகம் ஆக்குவித்த தாளானை * - தாமரை மேல்","மின்னிடையாள் நாயகனை விண்ணகருள் பொன் மலையை *","பொன்னி மணி கொழிக்கும் பூங்குடந்தைப் போர் விடையை *","தென் நன்குறுங்குடியுள் செம்பவளக் குன்றினை *","மன்னிய தண் சேறை வள்ளலை * - மா மலர் மேல்","அன்னம் துயிலும் அணி நீர் வயல் ஆலி *","என்னுடைய இன்னமுதை எவ்வுள் பெருமலையை *","கன்னி மதிள் சூழ் கணமங்கைக் கற்பகத்தை *","மின்னை இரு சுடரை வெள்ளறையுள் கல் அறை மேல்","பொன்னை * மரதகத்தைப் புட்குழி எம் போர் ஏற்றை *","** மன்னும் அரங்கத்து எம் மா மணியை * - வல்லவாழ்ப்","பின்னை மணாளனை பேரில் பிறப்பிலியை *","தொன்னீர்க் கடல் கிடந்த தோளா மணிச் சுடரை *","என் மனத்து மாலை இடவெந்தை ஈசனை *","மன்னும் கடல்மல்லை மாயவனை * - வானவர் தம்","சென்னி மணிச் சுடரைத் தண்கால் திறல் வலியை *","தன்னைப் பிறர் அறியாத் தத்துவத்தை முத்தினை *","அன்னத்தை மீனை அரியை அருமறையை *","முன் இவ்வுலகுண்ட மூர்த்தியை * - கோவலூர்","மன்னும் இடைகழி எம் மாயவனை * பேய் அலறப்","பின்னும் முலை உண்ட பிள்ளையை * - அள்ளல் வாய்","அன்னம் இரை தேர் அழுந்தூர் எழும் சுடரை *","தென் தில்லைச் சித்திர கூடத்து என் செல்வனை * -","மின்னி மழை தவழும் வேங்கடத்து எம் வித்தகனை *","மன்னனை மாலிருஞ்சோலை மணாளனை *","கொல் நவிலும் ஆழிப் படையானை * - கோட்டியூர்","அன்ன உருவின் அரியை * திருமெய்யத்து","இன்னமுத வெள்ளத்தை இந்தளூர் அந்தணனை *","மன்னு மதிள் கச்சி வேளுக்கை ஆளரியை *","மன்னிய பாடகத்து எம் மைந்தனை * - வெஃகாவில்","உன்னிய யோகத்து உறக்கத்தை * ஊரகத்துள்","அன்னவனை அட்டபுயகரத்து எம்மான் ஏற்றை *","என்னை மனம் கவர்ந்த ஈசனை * - வானவர் தம்","முன்னவனை மூழிக் களத்து விளக்கினை *","அன்னவனை ஆதனூர் ஆண்டளக்கும் ஐயனை *","நென்னலை இன்றினை நாளையை * - நீர்மலை மேல்","மன்னும் மறை நான்கும் ஆனானை * புல்லாணித்","தென்னன் தமிழை வடமொழியை * நாங்கூரில்","மன்னு மணிமாடக் கோயில் மணாளனை *","நன்னீர்த் தலைச்சங்க நாண்மதியை * - நான் வணங்கும்","கண்ணனைக் கண்ணபுரத்தானை * தென்னறையூர்","மன்னு மணிமாடக் கோயில் மணாளனை *","கல் நவில் தோள் காளையைக் கண்டாங்குக் கை தொழுது *","என் நிலைமை எல்லாம் அறிவித்தால் எம்பெருமான் *","தன் அருளும் ஆகமும் தாரானேல் * - தன்னை நான்","மின்னிடையார் சேரியிலும் வேதியர்கள் வாழ்விடத்தும் *","தன் அடியார் முன்பும் தரணி முழுதாளும் *","கொல் நவிலும் வேல் வேந்தர் கூட்டத்தும் நாட்டகத்தும் *","தன் நிலைமை எல்லாம் அறிவிப்பன் * - தான் முன நாள்","மின்னிடை ஆய்ச்சியர் தம் சேரிக் களவின்கண் *","துன்னு படல் திறந்து புக்கு * - தயிர் வெண்ணெய்","தன் வயிறார விழுங்க * கொழுங்கயற்கண்","மன்னு மடவோர்கள் பற்றி ஓர் வான் கயிற்றால் *","பின்னும் உரலோடு கட்டுண்ட பெற்றிமையும் *","அன்னதோர் பூதமாய் ஆயர் விழவின்கண் *","துன்னு சகடத்தால் புக்க பெருஞ்சோற்றை *","முன் இருந்து முற்றத் தான் துற்றிய தெற்றெனவும் *","மன்னர் பெரும் சவையுள் வாழ் வேந்தர் தூதனாய் *","தன்னை இகந்து உரைப்பத் தான் முன நாள் சென்றதுவும் *","மன்னு பறை கறங்க மங்கையர் தம் கண் களிப்ப *","கொன்னவிலும் கூத்தனாய்ப் பெயர்த்தும் குடம் ஆடி *","என் இவன்? என்னப்படுகின்ற ஈடறவும் *","தென் இலங்கையாட்டி அரக்கர் குலப் பாவை *","மன்னன் இராவணன் தன் நல் தங்கை * - வாள் எயிற்றுத்","துன்னு சுடு சினத்துச் சூர்பணகாச் சோர்வெய்தி *","பொன் நிறம் கொண்டு புலர்ந்து எழுந்த காமத்தால் *","தன்னை நயந்தாளைத் தான் முனிந்து மூக்கரிந்து *","மன்னிய திண்ணெனவும் வாய்த்த மலை போலும் *","தன் நிகர் ஒன்றில்லாத தாடகையை * - ** மாமுனிக்காத்","தென்னுலகம் ஏற்றுவித்த திண் திறலும் * மற்றிவை தான்","உன்னி உலவா உலகறிய ஊர்வன் நான் *","முன்னி முளைத்தெழுந்து ஓங்கி ஒளி பரந்த *","மன்னிய பூம் பெண்ணை மடல்","என் நிலைமை எல்லாம் அறிவித்தால் எம்பெருமான் *","தன் அருளும் ஆகமும் தாரானேல் * - பின்னைப் போய்","ஒண்டுறை நீர் வேலை உலகறிய ஊர்வன் நான் *","வண்டறை பூம் பெண்ணை மடல்"],0,null]]}]}