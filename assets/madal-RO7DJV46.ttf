":[138,0],"71":[140,0],"72":[142,0],"73":[144,0],"74":[146,0],"75":[148,0],"76":[150,0],"77":[152,0],"78":[154,0],"79":[156,0],"80":[158,0],"81":[160,0],"82":[162,0],"83":[164,0],"84":[166,0],"85":[168,0],"86":[170,0],"87":[172,0],"88":[174,0],"89":[176,0],"90":[178,0],"91":[180,0],"92":[182,0],"93":[184,0],"94":[186,0],"95":[188,0],"96":[190,0],"97":[192,0],"98":[194,0],"99":[196,0],"100":[198,0],"101":[200,0],"102":[202,0],"103":[204,0],"104":[206,0],"105":[208,0],"106":[210,0],"107":[212,0],"108":[214,0],"109":[216,0],"110":[218,0],"111":[220,0],"112":[222,0],"113":[224,0],"114":[226,0],"115":[228,0],"116":[230,0],"117":[232,0],"118":[234,1],"119":[236,0],"120":[238,0],"121":[240,0],"122":[242,0],"123":[244,0],"124":[246,0],"125":[248,0],"126":[250,0],"127":[252,0],"128":[254,0],"129":[256,0],"130":[258,0],"131":[260,0],"132":[262,0],"133":[264,0],"134":[266,0],"135":[268,0],"136":[270,0],"137":[272,0],"138":[274,0],"139":[276,0],"140":[278,0],"141":[280,0],"142":[282,0],"143":[284,0],"144":[286,0],"145":[288,0],"146":[290,0],"147":[292,0],"148":[294,0],"148½":[296,0]},"uv":{"2713":["மன்னியபல்பொறிசேர் ஆயிரவாய்வாளரவின் *","சென்னிமணிக்குடுமி தெய்வச்சுடர்நடுவுள் *","மன்னியஅந்நாகத்தணைமேல் ஓர்மாமலைபோல் *","மின்னுமணிமகரகுண்டலங்கள் வில்வீச *","துன்னியதாரகையின் பேரொளிசேராகாசம் *"],"2714":["என்னும்விதானத்தின்கீழால் * - இருசுடரை","மன்னும் விளக்காகவேற்றி * மறிகடலும்"],"2715":["வானியங்குதாரகைமீன் *","என்னும்மலர்ப்பிணையலேய்ந்த * - மழைக்கூந்தல்"],"2716":["தென்னனுயர்பொருப்பும் தெய்வவடமலையும் *","என்னுமிவையே முலையாவடிவமைந்த *","அன்னநடையவணங்கே * - அடியிணையைத்","உன்னியயோகத்து உறக்கந்தலைக்கொண்ட பின்னை *"],"2717":["தன்நாபிவலயத்துப் பேரொளிசேர் *","மன்னியதாமரை மாமலர்ப்பூத்து * அம்மலர்மேல்","முன்னந்திசைமுகனைத் தான்படைக்க *"],"2718":["மற்றவனும் முன்னம்படைத்தனன் நான்மறைகள் * -","அம்மறைதான் மன்னுமறம் பொருளின்பம் வீடென்று உலகில் *","நன்னெறிமேம்பட்டன நான்கன்றே * -"],"2719":["நான்கினிலும் பின்னையது பின்னைப்பெயர்த்தருமென்பது * ஓர்","தொன்னெறியைவேண்டுவார் வீழ்கனியுமூழிலையும் *","என்னுமிவையே நுகர்ந்து உடலம்தாம்வருந்தி *","துன்னுமிலைக்குரம்பைத் துஞ்சியும் * வெஞ்சுடரோன்-"],"2720":["மன்னுமழல் நுகர்ந்தும் வண்தடத்தினுட் கிடந்தும் *","இன்னதோர் தன்மையராய் ஈங்குடலம்விட்டெழுந்து *","தொன்னெறிக்கண்சென்றா ரெனப்படுஞ்சொல்லல்லால் *","இன்னதோர்காலத்து இனையாரிது பெற்றார் *","என்னவுங் கேட்டறிவதில்லை * உளதென்னில்-"],"2721":["மன்னுங்கடுங்கதிரோன் மண்டலத்தின் நன்னடுவுள் *","அன்னதோரில்லியினூடுபோய் * - வீடென்னும்","தொன்னெறிக்கண் சென்றாரைச் சொல்லுமின்கள் சொல்லாதே *","அன்னதேபேசும் அறிவில் சிறுமனத்து * ஆங்","கன்னவரைக் கற்பிப்போம்யாமே * - அதுநிற்க"],"2722":["முன்னம்நான் சொன்ன அறத்தின் வழிமுயன்ற *","அன்னவர்தாம்கண்டீர்கள் ஆயிரக்கண்வானவர்கோன் *","பொன்னகரம்புக்கமரர் போற்றிசெப்ப * - பொங்கொளிசேர்","கொல்நவிலுங்கோளரிமாத் தான்சுமந்தகோலம்சேர் *"],"2723":["மன்னியசிங்காசனத்தின்மேல் * - வாள்நெடுங்கண்","கன்னியராலிட்ட கவரிப்பொதியவிழ்ந்து * ஆங்","கின்னிளம்பூந்தென்றலியங்க * மருங்கிருந்த -"],"2724":["மின்னனைய நுண்மருங்குல் மெல்லியலார் வெண்முறுவல் *","முன்னம்முகிழ்த்த முகிழ்நிலாவந்தரும்ப *","அன்னவர்தம்மானோக்க முண்டாங்கணிமலர்சேர் *","பொன்னியல்கற்பகத்தின் காடுடுத்தமாடெல்லாம் *","மன்னியமந்தாரம் பூத்தமதுத்திவலை *","இன்னிசை வண்டமரும் சோலைவாய் மாலைசேர் *","மன்னியமாமயில்போல்கூந்தல் * - மழைத்தடங்கண்"],"2725":["மின்னிடையாரோடும் விளையாடிவேண்டிடத்து *","மன்னும்மணித்தலத்து மாணிக்கமஞ்சரியின் *","மின்னினொளிசேர் பளிங்குவிளிம்படுத்த *","மன்னும்பவளக்கால் செம்பொன் செய்மண்டபத்துள் *","அன்னநடைய அரம்பையர்தம்வகை வளர்த்த *"],"2726":["இருவிசும்பில் மன்னுமழைதவழும் வாணிலாநீண்மதிதோய் *","மின்னினொளிசேர் விசும்பூரும்மாளிகைமேல் *","மன்னுமணி விளக்கைமாட்டி * மழைக்கண்ணார் -"],"2727":["பன்னுவிசித்திரமாப் பாப்படுத்தபள்ளிமேல் *","துன்னியசாலேகம் சூழ்கதவம்தாள் திறப்ப *","அன்னமுழக்க நெரிந்துக்கவாள்நீலச் * சின்னநறுந்தாது சூடி * ஓர்மந்தாரம் -"],"2728":["துன்னுநறுமலரால் தோள்கொட்டி * கற்பகத்தின்","மன்னுமலர்வாய் மணிவண்டுபின்தொடர *","இன்னிளம்பூந்தென்றல் புகுந்தீங்கிளமுலைமேல் *","நன்னறுஞ்சந்தனச்சேறு உலர்த்த * தாங்கருஞ்சீர்-"],"2729":["மின்னிடைமேல் கைவைத்திருந்து ஏந்திளமுலைமேல் *","பொன்னரும்பாரம்புலம்ப * - அகங்குழைந்தாங்கு"],"2730":["இன்னவுருவின் இமையாத்தடங்கண்ணார் *","அன்னவர்தம்மானோக்கமுண்டு ஆங்கணிமுறுவல் *","இன்னமுதம் மாந்தியிருப்பர் * - இதுவன்றே"],"2731":["அன்னவறத்தின் பயனாவது * ஒண்பொருளும்","அன்னதிறத்ததே யாதலால் * - காமத்தின்","மன்னும்வழிமுறையே நிற்றும்நாம் *"],"2732":["மானோக்கின்","அன்னநடையாரலரேச ஆடவர்மேல் *","மன்னுமடலூரா ரென்பதோர்வாசகமும் *","தென்னுரையில் கேட்டறிவதுண்டு * - அதனையாம் தெளியோம்","மன்னும் வடநெறியே வேண்டினோம் * -"],"2733":["வேண்டாதார்","தென்னன்பொதியில் செழுஞ்சந்தனக்குழம்பின் *","அன்னதோர் தன்மையறியாதார் * -"],"2734":["ஆயன்வேய்","இன்னிசை யோசைக்கு இரங்காதார் * மால்விடையின்","மன்னுமணி புலம்பவாடாதார் * -"],"2735":["பெண்ணைமேல்","பின்னும் அவ்வன்றிற்பேடைவாய்ச் சிறுகுரலுக்கு *","உன்னியுடலுருகிநையாதார் * -"],"2736":["உம்பவர்வாய்த்","துன்னிமதியுகுத்த தூநிலா நீள்நெருப்பில் *","தம்முடலம்வேவத் தளராதார் * -"],"2737":["காமவேள்","மன்னுஞ்சிலைவாய் மலர்வாளிகோத்தெய்ய *","பொன்நெடுவீதிபுகாதார் * -"],"2738":["தம்பூவணைமேல்","சின்னமலர்க்குழலும் அல்குலும்மென்முலையும் *","இன்னிளவாடைதடவத் தாம்கண்துயிலும் *","பொன்னனையார் பின்னுந்திருவுறுக * -"],"2739":["போர்வேந்தன்தன்னுடையதாதை பணியாலரசொழிந்து * பொன்னகரம் பின்னேபுலம்ப வலங்கொண்டு * மன்னும்வளநாடு கைவிட்டு * - மாதிரங்கள்"],"2740":["மின்னுருவில் விண்தேர் திரிந்துவெளிப்பட்டு * கல்நிறைந்துதீய்ந்து கழையுடைந்து கால்சுழன்று * பின்னுந்திரைவயிற்றுப் பேயேதிரிந்துலவா * கொன்னவிலும் வெங்கானத்தூடு * -"],"2741":["கொடுங்கதிரோன் துன்னுவெயில்வறுத்த வெம்பரல்மேல் பஞ்சடியால் * மன்னனிராமன்பின் வைதேவிஎன்றுரைக்கும் * அன்னநடைய அணங்குநடந்திலளே? *"],"2742":["பின்னும்கருநெடுங்கண் செவ்வாய்பிணைநோக்கின் * மின்னனையநுண்மருங்குல் வேகவதியென்றுரைக்கும்கன்னி * தன் இன்னுயிராம் காதலனைக்காணது * தன்னுடைய முன்தோன்றல் கொண்டேகத் தான் சென்று * அங்குஅன்னவனை நோக்காது அழித்துரப்பி * -"],"2743":["வாளமருள் கல்நவில்தோள்காளையைக் கைப்பிடித்துமீண்டும்போய் * பொன்னவிலுமாகம் புணர்ந்திலளே? *"],"2744":["பூங்கங்கை முன்னம் புனல்பரக்கும் நல்நாடன் * மின்னாடும்கொன்னவிலும்நீள்வேல் குருக்கள் குலமதலை * தன்னிகரொன்றில்லாத வென்றித்தனஞ்சயனை * பன்னாகராயன் மடப்பாவை * -"],"2745":["பாவைதன் மன்னியநாணச்சம் மடமென்றிவையகல * தன்னுடைய கொங்கை முகம்நெரிய * -"],"2746":["தானவன்தன் பொன்வரையாகம் தழீஇக்கொண்டுபோய் * தனதுநல்நகரம்புக்கு நயந்தினிதுவாழ்ந்ததுவும் * முன்னுரையில் கேட்டறிவதில்லையே? * -"],"2747":["சூழ்கடலுள்","பொன்னகரம்செற்ற புரந்தரனோடேரொக்கும் *","மன்னவன்வாணன் அவுணர்க்குவாள்வேந்தன் *","தன்னுடையபாவை உலகத்துத்தன்னொக்கும் *","கன்னியரையில்லாத காட்சியாள் * -"],"2748":["தன்னுடைய","இன்னுயிர்த்தோழியால் எம்பெருமானீன்துழாய் *","மன்னுமணிவரைத்தோள் மாயவன் * -"],"2749":["பாவியேன்","என்னையிதுவிளைத்த ஈரிரண்டுமால்வரைத்தோள் *","மன்னவன்தன்காதலனை மாயத்தால்கொண்டுபோய் *","மன்னியபேரின்பமெய்தினாள் * -"],"2750":["மற்றிவைதான்","என்னாலேகேட்டீரே? ஏழைகாள்! என்னுரைக்கேன்? *","மன்னுமலையரயன் பொற்பாவை * -"],"2751":["வாள்நிலா மின்னுமணிமுறுவல் செவ்வாயுமையென்னும் *","அன்னநடைய அணங்கு நுடங்கிடைசேர் *","பொன்னுடம்புவாடப் புலனைந்தும்நொந்தகல *","தன்னுடையகூழைச் சடாபாரம்தாம்தரித்து * ஆங்கு","அன்னவருந்தவத்தினூடுபோய் * -"],"2752":["ஆயிரந்தோள் மன்னுகரதலங்கள் மட்டித்து *","மாதிரங்கள் மின்னியெரிவீச மேலெடுத்தசூழ்கழற்கால் *","பொன்னுலகமேழும்கடந்தும்பர்மேற்சிலும்ப *","மன்னுகுலவரையும் மாருதமும்தாரகையும் *","தன்னினுடனே சுழலச்சுழன்றாடும் *","கொல்நவிலும் மூவிலைவேல் கூத்தன்பொடியாடி *","அன்னவன்தன் பொன்னகலம் சென்றாங்கணைந்திலளே? *","பன்னியுரைக்குங்கால் பாரதமாம் * -"],"2753":["பாவியேற்கு என்னுறுநோய் யானுரைப்பக்கேண்மின் *","இரும்பொழில்சூழ் மன்னுமறையோர் திருநறையூர்மாமலைபோல் *","பொன்னியலுமாடக் கவாடம்கடந்துபுக்கு *","என்னுடையகண்களிப்ப நோக்கினேன் * -"],"2754":["நோக்குதலும் மன்னன்திருமார்பும் வாயுமடியிணையும் *","பன்னுகரதலமும் கண்களும் * - பங்கயத்தின்"],"2755":["பொன்னியல்காடு ஓர்மணிவரைமேல்பூத்ததுபோல் *","மின்னியொளிபடைப்ப வீழ்நாணும்தோள்வளையும் *","மன்னியகுண்டலமும் ஆரமும்நீள்முடியும் *","துன்னுவெயில்விரித்த சூளாமணியிமைப்ப *","மன்னும்மரதகக் குன்றின்மருங்கே * - ஓர்","இன்னிளவஞ்சிக் கொடியொன்றுநின்றதுதான் *"],"2756":["அன்னமாய்மானாய் அணிமயிலாய்ஆங்கிடையே *","மின்னாய்இளவேயிரண்டாய் இணைச்செப்பாய் *","முன்னாயதொண்டையாய்க் கெண்டைகுலமிரண்டாய் *","அன்னதிருவுருவம் நின்றதறியாதே *","என்னுடையநெஞ்சும் அறிவும்இனவளையும் *","பொன்னியலும்மேகலையும் ஆங்கொழியப்போந்தேற்கு *","மன்னுமறிகடலுமார்க்கும் * மதியுகுத்த","இன்னிலாவின்கதிரும் என்தனக்கேவெய்தாகும் *","தன்னுடையதன்மை தவிரத்தானெங்கொலோ? *"],"2757":["தென்னன்பொதியில் செழுஞ்சந்தின்தாதளைந்து *","மன்னிவ்வுலகை மனங்களிப்பவந்தியங்கும் *","இன்னிளம்பூந்தென்றலும் வீசுமெரியெனக்கே *","முன்னியபெண்ணைமேல் முள்முளரிக்கூட்டகத்து *","பின்னுமவ்வன்றில் பேடைவாய்ச்சிறுகுரலும் *","என்னுடையநெஞ்சுக்கு ஓரீர்வாளாம் என்செய்கேன்? *"],"2758":["கல்நவில்தோள்காமன் கருப்புச்சிலைவளைய *","கொல்நவிலும்பூங்கணைகள் கோத்துப்பொதவணைந்து *","தன்னுடையதோள்கழியவாங்கி * - தமியேன்மேல்","என்னுடையநெஞ்சே இலக்காகவெய்கின்றான் *","பின்னிதனைக் காப்பீர்தாமில்லையே * -"],"2759":["பேதையேன்","கல்நவிலும்காட்டகத்து ஓர்வல்லிக்கடிமலரின் *","நல்நறுவாசம் மற்றாரானுமெய்தாமே *","மன்னும்வறுநிலத்து வாளாங்குகுத்ததுபோல் *","என்னுடையபெண்மையும் என்நலனும்என்முலையும் *","மன்னுமலர்மங்கைமைந்தன் * கணபுரத்துப்"],"2760":["பொன்மலைபோல்நின்றவன்தன்பொன்னகலம் தோயாவேல் *","என்னிவைதான்? வாளாஎனக்கேபொறையாகி *","முன்னிருந்துமூக்கின்று மூவாமைக்காப்பதோர் *","மன்னுமருந்தறிவீரில்லையே? -","துன்னுபிடரெருத்துத் தூக்குண்டு * வன்தொடரால்","இன்னிசையோசையும் வந்தென்செவிதனக்கே *","கொன்நவிலுமெஃகின் கொடிதாய்நெடிதாகும் *","மன்னன்நறுந்துழாய்வாழ்மார்பன் * மாமதிகோள்"],"2764":["காயாவின்சின்னநறும்பூந் திகழ்வண்ணன் * வண்ணம்போல் அன்னகடலை மலையிட்டணைகட்டி * மன்னனிராவணனை மாமண்டுவெஞ்சமத்து * பொன்முடிகள்பத்தும் புரளச்சரந்துரந்து * தென்னுலகமேற்றுவித்த சேவகனை * -"],"2765":["ஆயிரக்கண் மன்னவன்வானமும் வானவர்தம்பொன்னும்லகும் * தன்னுடையதோள்வலியால் கைக்கொண்டதானவனை * பின்னோரரியுருவமாகி எரிவிழித்து * கொல்நவிலும்வெஞ்சமத்துக் கொல்லாதே * - வல்லாளன் மன்னுமணிக்குஞ்சி பற்றிவரவீர்த்து * தன்னுடையதாள்மேல் கிடாத்தி * - அவனுடைய பொன்னகலம்வள்ளுகிரால் போழ்ந்துபுகழ்படைத்த * மின்னிலங்கும்ஆழிப்படைத் தடக்கைவீரனை *"],"2766":["மன்னிவ்வகலிடத்தை மாமுதுநீர்தான்விழுங்க * பின்னுமோரேனமாய்ப் புக்குவளைமருப்பில் * கொன்னவிலுங்கூர்நுதிமேல் வைத்தெடுத்தகூத்தனை *"],"2767":["மன்னும்வடமலையை மத்தாகமாசுணத்தால் * மின்னுமிருசுடரும் விண்ணும்பிறங்கொளியும் * தன்னினுடனே சுழலமலைதிரித்து * ஆங்கு இன்னமுதம் வானவரையூட்டி * அவருடைய மன்னும்துயர்கடிந்த வள்ளலை *"],"2768":["மற்றன்றியும்","தன்னுருவம் ஆருமறியாமல் தானங்கு * ஓர்","மன்னும்குறளுருவில் மாணியாய் * மாவலிதன்"],"2769":["பொன்னியலும்வேள்விக்கண் புக்கிருந்து * போர்வேந்தர்","மன்னைமனங்கொள்ள வஞ்சித்துநெஞ்சுருக்கி *","என்னுடையபாதத்தால் யானளப்பமூவடிமண் *","மன்னா! தருகென்று வாய்திறப்ப * -"],"2770":["மற்றவனும்","என்னால்தரப்பட்டதென்றலுமே *","அத்துணைக்கண் மின்னார்மணிமுடிபோய் விண்தடவ *","மேலெடுத்த"],"2771":["பொன்னார்கனைகழற்கால் ஏழுலகும்போய்க்கடந்து * அங்கு","ஒன்னாவசுரர் துளங்கச்செலநீட்டி *"],"2772":["தாமரைமேல் மின்னிடையாள்நாயகனை விண்ணகருள்பொன்மலையை * பொன்னிமணிகொழிக்கும் பூங்குடந்தைப்போர் விடையை * தென்னன்குறுங்குடியுள் செம்பவளக்குன்றினை * மன்னியதண் சேறை வள்ளலை * -"],"2773":["மாமலர்மேல் அன்னம்துயிலும் அணிநீர்வயலாலி * என்னுடையவின்னமுதை எவ்வுள் பெருமலையை * கன்னிமதிள்சூழ் கணமங்கைக்கற்பகத்தை * மின்னையிருசுடரை வெள்ளறையுள்கல்லறைமேற் பொன்னை * மரதகத்தைப் புட்குழியெம்போரேற்றை * மன்னுமரங்கத்துஎம்மாமணியை * -"],"2774":["வல்லவாழ்ப் பின்னைமணாளனைப் பேரில்பிறப்பிலியை * (2)தொன்னீர்க்கடல்கிடந்த தோளாமணிச்சுடரை * என்மனத்துமாலை இடவெந்தையீசனை * மன்னுங்கடல்மல்லை மாயவனை * -"],"2775":["வானவர்தம் சென்னிமணிச்சுடரைத் தண்கால் திறல்வலியை * தன்னைப்பிறரறியாத் தத்துவத்தைமுத்தினை * அன்னத்தைமீனை அரியைஅருமறையை * முன்னிவ்வுலகுண்டமூர்த்தியை * -"],"2776":["கோவலூர் மன்னுமிடைகழி யெம்மாயவனை * பேயலறப் பின்னும்முலையுண்டபிள்ளையை *"],"2777":["அள்ளல்வாய் அன்னமிரைதேர் அழுந்தூரெழுஞ்சுடரை * தெந்தில்லைச் சித்திரகூடத்துஎன் செல்வனை * -"],"2778":["மின்னிமழைதவழும் வேங்கடத்துஎம்வித்தகனை * (2)மன்னனை மாலிருஞ்சோலைமணாளனை * கொல்நவிலும் ஆழிப்படையானை * -"],"2779":["கோட்டியூர் அன்னவுருவினரியை * திருமெய்யத்து இன்னமுதவெள்ளத்தை இந்தளூரந்தணனை * மன்னுமதிள்கச்சி வேளுக்கையாளரியை * மன்னியபாடகத்து எம்மைந்தனை * -"],"2780":["வெஃகாவில் * உன்னியயோகத்துறக்கத்தை * ஊரகத்துள் அன்னவனை அட்டபுயகரத்தெம்மானேற்றை * என்னைமனங்கவர்ந்தஈசனை * - வானவர்தம் முன்னவனை"],"2781":["மூழிக்களத்துவிளக்கினை * அன்னவனை ஆதனூராண்டாளக்குமையனை * நென்னலையின்றினை நாளையை * - நீர்மலைமேல் முன்னவனை"],"2782":["மன்னும்மறைநான்குமானானை * புல்லாணித் தென்னன்தமிழை வடமொழியை * நாங்கூரில் மன்னுமணிமாடக் கோயில்மணாளனை * நல்நீர்த்தலைச்சங்கநாண்மதியை * - நான்வணங்கும்கண்ணனைக் கண்ணபுரத்தானை * தென்னறையூர் மன்னுமணிமாடக் கோயில்மணாளனை *"],"2783":["கல்நவில்தோள்காளையைக் கண்டாங்குக்கைதொழுது * என்னிலைமையெல்லாம் அறிவித்தால்எம்பெருமான் * தன்னருளுமாகமும் தாரானேல் * -"],"2784":["தன்னைநான் மின்னிடையார்சேரியிலும் வேதியர்கள்வாழ்விடத்தும் * தன்னடியார்முன்பும் தரணிமுழுதாளும் * கொல்நவிலும்வேல்வேந்தர்கூட்டத்தும்நாட்டகத்தும் * தன்னிலைமையெல்லாம் அறிவிப்பன் * -"],"2785":["தான்முனநாள் மின்னிடையாய்ச்சியர்தம் சேரிக்களவிங்கண் * துன்னுபடல்திறந்துபுக்கு * -"],"2786":["தயிர்வெண்ணெய் தன்வயிறார விழுங்க * கொழுங்கயல்கண் மன்னுமடவோர்கள் பற்றியோர்வான்கயிற்றால் * பின்னுமுரலோடு கட்டுண்டபெற்றிமையும் * அன்னதோர்பூதமாய் ஆயர்விழவின்கண் * துன்னுசகடத்தால் புக்கபெருஞ்சோற்றை * முன்னிருந்துமுற்றத்தான் துற்றியதெற்றெனவும் * மன்னர்பெருஞ்சவையுள் வாழ்வேந்தர்தூதனாய் * தன்னையிகழ்ந்துரைப்பத் தான்முனநாள்சென்றதுவும் * மன்னுபறைகறங்க மங்கையர்தம்கண்களிப்ப * கொன்னவிலுங்கூத்தனாய்ப் பெயர்த்துங்குடமாடி * என்னிவன்? என்னப்படுகின்றஈடறவும் *"],"2787":["தென்னிலங்கையாட்டி அரக்கர்குலப்பாவை * மன்னனிராவணன்தன் நல்தங்கை * - வாளெயிற்றுத்துன்னுசுடுசினத்துச் சூர்ப்பணகா சோர்வெய்தி * பொன்னிறங்கொண்டு புலர்ந்தெழுந்தகாமத்தால் * தன்னைநயந்தாளைத் தான்முனிந்து மூக்கரிந்து * மன்னியதிண்ணெனவும்"],"2788":["வாய்த்தமலைபோலும் * தன்னிகரொன்றில்லாத தாடகையை * மாமுனிக்காகத் தென்னுலகமேற்றுவித்த திண்திறலும் *"],"2789":["மற்றிவைதான் (2)உன்னியுலவாவுலகறிய ஊர்வன்நான் *"],"2790":["முன்னிமுளைத்தெழுந்து ஓங்கியொளிபரந்த * மன்னியம்பூம் பெண்ணை மடல்."]},"chap":[{"n":1,"en":"God in his yogic sleep on the ocean - (மன்னிய பல்)","ta":"எம்பெருமான் திருப்பாற் கடலில் தனது யோக தூக்கத்தில் சயனிக்கிறார்","first":"2713"},{"n":2,"en":"The Earth goddess - (வான் இயங்கு)","ta":"பூமி தெய்வம்","first":"2715"},{"n":3,"en":"Sages in Moksha - (தன் நாபி)","ta":"மோக்ஷத்தில் முனிவர்கள்","first":"2717"},{"n":4,"en":"The sages enter Indra’s world and enjoy it - (முன்னம் நான்)","ta":"முனிவர்கள் இந்திரனின் உலகில் நுழைந்து அதை அனுபவிக்கிறார்கள்.","first":"2722"},{"n":5,"en":"Indra’s Palace - (இரு விசும்பில்)","ta":"இந்திரனின் அரண்மனை","first":"2726"},{"n":6,"en":"Women who suffered to find and follow their beloveds. - Rama going to the forest with Vaidehi. - (போர் வேந்தன்)","ta":"பெண்கள் தங்களது அன்பானவர்களை கண்டுபிடித்து பின்பற்ற சிரமப்படுவது","first":"2739"},{"n":7,"en":"Vegavathi searching for her beloved. - (பின்னும் கரு)","ta":"வேகாவதி தன் காதலியைத் தேடுவது","first":"2742"},{"n":8,"en":"The daughter of Nagarajan of the snake world finding Arjuna - (பூங் கங்கை)","ta":"அர்ஜுனனைக் கண்டுபிடிக்கும் பாம்பு உலக நாகராஜனின் மகள்","first":"2744"},{"n":9,"en":"Usha, Vānan’s daughter and Māyavan - (சூழ் கடலுள்)","ta":"உஷா, வானனின் மகள் மற்றும் மாயவன்","first":"2747"},{"n":10,"en":"Parvathi doing tapas to marry Shiva. - (மற்று இவை)","ta":"சிவனை திருமணம் செய்ய பார்வதி செய்யும் தபசு","first":"2750"},{"n":11,"en":"She describes Lakshmi - (அன்னம் ஆய்)","ta":"பார்வதி லட்சுமியை விவரிக்கிறார்","first":"2756"},{"n":12,"en":"The heroism of the Lord and how she riding on madal after telling the power of Thirumāl - (காயாவின் சின்ன)","ta":"எம்பெருமானின் வீரம்","first":"2764"},{"n":13,"en":"Hiranyan and the man-lion - (ஆயிரக் கண்)","ta":"ஹிரண்யனும் மனித-சிங்கமும்","first":"2765"},{"n":14,"en":"God in the form of a boar - (மன்னு இவ்)","ta":"எம்பெருமான் வராக வடிவத்தில்","first":"2766"},{"n":15,"en":"Thirumāl churning the milky ocean with gods and Asurans - (மன்னும் வட)","ta":"எம்பெருமான் தேவர்கள் மற்றும் அசுரர்களுடன் திருப்பாற் கடலைக் கடைதல்","first":"2767"},{"n":16,"en":"God in the form of a dwarf - (மற்று இன்றியும்)","ta":"எம்பெருமான் ஒரு குள்ள வடிவத்தில்","first":"2768"},{"n":17,"en":"She praises the Divyadesams where the god stays and worships him - (தாமரைமேல்)","ta":"எம்பெருமான் தங்கியிருக்கும் திவ்ய தேசங்களை அவள் புகழ்ந்து வணங்குகிறாள்","first":"2772"}],"gap":{"2714":[[1,2,1]],"2716":[[2,1,0]],"2725":[[4,0,1]],"2749":[[2,1,0]],"2760":[[2,0,1],[4,2,0],[6,1,0],[7,0,1]],"2771":[[1,1,1]],"2790":[[0,4,0]]}}}