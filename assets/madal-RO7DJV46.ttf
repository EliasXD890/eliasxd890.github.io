{"stm":{"u":{"2673":[0,1],"2674":[4,6],"2675":[7,6],"2676":[13,6],"2677":[17,0],"2678":[23,5],"2679":[28,5],"2680":[31,6],"2681":[33,5],"2682":[38,5],"2683":[42,6],"2684":[44,5],"2685":[51,6],"2686":[64,5],"2687":[67,6],"2688":[72,5],"2689":[76,5],"2690":[79,6],"2691":[82,5],"2692":[85,5],"2693":[88,6],"2694":[92,0],"2695":[94,5],"2696":[104,0],"2697":[107,5],"2698":[110,0],"2699":[112,0],"2700":[115,0],"2701":[122,0],"2702":[125,0],"2703":[127,0],"2704":[129,0],"2705":[132,0],"2706":[136,0],"2707":[142,0],"2708":[147,0],"2709":[148,0],"2710":[151,7],"2711":[153,0],"2712":[154,0]},"k":{"1":[0,1],"2":[2,0],"3":[4,0],"4":[6,0],"5":[8,0],"6":[10,0],"7":[12,0],"8":[14,0],"9":[16,0],"10":[18,0],"11":[20,0],"12":[22,0],"13":[24,0],"14":[26,0],"15":[28,0],"16":[30,0],"17":[32,0],"18":[34,0],"19":[36,0],"20":[38,0],"21":[40,0],"22":[42,0],"23":[44,0],"24":[46,0],"25":[48,0],"26":[50,0],"27":[52,0],"28":[54,0],"29":[56,0],"30":[58,0],"31":[60,0],"32":[62,0],"33":[64,0],"34":[66,0],"35":[68,0],"36":[70,0],"37":[72,0],"38":[74,0],"39":[76,0],"40":[78,0],"41":[80,0],"42":[82,0],"43":[84,0],"44":[86,0],"45":[88,0],"46":[90,0],"47":[92,0],"48":[94,0],"49":[96,0],"50":[98,0],"51":[100,0],"52":[102,0],"53":[104,0],"54":[106,0],"55":[108,0],"56":[110,0],"57":[112,0],"58":[114,0],"59":[116,0],"60":[118,0],"61":[120,0],"62":[122,0],"63":[124,0],"64":[126,0],"65":[128,0],"66":[130,0],"67":[132,0],"68":[134,0],"69":[136,0],"70":[138,0],"71":[140,0],"72":[142,0],"73":[144,0],"74":[146,0],"75":[148,0],"76":[150,0],"77":[152,0],"77½":[154,0]},"uv":{"2673":["காரார்வரைக்கொங்கை கண்ணார்கடலுடுக்கை *","சீரார்சுடர்ச்சுட்டி செங்கலுழிப்பேராற்று * (2)","பேராரமார்பின் பெருமாமழைக்கூந்தல் *","நீராரவேலி நிலமங்கையென்னும் * - இப்","பாரோர்சொலப்பட்ட மூன்றன்றே *"],"2674":["- அம்மூன்றும்","ஆராயில்தானே அறம்பொருளின்பமென்று *","ஆராரிவற்றினிடையதனையெய்துவார் *","சீராரிருகலயுமெய்துவர் *"],"2675":["சிக்கெனமற்று","ஆரானுமுண்டென்பா ரென்பதுதானதுவும் *","ஒராமையன்றெ? உலகத்தார்சொல்லுஞ்சொல் *","ஒராமையாமாறு அதுவுரைக்கேன்கேளாமே *","காரார்புரவியேழ் பூண்டதனியாழி *","தேரார்நிறைகதிரோன் மண்டலதைக்கீண்டுபுக்கு *","ஆராவமுதமங்கெய்தி *"],"2676":["- அதினின்றும்","வாராதொழிவதொன்றுண்டே? * - அதுநிற்க","ஏரார்முயல்விட்டுக் காக்கைப்பின்போவதே *","எராரிளமுலையீர்! எந்தனக்குற்றதுதான் *"],"2677":["காரார்குழலெடுத்துக்கட்டி * கதிர்முலையை","வாராரவீக்கி மணிமேகலைதிருத்தி *","ஆராரயில்வேற்கண் அஞ்சனத்தின்நீறணிந்து *","சீரார்செழும்பந்து கொண்டடியாநின்றேன்நான் *","நீரார்கமலம்போல் செங்கண்மாலென்றொருவன் *","பாரோர்களெல்லாம் மகிழப்பறைகறங்க *","சீரார்குடமிரண்டேந்தி *"],"2678":["- செழுந்தெருவே","ஆராரெனச்சொல்லி ஆடுமதுகண்டு *","ஏராரிளமுலையார் என்னயருமெல்லாரும் *","வாராயோவென்றார்க்குச் சென்றேனென்வல்வினையால் *","காரார்மணிநிறமும் கைவளையும்காணேன்நான் *","ஆரானுஞ்சொல்லிற்றுங்கொள்ளேன் *"],"2679":["- அறிவழிந்து","தீராவுடம்பொடு பேதுறுவேன்கண்டிரங்கி *","ஏரார்கிளிக்கிளவிஎம்மனைதான்வந்தென்னை *","சீரார்செழும்புழுதிக்காப்பிட்டு *"],"2680":["- செங்குறிஞ்சித்","தாரார்நறுமாலை சாத்தற்கு * தான்பின்னும்","நேராதனவொன்றுநேர்ந்தாள் *"],"2681":["- அதனாலும்","தீராதுஎன்சிந்தைநோய் தீராதுஎன்பேதுறவு *","வாராதுமாமை அதுகண்டுமற்றாங்கே *","ஆரானும்மூதறியும் அம்மனைமார்ச்சொல்லுவார் *","பாரோர்சொலப்படும் கட்டுப்படுத்திரேல் *","ஆரானும்மெய்படுவனென்றார் *"],"2682":["- அதுகேட்டுக்","காரார்குழற்கொண்டைக் கட்டுவிச்சிகட்டேறி *","சீரார்சுளகில் சிலநெல்பிடித்தெறியா *","வேராவிதிர்விதிரா மெய்சிலிராக்கைமோவா *","பேராயிரமுடையானென்றாள் *"],"2683":["- பேர்த்தேயும்","காரார்திருமேனிகாட்டினாள் * - கையதுவும்","சீரார்வலம்புரியேயென்றாள் *"],"2684":["- திருத்துழாய்த்","தாரார்நறுமாலை கட்டுரைத்தாள்கட்டுரையா *","நீரேதுமஞ்சேன்மின் நும்மகளைநோய்செய்தான் *","ஆரானுமல்லன் அறிந்தேன்அவனைநான் *","கூரார்வேற்கண்ணீர்! உமக்கறியக்கூறுகேனோ? *","ஆரால்இவ்வையம் அடியளப்புண்டதுதான்? *","ஆரால்இலங்கை பொடிபொடியாவீழ்ந்தது? * - மற்று","ஆராலே கன்மாரிகாத்ததுதான்? *"],"2685":["- ஆழிநீர்","ஆரால்கடைந்திடப்பட்டது? * - அவன்காண்மின்","ஊராநிரைமேய்த்து உலகெல்லாமுண்டுமிழ்ந்தும் *","ஆராததன்மையனாய் ஆங்கொருநாளாய்ப்பாடி *","சீரார்கலயல்குல் சீரடிசெந்துவர்வாய் *","வாரார்வனமுலையாள் மத்தாரப்பற்றிக்கொண்டு *","ஏராரிடைநோவ எத்தனையோர்போதுமாய் *","சீரார்தயிர்கடைந்து வெண்ணெய்திரண்டதனை *","வேரார்நுதல்மடவாள் வேறோர்கலத்திட்டு *","நாராருறியேற்றி நன்கமையவைத்ததனை *","போரார்வேற்கண்மடவாள் போந்தனையும்பொய்யுறக்கம் *","ஓராதவன்போல் உறங்கியறிவுற்று *","தாரார்தடந்தோள்கள் உள்ளளவும்கைநீட்டி *","ஆராதவெண்ணெய்விழுங்கி *"],"2686":["- அருகிருந்த","மோரார்குடமுருட்டி முன்கிடந்ததானத்தே *","ஓராதவன்போல்கிடந்தானைக் கண்டவளும் *","வாராத்தான்வைத்ததுகாணாள் *"],"2687":["- வயிறடித்திங்கு","ஆரார்புகுதுவார்? ஐயரிவரல்லால் *","நீராமிதுசெய்தீர் என்றோர்நெடுங்கயிற்றால் *","ஊரார்களெல்லாரும் காணவுரலோடே *","தீராவெகுளியளாய்ச் சிக்கெனவார்த்தடிப்ப *","ஆராவயிற்றினோடு ஆற்றாதான் *"],"2688":["அன்றியும்","நீரார்நெடுங்கயத்தைச் சென்றலைக்கநின்றுரப்பி *","ஒராயிரம்பணவெங்கோவியல்நாகத்தை *","வாராயெனக்கென்று மற்றதன்மத்தகத்து *","சீரார்திருவடியால்பாய்ந்தான் *"],"2689":["தன் சீதைக்கு","நேராவனென்று ஓர்நிசாசரிதான்வந்தாளை *","கூரர்ந்தவாளால் கொடிமூக்கும்காதிரண்டும் *","ஈராவிடுத்துஅவட்குமூத்தோனை *"],"2690":["- வெந்நரகம்","சேராவகையே சிலைகுனித்தான் * செந்துவர்வாய்","வாரார்வனமுலையாள் வைதேவிகாரணமா? *","எரார்தடந்தோளிராவணனை *"],"2691":["ஈரைந்து","சீரார்சிரமறுத்துச் செற்றுகந்தசெங்கண்மால் *","போரார்நெடுவேலோன் பொன்பெயரோனாகத்தை *","கூரார்ந்தவள்ளுகிரால்கீண்டு *"],"2692":["- குடல்மாலை","சீரார்திருமார்பின்மேல்கட்டி * செங்குருதி","சோராக்கிடந்தானைக் குங்குமத்தோள்கொட்டி *","ஆராவெழுந்தான் அரியுருவாய் *"],"2693":["அன்றியும்","பேர்வாமனனாகியகாலத்து * மூவடிமண்","தாராயெனக்கென்று வேண்டிச்சலத்தினால் *","நீரேற்றுஉலகெல்லாம் நின்றளந்தான்மாவலியை *"],"2694":["ஆராதபோரில் அசுரர்களும்தானுமாய் *","காரார்வரைநட்டு நாகம்கயிறாக *","பேராமல்தாங்கிக்கடைந்தான் *"],"2695":["- திருதுழாய்த்","தாரார்ந்தமார்வன் தடமால்வரைபோலும் *","போரானைபொய்கைவாய்க் கோட்பட்டுநின்றலறி *","நீரார்மலர்க்கமலம்கொண்டு ஓர்நெடுங்கையால் *","நாராயணா! ஓ! மணிவண்ணா! நாகணையாய்! *","வாராய்என்னாரிடரைநீக்காய் * - எனவெகுண்டு","தீராதசீற்றத்தால் சென்றிரண்டுகூறாக *","ஈராவதனையிடர்கடிந்தான் எம்பெருமான் *","பேராயிரமுடையான் பேய்ப்பெண்டீர்! நும்மகளை *","தீராநோய்செய்தான் எனவுரைத்தாள் * - சிக்கெனமற்று"],"2696":["ஆரானுமல்லாமைகேட்டு எங்களம்மனையும் *","போரார்வேற்கண்ணீர்! அவனாகில்பூந்துழாய் *","தாராதொழியுமே? தன்னடிச்சியல்லளே? * - மற்று","ஆரானுமல்லனேயென்றொழிந்தாள் *"],"2697":["நானவனைக்","காரார்த்திருமேனி கண்டதுவே காரணமா *","பேராப்பிதற்றாத் திரிதருவன் * - பின்னையும்"],"2698":["ஈராப்புகுதலும் இவ்வுடலைத்தண்வாடை *","சோராமறுக்கும் வகையறியேன் * - சூழ்குழலார்"],"2699":["ஆரானுமேசுவரென்னுமதன்பழியை *","வாராமல்காப்பதற்கு வாளாயிருந்தொழிந்தேன் *","வாராய்மடநெஞ்சே! வந்து * - மணிவண்ணன்"],"2700":["சீரார்திருத்துழாய்மாலை நமக்கருளி *","தாரான்தருமென்று இரண்டத்திலொன்றதனை *","ஆரானுமொன்னாதார் கேளாமேசொன்னக்கால் *","ஆராயுமேலும் பணிகேட்டுஅதன்றெனிலும் *","போராதொழியாதே போந்திடுநீயென்றேற்கு *","காரார்கடல்வண்ணன் பின்போனநெஞ்சமும் *","வாராதே என்னைமறந்ததுதான் * - வல்வினையேன்"],"2701":["ஊராருகப்பதேயாயினேன் * மற்றெனக்கிங்கு -","ஆராய்வாரில்லை அழல்வாய்மெழுகுபோல் *","நீராய்உருகும்என்னாவி * - நெடுங்கண்கள்"],"2702":["ஊராருறங்கிலும் தானுறங்கா * - உத்தமன்தன்","பேராயினவே பிதற்றுவன் * - பின்னையும்"],"2703":["காரார்கடல்போலும் காமத்தராயினார் *","ஆரேபொல்லாமையறிவார்? * அதுநிற்க"],"2704":["ஆரானுமாதானும் அல்லளவள்காணீர் *","வாரார்வனமுலை வாசவதத்தையென்று *","ஆரானும்சொல்லப்படுவாள் * - அவளும்தன்"],"2705":["பேராயமெல்லாம் ஒழியப் பெருந்தெருவே *","தாரார்தடந்தோள் தளைக்காலன்பின்போனாள் *","ஊராரிகழ்ந்திடப்பட்டாளே? * - மற்றெனக்கிங்கு","ஆரானும்கற்பிப்பார்நாயகரே? * நானவனைக்"],"2706":["## காரார்திருமேனி காணுமளவும்போய் *","சீரார் திருவேங்கடமே திருக்கோவ (2)","லூரே * - மதிட்கச்சியூரகமே பேரகமே *","பேராமருதிறுத்தான் வெள்ளறையேவெஃகாவே *","பேராலிதண்கால் நறையூர்திருப்புலியூர் *","ஆராமம்சூழ்ந்த அரங்கம் * - கணமங்கை (2)"],"2707":["காரார்மணிநிறக்கண்ணனூர்விண்ணகரம் *","சீரார்கணபுரம் சேறைதிருவழுந்தூர் *","காரார்குடந்தை கடிகைகடல்மல்லை *","ஏரார்பொழில்சூழ் இடவெந்தைநீர்மலை *","சீராரும்மாலிருஞ்சோலை திருமோகூர் *"],"2708":["பாரோர்புகழும் வதரிவடமதுரை *"],"2709":["ஊராயவெல்லாம் ஒழியாமேநானவனை *","ஓரானைகொம்பொசித்து ஓரானைகோள்விடுத்த","சீரானை * செங்கணெடியானைத் தேன்துழாய்த்","தாரானை * தாமரைபோல்கண்ணானை * -"],"2710":["எண்ணருஞ்சீர்ப் பேராயிரமும்பிதற்றி * பெருந்தெருவெ -"],"2711":["## ஊராரிகழிலும் ஊராதொழியேன்நான் * (2)"],"2712":