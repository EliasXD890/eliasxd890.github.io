{"id":"04-nachchiyar-thirumozhi","name":"Nachchiyar Thirumozhi","nameTa":"நாச்சியார் திருமொழி","alvar":"Andal","alvarTa":"ஆண்டாள்","src":"nAchchiyAr thirumozhi","ayiram":1,"start":504,"end":646,"thaniyans":[{"le":["nAchchiyAr thirumozhith thaniyan","thirukkaNNamanggaiyANDAn aruLich cheydhadhu"],"lt":["நாச்சியார் திருமொழித் தனியன்","திருக்கண்ணமங்கையாண்டான் அருளிச் செய்தது"],"en":["alli nAL thAmarai mEl AraNanggin inthuNaivi *","malli nADANDa maDamayil - melliyalAL *","Ayar kula vEndhan AgaththAL * then pudhuvai","vEyar payandha viLakku"],"ta":["அல்லி நாள் தாமரை மேல் ஆரணங்கின் இன்துணைவி *","மல்லி நாடாண்ட மடமயில் - மெல்லியலாள் *","ஆயர் குல வேந்தன் ஆகத்தாள் * தென் புதுவை","வேயர் பயந்த விளக்கு"]}],"sections":[{"he":["mudhal thirumozhi - thaiyoru thinggaLum","kaNNanODu kUTTumpaDi kAmanaith thozhudhal"],"ht":["முதல் திருமொழி - தையொரு திங்களும்","கண்ணனோடு கூட்டும்படி காமனைத் தொழுதல்"],"ae":"aDivaravu: thai veLLai maththam suvaril vAniDai uru kAyuDai mAsuDai thozhudhu karuppu nAmam","at":"அடிவரவு: தை வெள்ளை மத்தம் சுவரில் வானிடை உரு காயுடை மாசுடை தொழுது கருப்பு நாமம்","p":[[504,504,["** thaiyoru thinggaLum tharai viLakkith *","thaN maNDalam iTTu mAsi munnAL *","aiya nuNmaNaR koNDu theruvaNindhu *","azhaginukku alangkariththu anangga dhEvA! **","uyyavum AngkolO enRu solli *","unnaiyum umbiyaiyum thozhudhEn *","veyyadhOr thazhal umizh chakkarak kai *","vEngkaDavaRku ennai vidhikkiRRiyE"],["** தையொரு திங்களும் தரை விளக்கித் *","தண் மண்டலம் இட்டு மாசி முன்னாள் *","ஐய நுண்மணற் கொண்டு தெருவணிந்து *","அழகினுக்கு அலங்கரித்து அனங்க தேவா! **","உய்யவும் ஆங்கொலோ என்று சொல்லி *","உன்னையும் உம்பியையும் தொழுதேன் *","வெய்யதோர் தழல் உமிழ் சக்கரக் கை *","வேங்கடவற்கு என்னை விதிக்கிற்றியே"],0,"/media/recitation/NAT.1.1.mp3"],[505,505,["veLLai nuNmaNaR koNDu theruvaNindhu *","veLvaraippadhan munnam thuRai paDindhu *","muLLum illAch chuLLi eri maDuththu *","muyanRu unnai nORkinREn kAma dhEvA! **","kaLLavizh pUngkaNai thoDuththuk koNDu *","kaDalvaNNan enbadhOr pEr ezhudhi *","puLLinai vAy piLandhAn enbadhOr *","ilakkinil puga ennai eykiRRiyE"],["வெள்ளை நுண்மணற் கொண்டு தெருவணிந்து *","வெள்வரைப்பதன் முன்னம் துறை படிந்து *","முள்ளும் இல்லாச் சுள்ளி எரி மடுத்து *","முயன்று உன்னை நோற்கின்றேன் காம தேவா! **","கள்ளவிழ் பூங்கணை தொடுத்துக் கொண்டு *","கடல்வண்ணன் என்பதோர் பேர் எழுதி *","புள்ளினை வாய் பிளந்தான் என்பதோர் *","இலக்கினில் புக என்னை எய்கிற்றியே"],0,"/media/recitation/NAT.1.2.mp3"],[506,506,["maththa nannaRumalar murukkamalar","koNDu * muppOdhum unnaDi vaNanggi *","thaththuvam ili enRu nenjchu erindhu *","vAsagaththu azhiththu unnai vaidhiDAmE **","koththalar pUngkaNai thoDuththuk koNDu *","gOvindhan enbadhOr pEr ezhudhi *","viththagan vEngkaDavANan ennum *","viLakkinil puga ennai vidhikkiRRiyE"],["மத்த நன்னறுமலர் முருக்கமலர்","கொண்டு * முப்போதும் உன்னடி வணங்கி *","தத்துவம் இலி என்று நெஞ்சு எரிந்து *","வாசகத்து அழித்து உன்னை வைதிடாமே **","கொத்தலர் பூங்கணை தொடுத்துக் கொண்டு *","கோவிந்தன் என்பதோர் பேர் எழுதி *","வித்தகன் வேங்கடவாணன் என்னும் *","விளக்கினில் புக என்னை விதிக்கிற்றியே"],0,"/media/recitation/NAT.1.3.mp3"],[507,507,["suvaril purANa! nin pEr ezhudhich *","suRava naRkoDikkaLum thurangganggaLum *","kavarip piNAkkaLum karuppu villum *","kATTith thandhEn kaNDAy kAma dhEvA! **","avaraip pirAyam thoDanggi * enRum","Adhariththu ezhundha en thaDamulaigaL *","thuvaraip pirAnukkE sangkaRpiththuth *","thozhudhu vaiththEn ollai vidhikkiRRiyE"],["சுவரில் புராண! நின் பேர் எழுதிச் *","சுறவ நற்கொடிக்களும் துரங்கங்களும் *","கவரிப் பிணாக்களும் கருப்பு வில்லும் *","காட்டித் தந்தேன் கண்டாய் காம தேவா! **","அவரைப் பிராயம் தொடங்கி * என்றும்","ஆதரித்து எழுந்த என் தடமுலைகள் *","துவரைப் பிரானுக்கே சங்கற்பித்துத் *","தொழுது வைத்தேன் ஒல்லை விதிக்கிற்றியே"],0,"/media/recitation/NAT.1.4.mp3"],[508,508,["vAniDai vAzhum avvAnavarkku *","maRaiyavar vELviyil vaguththa avi *","kAniDaith thirivadhOr nari pugundhu *","kaDappadhum mOppadhum seyvadhu oppa **","UniDai Azhi sanggu uththamarkku enRu *","unniththu ezhundha en thaDamulaigaL *","mAniDavarkku enRu pEchchuppaDil *","vAzhakillEn kaNDAy manmadhanE!"],["வானிடை வாழும் அவ்வானவர்க்கு *","மறையவர் வேள்வியில் வகுத்த அவி *","கானிடைத் திரிவதோர் நரி புகுந்து *","கடப்பதும் மோப்பதும் செய்வது ஒப்ப **","ஊனிடை ஆழி சங்கு உத்தமர்க்கு என்று *","உன்னித்து எழுந்த என் தடமுலைகள் *","மானிடவர்க்கு என்று பேச்சுப்படில் *","வாழகில்லேன் கண்டாய் மன்மதனே!"],0,"/media/recitation/NAT.1.5.mp3"],[509,509,["uruvuDaiyAr iLaiyArgaL nallAr *","Oththu vallArgaLaik koNDu * vaigal","theruviDai edhir koNDu pangguni nAL *","thirundhavE nORkinREn kAma dhEvA! **","karuvuDai mugilvaNNan kAyAvaNNan *","karuviLai pOl vaNNan kamala vaNNath *","thiruvuDai mugaththinil thirukkaNgaLAl *","thirundhavE nOkkenakkaruL kaNDAy"],["உருவுடையார் இளையார்கள் நல்லார் *","ஓத்து வல்லார்களைக் கொண்டு * வைகல்","தெருவிடை எதிர் கொண்டு பங்குனி நாள் *","திருந்தவே நோற்கின்றேன் காம தேவா! **","கருவுடை முகில்வண்ணன் காயாவண்ணன் *","கருவிளை போல் வண்ணன் கமல வண்ணத் *","திருவுடை முகத்தினில் திருக்கண்களால் *","திருந்தவே நோக்கெனக்கருள் கண்டாய்"],0,"/media/recitation/NAT.1.6.mp3"],[510,510,["kAyuDai nelloDu karumbamaiththuk *","kaTTi arisi aval amaiththu *","vAyuDai maRaiyavar mandhiraththAl *","manmadhanE! unnai vaNangguginREn **","thEsa mun aLandhavan thirivikkiraman *","thirukkaigaLAl ennaith thINDum vaNNam *","sAyuDai vayiRum en thaDamulaiyum *","tharaNiyil thalaippugazh tharak kiRRiyE"],["காயுடை நெல்லொடு கரும்பமைத்துக் *","கட்டி அரிசி அவல் அமைத்து *","வாயுடை மறையவர் மந்திரத்தால் *","மன்மதனே! உன்னை வணங்குகின்றேன் **","தேச முன் அளந்தவன் திரிவிக்கிரமன் *","திருக்கைகளால் என்னைத் தீண்டும் வண்ணம் *","சாயுடை வயிறும் என் தடமுலையும் *","தரணியில் தலைப்புகழ் தரக் கிற்றியே"],0,"/media/recitation/NAT.1.7.mp3"],[511,511,["mAsuDai uDamboDu thalai ulaRi *","vAyppuRam veLuththu oru pOdhum uNDu *","thEsuDaith thiRal uDaik kAma dhEvA! *","nORkinRa nOnbinaik kuRikkoL kaNDAy **","pEsuvadhu onRuNDu inggu emperumAn! *","peNmaiyaith thalaiyuDaiththu Akkum vaNNam *","kEsava nambiyaik kAl piDippAL","ennum * ippERu enakkaruL kaNDAy"],["மாசுடை உடம்பொடு தலை உலறி *","வாய்ப்புறம் வெளுத்து ஒரு போதும் உண்டு *","தேசுடைத் திறலுடைக் காம தேவா! *","நோற்கின்ற நோன்பினைக் குறிக்கொள் கண்டாய் **","பேசுவது ஒன்றுண்டு இங்கு எம்பெருமான்! *","பெண்மையைத் தலையுடைத்து ஆக்கும் வண்ணம் *","கேசவ நம்பியைக் கால் பிடிப்பாள்","என்னும் * இப்பேறு எனக்கருள் கண்டாய்"],0,"/media/recitation/NAT.1.8.mp3"],[512,512,["tŏḻutu muppotum uṉ aṭi vaṇaṅkit *","tūmalar tūyt tŏḻutu ettukiṉṟeṉ *","paḻutu iṉṟip pāṟkaṭal vaṇṇaṉukke *","paṇicĕytu vāḻap pĕṟāviṭil nāṉ **","aḻutu aḻutu alamantu ammā vaḻaṅka *","āṟṟavum atu uṉakku uṟaikkum kaṇṭāy *","uḻuvator ĕruttiṉai nukaṅkŏṭu pāyntu *","ūṭṭam iṉṟit turantāl ŏkkume"],["தொழுது முப்போதும் உன் அடி வணங்கித் *","தூமலர் தூய்த் தொழுது ஏத்துகின்றேன் *","பழுது இன்றிப் பாற்கடல் வண்ணனுக்கே *","பணிசெய்து வாழப் பெறாவிடில் நான் **","அழுது அழுது அலமந்து அம்மா வழங்க *","ஆற்றவும் அது உனக்கு உறைக்கும் கண்டாய் *","உழுவதோர் எருத்தினை நுகங்கொடு பாய்ந்து *","ஊட்டம் இன்றித் துரந்தால் ஒக்குமே"],1,"/media/recitation/NAT.1.9.mp3"],[513,513,["** karuppu vil malark kaNaik kAma vELaik *","kazhaliNai paNindhu anggOr kari alaRa *","maruppinai osiththup puL vAy piLandha *","maNivaNNaRku ennai vaguththiDu enRu **","poruppanna mADam polindhu thOnRum *","pudhuvaiyar kOn viTTuchiththan kOdhai *","viruppuDai inthamizh mAlai vallAr *","viNNavar kOn aDi naNNuvarE"],["** கருப்பு வில் மலர்க் கணைக் காம வேளைக் *","கழலிணை பணிந்து அங்கோர் கரி அலற *","மருப்பினை ஒசித்துப் புள் வாய் பிளந்த *","மணிவண்ணற்கு என்னை வகுத்திடு என்று **","பொருப்பன்ன மாடம் பொலிந்து தோன்றும் *","புதுவையர் கோன் விட்டுசித்தன் கோதை *","விருப்புடை இன்தமிழ் மாலை வல்லார் *","விண்ணவர் கோன் அடி நண்ணுவரே"],0,"/media/recitation/NAT.1.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","01 thaiyoru thingaLum [504-513] .mp3",504,513]},{"he":["iraNDAm thirumozhi - nAmamAyiram","iDaip peNgaL siRRil sidhaikka vENDA enRu kaNNanai vENDudhal"],"ht":["இரண்டாம் திருமொழி - நாமமாயிரம்","இடைப் பெண்கள் சிற்றில் சிதைக்க வேண்டா என்று கண்ணனை வேண்டுதல்"],"ae":"aDivaravu: nAmam kuNDu peyyum veLLai muRRilAdha pEdham vaTTam muRRaththUDu sIdhai kOzhi","at":"அடிவரவு: நாமம் குண்டு பெய்யும் வெள்ளை முற்றிலாத பேதம் வட்டம் முற்றத்தூடு சீதை கோழி","p":[[514,514,["** nAmam Ayiram Eththa ninRa * nArAyaNA! naranE! * unnai","mAmi than maganAgap peRRAl * emakku vAdhai thavirumE **","kAman pOdharu kAlam enRu * pangguni nAL kaDai pAriththOm *","thImai seyyum sirIdharA! * enggaL siRRil vandhu sidhaiyElE"],["** நாமம் ஆயிரம் ஏத்த நின்ற * நாராயணா! நரனே! * உன்னை","மாமி தன் மகனாகப் பெற்றால் * எமக்கு வாதை தவிருமே **","காமன் போதரு காலம் என்று * பங்குனி நாள் கடை பாரித்தோம் *","தீமை செய்யும் சிரீதரா! * எங்கள் சிற்றில் வந்து சிதையேலே"],0,"/media/recitation/NAT.2.1.mp3"],[515,515,["iṉṟu muṟṟum mutuku nova * iruntu izhaitta icciṟṟilai *","naṉṟum kaṇ uṟa nokki * nām kŏl̤um ārvantaṉṉait taṇikiṭāy **","aṉṟu pālakaṉ āki * ālilai mel tuyiṉṟa ĕm ātiyāy ! *","ĕṉṟum uṉ taṉakku ĕṅkal̤ mel * irakkam ĕzhātatu ĕm pāvame"],["இன்று முற்றும் முதுகு நோவ * இருந்து இழைத்த இச்சிற்றிலை *","நன்றும் கண் உற நோக்கி * நாம் கொளும் ஆர்வந்தன்னைத் தணிகிடாய் **","அன்று பாலகன் ஆகி * ஆலிலை மேல் துயின்ற எம் ஆதியாய் ! *","என்றும் உன் தனக்கு எங்கள் மேல் * இரக்கம் எழாதது எம் பாவமே"],1,"/media/recitation/NAT.2.2.mp3"],[516,516,["kuNDu nIr uRai kOLarI! * madha yAnai kOL viDuththAy * unnaik","kaNDu mAl uRuvOnggaLaik * kaDaikkaNgaLAl iTTu vAdhiyEl **","vaNDal nuNmaNal theLLi * yAm vaLaik kaigaLAl siramappaTTOm *","theNthiraik kaDaR paLLiyAy! * enggaL siRRil vandhu sidhaiyElE"],["குண்டு நீர் உறை கோளரீ! * மத யானை கோள் விடுத்தாய் * உன்னைக்","கண்டு மால் உறுவோங்களைக் * கடைக்கண்களால் இட்டு வாதியேல் **","வண்டல் நுண்மணல் தெள்ளி * யாம் வளைக் கைகளால் சிரமப்பட்டோம் *","தெண்திரைக் கடற் பள்ளியாய்! * எங்கள் சிற்றில் வந்து சிதையேலே"],0,"/media/recitation/NAT.2.3.mp3"],[517,517,["peyyu mAmugil pOl vaNNA! * undhan pEchchum seygaiyum * enggaLai","maiyal ERRi mayakka * un mugam mAya mandhiram thAn kolO? **","noyyar piLLaigaL enbadhaRku * unnai nOva nAnggaL uraikkilOm *","seyya thAmaraik kaNNinAy! * enggaL siRRil vandhu sidhaiyElE"],["பெய்யு மாமுகில் போல் வண்ணா! * உன்தன் பேச்சும் செய்கையும் * எங்களை","மையல் ஏற்றி மயக்க * உன் முகம் மாய மந்திரம் தான் கொலோ? **","நொய்யர் பிள்ளைகள் என்பதற்கு * உன்னை நோவ நாங்கள் உரைக்கிலோம் *","செய்ய தாமரைக் கண்ணினாய்! * எங்கள் சிற்றில் வந்து சிதையேலே"],0,"/media/recitation/NAT.2.4.mp3"],[518,518,["veLLai nuNmaNaR koNDu * siRRil vichiththirappaDa * vIdhi vAyth","theLLi nAnggaL izhaiththa kOlam * azhiththi Agilum undhan mEl **","uLLam ODi urugal allAl * urODam onRum ilOm kaNDAy *","kaLLa mAdhavA! kEsavA! * un mugaththana kaNgaL allavE"],["வெள்ளை நுண்மணற் கொண்டு * சிற்றில் விசித்திரப்பட * வீதி வாய்த்","தெள்ளி நாங்கள் இழைத்த கோலம் * அழித்தி ஆகிலும் உன்தன் மேல் **","உள்ளம் ஓடி உருகல் அல்லால் * உரோடம் ஒன்றும் இலோம் கண்டாய் *","கள்ள மாதவா! கேசவா! * உன் முகத்தன கண்கள் அல்லவே"],0,"/media/recitation/NAT.2.5.mp3"],[519,519,["muRRilAdha piLLaigaLOm * mulai pOndhilAdhOmai * nAL thoRum","siRRil mEl iTTuk koNDu * nI siRidhuNDu thiNNena nAm adhu","kaRRilOm ** kaDalai aDaiththu arakkar kulanggaLai * muRRavum","seRRu * ilanggaiyaip pUsal Akkiya sEvagA! * emmai vAdhiyEl"],["முற்றிலாத பிள்ளைகளோம் * முலை போந்திலாதோமை * நாள் தொறும்","சிற்றில் மேல் இட்டுக் கொண்டு * நீ சிறிதுண்டு திண்ணென நாம் அது","கற்றிலோம் ** கடலை அடைத்து அரக்கர் குலங்களை * முற்றவும்","செற்று * இலங்கையைப் பூசல் ஆக்கிய சேவகா! * எம்மை வாதியேல்"],0,"/media/recitation/NAT.2.6.mp3"],[520,520,["pEdham nanku aRivArgaLODu * ivai pEsinAl peridhu insuvai *","yAdhum onRu aRiyAdha piLLaigaLOmai * nI nalindhu en payan? **","Odha mAkaDal vaNNA! * un maNavATTimAroDu sUzhaRum *","sEdhu bandham thiruththinAy! * enggaL siRRil vandhu sidhaiyElE"],["பேதம் நன்கு அறிவார்களோடு * இவை பேசினால் பெரிது இன்சுவை *","யாதும் ஒன்று அறியாத பிள்ளைகளோமை * நீ நலிந்து என் பயன்? **","ஓத மாகடல் வண்ணா! * உன் மணவாட்டிமாரொடு சூழறும் *","சேது பந்தம் திருத்தினாய்! * எங்கள் சிற்றில் வந்து சிதையேலே"],0,"/media/recitation/NAT.2.7.mp3"],[521,521,["vaTTa vAych siRu thUdhaiyODu * siRu suLagum maNalum koNDu *","iTTamA viLaiyADuvOnggaLaich * siRRil IDazhiththu en payan? **","thoTTudhaiththu naliyEl kaNDAy * suDarch chakkaram kaiyil EndhinAy! *","kaTTiyum kaiththAl innAmai * aRidhiyE kaDal vaNNanE!"],["வட்ட வாய்ச் சிறு தூதையோடு * சிறு சுளகும் மணலும் கொண்டு *","இட்டமா விளையாடுவோங்களைச் * சிற்றில் ஈடழித்து என் பயன்? **","தொட்டுதைத்து நலியேல் கண்டாய் * சுடர்ச் சக்கரம் கையில் ஏந்தினாய்! *","கட்டியும் கைத்தால் இன்னாமை * அறிதியே கடல் வண்ணனே!"],0,"/media/recitation/NAT.2.8.mp3"],[522,522,["muRRaththUDu pugundhu * nin mugam kATTip punmuRuval seydhu *","siRRilODu enggaL sindhaiyum * sidhaikkak kaDavaiyO? gOvindhA! **","muRRa maNNiDam thAvi * viNNuRa nINDu aLandhu koNDAy! * emmaip","paRRi meyppiNakkiTTakkAl * indhap pakkam ninRavar en sollAr?"],["முற்றத்தூடு புகுந்து * நின் முகம் காட்டிப் புன்முறுவல் செய்து *","சிற்றிலோடு எங்கள் சிந்தையும் * சிதைக்கக் கடவையோ? கோவிந்தா! **","முற்ற மண்ணிடம் தாவி * விண்ணுற நீண்டு அளந்து கொண்டாய்! * எம்மைப்","பற்றி மெய்ப்பிணக்கிட்டக்கால் * இந்தப் பக்கம் நின்றவர் என் சொல்லார்?"],0,"/media/recitation/NAT.2.9.mp3"],[523,523,["** sIdhai vAy amudham uNDAy! * enggaL siRRil nI sidhaiyEl enRu *","vIdhi vAy viLaiyADum * Ayar siRumiyar mazhalaich chollai **","vEdha vAyth thozhilArgaL vAzh * villipuththUr man viTTuchiththan than *","kOdhai vAyth thamizh vallavar * kuRaivinRi vaikuntham sErvarE"],["** சீதை வாய் அமுதம் உண்டாய்! * எங்கள் சிற்றில் நீ சிதையேல் என்று *","வீதி வாய் விளையாடும் * ஆயர் சிறுமியர் மழலைச் சொல்லை **","வேத வாய்த் தொழிலார்கள் வாழ் * வில்லிபுத்தூர் மன் விட்டுசித்தன் தன் *","கோதை வாய்த் தமிழ் வல்லவர் * குறைவின்றி வைகுந்தம் சேர்வரே"],0,"/media/recitation/NAT.2.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","02 nAmamAyiram [514-523].mp3",514,523]},{"he":["mUnRAm thirumozhi - kOzhi azhaippadhan","kaNNan kavarndha kURaigaLaik kanniyar iraththal"],"ht":["மூன்றாம் திருமொழி - கோழி அழைப்பதன்","கண்ணன் கவர்ந்த கூறைகளைக் கன்னியர் இரத்தல்"],"ae":"aDivaravu: kOzhi idhu ellE parakka kAlai thaDaththu nIril mAmimAr kanjchan kanniyarODu theLLiyAr","at":"அடிவரவு: கோழி இது எல்லே பரக்க காலை தடத்து நீரில் மாமிமார் கஞ்சன் கன்னியரோடு தெள்ளியார்","p":[[524,524,["kozhi azhaippataṉ muṉṉam * kuṭaintu nīrāṭuvāṉ pontom *","āzhiyañ cĕlvaṉ ĕzhuntāṉ * aravu-aṇaimel pal̤l̤i kŏṇṭāy **","ezhaimai āṟṟavum paṭṭom * iṉi ĕṉṟum pŏykaikku vārom *","tozhiyum nāṉum tŏzhutom * tukilaip paṇittarul̤āye"],["கோழி அழைப்பதன் முன்னம் * குடைந்து நீராடுவான் போந்தோம் *","ஆழியஞ் செல்வன் எழுந்தான் * அரவு அணைமேல் பள்ளி கொண்டாய் **","ஏழைமை ஆற்றவும் பட்டோம் * இனி என்றும் பொய்கைக்கு வாரோம் *","தோழியும் நானும் தொழுதோம் * துகிலைப் பணித்தருளாயே"],1,"/media/recitation/NAT.3.1.mp3"],[525,525,["itu ĕṉ pukuntatu iṅku? anto! * ip pŏykaikku ĕvvāṟu vantāy? *","matuviṉ tuzhāy muṭi māle! * māyaṉe ĕṅkal̤ amute *","viti iṉmaiyāl atu māṭṭom * vittakap pil̤l̤āy! viraiyel *","kutikŏṇṭu aravil naṭittāy * kuruntiṭaik kūṟai paṇiyāy"],["இது என் புகுந்தது இங்கு? அந்தோ! * இப் பொய்கைக்கு எவ்வாறு வந்தாய்? *","மதுவின் துழாய் முடி மாலே! * மாயனே எங்கள் அமுதே *","விதி இன்மையால் அது மாட்டோம் * வித்தகப் பிள்ளாய்! விரையேல் *","குதிகொண்டு அரவில் நடித்தாய் * குருந்திடைக் கூறை பணியாய்"],1,"/media/recitation/NAT.3.2.mp3"],[526,526,["ellE! Idhenna iLamai? * emmanaimAr kANil oTTAr *","pollAnggu IdhenRu karudhAy * pUngkurundhu ERi iruththi **","villAl ilanggai azhiththAy! * nI vENDiyadhu ellAm tharuvOm *","pallArum kANAmE pOvOm * paTTaip paNiththu aruLAyE"],["எல்லே! ஈதென்ன இளமை? * எம்மனைமார் காணில் ஒட்டார் *","பொல்லாங்கு ஈதென்று கருதாய் * பூங்குருந்து ஏறி இருத்தி **","வில்லால் இலங்கை அழித்தாய்! * நீ வேண்டியது எல்லாம் தருவோம் *","பல்லாரும் காணாமே போவோம் * பட்டைப் பணித்து அருளாயே"],0,"/media/recitation/NAT.3.3.mp3"],[527,527,["parakka vizhiththu enggum nOkkip * palar kuDaindhADum sunaiyil *","arakka nillA kaNNa nIrgaL * alamaruginRavA pArAy **","irakkamEl onRum ilAdhAy! * ilanggai azhiththa pirAnE! *","kurakkarasu Avadhu aRindhOm * kurundhiDaik kURai paNiyAy"],["பரக்க விழித்து எங்கும் நோக்கிப் * பலர் குடைந்தாடும் சுனையில் *","அரக்க நில்லா கண்ண நீர்கள் * அலமருகின்றவா பாராய் **","இரக்கமேல் ஒன்றும் இலாதாய்! * இலங்கை அழித்த பிரானே! *","குரக்கரசு ஆவது அறிந்தோம் * குருந்திடைக் கூறை பணியாய்"],0,"/media/recitation/NAT.3.4.mp3"],[528,528,["kAlaik kadhu viDuginRa * kayaloDu vALai viravi *","vElaip piDiththu ennaimArgaL OTTil * enna viLaiyATTO? **","kOlach chiRRADai palavum koNDu * nI ERi irAdhE *","kOlam kariya pirAnE! * kurundhiDaik kURai paNiyAy"],["காலைக் கது விடுகின்ற * கயலொடு வாளை விரவி *","வேலைப் பிடித்து என்னைமார்கள் ஓட்டில் * என்ன விளையாட்டோ? **","கோலச் சிற்றாடை பலவும் கொண்டு * நீ ஏறி இராதே *","கோலம் கரிய பிரானே! * குருந்திடைக் கூறை பணியாய்"],0,"/media/recitation/NAT.3.5.mp3"],[529,529,["thaDaththavizh thAmaraip poygaith * thALgaL em kAlaik kadhuva *","viDath thEL eRindhAlE pOla * vEdhanai ARRavum paTTOm **","kuDaththai eDuththERa viTTuk * kUththADa valla em kOvE! *","paDiRRai ellAm thavirndhu * enggaL paTTaip paNiththu aruLAyE"],["தடத்தவிழ் தாமரைப் பொய்கைத் * தாள்கள் எம் காலைக் கதுவ *","விடத் தேள் எறிந்தாலே போல * வேதனை ஆற்றவும் பட்டோம் **","குடத்தை எடுத்தேற விட்டுக் * கூத்தாட வல்ல எம் கோவே! *","படிற்றை எல்லாம் தவிர்ந்து * எங்கள் பட்டைப் பணித்தருளாயே"],0,"/media/recitation/NAT.3.6.mp3"],[530,530,["nIrilE ninRu ayarkkinROm * nIdhi allAdhana seydhAy *","Ur agam sAlavum sEyththAl * Uzhi ellAm uNarvAnE! **","Arvam unakkE uDaiyOm * ammanaimAr kANil oTTAr *","pOra viDAy enggaL paTTaip * pUngkurundhu ERi irAdhE"],["நீரிலே நின்று அயர்க்கின்றோம் * நீதி அல்லாதன செய்தாய் *","ஊர் அகம் சாலவும் சேய்த்தால் * ஊழி எல்லாம் உணர்வானே! **","ஆர்வம் உனக்கே உடையோம் * அம்மனைமார் காணில் ஒட்டார் *","போர விடாய் எங்கள் பட்டைப் * பூங்குருந்து ஏறி இராதே"],0,"/media/recitation/NAT.3.7.mp3"],[531,531,["mAmimAr makkaLE allOm * maRRum inggu ellArum pOndhAr *","thUmalark kaNgaL vaLarath * thollai irAth thuyilvAnE! **","sEmamEl anRidhu sAlach * chikkena nAm idhu sonnOm *","kOmaLa Ayar kozhundhE! * kurundhiDaik kURai paNiyAy"],["மாமிமார் மக்களே அல்லோம் * மற்றும் இங்கு எல்லாரும் போந்தார் *","தூமலர்க் கண்கள் வளரத் * தொல்லை இராத் துயில்வானே! **","சேமமேல் அன்றிது சாலச் * சிக்கென நாம் இது சொன்னோம் *","கோமள ஆயர் கொழுந்தே! * குருந்திடைக் கூறை பணியாய்"],0,"/media/recitation/NAT.3.8.mp3"],[532,532,["kanjchan valai vaiththa anRu * kAr iruL ellil pizhaiththu *","nenjchu dhukkam seyyap pOndhAy * ninRa ikkanniyarOmai **","anjcha urappAL asOdhai * ANADa viTTiTTu irukkum *","vanjchagap pEychchi pAl uNDa * masimai ilI! kURai thArAy"],["கஞ்சன் வலை வைத்த அன்று * கார் இருள் எல்லில் பிழைத்து *","நெஞ்சு துக்கம் செய்யப் போந்தாய் * நின்ற இக்கன்னியரோமை **","அஞ்ச உரப்பாள் அசோதை * ஆணாட விட்டிட்டு இருக்கும் *","வஞ்சகப் பேய்ச்சி பால் உண்ட * மசிமை இலீ! கூறை தாராய்"],0,"/media/recitation/NAT.3.9.mp3"],[533,533,["** kanniyarODu enggaL nambi * kariya pirAn viLaiyATTai *","ponniyal mADanggaL sUzhndha * pudhuvaiyar kOn paTTan kOdhai **","innisaiyAl sonna mAlai * Iraindhum vallavar thAm pOy *","manniya mAdhavanODu * vaikuntham pukkiruppArE"],["** கன்னியரோடு எங்கள் நம்பி * கரிய பிரான் விளையாட்டை *","பொன்னியல் மாடங்கள் சூழ்ந்த * புதுவையர் கோன் பட்டன் கோதை **","இன்னிசையால் சொன்ன மாலை * ஈரைந்தும் வல்லவர் தாம் போய் *","மன்னிய மாதவனோடு * வைகுந்தம் புக்கிருப்பாரே"],0,"/media/recitation/NAT.3.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","03 kOzhi azhaippathan munnam [524-533] .mp3",524,533]},{"he":["nAnkAm thirumozhi - theLLiyAr palar","kUDal izhaiththal"],"ht":["நான்காம் திருமொழி - தெள்ளியார் பலர்","கூடல் இழைத்தல்"],"ae":"aDivaravu: theLLiyAr kATTil pUmagan AychchimArgaL mADam aRRavan anRu Aval koNDa pazhagu UDal mannu","at":"அடிவரவு: தெள்ளியார் காட்டில் பூமகன் ஆய்ச்சிமார்கள் மாடம் அற்றவன் அன்று ஆவல் கொண்ட பழகு ஊடல் மன்னு","p":[[534,534,["** theLLiyAr * palar kai thozhum dhEvanAr *","vaLLal * mAlirunjchOlai maNALanAr **","paLLi koLLum iDaththu * aDi koTTiDa *","koLLum Agil * nI kUDiDu kUDalE!"],["** தெள்ளியார் * பலர் கை தொழும் தேவனார் *","வள்ளல் * மாலிருஞ்சோலை மணாளனார் **","பள்ளி கொள்ளும் இடத்து * அடி கொட்டிட *","கொள்ளும் ஆகில் * நீ கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.1.mp3"],[535,535,["** kATTil vEngkaDam * kaNNapura nagar *","vATTam inRi * magizhndhuRai vAmanan **","OTTarA vandhu * en kaip paRRi * thannoDum","kUTTumAgil * nI kUDiDu kUDalE!"],["** காட்டில் வேங்கடம் * கண்ணபுர நகர் *","வாட்டம் இன்றி * மகிழ்ந்துறை வாமனன் **","ஓட்டரா வந்து * என் கைப் பற்றி * தன்னொடும்","கூட்டுமாகில் * நீ கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.2.mp3"],[536,536,["pUmagan pugazh vAnavar * pORRudhaRku","Amagan * aNi vANudhal * dhEvaki","mAmagan ** migu sIr * vasudhEvar tham *","kOmagan varil * kUDiDu kUDalE!"],["பூமகன் புகழ் வானவர் * போற்றுதற்கு","ஆமகன் * அணி வாணுதல் * தேவகி","மாமகன் ** மிகு சீர் * வசுதேவர் தம் *","கோமகன் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.3.mp3"],[537,537,["AychchimArgaLum * Ayarum anjchiDa *","pUththa nIL * kaDambu ERip pugap pAyndhu **","vAyththa kALiyan mEl * naDam ADiya *","kUththanAr varil * kUDiDu kUDalE!"],["ஆய்ச்சிமார்களும் * ஆயரும் அஞ்சிட *","பூத்த நீள் * கடம்பு ஏறிப் புகப் பாய்ந்து **","வாய்த்த காளியன் மேல் * நடம் ஆடிய *","கூத்தனார் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.4.mp3"],[538,538,["mADa mALigai sUzh * madhuraip padhi","nADi * nam theruvin * naDuvE vandhiTTu **","ODai mA * madha yAnai udhaiththavan *","kUDum Agil * nI kUDiDu kUDalE!"],["மாட மாளிகை சூழ் * மதுரைப் பதி","நாடி * நம் தெருவின் * நடுவே வந்திட்டு **","ஓடை மா * மத யானை உதைத்தவன் *","கூடும் ஆகில் * நீ கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.5.mp3"],[539,539,["aṟṟavaṉ * marutam muṟiya naṭai","kaṟṟavaṉ * kañcaṉai * vañcaṉaiyiṟ","cĕṟṟavaṉ ** tikazhum maturaip pati *","kŏṟṟavaṉ varil * kūṭiṭu kūṭale"],["அற்றவன் * மருதம் முறிய நடை","கற்றவன் * கஞ்சனை * வஞ்சனையிற்","செற்றவன் ** திகழும் மதுரைப் பதி *","கொற்றவன் வரில் * கூடிடு கூடலே"],1,"/media/recitation/NAT.4.6.mp3"],[540,540,["anRu innAdhana sey * sisupAlanum *","ninRa nIL marudhum * erudhum puLLum **","venRi vEl * viRal kanjchanum vIzha * mun","konRavan varil * kUDiDu kUDalE!"],["அன்றின்னாதன செய் * சிசுபாலனும் *","நின்ற நீள் மருதும் * எருதும் புள்ளும் **","வென்றி வேல் * விறல் கஞ்சனும் வீழ * முன்","கொன்றவன் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.7.mp3"],[541,541,["Aval anbuDaiyAr tham * manaththanRi","mEvalan * virai sUzh * thuvarApadhik","kAvalan ** kanRu mEyththu viLaiyADum *","kOvalan varil * kUDiDu kUDalE!"],["ஆவல் அன்புடையார் தம் * மனத்தன்றி","மேவலன் * விரை சூழ் * துவராபதிக்","காவலன் ** கன்று மேய்த்து விளையாடும் *","கோவலன் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.8.mp3"],[542,542,["koNDa kOlak * kuRaL uruvAych senRu *","paNDu mAvali than * peru vELviyil **","aNDamum nilanum * aDi onRinAl *","koNDavan varil * kUDiDu kUDalE!"],["கொண்ட கோலக் * குறள் உருவாய்ச் சென்று *","பண்டு மாவலி தன் * பெரு வேள்வியில் **","அண்டமும் நிலனும் * அடி ஒன்றினால் *","கொண்டவன் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.9.mp3"],[543,543,["pazhagu nAnmaRaiyin poruLAy * madham","ozhugu vAraNam * uyya aLiththa ** em","azhaganAr * aNi Aychchiyar sindhaiyuL *","kuzhaganAr varil * kUDiDu kUDalE!"],["பழகு நான்மறையின் பொருளாய் * மதம்","ஒழுகு வாரணம் * உய்ய அளித்த ** எம்","அழகனார் * அணி ஆய்ச்சியர் சிந்தையுள் *","குழகனார் வரில் * கூடிடு கூடலே!"],0,"/media/recitation/NAT.4.10.mp3"],[544,544,["** UDal kUDal * uNardhal puNardhalai *","nIDu ninRa * niRai pugazh Aychchiyar **","kUDalaik * kuzhaR kOdhai mun kURiya *","pADal paththum vallArkku * illai pAvamE"],["** ஊடல் கூடல் * உணர்தல் புணர்தலை *","நீடு நின்ற * நிறை புகழ் ஆய்ச்சியர் **","கூடலைக் * குழற் கோதை முன் கூறிய *","பாடல் பத்தும் வல்லார்க்கு * இல்லை பாவமே"],0,"/media/recitation/NAT.4.11.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","04 theLLiyAr palar [534-544].mp3",534,544]},{"he":["aindhAm thirumozhi - mannu perumpugazh","emperumAnaik kUvi azhaikkumpaDi kuyilai vENDudhal"],"ht":["ஐந்தாம் திருமொழி - மன்னு பெரும்புகழ்","எம்பெருமானைக் கூவி அழைக்கும்படி குயிலை வேண்டுதல்"],"ae":"aDivaravu: mannu veLLai mAthali enbu mennaDai eththisai ponggiya sArnggam paingkiLi anRu viN vAraNam","at":"அடிவரவு: மன்னு வெள்ளை மாதலி என்பு மென்னடை எத்திசை பொங்கிய ஸார்ங்கம் பைங்கிளி அன்று விண் வாரணம்","p":[[545,545,["** mannu perumpugazh mAdhavan * mAmaNi","vaNNan maNimuDi maindhan","thannai * ugandhadhu kAraNamAga * en","sanggu izhakkum vazhakku uNDE? **","punnai kurukkaththi njAzhal serundhip *","podhumbinil vAzhum kuyilE! *","panni eppOdhum irundhu viraindhu * en","pavaLavAyan varak kUvAy"],["** மன்னு பெரும்புகழ் மாதவன் * மாமணி","வண்ணன் மணிமுடி மைந்தன்","தன்னை * உகந்தது காரணமாக * என்","சங்கு இழக்கும் வழக்கு உண்டே? **","புன்னை குருக்கத்தி ஞாழல் செருந்திப் *","பொதும்பினில் வாழும் குயிலே! *","பன்னி எப்போதும் இருந்து விரைந்து * என்","பவளவாயன் வரக் கூவாய்"],0,"/media/recitation/NAT.5.1.mp3"],[546,546,["veLLai viLi sanggu iDangkaiyil koNDa *","vimalan enakku uruk kATTAn *","uLLam pugundhu ennai naiviththu * nALum","uyirppeydhu kUththATTuk kANum **","kaLLavizh seNbagap pUmalar kOdhik *","kaLiththu isai pADum kuyilE! *","meLLa irundhu mizhaRRi mizhaRRAdhu * en","vEngkaDavan varak kUvAy"],["வெள்ளை விளி சங்கு இடங்கையில் கொண்ட *","விமலன் எனக்கு உருக் காட்டான் *","உள்ளம் புகுந்து என்னை நைவித்து * நாளும்","உயிர்ப்பெய்து கூத்தாட்டுக் காணும் **","கள்ளவிழ் செண்பகப் பூமலர் கோதிக் *","களித்து இசை பாடும் குயிலே! *","மெள்ள இருந்து மிழற்றி மிழற்றாது * என்","வேங்கடவன் வரக் கூவாய்"],0,"/media/recitation/NAT.5.2.mp3"],[547,547,["mAthali thEr munbu kOl koLLa * mAyan","irAvaNan mEl * saramAri","thAythalai aRRaRRu vIzhath * thoDuththa","thalaivan vara enggum kANEn **","pOdhalar kAvil pudhu maNam nARap *","poRi vaNDin kAmaram kETTu * un","kAdhaliyODu uDan vAzh kuyilE! * en","karumANikkam varak kUvAy"],["மாதலி தேர் முன்பு கோல் கொள்ள * மாயன்","இராவணன் மேல் * சரமாரி","தாய்தலை அற்றற்று வீழத் * தொடுத்த","தலைவன் வர எங்கும் காணேன் **","போதலர் காவில் புது மணம் நாறப் *","பொறி வண்டின் காமரம் கேட்டு * உன்","காதலியோடு உடன் வாழ் குயிலே! * என்","கருமாணிக்கம் வரக் கூவாய்"],0,"/media/recitation/NAT.5.3.mp3"],[548,548,["enbu urugi inavEl neDungkaNgaL *","imai porundhA pala nALum *","thunbak kaDal pukku vaikunthan enbadhOr *","thONi peRAdhu uzhalginREn **","anbuDaiyAraip pirivuRu nOy * adhu","nIyum aRidhi kuyilE! *","ponpurai mEnik karuLak koDiyuDaip *","puNNiyanai varak kUvAy"],["என்பு உருகி இனவேல் நெடுங்கண்கள் *","இமை பொருந்தா பல நாளும் *","துன்பக் கடல் புக்கு வைகுந்தன் என்பதோர் *","தோணி பெறாது உழல்கின்றேன் **","அன்புடையாரைப் பிரிவுறு நோய் * அது","நீயும் அறிதி குயிலே! *","பொன்புரை மேனிக் கருளக் கொடியுடைப் *","புண்ணியனை வரக் கூவாய்"],0,"/media/recitation/NAT.5.4.mp3"],[549,549,["** mennaDai annam parandhu viLaiyADum *","villipuththUr uRaivAn than *","ponnaDi kANbadhOr AsaiyinAl * en","porukayaR kaNNiNai thunjchA **","innaDisiloDu pAl amudhu UTTi *","eDuththa en kOlak kiLiyai *","unnoDu thOzhamai koLLuvan kuyilE! *","ulagaLandhAn varak kUvAy"],["** மென்னடை அன்னம் பரந்து விளையாடும் *","வில்லிபுத்தூர் உறைவான் தன் *","பொன்னடி காண்பதோர் ஆசையினால் * என்","பொருகயற் கண்ணிணை துஞ்சா **","இன்னடிசிலொடு பால் அமுது ஊட்டி *","எடுத்த என் கோலக் கிளியை *","உன்னொடு தோழமை கொள்ளுவன் குயிலே! *","உலகளந்தான் வரக் கூவாய்"],0,"/media/recitation/NAT.5.5.mp3"],[550,550,["eththisaiyum amarar paNindhu Eththum *","iruDIkEsan vali seyya *","muththanna veNmuRuval seyya vAyum *","mulaiyum azhagu azhindhEn nAn **","koththalar kAvil maNiththaDam * kaNpaDai","koLLum iLangkuyilE! * en","thaththuvanai varak kUgiRRi Agil *","thalai allAl kaimmARilEnE"],["எத்திசையும் அமரர் பணிந்து ஏத்தும் *","இருடீகேசன் வலி செய்ய *","முத்தன்ன வெண்முறுவல் செய்ய வாயும் *","முலையும் அழகு அழிந்தேன் நான் **","கொத்தலர் காவில் மணித்தடம் * கண்படை","கொள்ளும் இளங்குயிலே! * என்","தத்துவனை வரக் கூகிற்றி ஆகில் *","தலை அல்லால் கைம்மாறிலேனே"],0,"/media/recitation/NAT.5.6.mp3"],[551,551,["ponggiya pARkaDal paLLi koLvAnaip *","puNarvadhOr AsaiyinAl * en","konggai kiLarndhu kumaiththuk kuthugaliththu *","Aviyai Agulam seyyum","angkuyilE! ** unakku enna maRaindhu uRaivu? *","Azhiyum sanggum oNthaNDum *","thanggiya kaiyavanai varak kUvil nI *","sAlath tharumam peRudhi"],["பொங்கிய பாற்கடல் பள்ளி கொள்வானைப் *","புணர்வதோர் ஆசையினால் * என்","கொங்கை கிளர்ந்து குமைத்துக் குதுகலித்து *","ஆவியை ஆகுலம் செய்யும்","அங்குயிலே! ** உனக்கு என்ன மறைந்து உறைவு? *","ஆழியும் சங்கும் ஒண்தண்டும் *","தங்கிய கையவனை வரக் கூவில் நீ *","சாலத் தருமம் பெறுதி"],0,"/media/recitation/NAT.5.7.mp3"],[552,552,["sArnggam vaLaiya valikkum * thaDakkaich","sadhuran poruththam uDaiyan *","nAnggaL emmil irundhu oTTiya kachchanggam *","nAnum avanum aRidhum **","thEngkani mAmpozhil senthaLir kOdhum *","siRu kuyilE! * thirumAlai","Anggu viraindhu ollai kUgiRRi Agil *","avanai nAn seyvana kANE"],["சார்ங்கம் வளைய வலிக்கும் * தடக்கைச்","சதுரன் பொருத்தம் உடையன் *","நாங்கள் எம்மில் இருந்து ஒட்டிய கச்சங்கம் *","நானும் அவனும் அறிதும் **","தேங்கனி மாம்பொழில் செந்தளிர் கோதும் *","சிறு குயிலே! * திருமாலை","ஆங்கு விரைந்து ஒல்லை கூகிற்றி ஆகில் *","அவனை நான் செய்வன காணே"],0,"/media/recitation/NAT.5.8.mp3"],[553,553,["paingkiLi vaNNan sirIdharan enbadhOr *","pAsaththu agappaTTu irundhEn *","ponggoLi vaNDu iraikkum pozhil vAzh kuyilE! *","kuRikkoNDu idhu nI kEL **","sanggoDu chakkaraththAn varak kUvudhal *","ponvaLai koNDu tharudhal *","ingguLLa kAvinil vAzhak karudhil *","iraNDaththu onREl thiNNam vENDum"],["பைங்கிளி வண்ணன் சிரீதரன் என்பதோர் *","பாசத்து அகப்பட்டு இருந்தேன் *","பொங்கொளி வண்டு இரைக்கும் பொழில் வாழ் குயிலே! *","குறிக்கொண்டு இது நீ கேள் **","சங்கொடு சக்கரத்தான் வரக் கூவுதல் *","பொன்வளை கொண்டு தருதல் *","இங்குள்ள காவினில் வாழக் கருதில் *","இரண்டத்து ஒன்றேல் திண்ணம் வேண்டும்"],0,"/media/recitation/NAT.5.9.mp3"],[554,554,["anRu ulagam aLandhAnai ugandhu *","aDimaikkaN avan vali seyya *","thenRalum thinggaLum UDaRuththu * ennai","naliyum muRaimai aRiyEn **","enRum ikkAvil irundhirundhu * ennaith","thadharththAdhE nIyum kuyilE! *","inRu nArAyaNanai varak kUvAyEl *","ingguththai ninRum thurappan"],["அன்று உலகம் அளந்தானை உகந்து *","அடிமைக்கண் அவன் வலி செய்ய *","தென்றலும் திங்களும் ஊடறுத்து * என்னை","நலியும் முறைமை அறியேன் **","என்றும் இக்காவில் இருந்திருந்து * என்னைத்","ததர்த்தாதே நீயும் குயிலே! *","இன்று நாராயணனை வரக் கூவாயேல் *","இங்குற்று நின்றும் துரப்பன்"],0,"/media/recitation/NAT.5.10.mp3"],[555,555,["** viNNuRa nINDu aDi thAviya maindhanai *","vERkaN maDandhai virumbi *","kaNNuRa en kaDal vaNNanaik * kUvu","karungkuyilE! enRa mARRam **","paNNuRu nAnmaRaiyOr pudhuvai mannan *","paTTarpirAn kOdhai sonna *","naNNuRu vAsaga mAlai vallAr * namO","nArAyaNAya enbArE"],["** விண்ணுற நீண்டு அடி தாவிய மைந்தனை *","வேற்கண் மடந்தை விரும்பி *","கண்ணுற என் கடல் வண்ணனைக் * கூவு","கருங்குயிலே! என்ற மாற்றம் **","பண்ணுறு நான்மறையோர் புதுவை மன்னன் *","பட்டர்பிரான் கோதை சொன்ன *","நண்ணுறு வாசக மாலை வல்லார் * நமோ","நாராயணாய என்பாரே"],0,"/media/recitation/NAT.5.11.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","05 mannu perumpugazh [545-555].mp3",545,555]},{"he":["ARAm thirumozhi - vAraNamAyiram","Ayanai maNam seydhu koLvadhAgath thAn kaNDa kanAvaith thalaivi thOzhikkuk kURudhal"],"ht":["ஆறாம் திருமொழி - வாரணமாயிரம்","ஆயனை மணம் செய்து கொள்வதாகத் தான் கண்ட","கனாவைத் தலைவி தோழிக்குக் கூறுதல்"],"ae":"aDivaravu: vAraNam nALai indhiran nAlthisai kadhir maththaLam vAy immaikkum varisilai kunggumam AyanukkAga karuppUram","at":"அடிவரவு: வாரணம் நாளை இந்திரன் நால்திசை கதிர் மத்தளம் வாய் இம்மைக்கும் வரிசிலை குங்குமம் ஆயனுக்காக கருப்பூரம்","p":[[556,556,["vāraṇam āyiram * cūzha valañcĕytu *","nāraṇaṉ nampi * naṭakkiṉṟāṉ ĕṉṟu ĕtir **","pūraṇa pŏṟkuṭam * vaittup puṟam ĕṅkum *","toraṇam nāṭṭak * kaṉāk kaṇṭeṉ tozhī ! nāṉ"],["வாரணம் ஆயிரம் * சூழ வலஞ்செய்து *","நாரணன் நம்பி * நடக்கின்றான் என்று எதிர் **","பூரண பொற்குடம் * வைத்துப் புறம் எங்கும் *","தோரணம் நாட்டக் * கனாக் கண்டேன் தோழீ ! நான்"],1,"/media/recitation/NAT.6.1.mp3"],[557,557,["nALai vadhuvai * maNam enRu nAL iTTu *","pALai kamugu * parisuDaip pandhaR kIzh **","kOLari mAdhavan * gOvindhan enbAn Or *","kALai pugudhak * kanAk kaNDEn thOzhI! nAn"],["நாளை வதுவை * மணம் என்று நாள் இட்டு *","பாளை கமுகு * பரிசுடைப் பந்தற் கீழ் **","கோளரி மாதவன் * கோவிந்தன் என்பான் ஓர் *","காளை புகுதக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.2.mp3"],[558,558,["indhiran uLLiTTa * dhEvar kuzhAm ellAm *","vandhirundhu ennai * magaL pEsi mandhiriththu **","mandhirak kODi uDuththi * maNa mAlai *","andhari sUTTak * kanAk kaNDEn thOzhI! nAn"],["இந்திரன் உள்ளிட்ட * தேவர் குழாம் எல்லாம் *","வந்திருந்து என்னை * மகள் பேசி மந்திரித்து **","மந்திரக் கோடி உடுத்தி * மண மாலை *","அந்தரி சூட்டக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.3.mp3"],[559,559,["nAl thisaith thIrththam koNarndhu * nani nalgi *","pArppanach chiTTargaL * pallAr eDuththu Eththi **","pUppunai kaNNip * punidhanODu enthannai *","kAppu nAN kaTTak * kanAk kaNDEn thOzhI! nAn"],["நால் திசைத் தீர்த்தம் கொணர்ந்து * நனி நல்கி *","பார்ப்பனச் சிட்டர்கள் * பல்லார் எடுத்து ஏத்தி **","பூப்புனை கண்ணிப் * புனிதனோடு என்தன்னை *","காப்பு நாண் கட்டக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.4.mp3"],[560,560,["kadhiroLi dhIpam * kalasam uDan Endhi *","sadhir iLamanggaiyar thAm * vandhu edhir koLLa **","madhuraiyAr mannan * aDi nilai thoTTu enggum *","adhirap pugudhak * kanAk kaNDEn thOzhI! nAn"],["கதிரொளி தீபம் * கலசம் உடன் ஏந்தி *","சதிர் இளமங்கையர் தாம் * வந்து எதிர் கொள்ள **","மதுரையார் மன்னன் * அடி நிலை தொட்டு எங்கும் *","அதிரப் புகுதக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.5.mp3"],[561,561,["mattal̤am kŏṭṭa * vari-caṅkam niṉṟu ūta *","muttu uṭait tāmam * nirai tāzhnta pantaṟ kīzh **","maittuṉaṉ nampi * matucūtaṉ vantu ĕṉṉaik *","kaittalam paṟṟak * kaṉāk kaṇṭeṉ tozhī nāṉ"],["மத்தளம் கொட்ட * வரி சங்கம் நின்று ஊத *","முத்து உடைத் தாமம் * நிரை தாழ்ந்த பந்தற் கீழ் **","மைத்துனன் நம்பி * மதுசூதன் வந்து என்னைக் *","கைத்தலம் பற்றக் * கனாக் கண்டேன் தோழீ நான்"],1,"/media/recitation/NAT.6.6.mp3"],[562,562,["vAy nallAr * nalla maRai Odhi mandhiraththAl *","pAsilai nANal paDuththup * paridhi vaiththu **","kAy sina mA kaLiRu annAn * en kaip paRRi *","thI valam seyyak * kanAk kaNDEn thOzhI! nAn"],["வாய் நல்லார் * நல்ல மறை ஓதி மந்திரத்தால் *","பாசிலை நாணல் படுத்துப் * பரிதி வைத்து **","காய் சின மா களிறு அன்னான் * என் கைப் பற்றி *","தீ வலம் செய்யக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.7.mp3"],[563,563,["immaikkum * Ezh Ezh piRavikkum paRRAvAn *","nammai uDaiyavan * nArAyaNan nambi **","semmai uDaiya * thirukkaiyAl thAL paRRi *","ammi midhikkak * kanAk kaNDEn thOzhI! nAn"],["இம்மைக்கும் * ஏழ் ஏழ் பிறவிக்கும் பற்றாவான் *","நம்மை உடையவன் * நாராயணன் நம்பி **","செம்மை உடைய * திருக்கையால் தாள் பற்றி *","அம்மி மிதிக்கக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.8.mp3"],[564,564,["varisilai vAL mugaththu * ennaimAr thAm vandhiTTu *","eri mugam pAriththu * ennai munnE niRuththi **","ari mugan achchuthan * kaimmEl en kai vaiththu *","pori mugandhu aTTak * kanAk kaNDEn thOzhI! nAn"],["வரிசிலை வாள் முகத்து * என்னைமார் தாம் வந்திட்டு *","எரி முகம் பாரித்து * என்னை முன்னே நிறுத்தி **","அரி முகன் அச்சுதன் * கைம்மேல் என் கை வைத்து *","பொரி முகந்து அட்டக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.9.mp3"],[565,565,["kunggumam appik * kuLir sAndham maTTiththu *","manggala vIdhi * valam seydhu maNa nIr **","anggu avanODum * uDan senRu anggu Anai mEl *","manjchanam ATTak * kanAk kaNDEn thOzhI! nAn"],["குங்குமம் அப்பிக் * குளிர் சாந்தம் மட்டித்து *","மங்கல வீதி * வலம் செய்து மண நீர் **","அங்கு அவனோடும் * உடன் சென்று அங்கு ஆனை மேல் *","மஞ்சனம் ஆட்டக் * கனாக் கண்டேன் தோழீ! நான்"],0,"/media/recitation/NAT.6.10.mp3"],[566,566,["** AyanukkAgath * thAn kaNDa kanAvinai *","vEyar pugazh * villipuththUrk kOn kOdhai sol **","thUya thamizh mAlai * Iraindhum vallavar *","vAyu nanmakkaLaip peRRu * magizhvarE"],["** ஆயனுக்காகத் * தான் கண்ட கனாவினை *","வேயர் புகழ் * வில்லிபுத்தூர்க் கோன் கோதை சொல் **","தூய தமிழ் மாலை * ஈரைந்தும் வல்லவர் *","வாயு நன்மக்களைப் பெற்று * மகிழ்வரே"],0,"/media/recitation/NAT.6.11.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","06 vAraNamAyiram [556-566].mp3",556,566]},{"he":["EzhAm thirumozhi - karuppUram nARumO","pAnjchachanniyaththaip padmanAbanODum suRRamAkkudhal"],"ht":["ஏழாம் திருமொழி - கருப்பூரம் நாறுமோ","பாஞ்சசன்னியத்தைப் பத்மநாபனோடும் சுற்றமாக்குதல்"],"ae":"aDivaravu: karuppUram kaDalil thaDavarai chandhira unnODu pOy sengkamalam uNbadhu padhinARu pAnjchasanniyaththai viN","at":"அடிவரவு: கருப்பூரம் கடலில் தடவரை சந்திர உன்னோடு போய் செங்கமலம் உண்பது பதினாறு பாஞ்சசன்னியத்தை விண்","p":[[567,567,["** karuppUram nARumO? * kamalappU nARumO? *","thiruppavaLach chevvAy thAn * thiththiththu irukkumO? **","marupposiththa mAdhavan than * vAych chuvaiyum nARRamum *","viruppuRRuk kETkinREn * sol Azhi veNsanggE!"],["** கருப்பூரம் நாறுமோ? * கமலப்பூ நாறுமோ? *","திருப்பவளச் செவ்வாய் தான் * தித்தித்து இருக்குமோ? **","மருப்பொசித்த மாதவன் தன் * வாய்ச் சுவையும் நாற்றமும் *","விருப்புற்றுக் கேட்கின்றேன் * சொல் ஆழி வெண்சங்கே!"],0,"/media/recitation/NAT.7.1.mp3"],[568,568,["kaDalil piRandhu * karudhAdhu * panjchasanan","uDalil vaLarndhu pOy * UzhiyAn kaiththalath","thiDaril ** kuDi ERith * thIya asurar *","naDalaip paDa muzhanggum * thORRaththAy naRchanggE!"],["கடலில் பிறந்து * கருதாது * பஞ்சசனன்","உடலில் வளர்ந்து போய் * ஊழியான் கைத்தலத்","திடரில் ** குடி ஏறித் * தீய அசுரர் *","நடலைப் பட முழங்கும் * தோற்றத்தாய் நற்சங்கே!"],0,"/media/recitation/NAT.7.2.mp3"],[569,569,["thaDa varaiyin mIdhE * saraRkAla chandhiran *","iDaiyuvAvil vandhu * ezhundhAlE pOla ** nIyum","vaDamadhuraiyAr mannan * vAsudhEvan kaiyil *","kuDi ERi vIRRirundhAy * kOlap perum sanggE!"],["தட வரையின் மீதே * சரற்கால சந்திரன் *","இடையுவாவில் வந்து * எழுந்தாலே போல ** நீயும்","வடமதுரையார் மன்னன் * வாசுதேவன் கையில் *","குடி ஏறி வீற்றிருந்தாய் * கோலப் பெரும் சங்கே!"],0,"/media/recitation/NAT.7.3.mp3"],[570,570,["chandhira maNDalam pOl * dhAmOdharan kaiyil *","andharam onRinRi * ERi avan seviyil **","mandhiram koLvAyE pOlum * valampuriyE! *","indhiranum unnODu * selvaththukku ElAnE"],["சந்திர மண்டலம் போல் * தாமோதரன் கையில் *","அந்தரம் ஒன்றின்றி * ஏறி அவன் செவியில் **","மந்திரம் கொள்வாயே போலும் * வலம்புரியே! *","இந்திரனும் உன்னோடு * செல்வத்துக்கு ஏலானே"],0,"/media/recitation/NAT.7.4.mp3"],[571,571,["unnODu uDanE * oru kaDalil vAzhvArai *","innAr inaiyAr enRu * eNNuvAr illai kAN **","man Agi ninRa * madhusUdhan vAy amudham *","pannALum uNginRAy * pAnjchasanniyamE!"],["உன்னோடு உடனே * ஒரு கடலில் வாழ்வாரை *","இன்னார் இனையார் என்று * எண்ணுவார் இல்லை காண் **","மன் ஆகி நின்ற * மதுசூதன் வாய் அமுதம் *","பன்னாளும் உண்கின்றாய் * பாஞ்சசன்னியமே!"],0,"/media/recitation/NAT.7.5.mp3"],[572,572,["pOyth thIrththam ADAdhE * ninRa puNar marudham *","sAyththu IrththAn kaiththalaththE * ERik kuDi koNDu **","sEyth thIrththamAy ninRa * sengkaNmAl thannuDaiya *","vAyth thIrththam pAyndhADa vallAy * valampuriyE!"],["போய்த் தீர்த்தம் ஆடாதே * நின்ற புணர் மருதம் *","சாய்த்து ஈர்த்தான் கைத்தலத்தே * ஏறிக் குடி கொண்டு **","சேய்த் தீர்த்தமாய் நின்ற * செங்கண்மால் தன்னுடைய *","வாய்த் தீர்த்தம் பாய்ந்தாட வல்லாய் * வலம்புரியே!"],0,"/media/recitation/NAT.7.6.mp3"],[573,573,["cĕṅkamala nāl̤-malarmel * teṉ nukarum aṉṉam pol *","cĕṅkaṇ karumeṉi * vācutevaṉuṭaiya **","aṅkait talam eṟi * aṉṉa-vacañ cĕyyum *","caṅku-araiyā uṉ cĕlvam * cāla azhakiyate"],["செங்கமல நாள் மலர்மேல் * தேன் நுகரும் அன்னம் போல் *","செங்கண் கருமேனி * வாசுதேவனுடைய **","அங்கைத் தலம் ஏறி * அன்ன வசஞ் செய்யும் *","சங்கு அரையா உன் செல்வம் * சால அழகியதே"],1,"/media/recitation/NAT.7.7.mp3"],[574,574,["uNbadhu sollil * ulagaLandhAn vAy amudham *","kaNpaDai koLLil * kaDalvaNNan kaiththalaththE **","peNpaDaiyAr un mEl * perum pUsal sARRuginRAr *","paNbala seyginRAy * pAnjchasanniyamE!"],["உண்பது சொல்லில் * உலகளந்தான் வாய் அமுதம் *","கண்படை கொள்ளில் * கடல்வண்ணன் கைத்தலத்தே **","பெண்படையார் உன் மேல் * பெரும் பூசல் சாற்றுகின்றார் *","பண்பல செய்கின்றாய் * பாஞ்சசன்னியமே!"],0,"/media/recitation/NAT.7.8.mp3"],[575,575,["padhinARAm Ayiravar * dhEvimAr pArththu iruppa *","madhu vAyil koNDAR pOl * mAdhavan than vAy amudham **","podhuvAga uNbadhanaip * pukku nI uNDakkAl *","sidhaiyArO unnODu? * selvap perum sanggE!"],["பதினாறாம் ஆயிரவர் * தேவிமார் பார்த்து இருப்ப *","மது வாயில் கொண்டாற் போல் * மாதவன் தன் வாய் அமுதம் **","பொதுவாக உண்பதனைப் * புக்கு நீ உண்டக்கால் *","சிதையாரோ உன்னோடு? * செல்வப் பெரும் சங்கே!"],0,"/media/recitation/NAT.7.9.mp3"],[576,576,["** pAnjchasanniyaththaip * paRpanAbanODum *","vAyndha perum suRRam * Akkiya vaNpudhuvai **","Eyndha pugazhp paTTarpirAn * kOdhai thamizh Iraindhum *","Ayndhu Eththa vallAr * avarum aNukkarE"],["** பாஞ்சசன்னியத்தைப் * பற்பநாபனோடும் *","வாய்ந்த பெரும் சுற்றம் * ஆக்கிய வண்புதுவை **","ஏய்ந்த புகழ்ப் பட்டர்பிரான் * கோதை தமிழ் ஈரைந்தும் *","ஆய்ந்து ஏத்த வல்லார் * அவரும் அணுக்கரே"],0,"/media/recitation/NAT.7.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","07 karuppUram nARumO [567-576].mp3",567,576]},{"he":["eTTAm thirumozhi - viNNIla mElAppu","mEga viDu thUdhu"],"ht":["எட்டாம் திருமொழி - விண்ணீல மேலாப்பு","மேக விடு தூது"],"ae":"aDivaravu: viN mA oLi min vAn salam sanggam kAr madham nAgam sindhuram","at":"அடிவரவு: விண் மா ஒளி மின் வான் சலம் சங்கம் கார் மதம் நாகம் சிந்துரம்","p":[[577,577,["** viNNIla mElAppu * viriththAR pOl mEganggAL! *","theNNIr pAy vEngkaDaththu * en thirumAlum pOndhAnE? **","kaNNIrgaL mulaikkuvaTTil * thuLi sOrach sOrvEnai *","peNNIrmai IDazhikkum * idhu thamakkOr perumaiyE"],["** விண்ணீல மேலாப்பு * விரித்தாற் போல் மேகங்காள்! *","தெண்ணீர் பாய் வேங்கடத்து * என் திருமாலும் போந்தானே? **","கண்ணீர்கள் முலைக்குவட்டில் * துளி சோரச் சோர்வேனை *","பெண்ணீர்மை ஈடழிக்கும் * இது தமக்கோர் பெருமையே"],0,"/media/recitation/NAT.8.1.mp3"],[578,578,["mā muttaniti cŏriyum * mā mukilkāl̤ ! * veṅkaṭattuc","cāmattiṉ niṟaṅkŏṇṭa * tāl̤āl̤aṉ vārttai ĕṉṉe? **","kāmattī ul̤pukuntu * katuvappaṭṭu iṭaik kaṅkul *","emattu or tĕṉṟalukku * iṅku ilakkāy nāṉ iruppeṉe?"],["மா முத்தநிதி சொரியும் * மா முகில்காள் ! * வேங்கடத்துச்","சாமத்தின் நிறங்கொண்ட * தாளாளன் வார்த்தை என்னே? **","காமத்தீ உள்புகுந்து * கதுவப்பட்டு இடைக் கங்குல் *","ஏமத்து ஓர் தென்றலுக்கு * இங்கு இலக்காய் நான் இருப்பேனே?"],1,"/media/recitation/NAT.8.2.mp3"],[579,579,["oLi vaNNam vaLai sindhai * uRakkaththODu ivai ellAm *","eLimaiyAl iTTu ennai * IDazhiyap pOyinavAl **","kuLir aruvi vEngkaDaththu * en gOvindhan guNam pADi *","aLiyaththa mEganggAL! * Avi kAththiruppEnE"],["ஒளி வண்ணம் வளை சிந்தை * உறக்கத்தோடு இவை எல்லாம் *","எளிமையால் இட்டு என்னை * ஈடழியப் போயினவால் **","குளிர் அருவி வேங்கடத்து * என் கோவிந்தன் குணம் பாடி *","அளியத்த மேகங்காள்! * ஆவி காத்திருப்பேனே"],0,"/media/recitation/NAT.8.3.mp3"],[580,580,["miṉ ākattu ĕzhukiṉṟa * mekaṅkāl̤ ! * veṅkaṭattut","taṉ ākat tirumaṅkai * taṅkiya cīr mārvaṟku **","ĕṉ ākattu il̤aṅkŏṅkai * virumpit tām nāl̤toṟum *","pŏṉ ākam pulkutaṟku * ĕṉ purivuṭaimai cĕppumiṉe"],["மின் ஆகத்து எழுகின்ற * மேகங்காள் ! * வேங்கடத்துத்","தன் ஆகத் திருமங்கை * தங்கிய சீர் மார்வற்கு **","என் ஆகத்து இளங்கொங்கை * விரும்பித் தாம் நாள்தோறும் *","பொன் ஆகம் புல்குதற்கு * என் புரிவுடைமை செப்புமினே"],1,"/media/recitation/NAT.8.4.mp3"],[581,581,["vAn koNDu kiLarndhu ezhundha * mAmugilgAL! * vEngkaDaththuth","thEn koNDa malar sidhaRath * thiraNDERip pozhivIrgAL! **","Un koNDa vaLLugirAl * iraNiyanai uDal iDandhAn *","thAn koNDa sarivaLaigaL * tharum Agil sARRuminE"],["வான் கொண்டு கிளர்ந்து எழுந்த * மாமுகில்காள்! * வேங்கடத்துத்","தேன் கொண்ட மலர் சிதறத் * திரண்டேறிப் பொழிவீர்காள்! **","ஊன் கொண்ட வள்ளுகிரால் * இரணியனை உடல் இடந்தான் *","தான் கொண்ட சரிவளைகள் * தரும் ஆகில் சாற்றுமினே"],0,"/media/recitation/NAT.8.5.mp3"],[582,582,["salam koNDu kiLarndhu ezhundha * thaNmugilgAL! * mAvaliyai","nilam koNDAn vEngkaDaththE * nirandhERip pozhivIrgAL! **","ulangguNDa viLangkani pOl * uL meliyap pugundhu * ennai","nalangkoNDa nAraNaRku * en naDalai nOy seppuminE"],["சலம் கொண்டு கிளர்ந்து எழுந்த * தண்முகில்காள்! * மாவலியை","நிலம் கொண்டான் வேங்கடத்தே * நிரந்தேறிப் பொழிவீர்காள்! **","உலங்குண்ட விளங்கனி போல் * உள் மெலியப் புகுந்து * என்னை","நலங்கொண்ட நாரணற்கு * என் நடலை நோய் செப்புமினே"],0,"/media/recitation/NAT.8.6.mp3"],[583,583,["** sanggamA kaDal kaDaindhAn * thaNmugilgAL! * vEngkaDaththuch","sengkaNmAl sEvaDik kIzh * aDivIzhchchi viNNappam **","konggai mEl kunggumaththin * kuzhambazhiyap pugundhu * oru nAL","thanggumEl * en Avi thanggum enRuraiyIrE"],["** சங்கமா கடல் கடைந்தான் * தண்முகில்காள்! * வேங்கடத்துச்","செங்கண்மால் சேவடிக் கீழ் * அடிவீழ்ச்சி விண்ணப்பம் **","கொங்கை மேல் குங்குமத்தின் * குழம்பழியப் புகுந்து * ஒரு நாள்","தங்குமேல் * என் ஆவி தங்கும் என்றுரையீரே"],0,"/media/recitation/NAT.8.7.mp3"],[584,584,["kAr kAlaththu ezhuginRa * kArmugilgAL! * vEngkaDaththup","pOr kAlaththu ezhundharuLip * porudhavanAr pEr solli **","nIr kAlaththerukkil * ampazha ilai pOl vIzhvEnai *","vAr kAlaththoru nAL * tham vAsagam thandharuLArE"],["கார் காலத்து எழுகின்ற * கார்முகில்காள்! * வேங்கடத்துப்","போர் காலத்து எழுந்தருளிப் * பொருதவனார் பேர் சொல்லி **","நீர் காலத்தெருக்கில் * அம்பழ இலை போல் வீழ்வேனை *","வார் காலத்தொரு நாள் * தம் வாசகம் தந்தருளாரே"],0,"/media/recitation/NAT.8.8.mp3"],[585,585,["** madha yAnai pOl ezhundha * mAmugilgAL! * vEngkaDaththaip","padhiyAga vAzhvIrgAL! * pAmbaNaiyAn vArththai ennE! **","kadhi enRum thAn AvAn * karudhAdhu * Or peN koDiyai","vadhai seydhAn ennum sol * vaiyagaththAr madhiyArE"],["** மத யானை போல் எழுந்த * மாமுகில்காள்! * வேங்கடத்தைப்","பதியாக வாழ்வீர்காள்! * பாம்பணையான் வார்த்தை என்னே! **","கதி என்றும் தான் ஆவான் * கருதாது * ஓர் பெண் கொடியை","வதை செய்தான் என்னும் சொல் * வையகத்தார் மதியாரே"],0,"/media/recitation/NAT.8.9.mp3"],[586,586,["** nAgaththin aNaiyAnai * nannudhalAL nayandhurai sey *","mEgaththai vEngkaDak kOn * viDu thUdhil viNNappam **","bOgaththil vazhuvAdha * pudhuvaiyar kOn kOdhai thamizh *","Agaththu vaiththu uraippAr * avar aDiyAr AguvarE"],["** நாகத்தின் அணையானை * நன்னுதலாள் நயந்துரை செய் *","மேகத்தை வேங்கடக் கோன் * விடு தூதில் விண்ணப்பம் **","போகத்தில் வழுவாத * புதுவையர் கோன் கோதை தமிழ் *","ஆகத்து வைத்து உரைப்பார் * அவர் அடியார் ஆகுவரே"],0,"/media/recitation/NAT.8.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","08 viNNeela mElAppu [577-586].mp3",577,586]},{"he":["onbadhAm thirumozhi - sindhurach sempoDi","thirumAlirunjchOlai azhagarai vazhipaDudhal"],"ht":["ஒன்பதாம் திருமொழி - சிந்துரச் செம்பொடி","திருமாலிருஞ்சோலை அழகரை வழிபடுதல்"],"ae":"aDivaravu: sindhuram pOr karuviLai paimpozhil thunggam nARu inRu kAlai kOnggu sandhoDu kArkkODal","at":"அடிவரவு: சிந்துரம் போர் கருவிளை பைம்பொழில் துங்கம் நாறு இன்று காலை கோங்கு சந்தொடு கார்க்கோடல்","p":[[587,587,["** sindhurach sempoDip pOl * thirumAlirunjchOlai enggum *","indhira kOpanggaLE * ezhundhum parandhiTTanavAl **","mandharam nATTi anRu * madhurak kozhunjchARu koNDa *","sundharath thOL uDaiyAn * suzhalaiyil ninRu uydhungkolO?"],["** சிந்துரச் செம்பொடிப் போல் * திருமாலிருஞ்சோலை எங்கும் *","இந்திர கோபங்களே * எழுந்தும் பரந்திட்டனவால் **","மந்தரம் நாட்டி அன்று * மதுரக் கொழுஞ்சாறு கொண்ட *","சுந்தரத் தோள் உடையான் * சுழலையில் நின்று உய்துங்கொலோ?"],0,"/media/recitation/NAT.9.1.mp3"],[588,588,["porkkal̤iṟu pŏrum * māliruñcolai am pūmpuṟavil *","tārkkŏṭi mullaikal̤um * taval̤a nakai kāṭṭukiṉṟa **","kārkkŏl̤ piṭākkal̤ niṉṟu * kazhaṟic cirikkat tariyeṉ *","ārkku iṭuko? tozhī * avaṉ tār cĕyta pūcalaiye"],["போர்க்களிறு பொரும் * மாலிருஞ்சோலை அம் பூம்புறவில் *","தார்க்கொடி முல்லைகளும் * தவள நகை காட்டுகின்ற **","கார்க்கொள் பிடாக்கள் நின்று * கழறிச் சிரிக்கத் தரியேன் *","ஆர்க்கு இடுகோ? தோழீ * அவன் தார் செய்த பூசலையே"],1,"/media/recitation/NAT.9.2.mp3"],[589,589,["karuviLai oNmalargAL! * kAyA malargAL! * thirumAl","uruvoLi kATTuginRIr * enakku uyvazhakku onRu uraiyIr **","thiru viLaiyADu thiN thOL * thirumAlirunjchOlai nambi *","vari vaLaiyil pugundhu * vandhi paRRum vazhakku uLadhE"],["கருவிளை ஒண்மலர்காள்! * காயா மலர்காள்! * திருமால்","உருவொளி காட்டுகின்றீர் * எனக்கு உய்வழக்கு ஒன்று உரையீர் **","திரு விளையாடு திண் தோள் * திருமாலிருஞ்சோலை நம்பி *","வரி வளையில் புகுந்து * வந்தி பற்றும் வழக்கு உளதே"],0,"/media/recitation/NAT.9.3.mp3"],[590,590,["paimpozhil vAzh kuyilgAL! mayilgAL! * oNkaruviLaigAL! *","vambak kaLangkanigAL! * vaNNap pUvai naRumalargAL! **","aimperum pAdhagargAL! * aNi mAlirunjchOlai ninRa *","emperumAnuDaiya niRam * unggaLukku en seyvadhE?"],["பைம்பொழில் வாழ் குயில்காள்! மயில்காள்! * ஒண்கருவிளைகாள்! *","வம்பக் களங்கனிகாள்! * வண்ணப் பூவை நறுமலர்காள்! **","ஐம்பெரும் பாதகர்காள்! * அணி மாலிருஞ்சோலை நின்ற *","எம்பெருமானுடைய நிறம் * உங்களுக்கு என் செய்வதே?"],0,"/media/recitation/NAT.9.4.mp3"],[591,591,["tuṅka malarp pŏzhil cūzh * tirumāliruñcolai niṉṟa *","cĕṅkaṇ karumukiliṉ * tiruvurup pol ** malarmel","tŏṅkiya vaṇṭiṉaṅkāl̤ * tŏku pūñcuṉaikāl̤ * cuṉaiyil","taṅku cĕntāmaraikāl̤ * ĕṉakku or caraṇ cāṟṟumiṉe"],["துங்க மலர்ப் பொழில் சூழ் * திருமாலிருஞ்சோலை நின்ற *","செங்கண் கருமுகிலின் * திருவுருப் போல் ** மலர்மேல்","தொங்கிய வண்டினங்காள் * தொகு பூஞ்சுனைகாள் * சுனையில்","தங்கு செந்தாமரைகாள் * எனக்கு ஓர் சரண் சாற்றுமினே"],1,"/media/recitation/NAT.9.5.mp3"],[592,592,["nāṟu naṟum pŏzhil * māliruñcolai nampikku * nāṉ","nūṟu taṭāvil vĕṇṇĕy * vāynerntu parāvi vaitteṉ **","nūṟu taṭā niṟainta * akkāra aṭicil cŏṉṉeṉ *","eṟu tiruvuṭaiyāṉ * iṉṟu vantu ivai kŏl̤l̤uṅ kŏlo?"],["நாறு நறும் பொழில் * மாலிருஞ்சோலை நம்பிக்கு * நான்","நூறு தடாவில் வெண்ணெய் * வாய்நேர்ந்து பராவி வைத்தேன் **","நூறு தடா நிறைந்த * அக்கார அடிசில் சொன்னேன் *","ஏறு திருவுடையான் * இன்று வந்து இவை கொள்ளுங் கொலோ?"],1,"/media/recitation/NAT.9.6.mp3"],[593,593,["inRu vandhu iththanaiyum * amudhu seydhiDap peRil * nAn","onRu nURu AyiramAk koDuththup * pinnum ALum seyvan **","thenRal maNam kamazhum * thirumAlirunjchOlai thannuL","ninRa pirAn * aDiyEn manaththE vandhu nEr paDilE"],["இன்று வந்து இத்தனையும் * அமுது செய்திடப் பெறில் * நான்","ஒன்று நூறு ஆயிரமாக் கொடுத்துப் * பின்னும் ஆளும் செய்வன் **","தென்றல் மணம் கமழும் * திருமாலிருஞ்சோலை தன்னுள்","நின்ற பிரான் * அடியேன் மனத்தே வந்து நேர் படிலே"],0,"/media/recitation/NAT.9.7.mp3"],[594,594,["kAlai ezhundhirundhu * kariya kuruvik kaNanggaL *","mAlin varavu solli * maruL pADudhal meymmai kolO? **","sOlai malaip perumAn * thuvarApadhi emperumAn *","Alin ilaip perumAn * avan vArththai uraikkinRadhE"],["காலை எழுந்திருந்து * கரிய குருவிக் கணங்கள் *","மாலின் வரவு சொல்லி * மருள் பாடுதல் மெய்ம்மை கொலோ? **","சோலை மலைப் பெருமான் * துவராபதி எம்பெருமான் *","ஆலின் இலைப் பெருமான் * அவன் வார்த்தை உரைக்கின்றதே"],0,"/media/recitation/NAT.9.8.mp3"],[595,595,["kOnggalarum pozhil * mAlirunjchOlaiyil konRaigaL mEl *","thUnggu pon mAlaigaLODu * uDanAy ninRu thUngguginREn **","pUngkoL thirumugaththu * maDuththUdhiya sanggoliyum *","sArngga vil nAN oliyum * thalaippeyvadhu enjnjAnRu kolO"],["கோங்கலரும் பொழில் * மாலிருஞ்சோலையில் கொன்றைகள் மேல் *","தூங்கு பொன் மாலைகளோடு * உடனாய் நின்று தூங்குகின்றேன் **","பூங்கொள் திருமுகத்து * மடுத்தூதிய சங்கொலியும் *","சார்ங்க வில் நாண் ஒலியும் * தலைப்பெய்வது எஞ்ஞான்று கொலோ"],0,"/media/recitation/NAT.9.9.mp3"],[596,596,["** sandhoDu kAr agilum sumandhu * thaDanggaL porudhu *","vandhizhiyum silambARuDai * mAlirunjchOlai ninRa","sundharanai ** surumbAr kuzhal * kOdhai thoguththu uraiththa *","senthamizh paththum vallAr * thirumAl aDi sErvargaLE"],["** சந்தொடு கார் அகிலும் சுமந்து * தடங்கள் பொருது *","வந்திழியும் சிலம்பாறுடை * மாலிருஞ்சோலை நின்ற","சுந்தரனை ** சுரும்பார் குழல் * கோதை தொகுத்து உரைத்த *","செந்தமிழ் பத்தும் வல்லார் * திருமால் அடி சேர்வர்களே"],0,"/media/recitation/NAT.9.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","09 sinthurach sempodi [587-596].mp3",587,596]},{"he":["paththAm thirumozhi - kArkkODal pUkkAL","thalaivi pirindha nilaiyil pirivARRAdhu varundhik kURudhal"],"ht":["பத்தாம் திருமொழி - கார்க்கோடல் பூக்காள்","தலைவி பிரிந்த நிலையில் பிரிவாற்றாது வருந்திக் கூறுதல்"],"ae":"aDivaravu: kAr mEl kOvai mullai pADum kaNam naDamADi mazhaiyE kaDalE nalla thAm","at":"அடிவரவு: கார் மேல் கோவை முல்லை பாடும் கணம் நடமாடி மழையே கடலே நல்ல தாம்","p":[[597,597,["** kArkkODal pUkkAL! * kArkkaDal vaNNan en mEl * ummaip","pOrkkOlam seydhu * pOra viDuththavan engguRRAn? **","ArkkO ini nAm * pUsal iDuvadhu? * aNi thuzhAyth","thArkkODum nenjcham thannaip * paDaikka vallEn andhO!"],["** கார்க்கோடல் பூக்காள்! * கார்க்கடல் வண்ணன் என் மேல் * உம்மைப்","போர்க்கோலம் செய்து * போர விடுத்தவன் எங்குற்றான்? **","ஆர்க்கோ இனி நாம் * பூசல் இடுவது? * அணி துழாய்த்","தார்க்கோடும் நெஞ்சம் தன்னைப் * படைக்க வல்லேன் அந்தோ!"],0,"/media/recitation/NAT.10.1.mp3"],[598,598,["mEl thOnRip pUkkAL! * mEl ulaganggaLin mIdhu pOy *","mEl thOnRum sOdhi * vEdha mudhalvar valangkaiyil **","mEl thOnRum Azhiyin * venjchuDar pOlach suDAdhu * emmai","mARROlaip paTTavar kUTTaththu * vaiththuk koLgiRRirE"],["மேல் தோன்றிப் பூக்காள்! * மேல் உலகங்களின் மீது போய் *","மேல் தோன்றும் சோதி * வேத முதல்வர் வலங்கையில் **","மேல் தோன்றும் ஆழியின் * வெஞ்சுடர் போலச் சுடாது * எம்மை","மாற்றோலைப் பட்டவர் கூட்டத்து * வைத்துக் கொள்கிற்றிரே"],0,"/media/recitation/NAT.10.2.mp3"],[599,599,["kOvai maNATTi! * nI un kozhungkani koNDu * emmai","Avi tholaiviyEl * vAy azhagar thammai anjchudhum **","pAviyEn thOnRip * pAmbaNaiyArkkum tham pAmbu pOl *","nAvum iraNDu uLavAyththu * nAN iliyEnukkE"],["கோவை மணாட்டி! * நீ உன் கொழுங்கனி கொண்டு * எம்மை","ஆவி தொலைவியேல் * வாய் அழகர் தம்மை அஞ்சுதும் **","பாவியேன் தோன்றிப் * பாம்பணையார்க்கும் தம் பாம்பு போல் *","நாவும் இரண்டு உளவாய்த்து * நாண் இலியேனுக்கே"],0,"/media/recitation/NAT.10.3.mp3"],[600,600,["mullaip pirāṭṭi * nī uṉ muṟuvalkal̤ kŏṇṭu * ĕmmai","allal vil̤aiviyel * āzhi naṅkāy uṉ aṭaikkalam **","kŏllai arakkiyai mūkku arintiṭṭa * kumaraṉār","cŏllum pŏyyāṉāl * nāṉum piṟantamai pŏy aṉṟe?"],["முல்லைப் பிராட்டி * நீ உன் முறுவல்கள் கொண்டு * எம்மை","அல்லல் விளைவியேல் * ஆழி நங்காய் உன் அடைக்கலம் **","கொல்லை அரக்கியை மூக்கு அரிந்திட்ட * குமரனார்","சொல்லும் பொய்யானால் * நானும் பிறந்தமை பொய் அன்றே?"],1,"/media/recitation/NAT.10.4.mp3"],[601,601,["pADum kuyilgAL! * Idhenna pADal? * nal vEngkaDa","nADar namakku oru vAzhvu thandhAl * vandhu pADumin **","ADum karuLak koDi uDaiyAr * vandhu aruL seydhu *","kUDuvar AyiDil * kUvi num pATTukkaL kETTumE"],["பாடும் குயில்காள்! * ஈதென்ன பாடல்? * நல் வேங்கட","நாடர் நமக்கு ஒரு வாழ்வு தந்தால் * வந்து பாடுமின் **","ஆடும் கருளக் கொடி உடையார் * வந்து அருள் செய்து *","கூடுவர் ஆயிடில் * கூவி நும் பாட்டுக்கள் கேட்டுமே"],0,"/media/recitation/NAT.10.5.mp3"],[602,602,["kaNa mA mayilgAL! * kaNNa pirAn thirukkOlam pOnRu *","aNi mA naDam payinRu ADuginRIrkku * aDi vIzhginREn **","paNam ADaravaNaip * paRpala kAlamum paLLi koL *","maNavALar nammai vaiththa * parisu idhu kANminE"],["கண மா மயில்காள்! * கண்ண பிரான் திருக்கோலம் போன்று *","அணி மா நடம் பயின்று ஆடுகின்றீர்க்கு * அடி வீழ்கின்றேன் **","பணம் ஆடரவணைப் * பற்பல காலமும் பள்ளி கொள் *","மணவாளர் நம்மை வைத்த * பரிசு இது காண்மினே"],0,"/media/recitation/NAT.10.6.mp3"],[603,603,["naDamADith thOgai virikkinRa * mA mayilgAL! * ummai","naDamATTam kANap * pAviyEn nAn Or mudhalilEn **","kuDamADu kUththan * gOvindhan kOmiRai seydhu * emmai","uDaimADu koNDAn * unggaLukku ini onRu pOdhumE?"],["நடமாடித் தோகை விரிக்கின்ற * மா மயில்காள்! * உம்மை","நடமாட்டம் காணப் * பாவியேன் நான் ஓர் முதலிலேன் **","குடமாடு கூத்தன் * கோவிந்தன் கோமிறை செய்து * எம்மை","உடைமாடு கொண்டான் * உங்களுக்கு இனி ஒன்று போதுமே?"],0,"/media/recitation/NAT.10.7.mp3"],[604,604,["mazhaiye! mazhaiye! * maṇ puṟam pūci ul̤l̤āy niṉṟu *","mĕzhuku ūṟṟiṉāl pol * ūṟṟu nal veṅkaṭattu ul̤ niṉṟa **","azhakappirāṉār tammai * ĕṉ nĕñcattu akappaṭat","tazhuva niṉṟu * ĕṉṉait tataittukkŏṇṭu * ūṟṟavum vallaiye?"],["மழையே! மழையே! * மண் புறம் பூசி உள்ளாய் நின்று *","மெழுகு ஊற்றினால் போல் * ஊற்று நல் வேங்கடத்து உள் நின்ற **","அழகப்பிரானார் தம்மை * என் நெஞ்சத்து அகப்படத்","தழுவ நின்று * என்னைத் ததைத்துக்கொண்டு * ஊற்றவும் வல்லையே?"],1,"/media/recitation/NAT.10.8.mp3"],[605,605,["kaDalE! kaDalE! unnaik kaDaindhu * kalakkuRuththu *","uDaluL pugundhu ninRu * URal aRuththavaRku ** ennaiyum","uDaluL pugundhu ninRu * URal aRukkinRa mAyaRku * en","naDalaigaL ellAm * nAgaNaikkE senRu uraiththiyE"],["கடலே! கடலே! உன்னைக் கடைந்து * கலக்குறுத்து *","உடலுள் புகுந்து நின்று * ஊறல் அறுத்தவற்கு ** என்னையும்","உடலுள் புகுந்து நின்று * ஊறல் அறுக்கின்ற மாயற்கு * என்","நடலைகள் எல்லாம் * நாகணைக்கே சென்று உரைத்தியே"],0,"/media/recitation/NAT.10.9.mp3"],[606,606,["** nalla en thOzhi! * nAgaNai misai nam parar *","selvar periyar * siRu mAniDavar nAm seyvadhu en? **","villi pudhuvai * viTTuchiththar thanggaL dhEvarai *","valla parisu varuvipparEl * adhu kANDumE"],["** நல்ல என் தோழி! * நாகணை மிசை நம் பரர் *","செல்வர் பெரியர் * சிறு மானிடவர் நாம் செய்வது என்? **","வில்லி புதுவை * விட்டுசித்தர் தங்கள் தேவரை *","வல்ல பரிசு வருவிப்பரேல் * அது காண்டுமே"],0,"/media/recitation/NAT.10.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","10 kArkkOdal pUkkAL [597-606].mp3",597,606]},{"he":["padhinOrAm thirumozhi - thAmugakkum","thalaivi thiruvaranggan seygaiku manam poRAdhu thAymAr mudhaliyOrai nOkki varundhik kURudhal"],"ht":["பதினோராம் திருமொழி - தாமுகக்கும்","தலைவி திருவரங்கன் செய்கைகு மனம் பொறாது","தாய்மார் முதலியோரை நோக்கி வருந்திக் கூறுதல்"],"ae":"aDivaravu: thAm ezhil ponggu machchu pollA kai uNNAdhu pAsi kaNNAlam semmai maRRu","at":"அடிவரவு: தாம் எழில் பொங்கு மச்சு பொல்லா கை உண்ணாது பாசி கண்ணாலம் செம்மை மற்று","p":[[607,607,["tām ukakkum tam kaiyil * caṅkame polāvo *","yām ukakkum ĕm kaiyil * caṅkamum? entizhaiyīr **","tī mukattu nākaṇaimel * cerum tiruvaraṅkar *","ā mukattai nokkārāl * ammaṉe ammaṉe"],["தாம் உகக்கும் தம் கையில் * சங்கமே போலாவோ *","யாம் உகக்கும் எம் கையில் * சங்கமும்? ஏந்திழையீர் **","தீ முகத்து நாகணைமேல் * சேரும் திருவரங்கர் *","ஆ முகத்தை நோக்காரால் * அம்மனே அம்மனே"],1,"/media/recitation/NAT.11.1.mp3"],[608,608,["ezhil uDaiya ammanaimIr! * en aranggaththu innamudhar *","kuzhal azhagar vAy azhagar * kaN azhagar ** koppUzhil","ezhukamalap pUvazhagar * emmAnAr * ennuDaiya","kazhal vaLaiyaith * thAmum kazhal vaLaiyE AkkinarE"],["எழில் உடைய அம்மனைமீர்! * என் அரங்கத்து இன்னமுதர் *","குழல் அழகர் வாய் அழகர் * கண் அழகர் ** கொப்பூழில்","எழுகமலப் பூவழகர் * எம்மானார் * என்னுடைய","கழல் வளையைத் * தாமும் கழல் வளையே ஆக்கினரே"],0,"/media/recitation/NAT.11.2.mp3"],[609,609,["** ponggOdham sUzhndha * buvaniyum viNNulagum *","anggAdhum sOrAmE * ALginRa emperumAn **","sengkOl uDaiya * thiruvaranggach selvanAr *","engkOl vaLaiyAl * iDar thIrvar AgAdhE?"],["** பொங்கோதம் சூழ்ந்த * புவனியும் விண்ணுலகும் *","அங்காதும் சோராமே * ஆள்கின்ற எம்பெருமான் **","செங்கோல் உடைய * திருவரங்கச் செல்வனார் *","எங்கோல் வளையால் * இடர் தீர்வர் ஆகாதே?"],0,"/media/recitation/NAT.11.3.mp3"],[610,610,["machchaNi mADa * madhiL aranggar vAmananAr *","pachchaip pasundhEvar * thAm paNDu nIr ERRa **","pichchaik kuRai Agi * ennuDaiya peyvaLai mEl *","ichchai uDaiyarEl * iththeruvE pOdhArE?"],["மச்சணி மாட * மதிள் அரங்கர் வாமனனார் *","பச்சைப் பசுந்தேவர் * தாம் பண்டு நீர் ஏற்ற **","பிச்சைக் குறை ஆகி * என்னுடைய பெய்வளை மேல் *","இச்சை உடையரேல் * இத்தெருவே போதாரே?"],0,"/media/recitation/NAT.11.4.mp3"],[611,611,["pollAk kuRaL uruvAyp * poRkaiyil nIr ERRu *","ellA ulagum * aLandhu koNDa emperumAn **","nallArgaL vAzhum * naLir arangga nAgaNaiyAn *","illAdhOm kaipporuLum * eydhuvAn oththuLanE"],["பொல்லாக் குறள் உருவாய்ப் * பொற்கையில் நீர் ஏற்று *","எல்லா உலகும் * அளந்து கொண்ட எம்பெருமான் **","நல்லார்கள் வாழும் * நளிர் அரங்க நாகணையான் *","இல்லாதோம் கைப்பொருளும் * எய்துவான் ஒத்துளனே"],0,"/media/recitation/NAT.11.5.mp3"],[612,612,["kaipporuLgaL munnamE * kaikkoNDAr * kAviri nIr","seyp puraLa ODum * thiruvaranggach selvanAr **","epporuTkum ninRArkkum * eydhAdhu * nAnmaRaiyin","soRporuLAy ninRAr * en meypporuLum koNDArE"],["கைப்பொருள்கள் முன்னமே * கைக்கொண்டார் * காவிரி நீர்","செய்ப் புரள ஓடும் * திருவரங்கச் செல்வனார் **","எப்பொருட்கும் நின்றார்க்கும் * எய்தாது * நான்மறையின்","சொற்பொருளாய் நின்றார் * என் மெய்ப்பொருளும் கொண்டாரே"],0,"/media/recitation/NAT.11.6.mp3"],[613,613,["uNNAdhu uRanggAdhu * oli kaDalai UDaRuththu *","peN Akkai AppuNDu * thAm uRRa pEdhellAm **","thiNNAr madhiL sUzh * thiruvaranggach selvanAr *","eNNAdhE thammuDaiya * nanmaigaLE eNNuvarE"],["உண்ணாது உறங்காது * ஒலி கடலை ஊடறுத்து *","பெண் ஆக்கை ஆப்புண்டு * தாம் உற்ற பேதெல்லாம் **","திண்ணார் மதிள் சூழ் * திருவரங்கச் செல்வனார் *","எண்ணாதே தம்முடைய * நன்மைகளே எண்ணுவரே"],0,"/media/recitation/NAT.11.7.mp3"],[614,614,["** pAsi thUrththuk kiDandha * pAr magaTku * paNDoru nAL","mAsuDambil nIr vArA * mAnam ilAp panRiyAm **","thEsuDaiya dhEvar * thiruvaranggach selvanAr *","pEsi iruppanagaL * pErkkavum pErAvE"],["** பாசி தூர்த்துக் கிடந்த * பார் மகட்கு * பண்டொரு நாள்","மாசுடம்பில் நீர் வாரா * மானம் இலாப் பன்றியாம் **","தேசுடைய தேவர் * திருவரங்கச் செல்வனார் *","பேசி இருப்பனகள் * பேர்க்கவும் பேராவே"],0,"/media/recitation/NAT.11.8.mp3"],[615,615,["kaNNAlam kODiththuk * kanni thannaik kaippiDippAn *","thiNNArndhu irundha * sisupAlan thEsu azhindhu **","aNNAndhu irukkavE * Anggu avaLaik kaippiDiththa *","peNNALan pENum Ur * pErum aranggamE"],["கண்ணாலம் கோடித்துக் * கன்னி தன்னைக் கைப்பிடிப்பான் *","திண்ணார்ந்து இருந்த * சிசுபாலன் தேசு அழிந்து **","அண்ணாந்து இருக்கவே * ஆங்கு அவளைக் கைப்பிடித்த *","பெண்ணாளன் பேணும் ஊர் * பேரும் அரங்கமே"],0,"/media/recitation/NAT.11.9.mp3"],[616,616,["** semmai uDaiya * thiruvaranggar thAm paNiththa *","meymmaip peru vArththai * viTTuchiththar kETTu iruppar **","thammai ugappAraith * thAm ugappar ennum sol *","thammiDaiyE poyyAnAl * sAdhippAr Ar iniyE?"],["** செம்மை உடைய * திருவரங்கர் தாம் பணித்த *","மெய்ம்மைப் பெரு வார்த்தை * விட்டுசித்தர் கேட்டு இருப்பர் **","தம்மை உகப்பாரைத் * தாம் உகப்பர் என்னும் சொல் *","தம்மிடையே பொய்யானால் * சாதிப்பார் ஆர் இனியே?"],0,"/media/recitation/NAT.11.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","11 thAmugakkum [607-616].mp3",607,616]},{"he":["panniraNDAm thirumozhi - maRRirundhIrgaTku","thalaivi kaNNan uLLa iDaththil thannaik koNDu viDumpaDi uRRArai vENDudhal"],"ht":["பன்னிரண்டாம் திருமொழி - மற்றிருந்தீர்கட்கு","தலைவி கண்ணன் உள்ள இடத்தில் தன்னைக் கொண்டு விடும்படி உற்றாரை வேண்டுதல்"],"ae":"aDivaravu: maRRu nANi thandhai angkai Arkkum kArththaN vaNNam kaRRinam kUTTil mannu kaNNan","at":"அடிவரவு: மற்று நாணி தந்தை அங்கை ஆர்க்கும் கார்த்தண் வண்ணம் கற்றினம் கூட்டில் மன்னு கண்ணன்","p":[[617,617,["** maRRirundhIrgaTku aRiyal AgA *","mAdhavan enbadhOr anbu thannai *","uRRirundhEnukku uraippadhu ellAm *","UmaiyarODu seviDar vArththai **","peRRirundhALai ozhiyavE pOyp *","pErththoru thAy il vaLarndha nambi *","maRporundhAmaR kaLam aDaindha *","madhuraip puRaththu ennai uyththiDumin"],["** மற்றிருந்தீர்கட்கு அறியல் ஆகா *","மாதவன் என்பதோர் அன்பு தன்னை *","உற்றிருந்தேனுக்கு உரைப்பது எல்லாம் *","ஊமையரோடு செவிடர் வார்த்தை **","பெற்றிருந்தாளை ஒழியவே போய்ப் *","பேர்த்தொரு தாய் இல் வளர்ந்த நம்பி *","மற்பொருந்தாமற் களம் அடைந்த *","மதுரைப் புறத்து என்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.1.mp3"],[618,618,["nANi ini Or karumam illai *","nAl ayalArum aRindhu ozhindhAr *","pANiyAdhu ennai marundhu seydhu *","paNDu paNDAkka uRudhir Agil **","mANi uruvAy ulagaLandha *","mAyanaik kANil thalai maRiyum *","ANaiyAl nIr ennaik kAkka vENDil *","AyppADikkE ennai uyththiDumin"],["நாணி இனி ஓர் கருமம் இல்லை *","நால் அயலாரும் அறிந்து ஒழிந்தார் *","பாணியாது என்னை மருந்து செய்து *","பண்டு பண்டாக்க உறுதிர் ஆகில் **","மாணி உருவாய் உலகளந்த *","மாயனைக் காணில் தலை மறியும் *","ஆணையால் நீர் என்னைக் காக்க வேண்டில் *","ஆய்ப்பாடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.2.mp3"],[619,619,["thandhaiyum thAyum uRRArum niRkath *","thani vazhi pOyinAL ennum sollu *","vandha pinnaip pazhi kApparidhu *","mAyavan vandhu uruk kATTuginRAn **","kondhaLam Akkip parakkazhiththuk *","kuRumbu seyvAn Or maganaip peRRa *","nandhagOpAlan kaDaiththalaikkE *","naLLiruTkaN ennai uyththiDumin"],["தந்தையும் தாயும் உற்றாரும் நிற்கத் *","தனி வழி போயினாள் என்னும் சொல்லு *","வந்த பின்னைப் பழி காப்பரிது *","மாயவன் வந்து உருக் காட்டுகின்றான் **","கொந்தளம் ஆக்கிப் பரக்கழித்துக் *","குறும்பு செய்வான் ஓர் மகனைப் பெற்ற *","நந்தகோபாலன் கடைத்தலைக்கே *","நள்ளிருட்கண் என்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.3.mp3"],[620,620,["anggaith thalaththiDai Azhi koNDAn *","avan mugaththanRi vizhiyEn enRu *","sengkachchuk koNDu kaNNADai Arththuch *","siRu mAniDavaraik kANil nANum **","konggaith thalam ivai nOkkik kANIr *","gOvindhanukku allAl vAyil pOgA *","ingguththai vAzhvai ozhiyavE pOy *","yamunaik karaikkennai uyththiDumin"],["அங்கைத் தலத்திடை ஆழி கொண்டான் *","அவன் முகத்தன்றி விழியேன் என்று *","செங்கச்சுக் கொண்டு கண்ணாடை ஆர்த்துச் *","சிறு மானிடவரைக் காணில் நாணும் **","கொங்கைத் தலம் இவை நோக்கிக் காணீர் *","கோவிந்தனுக்கு அல்லால் வாயில் போகா *","இங்குத்தை வாழ்வை ஒழியவே போய் *","யமுனைக் கரைக்கென்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.4.mp3"],[621,621,["Arkkum en nOy idhu aRiyal AgAdhu *","ammanaimIr! thuzhadhip paDAdhE *","kArkkaDal vaNNan enbAn oruvan *","kai kaNDa yOgam thaDavath thIrum **","nIrkkarai ninRa kaDambai ERik *","kALiyan uchchiyil naTTam pAyndhu *","pOrkkaLamAga niruththam seydha *","poygaik karaikku ennai uyththiDumin"],["ஆர்க்கும் என் நோய் இது அறியல் ஆகாது *","அம்மனைமீர்! துழதிப் படாதே *","கார்க்கடல் வண்ணன் என்பான் ஒருவன் *","கை கண்ட யோகம் தடவத் தீரும் **","நீர்க்கரை நின்ற கடம்பை ஏறிக் *","காளியன் உச்சியில் நட்டம் பாய்ந்து *","போர்க்களமாக நிருத்தம் செய்த *","பொய்கைக் கரைக்கு என்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.5.mp3"],[622,622,["kArth thaNmugilum karuviLaiyum *","kAyA malarum kamalap pUvum *","IrththiDuginRana ennai vandhiTTu *","iruDIkEsan pakkal pOgE enRu **","vErththup pasiththu vayiRasaindhu *","vENDaDisil uNNum pOdhu * IdhenRu","pArththu irundhu neDunOkkuk koLLum *","paththavilOsanaththu uyththiDumin"],["கார்த் தண்முகிலும் கருவிளையும் *","காயா மலரும் கமலப் பூவும் *","ஈர்த்திடுகின்றன என்னை வந்திட்டு *","இருடீகேசன் பக்கல் போகே என்று **","வேர்த்துப் பசித்து வயிறசைந்து *","வேண்டடிசில் உண்ணும் போது * ஈதென்று","பார்த்து இருந்து நெடுநோக்குக் கொள்ளும் *","பத்தவிலோசனத்து உய்த்திடுமின்"],0,"/media/recitation/NAT.12.6.mp3"],[623,623,["vaNNam thirivum manam kuzhaivum *","mAnam ilAmaiyum vAy veLuppum *","uNNal uRAmaiyum uL melivum *","OdhanIr vaNNan enbAn oruvan **","thaNNanthuzhAy ennum mAlai koNDu *","sUTTath thaNiyum pilamban thannai *","paNNazhiyap baladhEvan venRa *","pANDi vaDaththu ennai uyththiDumin"],["வண்ணம் திரிவும் மனம் குழைவும் *","மானம் இலாமையும் வாய் வெளுப்பும் *","உண்ணல் உறாமையும் உள் மெலிவும் *","ஓதநீர் வண்ணன் என்பான் ஒருவன் **","தண்ணந்துழாய் என்னும் மாலை கொண்டு *","சூட்டத் தணியும் பிலம்பன் தன்னை *","பண்ணழியப் பலதேவன் வென்ற *","பாண்டி வடத்து என்னை உய்த்திடுமின்"],0,"/media/recitation/NAT.12.7.mp3"],[624,624,["kaṟṟiṉam meykkilum meykkap pĕṟṟāṉ *","kāṭu vāḻ cātiyum ākap pĕṟṟāṉ *","paṟṟi uraliṭai yāppum uṇṭāṉ *","pāvikāl̤ uṅkal̤ukku eccuk kŏlo? **","kaṟṟaṉa peci vacavu uṇāte *","kālikal̤ uyya maḻai taṭuttu *","kŏṟṟak kuṭaiyāka enti niṉṟa *","kovarttaṉattu ĕṉṉai uyttiṭumiṉ"],["கற்றினம் மேய்க்கிலும் மேய்க்கப் பெற்றான் *","காடு வாழ் சாதியும் ஆகப் பெற்றான் *","பற்றி உரலிடை யாப்பும் உண்டான் *","பாவிகாள் உங்களுக்கு ஏச்சுக் கொலோ? **","கற்றன பேசி வசவு உணாதே *","காலிகள் உய்ய மழை தடுத்து *","கொற்றக் குடையாக ஏந்தி நின்ற *","கோவர்த்தனத்து என்னை உய்த்திடுமின்"],1,"/media/recitation/NAT.12.8.mp3"],[625,625,["kūṭṭil iruntu kil̤i ĕppotum *","kovintā kovintā ĕṉṟu aḻaikkum *","ūṭṭak kŏṭātu cĕṟuppaṉākil *","ulaku al̤antāṉ ĕṉṟu uyarak kūvum **","nāṭṭil talaippaḻi ĕyti *","uṅkal̤ naṉmai iḻantu talaiyiṭāte *","cūṭṭu uyar māṭaṅkal̤ cūḻntutoṉṟum *","tuvarāpatikku ĕṉṉai uyttiṭumiṉ."],["கூட்டில் இருந்து கிளி எப்போதும் *","கோவிந்தா கோவிந்தா என்று அழைக்கும் *","ஊட்டக் கொடாது செறுப்பனாகில் *","உலகு அளந்தான் என்று உயரக் கூவும் **","நாட்டில் தலைப்பழி எய்தி *","உங்கள் நன்மை இழந்து தலையிடாதே *","சூட்டு உயர் மாடங்கள் சூழ்ந்துதோன்றும் *","துவராபதிக்கு என்னை உய்த்திடுமின்"],1,"/media/recitation/NAT.12.9.mp3"],[626,626,["** mannu madhurai thoDakkamAga *","vaNthuvarApadhi than aLavum *","thannaith thamar uyththup peyya vENDith *","thAzhkuzhalAL thuNindha thuNivai **","ponniyal mADam polindhu thOnRum *","pudhuvaiyar kOn viTTuchiththan kOdhai *","innisaiyAl sonna senjchol mAlai *","Eththa vallArkku iDam vaikunthamE"],["** மன்னு மதுரை தொடக்கமாக *","வண்துவராபதி தன் அளவும் *","தன்னைத் தமர் உய்த்துப் பெய்ய வேண்டித் *","தாழ்குழலாள் துணிந்த துணிவை **","பொன்னியல் மாடம் பொலிந்து தோன்றும் *","புதுவையர் கோன் விட்டுசித்தன் கோதை *","இன்னிசையால் சொன்ன செஞ்சொல் மாலை *","ஏத்த வல்லார்க்கு இடம் வைகுந்தமே"],0,"/media/recitation/NAT.12.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","12 maRRirunthIrkatku [617-626].mp3",617,626]},{"he":["padhinmUnRAm thirumozhi - kaNNan ennum","thalaivi kaNNan aNindha ADai mudhaliyavaRRAl than vATTaththaith thaNikka vENDudhal"],"ht":["பதின்மூன்றாம் திருமொழி - கண்ணன் என்னும்","தலைவி கண்ணன் அணிந்த ஆடை முதலியவற்றால்","தன் வாட்டத்தைத் தணிக்க வேண்டுதல்"],"ae":"aDivaravu: kaNNan pAl kanjchai ArE azhil naDai veRRi uLLE kommai allal paTTi","at":"அடிவரவு: கண்ணன் பால் கஞ்சை ஆரே அழில் நடை வெற்றி உள்ளே கொம்மை அல்லல் பட்டி","p":[[627,627,["** kaNNan ennum karundheyvam * kATchi pazhagik kiDappEnai *","puNNil puLip peydhAR pOlap * puRa ninRu azhagu pEsAdhE **","peNNin varuththam aRiyAdha * perumAn araiyil pIthaga","vaNNa ADai koNDu * ennai vATTam thaNiya vIsIrE"],["** கண்ணன் என்னும் கருந்தெய்வம் * காட்சி பழகிக் கிடப்பேனை *","புண்ணில் புளிப் பெய்தாற் போலப் * புற நின்று அழகு பேசாதே **","பெண்ணின் வருத்தம் அறியாத * பெருமான் அரையில் பீதக","வண்ண ஆடை கொண்டு * என்னை வாட்டம் தணிய வீசீரே"],0,"/media/recitation/NAT.13.1.mp3"],[628,628,["pAl Alilaiyil thuyil koNDa * paraman valaippaTTu irundhEnai *","vElAl thunnam peythAR pOl * vENDiRRu ellAm pEsAdhE **","kOlAl nirai mEyththu AyanAyk * kuDandhaik kiDandha kuDamADi *","nIlAr thaNNanthuzhAy koNDu * en neRimen kuzhal mEl sUTTIrE"],["பால் ஆலிலையில் துயில் கொண்ட * பரமன் வலைப்பட்டு இருந்தேனை *","வேலால் துன்னம் பெய்தாற் போல் * வேண்டிற்று எல்லாம் பேசாதே **","கோலால் நிரை மேய்த்து ஆயனாய்க் * குடந்தைக் கிடந்த குடமாடி *","நீலார் தண்ணந்துழாய் கொண்டு * என் நெறிமென் குழல் மேல் சூட்டீரே"],0,"/media/recitation/NAT.13.2.mp3"],[629,629,["kanjchaik kAyndha karuvilli * kaDaikkaN ennum siRaik kOlAl *","nenjchu UDuruva vEvuNDu * nilaiyum thaLarndhu naivEnai **","anjchEl ennAn avan oruvan * avan mArvaNindha vanamAlai *","vanjchiyAdhE tharumAgil * mArvil koNarndhu puraTTIrE"],["கஞ்சைக் காய்ந்த கருவில்லி * கடைக்கண் என்னும் சிறைக் கோலால் *","நெஞ்சு ஊடுருவ வேவுண்டு * நிலையும் தளர்ந்து நைவேனை **","அஞ்சேல் என்னான் அவன் ஒருவன் * அவன் மார்வணிந்த வனமாலை *","வஞ்சியாதே தருமாகில் * மார்வில் கொணர்ந்து புரட்டீரே"],0,"/media/recitation/NAT.13.3.mp3"],[630,630,["ArE ulagaththu ARRuvAr? * AyarpADi kavarndhu uNNum *","kArERu uzhakka uzhakkuNDu * thaLarndhum muRindhum kiDappEnai **","ArAvamudham anaiyAn than * amudha vAyil URiya *","nIr thAn koNarndhu pularAmE * parukki iLaippai nIkkIrE"],["ஆரே உலகத்து ஆற்றுவார்? * ஆயர்பாடி கவர்ந்து உண்ணும் *","காரேறு உழக்க உழக்குண்டு * தளர்ந்தும் முறிந்தும் கிடப்பேனை **","ஆராவமுதம் அனையான் தன் * அமுத வாயில் ஊறிய *","நீர் தான் கொணர்ந்து புலராமே * பருக்கி இளைப்பை நீக்கீரே"],0,"/media/recitation/NAT.13.4.mp3"],[631,631,["azhilum thozhilum uruk kATTAn * anjchEl ennAn avan oruvan *","thazhuvi muzhusip pugundhu ennaich * suRRich suzhanRu pOgAnAl **","thazhaiyin pozhil vAy niraip pinnE * neDumAl Udhi varuginRa *","kuzhalin thoLai vAy nIr koNDu * kuLira mugaththuth thaDavIrE"],["அழிலும் தொழிலும் உருக் காட்டான் * அஞ்சேல் என்னான் அவன் ஒருவன் *","தழுவி முழுசிப் புகுந்து என்னைச் * சுற்றிச் சுழன்று போகானால் **","தழையின் பொழில் வாய் நிரைப் பின்னே * நெடுமால் ஊதி வருகின்ற *","குழலின் தொளை வாய் நீர் கொண்டு * குளிர முகத்துத் தடவீரே"],0,"/media/recitation/NAT.13.5.mp3"],[632,632,["naDai onRu illA ulagaththu * nandhagOpan magan ennum *","koDiya kaDiya thirumAlAl * kuLappukkURu koLappaTTu **","puDaiyum peyarakillEn nAn * pOTkan midhiththa aDippATTil *","poDith thAn koNarndhu pUsIrgaL * pOgA uyir en uDambaiyE"],["நடை ஒன்று இல்லா உலகத்து * நந்தகோபன் மகன் என்னும் *","கொடிய கடிய திருமாலால் * குளப்புக்கூறு கொளப்பட்டு **","புடையும் பெயரகில்லேன் நான் * போட்கன் மிதித்த அடிப்பாட்டில் *","பொடித் தான் கொணர்ந்து பூசீர்கள் * போகா உயிர் என் உடம்பையே"],0,"/media/recitation/NAT.13.6.mp3"],[633,633,["veRRik karuLak koDiyAn than * mImIdhADA ulagaththu *","veRRa veRidhE peRRa thAy * vEmbEyAga vaLarththALE **","kuRRam aRRa mulai thannaik * kumaran kOlap paNaith thOLODu *","aRRa kuRRam avai thIra * aNaiya amukkik kaTTIrE"],["வெற்றிக் கருளக் கொடியான் தன் * மீமீதாடா உலகத்து *","வெற்ற வெறிதே பெற்ற தாய் * வேம்பேயாக வளர்த்தாளே **","குற்றம் அற்ற முலை தன்னைக் * குமரன் கோலப் பணைத் தோளோடு *","அற்ற குற்றம் அவை தீர * அணைய அமுக்கிக் கட்டீரே"],0,"/media/recitation/NAT.13.7.mp3"],[634,634,["uLLE urugi naivEnai * uLaLO ilaLO ennAdha *","koLLai koLLik kuRumbanaik * gOvarththananaik kaNDakkAl **","koLLum payan onRu illAdha * konggai thannaik kizhanggODum *","aLLip paRiththiTTu avan mArvil eRindhu * en azhalai thIrvEnE"],["உள்ளே உருகி நைவேனை * உளளோ இலளோ என்னாத *","கொள்ளை கொள்ளிக் குறும்பனைக் * கோவர்த்தனனைக் கண்டக்கால் **","கொள்ளும் பயன் ஒன்று இல்லாத * கொங்கை தன்னைக் கிழங்கோடும் *","அள்ளிப் பறித்திட்டு அவன் மார்வில் எறிந்து * என் அழலை தீர்வேனே"],0,"/media/recitation/NAT.13.8.mp3"],[635,635,["kŏmmai mulaikal̤ iṭar tīrak * kovintaṟku or kuṟṟeval *","immaip piṟavi cĕyyāte * iṉip poyc cĕyyum tavamtāṉ ĕṉ? **","cĕmmai uṭaiya tirumārvil * certtāṉeṉum ŏru ñāṉṟu *","mĕymmai cŏlli mukam nokki * viṭaitāṉ tarumel mika naṉṟe"],["கொம்மை முலைகள் இடர் தீரக் * கோவிந்தற்கு ஓர் குற்றேவல் *","இம்மைப் பிறவி செய்யாதே * இனிப் போய்ச் செய்யும் தவம்தான் என்? **","செம்மை உடைய திருமார்வில் * சேர்த்தானேனும் ஒரு ஞான்று *","மெய்ம்மை சொல்லி முகம் நோக்கி * விடைதான் தருமேல் மிக நன்றே"],1,"/media/recitation/NAT.13.9.mp3"],[636,636,["** allal viLaiththa perumAnai * AyarpADikku aNiviLakkai *","villi pudhuvai nagar nambi * viTTuchiththan viyan kOdhai **","villaith tholaiththa puruvaththAL * vETkai uRRu miga virumbum *","sollaith thudhikka vallArgaL * thunbak kaDaluL thuvaLArE"],["** அல்லல் விளைத்த பெருமானை * ஆயர்பாடிக்கு அணிவிளக்கை *","வில்லி புதுவை நகர் நம்பி * விட்டுசித்தன் வியன் கோதை **","வில்லைத் தொலைத்த புருவத்தாள் * வேட்கை உற்று மிக விரும்பும் *","சொல்லைத் துதிக்க வல்லார்கள் * துன்பக் கடலுள் துவளாரே"],0,"/media/recitation/NAT.13.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","13 kaNNanennum [627-636].mp3",627,636]},{"he":["padhinAnkAm thirumozhi - paTTi mEyndhu","virundhAvanaththE paramanaik kaNDamai kURudhal"],"ht":["பதினான்காம் திருமொழி - பட்டி மேய்ந்து","விருந்தாவனத்தே பரமனைக் கண்டமை கூறுதல்"],"ae":"aDivaravu: paTTi anungga mAl kArththaN mAdhavan dharumam poruththam veLiya nATTai parunthAL iruL","at":"அடிவரவு: பட்டி அனுங்க மால் கார்த்தண் மாதவன் தருமம் பொருத்தம் வெளிய நாட்டை பருந்தாள் இருள்","p":[[637,637,["** paTTi mEyndhOr kAr ERu * paladhEvaRku Or kIzhk kanRAy *","iTTIRiTTu viLaiyADi * inggE pOdhak kaNDIrE? **","iTTamAna pasukkaLai * inidhu maRiththu nIrUTTi *","viTTuk koNDu viLaiyADa * virundhAvanaththE kaNDOmE"],["** பட்டி மேய்ந்தோர் கார் ஏறு * பலதேவற்கு ஓர் கீழ்க் கன்றாய் *","இட்டீறிட்டு விளையாடி * இங்கே போதக் கண்டீரே? **","இட்டமான பசுக்களை * இனிது மறித்து நீரூட்டி *","விட்டுக் கொண்டு விளையாட * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.1.mp3"],[638,638,["aṉuṅka ĕṉṉaip pirivu cĕytu * āyarpāṭi kavarntu uṇṇum *","kuṇuṅku nāṟik kuṭṭeṟṟaik * kovarttaṉaṉaik kaṇṭīre? **","kaṇaṅkal̤oṭu miṉ mekam * kalantāl pola vaṉamālai *","miṉuṅka niṉṟu vil̤aiyāṭa * viruntāvaṉatte kaṇṭome"],["அனுங்க என்னைப் பிரிவு செய்து * ஆயர்பாடி கவர்ந்து உண்ணும் *","குணுங்கு நாறிக் குட்டேற்றைக் * கோவர்த்தனனைக் கண்டீரே? **","கணங்களோடு மின் மேகம் * கலந்தால் போல வனமாலை *","மினுங்க நின்று விளையாட * விருந்தாவனத்தே கண்டோமே"],1,"/media/recitation/NAT.14.2.mp3"],[639,639,["mAlAyp piRandha nambiyai * mAlE seyyum maNALanai *","ElAp poygaL uraippAnai * inggE pOdhak kaNDIrE? **","mElAl parandha veyil kAppAn * vinathai siRuvan siRagu ennum *","mElAppin kIzh varuvAnai * virundhAvanaththE kaNDOmE"],["மாலாய்ப் பிறந்த நம்பியை * மாலே செய்யும் மணாளனை *","ஏலாப் பொய்கள் உரைப்பானை * இங்கே போதக் கண்டீரே? **","மேலால் பரந்த வெயில் காப்பான் * வினதை சிறுவன் சிறகு என்னும் *","மேலாப்பின் கீழ் வருவானை * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.3.mp3"],[640,640,["kārt taṇ kamalak kaṇ ĕṉṉum * nĕṭuṅkayiṟu paṭutti ĕṉṉai *","īrttuk kŏṇṭu vil̤aiyāṭum * īcaṉ taṉṉaik kaṇṭīre? **","portta muttiṉ kuppāyap * pukar māl yāṉaik kaṉṟe pol *","verttu niṉṟu vil̤aiyāṭa * viruntāvaṉatte kaṇṭome"],["கார்த் தண் கமலக் கண் என்னும் * நெடுங்கயிறு படுத்தி என்னை *","ஈர்த்துக் கொண்டு விளையாடும் * ஈசன் தன்னைக் கண்டீரே? **","போர்த்த முத்தின் குப்பாயப் * புகர் மால் யானைக் கன்றே போல் *","வேர்த்து நின்று விளையாட * விருந்தாவனத்தே கண்டோமே"],1,"/media/recitation/NAT.14.4.mp3"],[641,641,["** mAdhavan en maNiyinai * valaiyil pizhaiththa panRi pOl *","Edhum onRum koLath thArA * Isan thannaik kaNDIrE? **","pIdhaga ADai uDai thAzhap * perungkAr mEgak kanRE pOl *","vIdhi Ara varuvAnai * virundhAvanaththE kaNDOmE"],["** மாதவன் என் மணியினை * வலையில் பிழைத்த பன்றி போல் *","ஏதும் ஒன்றும் கொளத் தாரா * ஈசன் தன்னைக் கண்டீரே? **","பீதக ஆடை உடை தாழப் * பெருங்கார் மேகக் கன்றே போல் *","வீதி ஆர வருவானை * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.5.mp3"],[642,642,["dharumam aRiyAk kuRumbanaith * than kaich sArnggam adhuvE pOl *","puruva vaTTam azhagiya * poruththam iliyaik kaNDIrE? **","uruvu karidhAy mugam seydhAy * udhayap paruppadhaththin mEl *","viriyum kadhirE pOlvAnai * virundhAvanaththE kaNDOmE"],["தருமம் அறியாக் குறும்பனைத் * தன் கைச் சார்ங்கம் அதுவே போல் *","புருவ வட்டம் அழகிய * பொருத்தம் இலியைக் கண்டீரே? **","உருவு கரிதாய் முகம் செய்தாய் * உதயப் பருப்பதத்தின் மேல் *","விரியும் கதிரே போல்வானை * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.6.mp3"],[643,643,["poruththam uDaiya nambiyaip * puRam pOl uLLum kariyAnai *","karuththaip pizhaiththu ninRa * akkaru mAmugilaik kaNDIrE? **","aruththith thArA kaNanggaLAl * Arap perugu vAnam pOl *","viruththam peridhAy varuvAnai * virundhAvanaththE kaNDOmE"],["பொருத்தம் உடைய நம்பியைப் * புறம் போல் உள்ளும் கரியானை *","கருத்தைப் பிழைத்து நின்ற * அக்கரு மாமுகிலைக் கண்டீரே? **","அருத்தித் தாரா கணங்களால் * ஆரப் பெருகு வானம் போல் *","விருத்தம் பெரிதாய் வருவானை * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.7.mp3"],[644,644,["veLiya sanggu onRu uDaiyAnaip * pIdhaga ADai uDaiyAnai *","aLi nankuDaiya thirumAlai * AzhiyAnaik kaNDIrE? **","kaLi vaNDu enggum kalandhAR pOl * kamazh pUngkuzhalgaL thaDanthOL mEl *","miLira ninRu viLaiyADa * virundhAvanaththE kaNDOmE"],["வெளிய சங்கு ஒன்று உடையானைப் * பீதக ஆடை உடையானை *","அளி நன்குடைய திருமாலை * ஆழியானைக் கண்டீரே? **","களி வண்டு எங்கும் கலந்தாற் போல் * கமழ் பூங்குழல்கள் தடந்தோள் மேல் *","மிளிர நின்று விளையாட * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.8.mp3"],[645,645,["** nATTaip paDai enRu ayan mudhalAth thandha * naLir mAmalar undhi *","vITTaip paNNi viLaiyADum * vimalan thannaik kaNDIrE? **","kATTai nADith thEnuganum * kaLiRum puLLum uDan maDiya *","vETTai ADi varuvAnai * virundhAvanaththE kaNDOmE"],["** நாட்டைப் படை என்று அயன் முதலாத் தந்த * நளிர் மாமலர் உந்தி *","வீட்டைப் பண்ணி விளையாடும் * விமலன் தன்னைக் கண்டீரே? **","காட்டை நாடித் தேனுகனும் * களிறும் புள்ளும் உடன் மடிய *","வேட்டை ஆடி வருவானை * விருந்தாவனத்தே கண்டோமே"],0,"/media/recitation/NAT.14.9.mp3"],[646,646,["** parunthAL kaLiRRukku aruL seydha * paraman thannai * pArin mEl","virundhAvanaththE kaNDamai * viTTuchiththan kOdhai sol **","marundhAm enRu tham manaththE * vaiththuk koNDu vAzhvArgaL *","perunthAL uDaiya pirAn aDik kIzhp * piriyAdhu enRum iruppArE"],["** பருந்தாள் களிற்றுக்கு அருள் செய்த * பரமன் தன்னை * பாரின் மேல்","விருந்தாவனத்தே கண்டமை * விட்டுசித்தன் கோதை சொல் **","மருந்தாம் என்று தம் மனத்தே * வைத்துக் கொண்டு வாழ்வார்கள் *","பெருந்தாள் உடைய பிரான் அடிக் கீழ்ப் * பிரியாது என்றும் இருப்பாரே"],0,"/media/recitation/NAT.14.10.mp3"]],"box":["https://app.box.com/s/6jjke7uxzwccmhgwt376qmglcbk8fhh2","14 patti mEynthu [637-646].mp3",637,646]}]}