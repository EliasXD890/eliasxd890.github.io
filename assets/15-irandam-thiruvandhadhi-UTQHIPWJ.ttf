{"id":"15-irandam-thiruvandhadhi","name":"Irandam Thiruvandhadhi","nameTa":"இரண்டாம் திருவந்தாதி","alvar":"Bhoothaththazhvar","alvarTa":"பூதத்தாழ்வார்","src":"iraNDAm thiruvandhAdhi","ayiram":3,"start":2182,"end":2281,"thaniyans":[{"le":["dasaka aDivaravu: vaiyam vAy ninRu puri kunRu eLidhil ulagum nanRu AL Un anbu","iraNDAm thiruvandhAdhi thaniyan","thirukkurugaippirAn piLLAn aruLich cheydhadhu"],"lt":["இரண்டாம் திருவந்தாதி தனியன்","திருக்குருகைப்பிரான் பிள்ளான் அருளிச் செய்தது"],"en":["en piRavi thIra iRainjchinEn innamudhA *","anbE thagaLi aLiththAnai * - nanpugazh sEr","sIdhaththAr muththukkaL sErum * kaDal mallaip","bUthaththAr pon angkazhal"],"ta":["என் பிறவி தீர இறைஞ்சினேன் இன்னமுதா *","அன்பே தகளி அளித்தானை * - நன்புகழ் சேர்","சீதத்தார் முத்துக்கள் சேரும் * கடல் மல்லைப்","பூதத்தார் பொன் அங்கழல்"]}],"sections":[{"he":[],"ht":[],"ae":null,"at":null,"p":[[2182,2182,["** anbE thagaLiyA * ArvamE ney Aga *","inburugu sindhai iDu thiriyA ** - nanburugi","njAnach chuDar viLakkERRinEn * nAraNaRku *","njAnath thamizh purindha nAn"],["** அன்பே தகளியா * ஆர்வமே நெய் ஆக *","இன்புருகு சிந்தை இடு திரியா ** - நன்புருகி","ஞானச் சுடர் விளக்கேற்றினேன் * நாரணற்கு *","ஞானத் தமிழ் புரிந்த நான்"],0,"/media/recitation/IT.1.mp3"],[2183,2183,["njAnaththAl nankuNarndhu * nAraNan than nAmanggaL *","dhAnaththAl maRRavan pEr sARRinAl ** - vAnaththu","aNi amarar * Akkuvikkum aqdhanRE * nanggaL","paNi amarar kOmAn parisu"],["ஞானத்தால் நன்குணர்ந்து * நாரணன் தன் நாமங்கள் *","தானத்தால் மற்றவன் பேர் சாற்றினால் ** - வானத்து","அணி அமரர் * ஆக்குவிக்கும் அஃதன்றே * நங்கள்","பணி அமரர் கோமான் பரிசு"],0,"/media/recitation/IT.2.mp3"],[2184,2184,["parisu naRumalarAl * pARkaDalAn pAdham *","purivAr pugap peRuvar pOlAm ** - purivArgaL","thollamarar kELvith * thulanggoLi sEr thORRaththu *","nallamarar kOmAn nagar"],["பரிசு நறுமலரால் * பாற்கடலான் பாதம் *","புரிவார் புகப் பெறுவர் போலாம் ** - புரிவார்கள்","தொல்லமரர் கேள்வித் * துலங்கொளி சேர் தோற்றத்து *","நல்லமரர் கோமான் நகர்"],0,"/media/recitation/IT.3.mp3"],[2185,2185,["nagar izhaiththu niththilaththu * nANmalar koNDu * AnggE","thigazhu maNi vayiram sErththu ** - nigar illAp","paingkamalam Endhip * paNindhEn panimalarAL *","anggam valam koNDAn aDi"],["நகர் இழைத்து நித்திலத்து * நாண்மலர் கொண்டு * ஆங்கே","திகழு மணி வயிரம் சேர்த்து ** - நிகர் இல்லாப்","பைங்கமலம் ஏந்திப் * பணிந்தேன் பனிமலராள் *","அங்கம் வலம் கொண்டான் அடி"],0,"/media/recitation/IT.4.mp3"],[2186,2186,["aDi mUnRil ivvulagam * anRu aLandhAy pOlum *","aDi mUnRu irandhu avani koNDAy ** - paDi ninRa","nIr Odha mEni * neDumAlE! * nin aDiyai","yAr Odha vallAr aRindhu?"],["அடி மூன்றில் இவ்வுலகம் * அன்று அளந்தாய் போலும் *","அடி மூன்று இரந்து அவனி கொண்டாய் ** - படி நின்ற","நீர் ஓத மேனி * நெடுமாலே! * நின் அடியை","யார் ஓத வல்லார் அறிந்து?"],0,"/media/recitation/IT.5.mp3"],[2187,2187,["aRindhu aindhum uL aDakki * Aymalar koNDu * Arvam","seRindha manaththarAych sevvE ** - aRindhavan than","pEr Odhi Eththum * perunthavaththOr kANbarE *","kAr Odha vaNNan kazhal"],["அறிந்தைந்தும் உள் அடக்கி * ஆய்மலர் கொண்டு * ஆர்வம்","செறிந்த மனத்தராய்ச் செவ்வே ** - அறிந்தவன் தன்","பேர் ஓதி ஏத்தும் * பெருந்தவத்தோர் காண்பரே *","கார் ஓத வண்ணன் கழல்"],0,"/media/recitation/IT.6.mp3"],[2188,2188,["kazhal ĕṭuttu vāy maṭittuk * kaṇ cuzhaṉṟu * māṟṟār","azhal ĕṭutta cintaiyarāy añca ** - tazhal ĕṭutta","por āzhi entiṉāṉ * pŏṉ malarc cevaṭiyai *","or āzhi nĕñce! ukantu -"],["கழல் எடுத்து வாய் மடித்துக் * கண் சுழன்று * மாற்றார்","அழல் எடுத்த சிந்தையராய் அஞ்ச ** தழல் எடுத்த","போர் ஆழி ஏந்தினான் * பொன் மலர்ச் சேவடியை *","ஓர் ஆழி நெஞ்சே! உகந்து"],1,"/media/recitation/IT.7.mp3"],[2189,2189,["ugandhu unnai vAnggi * oLi niRangkoL konggai *","agam kuLira uN enRAL Avi ** - ugandhu","mulai uNbAy pOlE * munindhu uNDAy * nIyum","alai paNbAl AnamaiyAl anRu"],["உகந்து உன்னை வாங்கி * ஒளி நிறங்கொள் கொங்கை *","அகம் குளிர உண் என்றாள் ஆவி ** - உகந்து","முலை உண்பாய் போலே * முனிந்து உண்டாய் * நீயும்","அலை பண்பால் ஆனமையால் அன்று"],0,"/media/recitation/IT.8.mp3"],[2190,2190,["anRu adhu kaNDu anjchAdha * Aychchi unakku iranggi *","ninRu mulai thandha innIrmaikku ** - anRu","varan muRaiyAl nI aLandha * mAkaDal sUzh njAlam *","perumuRaiyAl eydhumO pErththu?"],["அன்று அது கண்டு அஞ்சாத * ஆய்ச்சி உனக்கு இரங்கி *","நின்று முலை தந்த இந்நீர்மைக்கு ** - அன்று","வரன் முறையால் நீ அளந்த * மாகடல் சூழ் ஞாலம் *","பெருமுறையால் எய்துமோ பேர்த்து?"],0,"/media/recitation/IT.9.mp3"],[2191,2191,["pErththanai * mA sagaDam piLLaiyAy * maN irandhu","kAththanai * palluyirum kAvalanE! ** - Eththiya","nA uDaiyEn pU uDaiyEn * nin uLLi ninRamaiyAl *","kA aDiyEn paTTa kaDai"],["பேர்த்தனை * மா சகடம் பிள்ளையாய் * மண் இரந்து","காத்தனை * பல்லுயிரும் காவலனே! ** - ஏத்திய","நா உடையேன் பூ உடையேன் * நின் உள்ளி நின்றமையால் *","கா அடியேன் பட்ட கடை"],0,"/media/recitation/IT.10.mp3"],[2192,2192,["kaDai ninRu amarar * kazhal thozhudhu ** nALum","iDai ninRa inbaththar Avar ** - puDai ninRa","nIr Odha mEni * neDumAlE! * nin aDiyai","yAr Odha vallAr avar?"],["கடை நின்று அமரர் * கழல் தொழுது ** நாளும்","இடை நின்ற இன்பத்தர் ஆவர் ** - புடை நின்ற","நீர் ஓத மேனி * நெடுமாலே! * நின் அடியை","யார் ஓத வல்லார் அவர்?"],0,"/media/recitation/IT.11.mp3"],[2193,2193,["avar ivar enRillai * aravaNaiyAn pAdham *","evar vaNanggi EththAdhAr eNNil ** - pavarum","sezhungkadhirOn oNmalarOn * kaN nudhalOn anRE? *","thozhum thagaiyAr nALum thoDarndhu"],["அவர் இவர் என்றில்லை * அரவணையான் பாதம் *","எவர் வணங்கி ஏத்தாதார் எண்ணில் ** - பவரும்","செழுங்கதிரோன் ஒண்மலரோன் * கண் நுதலோன் அன்றே? *","தொழும் தகையார் நாளும் தொடர்ந்து"],0,"/media/recitation/IT.12.mp3"],[2194,2194,["thoDar eDuththa mAl yAnai * sUzh kayam pukkanjchi *","paDar eDuththa paingkamalam koNDu ** - anRu iDar aDukka","AzhiyAn * pAdham paNindhanRE? * vAnavar kOn","pAzhi thAn eydhiRRup paNDu"],["தொடர் எடுத்த மால் யானை * சூழ் கயம் புக்கஞ்சி *","படர் எடுத்த பைங்கமலம் கொண்டு ** - அன்று இடர் அடுக்க","ஆழியான் * பாதம் பணிந்தன்றே? * வானவர் கோன்","பாழி தான் எய்திற்றுப் பண்டு"],0,"/media/recitation/IT.13.mp3"],[2195,2195,["paNDu ipperum padhiyai Akki * pazhi pAvam","koNDu * inggu vAzhvAraik kURAdhE ** - eNthisaiyum","pErththa karam nAnkuDaiyAn * pEr Odhip pEdhaigAL! *","thIrththakarar Amin thirindhu"],["பண்டு இப்பெரும் பதியை ஆக்கி * பழி பாவம்","கொண்டு * இங்கு வாழ்வாரைக் கூறாதே ** - எண்திசையும்","பேர்த்த கரம் நான்குடையான் * பேர் ஓதிப் பேதைகாள்! *","தீர்த்தகரர் ஆமின் திரிந்து"],0,"/media/recitation/IT.14.mp3"],[2196,2196,["thirindhadhu venjchamaththuth * thEr kaDavi * anRu","pirindhadhu * sIthaiyai mAn pin pOy ** - purindhadhuvum","kaN paLLi koLLa * azhagiyadhE! * nAgaththin","thaNpaLLi koLvAn thanakku"],["திரிந்தது வெஞ்சமத்துத் * தேர் கடவி * அன்று","பிரிந்தது * சீதையை மான் பின் போய் ** - புரிந்ததுவும்","கண் பள்ளி கொள்ள * அழகியதே! * நாகத்தின்","தண்பள்ளி கொள்வான் தனக்கு"],0,"/media/recitation/IT.15.mp3"],[2197,2197,["thanakkaDimai paTTadhu * thAn aRiyAnElum *","manaththaDaiya vaippadhAm mAlai ** - vanath thiDarai","EriyAm vaNNam * iyaRRum idhu allAl *","mAri yAr peygiRpAr maRRu?"],["தனக்கடிமை பட்டது * தான் அறியானேலும் *","மனத்தடைய வைப்பதாம் மாலை ** - வனத் திடரை","ஏரியாம் வண்ணம் * இயற்றும் இது அல்லால் *","மாரி யார் பெய்கிற்பார் மற்று?"],0,"/media/recitation/IT.16.mp3"],[2198,2198,["maRRAr iyal Avar? * vAnavar kOn mAmalarOn *","suRRum vaNanggum thozhilAnai ** - oRRaip","piRai irundha * senjchaDaiyAn pin senRu * mAlaik","kuRai irandhu thAn muDiththAn koNDu"],["மற்றார் இயல் ஆவர்? * வானவர் கோன் மாமலரோன் *","சுற்றும் வணங்கும் தொழிலானை ** - ஒற்றைப்","பிறை இருந்த * செஞ்சடையான் பின் சென்று * மாலைக்","குறை இரந்து தான் முடித்தான் கொண்டு"],0,"/media/recitation/IT.17.mp3"],[2199,2199,["koNDadhu ulagam * kuRaL uruvAyk kOL ariyAy *","oNthiRalOn mArvaththu ugir vaiththadhu ** - uNDadhuvum","thAn kaDantha Ezh ulagE * thAmaraikkaN mAl oru nAL *","vAn kaDandhAn seydha vazhakku"],["கொண்டது உலகம் * குறள் உருவாய்க் கோள் அரியாய் *","ஒண்திறலோன் மார்வத்து உகிர் வைத்தது ** - உண்டதுவும்","தான் கடந்த ஏழ் உலகே * தாமரைக்கண் மால் ஒரு நாள் *","வான் கடந்தான் செய்த வழக்கு"],0,"/media/recitation/IT.18.mp3"],[2200,2200,["vazhakkanRu kaNDAy * vali sagaDam seRRAy *","vazhakkenRu nI madhikka vENDA ** - kuzhak kanRu","thI viLavin kAykkeRindha * thImai thirumAlE! *","pAr viLanggach seydhAy pazhi"],["வழக்கன்று கண்டாய் * வலி சகடம் செற்றாய் *","வழக்கென்று நீ மதிக்க வேண்டா ** - குழக் கன்று","தீ விளவின் காய்க்கெறிந்த * தீமை திருமாலே! *","பார் விளங்கச் செய்தாய் பழி"],0,"/media/recitation/IT.19.mp3"],[2201,2201,["pazhi pAvam kai agaRRip * palkAlum ninnai *","vazhi vAzhvAr vAzhvarAm mAdhO ** - vazhu inRi","nAraNan than nAmanggaL * nankuNarndhu nankEththum *","kAraNanggaL thAm uDaiyAr thAm"],["பழி பாவம் கை அகற்றிப் * பல்காலும் நின்னை *","வழி வாழ்வார் வாழ்வராம் மாதோ ** - வழு இன்றி","நாரணன் தன் நாமங்கள் * நன்குணர்ந்து நன்கேத்தும் *","காரணங்கள் தாம் உடையார் தாம்"],0,"/media/recitation/IT.20.mp3"],[2202,2202,["thAm uLarE * tham uLLam uL uLadhE * thAmaraiyin","pU uLadhE * Eththum pozhudhu uNDE ** - vAman","thiru maruvu * thAL maruvu senniyarE * sevvE","arunaragam sErvadhu aridhu"],["தாம் உளரே * தம் உள்ளம் உள் உளதே * தாமரையின்","பூ உளதே * ஏத்தும் பொழுதுண்டே ** - வாமன்","திரு மருவு * தாள் மருவு சென்னியரே * செவ்வே","அருநரகம் சேர்வது அரிது"],0,"/media/recitation/IT.21.mp3"],[2203,2203,["ariyadhu eLidhAgum * ARRalAl mARRi *","peruga muyalvAraip peRRAl ** - kariyadhOr","veNkOTTu mAl yAnai * venRu muDiththanRE *","thaNkOTTu mA malarAl thAzhndhu"],["அரியது எளிதாகும் * ஆற்றலால் மாற்றி *","பெருக முயல்வாரைப் பெற்றால் ** - கரியதோர்","வெண்கோட்டு மால் யானை * வென்று முடித்தன்றே *","தண்கோட்டு மா மலரால் தாழ்ந்து"],0,"/media/recitation/IT.22.mp3"],[2204,2204,["thAzhndhu varam koNDu * thakka vagaigaLAl *","vAzhndhu kazhivArai vAzhvikkum ** - thAzhndha","viLangkanikkuk * kanRu eRindhu vERRuruvAy * njAlam","aLandhu aDik kIzhk koNDa avan"],["தாழ்ந்து வரம் கொண்டு * தக்க வகைகளால் *","வாழ்ந்து கழிவாரை வாழ்விக்கும் ** - தாழ்ந்த","விளங்கனிக்குக் * கன்று எறிந்து வேற்றுருவாய் * ஞாலம்","அளந்து அடிக் கீழ்க் கொண்ட அவன்"],0,"/media/recitation/IT.23.mp3"],[2205,2205,["avan kaNDAy nannenjchE! * Ar aruLum kEDum *","avan kaNDAy aimpulanAy ninRAn ** - avan kaNDAy","kARRuth thI nIr vAn * karuvarai maN * kAr Odha","sIRRath thI AvAnum senRu"],["அவன் கண்டாய் நன்னெஞ்சே! * ஆர் அருளும் கேடும் *","அவன் கண்டாய் ஐம்புலனாய் நின்றான் ** - அவன் கண்டாய்","காற்றுத் தீ நீர் வான் * கருவரை மண் * கார் ஓத","சீற்றத் தீ ஆவானும் சென்று"],0,"/media/recitation/IT.24.mp3"],[2206,2206,["senRadhu ilanggai mEl * sevvE than sIRRaththAl *","konRadhu irAvaNanaik kURungkAl ** - ninRadhuvum","vEy Onggu thaN sAral * vEngkaDamE * viNNavar tham","vAy Onggu thol pugazhAn vandhu"],["சென்றது இலங்கை மேல் * செவ்வே தன் சீற்றத்தால் *","கொன்றது இராவணனைக் கூறுங்கால் ** - நின்றதுவும்","வேய் ஓங்கு தண் சாரல் * வேங்கடமே * விண்ணவர் தம்","வாய் ஓங்கு தொல் புகழான் வந்து"],0,"/media/recitation/IT.25.mp3"],[2207,2207,["vandhiththavanai * vazhi ninRa aimpUdham *","aindhum agaththaDakki ArvamAy ** - undhip","paDi amarar vElaiyAn * paNDu amararkku Indha *","paDi amarar vAzhum padhi"],["வந்தித்து அவனை * வழி நின்ற ஐம்பூதம் *","ஐந்தும் அகத்தடக்கி ஆர்வமாய் ** - உந்திப்","படி அமரர் வேலையான் * பண்டு அமரர்க்கு ஈந்த *","படி அமரர் வாழும் பதி"],0,"/media/recitation/IT.26.mp3"],[2208,2208,["padhi amaindhu nADip * paruththezhundha sindhai *","madhi urinjchi vAn mugaDu nOkki ** - kadhi miguththu ang","kOl thEDi ODum * kozhundhadhE pOnRadhE *","mAl thEDi ODum manam"],["பதி அமைந்து நாடிப் * பருத்தெழுந்த சிந்தை *","மதி உரிஞ்சி வான் முகடு நோக்கி ** - கதி மிகுத்து அங்","கோல் தேடி ஓடும் * கொழுந்ததே போன்றதே *","மால் தேடி ஓடும் மனம்"],0,"/media/recitation/IT.27.mp3"],[2209,2209,["manaththuLLAn vEngkaDaththAn * mA kaDalAn * maRRum","ninaippariya * nIL aranggaththu uLLAn ** - enaip palarum","dhEvAdhi dhEvan * enappaDuvAn * mun oru nAL","mA vAy piLandha magan"],["மனத்துள்ளான் வேங்கடத்தான் * மா கடலான் * மற்றும்","நினைப்பரிய * நீள் அரங்கத்து உள்ளான் ** - எனைப் பலரும்","தேவாதி தேவன் * எனப்படுவான் * முன் ஒரு நாள்","மா வாய் பிளந்த மகன்"],0,"/media/recitation/IT.28.mp3"],[2210,2210,["magan Agak koNDeDuththAL * mANbAya konggai *","agan Ara uNban enRuNDu ** - maganaith thAy","thERAdha vaNNam * thiruththinAy * then ilanggai","nIRAga eydhazhiththAy! nI"],["மகன் ஆகக் கொண்டெடுத்தாள் * மாண்பாய கொங்கை *","அகன் ஆர உண்பன் என்றுண்டு ** - மகனைத் தாய்","தேறாத வண்ணம் * திருத்தினாய் * தென் இலங்கை","நீறாக எய்தழித்தாய்! நீ"],0,"/media/recitation/IT.29.mp3"],[2211,2211,["nī aṉṟu ulaku al̤antāy * nīṇṭa tirumāle! *","nī aṉṟu ulaku iṭantāy ĕṉparāl ** nī aṉṟu","kār otam muṉ kaṭaintu * piṉ aṭaittāy mā kaṭalai *","per ota meṉip pirāṉ! -"],["நீ அன்று உலகு அளந்தாய் * நீண்ட திருமாலே! *","நீ அன்று உலகு இடந்தாய் என்பரால் ** நீ அன்று","கார் ஓதம் முன் கடைந்து * பின் அடைத்தாய் மா கடலை *","பேர் ஓத மேனிப் பிரான்!"],1,"/media/recitation/IT.30.mp3"],[2212,2212,["pirAn enRu nALum * perum pulari enRum *","kurA naRsezhum pOdhu koNDu ** - varAgaththu","aNi uruvan * pAdham paNiyum avar kaNDIr *","maNi uruvam kANbAr magizhndhu"],["பிரான் என்று நாளும் * பெரும் புலரி என்றும் *","குரா நற்செழும் போது கொண்டு ** - வராகத்து","அணி உருவன் * பாதம் பணியும் அவர் கண்டீர் *","மணி உருவம் காண்பார் மகிழ்ந்து"],0,"/media/recitation/IT.31.mp3"],[2213,2213,["magizhndhadhu sindhai * thirumAlE! * maRRum","magizhndhadhu * un pAdhamE pORRi ** - magizhndhadhu","azhal Azhi sanggam * avai pADi ADum *","thozhil Agam sUzhndhu thuNindhu"],["மகிழ்ந்தது சிந்தை * திருமாலே! * மற்றும்","மகிழ்ந்தது * உன் பாதமே போற்றி ** - மகிழ்ந்தது","அழல் ஆழி சங்கம் * அவை பாடி ஆடும் *","தொழில் ஆகம் சூழ்ந்து துணிந்து"],0,"/media/recitation/IT.32.mp3"],[2214,2214,["thuNindhadhu sindhai * thuzhAy alanggal * anggam","aNindhavan pEr * uLLaththup palkAl ** - paNindhadhuvum","vEy piRanggu sAral * viRal vEngkaDavanaiyE *","vAy thiRanggaL sollum vagai"],["துணிந்தது சிந்தை * துழாய் அலங்கல் * அங்கம்","அணிந்தவன் பேர் * உள்ளத்துப் பல்கால் ** - பணிந்ததுவும்","வேய் பிறங்கு சாரல் * விறல் வேங்கடவனையே *","வாய் திறங்கள் சொல்லும் வகை"],0,"/media/recitation/IT.33.mp3"],[2215,2215,["vagaiyAl avani * irandhu aLandhAy pAdham *","pugaiyAl naRumalarAl munnE ** - miga vAyndha","anbAkki Eththi * aDimaip paTTEn unakku *","en bAkkiyaththAl ini"],["வகையால் அவனி * இரந்து அளந்தாய் பாதம் *","புகையால் நறுமலரால் முன்னே ** - மிக வாய்ந்த","அன்பாக்கி ஏத்தி * அடிமைப் பட்டேன் உனக்கு *","என் பாக்கியத்தால் இனி"],0,"/media/recitation/IT.34.mp3"],[2216,2216,["inidhenbar kAmam * adhanilum ARRa *","inidhenbar thaNNIrum endhAy! ** - inidhenRu","kAma nIr vELAdhu * nin perumai vETparEl *","sEma nIr Agum siRidhu"],["இனிதென்பர் காமம் * அதனிலும் ஆற்ற *","இனிதென்பர் தண்ணீரும் எந்தாய்! ** - இனிதென்று","காம நீர் வேளாது * நின் பெருமை வேட்பரேல் *","சேம நீர் ஆகும் சிறிது"],0,"/media/recitation/IT.35.mp3"],[2217,2217,["siRiyAr perumai * siRidhin kaN eydhum *","aRiyArum thAm aRiyAr Avar ** - aRiyAmai","maN koNDu maN uNDu * maN umizhndha mAyan enRu *","eN koNDu en nenjchE! iru"],["சிறியார் பெருமை * சிறிதின் கண் எய்தும் *","அறியாரும் தாம் அறியார் ஆவர் ** - அறியாமை","மண் கொண்டு மண் உண்டு * மண் உமிழ்ந்த மாயன் என்று *","எண் கொண்டு என் நெஞ்சே! இரு"],0,"/media/recitation/IT.36.mp3"],[2218,2218,["irunthaN kamalaththu * irumalarin uLLE *","thirundhu thisaimuganaith thandhAy! ** - porundhiya nin","pAdhanggaL Eththip * paNiyAvEl * pal piRappum","EdhanggaL ellAm emakku"],["இருந்தண் கமலத்து * இருமலரின் உள்ளே *","திருந்து திசைமுகனைத் தந்தாய்! ** - பொருந்திய நின்","பாதங்கள் ஏத்திப் * பணியாவேல் * பல் பிறப்பும்","ஏதங்கள் எல்லாம் எமக்கு"],0,"/media/recitation/IT.37.mp3"],[2219,2219,["emakkenRu iru nidhiyam * EmAndhirAdhE *","thamakkenRum sArvam aRindhu ** - namakkenRum","mAdhavanE ennum * manam paDaiththu * maRRavan pEr","OdhuvadhE nAvinAl Oththu"],["எமக்கென்று இரு நிதியம் * ஏமாந்திராதே *","தமக்கென்றும் சார்வம் அறிந்து ** - நமக்கென்றும்","மாதவனே என்னும் * மனம் படைத்து * மற்றவன் பேர்","ஓதுவதே நாவினால் ஓத்து"],0,"/media/recitation/IT.38.mp3"],[2220,2220,["Oththin poruL muDivum iththanaiyE * uththaman pEr","Eththum * thiRam aRimin EzhaigAL! ** - Oththadhanai","vallIrEl * nanRadhanai mATTIrEl * mAdhavan pEr","solluvadhE Oththin surukku"],["ஓத்தின் பொருள் முடிவும் இத்தனையே * உத்தமன் பேர்","ஏத்தும் * திறம் அறிமின் ஏழைகாள்! ** - ஓத்ததனை","வல்லீரேல் * நன்றதனை மாட்டீரேல் * மாதவன் பேர்","சொல்லுவதே ஓத்தின் சுருக்கு"],0,"/media/recitation/IT.39.mp3"],[2221,2221,["surukkAga vAnggich * sulAvi ninRu * aiyAr","nerukkA mun * nIr ninaimin kaNDIr ** - thirup polindha","AgaththAn * pAdham aRindhum aRiyAdha *","bOgaththAl illai poruL"],["சுருக்காக வாங்கிச் * சுலாவி நின்று * ஐயார்","நெருக்கா முன் * நீர் நினைமின் கண்டீர் ** - திருப் பொலிந்த","ஆகத்தான் * பாதம் அறிந்தும் அறியாத *","போகத்தால் இல்லை பொருள்"],0,"/media/recitation/IT.40.mp3"],[2222,2222,["poruLAl amar ulagam * pukkiyalal AgAdhu *","aruLAl aRam aruLum anRE? ** - aruLAlE","mA maRaiyOrkkIndha * maNivaNNan pAdhamE *","nI maRavEl nenjchE! ninai"],["பொருளால் அமர் உலகம் * புக்கியலல் ஆகாது *","அருளால் அறம் அருளும் அன்றே? ** - அருளாலே","மா மறையோர்க்கீந்த * மணிவண்ணன் பாதமே *","நீ மறவேல் நெஞ்சே! நினை"],0,"/media/recitation/IT.41.mp3"],[2223,2223,["ninaippan thirumAlai * nINDa thOL kANa *","ninaippAr piRapponRum nErAr ** - manaippAl","piRandhAr piRandheydhum * pEr inbam ellAm *","thuRandhAr thozhudhAr aththOL"],["நினைப்பன் திருமாலை * நீண்ட தோள் காண *","நினைப்பார் பிறப்பொன்றும் நேரார் ** - மனைப்பால்","பிறந்தார் பிறந்தெய்தும் * பேர் இன்பம் எல்லாம் *","துறந்தார் தொழுதார் அத்தோள்"],0,"/media/recitation/IT.42.mp3"],[2224,2224,["thOL iraNDu eTTEzhum * mUnRum muDi anaiththum *","thAL iraNDum vIzhach * saram thurandhAn - ** thAL iraNDum","Ar thozhuvAr pAdham * avai thozhuvadhanRE? * en","sIr kezhu thOL seyyum siRappu"],["தோள் இரண்டு எட்டேழும் * மூன்றும் முடி அனைத்தும் *","தாள் இரண்டும் வீழச் * சரம் துரந்தான் - ** தாள் இரண்டும்","ஆர் தொழுவார் பாதம் * அவை தொழுவதன்றே? * என்","சீர் கெழு தோள் செய்யும் சிறப்பு"],0,"/media/recitation/IT.43.mp3"],[2225,2225,["siRandhArkku ezhu thuNaiyAm * sengkaN mAl nAmam *","maRandhArai mAniDamA vaiyEn ** - aRam thAnggum","mAdhavanE! ennum * manam paDaiththu * maRRu avan pEr","OdhuvadhE nAvinAl uLLu"],["சிறந்தார்க்கு எழு துணையாம் * செங்கண் மால் நாமம் *","மறந்தாரை மானிடமா வையேன் ** - அறம் தாங்கும்","மாதவனே! என்னும் * மனம் படைத்து * மற்று அவன் பேர்","ஓதுவதே நாவினால் உள்ளு"],0,"/media/recitation/IT.44.mp3"],[2226,2226,["uLadhenRu iRumAvAr * uNDillai enRu *","thaLardhal adhan arugum sArAr ** - aLavariya","vEdhaththAn vEngkaDaththAn * viNNOr muDi thOyum *","pAdhaththAn pAdham payinRu"],["உளதென்று இறுமாவார் * உண்டில்லை என்று *","தளர்தல் அதன் அருகும் சாரார் ** - அளவரிய","வேதத்தான் வேங்கடத்தான் * விண்ணோர் முடி தோயும் *","பாதத்தான் பாதம் பயின்று"],0,"/media/recitation/IT.45.mp3"],[2227,2227,["payinRadhu aranggam thirukkOTTi * pannAL","payinRadhuvum * vEngkaDamE pannAL - ** payinRadu","aNi thigazhum sOlai * aNi nIrmalaiyE *","maNi thigazhum vaNthaDakkai mAl"],["பயின்றது அரங்கம் திருக்கோட்டி * பன்னாள்","பயின்றதுவும் * வேங்கடமே பன்னாள் - ** பயின்றது","அணி திகழும் சோலை * அணி நீர்மலையே *","மணி திகழும் வண்தடக்கை மால்"],0,"/media/recitation/IT.46.mp3"],[2228,2228,["mAlai ari uruvan * pAdha malar aNindhu *","kAlai thozhudhezhumin kai kOli ** - njAlam","aLandhu iDandhu uNDu umizhndha * aNNalai maRRallAl *","uLam kiDandha ARRAl uNarndhu"],["மாலை அரி உருவன் * பாத மலர் அணிந்து *","காலை தொழுதெழுமின் கை கோலி ** - ஞாலம்","அளந்து இடந்து உண்டு உமிழ்ந்த * அண்ணலை மற்றல்லால் *","உளம் கிடந்த ஆற்றால் உணர்ந்து"],0,"/media/recitation/IT.47.mp3"],[2229,2229,["uNarndhAy maRai nAnkum * OdhinAy nIdhi *","maNandhAy malarmagaL thOL mAlE! ** - maNandhAy pOy","vEy irunjchAral * viyal iru njAlam sUzh *","mAy irunjchOlai malai"],["உணர்ந்தாய் மறை நான்கும் * ஓதினாய் நீதி *","மணந்தாய் மலர்மகள் தோள் மாலே! ** - மணந்தாய் போய்","வேய் இருஞ்சாரல் * வியல் இரு ஞாலம் சூழ் *","மாய் இருஞ்சோலை மலை"],0,"/media/recitation/IT.48.mp3"],[2230,2230,["malai Ezhum * mAnilanggaL Ezhum adhira *","kulai sUzh kurai kaDalgaL Ezhum ** - mulai sUzhndha","nanjchuraththup peNNai * navinRuNDa nAvan enRu *","anjchAdhu en nenjchE! azhai"],["மலை ஏழும் * மாநிலங்கள் ஏழும் அதிர *","குலை சூழ் குரை கடல்கள் ஏழும் ** - முலை சூழ்ந்த","நஞ்சுரத்துப் பெண்ணை * நவின்றுண்ட நாவன் என்று *","அஞ்சாது என் நெஞ்சே! அழை"],0,"/media/recitation/IT.49.mp3"],[2231,2231,["azhaippan thirumAlai * Anggu avargaL sonna *","pizhaippil perum peyarE pEsi ** - izhaippariya","AyavanE! yAdhavanE! * enRavanai yAr mugappum *","mAyavanE! enRu madhiththu"],["அழைப்பன் திருமாலை * ஆங்கு அவர்கள் சொன்ன *","பிழைப்பில் பெரும் பெயரே பேசி ** - இழைப்பரிய","ஆயவனே! யாதவனே! * என்றவனை யார் முகப்பும் *","மாயவனே! என்று மதித்து"],0,"/media/recitation/IT.50.mp3"],[2232,2232,["madhik kaNDAy nenjchE! * maNivaNNan pAdham *","madhik kaNDAy maRRavan pEr thannai ** - madhik kaNDAy","pEr Azhi ninRu * peyarndhu kaDal kaDaindha *","nIr Azhi vaNNan niRam"],["மதிக் கண்டாய் நெஞ்சே! * மணிவண்ணன் பாதம் *","மதிக் கண்டாய் மற்றவன் பேர் தன்னை ** - மதிக் கண்டாய்","பேர் ஆழி நின்று * பெயர்ந்து கடல் கடைந்த *","நீர் ஆழி வண்ணன் நிறம்"],0,"/media/recitation/IT.51.mp3"],[2233,2233,["niRam kariyan * seyya neDumalarAL mArvan *","aRam periyan Ar adhaRivAr? ** - maRam purindha","vAL arakkan pOlvAnai * vAnavar kOn dhAnaththu *","nIL irukkaikku uyththAn neRi"],["நிறம் கரியன் * செய்ய நெடுமலராள் மார்வன் *","அறம் பெரியன் ஆர் அதறிவார்? ** - மறம் புரிந்த","வாள் அரக்கன் போல்வானை * வானவர் கோன் தானத்து *","நீள் இருக்கைக்கு உய்த்தான் நெறி"],0,"/media/recitation/IT.52.mp3"],[2234,2234,["neRiyAr kuzhal kaRRai * mun ninRu pin thAzhndhu *","aRiyAdhu iLangkiri enRu eNNi ** - piRiyAdhu","pUngkoDikkaL vaigum * poru punal kunRu ennum *","vEngkaDamE yAm virumbum veRpu"],["நெறியார் குழல் கற்றை * முன் நின்று பின் தாழ்ந்து *","அறியாது இளங்கிரி என்ற் உஎண்ணி ** - பிறியாது","பூங்கொடிக்கள் வைகும் * பொரு புனல் குன்று என்னும் *","வேங்கடமே யாம் விரும்பும் வெற்பு"],0,"/media/recitation/IT.53.mp3"],[2235,2235,["veRpenRu irunjchOlai * vEngkaDam enRu ivviraNDum *","niRpenRu nI madhikkum nIrmai pOl ** - niRpenRu","uLangkOyil uLLam vaiththu uLLinEn * veLLaththu","iLangkOyil kaiviDEl enRu"],["வெற்பென்று இருஞ்சோலை * வேங்கடம் என்று இவ்விரண்டும் *","நிற்பென்று நீ மதிக்கும் நீர்மை போல் ** - நிற்பென்று","உளங்கோயில் உள்ளம் வைத்து உள்ளினேன் * வெள்ளத்து","இளங்கோயில் * கைவிடேல் என்று"],0,"/media/recitation/IT.54.mp3"],[2236,2236,["enRum maRandhaRiyEn * Ezh piRappum eppozhudhum *","ninRu ninaippozhiyA nIrmaiyAl ** - venRi","aDal Azhi koNDa * aRivanE! * inbak","kaDal Azhi nI aruLik kAN"],["என்றும் மறந்தறியேன் * ஏழ் பிறப்பும் எப்பொழுதும் *","நின்று நினைப்பொழியா நீர்மையால் ** - வென்றி","அடல் ஆழி கொண்ட * அறிவனே! * இன்பக்","கடல் ஆழி நீ அருளிக் காண்"],0,"/media/recitation/IT.55.mp3"],[2237,2237,["kANak kazhi kAdhal * kaimikkuk kATTinAl *","nANappaDum enRAl nANumE? ** - pENik","karu mAlaip * pon mEni kATTA mun kATTum *","thirumAlai nanggaL thiru"],["காணக் கழி காதல் * கைமிக்குக் காட்டினால் *","நாணப்படும் என்றால் நாணுமே? ** - பேணிக்","கரு மாலைப் * பொன் மேனி காட்டா முன் காட்டும் *","திருமாலை நங்கள் திரு"],0,"/media/recitation/IT.56.mp3"],[2238,2238,["thirumanggai ninRaruLum * dheyvam nA vAzhththum *","karumam kaDaippiDimin kaNDIr ** - urimaiyAl","EththinOm pAdham * irunthaDakkai endhai pEr *","nAl thisaiyum kETTIrE? nAm"],["திருமங்கை நின்றருளும் * தெய்வம் நா வாழ்த்தும் *","கருமம் கடைப்பிடிமின் கண்டீர் ** - உரிமையால்","ஏத்தினோம் பாதம் * இருந்தடக்கை எந்தை பேர் *","நால் திசையும் கேட்டீரே? நாம்"],0,"/media/recitation/IT.57.mp3"],[2239,2239,["nAm peRRa nanmaiyum * nA manggai nannenjchaththu *","Ombi irundhu emmai Odhuviththu ** - vEmbin","poruL nIrmai Ayinum * pon Azhi pADenRu *","aruL nIrmai thandha aruL"],["நாம் பெற்ற நன்மையும் * நா மங்கை நன்னெஞ்சத்து *","ஓம்பி இருந்து எம்மை ஓதுவித்து ** - வேம்பின்","பொருள் நீர்மை ஆயினும் * பொன் ஆழி பாடென்று *","அருள் நீர்மை தந்த அருள்"],0,"/media/recitation/IT.58.mp3"],[2240,2240,["aruL purindha sindhai * aDiyAr mEl vaiththu *","poruL therindhu kANkuRRa appOdhu ** - iruL thirindhu","nOkkinEn nOkki * ninaindhEn adhoNkamalam *","OkkinEn ennaiyum anggu Orndhu"],["அருள் புரிந்த சிந்தை * அடியார் மேல் வைத்து *","பொருள் தெரிந்து காண்குற்ற அப்போது ** - இருள் திரிந்து","நோக்கினேன் நோக்கி * நினைந்தேன் அதொண்கமலம் *","ஓக்கினேன் என்னையும் அங்கு ஓர்ந்து"],0,"/media/recitation/IT.59.mp3"],[2241,2241,["Or uruvan allai * oLi uruvam nin uruvam *","Ir uruvan enbar iru nilaththOr ** - Or uruvam","AdhiyAm vaNNam * aRindhAr avar kaNDIr *","nIdhiyAl maN kAppAr ninRu"],["ஓர் உருவன் அல்லை * ஒளி உருவம் நின் உருவம் *","ஈர் உருவன் என்பர் இரு நிலத்தோர் ** - ஓர் உருவம்","ஆதியாம் வண்ணம் * அறிந்தார் அவர் கண்டீர் *","நீதியால் மண் காப்பார் நின்று"],0,"/media/recitation/IT.60.mp3"],[2242,2242,["ninRadhOr pAdham * nilam pudhaippa * nINDa thOL","senRu aLandhadhu enbar * thisai ellAm ** - anRu","karumANiyAy irandha * kaLvanE! * unnaip","piramANiththAr peRRa pERu!"],["நின்றதோர் பாதம் * நிலம் புதைப்ப * நீண்ட தோள்","சென்று அளந்தது என்பர் * திசை எல்லாம் ** - அன்று","கருமாணியாய் இரந்த * கள்வனே! * உன்னைப்","பிரமாணித்தார் பெற்ற பேறு!"],0,"/media/recitation/IT.61.mp3"],[2243,2243,["pERonRu mun aRiyEn * peRRaRiyEn pEdhaimaiyAl *","mARenRu solli vaNangginEn ** - ERin","peruththeruththam kODosiyap * peN nasaiyin pin pOy *","eruththiRuththa nal Ayar ERu"],["பேறொன்று முன் அறியேன் * பெற்றறியேன் பேதைமையால் *","மாறென்று சொல்லி வணங்கினேன் ** - ஏறின்","பெருத்தெருத்தம் கோடொசியப் * பெண் நசையின் பின் போய் *","எருத்திறுத்த நல் ஆயர் ஏறு"],0,"/media/recitation/IT.62.mp3"],[2244,2244,["eṟu ezhum * vĕṉṟu aṭartta ĕntai * ĕri uruvattu","eṟu eṟi * paṭṭa iṭucāpam ** - pāṟu eṟi","uṇṭa talai vāy niṟaiyak * koṭṭu am kai ŏṇ kuruti *","kaṇṭa pŏrul̤ cŏlliṉ katai -"],["ஏறு ஏழும் * வென்று அடர்த்த எந்தை * எரி உருவத்து","ஏறு ஏறி * பட்ட இடுசாபம் ** பாறு ஏறி","உண்ட தலை வாய் நிறையக் * கோட்டு அம் கை ஒண் குருதி *","கண்ட பொருள் சொல்லின் கதை"],1,"/media/recitation/IT.63.mp3"],[2245,2245,["kataiyum pĕrum pŏrul̤um kaṇṇā ! * niṉ pere","itayam * iruntavaiye ettil ** - kataiyum","tirumŏzhiyāy niṉṟa * tirumāle ! * uṉṉaip","paru mŏzhiyāl kāṇap paṇi -"],["கதையும் பெரும் பொருளும் கண்ணா ! * நின் பேரே","இதயம் * இருந்தவையே ஏத்தில் ** கதையும்","திருமொழியாய் நின்ற * திருமாலே ! * உன்னைப்","பரு மொழியால் காணப் பணி"],1,"/media/recitation/IT.64.mp3"],[2246,2246,["paNindhEn thirumEni * paingkamalam kaiyAl *","aNindhEn un sEvaDi mEl anbAy ** - thuNindhEn","purindhEththi * unnaip pugal iDam pArththu * AnggE","irundhEththi vAzhum idhu"],["பணிந்தேன் திருமேனி * பைங்கமலம் கையால் *","அணிந்தேன் உன் சேவடி மேல் அன்பாய் ** - துணிந்தேன்","புரிந்தேத்தி * உன்னைப் புகல் இடம் பார்த்து * ஆங்கே","இருந்தேத்தி வாழும் இது"],0,"/media/recitation/IT.65.mp3"],[2247,2247,["idhu kaNDAy nannenjchE! * ippiRavi Avadhu *","idhu kaNDAy ellAm nAm uRRadhu ** - idhu kaNDAy","nAraNan pEr Odhi * naragaththu arugaNaiyA *","kAraNamum vallaiyEl kAN"],["இது கண்டாய் நன்னெஞ்சே! * இப்பிறவி ஆவது *","இது கண்டாய் எல்லாம் நாம் உற்றது ** - இது கண்டாய்","நாரணன் பேர் ஓதி * நரகத்து அருகணையா *","காரணமும் வல்லையேல் காண்"],0,"/media/recitation/IT.66.mp3"],[2248,2248,["kaNDEn thirumEni * yAn kanavil * Anggavan kaik","kaNDEn * kanalum suDar Azhi - ** kaNDEn","uRu nOy vinai iraNDum * OTTuviththu * pinnum","maRu nOy seRuvAn vali"],["கண்டேன் திருமேனி * யான் கனவில் * ஆங்கவன் கைக்","கண்டேன் * கனலும் சுடர் ஆழி - ** கண்டேன்","உறு நோய் வினை இரண்டும் * ஓட்டுவித்து * பின்னும்","மறு நோய் செறுவான் வலி"],0,"/media/recitation/IT.67.mp3"],[2249,2249,["vali mikka vāl̤ ĕyiṟṟu * vāl̤ avuṇar māl̤a *","vali mikka vāl̤ varai mattu āka * vali mikka","vāl̤ nākam cuṟṟi * maṟukak kaṭal kaṭaintāṉ *","kol̤ nākam kŏmpu ŏcitta ko -"],["வலி மிக்க வாள் எயிற்று * வாள் அவுணர் மாள *","வலி மிக்க வாள் வரை மத்து ஆக * வலி மிக்க","வாள் நாகம் சுற்றி * மறுகக் கடல் கடைந்தான் *","கோள் நாகம் கொம்பு ஒசித்த கோ"],1,"/media/recitation/IT.68.mp3"],[2250,2250,["kOvAgi * mA nilam kAththu * nangkaN mugappE *","mAvEgich selginRa mannavarum ** - pU mEvum","sengkamala nAbiyAn * sEvaDikkE Ezh piRappum *","thaNkamalam EyndhAr thamar"],["கோவாகி * மா நிலம் காத்து * நங்கண் முகப்பே *","மாவேகிச் செல்கின்ற மன்னவரும் ** - பூ மேவும்","செங்கமல நாபியான் * சேவடிக்கே ஏழ் பிறப்பும் *","தண்கமலம் ஏய்ந்தார் தமர்"],0,"/media/recitation/IT.69.mp3"],[2251,2251,["thamar uLLam thanjchai * thalai aranggam thaNkAl *","thamar uLLum thaNporuppu vElai ** - thamar uLLum","mA mallai kOval * madhiL kuDandhai enbarE *","Evalla endhaikku iDam"],["தமர் உள்ளம் தஞ்சை * தலை அரங்கம் தண்கால் *","தமர் உள்ளும் தண்பொருப்பு வேலை ** - தமர் உள்ளும்","மா மல்லை கோவல் * மதிள் குடந்தை என்பரே *","ஏவல்ல எந்தைக்கிடம்"],0,"/media/recitation/IT.70.mp3"],[2252,2252,["iDanggai valampuri ninRu Arppa * eri kAnRu","aDanggAr * oDungguviththadhu Azhi ** - viDangkAlum","thI vAy aravaNai mEl * thOnRal thisai aLappAn *","pUvAr aDi nimirththa pOdhu"],["இடங்கை வலம்புரி நின்று ஆர்ப்ப * எரி கான்று","அடங்கார் * ஒடுங்குவித்தது ஆழி ** - விடங்காலும்","தீ வாய் அரவணை மேல் * தோன்றல் திசை அளப்பான் *","பூவார் அடி நிமிர்த்த போது"],0,"/media/recitation/IT.71.mp3"],[2253,2253,["pOdhaRindhu vAnaranggaL * pUnjchunai pukku * Anggalarndha","pOdharindhu koNDu Eththum pOdhu ** uLLam! - pOdhu","maNi vEngkaDavan * malar aDikkE sella *","aNi vEngkaDavan pEr Ayndhu"],["போதறிந்து வானரங்கள் * பூஞ்சுனை புக்கு * ஆங்கலர்ந்த","போதரிந்து கொண்டு ஏத்தும் போது ** உள்ளம்! - போது","மணி வேங்கடவன் * மலர் அடிக்கே செல்ல *","அணி வேங்கடவன் பேர் ஆய்ந்து"],0,"/media/recitation/IT.72.mp3"],[2254,2254,["Ayndhuraippan Ayiram pEr * Adhi naDu andhivAy *","vAyndha malar thUvi vaigalum ** - Eyndha","piRaik kOTTuch sengkaN * kari viDuththa pemmAn *","iRaikku ATpaDath thuNindha yAn"],["ஆய்ந்துரைப்பன் ஆயிரம் பேர் * ஆதி நடு அந்திவாய் *","வாய்ந்த மலர் தூவி வைகலும் ** - ஏய்ந்த","பிறைக் கோட்டுச் செங்கண் * கரி விடுத்த பெம்மான் *","இறைக்கு ஆட்படத் துணிந்த யான்"],0,"/media/recitation/IT.73.mp3"],[2255,2255,["yAnE thavam seydhEn * Ezh piRappum eppozhudhum *","yAnE thavam uDaiyEn emperumAn! ** - yAnE","irunthamizh nanmAlai * iNai aDikkE sonnEn *","perunthamizhan nallEn peridhu"],["யானே தவம் செய்தேன் * ஏழ் பிறப்பும் எப்பொழுதும் *","யானே தவம் உடையேன் எம்பெருமான்! ** - யானே","இருந்தமிழ் நன்மாலை * இணை அடிக்கே சொன்னேன் *","பெருந்தமிழன் நல்லேன் பெரிது"],0,"/media/recitation/IT.74.mp3"],[2256,2256,["perugu madha vEzham * mAppiDikku mun ninRu *","irukaN iLamUnggil vAnggi ** - arugirundha","thEn kalandhu nITTum * thiruvEngkaDam kaNDIr *","vAn kalandha vaNNan varai"],["பெருகு மத வேழம் * மாப்பிடிக்கு முன் நின்று *","இருகண் இளமூங்கில் வாங்கி ** - அருகிருந்த","தேன் கலந்து நீட்டும் * திருவேங்கடம் கண்டீர் *","வான் கலந்த வண்ணன் வரை"],0,"/media/recitation/IT.75.mp3"],[2257,2257,["varaich chandhanak kuzhambum * vAn kalanum paTTum *","viraip polindha veNmalligaiyum - niraiththuk koNDu **","AdhikkaN ninRa * aRivan aDi iNaiyE *","Odhip paNivadhuRum"],["வரைச் சந்தனக் குழம்பும் * வான் கலனும் பட்டும் *","விரைப் பொலிந்த வெண்மல்லிகையும் - நிரைத்துக் கொண்டு **","ஆதிக்கண் நின்ற * அறிவன் அடி இணையே *","ஓதிப் பணிவதுறும்"],0,"/media/recitation/IT.76.mp3"],[2258,2258,["uṟum kaṇṭāy nal nĕñce ! * uttamaṉ nal pātam *","uṟum kaṇṭāy ŏṇ kamalam taṉṉāl ** - uṟum kaṇṭāy","ettip paṇintu avaṉ per * īr aiññūṟu ĕppŏzhutum *","cāṟṟi uraittal tavam -"],["உறும் கண்டாய் நல் நெஞ்சே ! * உத்தமன் நல் பாதம் *","உறும் கண்டாய் ஒண் கமலம் தன்னால் ** உறும் கண்டாய்","ஏத்திப் பணிந்து அவன் பேர் * ஈர் ஐஞ்ஞூறு எப்பொழுதும் *","சாற்றி உரைத்தல் தவம்"],1,"/media/recitation/IT.77.mp3"],[2259,2259,["tavam cĕytu * nāṉ mukaṉe pĕṟṟāṉ * taraṇi","nivantu al̤appa * nīṭṭiya pŏn pātam ** - civanta taṉ","kai aṉaittum * ārak kazhuviṉāṉ * kaṅkai nīr","pĕytu aṉaittup per mŏzhintu piṉ -"],["தவம் செய்து * நான் முகனே பெற்றான் * தரணி","நிவந்து அளப்ப * நீட்டிய பொன் பாதம் ** சிவந்த தன்","கை அனைத்தும் * ஆரக் கழுவினான் * கங்கை நீர்","பெய்து அனைத்துப் பேர் மொழிந்து பின்"],1,"/media/recitation/IT.78.mp3"],[2260,2260,["pin ninRu * thAy irappak kELAn * perum paNaiththOL","mun ninRu * thAn irappAL moymmalarAL ** - sol ninRa","thOL nalanthAn * nEr illAth thOnRal * avan aLandha","nIL nilam thAn aththanaikkum nEr"],["பின் நின்று * தாய் இரப்பக் கேளான் * பெரும் பணைத்தோள்","முன் நின்று * தான் இரப்பாள் மொய்ம்மலராள் ** - சொல் நின்ற","தோள் நலந்தான் * நேர் இல்லாத் தோன்றல் * அவன் அளந்த","நீள் நிலம் தான் அத்தனைக்கும் நேர்"],0,"/media/recitation/IT.79.mp3"],[2261,2261,["nErndhEn aDimai * ninaindhEn adhoNkamalam *","ArndhEn un sEvaDi mEl anbAy ** - Arndha","aDik kOlam * kaNDavarkku en kolO? * munnaip","paDik kOlam kaNDa pagal"],["நேர்ந்தேன் அடிமை * நினைந்தேன் அதொண்கமலம் *","ஆர்ந்தேன் உன் சேவடி மேல் அன்பாய் ** - ஆர்ந்த","அடிக் கோலம் * கண்டவர்க்கு என் கொலோ? * முன்னைப்","படிக் கோலம் கண்ட பகல்"],0,"/media/recitation/IT.80.mp3"],[2262,2262,["pakal kaṇṭeṉ * nāraṇaṉaik kaṇṭeṉ * kaṉavil","mikak kaṇṭeṉ * mīṇṭu avaṉai mĕyye - mikak kaṇṭeṉ **","ūṉ tikazhum nemi * ŏl̤i tikazhum cevaṭiyāṉ *","vāṉ tikazhum coti vaṭivu -"],["பகல் கண்டேன் * நாரணனைக் கண்டேன் * கனவில்","மிகக் கண்டேன் * மீண்டு அவனை மெய்யே மிகக் கண்டேன் **","ஊன் திகழும் நேமி * ஒளி திகழும் சேவடியான் *","வான் திகழும் சோதி வடிவு"],1,"/media/recitation/IT.81.mp3"],[2263,2263,["vaDik kOla vAL neDungkaN * mA malarAL * sevvip","paDik kOlam * kaNDu agalAL pal nAL ** - aDikkOli","njAlaththAL * pinnum nalam purindhadhu en kolO? *","kOlaththAl illai kuRai"],["வடிக் கோல வாள் நெடுங்கண் * மா மலராள் * செவ்விப்","படிக் கோலம் * கண்டு அகலாள் பல் நாள் ** - அடிக்கோலி","ஞாலத்தாள் * பின்னும் நலம் புரிந்தது என் கொலோ? *","கோலத்தால் இல்லை குறை"],0,"/media/recitation/IT.82.mp3"],[2264,2264,["kuRai Aga venjchoRkaL * kURinEn kURi *","maRai Anggena uraiththa mAlai ** - iRaiyEnum","Iyungkol! enRE * irundhEn enaip pagalum *","mAyan kaN senRa varam"],["குறை ஆக வெஞ்சொற்கள் * கூறினேன் கூறி *","மறை ஆங்கென உரைத்த மாலை ** - இறையேனும்","ஈயுங்கொல்! என்றே * இருந்தேன் எனைப் பகலும் *","மாயன் கண் சென்ற வரம்"],0,"/media/recitation/IT.83.mp3"],[2265,2265,["varam karudhith thannai * vaNanggAdha vanmai *","uram karudhi mUrkkaththavanai ** - naram kalandha","singgamAyk kINDa * thiruvan aDi iNaiyE *","angkaN mAnjAlaththu amudhu"],["வரம் கருதித் தன்னை * வணங்காத வன்மை *","உரம் கருதி மூர்க்கத்தவனை ** - நரம் கலந்த","சிங்கமாய்க் கீண்ட * திருவன் அடி இணையே *","அங்கண் மாஞாலத்து அமுது"],0,"/media/recitation/IT.84.mp3"],[2266,2266,["amudhu enRum thEn enRum * AzhiyAn enRum *","amudhanRu koNDu ugandhAn enRum ** - amudhanna","sol mAlai Eththith * thozhudhEn solappaTTa *","nanmAlai Eththi navinRu"],["அமுது என்றும் தேன் என்றும் * ஆழியான் என்றும் *","அமுதன்று கொண்டு உகந்தான் என்றும் ** - அமுதன்ன","சொல் மாலை ஏத்தித் * தொழுதேன் சொலப்பட்ட *","நன்மாலை ஏத்தி நவின்று"],0,"/media/recitation/IT.85.mp3"],[2267,2267,["navinRuraiththa nAvalargaL * nANmalar koNDu * AnggE","payinRadhanAl * peRRa payan en kol? ** - payinRAr tham","meyththavaththAl * kANbariya mEga maNivaNNanai * yAn","eththavaththAl kANban kol inRu?"],["நவின்றுரைத்த நாவலர்கள் * நாண்மலர் கொண்டு * ஆங்கே","பயின்றதனால் * பெற்ற பயன் என் கொல்? ** - பயின்றார் தம்","மெய்த்தவத்தால் * காண்பரிய மேக மணிவண்ணனை * யான்","எத்தவத்தால் காண்பன் கொல் இன்று?"],0,"/media/recitation/IT.86.mp3"],[2268,2268,["inRA aRiginREn allEn * irunilaththaich","senRAnggu aLandha thiruvaDiyai ** - anRu","karuk kOTTiyuL kiDandhu * kai thozhudhEn kaNDEn *","thirukkOTTi endhai thiRam"],["இன்றா அறிகின்றேன் அல்லேன் * இருநிலத்தைச்","சென்றாங்கு அளந்த திருவடியை ** - அன்று","கருக் கோட்டியுள் கிடந்து * கை தொழுதேன் கண்டேன் *","திருக்கோட்டி எந்தை திறம்"],0,"/media/recitation/IT.87.mp3"],[2269,2269,["thiRambiRRu ini aRindhEn * thennaranggaththu endhai *","thiRambA vazhi senRArkku allAl ** - thiRambAch","seDi naragai nIkkith * thAm selvadhan mun * vAnOr","kaDi nagara vAsal kadhavu"],["திறம்பிற்று இனி அறிந்தேன் * தென்னரங்கத்து எந்தை *","திறம்பா வழி சென்றார்க்கு அல்லால் ** - திறம்பாச்","செடி நரகை நீக்கித் * தாம் செல்வதன் முன் * வானோர்","கடி நகர வாசல் கதவு"],0,"/media/recitation/IT.88.mp3"],[2270,2270,["kadhavik kadham siRandha * kanjchanai mun kAyndhu *","adhavip pOr yAnai osiththu ** - padhaviyAyp","pANiyAl nIr ERRup * paNDorukAl mAvaliyai *","mANiyAyk koNDilaiyE maN?"],["கதவிக் கதம் சிறந்த * கஞ்சனை முன் காய்ந்து *","அதவிப் போர் யானை ஒசித்து ** - பதவியாய்ப்","பாணியால் நீர் ஏற்றுப் * பண்டொருகால் மாவலியை *","மாணியாய்க் கொண்டிலையே மண்?"],0,"/media/recitation/IT.89.mp3"],[2271,2271,["maṇṇulakam āl̤eṉe ? * vāṉavarkkum vāṉavaṉāy *","viṇṇulakam taṉ akattum meveṉe? ** - naṇṇit","tirumālaic * cĕṅkaṇ nĕṭiyāṉai * ĕṅkal̤","pĕrumāṉaik kai tŏzhuta piṉ -"],["மண்ணுலகம் ஆளேனே ? * வானவர்க்கும் வானவனாய் *","விண்ணுலகம் தன் அகத்தும் மேவேனே? ** நண்ணித்","திருமாலைச் * செங்கண் நெடியானை * எங்கள்","பெருமானைக் கை தொழுத பின்"],1,"/media/recitation/IT.90.mp3"],[2272,2272,["piṉṉāl aru narakam * cerāmal petuṟuvīr *","muṉṉāl vaṇaṅka muyalmiṉo ** - pal nūl","al̤antāṉaik * kārk kaṭal cūzh ñālattai * ĕllām","al̤antāṉ avaṉ cevaṭi -"],["பின்னால் அரு நரகம் * சேராமல் பேதுறுவீர் *","முன்னால் வணங்க முயல்மினோ ** பல் நூல்","அளந்தானைக் * கார்க் கடல் சூழ் ஞாலத்தை * எல்லாம்","அளந்தான் அவன் சேவடி"],1,"/media/recitation/IT.91.mp3"],[2273,2273,["aDiyAl mun kanjchanaich seRRu * amarar Eththum","paDiyAn * koDi mEl puL koNDAn ** - neDiyAn than","nAmamE * EththumingaL EththinAl * thAm vENDum","kAmamE kATTum kaDidhu"],["அடியால் முன் கஞ்சனைச் செற்று * அமரர் ஏத்தும்","படியான் * கொடி மேல் புள் கொண்டான் ** - நெடியான் தன்","நாமமே * ஏத்துமின்கள் ஏத்தினால் * தாம் வேண்டும்","காமமே காட்டும் கடிது"],0,"/media/recitation/IT.92.mp3"],[2274,2274,["kaDidhu koDu naragam * piRkAlum seygai *","koDidhenRu adhu kUDA munnam ** - vaDi sanggam","koNDAnaik * kUndhal vAy kINDAnai * konggai nanjchu","uNDAnai EththuminO uRRu"],["கடிது கொடு நரகம் * பிற்காலும் செய்கை *","கொடிதென்று அது கூடா முன்னம் ** - வடி சங்கம்","கொண்டானைக் * கூந்தல் வாய் கீண்டானை * கொங்கை நஞ்சு","உண்டானை ஏத்துமினோ உற்று"],0,"/media/recitation/IT.93.mp3"],[2275,2275,["uRRu vaNanggith thozhumin * ulagEzhum","muRRum vizhunggum mugilvaNNan ** - paRRip","porundhAdhAn mArbu iDandhu * pUmpADagaththuL","irundhAnai * Eththum en nenjchu"],["உற்று வணங்கித் தொழுமின் * உலகேழும்","முற்றும் விழுங்கும் முகில்வண்ணன் ** - பற்றிப்","பொருந்தாதான் மார்பு இடந்து * பூம்பாடகத்துள்","இருந்தானை * ஏத்தும் என் நெஞ்சு"],0,"/media/recitation/IT.94.mp3"],[2276,2276,["ennenjcha mEyAn * en senniyAn * dhAnavanai","vannenjcham kINDa maNivaNNan ** - munnam sEy","UzhiyAn * Uzhi peyarththAn * ulagEththum","AzhiyAn aththiyUrAn"],["என்னெஞ்ச மேயான் * என் சென்னியான் * தானவனை","வன்னெஞ்சம் கீண்ட மணிவண்ணன் ** - முன்னம் சேய்","ஊழியான் * ஊழி பெயர்த்தான் * உலகேத்தும்","ஆழியான் அத்தியூரான்"],0,"/media/recitation/IT.95.mp3"],[2277,2277,["** aththiyUrAn puLLai UrvAn * aNimaNiyin","thuththi sEr * nAgaththin mEl thuyilvAn ** - muththI","maRaiyAvAn * mAkaDal nanjchuNDAn thanakkum *","iRai AvAn enggaL pirAn"],["** அத்தியூரான் புள்ளை ஊர்வான் * அணிமணியின்","துத்தி சேர் * நாகத்தின் மேல் துயில்வான் ** - முத்தீ","மறையாவான் * மாகடல் நஞ்சுண்டான் தனக்கும் *","இறை ஆவான் எங்கள் பிரான்"],0,"/media/recitation/IT.96.mp3"],[2278,2278,["enggaL perumAn! * imaiyOr thalaimagan! nI *","sengkaN neDumAl! thirumArbA! ** - ponggu","paDa mUkkin Ayira vAyp * pAmbaNai mEl sErndhAy *","kuDamUkkuk kOyilAk koNDu"],["எங்கள் பெருமான்! * இமையோர் தலைமகன்! நீ *","செங்கண் நெடுமால்! திருமார்பா! ** - பொங்கு","பட மூக்கின் ஆயிர வாய்ப் * பாம்பணை மேல் சேர்ந்தாய் *","குடமூக்குக் கோயிலாக் கொண்டு"],0,"/media/recitation/IT.97.mp3"],[2279,2279,["koNDu vaLarkkak * kuzhaviyAyth thAn vaLarndhadhu *","uNDadhu ulagEzhum uL oDungga ** - koNDu","kuDam ADik * kOvalanAy mEvi * en nenjcham","iDam Agak koNDa iRai"],["கொண்டு வளர்க்கக் * குழவியாய்த் தான் வளர்ந்தது *","உண்டது உலகேழும் உள் ஒடுங்க ** - கொண்டு","குடம் ஆடிக் * கோவலனாய் மேவி * என் நெஞ்சம்","இடம் ஆகக் கொண்ட இறை"],0,"/media/recitation/IT.98.mp3"],[2280,2280,["** iRai emperumAn! aruL enRu * imaiyOr","muRai ninRu * moymmalargaL thUva ** - aRai kazhala","sEvaDiyAn * sengkaNeDiyAn * kuRaL uruvAy","mA vaDivil maN koNDAn mAl"],["** இறை எம்பெருமான்! அருள் என்று * இமையோர்","முறை நின்று * மொய்ம்மலர்கள் தூவ ** - அறை கழல","சேவடியான் * செங்கணெடியான் * குறள் உருவாய்","மா வடிவில் மண் கொண்டான் மால்"],0,"/media/recitation/IT.99.mp3"],[2281,2281,["** mAlE! neDiyOnE! kaNNanE! * viNNavarkku","mElA! * viyan thuzhAyk kaNNiyanE! ** - mElAl","viLavin kAy * kanRinAl vIzhththavanE! * endhan","aLavanRAl yAn uDaiya anbu"],["** மாலே! நெடியோனே! கண்ணனே! * விண்ணவர்க்கு","மேலா! * வியன் துழாய்க் கண்ணியனே! ** - மேலால்","விளவின் காய் * கன்றினால் வீழ்த்தவனே! * என்தன்","அளவன்றால் யான் உடைய அன்பு"],0,"/media/recitation/IT.100.mp3"]],"box":["https://app.box.com/s/eqs86l97czi9i4ms8z90pwm3htzac8z6","02. iraNdAm thiruvandhAdhi [2182-2281].mp3",2182,2281]}]}