{"id":"09-amalanadhipiran","name":"Amalanadhipiran","nameTa":"அமலனாதிபிரான்","alvar":"Thiruppan Azhvar","alvarTa":"திருப்பாணாழ்வார்","src":"amalanAdhipirAn","ayiram":1,"start":927,"end":936,"thaniyans":[{"le":["amalanAdhipirAn thaniyankaL","periya nambigaL aruLich cheydhadhu"],"lt":["அமலனாதிபிரான் தனியன்கள்","பெரிய நம்பிகள் அருளிச் செய்தது"],"en":["ApAda chUDamanubhUya harim shayAnam","madhyE kavEra duhitur muditAntarAtmA |","adraShTrutAm nayanayOr viShayAntarANAm","yO nishchikAya manavai munivAhanam tam ||"],"ta":["ஆபாத³ சூட³மநுபூ⁴ய ஹரிம் ஶயாநம்","மத்⁴யே கவேர து³ஹிதுர் முதி³தாந்தராத்மா |","அத்³ரஷ்ட்ருதாம் நயநயோர் விஷயாந்தராணாம்","யோ நிஶ்சிகாய மநவை முநிவாஹநம் தம் ||"]},{"le":["thirumalai nambigaL aruLich cheydhadhu"],"lt":["திருமலை நம்பிகள் அருளிச் செய்தது"],"en":["kATTavE kaNDa pAdha kamalam nallADai undhi *","thETTarum udhara bandham thirumArbu kaNDam sevvAy *","vATTamil kaNgaL mEni muni ERith thani pugundhu *","pATTinAl kaNDu vAzhum pANar thAL paravinOmE"],"ta":["காட்டவே கண்ட பாத கமலம் நல்லாடை உந்தி *","தேட்டரும் உதர பந்தம் திருமார்பு கண்டம் செவ்வாய் *","வாட்டமில் கண்கள் மேனி முனி ஏறித் தனி புகுந்து *","பாட்டினால் கண்டு வாழும் பாணர் தாள் பரவினோமே"]}],"sections":[{"he":["azhagiya maNavALanadhu thirumEni azhagil pAdhAdhi kEsAnthamAga IDupaDudhal"],"ht":["அழகிய மணவாளனது திருமேனி அழகில் பாதாதி கேசாந்தமாக ஈடுபடுதல்"],"ae":"aDivaravu: amalan uvandha mandhi sadhuram pAram thuNDa kai pari Alam koNDal kaNNi","at":"அடிவரவு: அமலன் உவந்த மந்தி சதுரம் பாரம் துண்ட கை பரி ஆலம் கொண்டல் கண்ணி","p":[[927,927,["** amalan Adhi pirAn * aDiyArkku ennai ATpaDuththa","vimalan * viNNavar kOn * viraiyAr pozhil vEngkaDavan **","nimalan ninmalan nIdhi vAnavan * nIL madhiL aranggaththu ammAn * thiruk","kamala pAdham vandhu * en kaNNin uLLana okkinRadhE"],["** அமலன் ஆதி பிரான் * அடியார்க்கு என்னை ஆட்படுத்த","விமலன் * விண்ணவர் கோன் * விரையார் பொழில் வேங்கடவன் **","நிமலன் நின்மலன் நீதி வானவன் * நீள் மதிள் அரங்கத்து அம்மான் * திருக்","கமல பாதம் வந்து * என் கண்ணின் உள்ளன ஒக்கின்றதே"],0,"/media/recitation/AAP.1.mp3"],[928,928,["uvandha uLLaththanAy * ulagam aLandhu aNDam uRa *","nivandha nIL muDiyan * anRu nErndha nisAsararai **","kavarndha vengkaNaik kAguththan * kaDiyAr pozhil aranggaththu ammAn * araich","sivandha ADaiyin mEl * senRadhAm ena sindhanaiyE"],["உவந்த உள்ளத்தனாய் * உலகம் அளந்து அண்டம் உற *","நிவந்த நீள் முடியன் * அன்று நேர்ந்த நிசாசரரை **","கவர்ந்த வெங்கணைக் காகுத்தன் * கடியார் பொழில் அரங்கத்து அம்மான் * அரைச்","சிவந்த ஆடையின் மேல் * சென்றதாம் என சிந்தனையே"],0,"/media/recitation/AAP.2.mp3"],[929,929,["** mandhi pAy * vaDa vEngkaDa mAmalai * vAnavargaL","sandhi seyya ninRAn * aranggaththu aravin aNaiyAn **","andhi pOl niRaththu ADaiyum * adhan mEl ayanaip paDaiththadhOr ezhil *","undhi mEl adhanRO * aDiyEn uLLaththu innuyirE"],["** மந்தி பாய் * வட வேங்கட மாமலை * வானவர்கள்","சந்தி செய்ய நின்றான் * அரங்கத்து அரவின் அணையான் **","அந்தி போல் நிறத்து ஆடையும் * அதன் மேல் அயனைப் படைத்ததோர் எழில் *","உந்தி மேல் அதன்றோ * அடியேன் உள்ளத்து இன்னுயிரே"],0,"/media/recitation/AAP.3.mp3"],[930,930,["sadhuramA madhiL sUzh * ilanggaikku iRaivan thalai paththu","udhira OTTi * Or vengkaNai uyththavan * Odha vaNNan **","madhuramA vaNDu pADa * mAmayil ADaranggaththu ammAn * thiruvayiRRu","udhara bandham * en uLLaththuL ninRu ulAginRadhE"],["சதுரமா மதிள் சூழ் * இலங்கைக்கு இறைவன் தலை பத்து","உதிர ஓட்டி * ஓர் வெங்கணை உய்த்தவன் * ஓத வண்ணன் **","மதுரமா வண்டு பாட * மாமயில் ஆடரங்கத்து அம்மான் * திருவயிற்று","உதர பந்தம் * என் உள்ளத்துள் நின்று உலாகின்றதே"],0,"/media/recitation/AAP.4.mp3"],[931,931,["pAramAya * pazha vinai paRRu aRuththu * ennaith than","vAram Akki vaiththAn * vaiththadhu anRi ennuL pugundhAn **","gOramA thavam seydhanan kol aRiyEn * aranggaththu ammAn * thiru","Ara mArbadhanRO * aDiyEnai ATkoNDadhE"],["பாரமாய * பழ வினை பற்று அறுத்து * என்னைத் தன்","வாரம் ஆக்கி வைத்தான் * வைத்தது அன்றி என்னுள் புகுந்தான் **","கோரமா தவம் செய்தனன் கொல் அறியேன் * அரங்கத்து அம்மான் * திரு","ஆர மார்பதன்றோ * அடியேனை ஆட்கொண்டதே"],0,"/media/recitation/AAP.5.mp3"],[932,932,["thuNDa veNpiRaiyan * thuyar thIrththavan * anjchiRaiya","vaNDu vAzh pozhil sUzh * arangga nagar mEya appan **","aNDar aNDa bagir aNDaththu * oru mAnilam ezhu mAl varai * muRRum","uNDa kaNDam kaNDIr * aDiyEnai uyyak koNDadhE"],["துண்ட வெண்பிறையன் * துயர் தீர்த்தவன் * அஞ்சிறைய","வண்டு வாழ் பொழில் சூழ் * அரங்க நகர் மேய அப்பன் **","அண்டர் அண்ட பகிர் அண்டத்து * ஒரு மாநிலம் எழு மால் வரை * முற்றும்","உண்ட கண்டம் கண்டீர் * அடியேனை உய்யக் கொண்டதே"],0,"/media/recitation/AAP.6.mp3"],[933,933,["kaiyinAr * surisanggu anal Azhiyar * nIL varai pOl","meyyanAr * thuLaba viraiyAr kamazh nIL muDi em","aiyanAr ** aNi arangganAr * aravin aNai misai mEya mAyanAr *","seyya vAy aiyO! * ennaich chindhai kavarndhadhuvE"],["கையினார் * சுரிசங்கு அனல் ஆழியர் * நீள் வரை போல்","மெய்யனார் * துளப விரையார் கமழ் நீள் முடி எம்","ஐயனார் ** அணி அரங்கனார் * அரவின் அணை மிசை மேய மாயனார் *","செய்ய வாய் ஐயோ! * என்னைச் சிந்தை கவர்ந்ததுவே"],0,"/media/recitation/AAP.7.mp3"],[934,934,["pariyanAgi vandha * avuNan uDal kINDa * amararkku","ariya Adhip pirAn * aranggaththu amalan mugaththu **","kariyavAgip puDai parandhu * miLirndhu sevvari ODi * nINDa ap","periyavAya kaNgaL * ennaip pEdhaimai seydhanavE"],["பரியனாகி வந்த * அவுணன் உடல் கீண்ட * அமரர்க்கு","அரிய ஆதிப் பிரான் * அரங்கத்து அமலன் முகத்து **","கரியவாகிப் புடை பரந்து * மிளிர்ந்து செவ்வரி ஓடி * நீண்ட அப்","பெரியவாய கண்கள் * என்னைப் பேதைமை செய்தனவே!"],0,"/media/recitation/AAP.8.mp3"],[935,935,["** AlamA maraththin ilai mEl * oru pAlaganAy *","njAlam Ezhum uNDAn * aranggaththu aravin aNaiyAn **","kOlamA maNi Aramum * muththuth thAmamum muDivilladhOr ezhil *","nIla mEni aiyO! * niRai koNDadhu en nenjchinaiyE"],["** ஆலமா மரத்தின் இலை மேல் * ஒரு பாலகனாய் *","ஞாலம் ஏழும் உண்டான் * அரங்கத்து அரவின் அணையான் **","கோலமா மணி ஆரமும் * முத்துத் தாமமும் முடிவில்லதோர் எழில் *","நீல மேனி ஐயோ! * நிறை கொண்டது என் நெஞ்சினையே"],0,"/media/recitation/AAP.9.mp3"],[936,936,["** koNDal vaNNanaik * kOvalanAy veNNey","uNDa vAyan * en uLLam kavarndhAnai **","aNDar kOn aNi aranggan * en amudhinaik","kaNDa kaNgaL * maRRonRinaik kANAvE"],["** கொண்டல் வண்ணனைக் * கோவலனாய் வெண்ணெய்","உண்ட வாயன் * என் உள்ளம் கவர்ந்தானை **","அண்டர் கோன் அணி அரங்கன் * என் அமுதினைக்","கண்ட கண்கள் * மற்றொன்றினைக் காணாவே"],0,"/media/recitation/AAP.10.mp3"]],"box":["https://app.box.com/s/yy12fyn79d1kx7oaifn5qd12owpza6rf","Amalanathipiraan [927-936].mp3",927,936]}]}