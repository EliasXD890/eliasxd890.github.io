{"id":"18-thiruviruththam","name":"Thiruviruththam","nameTa":"திருவிருத்தம்","alvar":"Nammazhvar","alvarTa":"நம்மாழ்வார்","src":"thiruviruththam","ayiram":3,"start":2478,"end":2577,"thaniyans":[{"le":["dasaka aDivaravu: nAnmugan vAzhththuga ivai mEl kANal enakku manakkEdham sEyan kadhavu thamarAvAr poynninRa","thaniyan","kiDAmbiyAchchAn aruLich cheydhadhu"],"lt":["தனியன்","கிடாம்பியாச்சான் அருளிச் செய்தது"],"en":["karu viruththak kuzhi nIththa pin kAmak kaDungkuzhi vIzhndhu *","oru viruththam pukku uzhaluRuvIr! * uyirin poruLgaTku","oru viruththam pugudhAmal kurugaiyar kOn uraiththa *","thiruviruththaththu Or aDi kaRRirIr thirunATTagaththE"],"ta":["கரு விருத்தக் குழி நீத்த பின் காமக் கடுங்குழி வீழ்ந்து *","ஒரு விருத்தம் புக்கு உழலுறுவீர்! * உயிரின் பொருள்கட்கு","ஒரு விருத்தம் புகுதாமல் குருகையர் கோன் உரைத்த *","திருவிருத்தத்து ஓர் அடி கற்றிரீர் திருநாட்டகத்தே"]}],"sections":[{"he":[],"ht":[],"ae":null,"at":null,"p":[[2478,2478,["** poynninRa njAnamum * pollA ozhukkum azhukkuDambum *","inninRa nIrmai ini yAm uRAmai ** uyir aLippAn","enninRa yOniyumAyp piRandhAy! imaiyOr thalaivA! *","meynninRu kETTaruLAy * aDiyEn seyyum viNNappamE"],["** பொய்ந்நின்ற ஞானமும் * பொல்லா ஒழுக்கும் அழுக்குடம்பும் *","இந்நின்ற நீர்மை இனி யாம் உறாமை ** உயிர் அளிப்பான்","எந்நின்ற யோனியுமாய்ப் பிறந்தாய்! இமையோர் தலைவா! *","மெய்ந்நின்று கேட்டருளாய் * அடியேன் செய்யும் விண்ணப்பமே"],0,"/media/recitation/TVT.1.mp3"],[2479,2479,["sezhu nIrth thaDaththuk * kayal miLirndhAl oppa * sEy arik kaN","azhu nIr thuLumba alamaruginRana ** vAzhiyarO","muzhu nIr mugil vaNNan kaNNan viNNATTavar mUdhuvarAm *","thozhu nIr iNai aDikkE * anbu sUTTiya sUzh kuzhaRkE"],["செழு நீர்த் தடத்துக் * கயல் மிளிர்ந்தால் ஒப்ப * சேய் அரிக் கண்","அழு நீர் துளும்ப அலமருகின்றன ** வாழியரோ","முழு நீர் முகில் வண்ணன் கண்ணன் விண்ணாட்டவர் மூதுவராம் *","தொழு நீர் இணை அடிக்கே * அன்பு சூட்டிய சூழ் குழற்கே"],0,"/media/recitation/TVT.2.mp3"],[2480,2480,["kuzhal kOvalar maDap pAvaiyum * maNmagaLum thiruvum *","nizhal pOlvanar kaNDu niRkungkol? mILungkol? ** thaNNanthuzhAy","azhal pOl aDum chakkaraththu aNNal viNNOr thozhak kaDavum *","thazhal pOl sinaththa * appuLLin pin pOna thani nenjchamE"],["குழல் கோவலர் மடப் பாவையும் * மண்மகளும் திருவும் *","நிழல் போல்வனர் கண்டு நிற்குங்கொல்? மீளுங்கொல்? ** தண்ணந்துழாய்","அழல் போல் அடும் சக்கரத்து அண்ணல் விண்ணோர் தொழக் கடவும் *","தழல் போல் சினத்த * அப்புள்ளின் பின் போன தனி நெஞ்சமே"],0,"/media/recitation/TVT.3.mp3"],[2481,2481,["thani nenjcham mun avar * puLLE kavarndhadhu * thaNNanthuzhAykku","ini nenjcham ingguk kavarvadhu yAm ilam ** nI naDuvE","muni vanjchap pEychchi mulai suvaiththAn muDi sUDu thuzhAyp *","pani nanjcha mArudhamE! * emmadhAvi panippu iyalvE?"],["தனி நெஞ்சம் முன் அவர் * புள்ளே கவர்ந்தது * தண்ணந்துழாய்க்கு","இனி நெஞ்சம் இங்குக் கவர்வது யாம் இலம் ** நீ நடுவே","முனி வஞ்சப் பேய்ச்சி முலை சுவைத்தான் முடி சூடு துழாய்ப் *","பனி நஞ்ச மாருதமே! * எம்மதாவி பனிப்பு இயல்வே?"],0,"/media/recitation/TVT.4.mp3"],[2482,2482,["panippu iyalvAga * uDaiya thaNvADai * ikkAlam ivvUrp","panippu iyalvellAm * thavirndhu eri vIsum ** anthaNNanthuzhAy","panip puyal sOrum thaDangkaNNi mAmaith thiRaththuk kolAm? *","panip puyal vaNNaN * sengkOl oru nAnRu thaDAviyadhE"],["பனிப்பு இயல்வாக * உடைய தண்வாடை * இக்காலம் இவ்வூர்ப்","பனிப்பு இயல்வெல்லாம் * தவிர்ந்து எரி வீசும் ** அந்தண்ணந்துழாய்","பனிப் புயல் சோரும் தடங்கண்ணி மாமைத் திறத்துக் கொலாம்? *","பனிப் புயல் வண்ணண் * செங்கோல் ஒரு நான்று தடாவியதே"],0,"/media/recitation/TVT.5.mp3"],[2483,2483,["thaDAviya ambum * murindha silaigaLum pOga viTTu *","kaDAyina koNDu olgum valli IdhEnum ** asurar manggak","kaDAviya vEgap paRavaiyin pAgan madhana sengkOl *","naDAviya kURRam kaNDIr * uyir kAmingaL njAlaththuLLE"],["தடாவிய அம்பும் * முரிந்த சிலைகளும் போக விட்டு *","கடாயின கொண்டு ஒல்கும் வல்லி ஈதேனும் ** அசுரர் மங்கக்","கடாவிய வேகப் பறவையின் பாகன் மதன செங்கோல் *","நடாவிய கூற்றம் கண்டீர் * உயிர் காமின்கள் ஞாலத்துள்ளே"],0,"/media/recitation/TVT.6.mp3"],[2484,2484,["njAlam panippach seRiththu * nannIr iTTukkAl sidhaindhu *","nIla vallERu porA ninRa vAnam idhu ** thirumAl","kOlam sumandhu pirindhAr koDumai kuzhaRu * thaN pUng","kAlangkolO? aRiyEn * vinaiyATTiyEn kANginRavE"],["ஞாலம் பனிப்பச் செறித்து * நன்னீர் இட்டுக்கால் சிதைந்து *","நீல வல்லேறு பொரா நின்ற வானம் இது ** திருமால்","கோலம் சுமந்து பிரிந்தார் கொடுமை குழறு * தண் பூங்","காலங்கொலோ? அறியேன் * வினையாட்டியேன் காண்கின்றவே"],0,"/media/recitation/TVT.7.mp3"],[2485,2485,["kANginRanagaLum * kETkinRanagaLum kANil * innAL","pAN kunRa nADar payilginRana ** idhellAm aRindhOm","mAN kunRam Endhith thaN mA malai vEngkaDaththumbar nambum *","sEN kunRam senRu * poruL paDaippAn kaRRa thiNNanavE"],["காண்கின்றனகளும் * கேட்கின்றனகளும் காணில் * இந்நாள்","பாண் குன்ற நாடர் பயில்கின்றன ** இதெல்லாம் அறிந்தோம்","மாண் குன்றம் ஏந்தித் தண் மா மலை வேங்கடத்தும்பர் நம்பும் *","சேண் குன்றம் சென்று * பொருள் படைப்பான் கற்ற திண்ணனவே"],0,"/media/recitation/TVT.8.mp3"],[2486,2486,["thiN pUnjchuDar nudhi nEmi anjchelvar * viNNADu anaiya","vaN pU maNi valli * ArE piribavar thAm? ** ivaiyO","kaN pUngkamalam karunjchuDar ADi veNmuththu arumbi *","vaNpUngkuvaLai * maDa mAn vizhikkinRa mA idhazhE"],["திண் பூஞ்சுடர் நுதி நேமி அஞ்செல்வர் * விண்ணாடு அனைய","வண் பூ மணி வல்லி * ஆரே பிரிபவர் தாம்? ** இவையோ","கண் பூங்கமலம் கருஞ்சுடர் ஆடி வெண்முத்து அரும்பி *","வண்பூங்குவளை * மட மான் விழிக்கின்ற மா இதழே"],0,"/media/recitation/TVT.9.mp3"],[2487,2487,["mAyOn vaDa thiruvEngkaDa nADa * vallik koDigAL!","nOyO uraikkilum * kETkinRilIr uraiyIr ** numadhu","vAyO? adhu anRi valvinaiyEnum kiLiyum eLgum","AyO? * aDum thoNDaiyO? * aRaiyO! idhu aRivaridhE"],["மாயோன் வட திருவேங்கட நாட * வல்லிக் கொடிகாள்!","நோயோ உரைக்கிலும் * கேட்கின்றிலீர் உரையீர் ** நுமது","வாயோ? அது அன்றி வல்வினையேனும் கிளியும் எள்கும்","ஆயோ? * அடும் தொண்டையோ? * அறையோ! இதறிவரிதே"],0,"/media/recitation/TVT.10.mp3"],[2488,2488,["ariyana yAm inRu kANginRana * kaNNan viN anaiyAy!","periyana kAdham * poruTkO pirivena ** njAlam eydhaRu","uriyana oNmuththum paimponnum Endhi OrO kuDangkaip *","periyana keNDaik kulam * ivaiyO vandhu pErginRavE"],["அரியன யாம் இன்று காண்கின்றன * கண்ணன் விண் அனையாய்!","பெரியன காதம் * பொருட்கோ பிரிவென ** ஞாலம் எய்தற்கு","உரியன ஒண்முத்தும் பைம்பொன்னும் ஏந்தி ஓரோ குடங்கைப் *","பெரியன கெண்டைக் குலம் * இவையோ வந்து பேர்கின்றவே"],0,"/media/recitation/TVT.11.mp3"],[2489,2489,["pErginRadhu maNi mAmai * piRanggi aLLal payalai *","UrginRadhu kanggul UzhigaLE ** idhellAm inavE","IrginRa chakkaraththu emperumAn kaNNan thaNNanthuzhAy *","sArginRa nannenjchinAr * thandhu pOna thani vaLamE"],["பேர்கின்றது மணி மாமை * பிறங்கி அள்ளல் பயலை *","ஊர்கின்றது கங்குல் ஊழிகளே ** இதெல்லாம் இனவே","ஈர்கின்ற சக்கரத்து எம்பெருமான் கண்ணன் தண்ணந்துழாய் *","சார்கின்ற நன்னெஞ்சினார் * தந்து போன தனி வளமே"],0,"/media/recitation/TVT.12.mp3"],[2490,2490,["thani vaLar sengkOl naDAvu * thazhal vAy arasaviyap","pani vaLar sengkOl * iruL vIRRu irundhadhu ** pAr muzhudhum","thuni vaLar kAdhal thuzhAyaith thuzhAvu thaNvADai thaDindhu *","ini vaLai kAppavar Ar? * enai UzhigaL IrvanavE"],["தனி வளர் செங்கோல் நடாவு * தழல் வாய் அரசவியப்","பனி வளர் செங்கோல் * இருள் வீற்று இருந்தது ** பார் முழுதும்","துனி வளர் காதல் துழாயைத் துழாவு தண்வாடை தடிந்து *","இனி வளை காப்பவர் ஆர்? * எனை ஊழிகள் ஈர்வனவே"],0,"/media/recitation/TVT.13.mp3"],[2491,2491,["Irvana vElum anjchElum * uyir mEl miLirndhu ivaiyO","pErvanavO alla * dheyva nal vEL kaNai ** pEr oLiyE","sOrvana nIlach suDar viDu mEni ammAn * visumbUr","thErvana * dheyvam annIra kaNNO? ichchezhum kayalE"],["ஈர்வன வேலும் அஞ்சேலும் * உயிர் மேல் மிளிர்ந்து இவையோ","பேர்வனவோ அல்ல * தெய்வ நல் வேள் கணை ** பேர் ஒளியே","சோர்வன நீலச் சுடர் விடு மேனி அம்மான் * விசும்பூர்","தேர்வன * தெய்வம் அன்னீர கண்ணோ? இச்செழும் கயலே"],0,"/media/recitation/TVT.14.mp3"],[2492,2492,["kayalO numa kaNgaL? enRu * kaLiRu vinavi niRRIr *","ayalOr aRiyilum Idhenna vArththai? ** kaDal kavarndha","puyalODu ulAm koNDal vaNNan puna vEngkaDaththu emmoDum *","payalO ilIr * kollai kAkkinRa nALum pala palavE"],["கயலோ நும கண்கள்? என்று * களிறு வினவி நிற்றீர் *","அயலோர் அறியிலும் ஈதென்ன வார்த்தை? ** கடல் கவர்ந்த","புயலோடு உலாம் கொண்டல் வண்ணன் புன வேங்கடத்து எம்மொடும் *","பயலோ இலீர் * கொல்லை காக்கின்ற நாளும் பல பலவே"],0,"/media/recitation/TVT.15.mp3"],[2493,2493,["pala pala UzhigaL AyiDum * anRi Or nAzhigaiyaip","pala pala kURiTTa kURAyiDum ** kaNNan viN anaiyAy!","pala pala nAL anbar kUDilum nInggilum yAm melidhum *","pala pala sUzhal uDaiththu * amma! vAzhi ippAy iruLE"],["பல பல ஊழிகள் ஆயிடும் * அன்றி ஓர் நாழிகையைப்","பல பல கூறிட்ட கூறாயிடும் ** கண்ணன் விண் அனையாய்!","பல பல நாள் அன்பர் கூடிலும் நீங்கிலும் யாம் மெலிதும் *","பல பல சூழல் உடைத்து * அம்ம! வாழி இப்பாய் இருளே"],0,"/media/recitation/TVT.16.mp3"],[2494,2494,["iruL virindhAl anna * mA nIrth thirai koNDu vAzhiyarO *","iruL pirindhAr anbar thEr vazhi thUral ** aravaNai mEl","iruL viri nIlak karu nAyiRu suDar kAlvadhu pOl *","iruL viri sOdhi * perumAn uRaiyum eRi kaDalE!"],["இருள் விரிந்தால் அன்ன * மா நீர்த் திரை கொண்டு வாழியரோ *","இருள் பிரிந்தார் அன்பர் தேர் வழி தூரல் ** அரவணை மேல்","இருள் விரி நீலக் கரு நாயிறு சுடர் கால்வது போல் *","இருள் விரி சோதி * பெருமான் உறையும் எறி கடலே!"],0,"/media/recitation/TVT.17.mp3"],[2495,2495,["kaDal koNDu ezhundhadhu vAnam * avvAnaththai anRich senRu *","kaDal koNDu ozhindha adhanAl idhu ** kaNNan maNNum viNNum","kaDal koNDu ezhundha akkAlam kolO? puyal kAlam kolO? *","kaDal koNDa kaNNIr * aruvi seyyA niRkum kArigaiyE"],["கடல் கொண்டு எழுந்தது வானம் * அவ்வானத்தை அன்றிச் சென்று *","கடல் கொண்டு ஒழிந்த அதனால் இது ** கண்ணன் மண்ணும் விண்ணும்","கடல் கொண்டு எழுந்த அக்காலம் கொலோ? புயல் காலம் கொலோ? *","கடல் கொண்ட கண்ணீர் * அருவி செய்யா நிற்கும் காரிகையே"],0,"/media/recitation/TVT.18.mp3"],[2496,2496,["kArigaiyAr niRai kAppavar yAr enRu * kAr koNDu innE","mAri kai ERi * aRaiyiDum kAlaththum ** vAzhiyarO","sArigaip puLLar anthaNNanthuzhAy iRai kUy aruLAr *","sEri kai Erum * pazhiyAy viLaindhadhu en chinmozhikkE"],["காரிகையார் நிறை காப்பவர் யார் என்று * கார் கொண்டு இன்னே","மாரி கை ஏறி * அறையிடும் காலத்தும் ** வாழியரோ","சாரிகைப் புள்ளர் அந்தண்ணந்துழாய் இறை கூய் அருளார் *","சேரி கை ஏரும் * பழியாய் விளைந்தது என் சின்மொழிக்கே"],0,"/media/recitation/TVT.19.mp3"],[2497,2497,["chinmozhi nOyO kazhi perundheyvam * innOy inadhenRu","inmozhi kETkum * iLandheyvam anRidhu ** vEla! nil nI","en mozhi kENmin en ammanaimIr! * ulagEzhum uNDAn","sol mozhi * mAlai anthaNNanthuzhAy koNDu sUTTuminE"],["சின்மொழி நோயோ கழி பெருந்தெய்வம் * இந்நோய் இனதென்று","இன்மொழி கேட்கும் * இளந்தெய்வம் அன்றிது ** வேல! நில் நீ","என் மொழி கேண்மின் என் அம்மனைமீர்! * உலகேழும் உண்டான்","சொல் மொழி * மாலை அந்தண்ணந்துழாய் கொண்டு சூட்டுமினே"],0,"/media/recitation/TVT.20.mp3"],[2498,2498,["sUTTu nanmAlaigaL * thUyana Endhi * viNNOrgaL nannIr","ATTi * anthUbam tharA niRkavE anggu ** Or mAyaiyinAl","ITTiya veNNai thoDu uNNap pOndhimil ERRu van kUn *","kOTTiDai ADinai kUththu * aDal Ayar tham kombinukkE"],["சூட்டு நன்மாலைகள் * தூயன ஏந்தி * விண்ணோர்கள் நன்னீர்","ஆட்டி * அந்தூபம் தரா நிற்கவே அங்கு ** ஓர் மாயையினால்","ஈட்டிய வெண்ணை தொடு உண்ணப் போந்திமில் ஏற்று வன் கூன் *","கோட்டிடை ஆடினை கூத்து * அடல் ஆயர் தம் கொம்பினுக்கே"],0,"/media/recitation/TVT.21.mp3"],[2499,2499,["kombAr thazhai kai * siRu nAN eRivilam * vETTai koNDATTu","ambAr kaLiRu * vinavuvadhaiyar ** puL Urum kaLvar","tham pAr agaththenRum ADAdhana thammil kUDAdhana *","vambAr vinAch sollavO * emmai vaiththadhu ivvAn punaththE"],["கொம்பார் தழை கை * சிறு நாண் எறிவிலம் * வேட்டை கொண்டாட்டு","அம்பார் களிறு * வினவுவதையர் ** புள் ஊரும் கள்வர்","தம் பார் அகத்தென்றும் ஆடாதன தம்மில் கூடாதன *","வம்பார் வினாச் சொல்லவோ * எம்மை வைத்தது இவ்வான் புனத்தே"],0,"/media/recitation/TVT.22.mp3"],[2500,2500,["punamO? punaththayalE * vazhi pOgum aruvinaiyEn *","manamO? magaLir! num kAval sollIr ** puNDarIgaththu angkEzh","vanam Or anaiya kaNNAn kaNNan vANADamarum * dheyvath","thinam Or anaiyIrgaLAy * ivaiyO num iyalvugaLE?"],["புனமோ? புனத்தயலே * வழி போகும் அருவினையேன் *","மனமோ? மகளிர்! நும் காவல் சொல்லீர் ** புண்டரீகத்து அங்கேழ்","வனம் ஓர் அனைய கண்ணான் கண்ணன் வாணாடமரும் * தெய்வத்","தினம் ஓர் அனையீர்களாய் * இவையோ நும் இயல்வுகளே?"],0,"/media/recitation/TVT.23.mp3"],[2501,2501,["iyalvu Ayina * vanjcha nOy koNDu ulAvum * OrO kuDangkaik","kayal pAyvana * peru nIrk kaNgaL thammoDum ** kunRam onRAl","puyal vAyina nirai kAththa puL Urdhi kaL Urum thuzhAyk *","koyal vAy malar mEl * manaththoDu ennAngkol engkOl vaLaikkE?"],["இயல்வு ஆயின * வஞ்ச நோய் கொண்டு உலாவும் * ஓரோ குடங்கைக்","கயல் பாய்வன * பெரு நீர்க் கண்கள் தம்மொடும் ** குன்றம் ஒன்றால்","புயல் வாயின நிரை காத்த புள் ஊர்தி கள் ஊரும் துழாய்க் *","கொயல் வாய் மலர் மேல் * மனத்தொடு என்னாங்கொல் எங்கோல் வளைக்கே?"],0,"/media/recitation/TVT.24.mp3"],[2502,2502,["engkOl vaLai mudhalAk * kaNNan maNNum viNNum aLikkum *","sengkOl vaLaivu viLaivikkumAl ** thiRal sEr amarar","thangkOnuDaiya thangkOn umbar ellA yavarkkum thangkOn *","nangkOn ugakkum thuzhAy * en seyyAdhu ini nAnilaththE?"],["எங்கோல் வளை முதலாக் * கண்ணன் மண்ணும் விண்ணும் அளிக்கும் *","செங்கோல் வளைவு விளைவிக்குமால் ** திறல் சேர் அமரர்","தங்கோனுடைய தங்கோன் உம்பர் எல்லா யவர்க்கும் தங்கோன் *","நங்கோன் உகக்கும் துழாய் * என் செய்யாது இனி நானிலத்தே?"],0,"/media/recitation/TVT.25.mp3"],[2503,2503,["nAnilam vAyk koNDu * nannIr aRam enRu kOdhu koNDa *","vEnil anjchelvan suvaiththumizh pAlai ** kaDandha ponnE!","kAl nilam thOyndhu viNNOr thozhum kaNNan veqkA udhu * ampUn","thEniLam sOlai appAladhu * eppAlaikkum sEmaththadhE"],["நானிலம் வாய்க் கொண்டு * நன்னீர் அறம் என்று கோது கொண்ட *","வேனில் அஞ்செல்வன் சுவைத்துமிழ் பாலை ** கடந்த பொன்னே!","கால் நிலம் தோய்ந்து விண்ணோர் தொழும் கண்ணன் வெஃகா உது * அம்பூந்","தேனிளம் சோலை அப்பாலது * எப்பாலைக்கும் சேமத்ததே"],0,"/media/recitation/TVT.26.mp3"],[2504,2504,["cemam cĕṅkoṉ arul̤e * cĕṟuvārum naṭpu ākuvar ĕṉṟu","emam pĕṟa vaiyam * cŏllum mĕyye ** paṇṭu ĕllām aṟai kūy","yāmaṅkal̤ toṟu ĕri vīcum nam kaṇṇaṉ am taṇṇam tuzhāyt *","tāmam puṉaiya * av vāṭai īto vantu taṇṇĕṉṟate"],["சேமம் செங்கோன் அருளே * செறுவாரும் நட்பு ஆகுவர் என்று","ஏமம் பெற வையம் * சொல்லும் மெய்யே ** பண்டு எல்லாம் அறை கூய்","யாமங்கள் தோறு எரி வீசும் நம் கண்ணன் அம் தண்ணம் துழாய்த் *","தாமம் புனைய * அவ் வாடை ஈதோ வந்து தண்ணென்றதே"],1,"/media/recitation/TVT.27.mp3"],[2505,2505,["taṇ am tuzhāy * val̤ai kŏl̤vatu yām izhappom * naṭuve","vaṇṇam tuzhāvi * or vāṭai ulāvum ** val̤ vāy alakāl","pul̤ nantu uzhāme pŏru nīrt tiruvaraṅkā * arul̤āy *","ĕṇṇam tuzhāvumiṭattu * ul̤avo paṇṭum iṉṉaṉṉave?"],["தண் அம் துழாய் * வளை கொள்வது யாம் இழப்போம் * நடுவே","வண்ணம் துழாவி * ஓர் வாடை உலாவும் ** வள் வாய் அலகால்","புள் நந்து உழாமே பொரு நீர்த் திருவரங்கா * அருளாய் *","எண்ணம் துழாவுமிடத்து * உளவோ பண்டும் இன்னன்னவே?"],1,"/media/recitation/TVT.28.mp3"],[2506,2506,["innanna thUdhu emmai * AL aRRap paTTirandhAL ivaL enRu *","annanna sollAp peDaiyoDum pOy varum ** nIlam uNDa","min anna mEnip perumAn ulagil peN thUdhu sellA *","annanna nIrmai kolO? * kuDich sIrmaiyil annanggaLE!"],["இன்னன்ன தூது எம்மை * ஆள் அற்றப் பட்டிரந்தாள் இவள் என்று *","அன்னன்ன சொல்லாப் பெடையொடும் போய் வரும் ** நீலம் உண்ட","மின் அன்ன மேனிப் பெருமான் உலகில் பெண் தூது செல்லா *","அன்னன்ன நீர்மை கொலோ? * குடிச் சீர்மையில் அன்னங்களே!"],0,"/media/recitation/TVT.29.mp3"],[2507,2507,["annam selvIrum * vaNDAnam selvIrum thozhudhu irandhEn *","munnam selvIrgaL maRavEnminO ** kaNNan vaigundhanODu","en nenjchinAraik kaNDAl ennaich solli * avariDai nIr","innam sellIrO? * idhuvO thagavenRu isaiminkaLE!"],["அன்னம் செல்வீரும் * வண்டானம் செல்வீரும் தொழுது இரந்தேன் *","முன்னம் செல்வீர்கள் மறவேன்மினோ ** கண்ணன் வைகுந்தனோடு","என் நெஞ்சினாரைக் கண்டால் என்னைச் சொல்லி * அவரிடை நீர்","இன்னம் செல்லீரோ? * இதுவோ தகவென்று இசைமின்களே!"],0,"/media/recitation/TVT.30.mp3"],[2508,2508,["isaiminkaL thUdhu enRu isaiththAl isaiyilam * en thalai mEl","asaiminkaL enRAl asaiyungkol Am? ** ampon mAmaNigaL","thisai min miLirum thiruvEngkaDaththu van thAL * simaya","misai * min miLiriya pOvAn vazhik koNDa mEganggaLE !"],["இசைமின்கள் தூது என்று இசைத்தால் இசையிலம் * என் தலை மேல்","அசைமின்கள் என்றால் அசையுங்கொல் ஆம்? ** அம்பொன் மாமணிகள்","திசை மின் மிளிரும் திருவேங்கடத்து வன் தாள் * சிமய","மிசை * மின் மிளிரிய போவான் வழிக் கொண்ட மேகங்களே !"],0,"/media/recitation/TVT.31.mp3"],[2509,2509,["mEganggaLO! uraiyIr * thirumAl thirumEni okkum *","yOganggaL unggaLukku evvARu peRRIr? ** uyir aLippAn","mAganggaL ellAm thirindhu nannIrgaL sumandhu * nuntham","AganggaL nOva * varuththum thavamAm aruL peRRadhE"],["மேகங்களோ! உரையீர் * திருமால் திருமேனி ஒக்கும் *","யோகங்கள் உங்களுக்கு எவ்வாறு பெற்றீர்? ** உயிர் அளிப்பான்","மாகங்கள் எல்லாம் திரிந்து நன்னீர்கள் சுமந்து * நுந்தம்","ஆகங்கள் நோவ * வருத்தும் தவமாம் அருள் பெற்றதே"],0,"/media/recitation/TVT.32.mp3"],[2510,2510,["aruL Ar thiruchchakkaraththAl * agal visumbum nilanum *","iruL Ar vinai keDach sengkOl naDAvudhir ** InggOr peNpAl","poruLO enum igazhvO? * ivaRRin puRaththAL enRu eNNO? *","theruLOm aravaNaiyIr! * ivaL mAmai sidhaikkinRadhE"],["அருள் ஆர் திருச்சக்கரத்தால் * அகல் விசும்பும் நிலனும் *","இருள் ஆர் வினை கெடச் செங்கோல் நடாவுதிர் ** ஈங்கோர் பெண்பால்","பொருளோ எனும் இகழ்வோ? * இவற்றின் புறத்தாள் என்று எண்ணோ? *","தெருளோம் அரவணையீர்! * இவள் மாமை சிதைக்கின்றதே"],0,"/media/recitation/TVT.33.mp3"],[2511,2511,["sidhaikkinRadhAzhi enRu * Azhiyaich sIRi * than sIRaDiyAl","udhaikkinRa nAyagam * thannoDu mAlE! ** unadhu thaNthAr","thadhaikkinRa thaNNanthuzhAy aNivAn adhuvE manamAyp *","padhaikkinRa mAdhin thiRaththu * aRiyEn seyaRpAladhuvE"],["சிதைக்கின்றதாழி என்று * ஆழியைச் சீறி * தன் சீறடியால்","உதைக்கின்ற நாயகம் * தன்னொடு மாலே! ** உனது தண்தார்","ததைக்கின்ற தண்ணந்துழாய் அணிவான் அதுவே மனமாய்ப் *","பதைக்கின்ற மாதின் திறத்து * அறியேன் செயற்பாலதுவே"],0,"/media/recitation/TVT.34.mp3"],[2512,2512,["pAl vAyp piRaip piLLai * okkalaik koNDu * pagal izhandha","mEl pAl thisaip peN * pulambuRu mAlai ** ulagaLandha","mAl pAl thuzhAykku manam uDaiyArkku nalkiRRai ellAm *","sOlvAn pugundhu * idhu Or pani vADai thuzhAginRadhE"],["பால் வாய்ப் பிறைப் பிள்ளை * ஒக்கலைக் கொண்டு * பகல் இழந்த","மேல் பால் திசைப் பெண் * புலம்புறு மாலை ** உலகளந்த","மால் பால் துழாய்க்கு மனம் உடையார்க்கு நல்கிற்றை எல்லாம் *","சோல்வான் புகுந்து * இது ஓர் பனி வாடை துழாகின்றதே"],0,"/media/recitation/TVT.35.mp3"],[2513,2513,["thuzhA neDunjchUzh iruL enRu * thanthaN thAr adhu peyarA *","ezhA neDu Uzhi ezhundha ikkAlaththum ** Inggu ivaLO!","vazhA neDunthunbaththaL enRu iranggAr ammanO! * ilanggaik","kuzhA neDu mADam * iDiththa pirAnAr koDumaigaLE!"],["துழா நெடுஞ்சூழ் இருள் என்று * தந்தண் தார் அது பெயரா *","எழா நெடு ஊழி எழுந்த இக்காலத்தும் ** ஈங்கு இவளோ!","வழா நெடுந்துன்பத்தள் என்று இரங்கார் அம்மனோ! * இலங்கைக்","குழா நெடு மாடம் * இடித்த பிரானார் கொடுமைகளே!"],0,"/media/recitation/TVT.36.mp3"],[2514,2514,["koDungkAl silaiyar * nirai kOL uzhavar kolaiyil veyya *","kaDungkAl iLainjar thuDi paDum kavvaiththu ** aruvinaiyEn","neDungkAlamum kaNNan nIL malarp pAdham paravip peRRa *","thoDungkAl osiyum iDai * iLamAn senRa sUzh kaDamE"],["கொடுங்கால் சிலையர் * நிரை கோள் உழவர் கொலையில் வெய்ய *","கடுங்கால் இளைஞர் துடி படும் கவ்வைத்து ** அருவினையேன்","நெடுங்காலமும் கண்ணன் நீள் மலர்ப் பாதம் பரவிப் பெற்ற *","தொடுங்கால் ஒசியும் இடை * இளமான் சென்ற சூழ் கடமே"],0,"/media/recitation/TVT.37.mp3"],[2515,2515,["kaṭam āyiṉakal̤ kazhittu * taṉ kāl vaṉmaiyāl pala nāl̤ *","taṭam āyiṉa pukku * nīr nilainiṉṟa tavam itukŏl **","kuṭam āṭi im maṇṇum viṇṇum kuluṅka ulaku al̤antu *","naṭamāṭiya pĕrumāṉ * uru ŏttaṉa nīlaṅkal̤e?"],["கடம் ஆயினகள் கழித்து * தன் கால் வன்மையால் பல நாள் *","தடம் ஆயின புக்கு * நீர் நிலைநின்ற தவம் இதுகொல் **","குடம் ஆடி இம் மண்ணும் விண்ணும் குலுங்க உலகு அளந்து *","நடமாடிய பெருமான் * உரு ஒத்தன நீலங்களே?"],1,"/media/recitation/TVT.38.mp3"],[2516,2516,["nIlath thaDa varai mEl * puNDarIga neDunthaDanggaL","pOla * polindhu emakku ellA iDaththavum ** ponggu munnIr","njAlap pirAn visumbukkum pirAn maRRum nallOr pirAn *","kOlam kariya pirAn * empirAn kaNNin kOlanggaLE"],["நீலத் தட வரை மேல் * புண்டரீக நெடுந்தடங்கள்","போல * பொலிந்து எமக்கு எல்லா இடத்தவும் ** பொங்கு முந்நீர்","ஞாலப் பிரான் விசும்புக்கும் பிரான் மற்றும் நல்லோர் பிரான் *","கோலம் கரிய பிரான் * எம்பிரான் கண்ணின் கோலங்களே"],0,"/media/recitation/TVT.39.mp3"],[2517,2517,["kOlap pagal kaLiRu * onRu kaRpuyya * kuzhAm virindha","nIlak kanggul * kaLiRellAm niRaindhana ** nEr izhaiyIr !","njAlap pon mAdhin maNALan thuzhAy nanggaL sUzh kuzhaRkE *","Elap punaindhu ennaimAr * emmai nOkkuvadhu enRu kolO?"],["கோலப் பகல் களிறு * ஒன்று கற்புய்ய * குழாம் விரிந்த","நீலக் கங்குல் * களிறெல்லாம் நிறைந்தன ** நேர் இழையீர் !","ஞாலப் பொன் மாதின் மணாளன் துழாய் நங்கள் சூழ் குழற்கே *","ஏலப் புனைந்து என்னைமார் * எம்மை நோக்குவது என்று கொலோ?"],0,"/media/recitation/TVT.40.mp3"],[2518,2518,["enRum pun vADai * idhu kaNDaRidhum * ivvARu vemmai","onRum uruvum suvaDum theriyilam ** Onggasurar","ponRum vagai puLLai UrvAn aruL aruLAdha innAL *","manRil niRai pazhi thURRi * ninRu ennai van kARRu aDumE"],["என்றும் புன் வாடை * இது கண்டறிதும் * இவ்வாறு வெம்மை","ஒன்றும் உருவும் சுவடும் தெரியிலம் ** ஓங்கசுரர்","பொன்றும் வகை புள்ளை ஊர்வான் அருள் அருளாத இந்நாள் *","மன்றில் நிறை பழி தூற்றி * நின்று என்னை வன் காற்று அடுமே"],0,"/media/recitation/TVT.41.mp3"],[2519,2519,["van kARRu aRaiya * orunggE maRindhu kiDandhu alarndha *","men kAl kamalath thaDam pOl polindhana ** maNNum viNNum","en kARku aLavinmai kANmin enbAn oththu vAn nimirndha *","than kAR paNindha en pAl * empirAna thaDangkaNgaLE"],["வன் காற்று அறைய * ஒருங்கே மறிந்து கிடந்து அலர்ந்த *","மென் கால் கமலத் தடம் போல் பொலிந்தன ** மண்ணும் விண்ணும்","என் காற்கு அளவின்மை காண்மின் என்பான் ஒத்து வான் நிமிர்ந்த *","தன் காற் பணிந்த என் பால் * எம்பிரான தடங்கண்களே"],0,"/media/recitation/TVT.42.mp3"],[2520,2520,["kaNNum senthAmarai * kaiyum avai aDiyO avaiyE *","vaNNam kariyadhOr mAl varai pOnRu ** madhi vikaRpAl","viNNum kaDandhu umbar appAl mikku maRRu eppAl yavarkkum *","eNNum iDaththadhuvO? * empirAnadhu ezhil niRamE"],["கண்ணும் செந்தாமரை * கையும் அவை அடியோ அவையே *","வண்ணம் கரியதோர் மால் வரை போன்று ** மதி விகற்பால்","விண்ணும் கடந்து உம்பர் அப்பால் மிக்கு மற்று எப்பால் யவர்க்கும் *","எண்ணும் இடத்ததுவோ? * எம்பிரானது எழில் நிறமே"],0,"/media/recitation/TVT.43.mp3"],[2521,2521,["niRam uyar kOlamum * pErum uruvum ivai ivai enRu *","aRa muyal njAnach samayigaL pEsilum ** angganggu ellAm","uRa uyar njAnach suDar viLakkAy ninRadhanRi onRum *","peRa muyanRAr illaiyAl * empirAna perumaiyaiyE"],["நிறம் உயர் கோலமும் * பேரும் உருவும் இவை இவை என்று *","அற முயல் ஞானச் சமயிகள் பேசிலும் ** அங்கங்கு எல்லாம்","உற உயர் ஞானச் சுடர் விளக்காய் நின்றதன்றி ஒன்றும் *","பெற முயன்றார் இல்லையால் * எம்பிரான பெருமையையே"],0,"/media/recitation/TVT.44.mp3"],[2522,2522,["perungkEzhalAr tham * perungkaN malarp puNDarIkam * nam mEl","orunggE piRazha vaiththAr ivvakAlam ** oruvar nam pOl","varum kEzhbavar uLarE? thollai vAzhiyam sUzh piRappu *","marunggE varap peRumE? * sollu vAzhi maDa nenjchamE!"],["பெருங்கேழலார் தம் * பெருங்கண் மலர்ப் புண்டரீகம் * நம் மேல்","ஒருங்கே பிறழ வைத்தார் இவ்வகாலம் ** ஒருவர் நம் போல்","வரும் கேழ்பவர் உளரே? தொல்லை வாழியம் சூழ் பிறப்பு *","மருங்கே வரப் பெறுமே? * சொல்லு வாழி மட நெஞ்சமே!"],0,"/media/recitation/TVT.45.mp3"],[2523,2523,["maDa nenjcham enRum thamadhu enRum * Or karumam karudhi","viDa nenjchai uRRAr viDavO amaiyum ** appon peyarOn","thaDa nenjcham kINDa pirAnAr thamadhu aDikkIzh viDap * pOyth","thiDa nenjchamAy * emmai nIththu inRu thARum thiriginRadhE"],["மட நெஞ்சம் என்றும் தமது என்றும் * ஓர் கருமம் கருதி","விட நெஞ்சை உற்றார் விடவோ அமையும் ** அப்பொன் பெயரோன்","தட நெஞ்சம் கீண்ட பிரானார் தமது அடிக்கீழ் விடப் * போய்த்","திட நெஞ்சமாய் * எம்மை நீத்து இன்று தாறும் திரிகின்றதே"],0,"/media/recitation/TVT.46.mp3"],[2524,2524,["thiriginRadhu vaDa mArudham * thinggaL venthI mugandhu *","soriginRadhu adhuvum adhu ** kaNNan viNNUr thozhavE","sariginRadhu sanggam thaNNanthuzhAykku vaNNam payalai *","viriginRadhu muzhu meyyum * ennAngkol en melliyaRkE?"],["திரிகின்றது வட மாருதம் * திங்கள் வெந்தீ முகந்து *","சொரிகின்றது அதுவும் அது ** கண்ணன் விண்ணூர் தொழவே","சரிகின்றது சங்கம் தண்ணந்துழாய்க்கு வண்ணம் பயலை *","விரிகின்றது முழு மெய்யும் * என்னாங்கொல் என் மெல்லியற்கே?"],0,"/media/recitation/TVT.47.mp3"],[2525,2525,["melliyal Akkaik kirumi * kuruvil miLirthandhu AnggE","selliya selgaiththu * ulagai en kANum? ** ennAlum thannaich","solliya sUzhal thirumAlavan kavi yAdhu kaRREn *","palliyin sollum sollA * koLvadhO uNDu paNDu paNDE"],["மெல்லியல் ஆக்கைக் கிருமி * குருவில் மிளிர்தந்து ஆங்கே","செல்லிய செல்கைத்து * உலகை என் காணும்? ** என்னாலும் தன்னைச்","சொல்லிய சூழல் திருமாலவன் கவி யாது கற்றேன் *","பல்லியின் சொல்லும் சொல்லா * கொள்வதோ உண்டு பண்டு பண்டே"],0,"/media/recitation/TVT.48.mp3"],[2526,2526,["paNDum pala pala * vInggiruL kANDum * ippAy iruL pOl","kaNDum aRivadhum * kETpadhum yAm ilam ** kALa vaNNa","vaNDuN thuzhAyp perumAn madhusUdhanan dhAmOdharan *","uNDum umizhndhum kaDAya * maNNEr anna oNNudhalE!"],["பண்டும் பல பல * வீங்கிருள் காண்டும் * இப்பாய் இருள் போல்","கண்டும் அறிவதும் * கேட்பதும் யாம் இலம் ** காள வண்ண","வண்டுண் துழாய்ப் பெருமான் மதுசூதனன் தாமோதரன் *","உண்டும் உமிழ்ந்தும் கடாய * மண்ணேர் அன்ன ஒண்ணுதலே!"],0,"/media/recitation/TVT.49.mp3"],[2527,2527,["oNNudhal mAmai * oLi payavAmai * viraindhu nanthEr","naNNudhal vENDum * valava! kaDAkinRu ** thEn navinRa","viN mudhal nAyagan nIL muDi veNmuththa vAsigaiththAy *","maN mudhal sErvuRRu * aruvi seyyA niRkum mAmalaikkE"],["ஒண்ணுதல் மாமை * ஒளி பயவாமை * விரைந்து நந்தேர்","நண்ணுதல் வேண்டும் * வலவ! கடாகின்று ** தேன் நவின்ற","விண் முதல் நாயகன் நீள் முடி வெண்முத்த வாசிகைத்தாய் *","மண் முதல் சேர்வுற்று * அருவி செய்யா நிற்கும் மாமலைக்கே"],0,"/media/recitation/TVT.50.mp3"],[2528,2528,["malai koNDu maththA aravAl suzhaRRiya mAyap pirAn *","alai kaNDu koNDa amudham koLLAdhu kaDal ** paradhar","vilai koNDu thandha sanggam ivai vErith thuzhAy thuNaiyAth *","thulai koNDu thAyam kiLarndhu * koLvAn oththu azhaikkinRadhE"],["மலை கொண்டு மத்தா அரவால் சுழற்றிய மாயப் பிரான் *","அலை கண்டு கொண்ட அமுதம் கொள்ளாது கடல் ** பரதர்","விலை கொண்டு தந்த சங்கம் இவை வேரித் துழாய் துணையாத் *","துலை கொண்டு தாயம் கிளர்ந்து * கொள்வான் ஒத்து அழைக்கின்றதே"],0,"/media/recitation/TVT.51.mp3"],[2529,2529,["azhaikkum karungkaDal * veNthiraik kaik koNDu pOy * alar vAy","mazhaik kaN maDandhai * aravaNai ERa ** maN mAdhar viN vAy","azhaiththup pulambi mulai malai mEl ninRum ARugaLAy *","mazhaik kaNNa nIr * thirumAl koDiyAn enRu vArginRadhE!"],["அழைக்கும் கருங்கடல் * வெண்திரைக் கைக் கொண்டு போய் * அலர் வாய்","மழைக் கண் மடந்தை * அரவணை ஏற ** மண் மாதர் விண் வாய்","அழைத்துப் புலம்பி முலை மலை மேல் நின்றும் ஆறுகளாய் *","மழைக் கண்ண நீர் * திருமால் கொடியான் என்று வார்கின்றதே!"],0,"/media/recitation/TVT.52.mp3"],[2530,2530,["vAr Ayina mulaiyAL ivaL * vAnOr thalaimaganAm *","sIr Ayina dheyva nannOy idhu ** dheyvath thaNNanthuzhAyth","thAr Ayinum thazhai Ayinum thaNkombu adhAyinum * kIzh","vEr Ayinum * ninRa maN Ayinum koNDu vIsuminE"],["வார் ஆயின முலையாள் இவள் * வானோர் தலைமகனாம் *","சீர் ஆயின தெய்வ நன்னோய் இது ** தெய்வத் தண்ணந்துழாய்த்","தார் ஆயினும் தழை ஆயினும் தண்கொம்பு அதாயினும் * கீழ்","வேர் ஆயினும் * நின்ற மண் ஆயினும் கொண்டு வீசுமினே"],0,"/media/recitation/TVT.53.mp3"],[2531,2531,["vIsum siRagAl paRaththir * viNNADu nunggaTku eLidhu *","pEsumpaDi anna pEsiyum pOvadhu ** ney thoDu uNDu","EsumpaDi anna seyyum em Isar viNNOr pirAnAr *","mAsil malar aDik kIzh * emmaich sErvikkum vaNDugaLE!"],["வீசும் சிறகால் பறத்திர் * விண்ணாடு நுங்கட்கு எளிது *","பேசும்படி அன்ன பேசியும் போவது ** நெய் தொடு உண்டு","ஏசும்படி அன்ன செய்யும் எம் ஈசர் விண்ணோர் பிரானார் *","மாசில் மலர் அடிக் கீழ் * எம்மைச் சேர்விக்கும் வண்டுகளே!"],0,"/media/recitation/TVT.54.mp3"],[2532,2532,["vaNDugaLO! vammin * nIrp pU nilap pU maraththil oNpU *","uNDu kaLiththu uzhalvIrkku onRu uraikkiyam ** Enam onRAy","maN thugaL ADi vaikundham annAL kuzhal vAy virai pOl *","viNDu kaL vArum * malar uLavO num viyal iDaththE?"],["வண்டுகளோ! வம்மின் * நீர்ப் பூ நிலப் பூ மரத்தில் ஒண்பூ *","உண்டு களித்து உழல்வீர்க்கு ஒன்று உரைக்கியம் ** ஏனம் ஒன்றாய்","மண் துகள் ஆடி வைகுந்தம் அன்னாள் குழல் வாய் விரை போல் *","விண்டு கள் வாரும் * மலர் உளவோ நும் வியல் இடத்தே?"],0,"/media/recitation/TVT.55.mp3"],[2533,2533,["viyal iDam uNDa pirAnAr viDuththa thiruvaruLAl *","uyal iDam peRRu uyndham anjchalam thOzhi! ** Or thaNthenRal vandhu","ayaliDai yArum aRindhilar ampUnthuzhAyin inthEn *","puyaluDai nIrmaiyinAl * thaDaviRRu en pulan kalanE"],["வியல் இடம் உண்ட பிரானார் விடுத்த திருவருளால் *","உயல் இடம் பெற்று உய்ந்தம் அஞ்சலம் தோழி! ** ஓர் தண்தென்றல் வந்து","அயலிடை யாரும் அறிந்திலர் அம்பூந்துழாயின் இன்தேன் *","புயலுடை நீர்மையினால் * தடவிற்று என் புலன் கலனே"],0,"/media/recitation/TVT.56.mp3"],[2534,2534,["pulak kuNDalap * puNDarIkaththa pOrk keNDai * valli onRAl","vilakkuNDu ulAginRu * vEl vizhikkinRana ** kaNNan kaiyAl","malakkuNDu amudham surandha maRi kaDal pOnRavaRRAl *","kalakkuNDa nAnRu kaNDAr * emmai yArum kazhaRalarE"],["புலக் குண்டலப் * புண்டரீகத்த போர்க் கெண்டை * வல்லி ஒன்றால்","விலக்குண்டு உலாகின்று * வேல் விழிக்கின்றன ** கண்ணன் கையால்","மலக்குண்டு அமுதம் சுரந்த மறி கடல் போன்றவற்றால் *","கலக்குண்ட நான்று கண்டார் * எம்மை யாரும் கழறலரே"],0,"/media/recitation/TVT.57.mp3"],[2535,2535,["kazhal thalam onRE nila muzhudhAyiRRu * oru kazhal pOy","nizhal thara * ellA visumbum niRaindhadhu ** nINDa aNDaththu","uzhaRalar njAnach suDar viLakkAy uyarndhOrai illA *","azhaRalar thAmaraik kaNNan * ennO inggu aLakkinRadhE?"],["கழல் தலம் ஒன்றே நில முழுதாயிற்று * ஒரு கழல் போய்","நிழல் தர * எல்லா விசும்பும் நிறைந்தது ** நீண்ட அண்டத்து","உழறலர் ஞானச் சுடர் விளக்காய் உயர்ந்தோரை இல்லா *","அழறலர் தாமரைக் கண்ணன் * என்னோ இங்கு அளக்கின்றதே?"],0,"/media/recitation/TVT.58.mp3"],[2536,2536,["aLapparum thanmaiya * Uzhi angkanggul * anthaNNanthuzhAykku","uLap perum kAdhalin * nILiyavAy uLa ** Onggu munnIr","vaLap peru nADan madhusUdhanan ennum valvinaiyEn *","thaLap peru nIL muRuval * seyya vAya thaDa mulaiyE"],["அளப்பரும் தன்மைய * ஊழி அங்கங்குல் * அந்தண்ணந்துழாய்க்கு","உளப் பெரும் காதலின் * நீளியவாய் உள ** ஓங்கு முந்நீர்","வளப் பெரு நாடன் மதுசூதனன் என்னும் வல்வினையேன் *","தளப் பெரு நீள் முறுவல் * செய்ய வாய தட முலையே"],0,"/media/recitation/TVT.59.mp3"],[2537,2537,["** mulaiyO * muzhu muRRum pOndhila * moy pUngkuzhal kuRiya","kalaiyO arai illai * nAvO kuzhaRum ** kaDal maN ellAm","vilaiyO ena miLirum kaN ivaL paramE? * perumAn","malaiyO * thiruvEngkaDam enRu kaRkinRa vAsagamE"],["** முலையோ * முழு முற்றும் போந்தில * மொய் பூங்குழல் குறிய","கலையோ அரை இல்லை * நாவோ குழறும் ** கடல் மண் எல்லாம்","விலையோ என மிளிரும் கண் இவள் பரமே? * பெருமான்","மலையோ * திருவேங்கடம் என்று கற்கின்ற வாசகமே"],0,"/media/recitation/TVT.60.mp3"],[2538,2538,["vAsagam seyvadhu nam paramE? * thollai vAnavar tham","nAyagan * nAyagar ellAm thozhumavan ** njAlam muRRum","vEy agam Ayinum sOrA vagai * iraNDE aDiyAl","thAyavan * Ayk kulamAy vandhu thOnRiRRu nam iRaiyE"],["வாசகம் செய்வது நம் பரமே? * தொல்லை வானவர் தம்","நாயகன் * நாயகர் எல்லாம் தொழுமவன் ** ஞாலம் முற்றும்","வேய் அகம் ஆயினும் சோரா வகை * இரண்டே அடியால்","தாயவன் * ஆய்க் குலமாய் வந்து தோன்றிற்று நம் இறையே"],0,"/media/recitation/TVT.61.mp3"],[2539,2539,["iRaiyO irakkinum * InggOr peNpAl enavum iranggAdhu *","aRaiyO! ena ninRadhirum karungkaDal ** Inggu ivaL than","niRaiyO ini un thiruvaruLAl anRik * kApparidhAl","muRaiyO? * aravaNai mEl paLLi koNDa mugil vaNNanE"],["இறையோ இரக்கினும் * ஈங்குஓர் பெண்பால் எனவும் இரங்காது *","அறையோ! என நின்றதிரும் கருங்கடல் ** ஈங்கு இவள் தன்","நிறையோ இனி உன் திருவருளால் அன்றிக் * காப்பரிதால்","முறையோ? * அரவணை மேல் பள்ளி கொண்ட முகில் வண்ணனே"],0,"/media/recitation/TVT.62.mp3"],[2540,2540,["vaNNam sivandhuLa * vAnADamarum kuLir vizhiya *","thaN men kamalath thaDam pOl polindhana ** thAm ivaiyO","kaNNan thirumAl thirumugam thannoDum kAdhal seydhERku *","eNNam pugundhu * aDiyEnoDu ikkAlam irukkinRavE"],["வண்ணம் சிவந்துள * வானாடமரும் குளிர் விழிய *","தண் மென் கமலத் தடம் போல் பொலிந்தன ** தாம் இவையோ","கண்ணன் திருமால் திருமுகம் தன்னொடும் காதல் செய்தேற்கு *","எண்ணம் புகுந்து * அடியேனொடு இக்காலம் இருக்கின்றவே"],0,"/media/recitation/TVT.63.mp3"],[2541,2541,["irukku ār mŏzhiyāl * nĕṟi izhukkāmai * ulaku al̤anta","tirut tāl̤ iṇai nilattevar vaṇaṅkuvar ** yāmum avā","ŏrukkā viṉaiyŏṭum ĕmmŏṭum nŏntu kaṉi iṉmaiyiṉ *","karukkāy kaṭippavar pol * tirunāmac cŏl kaṟṟaṉame"],["இருக்கு ஆர் மொழியால் * நெறி இழுக்காமை * உலகு அளந்த","திருத் தாள் இணை நிலத்தேவர் வணங்குவர் ** யாமும் அவா","ஒருக்கா வினையொடும் எம்மொடும் நொந்து கனி இன்மையின் *","கருக்காய் கடிப்பவர் போல் * திருநாமச் சொல் கற்றனமே"],1,"/media/recitation/TVT.64.mp3"],[2542,2542,["kaRRup piNai malark * kaNNin kulam venRu * OrO karumam","uRRup payinRu * seviyoDu usAvi ** ulagam ellAm","muRRum vizhunggi umizhndha pirAnAr thiruvaDik kIzh *","uRRum uRAdhum * miLirndha kaNNAy emmai uNginRavE"],["கற்றுப் பிணை மலர்க் * கண்ணின் குலம் வென்று * ஓரோ கருமம்","உற்றுப் பயின்று * செவியொடு உசாவி ** உலகம் எல்லாம்","முற்றும் விழுங்கி உமிழ்ந்த பிரானார் திருவடிக் கீழ் *","உற்றும் உறாதும் * மிளிர்ந்த கண்ணாய் எம்மை உண்கின்றவே"],0,"/media/recitation/TVT.65.mp3"],[2543,2543,["uṇṇātu uṟaṅkātu * uṇarvuṟum ĕttaṉai yokiyarkkum *","ĕṇ āy mil̤irum iyalviṉa ām ** ĕri nīr val̤i vāṉ","maṇ ākiya ĕm pĕrumāṉ taṉatu vaikuntam aṉṉāl̤ *","kaṇ āy aruviṉaiyeṉ * uyir āyiṉa kāvikal̤e"],["உண்ணாது உறங்காது * உணர்வுறும் எத்தனை யோகியர்க்கும் *","எண் ஆய் மிளிரும் இயல்வின ஆம் ** எரி நீர் வளி வான்","மண் ஆகிய எம் பெருமான் தனது வைகுந்தம் அன்னாள் *","கண் ஆய் அருவினையேன் * உயிர் ஆயின காவிகளே"],1,"/media/recitation/TVT.66.mp3"],[2544,2544,["kāviyum nīlamum * velum kayalum palapala vĕṉṟu *","āviyiṉ taṉmai al̤avu alla pārippu ** acuraraic cĕṟṟa","mā viyam pul̤ valla mātavaṉ kovintaṉ veṅkaṭam * cer","tūvi am peṭai aṉṉāl̤ * kaṇkal̤ āya tuṇaimalare"],["காவியும் நீலமும் * வேலும் கயலும் பலபல வென்று *","ஆவியின் தன்மை அளவு அல்ல பாரிப்பு ** அசுரரைச் செற்ற","மா வியம் புள் வல்ல மாதவன் கோவிந்தன் வேங்கடம் * சேர்","தூவி அம் பேடை அன்னாள் * கண்கள் ஆய துணைமலரே"],1,"/media/recitation/TVT.67.mp3"],[2545,2545,["malarndhE ozhindhila * mAlaiyum mAlaip pon vAsigaiyum *","pulam thOy thazhaip pandhar thaNDuRa nARRi ** poru kaDal sUzh","nilam thAviya emperumAn thanadhu vaikundham annAy! *","kalandhAr varavedhir koNDu * vankonRaigaL kArththanavE"],["மலர்ந்தே ஒழிந்தில * மாலையும் மாலைப் பொன் வாசிகையும் *","புலம் தோய் தழைப் பந்தர் தண்டுற நாற்றி ** பொரு கடல் சூழ்","நிலம் தாவிய எம்பெருமான் தனது வைகுந்தம் அன்னாய்! *","கலந்தார் வரவெதிர் கொண்டு * வன்கொன்றைகள் கார்த்தனவே"],0,"/media/recitation/TVT.68.mp3"],[2546,2546,["kAr ERRiruL segil ERRin * suDarukku uLaindhu * velvAn","pOr ERRedhirndhadhu * pun thalai mAlai ** buvani ellAm","nIr ERRu aLandha neDiya pirAn aruLA viDumE? *","vAr ERRiLa mulaiyAy! * varundhEl un vaLaith thiRamE"],["கார் ஏற்றிருள் செகில் ஏற்றின் * சுடருக்கு உளைந்து * வெல்வான்","போர் ஏற்றெதிர்ந்தது * புன் தலை மாலை ** புவனி எல்லாம்","நீர் ஏற்று அளந்த நெடிய பிரான் அருளா விடுமே? *","வார் ஏற்றிள முலையாய்! * வருந்தேல் உன் வளைத் திறமே"],0,"/media/recitation/TVT.69.mp3"],[2547,2547,["vaLai vAyth thiruchchakkaraththu * enggaL vAnavanAr muDi mEl *","thaLai vAy naRungkaNNith thaNNan thuzhAykku vaNNam payalai **","viLaivAn miga vandhu nAL thinggaL ANDu Uzhi niRka * emmai","uLaivAn pugundhu * idhu Or kanggul Ayiram UzhigaLE"],["வளை வாய்த் திருச்சக்கரத்து * எங்கள் வானவனார் முடி மேல் *","தளை வாய் நறுங்கண்ணித் தண்ணன் துழாய்க்கு வண்ணம் பயலை **","விளைவான் மிக வந்து நாள் திங்கள் ஆண்டு ஊழி நிற்க * எம்மை","உளைவான் புகுந்து * இது ஓர் கங்குல் ஆயிரம் ஊழிகளே"],0,"/media/recitation/TVT.70.mp3"],[2548,2548,["UzhigaLAy ulagEzhum uNDAn enRilam * pazham kaNDu","Azhi * kaLAm pazha vaNNam enRERku ** aqdhE koNDu annai","nAzh ivaLO ennum njAlam uNDAn vaNNam solliRRu ennum *","thOzhigaLO! uraiyIr * emmai ammanai sUzhginRavE"],["ஊழிகளாய் உலகேழும் உண்டான் என்றிலம் * பழம் கண்டு","ஆழி * களாம் பழ வண்ணம் என்றேற்கு ** அஃதே கொண்டு அன்னை","நாழ் இவளோ என்னும் ஞாலம் உண்டான் வண்ணம் சொல்லிற்று என்னும் *","தோழிகளோ! உரையீர் * எம்மை அம்மனை சூழ்கின்றவே"],0,"/media/recitation/TVT.71.mp3"],[2549,2549,["sUzhginRa kanggul * surunggA iruLin karunthiNimbai *","pOzhginRa thinggaL ampiLLaiyum pOzhga ** thuzhAy malarkkE","thAzhginRa nenjchaththu oru thamiyATTiyEn mAmaikku inRu *","vAzhginRa ARidhuvO? * vandhu thOnRiRRu vAliyadhE"],["சூழ்கின்ற கங்குல் * சுருங்கா இருளின் கருந்திணிம்பை *","போழ்கின்ற திங்கள் அம்பிள்ளையும் போழ்க ** துழாய் மலர்க்கே","தாழ்கின்ற நெஞ்சத்து ஒரு தமியாட்டியேன் மாமைக்கு இன்று *","வாழ்கின்ற ஆறிதுவோ? * வந்து தோன்றிற்று வாலியதே"],0,"/media/recitation/TVT.72.mp3"],[2550,2550,["vAl veNNilavu ulagArach surakkum veNthinggaL ennum *","pAl viN suravi sura mudhir mAlai ** paridhi vaTTam","pOlum suDar aDal Azhip pirAn pozhil Ezh aLikkum *","sAlbin thagaimai kolAm? * thamiyATTi thaLarndhadhuvE"],["வால் வெண்ணிலவு உலகாரச் சுரக்கும் வெண்திங்கள் என்னும் *","பால் விண் சுரவி சுர முதிர் மாலை ** பரிதி வட்டம்","போலும் சுடர் அடல் ஆழிப் பிரான் பொழில் ஏழ் அளிக்கும் *","சால்பின் தகைமை கொலாம்? * தமியாட்டி தளர்ந்ததுவே"],0,"/media/recitation/TVT.73.mp3"],[2551,2551,["thaLarndhum muRindhum * varu thiraip pAyal * thiru neDungkaN","vaLarndhum aRivuRRum * vaiyam vizhunggiyum ** mAl varaiyaik","kiLarndhu maRi tharak kINDu eDuththAn muDi sUDu thuzhAy *","aLaindhuN siRu pasunthenRal * andhO! vandhulAginRadhE"],["தளர்ந்தும் முறிந்தும் * வரு திரைப் பாயல் * திரு நெடுங்கண்","வளர்ந்தும் அறிவுற்றும் * வையம் விழுங்கியும் ** மால் வரையைக்","கிளர்ந்து மறி தரக் கீண்டு எடுத்தான் முடி சூடு துழாய் *","அளைந்துண் சிறு பசுந்தென்றல் * அந்தோ! வந்துலாகின்றதே"],0,"/media/recitation/TVT.74.mp3"],[2552,2552,["ulAginRa keNDai oLi ambu * em Aviyai UDuruvak","kulAginRa venjchilai vAL mugaththIr! ** kuni sanggiDaRip","pulAginRa vElaip puNari ampaLLi ammAn * aDiyAr","nilAginRa vaigundhamO? * vaiyamO? num nilai iDamE"],["உலாகின்ற கெண்டை ஒளி அம்பு * எம் ஆவியை ஊடுருவக்","குலாகின்ற வெஞ்சிலை வாள் முகத்தீர்! ** குனி சங்கிடறிப்","புலாகின்ற வேலைப் புணரி அம்பள்ளி அம்மான் * அடியார்","நிலாகின்ற வைகுந்தமோ? * வையமோ? நும் நிலை இடமே"],0,"/media/recitation/TVT.75.mp3"],[2553,2553,["iDam pOy virindhu * ivvulagaLandhAn ezhil Ar thaNthuzhAy *","vaDam pOdhinaiyum maDa nenjchamE! ** nanggaL veLvaLaikkE","viDam pOl viridhal idhu viyappE? viyan thAmaraiyin *","thaDam pOdhoDungga * mel Ambal alarvikkum veNthinggaLE"],["இடம் போய் விரிந்து * இவ்வுலகளந்தான் எழில் ஆர் தண்துழாய் *","வடம் போதினையும் மட நெஞ்சமே! ** நங்கள் வெள்வளைக்கே","விடம் போல் விரிதல் இது வியப்பே? வியன் தாமரையின் *","தடம் போதொடுங்க * மெல் ஆம்பல் அலர்விக்கும் வெண்திங்களே"],0,"/media/recitation/TVT.76.mp3"],[2554,2554,["thinggaL ampiLLai pulambath * than sengkOl arasu paTTa","sengkaLam paRRi * ninReLgu punmAlai ** thenpAl ilanggai","vengkaLam seydha nam viNNOr pirAnAr thuzhAy thuNaiyA *","nanggaLai mAmai koLvAn * vandhu thOnRi naliginRadhE"],["திங்கள் அம்பிள்ளை புலம்பத் * தன் செங்கோல் அரசு பட்ட","செங்களம் பற்றி * நின்றெள்கு புன்மாலை ** தென்பால் இலங்கை","வெங்களம் செய்த நம் விண்ணோர் பிரானார் துழாய் துணையா *","நங்களை மாமை கொள்வான் * வந்து தோன்றி நலிகின்றதே"],0,"/media/recitation/TVT.77.mp3"],[2555,2555,["naliyum narakaṉai vīṭṭiṟṟum * vāṇaṉ tiṇ tol tuṇitta *","valiyum pĕrumaiyum * yām cŏllum nīrttu alla ** mai varai pol","pŏliyum uruviṉ pirāṉār puṉai pūn tuzhāy malarkke *","mĕliyum maṭa nĕñciṉār * tantu poyiṉa vetaṉaiye"],["நலியும் நரகனை வீட்டிற்றும் * வாணன் திண் தோல் துணித்த *","வலியும் பெருமையும் * யாம் சொல்லும் நீர்த்து அல்ல ** மை வரை போல்","பொலியும் உருவின் பிரானார் புனை பூந் துழாய் மலர்க்கே *","மெலியும் மட நெஞ்சினார் * தந்து போயின வேதனையே"],1,"/media/recitation/TVT.78.mp3"],[2556,2556,["vEdhanai * veNpuri nUlanai * viNNOr parava ninRa","nAdhanai * njAlam vizhunggum anAdhanai ** njAlam thaththum","pAdhanaip pARkaDal pAmbaNai mEl paLLi koNDaruLum *","sIdhanaiyE thozhuvAr * viNNuLArilum sIriyarE"],["வேதனை * வெண்புரி நூலனை * விண்ணோர் பரவ நின்ற","நாதனை * ஞாலம் விழுங்கும் அநாதனை ** ஞாலம் தத்தும்","பாதனைப் பாற்கடல் பாம்பணை மேல் பள்ளி கொண்டருளும் *","சீதனையே தொழுவார் * விண்ணுளாரிலும் சீரியரே"],0,"/media/recitation/TVT.79.mp3"],[2557,2557,["sIr arasANDu than sengkOl * sila nAL selIik kazhindha *","pAr arasu oththu maRaindhadhu nAyiRu ** pAr aLandha","pEr arasE! em visumbarasE! emmai nIththu vanjchiththa *","Or arasE! aruLAy * iruLAy vandhu uRuginRadhE"],["சீர் அரசாண்டு தன் செங்கோல் * சில நாள் செலீஇக் கழிந்த *","பார் அரசு ஒத்து மறைந்தது நாயிறு ** பார் அளந்த","பேர் அரசே! எம் விசும்பரசே! எம்மை நீத்து வஞ்சித்த *","ஓர் அரசே! அருளாய் * இருளாய் வந்து உறுகின்றதே"],0,"/media/recitation/TVT.80.mp3"],[2558,2558,["uṟukiṉṟa kaṉmaṅkal̤ * melaṉa orppilarāy * ival̤aip","pĕṟukiṉṟa tāyar * mĕyn nŏntu pĕṟārkŏl? ** tuzhāy kuzhalvāyt","tuṟukiṉṟilar tŏllai veṅkaṭam āṭṭavum cūzhkiṉṟilar *","iṟukiṉṟatāl ival̤ ākam * mĕl āvi ĕri kŏl̤l̤ave"],["உறுகின்ற கன்மங்கள் * மேலன ஓர்ப்பிலராய் * இவளைப்","பெறுகின்ற தாயர் * மெய்ந் நொந்து பெறார்கொல்? ** துழாய் குழல்வாய்த்","துறுகின்றிலர் தொல்லை வேங்கடம் ஆட்டவும் சூழ்கின்றிலர் *","இறுகின்றதால் இவள் ஆகம் * மெல் ஆவி எரி கொள்ளவே"],1,"/media/recitation/TVT.81.mp3"],[2559,2559,["eri koL sennAyiRu * iraNDuDanE udhayam malai vAy *","viriginRa vaNNaththa emperumAn kaNgaL ** mINDu avaRRuL","eri koL senthI vIzh asuraraip pOla em pOliyarkkum *","viriva sollIr idhuvO? * vaiyam muRRum viLariyadhE"],["எரி கொள் செந்நாயிறு * இரண்டுடனே உதயம் மலை வாய் *","விரிகின்ற வண்ணத்த எம்பெருமான் கண்கள் ** மீண்டு அவற்றுள்","எரி கொள் செந்தீ வீழ் அசுரரைப் போல எம் போலியர்க்கும் *","விரிவ சொல்லீர் இதுவோ? * வையம் முற்றும் விளரியதே"],0,"/media/recitation/TVT.82.mp3"],[2560,2560,["viLarik kural anRil * menpaDai mEginRa munRil peNNai *","muLarik kurambai idhu idhuvAga ** mugil vaNNan pEr","kiLarik kiLarip pidhaRRum mel Aviyum naivum ellAm *","thaLaril kolO? aRiyEn * uyyal Avadhu iththaiyalukkE"],["விளரிக் குரல் அன்றில் * மென்படை மேகின்ற முன்றில் பெண்ணை *","முளரிக் குரம்பை இது இதுவாக ** முகில் வண்ணன் பேர்","கிளரிக் கிளரிப் பிதற்றும் மெல் ஆவியும் நைவும் எல்லாம் *","தளரில் கொலோ? அறியேன் * உய்யல் ஆவது இத்தையலுக்கே"],0,"/media/recitation/TVT.83.mp3"],[2561,2561,["taiyal nallārkal̤ kuzhāṅkal̤ * kuzhiya kuzhuviṉul̤l̤um *","aiya nallārkal̤ * kuzhiya vizhaviṉum ** aṅku aṅku ĕllām","kaiya pŏṉ āzhi vĕṇ caṅkŏṭum kāṇpāṉ avāvuvaṉ nāṉ *","maiya vaṇṇā maṇiye * muttame ĕṉ taṉ māṇikkame"],["தையல் நல்லார்கள் குழாங்கள் * குழிய குழுவினுள்ளும் *","ஐய நல்லார்கள் * குழிய விழவினும் ** அங்கு அங்கு எல்லாம்","கைய பொன் ஆழி வெண் சங்கொடும் காண்பான் அவாவுவன் நான் *","மைய வண்ணா மணியே * முத்தமே என் தன் மாணிக்கமே"],1,"/media/recitation/TVT.84.mp3"],[2562,2562,["māṇikkam kŏṇṭu * kuraṅku ĕṟivu ŏttu irul̤oṭu muṭṭi *","āṇippŏṉ aṉṉa cuṭar paṭum mālai ** ulaku al̤anta","māṇikkame ĕṉ marakatame maṟṟu ŏppārai illā *","āṇippŏṉṉe * aṭiyeṉ aṭi āvi aṭaikkalame"],["மாணிக்கம் கொண்டு * குரங்கு எறிவு ஒத்து இருளோடு முட்டி *","ஆணிப்பொன் அன்ன சுடர் படும் மாலை ** உலகு அளந்த","மாணிக்கமே என் மரகதமே மற்று ஒப்பாரை இல்லா *","ஆணிப்பொன்னே * அடியேன் அடி ஆவி அடைக்கலமே"],1,"/media/recitation/TVT.85.mp3"],[2563,2563,["aDaik kalaththOnggu kamalaththu alar ayan senni ennum *","muDaik kalaththUN mun aranukku nIkkiyai ** Azhi sanggam","paDaikkalam Endhiyai veNNeykku anRu Aychchi van thAmbugaLAl *","puDaikku alandhAnai emmAnai * en sollip pulambuvanE?"],["அடைக் கலத்தோங்கு கமலத்து அலர் அயன் சென்னி என்னும் *","முடைக் கலத்தூண் முன் அரனுக்கு நீக்கியை ** ஆழி சங்கம்","படைக்கலம் ஏந்தியை வெண்ணெய்க்கு அன்று ஆய்ச்சி வன் தாம்புகளால் *","புடைக்கு அலந்தானை எம்மானை * என் சொல்லிப் புலம்புவனே?"],0,"/media/recitation/TVT.86.mp3"],[2564,2564,["pulambum kana kural * pOzh vAya anRilum * pUngkazhi pAyndhu","alambum kana kural * sUzh thirai Azhiyum ** Anggu avai nin","valam puLLadhu nalam pADum idhu kuRRamAga * vaiyam","silambumpaDi seyvadhE? * thirumAl iththiruvinaiyE"],["புலம்பும் கன குரல் * போழ் வாய அன்றிலும் * பூங்கழி பாய்ந்து","அலம்பும் கன குரல் * சூழ் திரை ஆழியும் ** ஆங்கு அவை நின்","வலம் புள்ளது நலம் பாடும் இது குற்றமாக * வையம்","சிலம்பும்படி செய்வதே? * திருமால் இத்திருவினையே"],0,"/media/recitation/TVT.87.mp3"],[2565,2565,["thiru mAl uru okkum mEru * ammEruvil senjchuDarOn *","thiru mAl thiruk kaith thiruch chakkaram okkum ** anna kaNDum","thiru mAl uruvODu avan chinnamE pidhaRRA niRpadhOr *","thiru mAl thalaik koNDa nanggaTku * enggE varum thIvinaiyE?"],["திரு மால் உரு ஒக்கும் மேரு * அம்மேருவில் செஞ்சுடரோன் *","திரு மால் திருக் கைத் திருச் சக்கரம் ஒக்கும் ** அன்ன கண்டும்","திரு மால் உருவோடு அவன் சின்னமே பிதற்றா நிற்பதோர் *","திரு மால் தலைக் கொண்ட நங்கட்கு * எங்கே வரும் தீவினையே?"],0,"/media/recitation/TVT.88.mp3"],[2566,2566,["thI vinaikkaru nanjchai * nal vinaikku innamudhaththinai *","pUvinai mEviya dhEvi maNALanai ** punmai eLgAdhu","Avinai mEykkum val Ayanai anRulagu IraDiyAl *","thAvina ERRai emmAnai * enjnjAnRu thalaippeyvanE?"],["தீ வினைக்கரு நஞ்சை * நல் வினைக்கு இன்னமுதத்தினை *","பூவினை மேவிய தேவி மணாளனை ** புன்மை எள்காது","ஆவினை மேய்க்கும் வல் ஆயனை அன்றுலகு ஈரடியால் *","தாவின ஏற்றை எம்மானை * எஞ்ஞான்று தலைப்பெய்வனே?"],0,"/media/recitation/TVT.89.mp3"],[2567,2567,["thalaippeydhu yAn un thiruvaDich sUDum thagaimaiyinAl *","nilaippeydha Akkaikku nORRa immAyamum ** mAyam sevvE","nilaippeydhilAdha nilaimaiyum kANthORu asurar kuzhAm *","tholaip peydha nEmi endhAy! * thollai Uzhi surunggaladhE"],["தலைப்பெய்து யான் உன் திருவடிச் சூடும் தகைமையினால் *","நிலைப்பெய்த ஆக்கைக்கு நோற்ற இம்மாயமும் ** மாயம் செவ்வே","நிலைப்பெய்திலாத நிலைமையும் காண்தோறு அசுரர் குழாம் *","தொலைப் பெய்த நேமி எந்தாய்! * தொல்லை ஊழி சுருங்கலதே"],0,"/media/recitation/TVT.90.mp3"],[2568,2568,["surungguRi veNNey thoDu uNDa kaLvanai * vaiyam muRRum","orungguRa uNDa * peru vayiRRALanai ** mAvali mATTu","irungkuRaL Agi isaiya Or mUvaDi vENDich senRa *","perungkiRiyAnai allAl * aDiyEn nenjcham pENaladhE"],["சுருங்குறி வெண்ணெய் தொடு உண்ட கள்வனை * வையம் முற்றும்","ஒருங்குற உண்ட * பெரு வயிற்றாளனை ** மாவலி மாட்டு","இருங்குறள் ஆகி இசைய ஓர் மூவடி வேண்டிச் சென்ற *","பெருங்கிறியானை அல்லால் * அடியேன் நெஞ்சம் பேணலதே"],0,"/media/recitation/TVT.91.mp3"],[2569,2569,["pENalam illA arakkar munnIra perum padhi vAy *","nIL nagar nIL eri vaiththaruLAy enRu ** ninnai viNNOr","thAL nilam thOyndhu thozhuvar nin mUrththi pal kURRil onRu *","kANalum Angkol? enRE * vaigal mAlaiyum kAlaiyumE"],["பேணலம் இல்லா அரக்கர் முந்நீர பெரும் பதி வாய் *","நீள் நகர் நீள் எரி வைத்தருளாய் என்று ** நின்னை விண்ணோர்","தாள் நிலம் தோய்ந்து தொழுவர் நின் மூர்த்தி பல் கூற்றில் ஒன்று *","காணலும் ஆங்கொல்? என்றே * வைகல் மாலையும் காலையுமே"],0,"/media/recitation/TVT.92.mp3"],[2570,2570,["kAlai veyyORku mun OTTuk koDuththa kanggul kuRumbar *","mAlai veyyOn paDa * vaiyagam pAvuvar ** anna kaNDum","kAlai nalnjAnath thuRai paDindhADik kaN pOdhu seydhu *","mAlai nal nAvil koLLAr * ninaiyAr avan maip paDiyE"],["காலை வெய்யோற்கு முன் ஓட்டுக் கொடுத்த கங்குல் குறும்பர் *","மாலை வெய்யோன் பட * வையகம் பாவுவர் ** அன்ன கண்டும்","காலை நல்ஞானத் துறை படிந்தாடிக் கண் போது செய்து *","மாலை நல் நாவில் கொள்ளார் * நினையார் அவன் மைப் படியே"],0,"/media/recitation/TVT.93.mp3"],[2571,2571,["maip paDi mEniyum * senthAmaraik kaNNum vaidhigarE *","meyp paDiyAl un thiruvaDich sUDum thagaimaiyinAr **","eppaDi UrA milaikkak kuruTTA milaikkum ennum *","appaDi yAnum sonnEn * aDiyEn maRRu yAdhu enbanE?"],["மைப் படி மேனியும் * செந்தாமரைக் கண்ணும் வைதிகரே *","மெய்ப் படியால் உன் திருவடிச் சூடும் தகைமையினார் **","எப்படி ஊரா மிலைக்கக் குருட்டா மிலைக்கும் என்னும் *","அப்படி யானும் சொன்னேன் * அடியேன் மற்று யாது என்பனே?"],0,"/media/recitation/TVT.94.mp3"],[2572,2572,["** yAdhAnum Or Akkaiyil pukku * anggu AppuNDum Appavizhndhum *","mUdhAviyil thaDumARum uyir munnamE ** adhanAl","yAdhAnum paRRi nInggum viradhaththai nal vIDu seyyum *","mAthAvinaip pithuvai * thirumAlai vaNangguvanE"],["** யாதானும் ஓர் ஆக்கையில் புக்கு * அங்கு ஆப்புண்டும் ஆப்பவிழ்ந்தும் *","மூதாவியில் தடுமாறும் உயிர் முன்னமே ** அதனால்","யாதானும் பற்றி நீங்கும் விரதத்தை நல் வீடு செய்யும் *","மாதாவினைப் பிதுவை * திருமாலை வணங்குவனே"],0,"/media/recitation/TVT.95.mp3"],[2573,2573,["vaNanggum thuRaigaL pala pala Akki * madhi vigaRpAl","piNanggum samayam * pala pala Akki ** avai avai thORu","aNanggum pala pala Akki nin mUrththi parappi vaiththAy *","iNanggu ninnOrai illAy! * ninkaN vETkai ezhuvippanE"],["வணங்கும் துறைகள் பல பல ஆக்கி * மதி விகற்பால்","பிணங்கும் சமயம் * பல பல ஆக்கி ** அவை அவை தோறு","அணங்கும் பல பல ஆக்கி நின் மூர்த்தி பரப்பி வைத்தாய் *","இணங்கு நின்னோரை இல்லாய்! * நின்கண் வேட்கை எழுவிப்பனே"],0,"/media/recitation/TVT.96.mp3"],[2574,2574,["ezhuvadhum mINDE paDuvadhum paTTu * enai UzhigaL pOyk","kazhivadhum kaNDu kaNDu eLgal allAl ** imaiyOrgaL kuzhAm","thozhuvadhum sUzhvadhum sey thollai mAlaik kaNNArak kaNDu *","kazhivadhOr kAdhal uRRArkkum * uNDO kaNgaL thunjchudhalE?"],["எழுவதும் மீண்டே படுவதும் பட்டு * எனை ஊழிகள் போய்க்","கழிவதும் கண்டு கண்டு எள்கல் அல்லால் ** இமையோர்கள் குழாம்","தொழுவதும் சூழ்வதும் செய் தொல்லை மாலைக் கண்ணாரக் கண்டு *","கழிவதோர் காதல் உற்றார்க்கும் * உண்டோ கண்கள் துஞ்சுதலே?"],0,"/media/recitation/TVT.97.mp3"],[2575,2575,["thunjchA munivarum * allAdhavarum thoDara ninRa *","enjchAp piRavi iDar kaDivAn ** imaiyOr thamakkum","than sArvu ilAdha thanip peru mUrththi than mAyam sevvE *","nenjchAl ninaipparidhAl * veNNey UNennum Inach sollE"],["துஞ்சா முனிவரும் * அல்லாதவரும் தொடர நின்ற *","எஞ்சாப் பிறவி இடர் கடிவான் ** இமையோர் தமக்கும்","தன் சார்வு இலாத தனிப் பெரு மூர்த்தி தன் மாயம் செவ்வே *","நெஞ்சால் நினைப்பரிதால் * வெண்ணெய் ஊணென்னும் ஈனச் சொல்லே"],0,"/media/recitation/TVT.98.mp3"],[2576,2576,["** Inach sol Ayinum Aga * eRi thirai vaiyam muRRum *","Enaththu uruvAy iDandha pirAn ** irungkaRpagam sEr","vAnaththavarkkum allAdhavarkkum maRRellA yavarkkum *","njAnap pirAnai allAl illai * nAn kaNDa nalladhuvE"],["** ஈனச் சொல் ஆயினும் ஆக * எறி திரை வையம் முற்றும் *","ஏனத்து உருவாய் இடந்த பிரான் ** இருங்கற்பகம் சேர்","வானத்தவர்க்கும் அல்லாதவர்க்கும் மற்றெல்லா யவர்க்கும் *","ஞானப் பிரானை அல்லால் இல்லை * நான் கண்ட நல்லதுவே"],0,"/media/recitation/TVT.99.mp3"],[2577,2577,["** nallAr navil kurugUr nagarAn * thirumAl thirup pEr","vallAr * aDik kaNNi sUDiya ** mARan viNNappam seydha","sollAr thoDaiyal innURum vallAr azhundhAr piRappAm *","pollA aruvinai * mAya vansERRu aLLal poynnilaththE"],["** நல்லார் நவில் குருகூர் நகரான் * திருமால் திருப் பேர்","வல்லார் * அடிக் கண்ணி சூடிய ** மாறன் விண்ணப்பம் செய்த","சொல்லார் தொடையல் இந்நூறும் வல்லார் அழுந்தார் பிறப்பாம் *","பொல்லா அருவினை * மாய வன்சேற்று அள்ளல் பொய்ந்நிலத்தே"],0,"/media/recitation/TVT.100.mp3"]],"box":["https://app.box.com/s/eqs86l97czi9i4ms8z90pwm3htzac8z6","05. thiruviruththam [2478-2577] (NammAzhwAr).mp3",2478,2577]}]}